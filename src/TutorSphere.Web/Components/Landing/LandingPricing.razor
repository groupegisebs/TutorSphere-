@inject IStringLocalizer<SharedResources> L

<section class="lp-pricing lp-reveal" id="pricing">
    <div class="lp-container">
        <div class="lp-section-header lp-pricing-header">
            <span class="lp-section-label">@L["LandingPricing_Label"]</span>
            <h2>@L["LandingPricing_Title"]</h2>
            <p>@L["LandingPricing_SubtitleAnnual"]</p>
        </div>

        <div class="lp-plan-cards" style="justify-content:center">
            <article class="lp-plan-card lp-plan-card--featured" style="max-width:420px">
                <h3 class="lp-plan-card-name">@L["LandingPricing_AnnualPlan"]</h3>
                <p class="lp-plan-card-desc">@L["LandingPricing_AnnualPlanDesc"]</p>
                <div class="lp-plan-card-price">
                    <strong>10 $</strong>
                    <small>/@L["Activate_PerYear"] USD</small>
                </div>
                <ul class="lp-plan-card-features">
                    <li><i class="bi bi-check2" aria-hidden="true"></i>@L["Activate_F1"]</li>
                    <li><i class="bi bi-check2" aria-hidden="true"></i>@L["Activate_F2"]</li>
                    <li><i class="bi bi-check2" aria-hidden="true"></i>@L["Activate_F3"]</li>
                    <li><i class="bi bi-check2" aria-hidden="true"></i>@L["LandingPricing_Annual_F4"]</li>
                </ul>
                <a href="/login/tuteur" class="btn btn-primary w-100" data-enhance-nav="false">@L["Nav_Login"]</a>
            </article>
        </div>

        <p class="lp-pricing-footnote">
            <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>@L["LandingPricing_FootnoteAnnual"]
        </p>
    </div>
</section>
