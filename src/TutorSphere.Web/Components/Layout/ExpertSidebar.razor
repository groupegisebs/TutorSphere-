@rendermode InteractiveServer
@using TutorSphere.Application.Options
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Nav
@inject ExpertModuleFeatures Modules

<div class="cc-sidebar-brand">
    <a class="cc-sidebar-brand-link" href="expert/dashboard">
        <img class="cc-sidebar-logo" src="images/tutorsphere-logo-full.png" alt="TutorSphere" />
        <div class="cc-sidebar-brand-text">
            <span class="cc-sidebar-brand-name">TutorSphere</span>
            <span class="cc-sidebar-brand-badge">@(_isManager ? "Responsable" : "Expert")</span>
        </div>
    </a>
</div>

<div class="cc-nav-scroll">
    <nav>
        <CollapsibleNavSection Title="Pilotage" Icon="bi-speedometer2" SectionKey="pilotage" DefaultOpen="false">
            <NavLink class="cc-nav-link" href="expert/dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2" aria-hidden="true"></i>
                <span>Tableau de bord</span>
                @if (_pendingEnrollments > 0)
                {
                    <span class="ex-nav-badge">@_pendingEnrollments</span>
                }
            </NavLink>
            <NavLink class="cc-nav-link" href="expert/reports" Match="NavLinkMatch.Prefix">
                <i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>
                <span>Rapports</span>
            </NavLink>
            <NavLink class="cc-nav-link" href="expert/activity" Match="NavLinkMatch.Prefix">
                <i class="bi bi-activity" aria-hidden="true"></i>
                <span>Journal d'activité</span>
            </NavLink>
        </CollapsibleNavSection>

        @* Une entrée par écran, et une seule : « Ajouter des enseignants » est le bouton principal
           de la page Enseignants, et « Inscriptions élèves » n'était qu'une ancre vers le tableau
           de bord, badge compris. *@
        <CollapsibleNavSection Title="Enseignants" Icon="bi-mortarboard" SectionKey="enseignants" DefaultOpen="false">
            <NavLink class="cc-nav-link" href="expert/teachers" Match="NavLinkMatch.All">
                <i class="bi bi-mortarboard" aria-hidden="true"></i>
                <span>Enseignants</span>
            </NavLink>
            <NavLink class="cc-nav-link" href="expert/approvals" Match="NavLinkMatch.Prefix">
                <i class="bi bi-inbox" aria-hidden="true"></i>
                <span>Approbations</span>
                @if (_approvalCount > 0)
                {
                    <span class="ex-nav-badge">@_approvalCount</span>
                }
            </NavLink>
            <NavLink class="cc-nav-link" href="expert/demonstrations" Match="NavLinkMatch.Prefix">
                <i class="bi bi-easel" aria-hidden="true"></i>
                <span>Démonstrations</span>
            </NavLink>
            @if (_isManager)
            {
                <NavLink class="cc-nav-link" href="expert/contracts" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-pen" aria-hidden="true"></i>
                    <span>Contrats</span>
                </NavLink>
            }
            <NavLink class="cc-nav-link" href="expert/lesson-coverage" Match="NavLinkMatch.Prefix">
                <i class="bi bi-person-bounding-box" aria-hidden="true"></i>
                <span>Remplacements</span>
            </NavLink>
            <NavLink class="cc-nav-link" href="expert/documents" Match="NavLinkMatch.Prefix">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                <span>Documents</span>
            </NavLink>
            @if (!_isManager && Modules.Disciplines)
            {
                <NavLink class="cc-nav-link" href="expert/disciplines" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-book" aria-hidden="true"></i>
                    <span>Disciplines</span>
                </NavLink>
            }
        </CollapsibleNavSection>

        @* Section unique pour les deux rôles : Membres, Admissions et les tâches changent de page
           selon les droits, pas de section, pour qu'un écran se désigne toujours par le même chemin. *@
        <CollapsibleNavSection Title="Gestion du groupe" Icon="bi-diagram-3" SectionKey="gestion" DefaultOpen="false">
            @if (_isManager)
            {
                <NavLink class="cc-nav-link" href="group-admin/members" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Membres</span>
                </NavLink>
            }
            else
            {
                <NavLink class="cc-nav-link" href="expert/members" Match="NavLinkMatch.All">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Membres</span>
                </NavLink>
            }
            <NavLink class="cc-nav-link" href="expert/admissions" Match="NavLinkMatch.Prefix">
                <i class="bi bi-person-check" aria-hidden="true"></i>
                <span>Admissions</span>
            </NavLink>
            @if (_isManager)
            {
                <NavLink class="cc-nav-link" href="expert/offers" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-tags" aria-hidden="true"></i>
                    <span>Offres du groupe</span>
                </NavLink>
                <NavLink class="cc-nav-link" href="expert/teacher-payouts" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-receipt" aria-hidden="true"></i>
                    <span>Factures enseignants</span>
                </NavLink>
                <NavLink class="cc-nav-link" href="group-admin/tasks" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-list-check" aria-hidden="true"></i>
                    <span>Tâches &amp; délégations</span>
                </NavLink>
            }
            else
            {
                <NavLink class="cc-nav-link" href="expert/my-tasks" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                    <span>Mes tâches</span>
                </NavLink>
            }
            @* Entretiens, réévaluations, observations, bibliothèque, formations, décisions et
               incidents partagent un même écran : ils sont des onglets, pas des rubriques. *@
            <NavLink class="cc-nav-link" href="expert/workspace" Match="NavLinkMatch.Prefix">
                <i class="bi bi-kanban" aria-hidden="true"></i>
                <span>Espace de travail</span>
            </NavLink>
        </CollapsibleNavSection>

        <CollapsibleNavSection Title="Communication" Icon="bi-chat-dots" SectionKey="communication" DefaultOpen="false">
            <NavLink class="cc-nav-link" href="expert/messages" Match="NavLinkMatch.Prefix">
                <i class="bi bi-envelope" aria-hidden="true"></i>
                <span>Messagerie du groupe</span>
            </NavLink>
            @if (_isManager && Modules.Meetings)
            {
                <NavLink class="cc-nav-link" href="expert/meetings" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-camera-video" aria-hidden="true"></i>
                    <span>Réunions</span>
                </NavLink>
            }
            @if (_isManager)
            {
                <NavLink class="cc-nav-link" href="expert/admin-chat" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-headset" aria-hidden="true"></i>
                    <span>Contacter TutorSphere</span>
                </NavLink>
            }
        </CollapsibleNavSection>

        @if (_isManager)
        {
            <CollapsibleNavSection Title="Paramètres" Icon="bi-gear" SectionKey="parametres" DefaultOpen="false">
                <NavLink class="cc-nav-link" href="group-admin/settings" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-gear" aria-hidden="true"></i>
                    <span>Paramètres du groupe</span>
                </NavLink>
            </CollapsibleNavSection>
        }
    </nav>
</div>

<div class="cc-sidebar-footer">
    <button type="button" class="ex-logout" @onclick="LogoutAsync">
        <i class="bi bi-box-arrow-right"></i> Déconnexion
    </button>
</div>

@code {
    private bool _isManager;
    private int _approvalCount;
    private int _pendingEnrollments;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Auth.EnsureSessionRestoredAsync(forceJs: true);
            var ctx = await Api.GetAsync<MeContext>("api/expert/me-context");
            _isManager = ctx?.IsGroupManager == true || Auth.IsActingAsGroupAdmin;
        }
        catch { }

        try
        {
            var queue = await Api.GetAsync<List<QueuePeek>>("api/expert/approvals-queue");
            _approvalCount = queue?.Count ?? 0;
        }
        catch { }

        try
        {
            var pending = await Api.GetAsync<List<EnrollmentPeek>>("api/expert/enrollments/pending");
            _pendingEnrollments = pending?.Count ?? 0;
        }
        catch { }
    }

    private Task LogoutAsync()
    {
        Auth.Logout();
        Nav.NavigateTo("/login/expert", forceLoad: true);
        return Task.CompletedTask;
    }

    private sealed record MeContext(bool IsGroupManager, Guid? GroupId, string? GroupName);
    private sealed record QueuePeek(Guid TenantId);
    private sealed record EnrollmentPeek(Guid Id);
}
