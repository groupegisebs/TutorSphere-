@inject IStringLocalizer<SharedResources> L
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Nav

<div class="cc-sidebar-brand">
    <a class="cc-sidebar-brand-link" href="expert/dashboard">
        <img class="cc-sidebar-logo" src="images/tutorsphere-logo-full.png" alt="TutorSphere" />
        <div class="cc-sidebar-brand-text">
            <span class="cc-sidebar-brand-name">TutorSphere</span>
            <span class="cc-sidebar-brand-badge">Expert</span>
        </div>
    </a>
</div>

<div class="cc-nav-scroll">
    <nav>
        <div class="cc-nav-section">
            <div class="cc-nav-section-label">Pilotage</div>
            <NavLink class="cc-nav-link" href="expert/dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2" aria-hidden="true"></i>
                <span>Tableau de bord</span>
            </NavLink>
        </div>

        <div class="cc-nav-section">
            <div class="cc-nav-section-label">Enseignants</div>
            <NavLink class="cc-nav-link" href="expert/approvals" Match="NavLinkMatch.Prefix">
                <i class="bi bi-inbox" aria-hidden="true"></i>
                <span>File d'attente</span>
            </NavLink>
            <NavLink class="cc-nav-link" href="expert/teachers" Match="NavLinkMatch.All">
                <i class="bi bi-mortarboard" aria-hidden="true"></i>
                <span>Approuvés</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/interviews">
                <i class="bi bi-camera-video" aria-hidden="true"></i>
                <span>Entretiens</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/demonstrations">
                <i class="bi bi-easel" aria-hidden="true"></i>
                <span>Démonstrations</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/documents">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                <span>Documents</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/renewals">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                <span>Réévaluations</span>
            </NavLink>
        </div>

        <div class="cc-nav-section">
            <div class="cc-nav-section-label">Qualité</div>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/quality">
                <i class="bi bi-graph-up" aria-hidden="true"></i>
                <span>Suivi qualité</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/observations">
                <i class="bi bi-eye" aria-hidden="true"></i>
                <span>Observations</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/resources">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                <span>Supports</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/feedback">
                <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                <span>Remarques</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/incidents">
                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                <span>Incidents</span>
            </NavLink>
        </div>

        <div class="cc-nav-section">
            <div class="cc-nav-section-label">Organisation</div>
            <NavLink class="cc-nav-link" href="expert/disciplines" Match="NavLinkMatch.Prefix">
                <i class="bi bi-book" aria-hidden="true"></i>
                <span>Disciplines</span>
            </NavLink>
            <NavLink class="cc-nav-link" href="expert/offers" Match="NavLinkMatch.Prefix">
                <i class="bi bi-tags" aria-hidden="true"></i>
                <span>Offres du groupe</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/library">
                <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
                <span>Bibliothèque</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/training">
                <i class="bi bi-mortarboard-fill" aria-hidden="true"></i>
                <span>Formations</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/visibility">
                <i class="bi bi-globe2" aria-hidden="true"></i>
                <span>Visibilité</span>
            </NavLink>
        </div>

        <div class="cc-nav-section">
            <div class="cc-nav-section-label">Groupe</div>
            <NavLink class="cc-nav-link" href="expert/members" Match="NavLinkMatch.All">
                <i class="bi bi-people" aria-hidden="true"></i>
                <span>Membres</span>
            </NavLink>
            <NavLink class="cc-nav-link" href="expert/admissions" Match="NavLinkMatch.Prefix">
                <i class="bi bi-person-check" aria-hidden="true"></i>
                <span>Admissions Experts</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/meetings">
                <i class="bi bi-calendar-event" aria-hidden="true"></i>
                <span>Réunions</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/decisions">
                <i class="bi bi-ui-checks" aria-hidden="true"></i>
                <span>Décisions</span>
            </NavLink>
        </div>

        @if (_isManager)
        {
            <div class="cc-nav-section">
                <div class="cc-nav-section-label">Administration</div>
                <NavLink class="cc-nav-link" href="expert/admin-chat" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-chat-dots" aria-hidden="true"></i>
                    <span>Chat avec TutorSphere</span>
                </NavLink>
                <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/reports">
                    <i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>
                    <span>Rapports</span>
                </NavLink>
                <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/activity">
                    <i class="bi bi-activity" aria-hidden="true"></i>
                    <span>Journal d'activité</span>
                </NavLink>
            </div>
        }

        <div class="cc-nav-section">
            <div class="cc-nav-section-label">Outils</div>
            @if (!_isManager)
            {
                <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/reports">
                    <i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>
                    <span>Rapports</span>
                </NavLink>
            }
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/notifications">
                <i class="bi bi-bell" aria-hidden="true"></i>
                <span>Notifications</span>
            </NavLink>
            <NavLink class="cc-nav-link cc-nav-link-soon" href="expert/coming-soon/profile">
                <i class="bi bi-person-gear" aria-hidden="true"></i>
                <span>Mon profil</span>
            </NavLink>
        </div>
    </nav>
</div>

<div class="cc-sidebar-footer">
    <button type="button" class="cc-btn w-100" @onclick="LogoutAsync">
        <i class="bi bi-box-arrow-right"></i> @L["Nav_Logout"]
    </button>
</div>

@code {
    private bool _isManager;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Auth.EnsureSessionRestoredAsync(forceJs: true);
            var ctx = await Api.GetAsync<MeContext>("api/expert/me-context");
            _isManager = ctx?.IsGroupManager == true;
        }
        catch { }
    }

    private Task LogoutAsync()
    {
        Auth.Logout();
        Nav.NavigateTo("/login/expert", forceLoad: true);
        return Task.CompletedTask;
    }

    private sealed record MeContext(bool IsGroupManager, Guid? GroupId, string? GroupName);
}
