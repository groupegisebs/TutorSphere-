@using TutorSphere.Application.Options
@inject IStringLocalizer<SharedResources> L
@inject AuthService Auth
@inject ApiClient Api
@inject ExpertModuleFeatures Modules
@inject NavigationManager Nav

<div class="cc-sidebar-brand">
    <a class="cc-sidebar-brand-link" href="expert/dashboard">
        <img class="cc-sidebar-logo" src="images/tutorsphere-logo-full.png" alt="TutorSphere" />
        <div class="cc-sidebar-brand-text">
            <span class="cc-sidebar-brand-name">TutorSphere</span>
            <span class="cc-sidebar-brand-badge">@(_isManager ? "Responsable" : "Expert")</span>
        </div>
    </a>
</div>

<div class="cc-nav-scroll">
    <nav>
        <CollapsibleNavSection Title="Pilotage" SectionKey="pilotage" DefaultOpen="true">
            @if (Modules.IsEnabled(ExpertModuleKeys.Dashboard))
            {
                <NavLink class="cc-nav-link" href="expert/dashboard" Match="NavLinkMatch.All">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                    <span>Tableau de bord</span>
                </NavLink>
            }
            @if (_isManager && Modules.GroupAdmin)
            {
                <NavLink class="cc-nav-link" href="group-admin/dashboard" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-building-gear" aria-hidden="true"></i>
                    <span>Espace Responsable</span>
                </NavLink>
            }
            @ModuleLink(ExpertModuleKeys.Reports, "expert/coming-soon/reports", "bi-file-earmark-bar-graph", "Rapports")
            @ModuleLink(ExpertModuleKeys.Activity, "expert/coming-soon/activity", "bi-activity", "Journal d'activité")
        </CollapsibleNavSection>

        <CollapsibleNavSection Title="Enseignants" SectionKey="enseignants" DefaultOpen="true">
            @if (Modules.Approvals)
            {
                <NavLink class="cc-nav-link" href="expert/approvals" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-inbox" aria-hidden="true"></i>
                    <span>File d'attente</span>
                </NavLink>
            }
            @if (Modules.Teachers)
            {
                <NavLink class="cc-nav-link" href="expert/teachers" Match="NavLinkMatch.All">
                    <i class="bi bi-mortarboard" aria-hidden="true"></i>
                    <span>Approuvés</span>
                </NavLink>
            }
            <NavLink class="cc-nav-link" href="expert/my-tasks" Match="NavLinkMatch.Prefix">
                <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                <span>Mes tâches</span>
            </NavLink>
            @ModuleLink(ExpertModuleKeys.Interviews, "expert/coming-soon/interviews", "bi-camera-video", "Entretiens")
            @ModuleLink(ExpertModuleKeys.Demonstrations, "expert/coming-soon/demonstrations", "bi-easel", "Démonstrations")
            @ModuleLink(ExpertModuleKeys.Documents, "expert/coming-soon/documents", "bi-file-earmark-text", "Documents")
            @ModuleLink(ExpertModuleKeys.Renewals, "expert/coming-soon/renewals", "bi-arrow-repeat", "Réévaluations")
        </CollapsibleNavSection>

        @if (_isManager)
        {
            <CollapsibleNavSection Title="Responsable" SectionKey="responsable" DefaultOpen="true">
                <NavLink class="cc-nav-link" href="group-admin/dashboard" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                    <span>Tableau de bord groupe</span>
                </NavLink>
                <NavLink class="cc-nav-link" href="group-admin/tasks" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-list-check" aria-hidden="true"></i>
                    <span>Déléguer des tâches</span>
                </NavLink>
                @if (Modules.Offers)
                {
                    <NavLink class="cc-nav-link" href="expert/offers" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-tags" aria-hidden="true"></i>
                        <span>Offres du groupe</span>
                    </NavLink>
                }
                <NavLink class="cc-nav-link" href="group-admin/members" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Membres</span>
                </NavLink>
                @if (Modules.Admissions)
                {
                    <NavLink class="cc-nav-link" href="expert/admissions" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-person-check" aria-hidden="true"></i>
                        <span>Admissions</span>
                    </NavLink>
                }
                @if (Modules.AdminChat)
                {
                    <NavLink class="cc-nav-link" href="expert/admin-chat" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-chat-dots" aria-hidden="true"></i>
                        <span>Chat TutorSphere</span>
                    </NavLink>
                }
                <NavLink class="cc-nav-link" href="expert/messages" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                    <span>Messagerie groupe</span>
                </NavLink>
                <NavLink class="cc-nav-link" href="group-admin/settings" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-gear" aria-hidden="true"></i>
                    <span>Paramètres</span>
                </NavLink>
            </CollapsibleNavSection>
        }

        <CollapsibleNavSection Title="Qualité" SectionKey="qualite" DefaultOpen="false">
            @ModuleLink(ExpertModuleKeys.Quality, "expert/coming-soon/quality", "bi-graph-up", "Suivi qualité")
            @ModuleLink(ExpertModuleKeys.Observations, "expert/coming-soon/observations", "bi-eye", "Observations")
            @ModuleLink(ExpertModuleKeys.Resources, "expert/coming-soon/resources", "bi-folder2-open", "Supports")
            @ModuleLink(ExpertModuleKeys.Feedback, "expert/coming-soon/feedback", "bi-chat-left-text", "Remarques")
            @ModuleLink(ExpertModuleKeys.Incidents, "expert/coming-soon/incidents", "bi-exclamation-triangle", "Incidents")
        </CollapsibleNavSection>

        <CollapsibleNavSection Title="Organisation" SectionKey="organisation" DefaultOpen="false">
            @if (Modules.Disciplines)
            {
                <NavLink class="cc-nav-link" href="expert/disciplines" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-book" aria-hidden="true"></i>
                    <span>Disciplines</span>
                </NavLink>
            }
            @if (!_isManager && Modules.Offers)
            {
                <NavLink class="cc-nav-link" href="expert/offers" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-tags" aria-hidden="true"></i>
                    <span>Offres du groupe</span>
                </NavLink>
            }
            else if (!_isManager)
            {
                @ModuleLink(ExpertModuleKeys.Offers, "expert/offers", "bi-tags", "Offres du groupe")
            }
            @ModuleLink(ExpertModuleKeys.Library, "expert/coming-soon/library", "bi-journal-bookmark", "Bibliothèque")
            @ModuleLink(ExpertModuleKeys.Training, "expert/coming-soon/training", "bi-mortarboard-fill", "Formations")
            @ModuleLink(ExpertModuleKeys.Visibility, "expert/coming-soon/visibility", "bi-globe2", "Visibilité")
        </CollapsibleNavSection>

        <CollapsibleNavSection Title="Groupe" SectionKey="groupe" DefaultOpen="false">
            @if (!_isManager)
            {
                @if (Modules.Members)
                {
                    <NavLink class="cc-nav-link" href="expert/members" Match="NavLinkMatch.All">
                        <i class="bi bi-people" aria-hidden="true"></i>
                        <span>Membres</span>
                    </NavLink>
                }
                <NavLink class="cc-nav-link" href="expert/messages" Match="NavLinkMatch.Prefix">
                    <i class="bi bi-envelope" aria-hidden="true"></i>
                    <span>Messagerie</span>
                </NavLink>
                @if (Modules.Admissions)
                {
                    <NavLink class="cc-nav-link" href="expert/admissions" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-person-check" aria-hidden="true"></i>
                        <span>Votes d'admission</span>
                    </NavLink>
                }
            }
            @ModuleLink(ExpertModuleKeys.Meetings, "expert/coming-soon/meetings", "bi-calendar-event", "Réunions")
            @ModuleLink(ExpertModuleKeys.Decisions, "expert/coming-soon/decisions", "bi-ui-checks", "Décisions")
        </CollapsibleNavSection>

        <CollapsibleNavSection Title="Outils" SectionKey="outils" DefaultOpen="false">
            @ModuleLink(ExpertModuleKeys.Notifications, "expert/coming-soon/notifications", "bi-bell", "Notifications")
            @ModuleLink(ExpertModuleKeys.Profile, "expert/coming-soon/profile", "bi-person-gear", "Mon profil")
        </CollapsibleNavSection>
    </nav>
</div>

<div class="cc-sidebar-footer">
    <button type="button" class="cc-btn w-100" @onclick="LogoutAsync">
        <i class="bi bi-box-arrow-right"></i> @L["Nav_Logout"]
    </button>
</div>

@code {
    private bool _isManager;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Auth.EnsureSessionRestoredAsync(forceJs: true);
            var ctx = await Api.GetAsync<MeContext>("api/expert/me-context");
            _isManager = ctx?.IsGroupManager == true || Auth.IsActingAsGroupAdmin;
        }
        catch { }
    }

    private RenderFragment ModuleLink(string key, string href, string icon, string label) => builder =>
    {
        if (Modules.IsEnabled(key))
        {
            builder.OpenComponent<NavLink>(0);
            builder.AddAttribute(1, "class", "cc-nav-link");
            builder.AddAttribute(2, "href", href);
            builder.AddAttribute(3, "Match", NavLinkMatch.Prefix);
            builder.AddAttribute(4, "ChildContent", (RenderFragment)(child =>
            {
                child.OpenElement(0, "i");
                child.AddAttribute(1, "class", $"bi {icon}");
                child.AddAttribute(2, "aria-hidden", "true");
                child.CloseElement();
                child.OpenElement(3, "span");
                child.AddContent(4, label);
                child.CloseElement();
            }));
            builder.CloseComponent();
        }
        else if (Modules.IsFrozen(key))
        {
            builder.OpenComponent<FrozenNavItem>(10);
            builder.AddAttribute(11, "Icon", icon);
            builder.AddAttribute(12, "Label", label);
            builder.CloseComponent();
        }
    };

    private Task LogoutAsync()
    {
        Auth.Logout();
        Nav.NavigateTo("/login/expert", forceLoad: true);
        return Task.CompletedTask;
    }

    private sealed record MeContext(bool IsGroupManager, Guid? GroupId, string? GroupName);
}
