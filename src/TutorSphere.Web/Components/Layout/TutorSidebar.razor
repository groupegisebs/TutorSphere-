@rendermode InteractiveServer
@implements IDisposable
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Navigation
@inject AuthService AuthSvc
@inject AuthenticationStateProvider AuthState
@inject MessagingNotificationState NotifyState
@inject RealtimeMessagingClient Realtime
@inject ApiClient Api

<div class="sidebar-brand sidebar-brand--navy">
    <a class="sidebar-brand-link" href="tutor/dashboard">
        <img class="sidebar-brand-logo app-logo-compact" src="images/tutorsphere-logo-full.png" alt="@L["AppName"]" />
        <div class="sidebar-brand-text-group">
            <span class="sidebar-brand-text">@L["AppName"]</span>
            <span class="sidebar-brand-tagline">@L["AppTagline"]</span>
        </div>
    </a>
</div>

<input type="checkbox" id="ts-nav-toggle" title="@L["Nav_MenuToggle"]" class="navbar-toggler navbar-toggler--light" aria-label="@L["Nav_MenuToggle"]" />

<div class="nav-scrollable nav-scrollable--navy" onclick="var t=document.getElementById('ts-nav-toggle'); if(t) t.click();">
    <nav class="nav flex-column" aria-label="@L["Nav_Section_Tutor"]">

        <div class="nav-item">
            <NavLink class="nav-link" href="tutor/dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span>@L["Nav_Home"]</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="tutor/calendar">
                <i class="bi bi-easel2" aria-hidden="true"></i>
                <span>@L["Nav_MyClass"]</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="tutor/students">
                <i class="bi bi-people" aria-hidden="true"></i>
                <span>@L["Nav_MyStudents"]</span>
                @if (_pendingEnrollments > 0)
                {
                    <span class="sidebar-badge">@_pendingEnrollments</span>
                }
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="tutor/account">
                <i class="bi bi-person-circle" aria-hidden="true"></i>
                <span>@L["Nav_MyAccount"]</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="tutor/contracts">
                <i class="bi bi-pen" aria-hidden="true"></i>
                <span>Contrats</span>
            </NavLink>
        </div>
    </nav>

    <div class="sidebar-utility">
        <div class="nav-item">
            <NavLink class="nav-link" href="tutor/messages">
                <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                <span>@L["Nav_Messages"]</span>
                <span class="sidebar-badge @(NotifyState.UnreadTotal > 0 ? null : "sidebar-badge--zero")">@NotifyState.UnreadTotal</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="tutor/onboarding">
                <i class="bi bi-question-circle" aria-hidden="true"></i>
                <span>@L["Nav_Help"]</span>
            </NavLink>
        </div>
    </div>

    <div class="sidebar-bottom sidebar-bottom--navy">
        <button type="button" class="sidebar-logout-btn" @onclick="LogoutAsync">
            <i class="bi bi-box-arrow-left" aria-hidden="true"></i>
            <span>@L["Nav_Logout"]</span>
        </button>
    </div>
</div>

@code {
    private int _pendingEnrollments;

    protected override async Task OnInitializedAsync()
    {
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;
        NotifyState.Changed += OnNotifyChanged;

        await AuthSvc.EnsureSessionRestoredAsync();
        await LoadPendingEnrollmentsAsync();
        await Realtime.EnsureConnectedAsync();
    }

    private void OnNotifyChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadPendingEnrollmentsAsync()
    {
        try
        {
            var list = await Api.GetAsync<List<EnrollmentPeek>>("api/subscription-offerings/subscribers") ?? [];
            _pendingEnrollments = list.Count(s =>
                string.Equals(s.Status, "Pending", StringComparison.OrdinalIgnoreCase));
        }
        catch { /* keep 0 */ }
    }

    private Task LogoutAsync()
    {
        AuthSvc.Logout();
        Navigation.NavigateTo("/login", forceLoad: true);
        return Task.CompletedTask;
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> _)
    {
        await Realtime.EnsureConnectedAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
        NotifyState.Changed -= OnNotifyChanged;
    }

    private sealed record EnrollmentPeek(string Status);
}
