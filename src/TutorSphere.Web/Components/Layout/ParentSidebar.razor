@rendermode InteractiveServer
@inject IStringLocalizer<SharedResources> L
@inject AuthService AuthSvc
@inject ParentProfileState ParentProfile

<div class="sidebar-brand sidebar-brand--navy pd-brand">
    <a class="sidebar-brand-link" href="parent/dashboard">
        <img class="sidebar-brand-logo app-logo-compact" src="images/tutorsphere-logo-full.png" alt="@L["AppName"]" />
        <div class="sidebar-brand-text-group">
            <span class="sidebar-brand-text">@L["AppName"]</span>
            <span class="sidebar-brand-tagline">@L["Login_Parent_Space"]</span>
        </div>
    </a>
</div>

<input type="checkbox" id="ts-nav-toggle" title="@L["Nav_MenuToggle"]" class="navbar-toggler navbar-toggler--light" aria-label="@L["Nav_MenuToggle"]" />

<div class="nav-scrollable nav-scrollable--navy pd-nav" onclick="var t=document.getElementById('ts-nav-toggle'); if(t) t.click();">
    <nav class="nav flex-column">
        <div class="nav-item">
            <NavLink class="nav-link" href="parent/dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-house-door-fill" aria-hidden="true"></i>
                <span>@L["Nav_Home"]</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="parent/children">
                <i class="bi bi-people-fill" aria-hidden="true"></i>
                <span>@L["Nav_MyChildren"]</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="parent/calendar">
                <i class="bi bi-calendar3" aria-hidden="true"></i>
                <span>@L["Nav_Calendar"]</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="parent/homework">
                <i class="bi bi-journal-text" aria-hidden="true"></i>
                <span>@L["Nav_Homework"]</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="parent/progress">
                <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                <span>@L["Nav_Progress"]</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="parent/messages">
                <i class="bi bi-chat-dots" aria-hidden="true"></i>
                <span>@L["Nav_Messages"]</span>
                @if (_unreadMessages > 0)
                {
                    <span class="sidebar-badge sidebar-badge--purple">@_unreadMessages</span>
                }
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="parent/search">
                <i class="bi bi-mortarboard" aria-hidden="true"></i>
                <span>@L["Nav_Tutors"]</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="parent/payments">
                <i class="bi bi-credit-card" aria-hidden="true"></i>
                <span>@L["Nav_Payments"]</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="parent/documents">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                <span>@L["Nav_Documents"]</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="parent/settings">
                <i class="bi bi-gear" aria-hidden="true"></i>
                <span>@L["Nav_Settings"]</span>
            </NavLink>
        </div>
    </nav>

    <div class="pd-sidebar-footer" onclick="event.stopPropagation();">
        <div class="pd-refer-card">
            <div class="pd-refer-art" aria-hidden="true">
                <i class="bi bi-book-half"></i>
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <strong>@L["ParentDashboard_ReferTitle"]</strong>
            <p>@L["ParentDashboard_ReferDesc"]</p>
            <a href="/parent/refer" class="pd-refer-btn">@L["ParentDashboard_ReferCta"]</a>
        </div>
        <div class="pd-sidebar-help">
            <div class="pd-help-title">
                <i class="bi bi-headset" aria-hidden="true"></i>
                <strong>@L["ParentDashboard_NeedHelp"]</strong>
            </div>
            <a href="/parent/help">@L["ParentDashboard_ContactUs"]</a>
        </div>
    </div>
</div>

@code {
    private int _unreadMessages;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await AuthSvc.EnsureSessionRestoredAsync(forceJs: true);
        await ParentProfile.EnsureLoadedAsync();
        _unreadMessages = ParentProfile.UnreadMessagesCount;
        StateHasChanged();
    }
}
