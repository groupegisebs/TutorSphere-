@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IDisposable
@inject AuthService AuthSvc
@inject NavigationManager Navigation
@inject IJSRuntime Js

<div class="cc-topbar">
    <div class="cc-topbar-left">
        <div class="cc-breadcrumb">
            <button type="button" class="cc-breadcrumb-btn" @onclick="ToggleSidebarAsync" aria-label="Menu">
                <i class="bi bi-list"></i>
            </button>
            <span>@_pageTitle</span>
        </div>
        <div class="cc-topbar-sub">Vue d'ensemble de la plateforme TutorSphere.</div>
    </div>

    <div class="cc-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" placeholder="Rechercher..." @bind="_search" @onkeydown="OnSearchKey" />
    </div>

    <div class="cc-topbar-actions">
        <button type="button" class="cc-user-chip" @onclick="ToggleMenu" @onclick:stopPropagation="true">
            <span class="cc-user-avatar">@_initials</span>
            <span class="cc-user-meta">
                <span class="cc-user-name">@_displayName</span>
                <span class="cc-user-role">@_roleLabel</span>
            </span>
        </button>
        @if (_menuOpen)
        {
            <div class="cc-actions-wrap">
                <div class="cc-dropdown" style="right:0;top:2.6rem;">
                    <a href="admin/settings"><i class="bi bi-sliders"></i>Configurations</a>
                    <a href="admin/health"><i class="bi bi-heart-pulse"></i>Santé plateforme</a>
                    <button type="button" @onclick="InstallAppAsync"><i class="bi bi-download"></i>Installation</button>
                    <button type="button" class="danger" @onclick="Logout"><i class="bi bi-box-arrow-left"></i>Déconnexion</button>
                </div>
            </div>
        }
    </div>
</div>

@if (_menuOpen)
{
    <div style="position:fixed;inset:0;z-index:25;" @onclick="CloseMenu"></div>
}

@code {
    private bool _menuOpen;
    private string _search = "";
    private string _pageTitle = "Control Center";

    private string _displayName =>
        !string.IsNullOrWhiteSpace(AuthSvc.UserName) ? AuthSvc.UserName! :
        !string.IsNullOrWhiteSpace(AuthSvc.UserEmail) ? AuthSvc.UserEmail! :
        "Administrateur";

    private string _roleLabel => AuthSvc.PrimaryRole switch
    {
        "SuperAdmin" => "Super Administrateur",
        "PlatformAdmin" => "Administrateur plateforme",
        _ => AuthSvc.PrimaryRole ?? "Administrateur"
    };

    private string _initials => GetInitials(_displayName);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _pageTitle = ResolveTitle(Navigation.Uri);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Circuit dédié topbar : restaurer la session ici (pas pendant OnInitialized du layout).
        try
        {
            await AuthSvc.EnsureSessionRestoredAsync(forceJs: true);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // ne jamais tuer le circuit
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _pageTitle = ResolveTitle(e.Location);
        _menuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSidebarAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("eval",
                "document.getElementById('cc-shell')?.classList.toggle('cc-sidebar-open')");
        }
        catch { /* ignore */ }
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_search)) return;
        Navigation.NavigateTo($"admin/users?q={Uri.EscapeDataString(_search.Trim())}");
    }

    private void Logout()
    {
        _menuOpen = false;
        AuthSvc.Logout();
        Navigation.NavigateTo("/login/admin");
    }

    private async Task InstallAppAsync()
    {
        _menuOpen = false;
        try
        {
            await Js.InvokeVoidAsync("tutorSpherePwa.clearDismiss");
            var choice = await Js.InvokeAsync<InstallChoice>("tutorSpherePwa.promptInstall");
            if (choice?.Outcome is "unavailable" or null)
            {
                await Js.InvokeVoidAsync("alert",
                    "L'installation PWA n'est pas disponible pour le moment.\n\n" +
                    "Chrome / Edge : menu ⋮ → « Installer TutorSphere ».\n" +
                    "Safari iOS : Partager → « Sur l'écran d'accueil ».");
            }
        }
        catch
        {
            /* ignore */
        }
    }

    private sealed class InstallChoice
    {
        public string? Outcome { get; set; }
    }

    private static string ResolveTitle(string uri)
    {
        string path;
        if (Uri.TryCreate(uri, UriKind.Absolute, out var absolute))
            path = absolute.AbsolutePath;
        else
            path = uri.Split('?', '#')[0];

        path = path.Trim('/').ToLowerInvariant();
        return path switch
        {
            "admin" or "admin/dashboard" => "Tableau de bord",
            "admin/users" => "Utilisateurs",
            "admin/profils" or "admin/schools" => "Profils",
            "admin/parents" => "Parents",
            "admin/students" => "Élèves",
            "admin/teachers" or "admin/tutors" => "Enseignants",
            "admin/messages" or "admin/support" or "admin/chat" => "Messagerie",
            "admin/mailbox" => "Boîte mail",
            "admin/expert-groups/messages" => "Messages groupes",
            "admin/roles" => "Rôles & Permissions",
            "admin/promo-codes" => "Codes promo",
            "admin/payments" => "Paiements",
            "admin/health" => "Santé plateforme",
            "admin/settings" => "Configurations",
            _ when path.StartsWith("admin/users/") => "Fiche utilisateur",
            _ => "Control Center"
        };
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "AP";
        var parts = name.Trim().Split([' ', '@'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}"
            : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
