@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS

<div class="cc-sidebar-brand">
    <a class="cc-sidebar-brand-link" href="admin/dashboard">
        <img class="cc-sidebar-logo" src="images/tutorsphere-logo-full.png" alt="TutorSphere" />
        <div class="cc-sidebar-brand-text">
            <span class="cc-sidebar-brand-name">TutorSphere</span>
            <span class="cc-sidebar-brand-badge">Admin</span>
        </div>
    </a>
</div>

<div class="cc-nav-scroll">
    <nav>
        <div class="cc-nav-section">
            <NavLink class="cc-nav-link" href="admin/dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2" aria-hidden="true"></i>
                <span>Tableau de bord</span>
            </NavLink>
        </div>

        <div class="cc-nav-section">
            <div class="cc-nav-section-label">Supervision</div>
            <NavLink class="cc-nav-link" href="admin/users"><i class="bi bi-people"></i><span>Utilisateurs</span></NavLink>
            <NavLink class="cc-nav-link" href="admin/schools"><i class="bi bi-building"></i><span>Écoles</span></NavLink>
            <NavLink class="cc-nav-link" href="admin/parents"><i class="bi bi-person-hearts"></i><span>Parents</span></NavLink>
            <NavLink class="cc-nav-link" href="admin/students"><i class="bi bi-mortarboard"></i><span>Élèves</span></NavLink>
            <NavLink class="cc-nav-link" href="admin/teachers"><i class="bi bi-person-video3"></i><span>Enseignants</span></NavLink>
            <NavLink class="cc-nav-link" href="admin/tutors"><i class="bi bi-person-badge"></i><span>Tuteurs</span></NavLink>
            <NavLink class="cc-nav-link" href="admin/expert-groups"><i class="bi bi-award"></i><span>Groupes d'experts</span></NavLink>
            <NavLink class="cc-nav-link" href="admin/expert-groups/messages"><i class="bi bi-chat-dots"></i><span>Messages groupes</span></NavLink>
            <NavLink class="cc-nav-link" href="admin/roles"><i class="bi bi-shield-lock"></i><span>Rôles</span></NavLink>
        </div>

        <div class="cc-nav-section">
            <div class="cc-nav-section-label">Finance</div>
            <NavLink class="cc-nav-link" href="admin/promo-codes"><i class="bi bi-ticket-perforated"></i><span>Codes promo</span></NavLink>
            <NavLink class="cc-nav-link" href="admin/payments"><i class="bi bi-credit-card"></i><span>Paiements</span></NavLink>
        </div>

        <div class="cc-nav-section">
            <div class="cc-nav-section-label">Plateforme</div>
            <NavLink class="cc-nav-link" href="admin/settings"><i class="bi bi-sliders"></i><span>Configurations</span></NavLink>
            <NavLink class="cc-nav-link" href="admin/health"><i class="bi bi-heart-pulse"></i><span>Santé plateforme</span></NavLink>
            <button type="button" class="cc-nav-link cc-nav-link-btn" @onclick="InstallAppAsync">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span>Installation</span>
            </button>
        </div>
    </nav>
</div>

<div class="cc-sidebar-footer">
    <div class="cc-dark-toggle">
        <i class="bi bi-moon-stars" aria-hidden="true"></i>
        <span>Mode sombre</span>
    </div>
    <button type="button" class="cc-switch" title="Mode sombre actif" aria-label="Mode sombre"></button>
</div>

@code {
    private async Task InstallAppAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("tutorSpherePwa.clearDismiss");
            var choice = await JS.InvokeAsync<InstallChoice>("tutorSpherePwa.promptInstall");
            if (choice?.Outcome is "unavailable" or null)
            {
                await JS.InvokeVoidAsync("alert",
                    "L'installation PWA n'est pas disponible pour le moment.\n\n" +
                    "Chrome / Edge : menu ⋮ → « Installer TutorSphere ».\n" +
                    "Safari iOS : Partager → « Sur l'écran d'accueil ».");
            }
        }
        catch
        {
            /* ignore */
        }
    }

    private sealed class InstallChoice
    {
        public string? Outcome { get; set; }
    }
}
