@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

@* HeadContent can miss HeadOutlet with InteractiveServer(prerender:false); keep body <link> too. *@
<HeadContent>
    <link rel="stylesheet" href="css/admin-control-center.css" />
    <link rel="stylesheet" href="css/expert-space.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>
<link rel="stylesheet" href="css/admin-control-center.css" />
<link rel="stylesheet" href="css/expert-space.css" />

<div class="cc-shell cc-shell--expert" id="cc-shell">
    <ApplyRequestCulture />
    <aside class="cc-sidebar">
        <ExpertSidebar />
    </aside>
    <div class="cc-main">
        <header class="cc-topbar ex-topbar">
            <div class="ex-topbar-left">
                <span class="ex-topbar-kicker">@L["Expert_SpaceTitle"]</span>
                <span class="ex-topbar-sep" aria-hidden="true"></span>
                <span class="ex-topbar-hint">Centre de gouvernance</span>
            </div>
            <div class="ex-topbar-actions">
                <LanguageSelector />
                <a href="/login/expert" class="cc-btn btn-sm ex-logout">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    @L["Nav_Logout"]
                </a>
            </div>
        </header>
        <div class="cc-content ex-content">
            @Body
        </div>
    </div>
</div>

@code {
    protected override void OnParametersSet()
    {
        // Force password change before any expert page (except the change-password route itself).
        if (Auth.IsAuthenticated && Auth.MustChangePassword)
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri);
            if (!path.StartsWith("change-password", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("/change-password");
        }
    }
}
