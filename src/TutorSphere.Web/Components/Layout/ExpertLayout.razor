@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

@* HeadContent can miss HeadOutlet with InteractiveServer(prerender:false); keep body <link> too. *@
<HeadContent>
    <link rel="stylesheet" href="css/admin-control-center.css" />
</HeadContent>
<link rel="stylesheet" href="css/admin-control-center.css" />

<div class="cc-shell" id="cc-shell">
    <ApplyRequestCulture />
    <aside class="cc-sidebar">
        <ExpertSidebar />
    </aside>
    <div class="cc-main">
        <div class="cc-topbar px-3 py-2 d-flex justify-content-between align-items-center">
            <strong>@L["Expert_SpaceTitle"]</strong>
            <div class="d-flex align-items-center gap-2">
                <LanguageSelector />
                <a href="/login/expert" class="cc-btn btn-sm">@L["Nav_Logout"]</a>
            </div>
        </div>
        <div class="cc-content">
            @Body
        </div>
    </div>
</div>

@code {
    protected override void OnParametersSet()
    {
        // Force password change before any expert page (except the change-password route itself).
        if (Auth.IsAuthenticated && Auth.MustChangePassword)
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri);
            if (!path.StartsWith("change-password", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("/change-password");
        }
    }
}
