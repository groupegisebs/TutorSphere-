@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService Auth
@inject NavigationManager Nav

@* HeadContent can miss HeadOutlet with InteractiveServer(prerender:false); keep body <link> too. *@
<HeadContent>
    <link rel="stylesheet" href="css/expert-space.css?v=charte-light-23" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</HeadContent>
<link rel="stylesheet" href="css/expert-space.css?v=charte-light-23" />

<div class="cc-shell cc-shell--expert" id="cc-shell" data-module="@ModuleKey">
    <ApplyRequestCulture />
    <aside class="cc-sidebar">
        <ExpertSidebar />
    </aside>
    <div class="cc-main">
        <header class="cc-topbar ex-topbar">
            <ExpertTopbar />
        </header>
        <div class="cc-content ex-content">
            <ActingAsGroupAdminBanner />
            @Body
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        // Force password change before any expert page (except the change-password route itself).
        if (Auth.IsAuthenticated && Auth.MustChangePassword)
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri);
            if (!path.StartsWith("change-password", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("/change-password");
        }
    }

    private string ModuleKey
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
            return path.StartsWith("group-admin") ? "group" : "teachers";
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
