@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthService Auth

<link rel="stylesheet" href="css/admin-control-center.css" />

<div class="cc-shell @(_sidebarOpen ? "cc-sidebar-open" : null)">
    <aside class="cc-sidebar">
        <AdminSidebar />
    </aside>
    <div class="cc-main">
        <AdminControlTopbar OnToggleSidebar="ToggleSidebar" />
        <div class="cc-content">
            @Body
        </div>
    </div>
</div>

@code {
    private bool _sidebarOpen;
    private bool _checked;

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    protected override async Task OnInitializedAsync()
    {
        // Cookie / mémoire uniquement — pas de JS (évite le hang Edge/Cently).
        await Auth.EnsureSessionRestoredAsync(forceJs: false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _checked)
            return;

        _checked = true;

        if (Auth.PrimaryRole is not ("SuperAdmin" or "PlatformAdmin"))
        {
            // Une seule tentative JS courte ; EnsureSessionRestoredAsync a un timeout interne.
            await Auth.EnsureSessionRestoredAsync(forceJs: true);
        }

        if (Auth.PrimaryRole is not ("SuperAdmin" or "PlatformAdmin"))
        {
            // Pas de forceLoad — extensions qui patchent location cassent la nav.
            Navigation.NavigateTo("/login/admin");
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _sidebarOpen = false;
    }
}
