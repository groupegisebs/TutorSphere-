@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthService Auth

<link rel="stylesheet" href="css/admin-control-center.css" />

@if (_ready && (Auth.PrimaryRole is "SuperAdmin" or "PlatformAdmin"))
{
    <div class="cc-shell @(_sidebarOpen ? "cc-sidebar-open" : null)">
        <aside class="cc-sidebar">
            <AdminSidebar />
        </aside>
        <div class="cc-main">
            <AdminControlTopbar OnToggleSidebar="ToggleSidebar" />
            <div class="cc-content">
                @Body
            </div>
        </div>
    </div>
}
else if (!_ready)
{
    <div class="d-flex align-items-center justify-content-center py-5">
        <span class="spinner-border text-primary me-3" role="status"></span>
        <span class="text-muted">Vérification de la session…</span>
    </div>
}

@code {
    private bool _sidebarOpen;
    private bool _ready;

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Après login (forceLoad), le circuit est neuf : attendre le 1er rendu interactif
        // pour lire cookie HttpOnly + sessionStorage avant le garde de rôle.
        await Auth.EnsureSessionRestoredAsync(forceJs: true);
        _ready = true;

        var role = Auth.PrimaryRole ?? "";
        if (role is not ("SuperAdmin" or "PlatformAdmin"))
        {
            Navigation.NavigateTo("/login/admin", forceLoad: true);
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        _sidebarOpen = false;
    }
}
