@inherits LayoutComponentBase

@* Layout statique (Blazor n'autorise pas @rendermode sur les layouts).
   Interactivité = AdminControlTopbar + pages admin (InteractiveServer). *@

@* HeadContent can miss HeadOutlet when child pages use InteractiveServer(prerender:false).
   Keep HeadContent + an in-body <link> so admin-control-center.css always loads. *@
<HeadContent>
    <link rel="stylesheet" href="css/admin-control-center.css" />
</HeadContent>
<link rel="stylesheet" href="css/admin-control-center.css" />

<div class="cc-shell" id="cc-shell">
    <aside class="cc-sidebar">
        <AdminSidebar />
    </aside>
    <div class="cc-main">
        <AdminControlTopbar />
        <div class="cc-content">
            @Body
        </div>
    </div>
</div>
