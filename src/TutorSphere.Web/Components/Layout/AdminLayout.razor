@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthService Auth
@inject ILogger<AdminLayout> Logger

<link rel="stylesheet" href="css/admin-control-center.css" />

<div class="cc-shell @(_sidebarOpen ? "cc-sidebar-open" : null)">
    <aside class="cc-sidebar">
        <AdminSidebar />
    </aside>
    <div class="cc-main">
        <AdminControlTopbar OnToggleSidebar="ToggleSidebar" />
        <div class="cc-content">
            @Body
        </div>
    </div>
</div>

@code {
    private bool _sidebarOpen;
    private bool _checked;

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Auth.EnsureSessionRestoredAsync(forceJs: false);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "AdminLayout cookie session restore failed.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _checked)
            return;

        _checked = true;

        try
        {
            if (Auth.PrimaryRole is not ("SuperAdmin" or "PlatformAdmin"))
                await Auth.EnsureSessionRestoredAsync(forceJs: true);

            if (Auth.PrimaryRole is not ("SuperAdmin" or "PlatformAdmin"))
            {
                Navigation.NavigateTo("/login/admin");
                return;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "AdminLayout post-render session check failed.");
        }
    }

    protected override void OnParametersSet()
    {
        _sidebarOpen = false;
    }
}
