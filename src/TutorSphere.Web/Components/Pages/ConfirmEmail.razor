@page "/confirm-email"
@layout LoginLayout
@rendermode InteractiveServer
@using System.Net.Http.Json
@using TutorSphere.Application.DTOs.Auth
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Login_EmailConfirmed"]</PageTitle>

<div class="register-v2">
    <div class="register-v2-card register-v2-card--confirm" style="text-align:center;">
        @if (_loading)
        {
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 mb-0">@L["Login_Loading"]</p>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mb-3">@_error</div>
            <a href="/login" class="btn btn-primary px-4">@L["Nav_Login"]</a>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
        {
            _error = L["Error_FillAllFields"];
            _loading = false;
            return;
        }

        try
        {
            var resp = await Http.PostAsJsonAsync(
                "api/auth/confirm-email",
                new ConfirmEmailRequest(UserId.Trim(), Token.Trim()));

            if (resp.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/login/tuteur?confirmed=true", forceLoad: true);
                return;
            }

            var body = await resp.Content.ReadAsStringAsync();
            _error = TryParseError(body) ?? L["Login_Unavailable"].ToString();
        }
        catch (Exception ex)
        {
            _error = $"{L["Error_ApiConnection"]} ({ex.Message})";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string? TryParseError(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("error", out var err))
                return err.GetString();
        }
        catch (System.Text.Json.JsonException) { }
        return null;
    }
}
