@page "/profil/{Slug}"
@page "/school/{Slug}"
@layout SchoolLayout
@rendermode InteractiveServer
@using TutorSphere.Application.DTOs.Branding
@inject IStringLocalizer<SharedResources> L
@inject ApiClient Api

<PageTitle>@L["PageTitle_School", Profile?.DisplayName ?? L["School_DefaultName"]]</PageTitle>
@if (Profile is not null)
{
    <HeadContent>
        <meta name="description" content="@SeoDescription" />
        <meta name="robots" content="index,follow" />
        <meta property="og:title" content="@($"{Profile.DisplayName} — TutorSphere")" />
        <meta property="og:description" content="@SeoDescription" />
        @if (!string.IsNullOrWhiteSpace(Profile.PhotoUrl) && !Profile.PhotoIsGroupLogoFallback)
        {
            <meta property="og:image" content="@Profile.PhotoUrl" />
        }
    </HeadContent>
}

@if (_loading)
{
    <div class="school-loading">
        <p>@L["Loading"]</p>
    </div>
}
else if (_notFound || Profile is null)
{
    <div class="school-not-found">
        <h1>@L["School_NotFound_Title"]</h1>
        <p class="text-muted">@L["School_NotFound_Description", Slug]</p>
        <a class="btn btn-primary" href="/">@L["BackToHome"]</a>
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="container py-5">
        <div class="alert alert-danger">@_error</div>
    </div>
}
else
{
    <div class="container py-4 public-profile-content tutor-detail-public">
        <TutorDetailView Profile="Profile" SubscribeHref="/login/parent" />
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private TeacherPublicProfileDto? Profile { get; set; }
    private bool _loading = true;
    private bool _notFound;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _notFound = false;
        Profile = null;

        try
        {
            // Fiche riche (enseignant + badge groupe d'experts + offres), pas la landing minimale.
            Profile = await Api.GetAsync<TeacherPublicProfileDto>($"api/branding/{Uri.EscapeDataString(Slug)}/tutor");
            _notFound = Profile is null;
        }
        catch
        {
            _error = L["Search_Error_Load"];
        }
        finally
        {
            _loading = false;
        }
    }

    private string SeoDescription
    {
        get
        {
            var bio = Profile?.ShortBio ?? Profile?.FullBio;
            if (string.IsNullOrWhiteSpace(bio))
                return $"{Profile?.DisplayName} — TutorSphere";
            return bio.Length <= 160 ? bio : bio[..157] + "…";
        }
    }
}
