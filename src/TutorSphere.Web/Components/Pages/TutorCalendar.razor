    private void ApplyDefaultSubject()
    {
        if (!string.IsNullOrWhiteSpace(_lessonForm.Subject))
            return;
        if (_planSubjects.Count == 1)
        {
            _lessonForm.Subject = _planSubjects[0].Name;
            OnSubjectChanged();
        }
    }

    private void OnSubjectChanged()
    {
        if (string.IsNullOrWhiteSpace(_lessonForm.Subject))
            return;
        var prefix = "Cours de ";
        if (string.IsNullOrWhiteSpace(_lessonForm.Title) || _lessonForm.Title.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            _lessonForm.Title = prefix + _lessonForm.Subject;
    }

    private async Task LoadCalendarDataAsync()
    {
        _bannerError = null;
        var start = Uri.EscapeDataString(WeekStart.AddDays(-7).ToString("O"));
        var end   = Uri.EscapeDataString(WeekStart.AddDays(35).ToString("O"));

        var result = await Api.GetWithErrorAsync<CalendarViewDto>($"api/calendar/view?start={start}&end={end}");
        if (!result.IsSuccess || result.Value is null)
        {
            _bannerError = result.Error ?? "Impossible de charger le calendrier. Vérifiez votre connexion.";
            return;
        }

        var view = result.Value;
        _apiEvents.Clear();

        foreach (var lesson in view.Lessons ?? [])
        {
            var local = lesson.StartTime.Kind == DateTimeKind.Utc
                ? lesson.StartTime.ToLocalTime()
                : DateTime.SpecifyKind(lesson.StartTime, DateTimeKind.Local);
            var endLocal = lesson.EndTime.Kind == DateTimeKind.Utc
                ? lesson.EndTime.ToLocalTime()
                : DateTime.SpecifyKind(lesson.EndTime, DateTimeKind.Local);
            var dur = Math.Max(15, (int)(endLocal - local).TotalMinutes);
            var subtitle = lesson.Subject ?? "";
            if (!string.IsNullOrWhiteSpace(lesson.SubstituteTeacherName)
                && !string.IsNullOrWhiteSpace(lesson.OriginalTeacherName))
            {
                subtitle = string.IsNullOrWhiteSpace(subtitle)
                    ? $"{lesson.OriginalTeacherName} → {lesson.SubstituteTeacherName}"
                    : $"{subtitle} · {lesson.OriginalTeacherName} → {lesson.SubstituteTeacherName}";
            }
            _apiEvents.Add(new CalEvent(
                lesson.Id, local.Date, lesson.Title, subtitle, MapMode(lesson.Mode),
                local.Hour, local.Minute, dur, lesson.Mode, lesson.Description, lesson.Location, lesson.MeetingUrl,
                maxStudents: lesson.MaxStudents));
        }

        foreach (var unavail in view.Unavailabilities ?? [])
        {
            var local = unavail.StartTime.Kind == DateTimeKind.Utc
                ? unavail.StartTime.ToLocalTime()
                : DateTime.SpecifyKind(unavail.StartTime, DateTimeKind.Local);
            var endLocal = unavail.EndTime.Kind == DateTimeKind.Utc
                ? unavail.EndTime.ToLocalTime()
                : DateTime.SpecifyKind(unavail.EndTime, DateTimeKind.Local);
            var dur = Math.Max(15, (int)(endLocal - local).TotalMinutes);
            _apiEvents.Add(new CalEvent(
                unavail.Id, local.Date, unavail.Reason ?? "Indisponible", "", "unavailable",
                local.Hour, local.Minute, dur));
        }

        foreach (var offer in view.OfferAvailabilities ?? [])
        {
            var local = offer.StartTime.Kind == DateTimeKind.Utc
                ? offer.StartTime.ToLocalTime()
                : DateTime.SpecifyKind(offer.StartTime, DateTimeKind.Local);
            var endLocal = offer.EndTime.Kind == DateTimeKind.Utc
                ? offer.EndTime.ToLocalTime()
                : DateTime.SpecifyKind(offer.EndTime, DateTimeKind.Local);
            var dur = Math.Max(15, (int)(endLocal - local).TotalMinutes);
            _apiEvents.Add(new CalEvent(
                null, local.Date, offer.Title, offer.Subject ?? L["Calendar_Type_Offer"].Value, "offer",
                local.Hour, local.Minute, dur, offer.Mode, offeringId: offer.OfferingId));
        }
    }

    private void OnEventClick(CalEvent evt)
    {
        if (evt.Type == "offer")
        {
            JoinPeriodClassroom(evt);
            return;
        }

        OpenEditLesson(evt);
    }

    /// <summary>
    /// Période d'offre : rejoint la salle de la séance en cours, sinon la prochaine de la période.
    /// </summary>
    private void JoinPeriodClassroom(CalEvent offer)
    {
        var periodStart = StartOf(offer);
        var periodEnd = periodStart.AddMinutes(offer.DurMin);
        var now = DateTime.Now;

        var sessions = _apiEvents
            .Where(e => e.Id.HasValue && e.Type is not ("offer" or "unavailable"))
            .Where(e => StartOf(e) < periodEnd && StartOf(e).AddMinutes(e.DurMin) > periodStart)
            .OrderBy(StartOf)
            .ToList();

        if (sessions.Count == 0)
        {
            _bannerError = L["Calendar_OfferNoSession"];
            return;
        }

        var target = sessions.FirstOrDefault(e => StartOf(e) <= now && StartOf(e).AddMinutes(e.DurMin) > now)
                     ?? sessions.FirstOrDefault(e => StartOf(e) >= now)
                     ?? sessions[^1];

        _bannerError = null;
        Navigation.NavigateTo(
            $"/tutor/classroom/{target.Id}?title={Uri.EscapeDataString(target.Title)}&subject={Uri.EscapeDataString(target.Subtitle)}");
    }

    private static DateTime StartOf(CalEvent evt) =>
        evt.Date.AddHours(evt.StartH).AddMinutes(evt.StartM);

    private void OpenEditLesson(CalEvent evt)
    {
        if (evt.Type is "unavailable" or "offer" || !evt.Id.HasValue)
            return;

        _formError = null;
        _bannerSuccess = null;
        _editingLessonId = evt.Id;
        var locOrUrl = string.IsNullOrWhiteSpace(evt.MeetingUrl) ? (evt.Location ?? "") : evt.MeetingUrl;
        _lessonForm = new LessonFormModel
        {
            Title = evt.Title,
            Subject = evt.Subtitle,
            Description = evt.Description ?? "",
            Mode = ModeToForm(evt.ModeApi),
            LocationOrUrl = locOrUrl,
            Date = evt.Date,
            StartTime = new TimeOnly(evt.StartH, evt.StartM),
            Duration = Math.Max(0.5, Math.Round(evt.DurMin / 60.0, 1)),
            MaxStudents = Math.Max(1, evt.MaxStudents),
            Recurrence = "none"
        };
        _showLessonModal = true;
    }

    private async Task RequestCloseLessonModal()
    {
        if (_saving) return;

        if (IsLessonFormDirty())
        {
            var discard = await JS.InvokeAsync<bool>(
                "confirm",
                L["Offers_DiscardChanges"].Value);
            if (!discard)
                return;
        }

        CloseLessonModal();
    }

    private void CloseLessonModal()
    {
        _showLessonModal = false;
        _editingLessonId = null;
        _formError = null;
    }

    private bool IsLessonFormDirty() =>
        !string.IsNullOrWhiteSpace(_lessonForm.Title)
        || !string.IsNullOrWhiteSpace(_lessonForm.Subject)
        || !string.IsNullOrWhiteSpace(_lessonForm.Description)
        || !string.IsNullOrWhiteSpace(_lessonForm.LocationOrUrl)
        || _lessonForm.StudentIds.Count > 0
        || _lessonForm.Recurrence != "none"
        || _editingLessonId.HasValue;

    private void ToggleStudent(Guid id, bool selected)
    {
        if (selected)
        {
            if (_lessonForm.StudentIds.Count >= _lessonForm.MaxStudents)
                return;
            _lessonForm.StudentIds.Add(id);
        }
        else
            _lessonForm.StudentIds.Remove(id);
    }

    private void ClampSelectedStudents()
    {
        _lessonForm.MaxStudents = Math.Clamp(_lessonForm.MaxStudents, 1, 100);
        if (_lessonForm.StudentIds.Count <= _lessonForm.MaxStudents)
            return;
        _lessonForm.StudentIds = _lessonForm.StudentIds.Take(_lessonForm.MaxStudents).ToHashSet();
    }

