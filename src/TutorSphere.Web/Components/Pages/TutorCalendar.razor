    private async Task SaveLessonAsync()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_lessonForm.Title))
        {
            _formError = "Le titre est obligatoire.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_lessonForm.Subject))
        {
            _formError = L["Lessons_SubjectRequiredHint"];
            return;
        }

        if (_lessonForm.Duration < 0.5)
        {
            _formError = "La durée minimale est de 30 minutes.";
            return;
        }

        var start = DateTime.SpecifyKind(
            _lessonForm.Date.Date.Add(_lessonForm.StartTime.ToTimeSpan()),
            DateTimeKind.Local);
        var end = start.AddHours(_lessonForm.Duration);

        var isOnline = _lessonForm.Mode is "En ligne" or "Hybride";
        var location = isOnline ? null : _lessonForm.LocationOrUrl;
        var meetingUrl = isOnline ? _lessonForm.LocationOrUrl : null;

        _saving = true;
        try
        {
            var mode = _lessonForm.Mode switch
            {
                "Présentiel" => Domain.Enums.LessonMode.InPerson,
                "Hybride" => Domain.Enums.LessonMode.Hybrid,
                _ => Domain.Enums.LessonMode.Online
            };

            if (!_editingLessonId.HasValue)
            {
                _formError = L["Lessons_NoManualCreate"];
                return;
            }

            var updateReq = new Application.DTOs.Lessons.UpdateLessonRequest(
                _lessonForm.Title.Trim(),
                string.IsNullOrWhiteSpace(_lessonForm.Description) ? null : _lessonForm.Description.Trim(),
                string.IsNullOrWhiteSpace(_lessonForm.Subject) ? null : _lessonForm.Subject.Trim(),
                start.ToUniversalTime(),
                end.ToUniversalTime(),
                mode,
                location,
                meetingUrl,
                null,
                Math.Clamp(_lessonForm.MaxStudents, 1, 100));

            var updated = await Api.PutWithErrorAsync<Application.DTOs.Lessons.LessonDto>(
                $"api/lessons/{_editingLessonId}", updateReq);
            if (updated.Error is not null || updated.Value is null)
            {
                _formError = updated.Error ?? "Échec de la mise à jour du cours.";
                return;
            }

            _showLessonModal = false;
            _editingLessonId = null;
            _bannerSuccess = "Cours mis à jour.";

            await LoadCalendarDataAsync();
            GoToWeek(start);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveUnavailabilityAsync()
    {
        _formError = null;
        var start = DateTime.SpecifyKind(
            _unavailForm.Date.Date.Add(_unavailForm.StartTime.ToTimeSpan()),
            DateTimeKind.Local);
        var end = DateTime.SpecifyKind(
            _unavailForm.Date.Date.Add(_unavailForm.EndTime.ToTimeSpan()),
            DateTimeKind.Local);

        if (end <= start)
        {
            _formError = "L'heure de fin doit être après l'heure de début.";
            return;
        }

        _saving = true;
        try
        {
            var body = new
            {
                reason = string.IsNullOrWhiteSpace(_unavailForm.Reason) ? null : _unavailForm.Reason.Trim(),
                startTime = start.ToUniversalTime(),
                endTime = end.ToUniversalTime()
            };

            var created = await Api.PostAsync<ApiUnavailabilityDto>("api/calendar/unavailabilities", body);
            if (created is null)
            {
                _formError = "Échec de l'enregistrement de l'indisponibilité.";
                return;
            }

            _showUnavailModal = false;
            _bannerSuccess = "Indisponibilité enregistrée.";
            await LoadCalendarDataAsync();
            GoToWeek(start);
        }
        finally
        {
            _saving = false;
        }
    }

    // ── Navigation ─────────────────────────────────────────────────────────────
    private void GoToToday()
    {
        var today = DateTime.Today;
        FocusDate = today;
        var dow = (int)today.DayOfWeek;
        WeekStart = today.AddDays(dow == 0 ? -6 : -(dow - 1));
        DisplayMonth = new DateTime(today.Year, today.Month, 1);
    }

    private void SetViewMode(string mode)
    {
        ViewMode = mode;
        if (mode == "day" && FocusDate == default)
            FocusDate = DateTime.Today;
        if (mode != "day")
            GoToWeek(FocusDate == default ? DateTime.Today : FocusDate);
    }

    private async Task OpenDay(DateTime date)
    {
        FocusDate = date.Date;
        ViewMode = "day";
        GoToWeek(date);
        await LoadCalendarDataAsync();
    }

    private void ToggleOfferFilter() => _hideOffers = !_hideOffers;

    private void GoToWeek(DateTime date)
    {
        var dow = (int)date.DayOfWeek;
        WeekStart = date.AddDays(dow == 0 ? -6 : -(dow - 1));
        DisplayMonth = new DateTime(WeekStart.Year, WeekStart.Month, 1);
    }

    private async Task GoToTodayAndReload()
    {
        GoToToday();
        await LoadCalendarDataAsync();
    }

    private async Task PreviousWeekAsync()
    {
        if (ViewMode == "day")
        {
            FocusDate = FocusDate.AddDays(-1);
            GoToWeek(FocusDate);
        }
        else if (ViewMode == "month")
        {
            DisplayMonth = DisplayMonth.AddMonths(-1);
            WeekStart = DisplayMonth;
            FocusDate = DisplayMonth;
        }
        else
        {
            WeekStart = WeekStart.AddDays(-7);
            DisplayMonth = new DateTime(WeekStart.Year, WeekStart.Month, 1);
        }
        await LoadCalendarDataAsync();
    }

    private async Task NextWeekAsync()
    {
        if (ViewMode == "day")
        {
            FocusDate = FocusDate.AddDays(1);
            GoToWeek(FocusDate);
        }
        else if (ViewMode == "month")
        {
            DisplayMonth = DisplayMonth.AddMonths(1);
            WeekStart = DisplayMonth;
            FocusDate = DisplayMonth;
        }
        else
        {
            WeekStart = WeekStart.AddDays(7);
            DisplayMonth = new DateTime(WeekStart.Year, WeekStart.Month, 1);
        }
        await LoadCalendarDataAsync();
    }

    private async Task GoToWeekAndReload(DateTime date)
    {
        GoToWeek(date);
        await LoadCalendarDataAsync();
    }

    private void PreviousMonth() => DisplayMonth = DisplayMonth.AddMonths(-1);
    private void NextMonth()     => DisplayMonth = DisplayMonth.AddMonths(1);
}
