@page "/tutor/apply"
@layout LoginLayout
@rendermode InteractiveServer
@using System.Globalization
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.WebUtilities
@using TutorSphere.Application.Common
@using TutorSphere.Application.DTOs.Auth
@using TutorSphere.Application.DTOs.Branding
@using TutorSphere.Application.DTOs.ExpertApproval
@using TutorSphere.Application.DTOs.SubscriptionOfferings
@using TutorSphere.Domain.Policies
@using TutorSphere.Web.Common
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IConfiguration Config
@inject IStringLocalizer<SharedResources> L

<ApplyRequestCulture />

<PageTitle>@(_onForm ? L["TeacherApply_FormTitle"] : L["TeacherApply_TitleJoin"]) — TutorSphere</PageTitle>

<div class="expert-join-page teacher-apply-page">
    <div class="expert-join-shell">
        <header class="expert-join-brand">
            <img src="images/tutorsphere-logo-full.png" alt="TutorSphere" class="expert-join-logo" />
            <span class="expert-join-badge">@L["TeacherApply_Badge"]</span>
        </header>

        @if (!string.IsNullOrEmpty(_error) && _invite is null && !_done)
        {
            <div class="alert alert-danger">@_error</div>
            <a class="btn btn-outline-secondary" href="/">@L["ExpertJoin_Back"]</a>
        }
        else if (_done)
        {
            <div class="expert-join-done">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <h1>@((_invite?.IsProfileUpdate ?? false) ? L["TeacherApply_SuccessUpdate"] : L["TeacherApply_Success"])</h1>
                <p>@((_invite?.IsProfileUpdate ?? false) ? L["TeacherApply_SuccessWaitUpdate"] : L["TeacherApply_SuccessWait"])</p>
                <a class="btn expert-join-submit" href="/login/tuteur">@L["TeacherApply_GoLogin"]</a>
            </div>
        }
        else if (_loading)
        {
            <div class="text-center py-5"><span class="spinner-border"></span></div>
        }
        else if (_invite is not null && !_onForm)
        {
            <section class="ta-land-hero">
                <div class="ta-land-hero-icon" aria-hidden="true">
                    @if (!string.IsNullOrWhiteSpace(GroupLogoUrl))
                    {
                        <img src="@GroupLogoUrl" alt="" />
                    }
                    else
                    {
                        <i class="bi bi-building"></i>
                    }
                </div>
                <div>
                    <h1>@L["TeacherApply_TitleJoin"]</h1>
                    <p class="expert-join-lead">
                        <strong>@InviterGivenName</strong>
                        @L["TeacherApply_InvitesYou"]
                        <strong>@GroupLabel</strong>.
                    </p>
                    <p class="ta-land-tagline">@L["TeacherApply_LandTagline"]</p>
                    <p class="ta-land-chips">
                        <span class="ta-chip ta-chip-ok"><i class="bi bi-shield-check"></i> @L["TeacherApply_Verified"]</span>
                        @if (_invite.ExpiresAt is DateTime exp)
                        {
                            <span class="ta-chip"><i class="bi bi-calendar3"></i> @L["ExpertJoin_Expires", exp.ToLocalTime().ToString("d")]</span>
                        }
                    </p>
                    <p class="ta-land-privacy"><i class="bi bi-lock"></i> @L["TeacherApply_PrivacyLine"]</p>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(_invite.PersonalMessage))
            {
                <blockquote class="expert-join-message">
                    <p>@_invite.PersonalMessage</p>
                    <footer>— @InviterGivenName</footer>
                </blockquote>
            }

            <section class="ta-land-why">
                <h2>@L["TeacherApply_WhyTitle"]</h2>
                <div class="ta-land-why-grid">
                    <article>
                        <span class="ta-why-icon"><i class="bi bi-globe2"></i></span>
                        <h3>@L["TeacherApply_Why1Title"]</h3>
                        <p>@L["TeacherApply_Why1Body"]</p>
                    </article>
                    <article>
                        <span class="ta-why-icon"><i class="bi bi-wallet2"></i></span>
                        <h3>@L["TeacherApply_Why2Title"]</h3>
                        <p>@L["TeacherApply_Why2Body"]</p>
                    </article>
                    <article>
                        <span class="ta-why-icon"><i class="bi bi-house-door"></i></span>
                        <h3>@L["TeacherApply_Why3Title"]</h3>
                        <p>@L["TeacherApply_Why3Body"]</p>
                    </article>
                </div>
                <p class="ta-land-why-foot"><i class="bi bi-shield-check"></i> @L["TeacherApply_WhyFooter"]</p>
            </section>

            <section class="ta-land-cta">
                <h2>@L["TeacherApply_ReadyTitle"]</h2>
                <p>@L["TeacherApply_ReadyLead"]</p>
                <button type="button" class="btn ta-land-subscribe" @onclick="BeginForm">
                    @L["TeacherApply_Subscribe"] <i class="bi bi-arrow-right"></i>
                </button>
                <p class="ta-land-meta">
                    <i class="bi bi-clock"></i>
                    @L["TeacherApply_FreeMeta"] · @L["TeacherApply_DurationMeta"] · @L["TeacherApply_NoCommit"]
                </p>
                <p class="ta-land-privacy"><i class="bi bi-lock"></i> @L["TeacherApply_Confidential"]</p>
                <a class="ta-land-support" href="mailto:support@tutorsphere.com">
                    <i class="bi bi-question-circle"></i> @L["TeacherApply_ContactSupport"]
                </a>
            </section>
        }
        else if (_invite is not null)
        {
            @if (IsOpenInvite)
            {
                <button type="button" class="ta-back-intro" @onclick="BackToIntro">
                    <i class="bi bi-arrow-left"></i> @L["TeacherApply_BackToIntro"]
                </button>
            }
            <header class="ta-form-hero">
                <h1>@L["TeacherApply_FormTitle"]</h1>
                <p>@L["TeacherApply_FormLead"]</p>
                <p class="ta-land-chips">
                    <span class="ta-chip ta-chip-ok"><i class="bi bi-shield-check"></i> @L["TeacherApply_Verified"]</span>
                    <span class="ta-chip">@GroupLabel</span>
                    @if (_invite.ExpiresAt is DateTime exp)
                    {
                        <span class="ta-chip"><i class="bi bi-calendar3"></i> @L["ExpertJoin_Expires", exp.ToLocalTime().ToString("d")]</span>
                    }
                </p>
                <p class="ta-form-meta">
                    @L["TeacherApply_FreeMeta"] · @L["TeacherApply_DurationMeta"] · @L["TeacherApply_Confidential"]
                </p>
            </header>

            @if (_invite.IsProfileUpdate)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-1"></i>
                    @L["TeacherApply_ExistingAccountBanner"]
                </div>
            }

            <div class="ta-form-layout">
            <div class="teacher-apply-wizard expert-join-card">
                <StepIndicator Steps="@_steps" CurrentStep="@_step" Subtitles="@_stepHints" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2">@_error</div>
                }

                @if (_step == 1)
                {
                    <h2>@L["TeacherApply_Step1"]</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="ta-fn">@L["Label_FirstName"] <span class="text-danger">*</span></label>
                            <input id="ta-fn" class="form-control" @bind="_firstName" @bind:event="oninput" @bind:after="OnNameChanged" autocomplete="given-name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ta-ln">@L["Label_LastName"] <span class="text-danger">*</span></label>
                            <input id="ta-ln" class="form-control" @bind="_lastName" @bind:event="oninput" @bind:after="OnNameChanged" autocomplete="family-name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ta-dob">@L["TeacherApply_BirthDate"] <span class="text-muted">(@L["Label_Optional"])</span></label>
                            <input id="ta-dob" type="date" class="form-control" @bind="_birthDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ta-email">@L["Label_Email"] <span class="text-danger">*</span></label>
                            @if (EmailLocked)
                            {
                                <input id="ta-email" class="form-control" value="@_invite.Email" disabled readonly />
                                <div class="form-text">@L["TeacherApply_EmailLocked"]</div>
                            }
                            else
                            {
                                <input id="ta-email" class="form-control" type="email" @bind="_email" autocomplete="email" />
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ta-phone">@L["TeacherApply_Phone"]</label>
                            <div class="input-group">
                                <span class="input-group-text">@PhoneAddon</span>
                                <input id="ta-phone" class="form-control" @bind="_phone" @bind:after="RefreshAddressCoherence" placeholder="@PhonePlaceholder" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@L["TeacherApply_Country"] @if (CanSelectCountry) { <span class="text-danger">*</span> }</label>
                            @if (CanSelectCountry)
                            {
                                <CountrySelect Value="@_country" ValueChanged="OnCountryChanged" Placeholder="@L["TeacherApply_Country"]" />
                                <div class="form-text">@L["TeacherApply_CountryHintOpen"]</div>
                            }
                            else
                            {
                                <input class="form-control" value="@CountryDisplay" disabled readonly />
                                <div class="form-text">@L["TeacherApply_CountryHint"]</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="ta-city">@L["Expert_RegisterCity"] <span class="text-danger">*</span></label>
                            <input id="ta-city" class="form-control" @bind="_city" @bind:after="RefreshAddressCoherence" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label" for="ta-addr">@L["TeacherApply_Address"]</label>
                            <input id="ta-addr" class="form-control" @bind="_address" @bind:after="RefreshAddressCoherence" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="ta-postal">@L["TeacherApply_Postal"]</label>
                            <input id="ta-postal" class="form-control" @bind="_postal" @bind:after="RefreshAddressCoherence"
                                   placeholder="@AddressCoherence.PostalExample(ResidenceCountryCode)" />
                            @if (AddressCoherence.PostalHint(ResidenceCountryCode) is { } postalHint)
                            {
                                <div class="form-text">@postalHint</div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_addressError))
                        {
                            <div class="col-12">
                                <div class="alert alert-warning py-2 mb-0">@_addressError</div>
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label" for="ta-lang">@L["TeacherApply_Language"] <span class="text-danger">*</span></label>
                            <TeacherCommunicationLanguagePicker Selected="_languages"
                                                               SelectedChanged="OnLanguagesChanged"
                                                               IdPrefix="ta-lang"
                                                               Hint="@L["TeacherApply_LanguageHint"]" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@L["TeacherApply_Photo"]</label>
                            <label class="ex-upload">
                                <i class="bi bi-cloud-arrow-up"></i>
                                <span>PNG, JPG ou WEBP — max. 2 Mo</span>
                                @if (!string.IsNullOrWhiteSpace(_photoName))
                                {
                                    <strong>@_photoName</strong>
                                }
                                <InputFile OnChange="OnPhotoSelected" accept=".png,.jpg,.jpeg,.webp" />
                            </label>
                        </div>
                    </div>
                }
                else if (_step == 2)
                {
                    <h2>@L["TeacherApply_Step2"]</h2>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">@L["TeacherApply_GroupLabel"]</label>
                            <input class="form-control" value="@_invite.ExpertGroupName" disabled readonly />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@L["TeacherApply_Slug"] <span class="text-danger">*</span></label>
                            <div class="subdomain-field">
                                <span class="subdomain-prefix">https://</span>
                                <input class="form-control" @bind="_slug" @bind:event="oninput" @bind:after="AfterSlugChanged" placeholder="prenom-nom" />
                                <span class="subdomain-suffix">.tutorsphere.com</span>
                            </div>
                            @if (_slugAvailable == false)
                            {
                                <small class="text-danger">@L["Error_SlugTaken"]</small>
                            }
                            else if (_slugAvailable == true)
                            {
                                <small class="text-success">@L["TeacherApply_SlugOk"]</small>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="ta-bio">@L["TeacherApply_Presentation"]</label>
                            <textarea id="ta-bio" class="form-control" rows="4" @bind="_presentation"
                                      placeholder="@L["TeacherApply_PresentationHint"]"></textarea>
                            <div class="form-text">@L["TeacherApply_QualificationsHint"]</div>
                        </div>
                        <div class="col-12">
                            <TeacherCredentialsEditor @bind-YearsExperience="_yearsExperience"
                                                      Diplomas="_diplomas"
                                                      Certifications="_certs" />
                        </div>
                    </div>
                }
                else if (_step == 3)
                {
                    <h2>@L["TeacherApply_Step3"]</h2>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="ta-offer">@L["TeacherApply_Offer"] <span class="text-danger">*</span></label>
                            @if (_invite.Offers is null || _invite.Offers.Count == 0)
                            {
                                <p class="text-muted mb-2">@L["TeacherApply_OffersEmpty"]</p>
                                <input id="ta-offer" class="form-control" @bind="_offerTitle" placeholder="@L["TeacherApply_OfferTitleHint"]" />
                            }
                            else
                            {
                                <input class="form-control mb-2" @bind="_offerQuery" @bind:event="oninput"
                                       placeholder="@L["TeacherApply_OfferSearch"]" />
                                <select id="ta-offer" class="form-select" @bind="_offerPick" @bind:after="OnOfferChanged">
                                    <option value="">@L["TeacherApply_OfferChoose"]</option>
                                    @foreach (var o in SelectableInviteOffers)
                                    {
                                        <option value="@o.Id.ToString()">@OfferOptionLabel(o)</option>
                                    }
                                </select>
                                @if (!string.IsNullOrWhiteSpace(_offerQuery) && !SelectableInviteOffers.Any())
                                {
                                    <div class="form-text text-warning">@L["TeacherApply_OfferSearchEmpty"]</div>
                                }
                            }
                        </div>
                        @if (SelectedOffer is { } selected)
                        {
                            <div class="col-12">
                                <div class="ex-offer-recap">
                                    <strong>@selected.Name</strong>
                                    @if (!string.IsNullOrWhiteSpace(selected.Code))
                                    {
                                        <span class="small text-muted">@selected.Code</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(selected.ShortDescription))
                                    {
                                        <p class="mb-0">@selected.ShortDescription</p>
                                    }
                                    <div>@L["TeacherApply_Subject"] : @selected.Name</div>
                                    @if (SchoolLevelCatalog.FormatLevels(selected.Levels) is { Length: > 0 } lvls)
                                    {
                                        <div>@L["TeacherApply_Level"] : @lvls</div>
                                    }
                                    <div>@L["TeacherApply_Price"]: @(selected.RecommendedPrice?.ToString("N0") ?? "—") @GroupOfferCurrencyRules.FormatCurrencyLabel(selected.Currency)</div>
                                    <div class="form-text mb-0">@L["TeacherApply_OfferLockedHint"]</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ta-mode">@L["TeacherApply_Mode"]</label>
                                <select id="ta-mode" class="form-select" @bind="_offerMode">
                                    <option value="En ligne">En ligne</option>
                                    <option value="Présentiel">Présentiel</option>
                                    <option value="Hybride">Hybride</option>
                                </select>
                            </div>
                        }
                        else if (_invite.Offers is null || _invite.Offers.Count == 0)
                        {
                            <div class="col-md-6">
                                <label class="form-label" for="ta-subject">@L["TeacherApply_Subject"]</label>
                                <input id="ta-subject" class="form-control" @bind="_offerSubject" placeholder="Mathématiques, Français…" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ta-level">@L["TeacherApply_Level"]</label>
                                <select id="ta-level" class="form-select" @bind="_offerLevel">
                                    <option>Tous niveaux</option>
                                    <option>Primaire</option>
                                    <option>Collège</option>
                                    <option>Lycée</option>
                                    <option>Université</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="ta-mode">@L["TeacherApply_Mode"]</label>
                                <select id="ta-mode" class="form-select" @bind="_offerMode">
                                    <option value="En ligne">En ligne</option>
                                    <option value="Présentiel">Présentiel</option>
                                    <option value="Hybride">Hybride</option>
                                </select>
                            </div>
                        }
                    </div>
                }
                else if (_step == 4)
                {
                    <h2>@L["TeacherApply_Step4"]</h2>
                    <div class="ex-billing-toggle mb-3" role="group">
                        <button type="button" class="ex-billing-option @(_billing == "hourly" ? "active" : null)"
                                @onclick='() => _billing = "hourly"'>
                            <strong>@L["TeacherApply_Hourly"]</strong>
                            <span>@L["TeacherApply_HourlyHint"]</span>
                        </button>
                        <button type="button" class="ex-billing-option @(_billing == "monthly" ? "active" : null)"
                                @onclick='() => _billing = "monthly"'>
                            <strong>@L["TeacherApply_Monthly"]</strong>
                            <span>@L["TeacherApply_MonthlyHint"]</span>
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">@(_billing == "monthly" ? L["TeacherApply_Monthly"] : L["TeacherApply_Hourly"]) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" min="0" step="0.01" class="form-control" @bind="_price"
                                       disabled="@_catalogPriceLocked" readonly="@_catalogPriceLocked" />
                                <span class="input-group-text">@_currency @(_billing == "monthly" ? "/ mois" : "/ h")</span>
                            </div>
                            @if (_catalogPriceLocked)
                            {
                                <div class="form-text">@L["TeacherApply_PriceFromCatalog"]</div>
                            }
                        </div>
                        @if (_billing == "monthly")
                        {
                            <div class="col-md-4">
                                <label class="form-label">@L["TeacherApply_HoursPerWeek"] *</label>
                                <input type="number" min="0.5" step="0.5" class="form-control" @bind="_hoursPerWeek" />
                            </div>
                        }
                        <div class="col-md-4">
                            <label class="form-label">@L["TeacherApply_SessionMin"] <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <select class="form-select" @bind="_sessionMin">
                                    <option value="30">30</option>
                                    <option value="45">45</option>
                                    <option value="60">60</option>
                                    <option value="90">90</option>
                                </select>
                                <span class="input-group-text">min</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["TeacherApply_TimeZone"]</label>
                            <select class="form-select" @bind="_timeZone">
                                @foreach (var tz in TimeZoneCatalog.All)
                                {
                                    <option value="@tz.Id">@tz.Id (@TimeZoneCatalog.UtcOffsetLabel(tz.Id))</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label mb-2">@L["TeacherApply_Availability"]</label>
                            <div class="ex-avail-table">
                                <div class="ex-avail-cols">
                                    <span>@L["TeacherApply_Day"]</span>
                                    <span>@L["TeacherApply_Ranges"]</span>
                                </div>
                                @foreach (var day in Days)
                                {
                                    var sched = _avail[day];
                                    <div class="ex-avail-day @(sched.Enabled ? "is-on" : null)">
                                        <label class="ex-avail-check">
                                            <input type="checkbox" checked="@sched.Enabled"
                                                   @onchange="e => ToggleDay(day, e)" />
                                            <span>@day</span>
                                        </label>
                                        <div class="ex-avail-ranges">
                                            @if (!sched.Enabled)
                                            {
                                                <span class="ex-avail-off">@L["TeacherApply_Unavailable"]</span>
                                            }
                                            else
                                            {
                                                @for (var i = 0; i < sched.Ranges.Count; i++)
                                                {
                                                    var idx = i;
                                                    var range = sched.Ranges[idx];
                                                    <div class="ex-avail-range">
                                                        <span>@L["TeacherApply_From"]</span>
                                                        <input type="time" class="form-control form-control-sm"
                                                               value="@range.Start"
                                                               @onchange="e => SetRange(day, idx, true, e.Value?.ToString())" />
                                                        <span>@L["TeacherApply_To"]</span>
                                                        <input type="time" class="form-control form-control-sm"
                                                               value="@range.End"
                                                               @onchange="e => SetRange(day, idx, false, e.Value?.ToString())" />
                                                        <button type="button" class="ex-avail-del" title="@L["TeacherApply_RemoveRange"]"
                                                                @onclick="() => RemoveRange(day, idx)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                        @if (!string.IsNullOrWhiteSpace(range.Error))
                                                        {
                                                            <div class="ex-avail-error">@range.Error</div>
                                                        }
                                                    </div>
                                                }
                                                <button type="button" class="ex-avail-add" @onclick="() => AddRange(day)">
                                                    + @L["TeacherApply_AddRange"]
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else if (_step == 5)
                {
                    <h2>@L["TeacherApply_Step5"]</h2>
                    <p class="text-muted">@L["TeacherApply_Step5Lead"]</p>
                    <div class="alert alert-info py-2">@L["TeacherApply_PasswordLater"]</div>
                    <div class="teacher-apply-legal-stack">
                        <details class="teacher-apply-legal">
                            <summary>@L["TeacherApply_AdmissionTitle"]</summary>
                            <div class="teacher-apply-legal-body">
                                <ol>
                                    <li>@L["TeacherApply_Admission1"]</li>
                                    <li>@L["TeacherApply_Admission2"]</li>
                                    <li>@L["TeacherApply_Admission3"]</li>
                                    <li>@L["TeacherApply_Admission4"]</li>
                                </ol>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="ta-adm" @bind="_admission" />
                                    <label class="form-check-label" for="ta-adm">@L["TeacherApply_AcceptAdmission"]</label>
                                </div>
                            </div>
                        </details>
                        <details class="teacher-apply-legal">
                            <summary>@L["TeacherConduct_Title"]</summary>
                            <div class="teacher-apply-legal-body">
                                <p>@L["TeacherConduct_Intro"]</p>
                                <ul>
                                    <li>@L["TeacherConduct_Bullet_Trust"]</li>
                                    <li>@L["TeacherConduct_Bullet_Respect"]</li>
                                    <li>@L["TeacherConduct_Bullet_Safety"]</li>
                                    <li>@L["TeacherConduct_Bullet_Report"]</li>
                                    <li>@L["TeacherConduct_Bullet_Privacy"]</li>
                                    <li>@L["TeacherConduct_Bullet_Ethics"]</li>
                                </ul>
                                <p class="small text-muted">@L["TeacherConduct_LegalNote"]</p>
                                <a class="small d-inline-block mb-3" href="@TeacherConductPolicy.PublicPath" target="_blank" rel="noopener">
                                    @L["TeacherConduct_ReadFull"] <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="ta-cond" @bind="_conduct" />
                                    <label class="form-check-label" for="ta-cond">@L["TeacherConduct_AcceptCheckbox"]</label>
                                </div>
                            </div>
                        </details>
                        <details class="teacher-apply-legal">
                            <summary>@L["Privacy_Title"]</summary>
                            <div class="teacher-apply-legal-body">
                                <p>@L["Privacy_Intro"]</p>
                                <ul>
                                    <li>@L["Privacy_Bullet_Data"]</li>
                                    <li>@L["Privacy_Bullet_Purpose"]</li>
                                    <li>@L["Privacy_Bullet_Rights"]</li>
                                </ul>
                                <a class="small d-inline-block mb-3" href="@ExpertConductPolicy.PrivacyPath" target="_blank" rel="noopener">
                                    @L["ExpertJoin_ReadPrivacy"] <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="ta-priv" @bind="_privacy" />
                                    <label class="form-check-label" for="ta-priv">@L["Privacy_AcceptCheckbox"]</label>
                                </div>
                            </div>
                        </details>
                    </div>
                }
                else
                {
                    <h2>@L["TeacherApply_Step6"]</h2>
                    <p class="text-muted">@L["TeacherApply_PreviewHint"]</p>
                    <dl class="teacher-apply-recap">
                        <dt>@L["Label_FirstName"] / @L["Label_LastName"]</dt>
                        <dd>@_firstName @_lastName</dd>
                        <dt>@L["Label_Email"]</dt>
                        <dd>@ApplyEmail</dd>
                        <dt>@L["Expert_RegisterCity"]</dt>
                        <dd>@_city · @CountryDisplay</dd>
                        <dt>@L["TeacherApply_Slug"]</dt>
                        <dd>/profil/@_slug</dd>
                        <dt>@L["TeacherApply_Offer"]</dt>
                        <dd>@OfferTitle · @_price.ToString("N0") @_currency</dd>
                        <dt>@L["TeacherApply_Subject"]</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_offerSubject) ? "—" : _offerSubject) · @_offerLevel · @_offerMode</dd>
                        <dt>@L["TeacherApply_Availability"]</dt>
                        <dd>@AvailabilitySummary</dd>
                    </dl>
                }

                <div class="ex-wizard-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelOrBack">
                        @(_step == 1 ? L["Common_Cancel"] : L["TeacherApply_Back"])
                    </button>
                    @if (_step < 6)
                    {
                        <button type="button" class="btn expert-join-submit" @onclick="NextAsync">@L["TeacherApply_Next"] →</button>
                    }
                    else
                    {
                        <button type="button" class="btn expert-join-submit" disabled="@_busy" @onclick="SubmitAsync">
                            @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            @(_invite.IsProfileUpdate ? L["TeacherApply_SubmitUpdate"] : L["TeacherApply_Submit"])
                        </button>
                    }
                </div>
            </div>

            <aside class="ta-form-aside">
                <div class="ta-aside-card ta-aside-photo">
                    <div class="ta-teacher-photo">
                        @if (!string.IsNullOrWhiteSpace(_photoDataUrl))
                        {
                            <img src="@_photoDataUrl" alt="@L["TeacherApply_PhotoAside"]" />
                        }
                        else
                        {
                            <div class="ta-teacher-photo-placeholder" aria-hidden="true">
                                <i class="bi bi-person-badge"></i>
                                <span>@L["TeacherApply_PhotoAside"]</span>
                            </div>
                        }
                    </div>
                    <h2>@L["TeacherApply_HelpTitle"]</h2>
                    <p>@L["TeacherApply_HelpBody"]</p>
                    <a class="btn ta-aside-help-btn" href="mailto:support@tutorsphere.com">
                        <i class="bi bi-envelope"></i> @L["TeacherApply_HelpCta"]
                    </a>
                </div>
                <div class="ta-aside-card ta-aside-secure">
                    <i class="bi bi-shield-lock"></i>
                    <div>
                        <strong>@L["TeacherApply_SecureTitle"]</strong>
                        <span>@L["TeacherApply_SecureBody"]</span>
                    </div>
                </div>
                <blockquote class="ta-aside-quote">
                    <p>@L["TeacherApply_Quote"]</p>
                </blockquote>
            </aside>
            </div>
        }
    </div>
</div>

@code {
    private static readonly List<string> _stepsDefault = ["1", "2", "3", "4", "5", "6"];
    private List<string> _steps = _stepsDefault;
    private List<string> _stepHints = [];
    private static readonly string[] Days = ["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi", "Dimanche"];

    private bool _onForm;
    private string? _token;
    private bool _loading = true;
    private bool _busy;
    private bool _done;
    private string? _error;
    private TeacherInviteInfoResponse? _invite;
    private int _step = 1;

    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private DateTime? _birthDate;
    private string? _country;
    private string? _phone;
    private string _city = "";
    private string? _address;
    private string? _postal;
    private string? _addressError;
    private List<string> _languages = [SupportedLanguageCodes.French];
    private string PrimaryLanguage => TeacherCommunicationLanguages.Primary(_languages);
    private string _slug = "";
    private string? _autoSlug;
    private bool? _slugAvailable;
    private CancellationTokenSource? _slugCts;
    private string? _presentation;
    private int _yearsExperience;
    private readonly List<TeacherCredentialDraft> _diplomas = [];
    private readonly List<TeacherCredentialDraft> _certs = [];
    private string _offerPick = "";
    private string _offerQuery = "";
    private string _offerTitle = "";
    private string? _offerSubject;
    private string _offerLevel = "Tous niveaux";
    private string _offerMode = "En ligne";
    private string _billing = "hourly";
    private decimal _price;
    private decimal _hoursPerWeek = 4;
    private int _sessionMin = 60;
    private string _timeZone = "Africa/Abidjan";
    private string _currency = "XAF";
    private bool _conduct;
    private bool _privacy;
    private bool _admission;
    private string? _photoName;
    private string? _photoContentType;
    private string? _photoDataUrl;
    private byte[]? _photoBytes;
    private readonly Dictionary<string, DaySchedule> _avail = Days.ToDictionary(d => d, _ => new DaySchedule());

    private string GroupLabel => _invite is null
        ? ""
        : string.IsNullOrWhiteSpace(_invite.GroupCountryCode)
            ? _invite.ExpertGroupName
            : $"{_invite.ExpertGroupName} ({_invite.GroupCountryCode})";

    private string InviterGivenName
    {
        get
        {
            var given = TeacherPublicName.GivenNameFromDisplay(_invite?.InviterName);
            if (given.Length > 0)
                return given;
            return L["TeacherApply_AGroup"];
        }
    }

    private string GroupLogoUrl => MediaUrlHelper.Resolve(_invite?.GroupLogoUrl, Config, Navigation);

    private void BeginForm()
    {
        _error = null;
        _onForm = true;
        _step = 1;
    }

    private void BackToIntro()
    {
        _error = null;
        _onForm = false;
    }

    private bool EmailLocked => !string.IsNullOrWhiteSpace(_invite?.Email);

    /// <summary>Lien d’invitation unique (sans e-mail destinataire).</summary>
    private bool IsOpenInvite => _invite is not null && string.IsNullOrWhiteSpace(_invite.Email);

    /// <summary>
    /// Le pays du groupe n'est plus qu'une indication : dès qu'il n'en déclare pas, c'est à
    /// l'enseignant d'indiquer où il réside, sinon le champ resterait vide sans recours.
    /// </summary>
    private bool CanSelectCountry =>
        IsOpenInvite
        || _invite?.GroupIsInternational == true
        || string.IsNullOrWhiteSpace(_invite?.GroupCountryCode);

    private string ApplyEmail => EmailLocked ? _invite!.Email!.Trim() : _email.Trim();

    private string ResidenceCountryCode =>
        !string.IsNullOrWhiteSpace(_country)
            ? _country!
            : (_invite?.GroupCountryCode ?? "");

    private DateTime? EffectiveBirthDate =>
        _birthDate is DateTime d && d.Year >= 1900 ? d.Date : null;

    private string CountryDisplay
    {
        get
        {
            var code = ResidenceCountryCode;
            if (string.IsNullOrWhiteSpace(code))
                return CanSelectCountry ? "" : "🌐 International";
            var info = CountryCatalog.Find(code);
            return info is null ? code : $"{info.Flag} {info.Name}";
        }
    }

    private string PhoneAddon
    {
        get
        {
            var code = ResidenceCountryCode;
            var flag = CountryCatalog.Find(code)?.Flag ?? "🌐";
            var dial = CountryCatalog.DialPrefix(code);
            return string.IsNullOrWhiteSpace(dial) ? flag : $"{flag} {dial}";
        }
    }

    private string PhonePlaceholder =>
        CountryCatalog.DialPrefix(ResidenceCountryCode) is { Length: > 0 } dial
            ? $"{dial} …"
            : "Numéro de téléphone";

    private TeacherInvitePublicOfferDto? SelectedOffer =>
        Guid.TryParse(_offerPick, out var id)
            ? _invite?.Offers?.FirstOrDefault(o => o.Id == id)
            : null;

    private IEnumerable<TeacherInvitePublicOfferDto> SelectableInviteOffers
    {
        get
        {
            var offers = _invite?.Offers ?? [];
            var q = _offerQuery.Trim();
            if (string.IsNullOrWhiteSpace(q))
                return offers;
            return offers.Where(o =>
                (o.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (o.Code?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (o.ShortDescription?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (SelectedOffer is { } sel && sel.Id == o.Id));
        }
    }

    private bool _catalogPriceLocked => SelectedOffer?.RecommendedPrice is > 0;

    private string OfferTitle => SelectedOffer?.Name ?? (string.IsNullOrWhiteSpace(_offerTitle) ? "—" : _offerTitle.Trim());

    private string AvailabilitySummary
    {
        get
        {
            var parts = Days
                .Where(d => _avail[d].Enabled && _avail[d].Ranges.Count > 0)
                .Select(d => $"{d[..3]} {string.Join(", ", _avail[d].Ranges.Select(r => $"{r.Start}–{r.End}"))}");
            return parts.Any() ? string.Join(" · ", parts) : "—";
        }
    }

    private bool SlugOk => !string.IsNullOrWhiteSpace(_slug)
        && Regex.IsMatch(_slug, @"^[a-z0-9]([a-z0-9-]{1,48}[a-z0-9])?$");

    protected override async Task OnInitializedAsync()
    {
        _steps =
        [
            L["TeacherApply_Step1"],
            L["TeacherApply_Step2"],
            L["TeacherApply_Step3"],
            L["TeacherApply_Step4"],
            L["TeacherApply_Step5"],
            L["TeacherApply_Step6"]
        ];
        _stepHints =
        [
            L["TeacherApply_Step1Hint"],
            L["TeacherApply_Step2Hint"],
            L["TeacherApply_Step3Hint"],
            L["TeacherApply_Step4Hint"],
            L["TeacherApply_Step5Hint"],
            L["TeacherApply_Step6Hint"]
        ];

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("invite", out var invite))
            _token = invite.ToString();

        if (string.IsNullOrWhiteSpace(_token))
        {
            _error = L["Error_InviteRequired"];
            _loading = false;
            return;
        }

        try
        {
            var response = await Http.GetAsync($"api/auth/teacher-invite/{Uri.EscapeDataString(_token)}");
            if (!response.IsSuccessStatusCode)
            {
                _error = L["ExpertJoin_NotFound"];
                return;
            }
            _invite = await response.Content.ReadFromJsonAsync<TeacherInviteInfoResponse>();
            if (_invite is not null)
            {
                _firstName = _invite.FirstName ?? "";
                _lastName = _invite.LastName ?? "";
                _email = _invite.Email ?? "";
                _city = _invite.City ?? "";
                _presentation = _invite.Presentation;
                _languages = [SupportedLanguageCodes.Normalize(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)];
                _country = string.IsNullOrWhiteSpace(_invite.GroupCountryCode)
                    ? null
                    : _invite.GroupCountryCode;
                _timeZone = string.IsNullOrWhiteSpace(_invite.TimeZone)
                    ? TimeZoneCatalog.DefaultForCountry(ResidenceCountryCode)
                    : _invite.TimeZone;
                _currency = GroupOfferCurrencyRules.ResolveCurrency(ResidenceCountryCode);
                if (_invite.IsProfileUpdate && !string.IsNullOrWhiteSpace(_invite.ExistingSlug))
                {
                    _slug = _invite.ExistingSlug;
                    _autoSlug = _slug;
                    _slugAvailable = true;
                }
                else if (!string.IsNullOrWhiteSpace(_firstName))
                    await OnNameChanged();
                _onForm = !IsOpenInvite || _invite.IsProfileUpdate;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private void CancelOrBack()
    {
        if (_step == 1)
        {
            if (IsOpenInvite)
            {
                BackToIntro();
                return;
            }
            Navigation.NavigateTo("/");
            return;
        }
        _error = null;
        _step--;
    }

    private async Task NextAsync()
    {
        _error = null;
        if (_step == 1)
        {
            if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName)
                || string.IsNullOrWhiteSpace(_city))
            {
                _error = L["TeacherApply_NeedIdentity"];
                return;
            }
            if (CanSelectCountry && CountryCatalog.Find(_country) is null)
            {
                _error = L["TeacherApply_NeedCountry"];
                return;
            }
            if (!EmailLocked && (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@', StringComparison.Ordinal)))
            {
                _error = "Indiquez une adresse e-mail valide.";
                return;
            }
            if (_languages.Count == 0)
            {
                _error = L["TeacherApply_LanguageNeed"];
                return;
            }
            RefreshAddressCoherence();
            if (!string.IsNullOrWhiteSpace(_addressError))
            {
                _error = _addressError;
                return;
            }
        }
        else if (_step == 2)
        {
            if (!SlugOk) { _error = L["Error_InvalidSubdomain"]; return; }
            if (_slugAvailable == false
                && !(_invite.IsProfileUpdate
                     && string.Equals(_slug, _invite.ExistingSlug, StringComparison.OrdinalIgnoreCase)))
            {
                _error = L["Error_SlugTaken"];
                return;
            }
        }
        else if (_step == 3)
        {
            if (_invite?.Offers is { Count: > 0 } && SelectedOffer is null)
            {
                _error = L["TeacherApply_NeedOffer"];
                return;
            }
            if ((_invite?.Offers is null || _invite.Offers.Count == 0) && string.IsNullOrWhiteSpace(_offerTitle))
            {
                _error = L["TeacherApply_NeedOfferTitle"];
                return;
            }
        }
        else if (_step == 4)
        {
            if (_price <= 0) { _error = L["TeacherApply_NeedPrice"]; return; }
            if (_billing == "monthly" && _hoursPerWeek <= 0)
            { _error = L["TeacherApply_NeedHours"]; return; }
            var availError = ValidateAvailabilities();
            if (availError is not null)
            {
                _error = availError;
                return;
            }
        }
        else if (_step == 5)
        {
            if (!_admission || !_conduct || !_privacy)
            { _error = L["TeacherApply_MustAccept"]; return; }
        }
        _step++;
        await Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        if (_invite is null || string.IsNullOrWhiteSpace(_token))
            return;
        _busy = true;
        _error = null;
        try
        {
            var ranges = FlattenAvailabilities();
            var monthly = _billing == "monthly";
            var sessionMinutes = _sessionMin > 0 ? _sessionMin : 60;
            var windowsPerWeek = ranges.Sum(r => CountWindows(r.StartTime, r.EndTime, sessionMinutes));
            var sessionsPerWeek = monthly
                ? Math.Max(1, (int)Math.Ceiling((double)_hoursPerWeek * 60 / sessionMinutes))
                : Math.Max(1, windowsPerWeek);
            var sessionCount = Math.Max(1, sessionsPerWeek * 4);
            var schoolName = $"{_firstName.Trim()} {_lastName.Trim()}".Trim();
            var selected = SelectedOffer;
            var title = selected?.Name ?? _offerTitle.Trim();
            var slots = ranges.Select(r => new OfferingScheduleSlotDto(r.Day, r.StartTime, r.EndTime)).ToList();

            var request = new RegisterSchoolRequest(
                SchoolName: schoolName,
                Slug: _slug.Trim().ToLowerInvariant(),
                FirstName: _firstName.Trim(),
                LastName: _lastName.Trim(),
                Email: ApplyEmail,
                Password: "",
                City: _city.Trim(),
                Country: ResidenceCountryCode,
                PreferredLanguage: PrimaryLanguage,
                CommunicationLanguages: _languages,
                AcceptedTeacherConductPolicy: true,
                TeacherConductPolicyVersion: TeacherConductPolicy.CurrentVersion,
                InviteToken: _token,
                Phone: ComposePhone(),
                Address: string.IsNullOrWhiteSpace(_address) ? null : _address.Trim(),
                PostalCode: string.IsNullOrWhiteSpace(_postal) ? null : _postal.Trim(),
                DateOfBirth: EffectiveBirthDate,
                Presentation: _presentation,
                YearsExperience: _yearsExperience,
                Diplomas: ToCredentials(_diplomas),
                Certifications: ToCredentials(_certs),
                TimeZone: _timeZone,
                Availabilities: ranges,
                GroupOfferId: selected?.Id,
                PhotoBase64: _photoDataUrl,
                PhotoContentType: _photoContentType,
                InitialOffering: new CreateSubscriptionOfferingRequest(
                    Title: title,
                    Description: _presentation,
                    Subject: string.IsNullOrWhiteSpace(_offerSubject) ? null : _offerSubject.Trim(),
                    Price: _price,
                    Currency: _currency,
                    DurationDays: monthly ? 30 : 7,
                    SessionCount: sessionCount,
                    Frequency: monthly
                        ? $"{_hoursPerWeek:0.##} h/semaine · forfait mensuel"
                        : $"Taux horaire · {sessionMinutes} min",
                    Mode: _offerMode,
                    Schedule: new OfferingScheduleDto(
                        monthly ? "mois" : "semaine",
                        "weekly",
                        sessionMinutes,
                        _offerLevel,
                        null,
                        slots,
                        BillingMode: _billing,
                        HourlyRate: monthly ? (decimal?)null : _price,
                        HoursPerWeek: monthly ? _hoursPerWeek : (decimal?)null,
                        TimeZone: _timeZone)));

            var response = await Http.PostAsJsonAsync("api/auth/register-school", request);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = TryError(body) ?? L["Error_CreateSchool"];
                return;
            }
            _done = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private string? ComposePhone()
    {
        if (string.IsNullOrWhiteSpace(_phone))
            return null;
        var local = _phone.Trim();
        var dial = CountryCatalog.DialPrefix(ResidenceCountryCode);
        if (string.IsNullOrWhiteSpace(dial) || local.StartsWith('+'))
            return local;
        return $"{dial} {local}";
    }

    private void OnCountryChanged(string? code)
    {
        _country = code;
        _timeZone = TimeZoneCatalog.DefaultForCountry(code);
        if (SelectedOffer is null || string.IsNullOrWhiteSpace(SelectedOffer.Currency))
            _currency = GroupOfferCurrencyRules.ResolveCurrency(code);
        RefreshAddressCoherence();
    }

    private void RefreshAddressCoherence()
    {
        var issue = AddressCoherence.Evaluate(ResidenceCountryCode, _city, _postal, _address, _phone);
        _addressError = issue is null
            ? null
            : AddressCoherence.FormatMessage(issue, iso => CountryCatalog.Find(iso)?.Name ?? iso);
    }

    private void OnOfferChanged()
    {
        var offer = SelectedOffer;
        if (offer is null) return;
        _offerTitle = offer.Name;
        _offerSubject = offer.Name;
        if (offer.Levels is { Count: > 0 }
            && SchoolLevelCatalog.FormatLevels(offer.Levels) is { Length: > 0 } lv)
            _offerLevel = lv;
        if (offer.RecommendedPrice is decimal p && p > 0)
            _price = p;
        if (!string.IsNullOrWhiteSpace(offer.Currency))
            _currency = offer.Currency;
    }

    private void OnLanguagesChanged(List<string> next) =>
        _languages = next.Count == 0 ? [SupportedLanguageCodes.French] : next;

    private static IReadOnlyList<PublicCredentialDto> ToCredentials(List<TeacherCredentialDraft> rows) =>
        TeacherOnboardingPortfolio.Clean(rows.Select(r => new PublicCredentialDto(r.Title, r.Institution, r.Year)));

    private async Task OnNameChanged()
    {
        if (!string.IsNullOrWhiteSpace(_slug) && _slug != _autoSlug) return;
        if (_invite is { IsProfileUpdate: true } && !string.IsNullOrWhiteSpace(_invite.ExistingSlug)
            && _slug == _invite.ExistingSlug)
            return;
        var generated = Slugify(_firstName, _lastName);
        _autoSlug = generated;
        _slug = generated;
        await AfterSlugChanged();
    }

    private async Task AfterSlugChanged()
    {
        _slug = _slug.Trim().ToLowerInvariant();
        _slugAvailable = null;
        if (!SlugOk) return;
        _slugCts?.Cancel();
        _slugCts = new CancellationTokenSource();
        var token = _slugCts.Token;
        try
        {
            await Task.Delay(400, token);
            var r = await Http.GetFromJsonAsync<SlugOkDto>($"api/tenants/check-slug/{Uri.EscapeDataString(_slug)}", token);
            if (!token.IsCancellationRequested && r is not null)
            {
                _slugAvailable = r.Available
                    || (_invite is { IsProfileUpdate: true }
                        && string.Equals(_slug, _invite.ExistingSlug, StringComparison.OrdinalIgnoreCase));
            }
        }
        catch (OperationCanceledException) { }
        catch { }
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (file.Size > 2 * 1024 * 1024)
        {
            _error = L["TeacherApply_PhotoTooBig"];
            _photoBytes = null;
            _photoDataUrl = null;
            _photoName = null;
            return;
        }
        _error = null;
        _photoName = file.Name;
        _photoContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
        await using var stream = file.OpenReadStream(2 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _photoBytes = ms.ToArray();
        _photoDataUrl = $"data:{_photoContentType};base64,{Convert.ToBase64String(_photoBytes)}";
    }

    private static string Slugify(string a, string b)
    {
        var combined = $"{a} {b}".Trim();
        if (string.IsNullOrWhiteSpace(combined)) return "";
        var n = combined.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in n)
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        var slug = Regex.Replace(
            sb.ToString().Normalize(System.Text.NormalizationForm.FormC).ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');
        return slug.Length > 40 ? slug[..40].Trim('-') : slug;
    }

    private string OfferOptionLabel(TeacherInvitePublicOfferDto o)
    {
        var price = o.RecommendedPrice is decimal p ? p.ToString("N0") : "—";
        var cur = GroupOfferCurrencyRules.FormatCurrencyLabel(o.Currency);
        return string.IsNullOrWhiteSpace(o.Code)
            ? $"{o.Name} · {price} {cur}"
            : $"{o.Name} ({o.Code}) · {price} {cur}";
    }

    private void ToggleDay(string day, ChangeEventArgs e)
    {
        var on = e.Value is bool x ? x : bool.TryParse(e.Value?.ToString(), out var p) && p;
        var sched = _avail[day];
        sched.Enabled = on;
        if (on && sched.Ranges.Count == 0)
            sched.Ranges.Add(new TimeRange());
        ValidateDay(day);
    }

    private void AddRange(string day)
    {
        var sched = _avail[day];
        sched.Enabled = true;
        sched.Ranges.Add(new TimeRange());
        ValidateDay(day);
    }

    private void RemoveRange(string day, int index)
    {
        var sched = _avail[day];
        if (index < 0 || index >= sched.Ranges.Count) return;
        sched.Ranges.RemoveAt(index);
        if (sched.Ranges.Count == 0)
            sched.Enabled = false;
        ValidateDay(day);
    }

    private void SetRange(string day, int index, bool isStart, string? value)
    {
        var sched = _avail[day];
        if (index < 0 || index >= sched.Ranges.Count) return;
        if (isStart) sched.Ranges[index].Start = string.IsNullOrWhiteSpace(value) ? "08:00" : value;
        else sched.Ranges[index].End = string.IsNullOrWhiteSpace(value) ? "12:00" : value;
        ValidateDay(day);
    }

    private string? ValidateAvailabilities()
    {
        var any = false;
        foreach (var day in Days)
        {
            ValidateDay(day);
            var sched = _avail[day];
            if (!sched.Enabled) continue;
            if (sched.Ranges.Count == 0)
                return string.Format(L["TeacherApply_NeedRangeForDay"], day);
            foreach (var r in sched.Ranges)
            {
                if (!string.IsNullOrWhiteSpace(r.Error))
                    return r.Error;
            }
            any = true;
        }
        return any ? null : L["TeacherApply_NeedAvailability"].Value;
    }

    private void ValidateDay(string day)
    {
        var sched = _avail[day];
        foreach (var r in sched.Ranges)
            r.Error = null;
        if (!sched.Enabled) return;
        foreach (var r in sched.Ranges)
        {
            if (!AvailabilityWindows.TryParseTime(r.Start, out var start)
                || !AvailabilityWindows.TryParseTime(r.End, out var end))
            {
                r.Error = L["TeacherApply_NeedTimes"];
                continue;
            }
            if (end <= start)
                r.Error = L["TeacherApply_EndAfterStart"];
        }
    }

    private List<TeacherAvailabilityRangeDto> FlattenAvailabilities()
    {
        var list = new List<TeacherAvailabilityRangeDto>();
        foreach (var day in Days)
        {
            var sched = _avail[day];
            if (!sched.Enabled) continue;
            foreach (var r in sched.Ranges)
                list.Add(new TeacherAvailabilityRangeDto(day, r.Start, r.End));
        }
        return list;
    }

    private static int CountWindows(string start, string end, int sessionMin)
    {
        if (!AvailabilityWindows.TryParseTime(start, out var s)
            || !AvailabilityWindows.TryParseTime(end, out var e) || e <= s)
            return 0;
        return AvailabilityWindows.CountBookingSlots(s, e, sessionMin);
    }

    private static string? TryError(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("error", out var e))
                return e.GetString();
        }
        catch { }
        return null;
    }

    private sealed class DaySchedule
    {
        public bool Enabled { get; set; }
        public List<TimeRange> Ranges { get; set; } = [];
    }

    private sealed class TimeRange
    {
        public string Start { get; set; } = "08:00";
        public string End { get; set; } = "12:00";
        public string? Error { get; set; }
    }

    private sealed class SlugOkDto { public bool Available { get; set; } }
}
