@page "/student/tutors/{Slug}"
@layout StudentLayout
@rendermode InteractiveServer
@using TutorSphere.Application.DTOs.Branding
@inject IStringLocalizer<SharedResources> L
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>@(Profile?.DisplayName ?? L["Nav_FindTutor"]) — TutorSphere</PageTitle>

<div class="ts-page-header">
    <div>
        @if (!IsParentManaged)
        {
            <a href="/student/search" class="tutor-detail-back">
                <i class="bi bi-arrow-left"></i> Retour à la recherche
            </a>
        }
        else
        {
            <a href="/student/dashboard" class="tutor-detail-back">
                <i class="bi bi-arrow-left"></i> Retour à l’accueil
            </a>
        }
        <h1><i class="bi bi-person-badge me-2"></i>Profil de l’enseignant</h1>
        <p class="ts-page-subtitle">Consultez les offres et abonnez-vous</p>
    </div>
</div>

@if (_loading)
{
    <div class="loading-state">
        <div class="loading-spinner"></div>
        <span>@L["Loading"]</span>
    </div>
}
else if (_notFound || Profile is null)
{
    <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-person-x"></i></div>
        <h2 class="h5">Profil introuvable</h2>
        <p class="text-muted">Cet enseignant n’est pas disponible ou son profil n’est pas public.</p>
        @if (!IsParentManaged)
        {
            <a class="btn btn-primary mt-2" href="/student/search">@L["Nav_FindTutor"]</a>
        }
        else
        {
            <a class="btn btn-primary mt-2" href="/student/dashboard">Accueil</a>
        }
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-circle me-2"></i>@_error
    </div>
}
else
{
    <TutorDetailView Profile="Profile" AllowSelfSubscribe="@(!IsParentManaged && _me?.IsAutonomous == true)" />
}

@code {
    [Parameter] public string Slug { get; set; } = "";

    private TeacherPublicProfileDto? Profile { get; set; }
    private StudentDto? _me;
    private bool _loading = true;
    private bool _notFound;
    private string? _error;

    private bool IsParentManaged =>
        Auth.IsParentManagedStudent || _me?.ParentProfileId is not null;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _notFound = false;
        Profile = null;

        try
        {
            try { await Auth.EnsureSessionRestoredAsync(); } catch { }

            try { _me = await Api.GetAsync<StudentDto>("api/students/me"); }
            catch { _me = null; }

            if (IsParentManaged)
            {
                Navigation.NavigateTo("/student/dashboard", replace: true);
                return;
            }

            var url = $"api/branding/{Uri.EscapeDataString(Slug)}/tutor";
            if (!string.IsNullOrWhiteSpace(_me?.Country))
                url += $"?viewerCountry={Uri.EscapeDataString(_me.Country)}";
            Profile = await Api.GetAsync<TeacherPublicProfileDto>(url);
            _notFound = Profile is null;
        }
        catch
        {
            _error = L["Search_Error_Load"];
        }
        finally
        {
            _loading = false;
        }
    }
}
