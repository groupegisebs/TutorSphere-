@page "/student/coverage"
@layout StudentLayout
@rendermode InteractiveServer
@inject ApiClient Api
@inject AuthService Auth

<PageTitle>Remplacements — TutorSphere</PageTitle>

<div class="ts-page-header">
    <div>
        <h1><i class="bi bi-person-bounding-box me-2"></i>Remplacements</h1>
        <p class="ts-page-subtitle">
            Si votre enseignant est indisponible, un suppléant du même groupe peut être proposé. Le cours reste le même ; seul l'enseignant change si vous acceptez.
        </p>
    </div>
</div>

@if (_loading)
{
    <div class="d-flex align-items-center gap-2 py-4">
        <span class="spinner-border spinner-border-sm text-primary"></span>
        <span class="text-muted">Chargement…</span>
    </div>
}
else if (_pending.Count == 0)
{
    <p class="text-muted">Aucun remplacement en attente. Les élèves accompagnés par un parent voient cette demande dans l'espace parent.</p>
}
else
{
    <LessonCoverageRespondPanel Items="_pending"
                                Title="Un remplaçant vous est proposé"
                                Subtitle="Vous continuez le cours. Seul l'enseignant change si vous acceptez."
                                Error="_error" Busy="_busy"
                                OnApprove="id => RespondAsync(id, true)"
                                OnReject="id => RespondAsync(id, false)" />
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private List<LessonCoverageDto> _pending = [];

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _pending = await Api.GetAsync<List<LessonCoverageDto>>("api/students/lesson-coverage/pending") ?? [];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private async Task RespondAsync(Guid id, bool approve)
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.PostWithErrorAsync<LessonCoverageDto>(
                $"api/students/lesson-coverage/{id}/respond",
                new RespondLessonCoverageRequest(approve));
            if (result.Error is not null) { _error = result.Error; return; }
            await ReloadAsync();
        }
        finally { _busy = false; }
    }
}
