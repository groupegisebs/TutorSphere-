@page "/expert/meetings"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Réunions — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar">
            <div class="ex-page-head">
                <span class="ex-page-icon"><i class="bi bi-camera-video"></i></span>
                <div>
                    <h1 class="cc-page-title">Réunions</h1>
                    <p class="cc-page-sub">Planifiez et tenez les réunions du groupe d’experts directement dans TutorSphere.</p>
                </div>
            </div>
            <a class="cc-btn cc-btn-primary" href="/expert/meetings/create"><i class="bi bi-plus-lg"></i> Créer une réunion</a>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        <div class="cc-card">
            @if (_loading)
            {
                <div class="cc-empty"><span class="spinner-border"></span></div>
            }
            else if (_items.Count == 0)
            {
                <p class="text-muted mb-0">Aucune réunion pour le moment. Créez la première pour votre groupe.</p>
            }
            else
            {
                <table class="cc-table">
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Statut</th>
                            <th>Début</th>
                            <th>Organisateur</th>
                            <th>Participants</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _items)
                        {
                            <tr>
                                <td>
                                    <strong>@m.Title</strong>
                                    @if (m.AiEnabled) { <span class="mtg-pill mtg-pill-ai">IA</span> }
                                </td>
                                <td><span class="mtg-status mtg-status-@((int)m.Status)">@StatusFr(m.Status)</span></td>
                                <td>@(m.StartAtUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                                <td>@m.OrganizerName</td>
                                <td>@m.ParticipantCount</td>
                                <td class="text-end">
                                    @if (m.Status is 1 or 2)
                                    {
                                        <a class="cc-btn cc-btn-primary cc-btn-sm" href="@($"/expert/meetings/{m.Id}/room")">Rejoindre</a>
                                    }
                                    @if (m.Status == 3)
                                    {
                                        <a class="cc-btn cc-btn-sm" href="@($"/expert/meetings/{m.Id}/minutes")">Compte rendu</a>
                                    }
                                    @if (m.IsOrganizer && m.Status != 4)
                                    {
                                        <button type="button" class="cc-btn cc-btn-sm" @onclick="() => OpenCodeAsync(m)">Code d’accès</button>
                                    }
                                    @if (m.Status is 0 or 1 && m.IsOrganizer)
                                    {
                                        <button type="button" class="cc-btn cc-btn-sm" @onclick="() => CancelAsync(m.Id)">Annuler</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <p class="text-muted">Connectez-vous pour voir les réunions.</p>
    </NotAuthorized>
</AuthorizeView>

@if (_codeMeetingId is not null)
{
    <div class="ts-modal-backdrop" @onclick="CloseCode">
        <div class="ts-modal" @onclick:stopPropagation="true">
            <div class="ts-modal-header">
                <h2>Code d’accès — @_codeTitle</h2>
                <button class="ts-modal-close" @onclick="CloseCode"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="ts-modal-body">
                @if (!string.IsNullOrEmpty(_codeError))
                {
                    <div class="alert alert-danger">@_codeError</div>
                }
                <p class="text-muted">
                    Les membres du groupe saisissent ce code pour entrer dans la salle. Il est rappelé dans les
                    invitations et les rappels envoyés par courriel.
                </p>
                <label class="form-label">Code de la réunion</label>
                <input class="form-control mtg-code-input" maxlength="16" autocomplete="off" @bind="_codeInput" />
                <p class="text-muted small mt-1">4 à 16 lettres ou chiffres. Laissez vide et régénérez pour un nouveau code tiré au hasard.</p>
                @if (_codeGuests.Count > 0)
                {
                    <hr />
                    <label class="form-label">Codes d’invitation des invités externes</label>
                    <p class="text-muted small">
                        Chaque invité reçoit son propre code dans son invitation et le saisit une seule fois.
                        Renvoyer une invitation attribue un nouveau code.
                    </p>
                    <ul class="list-unstyled mb-0">
                        @foreach (var g in _codeGuests)
                        {
                            <li class="d-flex justify-content-between align-items-center gap-2 py-1">
                                <span>@g.FullName <span class="text-muted small">@g.Email</span></span>
                                <strong class="mtg-code-input">@(g.AccessCode ?? "—")</strong>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="ts-modal-footer">
                <button type="button" class="cc-btn" disabled="@_codeBusy" @onclick="RegenerateCodeAsync">Régénérer</button>
                <button type="button" class="cc-btn cc-btn-primary" disabled="@_codeBusy" @onclick="SaveCodeAsync">Enregistrer</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<Item> _items = [];
    private bool _loading = true;
    private string? _error;
    private Guid? _codeMeetingId;
    private string _codeTitle = "";
    private string _codeInput = "";
    private string? _codeError;
    private bool _codeBusy;
    private readonly List<GuestCode> _codeGuests = [];

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureSessionRestoredAsync();
        try
        {
            _items.Clear();
            _items.AddRange(await Api.GetAsync<List<Item>>("api/expert/meetings") ?? []);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task OpenCodeAsync(Item m)
    {
        _codeMeetingId = m.Id;
        _codeTitle = m.Title;
        _codeError = null;
        _codeInput = "";
        _codeGuests.Clear();
        var detail = await Api.GetAsync<CodeDetail>($"api/expert/meetings/{m.Id}");
        _codeInput = detail?.AccessCode ?? "";
        if (detail?.ExternalGuests is { Count: > 0 } guests)
            _codeGuests.AddRange(guests.Where(g => !g.Revoked));
    }

    private void CloseCode()
    {
        _codeMeetingId = null;
        _codeError = null;
    }

    private Task SaveCodeAsync() => ApplyCodeAsync(_codeInput);
    private Task RegenerateCodeAsync() => ApplyCodeAsync(null);

    private async Task ApplyCodeAsync(string? code)
    {
        if (_codeMeetingId is not Guid id) return;
        _codeError = null;
        _codeBusy = true;
        try
        {
            var r = await Api.PostWithErrorAsync<CodeDetail>(
                $"api/expert/meetings/{id}/access-code", new { code });
            if (r.Error is not null) { _codeError = r.Error; return; }
            _codeInput = r.Value?.Code ?? _codeInput;
        }
        finally { _codeBusy = false; }
    }

    private async Task CancelAsync(Guid id)
    {
        var r = await Api.PostWithErrorAsync<object>($"api/expert/meetings/{id}/cancel", new { });
        if (r.Error is not null) { _error = r.Error; return; }
        await OnInitializedAsync();
    }

    private static string StatusFr(int s) => s switch
    {
        0 => "Brouillon",
        1 => "Programmée",
        2 => "En cours",
        3 => "Terminée",
        4 => "Annulée",
        _ => "—"
    };

    /// <summary>Le détail expose le code en clair uniquement aux organisateurs et modérateurs.</summary>
    private sealed class CodeDetail
    {
        public string? AccessCode { get; set; }
        public string? Code { get; set; }
        public List<GuestCode>? ExternalGuests { get; set; }
    }

    private sealed class GuestCode
    {
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public bool Revoked { get; set; }
        public string? AccessCode { get; set; }
    }

    private sealed class Item
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public int Status { get; set; }
        public int Visibility { get; set; }
        public DateTime? StartAtUtc { get; set; }
        public DateTime? EndAtUtc { get; set; }
        public string TimeZoneId { get; set; } = "";
        public string OrganizerName { get; set; } = "";
        public int ParticipantCount { get; set; }
        public bool AiEnabled { get; set; }
        public bool IsOrganizer { get; set; }
    }
}
