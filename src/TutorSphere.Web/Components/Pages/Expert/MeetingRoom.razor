@page "/expert/meetings/{Id:guid}/room"
@page "/admin/meetings/{Id:guid}/room"
@layout MeetingRoomLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject RealtimeMeetingClient Rt
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>@(_detail?.Title ?? "Réunion") — TutorSphere</PageTitle>

@if (_codeGate)
{
    <div class="mtg-wait mtg-gate">
        <button type="button" class="mtg-back" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Retour
        </button>
        <h1>Code de la réunion</h1>
        <p>@(_detail?.Title ?? "Réunion") — saisissez le code reçu dans votre invitation.</p>
        <input class="form-control mtg-gate-input" maxlength="16" autocomplete="off"
               placeholder="Ex. K7M2QD" @bind="_code" @bind:event="oninput" @onkeydown="GateKey" />
        @if (!string.IsNullOrEmpty(_error)) { <p class="mtg-gate-error">@_error</p> }
        <button class="cc-btn cc-btn-primary" type="button" disabled="@_gateBusy" @onclick="SubmitCodeAsync">
            @(_gateBusy ? "Vérification…" : "Entrer dans la salle")
        </button>
        @if (!string.IsNullOrEmpty(_detail?.AccessCode))
        {
            <p class="mtg-gate-hint">Code de cette réunion (organisateur) : <strong>@_detail.AccessCode</strong></p>
        }
    </div>
}
else if (_replaced)
{
    <div class="mtg-wait">
        <button type="button" class="mtg-back" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Retour
        </button>
        <h1>Session reprise ailleurs</h1>
        <p>Vous avez rejoint cette réunion depuis un autre onglet ou un autre appareil.</p>
        <p class="mtg-gate-hint">
            Cet onglet a libéré votre micro et votre caméra : deux sessions ouvertes en même temps
            renvoient votre voix en écho. Continuez sur l’autre onglet, ou revenez ici.
        </p>
        <button class="cc-btn cc-btn-primary" type="button" @onclick="RetryJoinAsync">Reprendre ici</button>
    </div>
}
else if (_roomFull)
{
    <div class="mtg-wait">
        <button type="button" class="mtg-back" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Retour
        </button>
        <h1>Salle complète</h1>
        <p>@(_error ?? "La réunion a atteint son nombre maximum de participants.")</p>
        <p>Réessayez dans quelques minutes : une place se libérera peut-être.</p>
        <button class="cc-btn cc-btn-primary" type="button" @onclick="RetryJoinAsync">Réessayer</button>
    </div>
}
else if (_waiting)
{
    <div class="mtg-wait">
        <button type="button" class="mtg-back" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Retour
        </button>
        <h1>Salle d’attente</h1>
        <p>L’organisateur va bientôt vous faire entrer.</p>
        <p class="mtg-gate-hint">Gardez cette page ouverte : vous entrerez dès qu’il vous admettra.</p>
    </div>
}
else if (_detail is null && !string.IsNullOrEmpty(_error))
{
    <div class="mtg-wait">
        <button type="button" class="mtg-back" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Retour
        </button>
        <p>@_error</p>
    </div>
}
else if (_detail is not null)
{
    <div class="mtg-room">
        @if (_menu is not null)
        {
            @* Voile de fermeture : rendu seulement menu ouvert, pour ne pas router chaque clic de la salle. *@
            <div class="mtg-menu-veil" @onclick="CloseMenus"></div>
        }
        <header class="mtg-top">
            <div class="mtg-brand">
                <span class="mtg-brand-mark"><i class="bi bi-hexagon-fill"></i></span>
                <span class="mtg-brand-name">TutorSphere</span>
            </div>
            <div class="mtg-top-meeting">
                <span class="mtg-top-title">@_detail.Title <i class="bi bi-lock-fill" title="Réunion privée"></i></span>
                <span class="mtg-top-sub">Réunion du groupe</span>
            </div>
            <div class="mtg-menu-wrap" @onclick:stopPropagation="true">
                <button type="button" class="mtg-pill" @onclick='() => Menu("info")'>
                    <i class="bi bi-info-circle"></i> Informations
                </button>
                @if (_menu == "info")
                {
                    <div class="mtg-pop mtg-pop-info">
                        <h5>@_detail.Title</h5>
                        <dl>
                            <dt>Organisateur</dt>
                            <dd>@(string.IsNullOrWhiteSpace(_detail.OrganizerName) ? "—" : _detail.OrganizerName)</dd>
                            <dt>Début</dt>
                            <dd>@(_detail.StartAtUtc?.ToLocalTime().ToString("dddd d MMMM · HH:mm") ?? "—")</dd>
                            <dt>Ordre du jour</dt>
                            <dd>@(string.IsNullOrWhiteSpace(_detail.Agenda) ? "Non précisé" : _detail.Agenda)</dd>
                            @if (!string.IsNullOrEmpty(_detail.AccessCode))
                            {
                                <dt>Code de la réunion</dt>
                                <dd class="mtg-pop-code">@_detail.AccessCode</dd>
                            }
                        </dl>
                    </div>
                }
            </div>
            <div class="mtg-top-right">
                <span class="mtg-timer">@FormatElapsed(_elapsed)</span>
                @if (_recording) { <span class="mtg-rec"><i class="bi bi-record-circle-fill"></i> Enregistrement</span> }
                @if (_detail.AiActivatedByOrganizer) { <span class="mtg-ai-badge">IA active</span> }
                <span class="mtg-net"><i class="bi bi-reception-4"></i> Connexion stable</span>
                <button type="button" class="mtg-pill mtg-pill-solid" @onclick="OpenInvite">
                    <i class="bi bi-person-plus"></i> Inviter
                </button>
                <div class="mtg-menu-wrap" @onclick:stopPropagation="true">
                    <button type="button" class="mtg-icon-btn" title="Plus d’options" @onclick='() => Menu("top")'>
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    @if (_menu == "top")
                    {
                        <div class="mtg-pop mtg-pop-end">
                            <button type="button" @onclick='() => OpenTab("notes")'><i class="bi bi-journal-text"></i> Notes partagées</button>
                            <button type="button" @onclick="ShareBoardAsync"><i class="bi bi-easel"></i> Partager le tableau blanc</button>
                            @if (_sharing)
                            {
                                <button type="button" class="is-danger" @onclick="StopShareAsync"><i class="bi bi-stop-circle"></i> Arrêter le partage</button>
                            }
                            @if (_isOrganizer)
                            {
                                <button type="button" @onclick="ToggleRecAsync">
                                    <i class="bi bi-record-circle"></i> @(_recording ? "Arrêter l’enregistrement" : "Enregistrer")
                                </button>
                                <button type="button" @onclick="LockAsync"><i class="bi bi-lock"></i> Verrouiller la réunion</button>
                            }
                        </div>
                    }
                </div>
            </div>
        </header>
        @if (_detail.AiActivatedByOrganizer && _allConsented)
        {
            <div class="mtg-consent-bar">Tous les participants ont consenti à l’utilisation de l’IA <button type="button" @onclick="() => _allConsented = false">×</button></div>
        }
        @if (_aiPrompt)
        {
            <div class="mtg-consent-modal">
                <h3>Activer l’assistant IA ?</h3>
                <p>Transcription structurée, résumé, décisions et actions proposées. Aucune action n’est créée sans validation.</p>
                <p>En continuant, vous acceptez le traitement des données de cette réunion.</p>
                <button class="cc-btn" type="button" @onclick="() => _aiPrompt = false">Annuler</button>
                <button class="cc-btn cc-btn-primary" type="button" @onclick="ConfirmAiAsync">Activer et demander le consentement</button>
            </div>
        }
        @if (_consentAsk)
        {
            <div class="mtg-consent-modal">
                <h3>Consentement IA</h3>
                <p>L’organisateur a activé l’assistant IA. Acceptez-vous l’analyse de cette discussion ?</p>
                <button class="cc-btn cc-btn-primary" type="button" @onclick="() => ConsentAsync(true)">J’accepte</button>
                <button class="cc-btn" type="button" @onclick="() => ConsentAsync(false)">Je refuse</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_mediaError))
        {
            <div class="mtg-media-warn">
                <i class="bi bi-exclamation-triangle"></i> @_mediaError
                @if (!_scriptsReady)
                {
                    <button type="button" class="mtg-media-retry" @onclick="RetryMediaAsync">Réessayer</button>
                }
                <button type="button" @onclick="() => _mediaError = null">×</button>
            </div>
        }
        @if (_sharing)
        {
            <div class="mtg-share-bar">
                <i class="bi @(_sharingBoard ? "bi-easel" : "bi-display")"></i>
                @(_sharingBoard ? "Vous partagez le tableau blanc." : "Vous partagez votre écran.")
                <button type="button" @onclick="StopShareAsync">
                    <i class="bi bi-stop-circle"></i> Arrêter le partage
                </button>
            </div>
        }
        @* Sans geste de l'utilisateur, le navigateur coupe le son des participants sans rien dire :
           l'impression est celle d'une salle muette. Le bouton fournit ce geste. *@
        @if (_audioBlocked)
        {
            <div class="mtg-media-warn">
                <i class="bi bi-volume-mute"></i> Le navigateur bloque le son des participants.
                <button type="button" class="mtg-media-retry" @onclick="EnableAudioAsync">Activer le son</button>
                <button type="button" @onclick="() => _audioBlocked = false">×</button>
            </div>
        }
        @* Sans réduction d'écho, le son des autres repart dans le micro : chacun s'entend
           revenir avec le retard du réseau, et seul un casque y met fin. *@
        @if (_echoRisk)
        {
            <div class="mtg-media-warn">
                <i class="bi bi-headphones"></i>
                Ce micro n’a pas de réduction d’écho : utilisez un casque, sinon les autres
                s’entendront parler en différé.
                <button type="button" @onclick="() => _echoRisk = false">×</button>
            </div>
        }

        @* Sur téléphone, le panneau latéral est replié par défaut (voir la feuille de style) :
           ouvert, il ne laissait qu'une bande d'image. *@
        <div class="mtg-room-body @(_sideOpen ? "is-side-open" : "")">
            <div class="mtg-stage">
                <div class="mtg-notice"><i class="bi bi-info-circle"></i> @NoticeText</div>
                @* Locuteur en grand, les autres en vignettes : à taille égale, sur un téléphone,
                   trois tuiles se marchent dessus et plus personne n'est lisible. *@
                <div class="mtg-grid @(_peers.Count == 0 ? "is-solo" : "is-spot")"
                     style="--thumbs:@Math.Max(1, _peers.Count)">
                    <div class="@TileCss(string.Empty, true)" @onclick="() => TogglePin(string.Empty)"
                         title="@PinHint(string.Empty)">
                        @if (_mic)
                        {
                            <span class="mtg-tile-live"><i class="bi bi-volume-up-fill"></i></span>
                        }
                        @if (_pinned == string.Empty)
                        {
                            <span class="mtg-tile-pin"><i class="bi bi-pin-angle-fill"></i></span>
                        }
                        @* is-hidden au départ : le JS l'enlève dès qu'une piste vidéo est réellement publiée. *@
                        <video class="is-hidden" data-rtc-local @ref="_localVideo" autoplay playsinline muted></video>
                        <span class="mtg-av mtg-av-lg" style="background:@AvatarBg(_selfName)">
                            @Initials(_selfName)
                            @if (!SelfHasVideo)
                            {
                                <span class="mtg-av-cam"><i class="bi bi-camera-video-off-fill"></i></span>
                            }
                        </span>
                        <div class="mtg-tile-foot">
                            <span class="mtg-tile-id">
                                @_selfName (vous)
                                <span class="mtg-badge @RoleCls(SelfRole)">@RoleLabel(SelfRole)</span>
                            </span>
                            <span class="mtg-tile-mic @(_mic ? "is-on" : "")">
                                <i class="bi @(_mic ? "bi-mic-fill" : "bi-mic-mute-fill")"></i>
                                <span class="mtg-tile-mic-lb">@(_mic ? "Micro activé" : "Micro désactivé")</span>
                            </span>
                        </div>
                        <div class="mtg-menu-wrap mtg-tile-menu" @onclick:stopPropagation="true">
                            <button type="button" title="Options" @onclick='() => Menu("self")'><i class="bi bi-three-dots"></i></button>
                            @if (_menu == "self")
                            {
                                <div class="mtg-pop mtg-pop-up mtg-pop-end">
                                    <button type="button" @onclick="ToggleMic"><i class="bi bi-mic"></i> @(_mic ? "Couper mon micro" : "Activer mon micro")</button>
                                    <button type="button" @onclick="ToggleCam"><i class="bi bi-camera-video"></i> @(_cam ? "Couper ma caméra" : "Activer ma caméra")</button>
                                    @if (_sharing)
                                    {
                                        <button type="button" class="is-danger" @onclick="StopShareAsync"><i class="bi bi-stop-circle"></i> Arrêter le partage</button>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="ShareAsync"><i class="bi bi-display"></i> Partager mon écran</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    @* @key indispensable : sans lui, Blazor réutilise la balise vidéo d'un pair pour
                       un autre en changeant simplement data-rtc-peer. Le flux déjà accroché reste
                       sur la mauvaise tuile et le nouveau pair n'en reçoit aucun. *@
                    @foreach (var p in _peers)
                    {
                        <div class="@TileCss(p.ConnectionId, false)" @key="p.ConnectionId"
                             @onclick="() => TogglePin(p.ConnectionId)" title="@PinHint(p.ConnectionId)">
                            <video class="is-hidden" data-rtc-peer="@p.ConnectionId" autoplay playsinline></video>
                            @if (_pinned == p.ConnectionId)
                            {
                                <span class="mtg-tile-pin"><i class="bi bi-pin-angle-fill"></i></span>
                            }
                            <span class="mtg-av" style="background:@AvatarBg(p.DisplayName)">
                                @Initials(p.DisplayName)
                                @if (!p.CamOn)
                                {
                                    <span class="mtg-av-cam"><i class="bi bi-camera-video-off-fill"></i></span>
                                }
                            </span>
                            @if (p.HandRaised)
                            {
                                <span class="mtg-tile-hand"><i class="bi bi-hand-index-thumb-fill"></i></span>
                            }
                            <div class="mtg-tile-foot">
                                <span class="mtg-tile-id">
                                    @p.DisplayName
                                    <span class="mtg-dot">•</span>
                                    <span class="mtg-tile-role">@RoleName(p.Role)</span>
                                    <span class="mtg-badge @RoleCls(p.Role)">@RoleLabel(p.Role)</span>
                                </span>
                                <span class="mtg-tile-mic @(p.MicOn ? "is-on" : "")">
                                    <i class="bi @(p.MicOn ? "bi-mic-fill" : "bi-mic-mute-fill")"></i>
                                    <span class="mtg-tile-mic-lb">@(p.MicOn ? "Micro activé" : "Micro désactivé")</span>
                                </span>
                            </div>
                            @if (_isOrganizer)
                            {
                                <div class="mtg-menu-wrap mtg-tile-menu" @onclick:stopPropagation="true">
                                    <button type="button" title="Options" @onclick='() => Menu($"tile:{p.ConnectionId}")'><i class="bi bi-three-dots"></i></button>
                                    @if (_menu == $"tile:{p.ConnectionId}")
                                    {
                                        <div class="mtg-pop mtg-pop-up mtg-pop-end">
                                            <button type="button" @onclick="() => ForceMuteAsync(p.ConnectionId)"><i class="bi bi-mic-mute"></i> Couper son micro</button>
                                            <button type="button" class="is-danger" @onclick="() => KickAsync(p.ConnectionId)"><i class="bi bi-person-dash"></i> Exclure de la réunion</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_caption))
                {
                    <div class="mtg-cc">[CC] @_caption</div>
                }
                <div class="mtg-dockwrap">
                    <div class="mtg-react">
                        <button type="button" @onclick='() => Rt.ReactAsync(Id, "👍")'>👍</button>
                        <button type="button" @onclick='() => Rt.ReactAsync(Id, "👏")'>👏</button>
                        <button type="button" @onclick='() => Rt.ReactAsync(Id, "❤️")'>❤️</button>
                        <button type="button" @onclick='() => Rt.ReactAsync(Id, "🎉")'>🎉</button>
                    </div>
                    <div class="mtg-dock">
                        <div class="mtg-dock-item" @onclick:stopPropagation="true">
                            <button type="button" class="mtg-dock-btn @(_mic ? "" : "is-off")" @onclick="ToggleMic">
                                <span class="mtg-dock-ic"><i class="bi @(_mic ? "bi-mic-fill" : "bi-mic-mute-fill")"></i></span>
                                <span class="mtg-dock-lb">Micro</span>
                            </button>
                            <button type="button" class="mtg-dock-chev" @onclick='() => Menu("mic")'><i class="bi bi-chevron-up"></i></button>
                            @if (_menu == "mic")
                            {
                                <div class="mtg-pop mtg-pop-up">
                                    <button type="button" @onclick="ToggleMic"><i class="bi bi-mic"></i> @(_mic ? "Couper mon micro" : "Activer mon micro")</button>
                                    @if (_isOrganizer && _peers.Count > 0)
                                    {
                                        <button type="button" @onclick="MuteEveryoneAsync"><i class="bi bi-mic-mute"></i> Couper le micro de tous</button>
                                    }
                                    <span class="mtg-pop-note">@_micLabel</span>
                                </div>
                            }
                        </div>
                        <div class="mtg-dock-item" @onclick:stopPropagation="true">
                            <button type="button" class="mtg-dock-btn @(_cam ? "" : "is-off")" @onclick="ToggleCam">
                                <span class="mtg-dock-ic"><i class="bi @(_cam ? "bi-camera-video-fill" : "bi-camera-video-off-fill")"></i></span>
                                <span class="mtg-dock-lb">Caméra</span>
                            </button>
                            <button type="button" class="mtg-dock-chev" @onclick='() => Menu("cam")'><i class="bi bi-chevron-up"></i></button>
                            @if (_menu == "cam")
                            {
                                <div class="mtg-pop mtg-pop-up">
                                    <button type="button" @onclick="ToggleCam"><i class="bi bi-camera-video"></i> @(_cam ? "Couper ma caméra" : "Activer ma caméra")</button>
                                    <button type="button" @onclick="ToggleBlurAsync"><i class="bi bi-circle-half"></i> @(_blur ? "Retirer le flou" : "Flouter l’arrière-plan")</button>
                                    <span class="mtg-pop-note">@_camLabel</span>
                                </div>
                            }
                        </div>
                        <button type="button" class="mtg-dock-btn @(_sharing ? "is-on" : "")" @onclick="ToggleShareAsync">
                            <span class="mtg-dock-ic"><i class="bi @(_sharing ? "bi-stop-circle-fill" : "bi-display")"></i></span>
                            <span class="mtg-dock-lb">@(_sharing ? "Arrêter" : "Partager")</span>
                        </button>
                        <button type="button" class="mtg-dock-btn" @onclick='() => OpenTab("chat")'>
                            <span class="mtg-dock-ic">
                                <i class="bi bi-chat-dots"></i>
                                @if (_unread > 0) { <span class="mtg-dock-badge">@_unread</span> }
                            </span>
                            <span class="mtg-dock-lb">Discussion</span>
                        </button>
                        <button type="button" class="mtg-dock-btn" @onclick='() => OpenTab("people")'>
                            <span class="mtg-dock-ic">
                                <i class="bi bi-people-fill"></i>
                                <span class="mtg-dock-badge is-violet">@(1 + _peers.Count)</span>
                            </span>
                            <span class="mtg-dock-lb">Participants</span>
                        </button>
                        <button type="button" class="mtg-dock-btn @(_hand ? "is-on" : "")" @onclick="ToggleHand">
                            <span class="mtg-dock-ic"><i class="bi bi-hand-index-thumb"></i></span>
                            <span class="mtg-dock-lb">Lever la main</span>
                        </button>
                        <div class="mtg-dock-item" @onclick:stopPropagation="true">
                            <button type="button" class="mtg-dock-btn" @onclick='() => Menu("more")'>
                                <span class="mtg-dock-ic"><i class="bi bi-three-dots"></i></span>
                                <span class="mtg-dock-lb">Plus</span>
                            </button>
                            @if (_menu == "more")
                            {
                                <div class="mtg-pop mtg-pop-up">
                                    <button type="button" @onclick='() => OpenTab("notes")'><i class="bi bi-journal-text"></i> Notes partagées</button>
                                    <button type="button" @onclick="ShareBoardAsync"><i class="bi bi-easel"></i> Tableau blanc</button>
                                    @if (_sharing)
                                    {
                                        <button type="button" class="is-danger" @onclick="StopShareAsync"><i class="bi bi-stop-circle"></i> Arrêter le partage</button>
                                    }
                                    <button type="button" @onclick='() => OpenTab("ai")'><i class="bi bi-stars"></i> Assistant IA</button>
                                    @if (_isOrganizer)
                                    {
                                        <button type="button" @onclick="ToggleRecAsync">
                                            <i class="bi bi-record-circle"></i> @(_recording ? "Arrêter l’enregistrement" : "Enregistrer")
                                        </button>
                                        <button type="button" @onclick="LockAsync"><i class="bi bi-lock"></i> Verrouiller</button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="mtg-dock-item mtg-dock-end" @onclick:stopPropagation="true">
                            <button type="button" class="mtg-leave" @onclick="LeaveAsync">
                                <i class="bi bi-telephone-x-fill"></i> Quitter
                            </button>
                            <button type="button" class="mtg-dock-chev" @onclick='() => Menu("leave")'><i class="bi bi-chevron-down"></i></button>
                            @if (_menu == "leave")
                            {
                                <div class="mtg-pop mtg-pop-up mtg-pop-end">
                                    <button type="button" @onclick="LeaveOnlyAsync"><i class="bi bi-box-arrow-right"></i> Quitter la réunion</button>
                                    @if (_isOrganizer)
                                    {
                                        <button type="button" class="is-danger" @onclick="EndForAllAsync"><i class="bi bi-stop-circle"></i> Terminer pour tous</button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <aside class="mtg-side @(_sideOpen ? "is-open" : "")">
                <div class="mtg-side-tabs">
                    <button type="button" class="@TabCls("chat")" @onclick='() => OpenTab("chat")'>
                        <i class="bi bi-chat-dots"></i><span>Discussion</span>
                    </button>
                    <button type="button" class="@TabCls("people")" @onclick='() => OpenTab("people")'>
                        <i class="bi bi-people-fill"></i><span>Participants (@(1 + _peers.Count))</span>
                        @if (!_waiting && _waitingList.Count > 0)
                        {
                            <span class="mtg-tab-badge" title="En attente d’admission">@_waitingList.Count</span>
                        }
                    </button>
                    <button type="button" class="@TabCls("notes")" @onclick='() => OpenTab("notes")'>
                        <i class="bi bi-journal-text"></i><span>Notes</span>
                    </button>
                    <button type="button" class="@TabCls("ai")" @onclick='() => OpenTab("ai")'>
                        <i class="bi bi-stars"></i><span>Assistant IA</span>
                    </button>
                </div>

                @if (_tab == "chat")
                {
                    <div class="mtg-side-body mtg-chat">
                        @if (_chat.Count == 0)
                        {
                            <p class="mtg-empty">Aucun message pour l’instant.</p>
                        }
                        @foreach (var m in _chat)
                        {
                            <div class="mtg-msg">
                                <span class="mtg-av mtg-av-sm" style="background:@AvatarBg(m.SenderName)">@Initials(m.SenderName)</span>
                                <div>
                                    <span class="mtg-msg-head">@m.SenderName <time>@m.SentAtUtc.ToLocalTime().ToString("HH:mm")</time></span>
                                    <p>@m.Text</p>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="mtg-chat-in">
                        <input @bind="_chatIn" @onkeydown="ChatKey" placeholder="Écrire un message…" />
                        <button type="button" title="Envoyer" @onclick="SendChat"><i class="bi bi-send-fill"></i></button>
                    </div>
                }
                else if (_tab == "people")
                {
                    <div class="mtg-side-body">
                        <div class="mtg-search-row">
                            <span class="mtg-search">
                                <i class="bi bi-search"></i>
                                <input placeholder="Rechercher un participant" @bind="_search" @bind:event="oninput" />
                            </span>
                            <button type="button" class="mtg-btn-primary" @onclick="OpenInvite"><i class="bi bi-plus-lg"></i> Inviter</button>
                        </div>

                        @* Réunion sur invitation : toute personne déjà dans la salle peut faire entrer
                           les arrivants. Réunion libre : le lien a pu circuler, l'organisateur seul décide. *@
                        @if (!_waiting)
                        {
                            <div class="mtg-wait-head">
                                <h5 class="mtg-group">
                                    Salle d’attente
                                    @if (_waitingList.Count > 0)
                                    {
                                        <span class="mtg-wait-count">@_waitingList.Count</span>
                                    }
                                </h5>
                                <div class="mtg-wait-tools">
                                    @if (_waitingList.Count > 1 && CanAdmit)
                                    {
                                        <button type="button" class="mtg-btn-mini" disabled="@_waitBusy" @onclick="AdmitAllAsync">Tout admettre</button>
                                    }
                                    <button type="button" class="mtg-btn-mini" disabled="@_waitBusy" title="Actualiser la file"
                                            @onclick="RefreshWaitingAsync">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                    @if (_isOrganizer)
                                    {
                                        <button type="button" class="mtg-wait-toggle @(WaitingRoomOn ? "is-on" : "")"
                                                disabled="@_waitBusy" @onclick="ToggleWaitingRoomAsync"
                                                title="@(WaitingRoomOn ? "Les arrivants patientent jusqu’à votre accord" : "Les invités entrent directement")">
                                            <i class="bi @(WaitingRoomOn ? "bi-shield-check" : "bi-shield-slash")"></i>
                                            @(WaitingRoomOn ? "Filtrage activé" : "Filtrage désactivé")
                                        </button>
                                    }
                                </div>
                            </div>
                            @if (_waitingList.Count == 0)
                            {
                                <p class="mtg-empty mtg-empty-sm">
                                    @(_isOrganizer && !WaitingRoomOn
                                        ? "Filtrage désactivé : les invités rejoignent la salle sans validation."
                                        : "Personne n’attend. Les personnes qui cliquent sur leur lien d’invitation apparaîtront ici avant d’entrer.")
                                </p>
                            }
                            else if (!CanAdmit)
                            {
                                <p class="mtg-empty mtg-empty-sm">
                                    Réunion libre : seul l’organisateur peut faire entrer les personnes en attente.
                                </p>
                            }
                            @foreach (var w in _waitingList)
                            {
                                <div class="mtg-prow is-waiting">
                                    <span class="mtg-av mtg-av-sm" style="background:@AvatarBg(w.DisplayName)">@Initials(w.DisplayName)</span>
                                    <span class="mtg-prow-name">
                                        @w.DisplayName
                                        <span class="mtg-badge @RoleCls(w.Role)">@RoleLabel(w.Role)</span>
                                    </span>
                                    @if (CanAdmit)
                                    {
                                        <button type="button" class="mtg-btn-mini is-admit" @onclick="() => AdmitAsync(w.ConnectionId)">Admettre</button>
                                        <button type="button" class="mtg-btn-mini is-danger" @onclick="() => DenyAsync(w.ConnectionId)">Refuser</button>
                                    }
                                </div>
                            }
                        }

                        <h5 class="mtg-group">Dans la réunion — @(1 + _peers.Count)</h5>
                        @if (Matches(_selfName))
                        {
                            <div class="mtg-prow">
                                <span class="mtg-av mtg-av-sm" style="background:@AvatarBg(_selfName)">@Initials(_selfName)</span>
                                <span class="mtg-prow-name">
                                    @_selfName (vous)
                                    <span class="mtg-badge @RoleCls(SelfRole)">@RoleLabel(SelfRole)</span>
                                </span>
                                <i class="bi @(_mic ? "bi-mic-fill" : "bi-mic-mute-fill") mtg-prow-mic @(_mic ? "is-on" : "")"></i>
                                <div class="mtg-menu-wrap" @onclick:stopPropagation="true">
                                    <button type="button" class="mtg-prow-menu" @onclick='() => Menu("row:self")'><i class="bi bi-three-dots-vertical"></i></button>
                                    @if (_menu == "row:self")
                                    {
                                        <div class="mtg-pop mtg-pop-end">
                                            <button type="button" @onclick="ToggleMic"><i class="bi bi-mic"></i> @(_mic ? "Couper mon micro" : "Activer mon micro")</button>
                                            <button type="button" @onclick="ToggleCam"><i class="bi bi-camera-video"></i> @(_cam ? "Couper ma caméra" : "Activer ma caméra")</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        @foreach (var p in _peers.Where(x => Matches(x.DisplayName)))
                        {
                            <div class="mtg-prow">
                                <span class="mtg-av mtg-av-sm" style="background:@AvatarBg(p.DisplayName)">@Initials(p.DisplayName)</span>
                                <span class="mtg-prow-name">
                                    @p.DisplayName
                                    <span class="mtg-badge @RoleCls(p.Role)">@RoleLabel(p.Role)</span>
                                </span>
                                @if (p.HandRaised)
                                {
                                    <i class="bi bi-hand-index-thumb-fill mtg-prow-hand"></i>
                                }
                                <i class="bi @(p.MicOn ? "bi-mic-fill" : "bi-mic-mute-fill") mtg-prow-mic @(p.MicOn ? "is-on" : "")"></i>
                                <div class="mtg-menu-wrap" @onclick:stopPropagation="true">
                                    <button type="button" class="mtg-prow-menu" @onclick='() => Menu($"row:{p.ConnectionId}")'><i class="bi bi-three-dots-vertical"></i></button>
                                    @if (_menu == $"row:{p.ConnectionId}")
                                    {
                                        <div class="mtg-pop mtg-pop-end">
                                            <button type="button" @onclick='() => OpenTab("chat")'><i class="bi bi-chat"></i> Écrire dans la discussion</button>
                                            @if (_isOrganizer)
                                            {
                                                <button type="button" @onclick="() => ForceMuteAsync(p.ConnectionId)"><i class="bi bi-mic-mute"></i> Couper son micro</button>
                                                <button type="button" class="is-danger" @onclick="() => KickAsync(p.ConnectionId)"><i class="bi bi-person-dash"></i> Exclure</button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @{
                            var guests = _peers.Where(x => IsGuest(x.Role) && Matches(x.DisplayName)).ToList();
                        }
                        @if (guests.Count > 0)
                        {
                            <h5 class="mtg-group">Invités externes</h5>
                            @foreach (var p in guests)
                            {
                                <div class="mtg-prow">
                                    <span class="mtg-av mtg-av-sm" style="background:@AvatarBg(p.DisplayName)">@Initials(p.DisplayName)</span>
                                    <span class="mtg-prow-name">
                                        @p.DisplayName
                                        <span class="mtg-badge is-ext">Invité externe</span>
                                        <i class="bi bi-patch-check-fill mtg-verified" title="Invitation vérifiée"></i>
                                    </span>
                                    <i class="bi @(p.MicOn ? "bi-mic-fill" : "bi-mic-mute-fill") mtg-prow-mic @(p.MicOn ? "is-on" : "")"></i>
                                    <div class="mtg-menu-wrap" @onclick:stopPropagation="true">
                                        <button type="button" class="mtg-prow-menu" @onclick='() => Menu($"guest:{p.ConnectionId}")'><i class="bi bi-three-dots-vertical"></i></button>
                                        @if (_menu == $"guest:{p.ConnectionId}")
                                        {
                                            <div class="mtg-pop mtg-pop-end">
                                                @if (_isOrganizer)
                                                {
                                                    <button type="button" @onclick="() => ForceMuteAsync(p.ConnectionId)"><i class="bi bi-mic-mute"></i> Couper son micro</button>
                                                    <button type="button" class="is-danger" @onclick="() => KickAsync(p.ConnectionId)"><i class="bi bi-person-dash"></i> Retirer l’invité</button>
                                                }
                                                else
                                                {
                                                    <span class="mtg-pop-note">Invitation vérifiée par code personnel.</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <div class="mtg-side-foot">
                        <button type="button" class="mtg-btn-ghost w-100" @onclick="CopyInviteAsync">
                            <i class="bi bi-link-45deg"></i> @(_copied ? "Lien copié" : "Copier le lien d’invitation")
                        </button>
                        <div class="mtg-ai-card">
                            <div>
                                <h4>@(_detail.AiActivatedByOrganizer ? "Assistant IA actif" : "Assistant IA désactivé")</h4>
                                @if (!_detail.AiActivatedByOrganizer && _isOrganizer)
                                {
                                    <button type="button" class="mtg-btn-ghost" @onclick="() => _aiPrompt = true">Activer la prise de notes IA</button>
                                }
                                <p>Capture les décisions, points clés et actions avec le consentement des participants.</p>
                            </div>
                            <i class="bi bi-shield-check mtg-ai-shield"></i>
                        </div>
                        <p class="mtg-privacy"><i class="bi bi-shield-lock"></i> Vos données restent confidentielles et sécurisées.</p>
                    </div>
                }
                else if (_tab == "notes")
                {
                    <div class="mtg-side-body">
                        <h5 class="mtg-group">Notes partagées</h5>
                        <textarea class="mtg-input" rows="10" @bind="_notes" @bind:event="oninput" @onblur="PushNotes"></textarea>
                        <h5 class="mtg-group">Tableau blanc</h5>
                        <canvas class="mtg-board" @ref="_board" width="480" height="280"></canvas>
                        <h5 class="mtg-group">Sondage</h5>
                        @if (_isOrganizer)
                        {
                            <div class="mtg-search-row">
                                <input class="mtg-input" placeholder="Question" @bind="_pollQ" />
                                <button type="button" class="mtg-btn-primary" @onclick="StartPoll">Lancer</button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(_pollQLive))
                        {
                            <p class="mtg-poll-q">@_pollQLive</p>
                            <div class="mtg-search-row">
                                <button type="button" class="mtg-btn-ghost" @onclick="() => Rt.VotePollAsync(Id, 0)">Oui</button>
                                <button type="button" class="mtg-btn-ghost" @onclick="() => Rt.VotePollAsync(Id, 1)">Non</button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="mtg-side-body">
                        <h5 class="mtg-group">
                            Assistant IA de réunion
                            @if (_detail.AiActivatedByOrganizer) { <span class="mtg-ai-badge">Analyse en cours</span> }
                        </h5>
                        @if (!_detail.AiActivatedByOrganizer)
                        {
                            <p class="mtg-hint">Désactivé par défaut. Seul l’organisateur peut l’activer, avec le consentement des participants.</p>
                            @if (_isOrganizer)
                            {
                                <button type="button" class="mtg-btn-primary" @onclick="() => _aiPrompt = true">Activer la prise de notes IA</button>
                            }
                        }
                        else
                        {
                            <p class="mtg-hint">Les réponses de l’IA peuvent contenir des erreurs. Les actions doivent être validées après la réunion.</p>
                            <input class="mtg-input" placeholder="Poser une question sur la réunion…" @bind="_aiQ" />
                        }
                        <div class="mtg-ai-card mt-3">
                            <div>
                                <h4>Confidentialité</h4>
                                <p>Capture les décisions, points clés et actions avec le consentement des participants.</p>
                            </div>
                            <i class="bi bi-shield-check mtg-ai-shield"></i>
                        </div>
                    </div>
                }
            </aside>
        </div>

        @if (_invite)
        {
            <div class="mtg-modal-back" @onclick="() => _invite = false">
                <div class="mtg-modal" @onclick:stopPropagation="true">
                    <h3>Inviter à cette réunion</h3>
                    @if (_detail.OpenJoinEnabled && !string.IsNullOrWhiteSpace(_detail.OpenJoinUrl))
                    {
                        <p class="mtg-hint">
                            Réunion libre : ce lien s’adresse à tout le monde, même sans compte
                            TutorSphere. L’invité saisit son nom et vous l’admettez depuis la salle
                            d’attente.
                            @if (_detail.MaxParticipants is int cap)
                            {
                                <text> Salle limitée à @cap personnes, vous compris.</text>
                            }
                        </p>
                        <label class="mtg-lbl">Lien à partager</label>
                        <input class="mtg-input" readonly value="@_detail.OpenJoinUrl" />
                        <div class="mtg-modal-actions">
                            <button type="button" class="mtg-btn-ghost" @onclick="() => _invite = false">Fermer</button>
                            <button type="button" class="mtg-btn-primary" @onclick="CopyOpenLinkAsync">
                                <i class="bi bi-link-45deg"></i> @(_copied ? "Lien copié" : "Copier le lien")
                            </button>
                        </div>
                        <label class="mtg-lbl mt-3">Lien réservé aux membres invités</label>
                        <input class="mtg-input" readonly value="@InviteLink" />
                    }
                    else
                    {
                        <p class="mtg-hint">Le lien contient déjà le code : le destinataire n’a qu’à cliquer pour entrer.</p>
                        <label class="mtg-lbl">Lien d’invitation</label>
                        <input class="mtg-input" readonly value="@InviteLink" />
                        @if (!string.IsNullOrEmpty(_detail.AccessCode))
                        {
                            <label class="mtg-lbl">Code de la réunion</label>
                            <p class="mtg-modal-code">@_detail.AccessCode</p>
                        }
                        <div class="mtg-modal-actions">
                            <button type="button" class="mtg-btn-ghost" @onclick="() => _invite = false">Fermer</button>
                            <button type="button" class="mtg-btn-primary" @onclick="CopyInviteAsync">
                                <i class="bi bi-link-45deg"></i> @(_copied ? "Lien copié" : "Copier le lien")
                            </button>
                        </div>
                        @if (_isOrganizer)
                        {
                            <p class="mtg-hint mt-3">
                                Besoin d’accueillir des personnes sans compte ? Ouvrez un lien libre :
                                elles n’auront qu’à donner leur nom, et vous seul les ferez entrer.
                            </p>
                            <button type="button" class="mtg-btn-ghost" disabled="@_openingLink" @onclick="OpenFreeLinkAsync">
                                <i class="bi bi-people"></i> Ouvrir un lien libre
                            </button>
                        }
                    }
                </div>
            </div>
        }
        @if (_toasts.Count > 0)
        {
            <div class="mtg-toasts">@foreach (var t in _toasts) { <div>@t</div> }</div>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? GuestToken { get; set; }
    [Parameter] public string? GuestName { get; set; }

    private Detail? _detail;
    private string? _error;
    private string _selfName = "";
    private string _tab = "people";
    /// <summary>Panneau latéral déplié. Sans effet sur grand écran, où il reste toujours visible.</summary>
    private bool _sideOpen;
    private bool _mic = true, _cam, _hand, _recording, _waiting, _aiPrompt, _consentAsk, _allConsented, _isOrganizer;
    private bool _codeGate, _gateBusy;
    private bool _sharing, _blur, _invite, _copied, _waitBusy, _openingLink;
    /// <summary>Salle pleine : l'arrivant est resté dehors, il faut le lui dire sans détour.</summary>
    private bool _roomFull;
    /// <summary>Cette session a cédé la place à un autre onglet du même participant.</summary>
    private bool _replaced;
    /// <summary>Micro sans réduction d'écho : le locuteur s'entendra revenir sans casque.</summary>
    private bool _echoRisk;
    /// <summary>Dernier locuteur détecté par le niveau sonore. Chaîne vide : moi.</summary>
    private string? _speaker;
    /// <summary>Mise en avant choisie à la main : elle prime sur la détection.</summary>
    private string? _pinned;
    /// <summary>Distingue le tableau blanc de l'écran, pour nommer le partage en cours.</summary>
    private bool _sharingBoard;
    private int _unread;
    private string? _menu;
    private string _search = "";
    private string _micLabel = "Micro par défaut", _camLabel = "Caméra par défaut";
    private string _code = "";
    private string _chatIn = "", _notes = "", _caption = "", _aiQ = "", _pollQ = "", _pollQLive = "";
    private readonly List<MeetingLivePeerDto> _peers = [];
    private readonly List<MeetingLivePeerDto> _waitingList = [];
    private readonly List<MeetingLiveChatDto> _chat = [];
    private readonly List<string> _toasts = [];
    private DotNetObjectReference<MeetingRoom>? _jsRef;
    private ElementReference _board;
    private ElementReference _localVideo;
    private string? _mediaError;
    private bool _mediaStarted, _inRoom, _scriptsReady;
    /// <summary>Un rendu a touché les tuiles : les flux distants doivent être réaccrochés.</summary>
    private bool _needRtcRemount;
    /// <summary>Le navigateur refuse de jouer le son des participants faute de geste utilisateur.</summary>
    private bool _audioBlocked;
    private int _cameraCount;
    private int _elapsed;
    private System.Timers.Timer? _timer;

    /// <summary>Retour de classroomMedia : état réel des périphériques après demande d'autorisation.</summary>
    private sealed class MediaStartResult
    {
        public bool Ok { get; set; }
        public bool Video { get; set; }
        public bool Audio { get; set; }
        public int Cameras { get; set; }
        public int Mics { get; set; }
        public string? Warning { get; set; }
        public string? Error { get; set; }
    }

    public sealed class MediaDevicesInfo
    {
        public int Cameras { get; set; }
        public int Mics { get; set; }
    }

    private sealed class DeviceList
    {
        public int Cameras { get; set; }
        public int Mics { get; set; }
        public string[]? CameraLabels { get; set; }
        public string[]? MicLabels { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var qs = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        GuestToken = qs.TryGetValue("guest", out var g) ? g.ToString() : GuestToken;
        GuestName = qs.TryGetValue("name", out var n) ? n.ToString() : GuestName;
        // Le lien reçu par courriel porte le code : un clic suffit, aucune saisie.
        _code = qs.TryGetValue("code", out var c) ? c.ToString() : _code;
        _waiting = qs.TryGetValue("wait", out _);

        if (string.IsNullOrEmpty(GuestToken))
            await Auth.EnsureSessionRestoredAsync(forceJs: true);

        if (string.IsNullOrEmpty(GuestToken))
        {
            var r = await Api.GetWithErrorAsync<Detail>($"api/expert/meetings/{Id}");
            if (r.Value is null)
            {
                _error = r.Error ?? "Réunion introuvable.";
                return;
            }
            _detail = r.Value;
            _isOrganizer = _detail.OrganizerUserId == Auth.UserId;
            _recording = _detail.RecordingEnabled;
            // Code fourni par l'URL : on le valide sans rien demander, sinon on affiche la saisie.
            if (_detail.RequiresAccessCode)
            {
                // L'organisateur et les modérateurs reçoivent le code dans le détail : rien à ressaisir.
                if (string.IsNullOrWhiteSpace(_code))
                    _code = _detail.AccessCode ?? "";
                if (string.IsNullOrWhiteSpace(_code))
                {
                    _codeGate = true;
                    return;
                }
                var check = await Api.PostWithErrorAsync<object>($"api/expert/meetings/{Id}/verify-code", new { code = _code });
                if (check.Error is not null)
                {
                    _error = check.Error;
                    _codeGate = true;
                    return;
                }
            }
        }
        else
        {
            _detail = new Detail(Id, "Réunion", null, 2, DateTime.UtcNow, null, "", "", true, true, true, true, false, false, false, false, false, "fr", false, null);
        }

        await EnterRoomAsync();
    }

    private async Task GateKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SubmitCodeAsync();
    }

    private async Task SubmitCodeAsync()
    {
        if (_gateBusy) return;
        _error = null;
        _gateBusy = true;
        try
        {
            var r = await Api.PostWithErrorAsync<object>($"api/expert/meetings/{Id}/verify-code", new { code = _code });
            if (r.Error is not null)
            {
                _error = r.Error;
                return;
            }
            _codeGate = false;
            await EnterRoomAsync();
        }
        finally { _gateBusy = false; }
    }

    /// <summary>
    /// Refus pour salle pleine : seule l'entrée est rejouée. Session reprise ailleurs : le média
    /// et les connexions ont été fermés, un rechargement complet repart d'un état propre.
    /// </summary>
    private async Task RetryJoinAsync()
    {
        if (_replaced)
        {
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
            return;
        }
        _roomFull = false;
        _error = null;
        var role = _isOrganizer ? "Organizer" : string.IsNullOrEmpty(GuestToken) ? "Participant" : "ExternalGuest";
        await Rt.JoinAsync(Id, _selfName, role, _mic, _cam, GuestToken, _code);
    }

    private async Task EnterRoomAsync()
    {
        _selfName = GuestName ?? Auth.UserName ?? "Participant";
        await EnsureMediaScriptsAsync();
        BindRt();
        await Rt.EnsureHubReadyAsync(GuestToken);
        _jsRef = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("classroomRtc.init", _jsRef, new { selfConnectionId = Rt.ConnectionId }); } catch { }
        try { await JS.InvokeVoidAsync("classroomMedia.setEndedCallback", _jsRef); } catch { }
        if (!string.IsNullOrEmpty(Rt.ConnectionId))
            try { await JS.InvokeVoidAsync("classroomRtc.setSelfId", Rt.ConnectionId); } catch { }
        // Le rôle définitif est décidé par le serveur ; cette valeur n'est qu'une indication.
        var role = _isOrganizer ? "Organizer" : string.IsNullOrEmpty(GuestToken) ? "Participant" : "ExternalGuest";
        await Rt.JoinAsync(Id, _selfName, role, _mic, _cam, GuestToken, _code);
        // Le média démarre après le premier rendu de la salle : la balise vidéo locale doit exister.
        _inRoom = true;
        await Rt.RequestWaitingListAsync(Id);
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (_, _) =>
        {
            _elapsed++;
            // Filet de sécurité : une diffusion perdue (reconnexion du hub) ne doit pas cacher la file d'attente.
            if (_elapsed % 10 == 0 && !_waiting) _ = Rt.RequestWaitingListAsync(Id);
            _ = InvokeAsync(StateHasChanged);
        };
        _timer.Start();
        if (_detail is { Status: 0 or 1 } && _isOrganizer)
            await Api.PostWithErrorAsync<object>($"api/expert/meetings/{Id}/start", new { });
    }

    /// <summary>
    /// Charge les moteurs média et WebRTC et vérifie qu'ils se sont bien exécutés : sans eux,
    /// classroomMedia n'existe pas et chaque action caméra/micro échoue avec « was undefined ».
    /// </summary>
    private async Task<bool> EnsureMediaScriptsAsync()
    {
        if (_scriptsReady) return true;
        try
        {
            var status = await JS.InvokeAsync<AssetStatus>("tsPageAssets.loadMeetingRoom");
            _scriptsReady = status?.Ok == true;
            _mediaError = _scriptsReady
                ? null
                : "Moteur audio/vidéo non chargé (" + string.Join(", ", status?.Missing ?? []) +
                  "). Rechargez la page avec Ctrl+F5 ; si le problème persiste, désactivez le bloqueur de scripts.";
        }
        catch (Exception ex)
        {
            _scriptsReady = false;
            _mediaError = "Moteur audio/vidéo indisponible : rechargez la page. (" + Short(ex.Message) + ")";
        }
        return _scriptsReady;
    }

    /// <summary>Première ligne du message : une pile JavaScript entière rendait la bannière illisible.</summary>
    private static string Short(string? message)
    {
        var text = (message ?? "").Split('\n')[0].Trim();
        return text.Length > 160 ? text[..160] + "…" : text;
    }

    /// <summary>Nouvelle tentative de chargement des moteurs, puis relance caméra et micro.</summary>
    private async Task RetryMediaAsync()
    {
        if (!await EnsureMediaScriptsAsync()) return;
        try { await JS.InvokeVoidAsync("classroomRtc.init", _jsRef, new { selfConnectionId = Rt.ConnectionId }); } catch { }
        try { await JS.InvokeVoidAsync("classroomMedia.setEndedCallback", _jsRef); } catch { }
        await StartLocalMediaAsync();
    }

    /// <summary>Retour de tsPageAssets : globales JS manquantes après chargement.</summary>
    public sealed class AssetStatus
    {
        public bool Ok { get; set; }
        public string[]? Missing { get; set; }
    }

    private void BindRt()
    {
        Rt.PeerListReceived += (id, list) => _ = InvokeAsync(() => { ReplacePeers(list); ConnectAll(); _needRtcRemount = true; });
        Rt.PeerJoined += (id, p) => _ = InvokeAsync(() => { Upsert(p); ConnectOne(p); _needRtcRemount = true; StateHasChanged(); });
        Rt.PeerLeft += (id, cid) => _ = InvokeAsync(() => { _peers.RemoveAll(x => x.ConnectionId == cid); JS.InvokeVoidAsync("classroomRtc.closePeer", cid); _needRtcRemount = true; StateHasChanged(); });
        Rt.PeerMediaStateChanged += (id, cid, mic, cam) => _ = InvokeAsync(async () =>
        {
            var i = _peers.FindIndex(x => x.ConnectionId == cid);
            if (i >= 0) _peers[i] = _peers[i] with { MicOn = mic, CamOn = cam };
            try { await JS.InvokeVoidAsync("classroomRtc.setRemoteMediaVisible", cid, cam); } catch { }
            if (cam) { try { await JS.InvokeVoidAsync("classroomRtc.probeRemoteMedia", cid); } catch { } }
            _needRtcRemount = true;
            StateHasChanged();
        });
        Rt.RtcSignalReceived += (id, from, type, payload) => _ = JS.InvokeVoidAsync("classroomRtc.handleSignal", from, type, payload);
        Rt.ChatMessageReceived += m => _ = InvokeAsync(() =>
        {
            _chat.Add(m);
            if (_tab != "chat") _unread++;
            StateHasChanged();
        });
        Rt.ChatHistoryReceived += (id, list) => _ = InvokeAsync(() => { _chat.Clear(); _chat.AddRange(list); });
        Rt.WaitingUpdated += (id, list) => _ = InvokeAsync(() =>
        {
            // L'organisateur doit voir tout de suite qui patiente, même s'il consulte un autre onglet.
            var arrivals = list.Where(w => _waitingList.All(x => x.ConnectionId != w.ConnectionId)).ToList();
            _waitingList.Clear();
            _waitingList.AddRange(list);
            if (!_waiting && arrivals.Count > 0)
            {
                foreach (var w in arrivals)
                    Toast($"{w.DisplayName} attend d’être admis");
                _tab = "people";
                // Panneau replié sur téléphone : quelqu'un attend, il faut le montrer.
                _sideOpen = true;
            }
            StateHasChanged();
        });
        Rt.WaitingRoom += _id => { _ = InvokeAsync(() => { _waiting = true; StateHasChanged(); }); };
        Rt.Admitted += _id => { _ = InvokeAsync(() => { _waiting = false; StateHasChanged(); }); };
        Rt.Denied += _id => { _ = InvokeAsync(() => Nav.NavigateTo("/expert/meetings")); };
        // Session doublée : il faut libérer micro et caméra ici, sinon les deux onglets captent
        // le son et le locuteur s'entend revenir avec le retard du réseau.
        Rt.SessionReplaced += _id => _ = InvokeAsync(async () =>
        {
            _replaced = true;
            _inRoom = false;
            try { await JS.InvokeVoidAsync("classroomMedia.stop", _localVideo); } catch { }
            try { await JS.InvokeVoidAsync("classroomRtc.stop"); } catch { }
            _timer?.Stop();
            StateHasChanged();
        });
        // Refusé faute de place : l'invité anonyme n'a nulle part où retourner dans l'application,
        // on lui laisse la page avec l'explication plutôt qu'une redirection muette.
        Rt.MeetingFull += (_id, max) => _ = InvokeAsync(() =>
        {
            _roomFull = true;
            _waiting = false;
            _error = max is int cap
                ? $"La réunion est complète : {cap} participants au maximum."
                : "La réunion est complète.";
            StateHasChanged();
        });
        Rt.RoomFull += (_id, max, who) => _ = InvokeAsync(() =>
        {
            Toast(max is int cap
                ? $"Salle pleine ({cap} places) : {who} ne peut pas entrer."
                : $"Salle pleine : {who} ne peut pas entrer.");
            StateHasChanged();
        });
        Rt.Kicked += _id => { _ = InvokeAsync(() => Nav.NavigateTo("/expert/meetings")); };
        Rt.Caption += (id, name, text) => _ = InvokeAsync(() => { _caption = $"{name} : {text}"; StateHasChanged(); });
        // Micro coupé par l'organisateur : sans réémission de l'état, sa liste continuait
        // d'afficher « micro activé » pour quelqu'un qui ne pouvait plus se faire entendre.
        Rt.ForceMute += _id => _ = InvokeAsync(async () =>
        {
            _mic = false;
            try { await JS.InvokeVoidAsync("classroomMedia.setAudioEnabled", false); } catch { }
            await Rt.BroadcastMediaAsync(Id, _mic, _cam);
            Toast("Votre micro a été coupé par l’organisateur");
            StateHasChanged();
        });
        Rt.AiEnabled += _id => { _ = InvokeAsync(() => { if (_detail is not null) _detail = _detail with { AiActivatedByOrganizer = true }; _consentAsk = !_isOrganizer; StateHasChanged(); }); };
        Rt.MeetingEnded += _id => { _ = InvokeAsync(() => Nav.NavigateTo($"/expert/meetings/{Id}/minutes")); };
        Rt.RecordingState += (id, on) => _ = InvokeAsync(() => { _recording = on; StateHasChanged(); });
        Rt.Reaction += (id, cid, name, emoji) => Toast($"{name} {emoji}");
        Rt.HandRaised += (id, cid, name, raised) => Toast(raised ? $"{name} lève la main" : $"{name} baisse la main");
        Rt.SharedNotes += (id, notes) => _ = InvokeAsync(() => { _notes = notes; StateHasChanged(); });
        Rt.Poll += (id, q, opts) => { _ = InvokeAsync(() => { _pollQLive = q; StateHasChanged(); }); };
        Rt.MediaSyncRequested += _id => { _ = Rt.BroadcastMediaAsync(Id, _mic, _cam); };
    }

    [JSInvokable] public Task OnRtcOutgoingSignal(string target, string type, string payload) => Rt.SendRtcAsync(Id, target, type, payload);

    /// <summary>
    /// Un flux distant vient d'arriver ou de changer. On raccroche le flux à la tuile et on
    /// débloque la lecture ; les voyants micro et caméra, eux, restent ceux annoncés par le pair :
    /// une piste reçue existe même quand elle ne transporte rien (émetteur sans caméra).
    /// </summary>
    [JSInvokable]
    public Task OnRtcRemoteMedia(string remoteId, bool hasVideo, bool hasAudio) => InvokeAsync(async () =>
    {
        var peer = _peers.FirstOrDefault(x => x.ConnectionId == remoteId);
        if (peer is null) return;
        try { await JS.InvokeVoidAsync("classroomRtc.setRemoteMediaVisible", remoteId, peer.CamOn && hasVideo); } catch { }
        await UnlockAudioAsync();
        _needRtcRemount = true;
        StateHasChanged();
    });

    /// <summary>
    /// Le niveau sonore a désigné un nouveau locuteur : sa tuile passe en grand, sauf si
    /// quelqu'un a été épinglé à la main.
    /// </summary>
    [JSInvokable]
    public Task OnRtcActiveSpeaker(string speakerId) => InvokeAsync(() =>
    {
        if (_speaker == speakerId) return;
        _speaker = speakerId;
        // La tuile mise en avant change de taille : les flux doivent être réaccrochés.
        if (_pinned is null) _needRtcRemount = true;
        StateHasChanged();
    });

    /// <summary>Tuile affichée en grand : épinglage manuel, sinon dernier locuteur.</summary>
    private string SpotId
    {
        get
        {
            if (_pinned is not null && IsPresent(_pinned)) return _pinned;
            if (_speaker is not null && IsPresent(_speaker)) return _speaker;
            // Personne n'a encore parlé : un autre participant est plus utile à voir que soi.
            return _peers.Count > 0 ? _peers[0].ConnectionId : string.Empty;
        }
    }

    private bool IsPresent(string id) =>
        id.Length == 0 || _peers.Any(p => p.ConnectionId == id);

    private bool IsSpeaking(string id) =>
        _speaker == id && (id.Length == 0 ? _mic : _peers.Any(p => p.ConnectionId == id && p.MicOn));

    private string TileCss(string id, bool self)
    {
        var css = self ? "mtg-tile is-main" : "mtg-tile";
        if (SpotId == id) css += " is-spot";
        if (IsSpeaking(id)) css += " is-speaking";
        if (_pinned == id) css += " is-pinned";
        return css;
    }

    /// <summary>
    /// Épingle ou libère une tuile. Utile quand on veut garder l'écran partagé ou le tableau
    /// sous les yeux pendant que d'autres commentent.
    /// </summary>
    private void TogglePin(string id)
    {
        _pinned = _pinned == id ? null : id;
        _needRtcRemount = true;
    }

    private string PinHint(string id) =>
        _pinned == id ? "Ne plus garder au premier plan" : "Garder au premier plan";

    /// <summary>
    /// Relance la lecture des flux distants et retient le refus éventuel du navigateur : sans
    /// geste de l'utilisateur, la politique de lecture automatique coupe le son des participants
    /// sans rien afficher. On le dit alors, avec un bouton pour l'autoriser.
    /// </summary>
    private async Task UnlockAudioAsync()
    {
        try
        {
            var r = await JS.InvokeAsync<UnlockAudioResult>("classroomRtc.unlockAudio");
            _audioBlocked = r?.Blocked == true;
        }
        catch { }
    }

    private async Task EnableAudioAsync()
    {
        await UnlockAudioAsync();
        if (_audioBlocked)
            Toast("Le navigateur bloque encore le son : vérifiez l’autorisation du site");
    }

    /// <summary>Retour de classroomRtc.unlockAudio.</summary>
    public sealed class UnlockAudioResult
    {
        public bool Ok { get; set; }
        public bool Blocked { get; set; }
    }

    /// <summary>Lien rétabli après une coupure : les flux doivent être réaccrochés aux tuiles.</summary>
    [JSInvokable]
    public Task OnRtcConnectionState(string remoteId, string state) => InvokeAsync(() =>
    {
        if (state is "connected")
            _needRtcRemount = true;
        StateHasChanged();
    });

    [JSInvokable]
    public async Task OnScreenShareEnded(string kind)
    {
        _sharing = false;
        _sharingBoard = false;
        Toast("Partage terminé");
        await RefreshTracksAsync(force: true);
        await Rt.BroadcastMediaAsync(Id, _mic, _cam);
