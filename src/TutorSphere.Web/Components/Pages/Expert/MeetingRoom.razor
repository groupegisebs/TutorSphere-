    /// <summary>Clôture pour tout le monde : réservée à l'organisateur, elle ouvre le compte rendu.</summary>
    private async Task EndForAllAsync()
    {
        await Api.PostWithErrorAsync<object>($"api/expert/meetings/{Id}/end", new { });
        await Rt.NotifyEndedAsync(Id);
        Nav.NavigateTo($"/expert/meetings/{Id}/minutes");
    }

    private async Task MuteEveryoneAsync()
    {
        _menu = null;
        foreach (var p in _peers.ToList())
            await Rt.ForceMuteAsync(Id, p.ConnectionId);
        Toast("Micros coupés");
    }

    private bool WaitingRoomOn => _detail?.WaitingRoomEnabled == true;

    /// <summary>
    /// Le hub applique la même règle : réunion libre, l'organisateur seul ; sur invitation,
    /// tout participant présent. Ici, il s'agit de ne pas afficher un bouton sans effet.
    /// </summary>
    private bool CanAdmit => _detail?.OpenJoinEnabled != true || _isOrganizer;

    private async Task RefreshWaitingAsync()
    {
        await Rt.RequestWaitingListAsync(Id);
        Toast("File d’attente actualisée");
    }

    private async Task AdmitAsync(string connectionId)
    {
        var name = _waitingList.FirstOrDefault(w => w.ConnectionId == connectionId)?.DisplayName;
        await Rt.AdmitAsync(Id, connectionId);
        _waitingList.RemoveAll(w => w.ConnectionId == connectionId);
        Toast(name is null ? "Participant admis" : $"{name} a été admis");
    }

    private async Task DenyAsync(string connectionId)
    {
        var name = _waitingList.FirstOrDefault(w => w.ConnectionId == connectionId)?.DisplayName;
        await Rt.DenyAsync(Id, connectionId);
        _waitingList.RemoveAll(w => w.ConnectionId == connectionId);
        Toast(name is null ? "Demande refusée" : $"{name} a été refusé");
    }

    private async Task AdmitAllAsync()
    {
        if (_waitBusy) return;
        _waitBusy = true;
        try
        {
            var count = _waitingList.Count;
            foreach (var w in _waitingList.ToList())
                await Rt.AdmitAsync(Id, w.ConnectionId);
            _waitingList.Clear();
            Toast($"{count} participant(s) admis");
        }
        finally { _waitBusy = false; }
    }

    /// <summary>Le filtrage ne concerne que les arrivées suivantes : les présents restent en salle.</summary>
    private async Task ToggleWaitingRoomAsync()
    {
        if (_waitBusy || _detail is null) return;
        _waitBusy = true;
        try
        {
            var target = !WaitingRoomOn;
            var r = await Api.PostWithErrorAsync<object>(
                $"api/expert/meetings/{Id}/waiting-room", new { enabled = target });
            if (r.Error is not null)
            {
                Toast(r.Error);
                return;
            }
            _detail = _detail with { WaitingRoomEnabled = target };
            Toast(target ? "Salle d’attente activée" : "Salle d’attente désactivée");
        }
        finally { _waitBusy = false; }
    }

    private async Task ForceMuteAsync(string connectionId)
    {
        _menu = null;
        await Rt.ForceMuteAsync(Id, connectionId);
    }

    private async Task KickAsync(string connectionId)
    {
        _menu = null;
        await Rt.KickAsync(Id, connectionId);
    }

    private async Task ToggleBlurAsync()
    {
        _menu = null;
        var mode = _blur ? "none" : "blur";
        var r = await InvokeMediaAsync("classroomMedia.setBackgroundEffect", _localVideo, new { mode });
        if (r is not null && !r.Ok)
        {
            Toast(r.Error ?? "Arrière-plan indisponible");
            return;
        }
        _blur = !_blur;
        await RefreshTracksAsync(force: true);
    }

    private async Task ShareBoardAsync()
    {
        _menu = null;
        var r = await InvokeMediaAsync("classroomMedia.startWhiteboardShare", _localVideo, _board);
        if (r is null || !r.Ok)
        {
            Toast(r?.Error ?? "Tableau blanc indisponible");
            return;
        }
        _sharing = true;
        _sharingBoard = true;
        Toast("Tableau blanc partagé");
        await RefreshTracksAsync(force: true);
        await Rt.BroadcastMediaAsync(Id, _mic, true);
    }

    private void OpenInvite()
    {
        _copied = false;
        _invite = true;
        _menu = null;
    }

    private async Task CopyInviteAsync()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", InviteLink); }
        catch { Toast("Copie impossible : copiez le lien à la main."); return; }
        _copied = true;
        Toast("Lien d’invitation copié");
    }

    private async Task CopyOpenLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(_detail?.OpenJoinUrl)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _detail.OpenJoinUrl); }
        catch { Toast("Copie impossible : copiez le lien à la main."); return; }
        _copied = true;
        Toast("Lien de la réunion libre copié");
    }

    /// <summary>Ouvre un lien libre sur une réunion qui n'en avait pas : la salle d'attente devient obligatoire.</summary>
    private async Task OpenFreeLinkAsync()
    {
        _openingLink = true;
        try
        {
            var r = await Api.PostWithErrorAsync<OpenJoinDto>(
                $"api/expert/meetings/{Id}/open-join", new { enabled = true, maxParticipants = (int?)null });
            if (r.Error is not null || r.Value is null)
            {
                Toast(r.Error ?? "Ouverture du lien impossible.");
                return;
            }
            if (_detail is not null)
                _detail = _detail with
                {
                    OpenJoinEnabled = r.Value.Enabled,
                    OpenJoinUrl = r.Value.Url,
                    MaxParticipants = r.Value.MaxParticipants,
                    WaitingRoomEnabled = true
                };
            _copied = false;
            Toast("Lien libre ouvert : partagez-le à qui vous voulez");
        }
        finally { _openingLink = false; }
    }

    /// <summary>Lien prêt à l'emploi : le code voyage avec, le destinataire n'a qu'à cliquer.</summary>
    private string InviteLink
    {
        get
        {
            var url = $"{Nav.BaseUri.TrimEnd('/')}/expert/meetings/{Id}/room";
            var code = _detail?.AccessCode ?? (_codeGate ? null : _code);
            return string.IsNullOrWhiteSpace(code) ? url : $"{url}?code={Uri.EscapeDataString(code)}";
        }
    }

    private void Menu(string key) => _menu = _menu == key ? null : key;
    private void CloseMenus() => _menu = null;

    private void OpenTab(string tab)
    {
        // Toucher l'onglet déjà ouvert replie le panneau : sur téléphone, c'est le seul moyen de
        // rendre toute la hauteur à l'image.
        _sideOpen = !(_sideOpen && _tab == tab);
        _tab = tab;
        _menu = null;
        if (tab == "chat") _unread = 0;
        if (tab == "people" && !_waiting) _ = Rt.RequestWaitingListAsync(Id);
    }

    private bool SelfHasVideo => _cam || _sharing;
    private string SelfRole => _isOrganizer ? "Organizer" : string.IsNullOrEmpty(GuestToken) ? "Participant" : "ExternalGuest";

    private string NoticeText => (_recording, _detail?.AiActivatedByOrganizer ?? false) switch
    {
        (true, true) => "L’enregistrement et l’assistant IA sont actifs",
        (true, false) => "L’enregistrement est en cours",
        (false, true) => "L’assistant IA est actif",
        _ => "L’enregistrement et l’assistant IA sont désactivés"
    };

    private bool Matches(string name) =>
        string.IsNullOrWhiteSpace(_search) || name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase);

    private static bool IsGuest(string role) => role is "ExternalGuest" or "Guest";

    private static string RoleName(string role) => role switch
    {
        "Organizer" => "Organisateur",
        "ExternalGuest" or "Guest" => "Invité externe",
        "Waiting" => "En attente",
        _ => "Participant"
    };

    private static string RoleLabel(string role) => role switch
    {
        "Organizer" => "Organisateur",
        "ExternalGuest" or "Guest" => "Externe",
        "Waiting" => "En attente",
        _ => "Participant"
    };

    private static string RoleCls(string role) => role switch
    {
        "Organizer" => "is-org",
        "ExternalGuest" or "Guest" => "is-ext",
        "Waiting" => "is-wait",
        _ => "is-part"
    };

    private static string Initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        var first = char.ToUpperInvariant(parts[0][0]);
        if (parts.Length == 1)
            return parts[0].Length > 1 ? $"{first}{char.ToUpperInvariant(parts[0][1])}" : first.ToString();
        return $"{first}{char.ToUpperInvariant(parts[^1][0])}";
    }

    /// <summary>Couleur stable par personne : la même initiale garde sa teinte d'une vue à l'autre.</summary>
    private static string AvatarBg(string name)
    {
        string[] palette = ["#7c3aed", "#2f9e8f", "#3b82f6", "#db2777", "#d97706", "#0ea5e9", "#16a34a", "#6366f1"];
        var sum = 0;
        foreach (var ch in name ?? "") sum = (sum + ch) % 4096;
        return palette[sum % palette.Length];
    }
    /// <summary>Sortie avant l'entrée en salle : l'invité revient à sa page d'accès, le membre à sa liste.</summary>
    private void GoBack()
    {
        if (!string.IsNullOrEmpty(GuestToken))
        {
            Nav.NavigateTo($"/meet/join/{Uri.EscapeDataString(GuestToken)}");
            return;
        }
        Nav.NavigateTo(Nav.Uri.Contains("/admin/meetings", StringComparison.OrdinalIgnoreCase)
            ? "/admin/meetings"
            : "/expert/meetings");
    }

    private void Toast(string t) { _toasts.Add(t); _ = Task.Delay(2500).ContinueWith(_ => InvokeAsync(() => { _toasts.Remove(t); StateHasChanged(); })); }
    private string TabCls(string t) => _tab == t ? "is-on" : "";
    private static string FormatElapsed(int s) => TimeSpan.FromSeconds(s).ToString(@"hh\:mm\:ss");

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        try { await JS.InvokeVoidAsync("classroomRtc.stop"); } catch { }
        try { await JS.InvokeVoidAsync("classroomMedia.stop"); } catch { }
        await Rt.LeaveAsync();
        _jsRef?.Dispose();
    }

    private sealed record OpenJoinDto(bool Enabled, string? Url, int? MaxParticipants);

    private sealed record Detail(
        Guid Id, string Title, string? Agenda, int Status, DateTime? StartAtUtc, DateTime? EndAtUtc,
        string OrganizerUserId, string OrganizerName, bool WaitingRoomEnabled, bool AllowMic, bool AllowCamera,
        bool AllowScreenShare, bool RecordingEnabled, bool TranscriptionEnabled, bool AiEnabled,
        bool AiActivatedByOrganizer, bool Locked, string Language,
        bool RequiresAccessCode, string? AccessCode,
        bool OpenJoinEnabled = false, string? OpenJoinUrl = null, int? MaxParticipants = null);
}
