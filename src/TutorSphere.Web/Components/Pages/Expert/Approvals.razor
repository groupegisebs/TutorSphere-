@page "/expert/approvals"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TutorSphere.Domain.Policies
@using TutorSphere.Web.Common
@inject AuthService Auth
@inject ApiClient Api
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Nav

<ApplyRequestCulture />

<PageTitle>@L["Expert_TeachersHubTitle"]</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">@L["Expert_TeachersHubTitle"]</h1>
                <p class="cc-page-sub">@L["Expert_TeachersHubSubtitle"]</p>
            </div>
        </div>

        <div class="cc-path-grid mb-3" role="navigation" aria-label="@L["Expert_TeachersNav"]">
            <button type="button" class="cc-path-card @(_activeTab == "register" ? "active" : null)"
                    @onclick='() => SetTab("register")'>
                <span class="cc-path-num">1</span>
                <div>
                    <strong>@L["Expert_PathCreateTitle"]</strong>
                    <p>@L["Expert_PathCreateDesc"]</p>
                </div>
            </button>
            <button type="button" class="cc-path-card @(_activeTab == "invite" ? "active" : null)"
                    @onclick='() => SetTab("invite")'>
                <span class="cc-path-num">2</span>
                <div>
                    <strong>@L["Expert_PathInviteTitle"]</strong>
                    <p>@L["Expert_PathInviteDesc"]</p>
                </div>
            </button>
            <button type="button" class="cc-path-card @(_activeTab == "queue" ? "active" : null)"
                    @onclick='() => SetTab("queue")'>
                <span class="cc-path-num">3</span>
                <div>
                    <strong>@L["Expert_PathQueueTitle"]</strong>
                    <p>@L["Expert_PathQueueDesc"]</p>
                </div>
            </button>
        </div>

        <div class="alert alert-secondary small mb-3">
            @((MarkupString)L["Expert_TeachersNotConfuse"].Value)
        </div>

        <div class="cc-tabs" role="tablist">
            <button type="button" role="tab" class="cc-tab @(_activeTab == "register" ? "active" : null)"
                    aria-selected="@(_activeTab == "register")" @onclick='() => SetTab("register")'>
                <i class="bi bi-person-plus me-1" aria-hidden="true"></i>@L["Expert_PathCreateTitle"]
            </button>
            <button type="button" role="tab" class="cc-tab @(_activeTab == "invite" ? "active" : null)"
                    aria-selected="@(_activeTab == "invite")" @onclick='() => SetTab("invite")'>
                <i class="bi bi-envelope me-1" aria-hidden="true"></i>@L["Expert_PathInviteTitle"]
                @if (!_invitesLoading && _invites.Count > 0)
                {
                    <span class="cc-pill cc-pill-type ms-1">@_invites.Count</span>
                }
            </button>
            <button type="button" role="tab" class="cc-tab @(_activeTab == "queue" ? "active" : null)"
                    aria-selected="@(_activeTab == "queue")" @onclick='() => SetTab("queue")'>
                <i class="bi bi-inbox me-1" aria-hidden="true"></i>@L["Expert_PathQueueTitle"]
                @if (!_loading && _queue.Count > 0)
                {
                    <span class="cc-pill cc-pill-type ms-1">@_queue.Count</span>
                }
            </button>
        </div>

        @if (_activeTab == "register")
        {
        <div class="cc-card mb-3">
            <h2 class="cc-card-title">@L["Expert_RegisterTeacherTitle"]</h2>
            <p class="small text-muted mb-2">
                @L["Expert_RegisterTeacherSubtitle"]
                <button type="button" class="btn btn-link p-0 align-baseline" @onclick='() => SetTab("invite")'>
                    @L["Expert_RegisterOrInviteLink"]
                </button>
            </p>

            @if (!string.IsNullOrEmpty(_regError))
            {
                <div class="alert alert-danger py-2">@_regError</div>
            }
            @if (!string.IsNullOrEmpty(_regSuccess))
            {
                <div class="alert alert-success py-2">@_regSuccess</div>
            }

            <div class="mb-3">
                <label class="form-label">@L["Label_ExpertGroupName"] <span class="text-danger">*</span></label>
                <div class="form-field-icon">
                    <i class="bi bi-people field-icon" aria-hidden="true"></i>
                    <input class="form-control" value="@_regSchoolName" disabled readonly
                           placeholder="@(_regGroupLoading ? L["Label_Loading"] : L["Placeholder_ExpertGroupName"])" />
                </div>
            </div>

            <div class="row g-2">
                <div class="col-12 col-sm-6 mb-3">
                    <label class="form-label">@L["Label_FirstName"] <span class="text-danger">*</span></label>
                    <div class="form-field-icon">
                        <i class="bi bi-person field-icon" aria-hidden="true"></i>
                        <input class="form-control" @bind="_regFirstName" @bind:event="oninput" @bind:after="OnRegNameChanged"
                               placeholder="@L["Label_FirstName"]" autocomplete="given-name" />
                    </div>
                </div>
                <div class="col-12 col-sm-6 mb-3">
                    <label class="form-label">@L["Label_LastName"] <span class="text-danger">*</span></label>
                    <div class="form-field-icon">
                        <i class="bi bi-person field-icon" aria-hidden="true"></i>
                        <input class="form-control" @bind="_regLastName" @bind:event="oninput" @bind:after="OnRegNameChanged"
                               placeholder="@L["Label_LastName"]" autocomplete="family-name" />
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">E-mail réel de l'enseignant <span class="text-muted">(optionnel)</span></label>
                <div class="form-field-icon">
                    <i class="bi bi-envelope field-icon" aria-hidden="true"></i>
                    <input type="email" class="form-control" @bind="_regEmail" placeholder="exemple@courriel.com" />
                </div>
                <div class="form-text">
                    Login généré automatiquement (e-mail du groupe + .XXXX).
                    Avec e-mail réel : identifiants envoyés à l'enseignant, au Responsable et à admin@holotuto.com.
                    Sans e-mail réel : uniquement Responsable + admin@holotuto.com.
                </div>
            </div>

            <div class="alert alert-info small mb-3">
                <i class="bi bi-shield-lock me-1"></i>
                Mot de passe temporaire généré automatiquement et envoyé par e-mail. Changement obligatoire à la première connexion.
            </div>

            <div class="teacher-conduct-box mb-3">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <strong>@L["TeacherConduct_Title"]</strong>
                    <span class="badge ex-badge-version">v@(TeacherConductPolicy.CurrentVersion)</span>
                </div>
                <div class="teacher-conduct-scroll" tabindex="0">
                    <p class="small mb-2">@L["TeacherConduct_Intro"]</p>
                    <ul class="small mb-2">
                        <li>@L["TeacherConduct_Bullet_Trust"]</li>
                        <li>@L["TeacherConduct_Bullet_Respect"]</li>
                        <li>@L["TeacherConduct_Bullet_Safety"]</li>
                        <li>@L["TeacherConduct_Bullet_Report"]</li>
                        <li>@L["TeacherConduct_Bullet_Privacy"]</li>
                        <li>@L["TeacherConduct_Bullet_Ethics"]</li>
                    </ul>
                    <p class="small text-muted mb-0">@L["TeacherConduct_LegalNote"]</p>
                </div>
                <a class="small d-inline-block mt-2" href="@TeacherConductPolicy.PublicPath" target="_blank" rel="noopener">
                    @L["TeacherConduct_ReadFull"] <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                </a>
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="expert-accept-conduct"
                           @bind="_regAcceptedConduct" />
                    <label class="form-check-label" for="expert-accept-conduct">
                        @L["TeacherConduct_AcceptCheckbox"]
                    </label>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">@L["Label_SubdomainFull"] <span class="text-danger">*</span></label>
                <div class="subdomain-field">
                    <span class="subdomain-prefix">https://</span>
                    <input @bind="_regSlug" @bind:event="oninput" @bind:after="AfterRegSlugChanged" placeholder="jean" aria-label="@L["Label_Subdomain"]" />
                    <span class="subdomain-suffix">.tutorsphere.com</span>
                    @if (_regCheckingSlug)
                    {
                        <span class="subdomain-status"><span class="spinner-border spinner-border-sm" role="status"></span></span>
                    }
                    else if (!string.IsNullOrWhiteSpace(_regSlug) && IsRegSlugFormatValid)
                    {
                        <span class="subdomain-status @(_regSlugAvailable == true ? "" : "unavailable")">
                            <i class="bi @(_regSlugAvailable == true ? "bi-check-circle-fill" : "bi-x-circle-fill")" aria-hidden="true"></i>
                        </span>
                    }
                </div>
                <small class="text-muted">@L["Hint_SubdomainAutoFilled"]</small>
                @if (_regSlugAvailable == false && !string.IsNullOrWhiteSpace(_regSlug))
                {
                    <small class="text-danger d-block">@L["Error_SlugTaken"]</small>
                }
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label">@L["Expert_RegisterCity"]</label>
                    <div class="form-field-icon">
                        <i class="bi bi-geo-alt field-icon" aria-hidden="true"></i>
                        <input class="form-control" @bind="_regCity" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">@L["Expert_RegisterCountry"]</label>
                    <div class="form-field-icon">
                        <i class="bi bi-flag field-icon" aria-hidden="true"></i>
                        <input class="form-control" value="@RegCountryDisplay" disabled readonly />
                    </div>
                    <small class="text-muted">@L["Expert_RegisterCountryFromGroup"]</small>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">@L["School_VisibleCountries"]</label>
                <p class="small text-muted mb-2">@L["School_VisibleCountriesHint"]</p>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach (var code in _regVisibleCountries)
                    {
                        var info = CountryCatalog.Find(code);
                        <span class="badge text-bg-light border d-inline-flex align-items-center gap-1 py-2 px-2">
                            <span aria-hidden="true">@(info?.Flag ?? "")</span>
                            @(info?.Name ?? code)
                            @if (!string.Equals(code, _regCountry, StringComparison.OrdinalIgnoreCase))
                            {
                                <button type="button" class="btn-close btn-close-sm ms-1" @onclick="() => RemoveRegVisible(code)"></button>
                            }
                        </span>
                    }
                </div>
                <div class="col-md-6 px-0">
                    <CountrySelect Value="@_regAddVisible" ValueChanged="OnRegAddVisibleChanged" Placeholder="@L["School_AddVisibleCountry"]" />
                </div>
            </div>

            <div class="mb-3 border-top pt-3">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="reg-publish-public" @bind="_regPublishPublic" />
                    <label class="form-check-label" for="reg-publish-public">
                        @L["Expert_PublishPublicProfile"]
                    </label>
                    <div class="form-text">@L["Expert_PublishPublicProfileHint"]</div>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="reg-create-offer" @bind="_regCreateOffer" />
                    <label class="form-check-label" for="reg-create-offer">
                        @L["Expert_CreateOfferLabel"]
                    </label>
                </div>
                @if (_regCreateOffer)
                {
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Titre de l'offre *</label>
                            <input class="form-control" @bind="_regOfferTitle" placeholder="Ex. Français — soutien scolaire" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Matière</label>
                            <input class="form-control" @bind="_regOfferSubject" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Mode</label>
                            <select class="form-select" @bind="_regOfferMode">
                                <option value="En ligne">En ligne</option>
                                <option value="Présentiel">Présentiel</option>
                                <option value="Hybride">Hybride</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Période package</label>
                            <select class="form-select" @bind="_regOfferPeriod">
                                <option value="semaine">Hebdomadaire</option>
                                <option value="mois">Mensuel</option>
                                <option value="trimestre">Trimestriel</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Cadence</label>
                            <select class="form-select" @bind="_regOfferCadence">
                                <option value="weekly">Chaque semaine</option>
                                <option value="biweekly">Toutes les 2 semaines</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Facturation</label>
                            <select class="form-select" @bind="_regOfferBillingMode">
                                <option value="perSession">Par séance</option>
                                <option value="hourly">Horaire</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Durée séance (min)</label>
                            <input type="number" min="15" step="15" class="form-control" @bind="_regOfferSessionDuration" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Prix *</label>
                            <input type="number" min="0" step="100" class="form-control" @bind="_regOfferPrice" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Devise</label>
                            <select class="form-select" @bind="_regOfferCurrency">
                                <option>CAD</option><option>USD</option><option>EUR</option><option>XAF</option><option>XOF</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Séances</label>
                            <input type="number" min="1" class="form-control" @bind="_regOfferSessionCount" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fréquence (libellé)</label>
                            <input class="form-control" @bind="_regOfferFrequency" placeholder="1× / semaine" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" rows="2" @bind="_regOfferDescription"></textarea>
                        </div>
                    </div>
                }
            </div>

            <button type="button" class="cc-btn cc-btn-primary"
                    disabled="@(_regBusy || !_regAcceptedConduct)" @onclick="RegisterTeacherAsync">
                @if (_regBusy)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>@L["Button_Loading"]</span>
                }
                else
                {
                    <i class="bi bi-person-plus"></i> @L["Expert_RegisterTeacherSend"]
                }
            </button>
        </div>
        }
        else if (_activeTab == "invite")
        {
        <div class="cc-card mb-3">
            <h2 class="cc-card-title">@L["Expert_InviteTitle"]</h2>
            <p class="small text-muted mb-3">@L["Expert_InviteSubtitle"]</p>

            @if (!string.IsNullOrEmpty(_inviteError))
            {
                <div class="alert alert-danger py-2">@_inviteError</div>
            }
            @if (!string.IsNullOrEmpty(_inviteSuccess))
            {
                <div class="alert alert-success py-2">@_inviteSuccess</div>
            }

            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">@L["Expert_InviteEmail"]</label>
                    <input class="form-control" type="email" @bind="_inviteEmail" placeholder="enseignant@exemple.com" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Expert_InviteFirstName"]</label>
                    <input class="form-control" @bind="_inviteFirstName" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">@L["Expert_InviteMessage"]</label>
                    <input class="form-control" @bind="_inviteMessage" placeholder="@L["Expert_InviteMessagePlaceholder"]" />
                </div>
                <div class="col-12">
                    <button type="button" class="cc-btn cc-btn-primary" disabled="@_inviteBusy" @onclick="InviteAsync">
                        <i class="bi bi-envelope"></i> @L["Expert_InviteSend"]
                    </button>
                </div>
            </div>
        </div>

        <div class="cc-card mb-3">
            <h2 class="cc-card-title">@L["Expert_InvitesListTitle"]</h2>
            <p class="small text-muted mb-3">@L["Expert_InvitesListSubtitle"]</p>

            @if (_invitesLoading)
            {
                <div class="cc-empty py-3"><span class="spinner-border spinner-border-sm"></span></div>
            }
            else if (_invites.Count == 0)
            {
                <div class="cc-empty py-3">
                    <i class="bi bi-envelope-open"></i>
                    <p>@L["Expert_InvitesEmpty"]</p>
                </div>
            }
            else
            {
                <table class="cc-table">
                    <thead>
                        <tr>
                            <th>@L["Expert_InviteEmail"]</th>
                            <th>@L["Expert_InviteColInvitedBy"]</th>
                            <th>@L["Expert_ColDate"]</th>
                            <th>@L["Expert_InviteColStatus"]</th>
                            <th>@L["Expert_ColSchool"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in _invites)
                        {
                            <tr>
                                <td>
                                    <strong>@inv.Email</strong>
                                    @if (!string.IsNullOrWhiteSpace(inv.FirstName))
                                    {
                                        <div class="small text-muted">@inv.FirstName</div>
                                    }
                                </td>
                                <td>@(inv.InvitedByName ?? "—")</td>
                                <td>@inv.SentAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    <span class="cc-pill @InviteStatusPill(inv.Status)">@InviteStatusLabel(inv.Status)</span>
                                </td>
                                <td>
                                    @if (inv.AcceptedTenantId is Guid tid && !string.IsNullOrWhiteSpace(inv.SchoolName))
                                    {
                                        <a href="@($"expert/teachers/{tid}")">@inv.SchoolName</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        }
        else
        {
        <div class="cc-card mb-3">
            <h2 class="cc-card-title">@L["Expert_Queue"]</h2>
            <p class="small text-muted mb-3">@L["Expert_QueueSubtitle"]</p>

            <div class="row g-2 mb-3">
                <div class="col-md-2">
                    <label class="form-label">Pays</label>
                    <input class="form-control" @bind="_filterCountry" placeholder="CM" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Ville</label>
                    <input class="form-control" @bind="_filterCity" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Statut</label>
                    <select class="form-select" @bind="_filterStatus">
                        <option value="">Tous (pipeline)</option>
                        <option value="0">Pending</option>
                        <option value="5">Assigned</option>
                        <option value="4">UnderReview</option>
                        <option value="3">ChangesRequested</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Ancienneté ≥ j</label>
                    <input class="form-control" type="number" @bind="_filterOlderDays" />
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <label class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" @bind="_filterUrgent" />
                        <span class="form-check-label">Urgent</span>
                    </label>
                    <label class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" @bind="_filterIncomplete" />
                        <span class="form-check-label">Incomplet</span>
                    </label>
                    <button type="button" class="cc-btn cc-btn-primary btn-sm mb-2" @onclick="LoadQueueFilteredAsync">Filtrer</button>
                </div>
            </div>

        @if (_loading)
        {
            <div class="cc-empty"><span class="spinner-border"></span></div>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        else if (_queue.Count == 0)
        {
            <div class="cc-empty py-3">
                <i class="bi bi-inbox"></i>
                <p>@L["Expert_QueueEmpty"]</p>
            </div>
        }
        else
        {
                <table class="cc-table">
                    <thead>
                        <tr>
                            <th>@L["Expert_ColSchool"]</th>
                            <th>@L["Expert_ColCountry"]</th>
                            <th>Statut</th>
                            <th>Âge</th>
                            <th>@L["Expert_ColDocs"]</th>
                            <th>Priorité</th>
                            <th>Assigné</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _queue)
                        {
                            <tr>
                                <td>
                                    <strong>@item.SchoolName</strong>
                                    <div class="small text-muted">@(item.OwnerName ?? item.OwnerEmail)</div>
                                </td>
                                <td>@(item.Country ?? "—") @(string.IsNullOrWhiteSpace(item.City) ? "" : $"· {item.City}")</td>
                                <td><span class="cc-pill cc-pill-type">@StatusName(item.ApprovalStatus)</span></td>
                                <td>@item.AgeDays j</td>
                                <td>@item.DocumentCount @(item.IsComplete ? "" : "(incomplet)")</td>
                                <td>@(item.ReviewPriority > 0 ? "Urgent" : "Normal")</td>
                                <td class="small">@(item.ReviewAssignedToName ?? "—")</td>
                                <td class="text-end">
                                    @if (_isManager)
                                    {
                                        <button type="button" class="cc-btn btn-sm me-1" @onclick="() => OpenAssignAsync(item)">Attribuer</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="cc-btn btn-sm me-1" @onclick="() => AssignToMeAsync(item.TenantId)">M'attribuer</button>
                                    }
                                    <button type="button" class="cc-btn btn-sm me-1" @onclick="() => StartReviewAsync(item.TenantId)">Revoir</button>
                                    <a class="cc-btn cc-btn-primary btn-sm" href="@($"expert/teachers/{item.TenantId}")">
                                        @L["Expert_Review"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
        }
        </div>

        @if (_assignTarget is not null)
        {
            <div class="cc-card mt-3">
                <h2 class="cc-card-title">Attribuer le dossier — @_assignTarget.SchoolName</h2>
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">Expert</label>
                        <select class="form-select" @bind="_assignUserId">
                            <option value="">— Choisir —</option>
                            @foreach (var m in _members)
                            {
                                <option value="@m.UserId">@(string.IsNullOrWhiteSpace(m.FullName) ? m.Email : m.FullName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" @bind="_assignUrgent" />
                            <span class="form-check-label">Urgent</span>
                        </label>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="button" class="cc-btn cc-btn-primary" disabled="@_assignBusy" @onclick="ConfirmAssignAsync">Confirmer</button>
                        <button type="button" class="cc-btn" @onclick="() => _assignTarget = null">Annuler</button>
                    </div>
                </div>
            </div>
        }
        }
    </Authorized>
    <NotAuthorized>
        <div class="cc-card cc-empty">
            <p>@L["Expert_LoginRequired"]</p>
            <a class="cc-btn cc-btn-primary" href="/login/expert">@L["Nav_Login"]</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
