@page "/expert/approvals"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@inject AuthService Auth
@inject ApiClient Api
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Nav
@inject IConfiguration Config

<ApplyRequestCulture />

<PageTitle>Approbations — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar ex-toolbar">
            <div class="ex-page-head">
                <span class="ex-page-icon"><i class="bi bi-person-check" aria-hidden="true"></i></span>
                <div>
                    <h1 class="cc-page-title">Approbations</h1>
                    <p class="cc-page-sub">Examinez et approuvez les enseignants invités à rejoindre votre groupe.</p>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="cc-btn" @onclick="() => _showGuide = !_showGuide">
                    <i class="bi bi-journal-text"></i> Guide d’utilisation
                </button>
                <button type="button" class="cc-btn" @onclick="() => _showInvite = !_showInvite">
                    <i class="bi bi-person-plus"></i> Inviter des enseignants
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_success))
        {
            <div class="alert alert-success py-2">@_success</div>
        }

        @if (_showGuide)
        {
            <div class="alert alert-light border ex-demo-process mb-3">
                <strong>Parcours d’approbation :</strong> invitation ou ajout → examen du dossier → entretien (si prévu) → démonstration (si exigée) → décision.
                La démonstration n’est obligatoire que si le Responsable l’a activée.
            </div>
        }

        <div class="alert alert-light border ex-demo-process mb-3">
            <strong>Processus du groupe :</strong> @_trackLabel
            <span class="text-muted"> La démonstration n’est exigée que si ce parcours l’inclut.</span>
            @if (_isManager)
            {
                <a class="ms-2" href="group-admin/settings">Configurer</a>
            }
        </div>

        @if (!_loading && ViaLinkPendingCount > 0)
        {
            <div class="ex-via-link-banner mb-3" role="status">
                <div>
                    <i class="bi bi-link-45deg" aria-hidden="true"></i>
                    <strong>@ViaLinkPendingCount inscription@(ViaLinkPendingCount > 1 ? "s" : "") via le lien d’invitation unique</strong>
                    <span>à examiner — ces dossiers apparaissent aussi dans « À examiner ».</span>
                </div>
                <button type="button" class="cc-btn cc-btn-primary" @onclick='() => SetBoard("link")'>
                    Voir les dossiers
                </button>
            </div>
        }

        @if (_showInvite)
        {
            <div class="cc-card mb-3">
                <h2 class="cc-card-title">Inviter des enseignants</h2>
                <div class="ex-invite-tabs mb-3">
                    <button type="button" class="@(_inviteMode == "email" ? "is-on" : null)" @onclick='() => _inviteMode = "email"'>
                        <i class="bi bi-envelope"></i> Par e-mail
                    </button>
                    <button type="button" class="@(_inviteMode == "link" ? "is-on" : null)" @onclick='() => _inviteMode = "link"'>
                        <i class="bi bi-link-45deg"></i> Lien unique
                    </button>
                </div>
                @if (_inviteMode == "email")
                {
                    <p class="small text-muted">L’enseignant rejoint la file d’approbation après inscription.</p>
                    @if (!string.IsNullOrEmpty(_inviteError))
                    {
                        <div class="alert alert-danger py-2">@_inviteError</div>
                    }
                    @if (!string.IsNullOrEmpty(_inviteSuccess))
                    {
                        <div class="alert alert-success py-2">@_inviteSuccess</div>
                    }
                    <div class="row g-2 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">E-mail <span class="ex-req">*</span></label>
                            <input class="form-control @(_inviteEmailInvalid ? "is-invalid" : null)" type="email"
                                   @bind="_inviteEmail" @bind:after="() => _inviteEmailInvalid = false" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Prénom</label>
                            <input class="form-control" @bind="_inviteFirstName" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Message</label>
                            <input class="form-control" @bind="_inviteMessage" />
                        </div>
                        <div class="col-12">
                            <button type="button" class="cc-btn cc-btn-primary" disabled="@_inviteBusy" @onclick="InviteAsync">
                                Envoyer l’invitation
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <TeacherInviteLinkPanel OnChanged="ReloadInvitesAsync" />
                }
            </div>
        }

        @if (_loading)
        {
            <div class="cc-empty"><span class="spinner-border"></span></div>
        }
        else
        {
            <div class="ex-approve-layout @(_selected is not null ? "has-drawer" : null)">
                <div>
                    @* Les onglets portent déjà les compteurs : le bandeau de six cartes qui les
                       répétait a été retiré. Seuls les deux chiffres du mois, absents des onglets,
                       restent, en texte, à droite de la barre. *@
                    <div class="ex-tabbar mb-3">
                        <div class="cc-tabs" role="tablist">
                            <button type="button" class="cc-tab @(_boardTab == "exam" ? "active" : null)" @onclick='() => SetBoard("exam")'>
                                À examiner (@PendingCount)
                            </button>
                            <button type="button" class="cc-tab @(_boardTab == "talk" ? "active" : null)" @onclick='() => SetBoard("talk")'>
                                Entretiens programmés (@InterviewCount)
                            </button>
                            <button type="button" class="cc-tab @(_boardTab == "eval" ? "active" : null)" @onclick='() => SetBoard("eval")'>
                                En évaluation (@ReviewCount)
                            </button>
                            <button type="button" class="cc-tab @(_boardTab == "link" ? "active" : null)" @onclick='() => SetBoard("link")'>
                                Lien unique (@ViaLinkPendingCount)
                            </button>
                            <button type="button" class="cc-tab @(_boardTab == "done" ? "active" : null)" @onclick='() => SetBoard("done")'>
                                Décisions récentes
                            </button>
                        </div>
                        <button type="button" class="ex-tabbar-note" @onclick='() => SetBoard("done")'>
                            Ce mois : <strong>@ApprovedMonth</strong> approuvé@(ApprovedMonth > 1 ? "s" : "")
                            · <strong>@RejectedMonth</strong> refusé@(RejectedMonth > 1 ? "s" : "")
                        </button>
                    </div>

                    <div class="cc-card ex-filter-bar mb-3">
                        <div class="ex-filter-search">
                            <i class="bi bi-search"></i>
                            <input class="form-control" placeholder="Rechercher un enseignant..."
                                   @bind="_search" @bind:event="oninput" @bind:after="OnFilterChanged" />
                        </div>
                        <div class="ex-filter-field">
                            <label>Matière</label>
                            <select class="form-select" @bind="_subjectFilter" @bind:after="OnFilterChanged">
                                <option value="">Toutes les matières</option>
                                @foreach (var s in SubjectOptions)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                        <div class="ex-filter-field">
                            <label>Niveau</label>
                            <select class="form-select" @bind="_levelFilter" @bind:after="OnFilterChanged">
                                <option value="">Tous les niveaux</option>
                                @foreach (var lv in LevelOptions)
                                {
                                    <option value="@lv">@lv</option>
                                }
                            </select>
                        </div>
                        <div class="ex-filter-field">
                            <label>Statut</label>
                            <select class="form-select" @bind="_statusFilter" @bind:after="OnFilterChanged">
                                <option value="">Tous les statuts</option>
                                <option value="0">En attente d’examen</option>
                                <option value="5">Attribué</option>
                                <option value="4">En évaluation</option>
                                <option value="3">Modifications</option>
                                <option value="1">Approuvé</option>
                                <option value="2">Refusé</option>
                            </select>
                        </div>
                        <button type="button" class="cc-btn" @onclick="ResetFilters">
                            <i class="bi bi-funnel"></i> Filtres
                        </button>
                    </div>

                    <div class="cc-card ex-teachers-table-wrap mb-3">
                        @if (_filtered.Count == 0)
                        {
                            <div class="cc-empty py-4">
                                <i class="bi bi-inbox"></i>
                                <p>@(_boardTab == "link" ? "Aucune inscription via le lien unique pour le moment." : "Aucun dossier dans cet onglet.")</p>
                            </div>
                        }
                        else
                        {
                            <table class="cc-table ex-teachers-table">
                                <thead>
                                    <tr>
                                        <th>Candidat</th>
                                        <th>Matières</th>
                                        <th>Niveaux</th>
                                        <th>Expérience</th>
                                        <th>Statut</th>
                                        <th>Date d'invitation</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Paged)
                                    {
                                        <tr class="@($"{(_selected?.TenantId == row.TenantId ? "table-active" : "")}{(row.ViaInviteLink ? " ex-via-link-row" : "")}")"
                                            @onclick="() => SelectRowAsync(row)" style="cursor:pointer">
                                            <td>
                                                <div class="ex-teacher-id">
                                                    @if (!string.IsNullOrWhiteSpace(row.LogoUrl))
                                                    {
                                                        <img src="@MediaUrlHelper.Resolve(row.LogoUrl, Config, Nav)" alt="" />
                                                    }
                                                    else
                                                    {
                                                        <span class="ex-teacher-avatar">@Initials(row.Name)</span>
                                                    }
                                                    <div>
                                                        <strong>@row.Name</strong>
                                                        @if (row.ViaInviteLink)
                                                        {
                                                            <span class="ex-via-link-pill"><i class="bi bi-link-45deg"></i> Lien unique</span>
                                                        }
                                                        <span>@(row.Email ?? "—")</span>
                                                        @if (!string.IsNullOrWhiteSpace(row.InvitedBy))
                                                        {
                                                            <span>Invité par : @row.InvitedBy</span>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="ex-subj-wrap">
                                                    @if (row.Subjects.Count == 0)
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var s in row.Subjects.Take(3))
                                                        {
                                                            <span class="ex-subj" data-tone="@SubjectTone(s)">@s</span>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                            <td>@(row.Levels.Count == 0 ? "—" : string.Join(", ", row.Levels))</td>
                                            <td>@(row.Years is int y ? $"{y} ans" : "—")</td>
                                            <td>
                                                <span class="ex-status @StatusClass(row.Status)">
                                                    <i></i> @StatusLabel(row.Status)
                                                </span>
                                            </td>
                                            <td>@row.Date.ToLocalTime().ToString("d MMM yyyy", Fr)</td>
                                            <td class="text-end" @onclick:stopPropagation="true">
                                                <div class="ex-row-actions">
                                                    <button type="button" class="cc-btn btn-sm" @onclick="() => SelectRowAsync(row)">Voir le dossier</button>
                                                    <div class="ex-more">
                                                        <button type="button" class="ex-more-btn" aria-label="Plus d'actions"
                                                                @onclick="() => ToggleMenu(row.TenantId)" @onclick:stopPropagation="true">
                                                            <i class="bi bi-three-dots-vertical"></i>
                                                        </button>
                                                        @if (_menuId == row.TenantId)
                                                        {
                                                            <div class="ex-more-menu">
                                                                <button type="button" @onclick="() => SelectRowAsync(row)">
                                                                    <i class="bi bi-folder2-open"></i> Voir le dossier
                                                                </button>
                                                                @if (CanDecide(row.Status))
                                                                {
                                                                    <button type="button" @onclick="() => OpenInterviewFromRow(row)">
                                                                        <i class="bi bi-camera-video"></i> Programmer un entretien
                                                                    </button>
                                                                    <button type="button" class="text-danger" @onclick="() => OpenRejectFromRow(row)">
                                                                        <i class="bi bi-x-circle"></i> Refuser
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="ex-table-foot">
                                <span>Affichage de @FromRow à @ToRow sur @_filtered.Count dossier@(_filtered.Count > 1 ? "s" : "")</span>
                                <div class="ex-table-pager">
                                    <select class="form-select form-select-sm" @bind="_pageSize" @bind:after="() => { _page = 1; }">
                                        <option value="10">10 par page</option>
                                        <option value="20">20 par page</option>
                                    </select>
                                    <button type="button" class="cc-btn btn-sm" disabled="@(_page <= 1)" @onclick="FirstPage">«</button>
                                    <button type="button" class="cc-btn btn-sm" disabled="@(_page <= 1)" @onclick="PrevPage">‹</button>
                                    @for (var i = 1; i <= PageCount; i++)
                                    {
                                        var p = i;
                                        <button type="button" class="ex-page-n @(_page == p ? "is-on" : null)" @onclick="() => GoPage(p)">@p</button>
                                    }
                                    <button type="button" class="cc-btn btn-sm" disabled="@(_page >= PageCount)" @onclick="NextPage">›</button>
                                    <button type="button" class="cc-btn btn-sm" disabled="@(_page >= PageCount)" @onclick="LastPage">»</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (_selected is RowVm sel)
                {
                    <aside class="cc-card ex-approve-drawer">
                        <div class="ex-drawer-titlebar">
                            <strong>Dossier du candidat</strong>
                            <button type="button" class="ex-more-btn" @onclick="CloseDrawer" aria-label="Fermer">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <div class="ex-drawer-head">
                            <span class="ex-teacher-avatar">@Initials(sel.Name)</span>
                            <div>
                                <strong>@sel.Name</strong>
                                @if (sel.ViaInviteLink)
                                {
                                    <span class="ex-via-link-pill"><i class="bi bi-link-45deg"></i> Inscrit via le lien unique</span>
                                }
                                <span>@(sel.Email ?? "—")</span>
                            </div>
                        </div>
                        <div class="ex-drawer-meta">
                            <span><i class="bi bi-book"></i> @(sel.Subjects.Count == 0 ? "—" : string.Join(", ", sel.Subjects.Take(2)))</span>
                            <span><i class="bi bi-layers"></i> @(sel.Levels.Count == 0 ? "—" : string.Join(", ", sel.Levels.Take(2)))</span>
                            <span><i class="bi bi-briefcase"></i> @(sel.Years is int y ? $"{y} ans" : "—")</span>
                        </div>

                        <div class="cc-tabs mb-2">
                            <button type="button" class="cc-tab @(_drawerTab == "sum" ? "active" : null)" @onclick='() => _drawerTab = "sum"'>Résumé</button>
                            <button type="button" class="cc-tab @(_drawerTab == "docs" ? "active" : null)" @onclick='() => _drawerTab = "docs"'>
                                Documents@(_detail?.Documents?.Count is int dc && dc > 0 ? $" ({dc})" : "")
                            </button>
                            <button type="button" class="cc-tab @(_drawerTab == "eval" ? "active" : null)" @onclick='() => _drawerTab = "eval"'>Évaluations</button>
                            <button type="button" class="cc-tab @(_drawerTab == "hist" ? "active" : null)" @onclick='() => _drawerTab = "hist"'>Historique</button>
                        </div>

                        @if (_detailLoading)
                        {
                            <div class="cc-empty py-3"><span class="spinner-border spinner-border-sm"></span></div>
                        }
                        else if (_drawerTab == "docs")
                        {
                            @if (_detail?.Documents is { Count: > 0 } docs)
                            {
                                <ul class="ex-doc-list">
                                    @foreach (var d in docs)
                                    {
                                        <li>
                                            <i class="bi bi-file-earmark-pdf"></i>
                                            <div>
                                                <a href="@MediaUrlHelper.Resolve(d.FileUrl, Config, Nav)" target="_blank" rel="noopener">@d.FileName</a>
                                                <span>@DocLabel(d.DocumentType) · @FormatSize(d.FileSizeBytes)</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="small text-muted mb-0">Aucune pièce jointe.</p>
                            }
                        }
                        else if (_drawerTab == "eval")
                        {
                            <p class="small mb-0">@(string.IsNullOrWhiteSpace(_detail?.ExpertApprovalNotes) && string.IsNullOrWhiteSpace(sel.Notes) ? "Pas encore d’évaluation écrite." : (_detail?.ExpertApprovalNotes ?? sel.Notes))</p>
                        }
                        else if (_drawerTab == "hist")
                        {
                            <ul class="small text-muted mb-0">
                                <li>Créé le @sel.Date.ToLocalTime().ToString("d MMM yyyy HH:mm", Fr)</li>
                                @if (!string.IsNullOrWhiteSpace(sel.AssignedTo))
                                {
                                    <li>Attribué à @sel.AssignedTo</li>
                                }
                                @if (_detail?.ExpertApprovedAt is DateTime at)
                                {
                                    <li>Décision le @at.ToLocalTime().ToString("d MMM yyyy HH:mm", Fr)</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <h3 class="h6">Résumé du profil</h3>
                            <p class="small">@(FirstText(_detail?.Presentation, _detail?.Description) ?? "Aucune présentation.")</p>
                            @if (_portfolio?.Diplomas is { Count: > 0 })
                            {
                                <h3 class="h6">Formation</h3>
                                <ul class="small">
                                    @foreach (var d in _portfolio.Diplomas)
                                    {
                                        <li>@(d.Title ?? "—")@(string.IsNullOrWhiteSpace(d.Institution) ? "" : $" — {d.Institution}")</li>
                                    }
                                </ul>
                            }
                            @if (_portfolio?.Certifications is { Count: > 0 })
                            {
                                <h3 class="h6">Expérience professionnelle</h3>
                                <ul class="small">
                                    @foreach (var c in _portfolio.Certifications)
                                    {
                                        <li>@(c.Title ?? "—")</li>
                                    }
                                </ul>
                            }
                        }

                        @if (_showReject)
                        {
                            <div class="mt-3">
                                <label class="form-label">Motif du refus</label>
                                <textarea class="form-control" rows="3" @bind="_notes"></textarea>
                            </div>
                        }
                        @if (_showInterview)
                        {
                            <div class="mt-3">
                                <label class="form-label">Date de l’entretien</label>
                                <input type="datetime-local" class="form-control" @bind="_interviewAt" />
                            </div>
                        }

                        @if (CanDecide(sel.Status))
                        {
                            @if (!string.IsNullOrEmpty(ProcessGap(sel)))
                            {
                                <p class="small text-warning mb-2">@ProcessGap(sel)</p>
                            }
                            <div class="mb-3">
                                <p class="form-label fw-semibold mb-2">Activation de la session</p>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="license-settle" id="settle-pay"
                                           checked="@(_licenseSettlement == "pay")"
                                           @onchange='() => _licenseSettlement = "pay"' />
                                    <label class="form-check-label" for="settle-pay">L’enseignant paie 10 $ USD</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="license-settle" id="settle-promo"
                                           checked="@(_licenseSettlement == "promo")"
                                           @onchange='() => _licenseSettlement = "promo"' />
                                    <label class="form-check-label" for="settle-promo">Clé d'activation</label>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="license-settle" id="settle-hold"
                                           checked="@(_licenseSettlement == "withhold")"
                                           @onchange='() => _licenseSettlement = "withhold"' />
                                    <label class="form-check-label" for="settle-hold">Retenue à la source (10 $ USD sur les premiers paiements)</label>
                                </div>
                                @if (_licenseSettlement == "promo")
                                {
                                    <input class="form-control font-monospace text-uppercase" maxlength="64"
                                           placeholder="TUTOR-MM-AAAAA-DD-UNIQUEGUID"
                                           @bind="_licensePromo" />
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" id="settle-autorenew"
                                               @bind="_autoRenewAtSource" />
                                        <label class="form-check-label" for="settle-autorenew">
                                            J’autorise le renouvellement annuel automatique par retenue à la source
                                        </label>
                                    </div>
                                    <p class="form-text">Chaque année, 10 $ USD sont prélevés sur les premiers paiements dus à l’enseignant.</p>
                                }
                            </div>
                            <div class="ex-drawer-actions">
                                <button type="button" class="ex-btn-danger" disabled="@_busy" @onclick="RejectAsync">Refuser le dossier</button>
                                <button type="button" class="cc-btn" disabled="@_busy" @onclick="ScheduleInterviewAsync">Programmer un entretien</button>
                                <button type="button" class="ex-btn-ok" disabled="@_busy" @onclick="ApproveAsync">Approuver</button>
                            </div>
                        }
                    </aside>
                }
            </div>
        }

        @if (_assignTarget is not null)
        {
            <div class="cc-card mt-3">
                <h2 class="cc-card-title">Attribuer le dossier</h2>
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <select class="form-select" @bind="_assignUserId">
                            <option value="">— Expert —</option>
                            @foreach (var m in _members)
                            {
                                <option value="@m.UserId">@(string.IsNullOrWhiteSpace(m.FullName) ? m.Email : m.FullName)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="button" class="cc-btn cc-btn-primary" disabled="@_assignBusy" @onclick="ConfirmAssignAsync">Confirmer</button>
                        <button type="button" class="cc-btn" @onclick="() => _assignTarget = null">Annuler</button>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="cc-card cc-empty">
            <p>@L["Expert_LoginRequired"]</p>
            <a class="cc-btn cc-btn-primary" href="/login/expert">@L["Nav_Login"]</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly CultureInfo Fr = new("fr-FR");
    private static readonly JsonSerializerOptions PortfolioJson = new()
    {
        PropertyNameCaseInsensitive = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    private bool _loading = true;
    private bool _busy;
    private bool _showInvite;
    private string _inviteMode = "email";
    private bool _showGuide;
    private bool _showReject;
    private bool _showInterview;
    private bool _detailLoading;
    private bool _inviteBusy;
    private bool _inviteEmailInvalid;
    private bool _assignBusy;
    private bool _isManager;
    private int _track;
    private string? _error;
    private string? _success;
    private string? _inviteError;
    private string? _inviteSuccess;
    private string _boardTab = "exam";
    private string _drawerTab = "sum";
    private string _search = "";
    private string _subjectFilter = "";
    private string _levelFilter = "";
    private string _statusFilter = "";
    private string _inviteEmail = "";
    private string _inviteFirstName = "";
    private string _inviteMessage = "";
    private string _notes = "";
    private string _licenseSettlement = "pay";
    private string _licensePromo = "";
    private bool _autoRenewAtSource = true;
    private string _assignUserId = "";
    private DateTime? _interviewAt;
    private int _page = 1;
    private int _pageSize = 10;
    private Guid? _menuId;

    private List<QueueItem> _queue = [];
    private List<DirItem> _directory = [];
    private List<DecisionItem> _decisions = [];
    private List<TalkItem> _talks = [];
    private List<TalkItem> _demos = [];
    private List<InviteItem> _invites = [];
    private List<MemberItem> _members = [];
    private List<RowVm> _filtered = [];
    private RowVm? _selected;
    private QueueItem? _assignTarget;
    private ReviewDetail? _detail;
    private Showcase? _portfolio;

    private int PendingCount => _queue.Count(q => q.ApprovalStatus == 0);
    private int ReviewCount => _queue.Count(q => q.ApprovalStatus is 3 or 4 or 5);
    private int InterviewCount => _talks.Count(t => t.Status is 0 or 1);
    private int ViaLinkPendingCount => _queue.Count(q => q.JoinedViaInviteLink && q.ApprovalStatus is 0 or 3 or 4 or 5);
    private int ApprovedMonth => _decisions.Count(d => d.ApprovalStatus == 1);
    private int RejectedMonth => _decisions.Count(d => d.ApprovalStatus == 2);
    private string _trackLabel => _track switch
    {
        1 => "Dossier → Entretien → Approbation",
        2 => "Dossier → Entretien → Démonstration → Approbation",
        3 => "Dossier → Démonstration → Approbation",
        _ => "Dossier → Approbation"
    };
    private int PageCount => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));
    private int FromRow => _filtered.Count == 0 ? 0 : ((_page - 1) * _pageSize) + 1;
    private int ToRow => Math.Min(_filtered.Count, _page * _pageSize);
    private IEnumerable<RowVm> Paged => _filtered.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private void FirstPage() { if (_page > 1) _page = 1; }
    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < PageCount) _page++; }
    private void LastPage() => _page = PageCount;
    private void GoPage(int p) => _page = p;

    private IEnumerable<string> SubjectOptions => _directory.SelectMany(d => d.Subjects ?? []).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    private IEnumerable<string> LevelOptions => _directory.SelectMany(d => d.Levels ?? []).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private List<RowVm> AllRows
    {
        get
        {
            IEnumerable<RowVm> FromQueue(IEnumerable<QueueItem> src) => src.Select(q =>
            {
                var dir = _directory.FirstOrDefault(d => d.TenantId == q.TenantId);
                var inv = _invites.FirstOrDefault(i => i.AcceptedTenantId == q.TenantId
                    || string.Equals(i.Email, q.OwnerEmail, StringComparison.OrdinalIgnoreCase));
                return new RowVm(
                    q.TenantId,
                    dir?.DisplayName ?? q.OwnerName ?? q.SchoolName,
                    q.OwnerEmail,
                    inv?.InvitedByName,
                    dir?.Subjects ?? [],
                    dir?.Levels ?? [],
                    dir?.YearsExperience,
                    q.ApprovalStatus,
                    q.CreatedAt,
                    dir?.LogoUrl,
                    q.ReviewAssignedToName,
                    q.ReviewRequestNotes,
                    q.JoinedViaInviteLink);
            });

            return _boardTab switch
            {
                "talk" => _talks
                    .Where(t => t.Status is 0 or 1 && t.RelatedTeacherTenantId is Guid)
                    .Select(t =>
                    {
                        var id = t.RelatedTeacherTenantId!.Value;
                        var q = _queue.FirstOrDefault(x => x.TenantId == id);
                        var dir = _directory.FirstOrDefault(d => d.TenantId == id);
                        var inv = _invites.FirstOrDefault(i => i.AcceptedTenantId == id);
                        return new RowVm(
                            id,
                            dir?.DisplayName ?? q?.OwnerName ?? q?.SchoolName ?? t.Title,
                            q?.OwnerEmail ?? dir?.OwnerEmail,
                            inv?.InvitedByName,
                            dir?.Subjects ?? [],
                            dir?.Levels ?? [],
                            dir?.YearsExperience,
                            q?.ApprovalStatus ?? 0,
                            t.ScheduledAtUtc ?? t.CreatedAt,
                            dir?.LogoUrl,
                            q?.ReviewAssignedToName,
                            q?.ReviewRequestNotes,
                            q?.JoinedViaInviteLink ?? false);
                    }).ToList(),
                "eval" => FromQueue(_queue.Where(q => q.ApprovalStatus is 3 or 4 or 5)).ToList(),
                "link" => FromQueue(_queue.Where(q => q.JoinedViaInviteLink && q.ApprovalStatus is 0 or 3 or 4 or 5)).ToList(),
                "done" => _decisions.Select(d =>
                {
                    var dir = _directory.FirstOrDefault(x => x.TenantId == d.TenantId);
                    return new RowVm(d.TenantId, d.DisplayName, d.OwnerEmail, null, dir?.Subjects ?? [], dir?.Levels ?? [], dir?.YearsExperience, d.ApprovalStatus, d.DecisionAt ?? DateTime.UtcNow, dir?.LogoUrl, null, d.Notes, dir?.JoinedViaInviteLink ?? false);
                }).ToList(),
                _ => FromQueue(_queue.Where(q => q.ApprovalStatus == 0)).ToList()
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        ApplyInviteQuery();
        await LoadAllAsync();
    }

    private void ApplyInviteQuery()
    {
        try
        {
            var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
            if (q.TryGetValue("tab", out var tab) && string.Equals(tab.ToString(), "register", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("expert/teachers/add");
                return;
            }
            if (q.TryGetValue("tab", out tab) && string.Equals(tab.ToString(), "invite", StringComparison.OrdinalIgnoreCase))
            {
                _showInvite = true;
                _inviteMode = "email";
            }
        }
        catch { }
    }

    private async Task LoadAllAsync()
    {
        _loading = true;
        try
        {
            var monthStart = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1, 0, 0, 0, DateTimeKind.Utc);
            var queueT = Api.GetAsync<List<QueueItem>>("api/expert/approvals-queue");
            var dirT = Api.GetAsync<List<DirItem>>("api/expert/teacher-directory");
            var talkT = Api.GetAsync<List<TalkItem>>("api/expert/workspace?type=0");
            var demoT = Api.GetAsync<List<TalkItem>>("api/expert/workspace?type=1");
            var decT = Api.GetAsync<List<DecisionItem>>($"api/expert/teacher-decisions?sinceUtc={monthStart:O}");
            var invT = Api.GetAsync<List<InviteItem>>("api/expert/invitations");
            var ctxT = Api.GetAsync<MeCtx>("api/expert/me-context");
            var grpT = Api.GetAsync<GroupDto>("api/expert/my-group");
            await Task.WhenAll(queueT, dirT, talkT, demoT, decT, invT, ctxT, grpT);
            _queue = await queueT ?? [];
            _directory = await dirT ?? [];
            _talks = await talkT ?? [];
            _demos = await demoT ?? [];
            _decisions = await decT ?? [];
            _invites = await invT ?? [];
            _isManager = (await ctxT)?.IsGroupManager == true;
            _track = (await grpT)?.TeacherApprovalTrack ?? 0;
            OnFilterChanged();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void SetBoard(string tab)
    {
        _boardTab = tab;
        _page = 1;
        OnFilterChanged();
    }

    private void ResetFilters()
    {
        _search = _subjectFilter = _levelFilter = _statusFilter = "";
        OnFilterChanged();
    }

    private void OnFilterChanged()
    {
        IEnumerable<RowVm> q = AllRows;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim();
            q = q.Where(r => r.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
                || (r.Email?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        if (!string.IsNullOrWhiteSpace(_subjectFilter))
            q = q.Where(r => r.Subjects.Any(x => string.Equals(x, _subjectFilter, StringComparison.OrdinalIgnoreCase)));
        if (!string.IsNullOrWhiteSpace(_levelFilter))
            q = q.Where(r => r.Levels.Any(x => string.Equals(x, _levelFilter, StringComparison.OrdinalIgnoreCase)));
        if (int.TryParse(_statusFilter, out var st))
            q = q.Where(r => r.Status == st);
        _filtered = q.ToList();
        if (_page > PageCount) _page = PageCount;
    }

    private async Task SelectRowAsync(RowVm row)
    {
        _menuId = null;
        _selected = row;
        _drawerTab = "sum";
        _showReject = _showInterview = false;
        _notes = "";
        _detailLoading = true;
        try
        {
            _detail = await Api.GetAsync<ReviewDetail>($"api/expert/teachers/{row.TenantId}");
            _portfolio = ParsePortfolio(_detail?.Portfolio);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _detailLoading = false; }
    }

    private void ToggleMenu(Guid id) => _menuId = _menuId == id ? null : id;

    private async Task OpenInterviewFromRow(RowVm row)
    {
        await SelectRowAsync(row);
        await ScheduleInterviewAsync();
    }

    private async Task OpenRejectFromRow(RowVm row)
    {
        await SelectRowAsync(row);
        await RejectAsync();
    }

    private void CloseDrawer()
    {
        _selected = null;
        _detail = null;
        _portfolio = null;
        _showReject = _showInterview = false;
    }

    private async Task ApproveAsync()
    {
        if (_selected is null) return;
        _busy = true;
        _error = _success = null;
        try
        {
            var r = await Api.PostWithErrorAsync<object>($"api/expert/teachers/{_selected.TenantId}/approve", new
            {
                notes = _notes,
                licenseSettlement = _licenseSettlement,
                promoCode = _licensePromo,
                autoRenewAtSource = _licenseSettlement == "promo" && _autoRenewAtSource
            });
            if (r.Error is not null) { _error = r.Error; return; }
            _success = "Dossier approuvé.";
            CloseDrawer();
            await LoadAllAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RejectAsync()
    {
        if (_selected is null) return;
        if (!_showReject)
        {
            _showReject = true;
            _showInterview = false;
            return;
        }
        if (string.IsNullOrWhiteSpace(_notes))
        {
            _error = L["Expert_RejectNotesRequired"];
            return;
        }
        _busy = true;
        _error = _success = null;
        try
        {
            var r = await Api.PostWithErrorAsync<object>($"api/expert/teachers/{_selected.TenantId}/reject", new { notes = _notes });
            if (r.Error is not null) { _error = r.Error; return; }
            _success = "Dossier refusé.";
            CloseDrawer();
            await LoadAllAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ScheduleInterviewAsync()
    {
        if (_selected is null) return;
        if (!_showInterview)
        {
            _showInterview = true;
            _showReject = false;
            _interviewAt = DateTime.Now.AddDays(2).Date.AddHours(10);
            return;
        }
        _busy = true;
        _error = _success = null;
        try
        {
            DateTime? utc = _interviewAt.HasValue
                ? DateTime.SpecifyKind(_interviewAt.Value, DateTimeKind.Local).ToUniversalTime()
                : null;
            var r = await Api.PostWithErrorAsync<TalkItem>("api/expert/workspace", new
            {
                itemType = 0,
                title = $"Entretien — {_selected.Name}",
                relatedTeacherTenantId = _selected.TenantId,
                scheduledAtUtc = utc
            });
            if (r.Error is not null) { _error = r.Error; return; }
            _success = "Entretien programmé.";
            _showInterview = false;
            await LoadAllAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmAssignAsync()
    {
        if (_assignTarget is null || string.IsNullOrWhiteSpace(_assignUserId))
        {
            _error = "Choisissez un Expert.";
            return;
        }
        _assignBusy = true;
        try
        {
            var r = await Api.PostWithErrorAsync<object>($"api/expert/teachers/{_assignTarget.TenantId}/assign", new
            {
                assigneeUserId = _assignUserId,
                urgent = false
            });
            if (r.Error is not null) { _error = r.Error; return; }
            _assignTarget = null;
            await LoadAllAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _assignBusy = false; }
    }

    private async Task InviteAsync()
    {
        _inviteError = _inviteSuccess = null;
        // Contrôle avant l'appel : sans lui, une adresse vide partait au serveur et revenait en
        // « Adresse e-mail invalide », sans désigner le champ fautif.
        _inviteEmailInvalid = string.IsNullOrWhiteSpace(_inviteEmail) || !IsEmail(_inviteEmail);
        if (_inviteEmailInvalid)
        {
            _inviteError = string.IsNullOrWhiteSpace(_inviteEmail)
                ? "L'adresse e-mail est obligatoire pour envoyer une invitation."
                : "Cette adresse e-mail n'est pas valide.";
            return;
        }

        _inviteBusy = true;
        try
        {
            var result = await Api.PostWithErrorAsync<object>("api/expert/invite-application", new
            {
                email = _inviteEmail,
                firstName = string.IsNullOrWhiteSpace(_inviteFirstName) ? null : _inviteFirstName,
                personalMessage = string.IsNullOrWhiteSpace(_inviteMessage) ? null : _inviteMessage
            });
            if (result.Error is not null) { _inviteError = result.Error; return; }
            _inviteSuccess = L["Expert_InviteSuccess"];
            _inviteEmail = _inviteFirstName = _inviteMessage = "";
            _invites = await Api.GetAsync<List<InviteItem>>("api/expert/invitations") ?? _invites;
        }
        catch (Exception ex) { _inviteError = ex.Message; }
        finally { _inviteBusy = false; }
    }

    private async Task ReloadInvitesAsync()
    {
        _invites = await Api.GetAsync<List<InviteItem>>("api/expert/invitations") ?? _invites;
    }

    /// <summary>
    /// Contrôle volontairement sommaire : une arobase entourée de texte et un point dans le
    /// domaine. Il s'agit d'attraper la faute de frappe avant l'aller-retour réseau, pas de
    /// valider l'adresse — seul l'envoi du courriel le fera.
    /// </summary>
    private static bool IsEmail(string value)
    {
        var at = value.IndexOf('@');
        return at > 0
            && at < value.Length - 1
            && value.IndexOf('@', at + 1) < 0
            && value.LastIndexOf('.') > at + 1
            && !value.EndsWith('.')
            && !value.Any(char.IsWhiteSpace);
    }

    private static bool CanDecide(int status) => status is 0 or 3 or 4 or 5;

    private string? ProcessGap(RowVm sel)
    {
        if (_track is 1 or 2)
        {
            var interviewDone = _talks.Any(t => t.RelatedTeacherTenantId == sel.TenantId && t.Status == 2);
            if (!interviewDone)
                return "Le processus du groupe exige un entretien clôturé avant l’approbation définitive.";
        }
        if (_track is 2 or 3)
        {
            var demoOk = _demos.Any(d =>
                d.RelatedTeacherTenantId == sel.TenantId
                && d.Status == 2
                && DemoApproved(d.PayloadJson));
            if (!demoOk)
                return "Le processus du groupe exige une démonstration pédagogique avec recommandation « Approuver ».";
        }
        return null;
    }

    private static bool DemoApproved(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return false;
        try
        {
            using var doc = JsonDocument.Parse(json);
            return doc.RootElement.TryGetProperty("recommendation", out var r) && r.GetInt32() == 1;
        }
        catch { return false; }
    }
    private static string StatusLabel(int status) => status switch
    {
        1 => "Approuvé",
        2 => "Refusé",
        3 => "Modifications",
        4 => "En évaluation",
        5 => "Attribué",
        _ => "En attente d’examen"
    };
    private static string StatusClass(int status) => status switch
    {
        1 => "is-ok",
        2 => "is-bad",
        3 or 4 or 5 => "is-eval",
        _ => "is-wait"
    };
    private static string Initials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
        return string.IsNullOrEmpty(name) ? "?" : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }
    private static int SubjectTone(string s) => Math.Abs(s.GetHashCode(StringComparison.OrdinalIgnoreCase)) % 5;
    private static string? FirstText(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));
    private string DocLabel(int type) => type switch
    {
        0 => L["TeacherDoc_Identification"],
        1 => L["TeacherDoc_Diploma"],
        2 => L["TeacherDoc_Cv"],
        3 => L["TeacherDoc_CoverLetter"],
        _ => L["TeacherDoc_Other"]
    };
    private static string FormatSize(long bytes) =>
        bytes < 1024 ? $"{bytes} o" : bytes < 1024 * 1024 ? $"{bytes / 1024.0:0} Ko" : $"{bytes / (1024.0 * 1024):0.0} Mo";
    private static Showcase? ParsePortfolio(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try { return JsonSerializer.Deserialize<Showcase>(json, PortfolioJson); }
        catch { return null; }
    }

    private sealed record RowVm(
        Guid TenantId, string Name, string? Email, string? InvitedBy,
        List<string> Subjects, List<string> Levels, int? Years, int Status, DateTime Date,
        string? LogoUrl, string? AssignedTo, string? Notes, bool ViaInviteLink = false);
    private sealed record QueueItem(
        Guid TenantId, string SchoolName, string Slug, string? Country, string? City,
        int ApprovalStatus, DateTime CreatedAt, int AgeDays, string? OwnerEmail, string? OwnerName,
        int DocumentCount, bool IsComplete, int ReviewPriority, string? ReviewAssignedToUserId,
        string? ReviewAssignedToName, string? ReviewRequestNotes, bool JoinedViaInviteLink = false);
    private sealed record DirItem(
        Guid TenantId, string DisplayName, string? OwnerEmail, string? LogoUrl,
        List<string>? Subjects, List<string>? Levels, int? YearsExperience, int ApprovalStatus,
        DateTime CreatedAt, string Slug, bool IsPublicProfile, string? City = null, string? Country = null,
        bool JoinedViaInviteLink = false);
    private sealed record DecisionItem(Guid TenantId, string DisplayName, string? OwnerEmail, int ApprovalStatus, DateTime? DecisionAt, string? Notes);
    private sealed record TalkItem(Guid Id, int ItemType, int Status, string Title, Guid? RelatedTeacherTenantId, DateTime? ScheduledAtUtc, DateTime CreatedAt, string? PayloadJson = null);
    private sealed record InviteItem(Guid Id, string Email, string? FirstName, int Status, DateTime SentAt, Guid? AcceptedTenantId, string? InvitedByName);
    private sealed record MemberItem(Guid Id, Guid ExpertGroupId, string UserId, string Email, string FullName);
    private sealed record MeCtx(bool IsGroupManager, Guid? GroupId, string? GroupName);
    private sealed record GroupDto(Guid Id, string Name, int TeacherApprovalTrack = 0);
    private sealed record ReviewDoc(Guid Id, int DocumentType, string FileName, string FileUrl, long FileSizeBytes);
    private sealed record ReviewDetail(
        Guid TenantId, string SchoolName, string? Description, int ApprovalStatus,
        string? ExpertApprovalNotes, DateTime? ExpertApprovedAt, string? OwnerEmail, string? OwnerName,
        string? Presentation, string? Portfolio, string? LogoUrl, List<ReviewDoc>? Documents);
    private sealed record Cred(string? Title, string? Institution, string? Year);
    private sealed record Showcase(int YearsExperience, List<Cred>? Diplomas, List<Cred>? Certifications, List<string>? Subjects, List<string>? Levels);
}
