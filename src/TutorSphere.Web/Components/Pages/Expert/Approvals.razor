    private bool IsRegSlugFormatValid => !string.IsNullOrWhiteSpace(_regSlug)
        && System.Text.RegularExpressions.Regex.IsMatch(_regSlug, @"^[a-z0-9]([a-z0-9-]{1,48}[a-z0-9])?$");

    private string RegCountryDisplay
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_regCountry))
                return "—";
            var info = CountryCatalog.Find(_regCountry);
