    private sealed record MemberItem(Guid Id, Guid ExpertGroupId, string UserId, string Email, string FullName);
    private sealed record MeCtx(bool IsGroupManager, Guid? GroupId, string? GroupName);

    private async Task LoadInvitesAsync()
    {
        try
        {
            _invites = await Api.GetAsync<List<TeacherInviteItem>>("api/expert/invitations") ?? [];
        }
        catch
        {
            _invites = [];
        }
        finally { _invitesLoading = false; }
    }

    private async Task InviteAsync()
    {
        _inviteBusy = true;
        _inviteError = null;
        _inviteSuccess = null;
        try
        {
            var result = await Api.PostWithErrorAsync<object>("api/expert/invite-application", new
            {
                email = _inviteEmail,
                firstName = string.IsNullOrWhiteSpace(_inviteFirstName) ? null : _inviteFirstName,
                personalMessage = string.IsNullOrWhiteSpace(_inviteMessage) ? null : _inviteMessage
            });
            if (result.Error is not null)
            {
                _inviteError = result.Error;
                return;
            }

            _inviteSuccess = L["Expert_InviteSuccess"];
            _inviteEmail = "";
            _inviteFirstName = "";
            _inviteMessage = "";
            await LoadInvitesAsync();
        }
        catch (Exception ex)
        {
            _inviteError = ex.Message;
        }
        finally { _inviteBusy = false; }
    }

    private Task OnRegAddVisibleChanged(string? code)
    {
        _regAddVisible = null;
        if (string.IsNullOrWhiteSpace(code))
            return Task.CompletedTask;
        var n = code.Trim().ToUpperInvariant();
        if (!_regVisibleCountries.Contains(n, StringComparer.OrdinalIgnoreCase))
            _regVisibleCountries.Add(n);
        return Task.CompletedTask;
    }

    private void RemoveRegVisible(string code)
    {
        _regVisibleCountries.RemoveAll(c => string.Equals(c, code, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_regCountry)
            && !_regVisibleCountries.Contains(_regCountry, StringComparer.OrdinalIgnoreCase))
            _regVisibleCountries.Insert(0, _regCountry.Trim().ToUpperInvariant());
    }

    private async Task OnRegNameChanged()
    {
        if (!string.IsNullOrWhiteSpace(_regSlug) && _regSlug != _regAutoSlugValue)
            return;

        var generated = SlugifyName(_regFirstName, _regLastName);
        if (generated == _regAutoSlugValue)
            return;

        _regAutoSlugValue = generated;
        _regSlug = generated;
        await AfterRegSlugChanged();
    }

    private static string SlugifyName(string firstName, string lastName)
    {
        var combined = $"{firstName} {lastName}".Trim();
        if (string.IsNullOrWhiteSpace(combined))
            return "";

        var normalized = combined.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in normalized)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c)
                != System.Globalization.UnicodeCategory.NonSpacingMark)
            {
                sb.Append(c);
            }
        }

        var ascii = sb.ToString().Normalize(System.Text.NormalizationForm.FormC);
        var slug = System.Text.RegularExpressions.Regex.Replace(ascii.ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');
        return slug.Length > 40 ? slug[..40].Trim('-') : slug;
    }

    private async Task AfterRegSlugChanged()
    {
        _regSlug = _regSlug.Trim().ToLowerInvariant();
        _regSlugAvailable = null;

        if (!IsRegSlugFormatValid) return;

        _regSlugCts?.Cancel();
        _regSlugCts = new CancellationTokenSource();
        var token = _regSlugCts.Token;

        _regCheckingSlug = true;
        StateHasChanged();

        try
        {
            await Task.Delay(500, token);
            if (token.IsCancellationRequested) return;

            var result = await Api.GetAsync<SlugCheckResult>($"api/tenants/check-slug/{Uri.EscapeDataString(_regSlug)}");
            if (result is not null)
                _regSlugAvailable = result.Available;
        }
        catch (OperationCanceledException) { }
        catch { }
        finally
        {
            _regCheckingSlug = false;
            StateHasChanged();
        }
    }

    private async Task RegisterTeacherAsync()
    {
        _regBusy = true;
        _regError = null;
        _regSuccess = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_regSchoolName)
                || string.IsNullOrWhiteSpace(_regSlug)
                || string.IsNullOrWhiteSpace(_regFirstName) || string.IsNullOrWhiteSpace(_regLastName))
            {
                _regError = L["Error_FillAllFields"];
                return;
            }

            if (!IsRegSlugFormatValid)
            {
                _regError = L["Error_InvalidSubdomain"];
                return;
            }

            if (_regSlugAvailable == false)
            {
                _regError = L["Error_SlugTaken"];
                return;
            }

            if (!_regAcceptedConduct)
            {
                _regError = L["TeacherConduct_MustAccept"];
                return;
            }

            if (string.IsNullOrWhiteSpace(_regCountry))
            {
                _regError = L["Expert_RegisterCountryRequired"];
                return;
            }

            object? initialOffering = null;
            if (_regCreateOffer)
            {
                if (string.IsNullOrWhiteSpace(_regOfferTitle))
                {
                    _regError = "Titre de l'offre obligatoire (ou décochez « Créer une offre »).";
                    return;
                }
                initialOffering = new
                {
                    title = _regOfferTitle.Trim(),
                    description = string.IsNullOrWhiteSpace(_regOfferDescription) ? null : _regOfferDescription,
                    subject = string.IsNullOrWhiteSpace(_regOfferSubject) ? null : _regOfferSubject,
                    price = _regOfferPrice,
                    currency = string.IsNullOrWhiteSpace(_regOfferCurrency) ? "CAD" : _regOfferCurrency,
                    durationDays = _regOfferPeriod switch
                    {
                        "semaine" => 7,
                        "mois" => 30,
                        "trimestre" => 90,
                        _ => _regOfferDurationDays > 0 ? _regOfferDurationDays : 30
                    },
                    sessionCount = _regOfferSessionCount > 0 ? _regOfferSessionCount : 4,
                    frequency = string.IsNullOrWhiteSpace(_regOfferFrequency) ? null : _regOfferFrequency,
                    mode = _regOfferMode,
                    maxCapacity = 20,
                    schedule = new
                    {
                        billingPeriod = _regOfferPeriod,
                        cadence = _regOfferCadence,
                        sessionDurationMin = _regOfferSessionDuration > 0 ? _regOfferSessionDuration : 60,
                        level = (string?)null,
                        cancellationPolicy = (string?)null,
                        slots = Array.Empty<object>(),
                        billingMode = _regOfferBillingMode
                    }
                };
            }

            var result = await Api.PostWithErrorAsync<RegisterTeacherResult>("api/expert/register-teacher", new
            {
                email = string.IsNullOrWhiteSpace(_regEmail) ? null : _regEmail.Trim(),
                firstName = _regFirstName,
                lastName = _regLastName,
                schoolName = _regSchoolName,
                slug = _regSlug.Trim().ToLowerInvariant(),
                city = string.IsNullOrWhiteSpace(_regCity) ? null : _regCity,
                visibleCountryCodes = _regVisibleCountries,
                acceptedTeacherConductPolicy = true,
                publishPublicProfile = _regPublishPublic,
                initialOffering
            });
            if (result.Error is not null)
            {
                _regError = result.Error;
                return;
            }

            var created = result.Value;
            _regSuccess = created is null
                ? L["Expert_RegisterTeacherSuccess"]
                : $"Compte créé. Login : {created.Email}"
                  + (string.IsNullOrWhiteSpace(created.TemporaryPassword) ? "" : $" · MDP temporaire : {created.TemporaryPassword}")
                  + (created.CredentialsSent ? " · identifiants envoyés par e-mail." : " · e-mail non envoyé (vérifier Mail Sender).")
                  + (created.OfferingId is not null ? " Offre créée." : "");

            if (created is { IsPublicProfile: true })
            {
                _regSuccess = $"{_regSuccess} {L["Expert_RegisterPublicPublished"]}"
                    + (string.IsNullOrWhiteSpace(created.PublicPath) ? "" : $" ({created.PublicPath})");
            }
            else if (_regPublishPublic && created is not null)
            {
                // Secours si l'API n'a pas encore le flag côté déploiement.
                var pub = await Api.PostWithErrorAsync<object>(
                    $"api/expert/teachers/{created.TenantId}/publish-profile", new { });
                if (pub.IsSuccess)
                    _regSuccess = $"{_regSuccess} {L["Expert_RegisterPublicPublished"]}";
                else if (!string.IsNullOrWhiteSpace(pub.Error))
                    _regSuccess = string.Format(L["Expert_RegisterPublicPublishFailed"], pub.Error);
            }

            var keptGroupName = _regSchoolName;
            var keptCountry = _regCountry;
            _regEmail = _regFirstName = _regLastName = _regCity = "";
            _regSlug = _regAutoSlugValue = "";
            _regSlugAvailable = null;
            _regAcceptedConduct = false;
            _regCreateOffer = false;
            _regPublishPublic = true;
            _regOfferTitle = "";
            _regOfferDescription = _regOfferSubject = _regOfferFrequency = null;
            _regOfferPrice = 0;
            _regOfferCurrency = "CAD";
            _regOfferDurationDays = 30;
            _regOfferSessionCount = 4;
            _regOfferPeriod = "mois";
            _regOfferCadence = "weekly";
            _regOfferBillingMode = "perSession";
            _regOfferSessionDuration = 60;
            _regOfferSessionCount = 4;
            _regOfferMode = "En ligne";
            _regSchoolName = keptGroupName;
            _regCountry = keptCountry;
            _regVisibleCountries = string.IsNullOrWhiteSpace(keptCountry) ? ["CM"] : [keptCountry];
            await LoadInvitesAsync();
        }
        catch (Exception ex)
        {
            _regError = ex.Message;
        }
        finally { _regBusy = false; }
    }

