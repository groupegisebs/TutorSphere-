    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        ApplyTabFromQuery();
        await Task.WhenAll(LoadQueueAsync(), LoadInvitesAsync(), LoadMyGroupAsync(), LoadAssignContextAsync());
    }

    private void ApplyTabFromQuery()
    {
        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("tab", out var tab))
                SetTab(tab.ToString());
        }
        catch { }
    }

    private void SetTab(string tab)
    {
        _activeTab = tab switch
        {
            "invite" => "invite",
            "queue" => "queue",
            _ => "register"
        };
    }

    private async Task LoadAssignContextAsync()
    {
        try
        {
            var ctx = await Api.GetAsync<MeCtx>("api/expert/me-context");
            _isManager = ctx?.IsGroupManager == true;
            _members = await Api.GetAsync<List<MemberItem>>("api/expert/membership/members") ?? [];
        }
        catch { }
    }

    private async Task OpenAssignAsync(QueueItem item)
    {
        _assignTarget = item;
        _assignUserId = item.ReviewAssignedToUserId ?? "";
        _assignUrgent = item.ReviewPriority > 0;
        if (_members.Count == 0)
            _members = await Api.GetAsync<List<MemberItem>>("api/expert/membership/members") ?? [];
    }

    private async Task AssignToMeAsync(Guid tenantId)
    {
        try
        {
            var result = await Api.PostWithErrorAsync<object>($"api/expert/teachers/{tenantId}/assign", new
            {
                assigneeUserId = (string?)null,
                urgent = false
            });
            if (result.Error is not null) { _error = result.Error; return; }
            await LoadQueueFilteredAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ConfirmAssignAsync()
    {
        if (_assignTarget is null || string.IsNullOrWhiteSpace(_assignUserId))
        {
            _error = "Choisissez un Expert.";
            return;
        }
        _assignBusy = true;
        try
        {
            var result = await Api.PostWithErrorAsync<object>(
                $"api/expert/teachers/{_assignTarget.TenantId}/assign",
                new { assigneeUserId = _assignUserId, urgent = _assignUrgent });
            if (result.Error is not null) { _error = result.Error; return; }
            _assignTarget = null;
            await LoadQueueFilteredAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _assignBusy = false; }
    }

    private async Task LoadMyGroupAsync()
    {
        try
        {
            var group = await Api.GetAsync<ExpertMyGroup>("api/expert/my-group");
            if (group is not null)
            {
                _regSchoolName = group.Name;
                if (!string.IsNullOrWhiteSpace(group.CountryCode))
                {
                    _regCountry = group.CountryCode.Trim().ToUpperInvariant();
                    _regVisibleCountries = [_regCountry];
                }
            }
        }
        catch { }
        finally { _regGroupLoading = false; }
    }

    private async Task LoadQueueAsync() => await LoadQueueFilteredAsync();

    private async Task LoadQueueFilteredAsync()
    {
        try
        {
            var parts = new List<string>();
            if (!string.IsNullOrWhiteSpace(_filterCountry)) parts.Add($"country={Uri.EscapeDataString(_filterCountry.Trim())}");
            if (!string.IsNullOrWhiteSpace(_filterCity)) parts.Add($"city={Uri.EscapeDataString(_filterCity.Trim())}");
            if (!string.IsNullOrWhiteSpace(_filterStatus) && int.TryParse(_filterStatus, out var st))
                parts.Add($"status={st}");
            if (_filterOlderDays is int d && d > 0) parts.Add($"olderThanDays={d}");
            if (_filterUrgent) parts.Add("urgentOnly=true");
            if (_filterIncomplete) parts.Add("incompleteOnly=true");
            var qs = parts.Count == 0 ? "" : "?" + string.Join("&", parts);
            _queue = await Api.GetAsync<List<QueueItem>>($"api/expert/approvals-queue{qs}") ?? [];
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private async Task StartReviewAsync(Guid tenantId)
    {
        try
        {
            var result = await Api.PostWithErrorAsync<object>($"api/expert/teachers/{tenantId}/start-review", new { });
            if (result.Error is not null) { _error = result.Error; return; }
            await LoadQueueFilteredAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static string StatusName(int status) => status switch
    {
        0 => "Pending",
        3 => "ChangesRequested",
        4 => "UnderReview",
        5 => "Assigned",
        6 => "Suspended",
        1 => "Approved",
        2 => "Rejected",
        _ => status.ToString()
    };

