@page "/expert/join"
@layout LoginLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@using TutorSphere.Application.Common
@using TutorSphere.Domain.Policies
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IConfiguration Config
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["ExpertJoin_Title"] — TutorSphere</PageTitle>

<div class="expert-join-page">
    <div class="expert-join-shell">
        <header class="expert-join-brand">
            <img src="images/tutorsphere-logo-full.png" alt="TutorSphere" class="expert-join-logo" />
            <span class="expert-join-badge">@L["ExpertJoin_Badge"]</span>
        </header>

        @if (!string.IsNullOrEmpty(_error) && _invite is null && !_done)
        {
            <div class="alert alert-danger">@_error</div>
            <a class="btn btn-outline-secondary" href="/">@L["ExpertJoin_Back"]</a>
        }
        else if (_done)
        {
            <div class="expert-join-done">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <h1>@L["ExpertJoin_Success"]</h1>
                <p>@L["ExpertJoin_SuccessWait"]</p>
                <a class="btn expert-join-submit" href="/login/expert">@L["ExpertJoin_GoLogin"]</a>
            </div>
        }
        else if (_loading)
        {
            <div class="text-center py-5"><span class="spinner-border text-primary"></span></div>
        }
        else if (_invite is not null)
        {
            <div class="expert-join-hero">
                <h1>@L["ExpertJoin_Title"]</h1>
                <p class="expert-join-lead">
                    @_invite.InviterName @L["ExpertJoin_InvitesYou"]
                    <strong>@GroupLabel</strong>.
                </p>
                <p class="expert-join-meta">
                    <span><i class="bi bi-envelope"></i> @_invite.Email</span>
                    <span><i class="bi bi-hourglass-split"></i> @L["ExpertJoin_Expires", _invite.InviteExpiresAtUtc.ToLocalTime().ToString("d")]</span>
                </p>
            </div>

            <div class="expert-join-grid">
                <div class="expert-join-main">
                    @if (!string.IsNullOrWhiteSpace(_invite.PersonalMessage))
                    {
                        <blockquote class="expert-join-message">
                            <p>@_invite.PersonalMessage</p>
                            <footer>— @_invite.InviterName</footer>
                        </blockquote>
                    }

                    <section class="expert-join-card">
                        <h2>@L["ExpertJoin_PlatformTitle"]</h2>
                        <p>@L["ExpertJoin_PlatformLead"]</p>
                        <ul class="expert-join-bullets">
                            <li>@L["ExpertJoin_PlatformBullet1"]</li>
                            <li>@L["ExpertJoin_PlatformBullet2"]</li>
                            <li>@L["ExpertJoin_PlatformBullet3"]</li>
                        </ul>
                    </section>

                    <section class="expert-join-card">
                        <h2>@L["ExpertJoin_GroupTitle"]</h2>
                        <div class="expert-join-profile">
                            @if (!string.IsNullOrWhiteSpace(LogoUrl))
                            {
                                <img src="@LogoUrl" alt="@_invite.GroupName" class="expert-join-group-logo" />
                            }
                            else
                            {
                                <div class="expert-join-group-fallback">@GroupInitial</div>
                            }
                            <div>
                                <h3>@_invite.GroupName</h3>
                                <p class="expert-join-chips">
                                    @if (_invite.GroupIsInternational)
                                    {
                                        <span>@L["ExpertJoin_International"]</span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(_invite.GroupCountryCode))
                                    {
                                        <span>@_invite.GroupCountryCode</span>
                                    }
                                    <span>@L["ExpertJoin_Members", _invite.GroupMemberCount]</span>
                                    <span>@L["ExpertJoin_Responsable"]: @_invite.InviterName</span>
                                </p>
                            </div>
                        </div>
                        <p>@(string.IsNullOrWhiteSpace(_invite.GroupDescription)
                            ? L["ExpertJoin_GroupDescriptionEmpty"].Value
                            : _invite.GroupDescription)</p>
                    </section>

                    <section class="expert-join-card">
                        <h2>@L["ExpertJoin_OffersTitle"]</h2>
                        @if (_invite.Offers is null || _invite.Offers.Count == 0)
                        {
                            <p class="text-muted mb-0">@L["ExpertJoin_OffersEmpty"]</p>
                        }
                        else
                        {
                            <div class="expert-join-offers">
                                @foreach (var offer in _invite.Offers)
                                {
                                    <article class="expert-join-offer">
                                        <h3>@offer.Name</h3>
                                        @if (!string.IsNullOrWhiteSpace(offer.ShortDescription))
                                        {
                                            <p>@offer.ShortDescription</p>
                                        }
                                        <p class="expert-join-offer-meta">
                                            @if (offer.RecommendedPrice is decimal price)
                                            {
                                                <strong>@price.ToString("N0") @GroupOfferCurrencyRules.FormatCurrencyLabel(offer.Currency)</strong>
                                            }
                                            @if (offer.IsInternational)
                                            {
                                                <span>@L["ExpertJoin_OfferInternational"]</span>
                                            }
                                        </p>
                                    </article>
                                }
                            </div>
                        }
                    </section>

                    <section class="expert-join-card expert-join-terms">
                        <h2>@L["ExpertJoin_ConditionsTitle"]</h2>
                        <p>@L["ExpertJoin_ConditionsIntro"]</p>

                        <h3>@L["ExpertJoin_AdmissionTitle"]</h3>
                        <p>@L["ExpertJoin_AdmissionIntro"]</p>
                        <ol>
                            <li>@L["ExpertJoin_Admission1"]</li>
                            <li>@L["ExpertJoin_Admission2"]</li>
                            <li>@L["ExpertJoin_Admission3"]</li>
                            <li>@L["ExpertJoin_Admission4"]</li>
                        </ol>

                        <h3>@L["ExpertConduct_Title"]</h3>
                        <p>@L["ExpertConduct_Intro"]</p>
                        <ul>
                            <li>@L["ExpertConduct_Bullet_Integrity"]</li>
                            <li>@L["ExpertConduct_Bullet_Confidentiality"]</li>
                            <li>@L["ExpertConduct_Bullet_Fairness"]</li>
                            <li>@L["ExpertConduct_Bullet_Quality"]</li>
                            <li>@L["ExpertConduct_Bullet_Vote"]</li>
                            <li>@L["ExpertConduct_Bullet_Law"]</li>
                        </ul>
                        <a href="@ExpertConductPolicy.PublicPath" target="_blank" rel="noopener">@L["ExpertJoin_ReadConduct"]</a>

                        <h3>@L["Privacy_Title"]</h3>
                        <p>@L["Privacy_Intro"]</p>
                        <ul>
                            <li>@L["Privacy_Bullet_Data"]</li>
                            <li>@L["Privacy_Bullet_Purpose"]</li>
                            <li>@L["Privacy_Bullet_Rights"]</li>
                        </ul>
                        <a href="@ExpertConductPolicy.PrivacyPath" target="_blank" rel="noopener">@L["ExpertJoin_ReadPrivacy"]</a>
                    </section>
                </div>

                <aside class="expert-join-aside">
                    <form class="expert-join-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                        <h2>@L["ExpertJoin_RegisterTitle"]</h2>
                        <p>@L["ExpertJoin_RegisterLead"]</p>

                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <div class="alert alert-danger">@_error</div>
                        }

                        <div class="mb-3">
                            <label class="form-label" for="ej-email">@L["Login_Email"]</label>
                            <input id="ej-email" class="form-control" value="@_invite.Email" disabled readonly />
                            <small class="text-muted">@L["ExpertJoin_EmailLocked"]</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="ej-fn">@L["Label_FirstName"]</label>
                            <input id="ej-fn" class="form-control" @bind="_firstName" autocomplete="given-name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="ej-ln">@L["Label_LastName"]</label>
                            <input id="ej-ln" class="form-control" @bind="_lastName" autocomplete="family-name" />
                        </div>
                        @if (_invite.RequiresAccountCreation)
                        {
                            <div class="mb-3">
                                <label class="form-label" for="ej-pwd">@L["ExpertJoin_Password"] *</label>
                                <input id="ej-pwd" class="form-control" type="password" @bind="_password" autocomplete="new-password" />
                                <small class="text-muted">@L["ExpertJoin_PasswordHint"]</small>
                            </div>
                        }
                        else
                        {
                            <p class="expert-join-existing">@L["ExpertJoin_ExistingAccount"]</p>
                        }
                        <div class="mb-3">
                            <label class="form-label" for="ej-spec">@L["ExpertJoin_Specialty"]</label>
                            <input id="ej-spec" class="form-control" @bind="_specialty" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="ej-bio">@L["ExpertJoin_Presentation"]</label>
                            <textarea id="ej-bio" class="form-control" rows="4" @bind="_presentation"></textarea>
                        </div>

                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="ej-adm" @bind="_admission" />
                            <label class="form-check-label" for="ej-adm">@L["ExpertJoin_AcceptAdmission"]</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="ej-cond" @bind="_conduct" />
                            <label class="form-check-label" for="ej-cond">@L["ExpertConduct_AcceptCheckbox"]</label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="ej-priv" @bind="_privacy" />
                            <label class="form-check-label" for="ej-priv">@L["Privacy_AcceptCheckbox"]</label>
                        </div>

                        <button type="submit" class="btn expert-join-submit w-100" disabled="@_busy">
                            @(_busy ? L["ExpertJoin_Submitting"] : L["ExpertJoin_Submit"])
                        </button>
                        <button type="button" class="btn btn-outline-secondary w-100 mt-2" disabled="@_busy" @onclick="DeclineAsync">
                            @L["ExpertJoin_Decline"]
                        </button>
                    </form>
                </aside>
            </div>
        }
    </div>
</div>

@code {
    private string? _token;
    private bool _loading = true;
    private bool _busy;
    private bool _done;
    private string? _error;
    private PublicInvite? _invite;

    private string _firstName = "";
    private string _lastName = "";
    private string _password = "";
    private string _specialty = "";
    private string _presentation = "";
    private bool _conduct;
    private bool _privacy;
    private bool _admission;

    private string GroupLabel => _invite is null
        ? ""
        : string.IsNullOrWhiteSpace(_invite.GroupCountryCode)
            ? _invite.GroupName
            : $"{_invite.GroupName} ({_invite.GroupCountryCode})";

    private string GroupInitial => string.IsNullOrWhiteSpace(_invite?.GroupName)
        ? "G"
        : _invite.GroupName.Trim()[..1].ToUpperInvariant();

    private string LogoUrl => _invite is null
        ? ""
        : MediaUrlHelper.Resolve(_invite.GroupLogoUrl, Config, Navigation);

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("invite", out var invite))
            _token = invite.ToString();

        if (string.IsNullOrWhiteSpace(_token))
        {
            _error = L["ExpertJoin_InvalidLink"];
            _loading = false;
            return;
        }

        try
        {
            var response = await Http.GetAsync($"api/expert/membership/public/{Uri.EscapeDataString(_token)}");
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _error = TryError(body) ?? L["ExpertJoin_NotFound"];
                return;
            }
            _invite = await response.Content.ReadFromJsonAsync<PublicInvite>();
            if (_invite is not null)
            {
                _firstName = _invite.FirstName;
                _lastName = _invite.LastName;
                _specialty = _invite.Specialty ?? "";
                _presentation = _invite.Presentation ?? "";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private async Task SubmitAsync()
    {
        if (_invite?.RequiresAccountCreation == true && string.IsNullOrWhiteSpace(_password))
        {
            _error = L["ExpertJoin_MustPassword"];
            return;
        }
        if (!_admission || !_conduct || !_privacy)
        {
            _error = L["ExpertJoin_MustAccept"];
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/expert/membership/public/submit", new
            {
                token = _token,
                password = string.IsNullOrWhiteSpace(_password) ? null : _password,
                firstName = _firstName,
                lastName = _lastName,
                specialty = string.IsNullOrWhiteSpace(_specialty) ? null : _specialty,
                presentation = string.IsNullOrWhiteSpace(_presentation) ? null : _presentation,
                acceptedConduct = _conduct,
                acceptedPrivacy = _privacy,
                acceptedAdmissionRules = _admission
            });
            if (!response.IsSuccessStatusCode)
            {
                _error = TryError(await response.Content.ReadAsStringAsync()) ?? L["ExpertJoin_SubmitFail"];
                return;
            }
            _done = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeclineAsync()
    {
        _busy = true;
        try
        {
            await Http.PostAsJsonAsync("api/expert/membership/public/decline", new { token = _token });
            Navigation.NavigateTo("/");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static string? TryError(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("error", out var e))
                return e.GetString();
        }
        catch { }
        return null;
    }

    private sealed class PublicInvite
    {
        public Guid Id { get; set; }
        public string GroupName { get; set; } = "";
        public string? GroupCountryCode { get; set; }
        public string InviterName { get; set; } = "";
        public string Email { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public int Status { get; set; }
        public DateTime InviteExpiresAtUtc { get; set; }
        public bool RequiresAccountCreation { get; set; }
        public string? PersonalMessage { get; set; }
        public string? GroupDescription { get; set; }
        public string? GroupLogoUrl { get; set; }
        public bool GroupIsInternational { get; set; }
        public int GroupMemberCount { get; set; }
        public List<PublicOffer> Offers { get; set; } = [];
        public string? Specialty { get; set; }
        public string? Presentation { get; set; }
    }

    private sealed class PublicOffer
    {
        public string Name { get; set; } = "";
        public string? ShortDescription { get; set; }
        public string Currency { get; set; } = "";
        public decimal? RecommendedPrice { get; set; }
        public bool IsInternational { get; set; }
        public string? MarketCountryCode { get; set; }
    }
}
