@page "/expert/admissions"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text
@inject AuthService Auth
@inject ApiClient Api
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<ApplyRequestCulture />

<PageTitle>Admissions des Experts — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar ex-toolbar">
            <div class="ex-page-head">
                <div>
                    <h1 class="cc-page-title">Admissions des experts</h1>
                    <p class="cc-page-sub">
                        Invitez et gérez les candidatures des experts souhaitant rejoindre votre groupe.
                    </p>
                </div>
            </div>
            @if (_canInvite)
            {
                @* Le formulaire est déjà sur la page : le bouton y conduit au lieu d'ouvrir un doublon. *@
                <button type="button" class="cc-btn cc-btn-primary" @onclick="FocusInviteAsync">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Inviter un expert
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mb-3">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_success))
        {
            <div class="alert alert-success mb-3">@_success</div>
        }

        @if (_loading)
        {
            <div class="cc-empty"><span class="spinner-border"></span></div>
        }
        else
        {
            @* Le chiffre avant son libellé : c'est lui qu'on vient lire. *@
            <div class="ex-kpi-grid ex-adm-kpis">
                <div class="ex-kpi" data-tone="sky">
                    <span class="ex-kpi-icon"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                    <div>
                        <div class="ex-kpi-value">@_receivedThisMonth</div>
                        <div class="ex-kpi-label">Candidatures reçues</div>
                        <div class="ex-kpi-hint">ce mois-ci</div>
                    </div>
                </div>
                <div class="ex-kpi" data-tone="amber">
                    <span class="ex-kpi-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
                    <div>
                        <div class="ex-kpi-value">@_pending.Count</div>
                        <div class="ex-kpi-label">En attente</div>
                        <div class="ex-kpi-hint">à examiner</div>
                    </div>
                </div>
                <div class="ex-kpi" data-tone="emerald">
                    <span class="ex-kpi-icon"><i class="bi bi-check-circle" aria-hidden="true"></i></span>
                    <div>
                        <div class="ex-kpi-value">@CountStatus(3)</div>
                        <div class="ex-kpi-label">Approuvés</div>
                        <div class="ex-kpi-hint">membres actifs</div>
                    </div>
                </div>
                <div class="ex-kpi" data-tone="rose">
                    <span class="ex-kpi-icon"><i class="bi bi-x-circle" aria-hidden="true"></i></span>
                    <div>
                        <div class="ex-kpi-value">@CountStatus(4)</div>
                        <div class="ex-kpi-label">Refusés</div>
                        <div class="ex-kpi-hint">ce cycle</div>
                    </div>
                </div>
            </div>

            <div class="ex-admissions-grid">
                @if (_canInvite)
                {
                    <div class="cc-card">
                        <h2 class="cc-card-title">Inviter un expert</h2>
                        <p class="small text-muted mb-3">
                            Invitez un membre du groupe d'experts. Pour ajouter un enseignant, utilisez le module « Enseignants ».
                        </p>

                        <p class="ex-adm-legend">Coordonnées</p>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label" for="adm-email">E-mail <span class="ex-req">*</span></label>
                                <input id="adm-email" class="form-control @(_missing.Contains("email") ? "is-invalid" : null)"
                                       type="email" @bind="_email" @bind:after='() => _missing.Remove("email")'
                                       @ref="_emailInput" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="adm-first">Prénom <span class="ex-req">*</span></label>
                                <input id="adm-first" class="form-control @(_missing.Contains("first") ? "is-invalid" : null)"
                                       @bind="_firstName" @bind:after='() => _missing.Remove("first")' />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="adm-last">Nom <span class="ex-req">*</span></label>
                                <input id="adm-last" class="form-control @(_missing.Contains("last") ? "is-invalid" : null)"
                                       @bind="_lastName" @bind:after='() => _missing.Remove("last")' />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="adm-phone">Téléphone</label>
                                <input id="adm-phone" class="form-control" @bind="_phone" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="adm-spec">Spécialité</label>
                                <input id="adm-spec" class="form-control" @bind="_specialty" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="adm-role">Fonction envisagée</label>
                                <select id="adm-role" class="form-select" @bind="_role">
                                    <option value="">— Choisir —</option>
                                    <option>Évaluateur</option>
                                    <option>Mentor pédagogique</option>
                                    <option>Coordinateur</option>
                                    <option>Expert matière</option>
                                    <option>Autre</option>
                                </select>
                            </div>
                        </div>

                        <p class="ex-adm-legend">Motif de l'invitation</p>
                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label" for="adm-just">Justification <span class="ex-req">*</span></label>
                                <textarea id="adm-just" rows="3"
                                          class="form-control @(_missing.Contains("just") ? "is-invalid" : null)"
                                          @bind="_justification" @bind:after='() => _missing.Remove("just")'
                                          placeholder="Expliquez pourquoi cette personne est invitée à rejoindre le groupe."></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="adm-msg">Message personnel</label>
                                <textarea id="adm-msg" class="form-control" rows="2" @bind="_message"
                                          placeholder="Ajoutez un message qui sera inclus dans l'e-mail d'invitation."></textarea>
                            </div>
                        </div>

                        <div class="ex-adm-form-foot">
                            @* Durée réelle du jeton d'invitation, définie côté service. *@
                            <span class="ex-adm-note">
                                <i class="bi bi-shield-lock" aria-hidden="true"></i>
                                Un lien sécurisé valable @InviteValidityDays jours sera envoyé.
                            </span>
                            <button type="button" class="cc-btn cc-btn-primary" disabled="@_busy" @onclick="InviteAsync">
                                <i class="bi bi-send" aria-hidden="true"></i> Envoyer l’invitation
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="cc-card">
                        <h2 class="cc-card-title">Votre rôle</h2>
                        <p class="mb-0">
                            Vous votez les candidatures de nouveaux <strong>membres Experts</strong>.
                            Seul le Responsable peut envoyer une invitation.
                            Pour un enseignant, utilisez « Ajouter un enseignant ».
                        </p>
                    </div>
                }

                <div class="ex-adm-side">
                <div class="cc-card">
                    <div class="ex-pending-title">
                        <h2 class="cc-card-title">À examiner</h2>
                        @if (_pending.Count > 0)
                        {
                            <button type="button" class="cc-btn btn-sm" @onclick='() => { _statusFilter = "pending"; _page = 1; }'>Voir toutes</button>
                        }
                    </div>
                    @if (_pending.Count == 0)
                    {
                        @* État vide chiffré : le zéro dit que la file est vide, non que la donnée manque. *@
                        <div class="ex-adm-empty">
                            <span class="ex-adm-empty-ic"><i class="bi bi-check-lg" aria-hidden="true"></i></span>
                            <strong class="ex-adm-empty-n">0</strong>
                            <span class="ex-adm-empty-t">Aucune candidature en attente</span>
                            <span class="ex-adm-empty-s">Toutes les candidatures ont été traitées.</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var inv in _pending)
                        {
                            <div class="ex-pending-card">
                                <div class="ex-pending-head">
                                    <span class="ex-avatar">@Initials(inv.FirstName, inv.LastName)</span>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <strong>@inv.FirstName @inv.LastName</strong>
                                            <button type="button" class="cc-btn btn-sm" @onclick="() => ToggleProfile(inv.Id)">Voir le profil</button>
                                        </div>
                                        <div class="small text-muted">@inv.Email</div>
                                        <div class="small">@(inv.Specialty ?? "—") · @(inv.IntendedRole ?? "—")</div>
                                        <div class="small text-muted">Reçu le @inv.SentAtUtc.ToLocalTime().ToString("dd MMM yyyy")</div>
                                        <span class="cc-pill @StatusPill(inv.Status)">@StatusLabel(inv.Status)</span>
                                    </div>
                                </div>
                                @if (_openProfileId == inv.Id)
                                {
                                    <p class="small mt-2 mb-1">@(string.IsNullOrWhiteSpace(inv.Presentation) ? "Aucun résumé de profil." : inv.Presentation)</p>
                                    @if (!string.IsNullOrWhiteSpace(inv.Justification))
                                    {
                                        <p class="small text-muted mb-1">@inv.Justification</p>
                                    }
                                }
                                <VoteProgress Approve="inv.ApprovalCount" Reject="inv.RejectCount"
                                              Abstain="inv.AbstainCount" Eligible="inv.EligibleVoterCount"
                                              Required="inv.RequiredApprovalCount" />
                                @if (inv.Status is 2 or 7)
                                {
                                    <div class="ex-pending-actions">
                                        <button type="button" class="cc-btn cc-btn-success btn-sm" disabled="@_busy"
                                                @onclick="() => VoteAsync(inv.Id, 0)">Approuver</button>
                                        <button type="button" class="cc-btn cc-btn-danger-text btn-sm" disabled="@_busy"
                                                @onclick="() => AskReject(inv)">Refuser</button>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="cc-card">
                    <h2 class="cc-card-title">Processus d'admission</h2>
                    <ol class="ex-adm-steps">
                        <li>
                            <span class="ex-adm-step-n">1</span>
                            <div>
                                <strong>Invitation envoyée</strong>
                                <span>L'invitation est envoyée à l'expert.</span>
                            </div>
                        </li>
                        <li>
                            <span class="ex-adm-step-n">2</span>
                            <div>
                                <strong>Candidature reçue</strong>
                                <span>L'expert soumet sa candidature.</span>
                            </div>
                        </li>
                        <li>
                            <span class="ex-adm-step-n">3</span>
                            <div>
                                <strong>Décision du groupe</strong>
                                <span>Le groupe approuve ou refuse la candidature.</span>
                            </div>
                        </li>
                    </ol>
                    <button type="button" class="ex-adm-rules" @onclick="() => _showGuide = !_showGuide">
                        @(_showGuide ? "Masquer les règles d'admission" : "Voir les règles d'admission")
                        <i class="bi @(_showGuide ? "bi-chevron-up" : "bi-chevron-right")" aria-hidden="true"></i>
                    </button>
                    @if (_showGuide)
                    {
                        <p class="small text-muted mb-0 mt-2">
                            Le vote des Experts du groupe décide de l'admission : il faut au moins 75&nbsp;% d'avis
                            favorables parmi les votants éligibles. Le vote reste ouvert 15 jours. Sans votant
                            éligible, la décision revient à l'administration de la plateforme. Ce parcours ne
                            concerne que les membres Experts : un <em>enseignant</em> se crée depuis le module
                            « Enseignants ».
                        </p>
                    }
                </div>
                </div>
            </div>

            <div class="cc-card ex-adm-history">
                <div class="ex-adm-history-head">
                    <div>
                        <h2 class="cc-card-title mb-0">Historique des candidatures</h2>
                        <p class="cc-page-sub mb-0">Consultez les invitations et candidatures déjà traitées.</p>
                    </div>
                    <div class="ex-adm-tools">
                        <div class="ex-filter-search">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input class="form-control" placeholder="Rechercher un candidat…"
                                   @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />
                        </div>
                        <select class="form-select" @bind="_statusFilter" @bind:after="ResetPage">
                            <option value="">Tous les statuts</option>
                            <option value="pending">En attente</option>
                            <option value="3">Approuvées</option>
                            <option value="4">Refusées</option>
                            <option value="6">Annulées</option>
                            <option value="5">Expirées</option>
                        </select>
                        <button type="button" class="ex-adm-icon @(_showDates ? "is-on" : null)"
                                title="Filtrer par période" @onclick="() => _showDates = !_showDates">
                            <i class="bi bi-calendar-event" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="ex-adm-icon" title="Exporter en CSV"
                                disabled="@(_filtered.Count == 0)" @onclick="ExportCsvAsync">
                            <i class="bi bi-download" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                @if (_showDates)
                {
                    <div class="ex-adm-dates">
                        <label>Du <input type="date" class="form-control" @bind="_from" @bind:after="ResetPage" /></label>
                        <label>Au <input type="date" class="form-control" @bind="_to" @bind:after="ResetPage" /></label>
                        @if (_from is not null || _to is not null)
                        {
                            <button type="button" class="cc-btn btn-sm" @onclick="ClearDates">Effacer</button>
                        }
                    </div>
                }

                @* Les mêmes filtres que la liste déroulante, avec le nombre de dossiers de chaque
                   statut : on voit d'un coup où sont les candidatures. *@
                <div class="ex-adm-chips" role="group" aria-label="Filtrer par statut">
                    <button type="button" class="ex-adm-chip @(_statusFilter == "" ? "is-on" : null)"
                            @onclick='() => SetStatus("")'>Tous <span>@_invites.Count</span></button>
                    <button type="button" class="ex-adm-chip @(_statusFilter == "pending" ? "is-on" : null)"
                            @onclick='() => SetStatus("pending")'>En attente <span>@_pending.Count</span></button>
                    <button type="button" class="ex-adm-chip @(_statusFilter == "3" ? "is-on" : null)"
                            @onclick='() => SetStatus("3")'>Approuvées <span>@CountStatus(3)</span></button>
                    <button type="button" class="ex-adm-chip @(_statusFilter == "4" ? "is-on" : null)"
                            @onclick='() => SetStatus("4")'>Refusées <span>@CountStatus(4)</span></button>
                    <button type="button" class="ex-adm-chip @(_statusFilter == "6" ? "is-on" : null)"
                            @onclick='() => SetStatus("6")'>Annulées <span>@CountStatus(6)</span></button>
                </div>

                @if (_filtered.Count == 0)
                {
                    <p class="text-muted mb-0 p-3">Aucune candidature pour ces filtres.</p>
                }
                else
                {
                    <div class="cc-table-wrap">
                        <table class="cc-table">
                            <thead>
                                <tr>
                                    <th>Candidat</th>
                                    <th>Spécialité</th>
                                    <th>Fonction envisagée</th>
                                    <th>Date</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inv in Paged)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="ex-avatar">@Initials(inv.FirstName, inv.LastName)</span>
                                                <div>
                                                    <strong>@inv.FirstName @inv.LastName</strong>
                                                    <div class="small text-muted">@inv.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@(inv.Specialty ?? "—")</td>
                                        <td>@(inv.IntendedRole ?? "—")</td>
                                        <td class="text-nowrap">@inv.SentAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                                        <td><span class="cc-pill @StatusPill(inv.Status)">@StatusLabel(inv.Status)</span></td>
                                        <td class="text-end">
                                            <div class="ex-row-actions">
                                                <button type="button" class="ex-adm-see" @onclick="() => ToggleProfile(inv.Id)">Voir</button>
                                                <div class="ex-more">
                                                    <button type="button" class="ex-more-btn" aria-label="Plus d'actions"
                                                            @onclick="() => ToggleMenu(inv.Id)" @onclick:stopPropagation="true">
                                                        <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                    @if (_menuId == inv.Id)
                                                    {
                                                        <div class="ex-more-menu">
                                                            <button type="button" @onclick="() => ToggleProfile(inv.Id)">Voir le profil</button>
                                                            @if (inv.Status is 2 or 7)
                                                            {
                                                                <button type="button" @onclick="() => VoteAsync(inv.Id, 0)">Approuver</button>
                                                                <button type="button" class="text-danger" @onclick="() => AskReject(inv)">Refuser</button>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    @if (_openProfileId == inv.Id)
                                    {
                                        @* « Voir » ouvrait le détail sans que rien ne s'affiche dans le tableau. *@
                                        <tr class="ex-adm-detail">
                                            <td colspan="6">
                                                <div class="ex-adm-detail-grid">
                                                    <div>
                                                        <span class="ex-adm-detail-lbl">Présentation</span>
                                                        <p class="mb-0">@(string.IsNullOrWhiteSpace(inv.Presentation) ? "Aucun résumé de profil." : inv.Presentation)</p>
                                                    </div>
                                                    <div>
                                                        <span class="ex-adm-detail-lbl">Justification de l'invitation</span>
                                                        <p class="mb-0">@(string.IsNullOrWhiteSpace(inv.Justification) ? "—" : inv.Justification)</p>
                                                    </div>
                                                    <div>
                                                        <span class="ex-adm-detail-lbl">Invité par</span>
                                                        <p class="mb-0">@(string.IsNullOrWhiteSpace(inv.InvitedByName) ? "—" : inv.InvitedByName)</p>
                                                    </div>
                                                    <div>
                                                        <span class="ex-adm-detail-lbl">Téléphone</span>
                                                        <p class="mb-0">@(string.IsNullOrWhiteSpace(inv.Phone) ? "—" : inv.Phone)</p>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <div class="ex-table-foot">
                            <span>@_filtered.Count candidature@(_filtered.Count > 1 ? "s" : "")</span>
                            <div class="ex-table-pager">
                                <select class="form-select form-select-sm" @bind="_pageSize" @bind:after="OnPageSizeChanged">
                                    <option value="10">10 par page</option>
                                    <option value="20">20 par page</option>
                                </select>
                                <button type="button" class="cc-btn btn-sm" disabled="@(_page <= 1)" @onclick="FirstPage">«</button>
                                <button type="button" class="cc-btn btn-sm" disabled="@(_page <= 1)" @onclick="PrevPage">‹</button>
                                @for (var i = 1; i <= PageCount; i++)
                                {
                                    var p = i;
                                    <button type="button" class="ex-page-n @(_page == p ? "is-on" : null)" @onclick="() => GoPage(p)">@p</button>
                                }
                                <button type="button" class="cc-btn btn-sm" disabled="@(_page >= PageCount)" @onclick="NextPage">›</button>
                                <button type="button" class="cc-btn btn-sm" disabled="@(_page >= PageCount)" @onclick="LastPage">»</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (_rejectTarget is not null)
        {
            <div class="cc-card mt-3">
                <h2 class="cc-card-title">Refuser @_rejectTarget.FirstName @_rejectTarget.LastName ?</h2>
                <p class="small text-muted">Cette action est enregistrée. Le candidat sera informé selon les règles du groupe.</p>
                <div class="d-flex gap-2">
                    <button type="button" class="cc-btn" @onclick="() => _rejectTarget = null">Annuler</button>
                    <button type="button" class="cc-btn cc-btn-primary" disabled="@_busy"
                            @onclick="ConfirmRejectAsync">Confirmer le refus</button>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="cc-card cc-empty">
            <p>@L["Expert_LoginRequired"]</p>
            <a class="cc-btn cc-btn-primary" href="/login/expert">@L["Nav_Login"]</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<InviteItem> _invites = [];
    private bool _loading = true;
    private bool _busy;
    private bool _canInvite;
    private string? _error;
    private string? _success;

    private string _email = "";
    private string _firstName = "";
    private string _lastName = "";
    private string _phone = "";
    private string _specialty = "";
    private string _role = "";
    private string _justification = "";
    private string _message = "";
    private string _search = "";
    private string _statusFilter = "";
    private InviteItem? _rejectTarget;
    private bool _showGuide;
    private bool _showDates;
    private DateTime? _from;
    private DateTime? _to;
    private int _page = 1;
    private int _pageSize = 10;
    private Guid? _menuId;
    private Guid? _openProfileId;
    private readonly HashSet<string> _missing = new(StringComparer.Ordinal);
    private ElementReference _emailInput;

    /// <summary>Doit suivre <c>ExpertMembershipGovernanceService.InviteDays</c>.</summary>
    private const int InviteValidityDays = 30;

    private List<InviteItem> _pending =>
        _invites.Where(i => i.Status is 0 or 1 or 2 or 7).ToList();

    private int CountStatus(int status) => _invites.Count(i => i.Status == status);

    private int _receivedThisMonth
    {
        get
        {
            var start = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1, 0, 0, 0, DateTimeKind.Utc);
            return _invites.Count(i => i.SentAtUtc >= start);
        }
    }

    private List<InviteItem> _filtered
    {
        get
        {
            IEnumerable<InviteItem> q = _invites;
            if (_statusFilter == "pending")
                q = q.Where(i => i.Status is 0 or 1 or 2 or 7);
            else if (int.TryParse(_statusFilter, out var st))
                q = q.Where(i => i.Status == st);

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(i =>
                    ($"{i.FirstName} {i.LastName}").Contains(s, StringComparison.OrdinalIgnoreCase)
                    || (i.Email?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (i.Specialty?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            // Les bornes sont saisies en heure locale : la comparaison se fait sur la date affichée.
            if (_from is DateTime from)
                q = q.Where(i => i.SentAtUtc.ToLocalTime().Date >= from.Date);
            if (_to is DateTime to)
                q = q.Where(i => i.SentAtUtc.ToLocalTime().Date <= to.Date);

            return q.OrderByDescending(i => i.SentAtUtc).ToList();
        }
    }

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));
    private int FromRow => _filtered.Count == 0 ? 0 : ((_page - 1) * _pageSize) + 1;
    private int ToRow => Math.Min(_filtered.Count, _page * _pageSize);
    private IEnumerable<InviteItem> Paged
    {
        get
        {
            if (_page > PageCount) _page = PageCount;
            return _filtered.Skip((_page - 1) * _pageSize).Take(_pageSize);
        }
    }

    private void OnPageSizeChanged() => _page = 1;
    private void FirstPage() => _page = 1;
    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < PageCount) _page++; }
    private void LastPage() => _page = PageCount;
    private void GoPage(int p) => _page = p;
    private void ToggleMenu(Guid id) => _menuId = _menuId == id ? null : id;
    private void ToggleProfile(Guid id)
    {
        _openProfileId = _openProfileId == id ? null : id;
        _menuId = null;
    }
    private void ResetPage() => _page = 1;
    private void SetStatus(string status)
    {
        _statusFilter = status;
        _page = 1;
    }
    private void ClearDates()
    {
        _from = _to = null;
        _page = 1;
    }

    /// <summary>Le formulaire est déjà affiché : on y amène le curseur plutôt que d'ouvrir un doublon.</summary>
    private async Task FocusInviteAsync()
    {
        try { await _emailInput.FocusAsync(); } catch { }
    }

    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine("Candidat;Email;Specialite;Fonction envisagee;Date;Statut");
        foreach (var i in _filtered)
        {
            sb.AppendLine(string.Join(';',
                Csv($"{i.FirstName} {i.LastName}"),
                Csv(i.Email),
                Csv(i.Specialty),
                Csv(i.IntendedRole),
                i.SentAtUtc.ToLocalTime().ToString("yyyy-MM-dd"),
                Csv(StatusLabel(i.Status))));
        }
        var bytes = Encoding.UTF8.GetPreamble()
            .Concat(Encoding.UTF8.GetBytes(sb.ToString()))
            .ToArray();
        await JS.InvokeVoidAsync("downloadFileFromBase64",
            "candidatures-experts.csv", "text/csv;charset=utf-8", Convert.ToBase64String(bytes));
    }

    private static string Csv(string? value)
    {
        var v = value ?? "";
        return v.Contains(';') || v.Contains('"') || v.Contains('\n')
            ? "\"" + v.Replace("\"", "\"\"") + "\""
            : v;
    }

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        try { await Auth.RestoreActAsGroupAsync(); } catch { }
        try
        {
            var ctx = await Api.GetAsync<MeContext>("api/expert/me-context");
            _canInvite = ctx?.IsGroupManager == true
                         || Auth.IsInRole("GroupManager")
                         || Auth.IsActingAsGroupAdmin;
        }
        catch { _canInvite = Auth.IsInRole("GroupManager") || Auth.IsActingAsGroupAdmin; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _invites = await Api.GetAsync<List<InviteItem>>("api/expert/membership/invites") ?? [];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private async Task InviteAsync()
    {
        if (!_canInvite)
        {
            _error = "Seul le Responsable du groupe peut inviter un membre Expert.";
            return;
        }

        _busy = true;
        _error = _success = null;
        try
        {
            // Un envoi refusé sans indication laissait chercher le champ manquant.
            _missing.Clear();
            if (string.IsNullOrWhiteSpace(_email)) _missing.Add("email");
            if (string.IsNullOrWhiteSpace(_firstName)) _missing.Add("first");
            if (string.IsNullOrWhiteSpace(_lastName)) _missing.Add("last");
            if (string.IsNullOrWhiteSpace(_justification)) _missing.Add("just");
            if (_missing.Count > 0)
            {
                _error = "Complétez les champs obligatoires signalés en rouge.";
                return;
            }
            if (!IsEmail(_email))
            {
                _missing.Add("email");
                _error = "Cette adresse e-mail n'est pas valide.";
                return;
            }
            var result = await Api.PostWithErrorAsync<InviteItem>("api/expert/membership/invites", new
            {
                email = _email,
                firstName = _firstName,
                lastName = _lastName,
                phone = string.IsNullOrWhiteSpace(_phone) ? null : _phone,
                specialty = string.IsNullOrWhiteSpace(_specialty) ? null : _specialty,
                intendedRole = string.IsNullOrWhiteSpace(_role) ? null : _role,
                justification = _justification,
                personalMessage = string.IsNullOrWhiteSpace(_message) ? null : _message
            });
            if (result.Error is not null) { _error = result.Error; return; }
            _success = "Invitation envoyée avec succès.";
            _missing.Clear();
            _email = _firstName = _lastName = _phone = _specialty = _role = _justification = _message = "";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task VoteAsync(Guid id, int choice)
    {
        _busy = true;
        _error = _success = null;
        try
        {
            var result = await Api.PostWithErrorAsync<InviteItem>($"api/expert/membership/invites/{id}/vote", new { choice });
            if (result.Error is not null) { _error = result.Error; return; }
            _success = "Vote enregistré.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private void AskReject(InviteItem inv) => _rejectTarget = inv;

    private async Task ConfirmRejectAsync()
    {
        if (_rejectTarget is null) return;
        var id = _rejectTarget.Id;
        _rejectTarget = null;
        await VoteAsync(id, 1);
        if (string.IsNullOrEmpty(_error))
            _success = "Candidature refusée.";
    }

    private static bool IsEmail(string value)
    {
        var v = value.Trim();
        var at = v.IndexOf('@');
        return at > 0 && v.IndexOf('.', at) > at + 1 && !v.EndsWith('.') && !v.Contains(' ');
    }

    private static string Initials(string? first, string? last)
    {
        var a = string.IsNullOrWhiteSpace(first) ? "" : first.Trim()[0].ToString().ToUpperInvariant();
        var b = string.IsNullOrWhiteSpace(last) ? "" : last.Trim()[0].ToString().ToUpperInvariant();
        var s = a + b;
        return string.IsNullOrEmpty(s) ? "?" : s;
    }

    private static string StatusLabel(int status) => status switch
    {
        0 => "Envoyée",
        1 => "Acceptée par le candidat",
        2 => "En vote",
        3 => "Approuvée",
        4 => "Rejetée",
        5 => "Expirée",
        6 => "Annulée",
        7 => "Validation admin",
        _ => status.ToString()
    };

    private static string StatusPill(int status) => status switch
    {
        3 => "cc-pill-ok",
        4 or 6 => "cc-pill-bad",
        5 => "cc-pill-bad",
        _ => "cc-pill-type"
    };

    private sealed record MeContext(bool IsGroupManager, Guid? GroupId, string? GroupName, bool IsPlatformActAs = false);

    private sealed record InviteItem(
        Guid Id,
        Guid ExpertGroupId,
        string GroupName,
        string Email,
        string FirstName,
        string LastName,
        string? Phone,
        string? Specialty,
        string? IntendedRole,
        string? Presentation,
        string? Justification,
        string InvitedByUserId,
        string? InvitedByName,
        int Status,
        DateTime SentAtUtc,
        DateTime InviteExpiresAtUtc,
        DateTime? VoteOpenedAtUtc,
        DateTime? VoteExpiresAtUtc,
        int EligibleVoterCount,
        int RequiredApprovalCount,
        int ApprovalCount,
        int RejectCount,
        int AbstainCount,
        int? MyVote,
        object? Votes,
        string? CandidateUserId,
        DateTime? DecisionAtUtc,
        string? AdminNotes);
}
