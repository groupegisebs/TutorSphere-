@page "/expert/teachers"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject AuthService Auth
@inject ApiClient Api
@inject IStringLocalizer<SharedResources> L
@inject IConfiguration Config
@inject NavigationManager Navigation

<ApplyRequestCulture />

<PageTitle>@L["ExpertTeachers_Title"] — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">@L["ExpertTeachers_Title"]</h1>
                <p class="cc-page-sub">@L["ExpertTeachers_Subtitle"]</p>
            </div>
            <a class="cc-btn cc-btn-primary" href="expert/teachers/add">
                <i class="bi bi-person-plus" aria-hidden="true"></i> Ajouter un enseignant
            </a>
        </div>

        @if (_loading)
        {
            <div class="cc-empty"><span class="spinner-border"></span></div>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        else if (_teachers.Count == 0)
        {
            <div class="cc-card cc-empty">
                <i class="bi bi-mortarboard"></i>
                <p>@L["ExpertTeachers_Empty"]</p>
                <a class="cc-btn cc-btn-primary" href="expert/teachers/add">Ajouter un enseignant</a>
            </div>
        }
        else
        {
            <div class="cc-card mb-3">
                <table class="cc-table">
                    <thead>
                        <tr>
                            <th>@L["Expert_ColSchool"]</th>
                            <th>@L["Expert_ColCountry"]</th>
                            <th>@L["ExpertTeachers_ColLessons"]</th>
                            <th>@L["ExpertTeachers_ColCancelled"]</th>
                            <th>@L["ExpertTeachers_ColNoShow"]</th>
                            <th>@L["ExpertTeachers_ColLastActivity"]</th>
                            <th>@L["ExpertTeachers_ColRemarks"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _teachers)
                        {
                            <tr class="@(_selectedTenantId == t.TenantId ? "table-active" : "")">
                                <td>
                                    <strong>@t.SchoolName</strong>
                                    <div class="small text-muted">@(t.OwnerName ?? t.OwnerEmail)</div>
                                </td>
                                <td>@JoinMeta(t.City, t.Country)</td>
                                <td>@t.TotalLessons</td>
                                <td>@t.CancelledLessons</td>
                                <td>
                                    @if (t.NoShowIncidents > 0)
                                    {
                                        <span class="cc-pill cc-pill-bad">@t.NoShowIncidents</span>
                                    }
                                    else
                                    {
                                        <span>0</span>
                                    }
                                </td>
                                <td>@(t.LastActivityAt is { } la ? la.ToLocalTime().ToString("dd MMM yyyy") : "—")</td>
                                <td>@t.RemarkCount</td>
                                <td class="text-end">
                                    <button type="button" class="cc-btn btn-sm" @onclick="() => SelectTeacherAsync(t.TenantId)">
                                        @L["ExpertTeachers_Manage"]
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_selectedTenantId is Guid selected)
            {
                var selectedTeacher = _teachers.FirstOrDefault(x => x.TenantId == selected);
                <div class="cc-card mb-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <h2 class="cc-card-title mb-0">@(selectedTeacher?.SchoolName ?? "—")</h2>
                        <button type="button" class="cc-btn btn-sm" @onclick="CloseDetail">
                            <i class="bi bi-x-lg"></i> @L["ExpertTeachers_Close"]
                        </button>
                    </div>

                    @if (_detailLoading)
                    {
                        <div class="cc-empty py-3"><span class="spinner-border spinner-border-sm"></span></div>
                    }
                    else
                    {
                        <div class="row g-3 mt-2">
                            <div class="col-12">
                                <div class="cc-card border mb-0">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                        <h3 class="h6 mb-0">Fiche enseignant / publique</h3>
                                        @if (_school is not null)
                                        {
                                            <span class="cc-pill @(_school.IsPublicProfile ? "cc-pill-ok" : "cc-pill-type")">
                                                @(_school.IsPublicProfile ? "Publiée" : "Non publiée")
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(_schoolError))
                                    {
                                        <div class="alert alert-danger py-2">@_schoolError</div>
                                    }
                                    @if (!string.IsNullOrEmpty(_schoolSuccess))
                                    {
                                        <div class="alert alert-success py-2">@_schoolSuccess</div>
                                    }
                                    @if (_school is not null)
                                    {
                                        <div class="row g-2">
                                            <div class="col-md-3">
                                                <label class="form-label small">Photo</label>
                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    @if (!string.IsNullOrWhiteSpace(_photoUrl))
                                                    {
                                                        <img src="@MediaUrlHelper.Resolve(_photoUrl, Config, Navigation)"
                                                             alt="Photo" class="rounded"
                                                             style="width:64px;height:64px;object-fit:cover;border:1px solid #ddd;" />
                                                    }
                                                    <InputFile OnChange="OnPhotoSelected" accept="image/*" class="form-control form-control-sm" />
                                                </div>
                                                @if (_photoBusy)
                                                {
                                                    <div class="small text-muted mt-1">Envoi…</div>
                                                }
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small">Prénom</label>
                                                <input class="form-control" @bind="_sFirstName" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small">Nom</label>
                                                <input class="form-control" @bind="_sLastName" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small">Téléphone</label>
                                                <input class="form-control" @bind="_sPhone" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small">Nom affiché (profil)</label>
                                                <input class="form-control" @bind="_sSchoolName" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small">Ville</label>
                                                <input class="form-control" @bind="_sCity" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small">Pays</label>
                                                <input class="form-control" @bind="_sCountry" maxlength="2" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small">Langue</label>
                                                <input class="form-control" @bind="_sLanguage" />
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label small">Devise</label>
                                                <select class="form-select" @bind="_sCurrency">
                                                    <option value="CAD">CAD</option>
                                                    <option value="USD">USD</option>
                                                    <option value="EUR">EUR</option>
                                                    <option value="XAF">XAF</option>
                                                    <option value="XOF">XOF</option>
                                                </select>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small">Présentation publique</label>
                                                <textarea class="form-control" rows="3" @bind="_sPresentation"
                                                          placeholder="Texte visible sur /profil/…"></textarea>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small">Description courte</label>
                                                <textarea class="form-control" rows="2" @bind="_sDescription"></textarea>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label small">Disciplines du groupe</label>
                                                @if (_disciplines.Count == 0)
                                                {
                                                    <p class="small text-muted mb-0">Aucune discipline définie. Créez-en dans <a href="expert/disciplines">Disciplines</a>.</p>
                                                }
                                                else
                                                {
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach (var d in _disciplines.Where(x => x.IsActive || x.IsAssigned))
                                                        {
                                                            <label class="border rounded px-2 py-1 small mb-0 @(d.IsAssigned ? "bg-light" : "")">
                                                                <input type="checkbox" class="form-check-input me-1"
                                                                       checked="@d.IsAssigned"
                                                                       disabled="@_discBusy"
                                                                       @onchange="e => ToggleDisciplineAsync(d, e)" />
                                                                @d.Name <span class="text-muted">(@CycleLabel(d.Cycle))</span>
                                                            </label>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label small">Agenda / disponibilités (fiche publique)</label>
                                                <p class="small text-muted mb-2">Cliquez pour activer les créneaux hebdomadaires visibles aux parents.</p>
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var day in AvailabilityDays)
                                                    {
                                                        @foreach (var slot in AvailabilitySlots)
                                                        {
                                                            var key = $"{day}-{slot}";
                                                            var on = _availability.Contains(key);
                                                            <button type="button" class="btn btn-sm @(on ? "btn-primary" : "btn-outline-secondary")"
                                                                    @onclick="() => ToggleAvailability(key)">
                                                                @day @slot
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="mt-2 d-flex gap-2 flex-wrap">
                                            <button type="button" class="cc-btn cc-btn-primary btn-sm" disabled="@_schoolBusy" @onclick="SaveSchoolAsync">
                                                @(_school.IsPublicProfile ? "Enregistrer les modifications" : "Enregistrer la fiche")
                                            </button>
                                            @if (!_school.IsPublicProfile)
                                            {
                                                <button type="button" class="cc-btn btn-sm" disabled="@_schoolBusy" @onclick="PublishSchoolAsync">
                                                    <i class="bi bi-globe2"></i> Créer fiche publique
                                                </button>
                                            }
                                            else
                                            {
                                                <a class="cc-btn btn-sm" href="@($"/profil/{_school.Slug}")" target="_blank" rel="noopener">
                                                    Voir fiche publique
                                                </a>
                                                <button type="button" class="cc-btn btn-sm" disabled="@_schoolBusy" @onclick="UnpublishSchoolAsync">
                                                    <i class="bi bi-eye-slash"></i> Dépublier
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <h3 class="h6">@L["ExpertTeachers_MaterialsTitle"]</h3>
                                @if (_materials.Count == 0)
                                {
                                    <p class="text-muted small">@L["ExpertTeachers_MaterialsEmpty"]</p>
                                }
                                else
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var m in _materials)
                                        {
                                            <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                                <div>
                                                    <span class="cc-pill cc-pill-type">@MaterialKindLabel(m.Kind)</span>
                                                    <strong class="ms-2">@m.Title</strong>
                                                    @if (m.RemarkCount > 0)
                                                    {
                                                        <span class="small text-muted ms-2">(@m.RemarkCount)</span>
                                                    }
                                                </div>
                                                <div class="d-flex gap-2">
                                                    @if (!string.IsNullOrWhiteSpace(m.FileUrl))
                                                    {
                                                        <a class="cc-btn btn-sm" href="@m.FileUrl" target="_blank" rel="noopener">@L["Common_Open"]</a>
                                                    }
                                                    <button type="button" class="cc-btn btn-sm cc-btn-primary" @onclick="() => PrepareRemarkFor(m)">
                                                        @L["ExpertTeachers_AddRemarkTitle"]
                                                    </button>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }

                                <h3 class="h6 mt-4">Offres de service</h3>
                                @if (_offerings.Count == 0)
                                {
                                    <p class="text-muted small">Aucune offre pour cet enseignant.</p>
                                }
                                else
                                {
                                    <ul class="list-unstyled mb-3">
                                        @foreach (var o in _offerings)
                                        {
                                            <li class="py-2 border-bottom">
                                                <strong>@o.Title</strong>
                                                <span class="small text-muted ms-2">@o.Price.ToString("N0") @o.Currency</span>
                                                @if (!string.IsNullOrWhiteSpace(o.Subject))
                                                {
                                                    <div class="small text-muted">@o.Subject · @o.Mode</div>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }

                                <div class="border rounded p-3 mb-3 ex-offer-panel">
                                    <h4 class="h6">@L["Expert_CreateOfferLabel"]</h4>
                                    <p class="small text-muted mb-2">@L["Expert_OfferBillingHint"]</p>
                                    @if (!string.IsNullOrEmpty(_offerError))
                                    {
                                        <div class="alert alert-danger py-2">@_offerError</div>
                                    }
                                    @if (!string.IsNullOrEmpty(_offerSuccess))
                                    {
                                        <div class="alert alert-success py-2">@_offerSuccess</div>
                                    }
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">@L["Expert_OfferTitle"] <span class="text-danger">*</span></label>
                                            <input class="form-control" @bind="_offerTitle" placeholder="Ex. Français — soutien scolaire" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">@L["Common_Subject"]</label>
                                            <input class="form-control" @bind="_offerSubject" />
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">@L["Offers_Mode"]</label>
                                            <select class="form-select" @bind="_offerMode">
                                                <option value="En ligne">@L["Offers_Online"]</option>
                                                <option value="Présentiel">@L["Offers_InPerson"]</option>
                                                <option value="Hybride">@L["Offers_Hybrid"]</option>
                                            </select>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">@L["Expert_OfferBillingMode"] <span class="text-danger">*</span></label>
                                            <div class="ex-billing-toggle" role="group">
                                                <button type="button"
                                                        class="ex-billing-option @(_offerBillingMode == "hourly" ? "active" : null)"
                                                        @onclick='() => SetTeacherOfferBilling("hourly")'>
                                                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                                                    <strong>@L["Billing_Hourly"]</strong>
                                                    <span>/ @L["CreateOffer_PerHour"]</span>
                                                </button>
                                                <button type="button"
                                                        class="ex-billing-option @(_offerBillingMode == "monthly" ? "active" : null)"
                                                        @onclick='() => SetTeacherOfferBilling("monthly")'>
                                                    <i class="bi bi-calendar-month" aria-hidden="true"></i>
                                                    <strong>@L["Billing_Monthly"]</strong>
                                                    <span>/ @L["CreateOffer_PerMonth"]</span>
                                                </button>
                                            </div>
                                        </div>

                                        @if (_offerBillingMode == "hourly")
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label">@L["Expert_OfferHourlyRate"] <span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <input type="number" min="0" step="0.01" class="form-control" @bind="_offerPrice" />
                                                    <span class="input-group-text">@_offerCurrency / h</span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label">@L["Expert_OfferMonthlyRate"] <span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <input type="number" min="0" step="0.01" class="form-control" @bind="_offerPrice" />
                                                    <span class="input-group-text">@_offerCurrency / mois</span>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">@L["Expert_OfferHoursPerWeek"] <span class="text-danger">*</span></label>
                                                <input type="number" min="0.5" step="0.5" class="form-control" @bind="_offerHoursPerWeek" />
                                                <div class="form-text">@L["Expert_OfferHoursPerWeekHint"]</div>
                                            </div>
                                        }

                                        <div class="col-md-4">
                                            <label class="form-label">@L["Expert_OfferSessionDuration"]</label>
                                            <select class="form-select" @bind="_offerSessionDuration">
                                                <option value="30">30</option>
                                                <option value="45">45</option>
                                                <option value="60">60</option>
                                                <option value="90">90</option>
                                                <option value="120">120</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">@L["Common_Currency"]</label>
                                            <select class="form-select" @bind="_offerCurrency">
                                                <option>CAD</option><option>USD</option><option>EUR</option><option>XAF</option><option>XOF</option>
                                            </select>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">@L["Expert_OfferSlotsTitle"] <span class="text-danger">*</span></label>
                                            <p class="small text-muted mb-2">@L["Expert_OfferSlotsHint"]</p>
                                            <div class="offer-day-grid">
                                                @foreach (var day in OfferDays)
                                                {
                                                    var slot = _offerDaySlots[day];
                                                    <div class="offer-day-row @(slot.Enabled ? "is-on" : null)">
                                                        <label class="offer-day-check">
                                                            <input type="checkbox" checked="@slot.Enabled"
                                                                   @onchange="e => OnOfferDayToggle(day, e)" />
                                                            <span>@OfferDayFullLabel(day)</span>
                                                        </label>
                                                        <input type="time" class="form-control form-control-sm offer-day-time"
                                                               disabled="@(!slot.Enabled)"
                                                               value="@slot.Time"
                                                               @onchange="e => SetOfferDayTime(day, e.Value?.ToString())" />
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <button type="button" class="cc-btn cc-btn-primary mt-3" disabled="@_offerBusy" @onclick="CreateOfferingAsync">
                                        @if (_offerBusy) { <span class="spinner-border spinner-border-sm"></span> }
                                        Créer l'offre
                                    </button>
                                </div>

                                <h3 class="h6 mt-4">@L["ExpertTeachers_RemarksTitle"]</h3>
                                @if (_remarks.Count == 0)
                                {
                                    <p class="text-muted small">@L["ExpertTeachers_RemarksEmpty"]</p>
                                }
                                else
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var r in _remarks)
                                        {
                                            <li class="py-2 border-bottom">
                                                <span class="cc-pill cc-pill-type">@CategoryLabel(r.Category)</span>
                                                <span class="small text-muted ms-2">@r.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                                @if (r.ReadByTeacherAt is not null)
                                                {
                                                    <span class="small text-muted ms-2"><i class="bi bi-check2-all"></i></span>
                                                }
                                                <div class="mt-1">@r.Message</div>
                                                <div class="small text-muted">@(r.AuthorName ?? "—")</div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>

                            <div class="col-lg-6">
                                <h3 class="h6">@L["ExpertTeachers_AddRemarkTitle"]</h3>

                                @if (!string.IsNullOrEmpty(_remarkError))
                                {
                                    <div class="alert alert-danger py-2">@_remarkError</div>
                                }
                                @if (!string.IsNullOrEmpty(_remarkSuccess))
                                {
                                    <div class="alert alert-success py-2">@_remarkSuccess</div>
                                }

                                <label class="form-label">@L["ExpertTeachers_RemarkCategory"]</label>
                                <select class="form-select mb-2" @bind="_formCategory">
                                    <option value="0">@L["ExpertTeachers_RemarkCategory_General"]</option>
                                    <option value="1">@L["ExpertTeachers_RemarkCategory_Activity"]</option>
                                    <option value="2">@L["ExpertTeachers_RemarkCategory_CourseMaterial"]</option>
                                </select>

                                <label class="form-label">@L["ExpertTeachers_RelatedMaterial"]</label>
                                <select class="form-select mb-2" @bind="_formRelatedKey">
                                    <option value="">@L["ExpertTeachers_RelatedMaterialNone"]</option>
                                    @foreach (var m in _materials)
                                    {
                                        <option value="@MaterialKey(m)">@MaterialKindLabel(m.Kind) — @m.Title</option>
                                    }
                                </select>

                                <label class="form-label">@L["ExpertTeachers_RemarkMessage"]</label>
                                <textarea class="form-control mb-3" rows="4" @bind="_formMessage"
                                          placeholder="@L["ExpertTeachers_RemarkMessagePlaceholder"]"></textarea>

                                <button type="button" class="cc-btn cc-btn-primary" disabled="@_remarkBusy" @onclick="SendRemarkAsync">
                                    @if (_remarkBusy) { <span class="spinner-border spinner-border-sm"></span> }
                                    <i class="bi bi-chat-left-text"></i> @L["ExpertTeachers_SendRemark"]
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <div class="cc-card cc-empty">
            <p>@L["Expert_LoginRequired"]</p>
            <a class="cc-btn cc-btn-primary" href="/login/expert">@L["Nav_Login"]</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<MonitoredTeacherItem> _teachers = [];
    private bool _loading = true;
    private string? _error;

    private Guid? _selectedTenantId;
    private bool _detailLoading;
    private List<TeacherMaterialItem> _materials = [];
    private List<ExpertRemarkItem> _remarks = [];
    private List<TeacherOfferingItem> _offerings = [];
    private TeacherSchoolVm? _school;

    private int _formCategory;
    private string _formRelatedKey = "";
    private string _formMessage = "";
    private bool _remarkBusy;
    private string? _remarkError;
    private string? _remarkSuccess;

    private string _offerTitle = "";
    private string? _offerSubject;
    private decimal _offerPrice;
    private string _offerCurrency = "CAD";
    private string _offerMode = "En ligne";
    private string _offerBillingMode = "hourly";
    private decimal _offerHoursPerWeek = 2;
    private int _offerSessionDuration = 60;
    private readonly Dictionary<string, OfferDaySlot> _offerDaySlots = OfferDays.ToDictionary(
        d => d, _ => new OfferDaySlot());
    private bool _offerBusy;
    private string? _offerError;
    private string? _offerSuccess;

    private string _sFirstName = "";
    private string _sLastName = "";
    private string? _sPhone;
    private string _sSchoolName = "";
    private string? _sDescription;
    private string? _sPresentation;
    private string? _sCity;
    private string? _sCountry;
    private string _sLanguage = "fr";
    private string _sCurrency = "CAD";
    private bool _schoolBusy;
    private string? _schoolError;
    private string? _schoolSuccess;

    private string? _photoUrl;
    private bool _photoBusy;
    private List<TeacherDisciplineStatusVm> _disciplines = [];
    private bool _discBusy;
    private HashSet<string> _availability = new(StringComparer.OrdinalIgnoreCase);
    private string? _portfolioJson;

    private static readonly string[] AvailabilityDays = ["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi", "Dimanche"];
    private static readonly string[] AvailabilitySlots = ["Matin", "Après-midi", "Soir"];
    private static readonly string[] OfferDays =
        ["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi", "Dimanche"];
    private static readonly JsonSerializerOptions PortfolioJsonOpts = new()
    {
        PropertyNameCaseInsensitive = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        await LoadTeachersAsync();
    }

    private async Task LoadTeachersAsync()
    {
        try
        {
            _teachers = await Api.GetAsync<List<MonitoredTeacherItem>>("api/expert/teachers") ?? [];
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task SelectTeacherAsync(Guid tenantId)
    {
        if (_selectedTenantId == tenantId) { CloseDetail(); return; }

        _selectedTenantId = tenantId;
        _detailLoading = true;
        _remarkError = null;
        _remarkSuccess = null;
        _offerError = null;
        _offerSuccess = null;
        _schoolError = null;
        _schoolSuccess = null;
        _formCategory = 0;
        _formRelatedKey = "";
        _formMessage = "";
        StateHasChanged();

        try
        {
            _materials = await Api.GetAsync<List<TeacherMaterialItem>>($"api/expert/teachers/{tenantId}/materials") ?? [];
            _remarks = await Api.GetAsync<List<ExpertRemarkItem>>($"api/expert/teachers/{tenantId}/remarks") ?? [];
            _offerings = await Api.GetAsync<List<TeacherOfferingItem>>($"api/expert/teachers/{tenantId}/offerings") ?? [];
            _school = await Api.GetAsync<TeacherSchoolVm>($"api/expert/teachers/{tenantId}/school");
            _disciplines = await Api.GetAsync<List<TeacherDisciplineStatusVm>>($"api/expert/teachers/{tenantId}/disciplines") ?? [];
            var branding = await Api.GetAsync<TeacherBrandingVm>($"api/expert/teachers/{tenantId}/branding");
            _photoUrl = branding?.LogoUrl;
            _portfolioJson = branding?.Portfolio;
            _availability = ParseAvailability(branding?.Portfolio);
            if (_school is not null)
            {
                _sFirstName = _school.FirstName;
                _sLastName = _school.LastName;
                _sPhone = _school.Phone;
                _sSchoolName = _school.SchoolName;
                _sDescription = _school.Description;
                _sPresentation = string.IsNullOrWhiteSpace(_school.Presentation)
                    ? _school.Description
                    : _school.Presentation;
                _sCity = _school.City;
                _sCountry = _school.Country;
                _sLanguage = string.IsNullOrWhiteSpace(_school.Language) ? "fr" : _school.Language;
                _sCurrency = string.IsNullOrWhiteSpace(_school.Currency) ? "CAD" : _school.Currency;
                _offerCurrency = _sCurrency;
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _detailLoading = false; }
    }

    private void CloseDetail()
    {
        _selectedTenantId = null;
        _materials = [];
        _remarks = [];
        _offerings = [];
        _school = null;
        _disciplines = [];
        _photoUrl = null;
        _availability = [];
        _portfolioJson = null;
    }

    private async Task CreateOfferingAsync()
    {
        if (_selectedTenantId is not Guid tenantId) return;
        if (string.IsNullOrWhiteSpace(_offerTitle))
        {
            _offerError = L["Expert_OfferTitleRequired"];
            return;
        }
        if (_offerPrice <= 0)
        {
            _offerError = L["Error_FillAllFields"];
            return;
        }
        if (_offerBillingMode == "monthly" && _offerHoursPerWeek <= 0)
        {
            _offerError = L["Expert_OfferHoursPerWeekRequired"];
            return;
        }

        var slots = _offerDaySlots
            .Where(kv => kv.Value.Enabled && !string.IsNullOrWhiteSpace(kv.Value.Time))
            .Select(kv => new { day = kv.Key, time = kv.Value.Time })
            .ToList();
        if (slots.Count == 0)
        {
            _offerError = L["Expert_OfferSlotsRequired"];
            return;
        }

        _offerBusy = true;
        _offerError = null;
        _offerSuccess = null;
        try
        {
            var isMonthly = _offerBillingMode == "monthly";
            var sessionMinutes = _offerSessionDuration > 0 ? _offerSessionDuration : 60;
            var sessionsPerWeek = isMonthly
                ? Math.Max(1, (int)Math.Ceiling((double)_offerHoursPerWeek * 60 / sessionMinutes))
                : slots.Count;
            var sessionCount = Math.Max(1, sessionsPerWeek * 4);

            var result = await Api.PostWithErrorAsync<TeacherOfferingItem>($"api/expert/teachers/{tenantId}/offerings", new
            {
                title = _offerTitle.Trim(),
                subject = string.IsNullOrWhiteSpace(_offerSubject) ? null : _offerSubject,
                price = _offerPrice,
                currency = string.IsNullOrWhiteSpace(_offerCurrency) ? _sCurrency : _offerCurrency,
                durationDays = isMonthly ? 30 : 7,
                sessionCount,
                frequency = isMonthly
                    ? $"{_offerHoursPerWeek:0.##} h/semaine · forfait mensuel"
                    : $"Taux horaire · {sessionMinutes} min",
                mode = _offerMode,
                maxCapacity = 20,
                schedule = new
                {
                    billingPeriod = isMonthly ? "mois" : "semaine",
                    cadence = "weekly",
                    sessionDurationMin = sessionMinutes,
                    level = (string?)null,
                    cancellationPolicy = (string?)null,
                    slots,
                    billingMode = isMonthly ? "monthly" : "hourly",
                    hourlyRate = isMonthly ? (decimal?)null : _offerPrice,
                    sessionRate = (decimal?)null,
                    hoursPerWeek = isMonthly ? _offerHoursPerWeek : (decimal?)null
                }
            });
            if (!result.IsSuccess)
            {
                _offerError = result.Error ?? "Échec de création de l'offre.";
                return;
            }

            _offerSuccess = "Offre créée (facturation + plages horaires).";
            _offerTitle = "";
            _offerSubject = null;
            _offerPrice = 0;
            _offerBillingMode = "hourly";
            _offerHoursPerWeek = 2;
            foreach (var day in OfferDays)
                _offerDaySlots[day] = new OfferDaySlot();
            _offerings = await Api.GetAsync<List<TeacherOfferingItem>>($"api/expert/teachers/{tenantId}/offerings") ?? [];
        }
        catch (Exception ex) { _offerError = ex.Message; }
        finally { _offerBusy = false; }
    }

    private void SetTeacherOfferBilling(string mode)
    {
        _offerBillingMode = mode is "monthly" ? "monthly" : "hourly";
    }

    private string OfferDayFullLabel(string day) => day switch
    {
        "Lundi" => L["Day_Monday"],
        "Mardi" => L["Day_Tuesday"],
        "Mercredi" => L["Day_Wednesday"],
        "Jeudi" => L["Day_Thursday"],
        "Vendredi" => L["Day_Friday"],
        "Samedi" => L["Day_Saturday"],
        "Dimanche" => L["Day_Sunday"],
        _ => day
    };

    private void OnOfferDayToggle(string day, ChangeEventArgs e)
    {
        var on = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (!_offerDaySlots.TryGetValue(day, out var slot)) return;
        slot.Enabled = on;
        if (on && string.IsNullOrWhiteSpace(slot.Time))
            slot.Time = "17:00";
    }

    private void SetOfferDayTime(string day, string? time)
    {
        if (_offerDaySlots.TryGetValue(day, out var slot))
            slot.Time = string.IsNullOrWhiteSpace(time) ? "17:00" : time!;
    }

    private async Task SaveSchoolAsync()
    {
        if (_selectedTenantId is not Guid tenantId) return;
        _schoolBusy = true;
        _schoolError = null;
        _schoolSuccess = null;
        try
        {
            var result = await Api.PutWithErrorAsync<TeacherSchoolVm>($"api/expert/teachers/{tenantId}/school", new
            {
                firstName = _sFirstName,
                lastName = _sLastName,
                phone = _sPhone,
                schoolName = _sSchoolName,
                description = _sDescription,
                presentation = _sPresentation,
                city = _sCity,
                country = _sCountry,
                language = _sLanguage,
                currency = _sCurrency
            });
            if (!result.IsSuccess || result.Value is null)
            {
                _schoolError = result.Error ?? "Échec de l'enregistrement.";
                return;
            }
            _school = result.Value;
            _sPresentation = string.IsNullOrWhiteSpace(_school.Presentation)
                ? _school.Description
                : _school.Presentation;

            await SaveAvailabilityAsync(tenantId);

            _schoolSuccess = _school.IsPublicProfile
                ? "Fiche publique mise à jour (profil, agenda, devise)."
                : "Fiche enregistrée (brouillon).";
            _teachers = await Api.GetAsync<List<MonitoredTeacherItem>>("api/expert/teachers") ?? _teachers;
        }
        catch (Exception ex) { _schoolError = ex.Message; }
        finally { _schoolBusy = false; }
    }

    private async Task SaveAvailabilityAsync(Guid tenantId)
    {
        var portfolio = BuildPortfolioJson();
        await Api.PutWithErrorAsync<TeacherBrandingVm>($"api/expert/teachers/{tenantId}/branding", new
        {
            presentation = _sPresentation,
            portfolio
        });
        _portfolioJson = portfolio;
    }

    private void ToggleAvailability(string key)
    {
        if (!_availability.Add(key))
            _availability.Remove(key);
    }

    private HashSet<string> ParseAvailability(string? portfolio)
    {
        if (string.IsNullOrWhiteSpace(portfolio)) return [];
        try
        {
            using var doc = JsonDocument.Parse(portfolio);
            if (doc.RootElement.TryGetProperty("availability", out var arr) && arr.ValueKind == JsonValueKind.Array)
            {
                return arr.EnumerateArray()
                    .Select(x => x.GetString())
                    .Where(s => !string.IsNullOrWhiteSpace(s))
                    .Cast<string>()
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
            }
        }
        catch { }
        return [];
    }

    private string BuildPortfolioJson()
    {
        Dictionary<string, object?>? existing = null;
        if (!string.IsNullOrWhiteSpace(_portfolioJson))
        {
            try
            {
                existing = JsonSerializer.Deserialize<Dictionary<string, object?>>(_portfolioJson, PortfolioJsonOpts);
            }
            catch { }
        }
        existing ??= new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        existing["availability"] = _availability.OrderBy(x => x).ToList();
        return JsonSerializer.Serialize(existing, PortfolioJsonOpts);
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        if (_selectedTenantId is not Guid tenantId) return;
        var file = e.File;
        if (file is null) return;
        _photoBusy = true;
        _schoolError = null;
        try
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "file", file.Name);
            var result = await Api.PostMultipartAsync<PhotoUploadVm>($"api/expert/teachers/{tenantId}/photo", content);
            if (!result.IsSuccess)
            {
                _schoolError = result.Error ?? "Échec de l'envoi de la photo.";
                return;
            }
            _photoUrl = result.Value?.LogoUrl ?? _photoUrl;
            _schoolSuccess = "Photo mise à jour.";
        }
        catch (Exception ex) { _schoolError = ex.Message; }
        finally { _photoBusy = false; }
    }

    private async Task ToggleDisciplineAsync(TeacherDisciplineStatusVm d, ChangeEventArgs e)
    {
        if (_selectedTenantId is not Guid tenantId) return;
        var on = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        _discBusy = true;
        _schoolError = null;
        try
        {
            if (on)
            {
                var r = await Api.PostWithErrorAsync<object>($"api/expert/teachers/{tenantId}/disciplines/{d.DisciplineId}", new { });
                if (!r.IsSuccess) { _schoolError = r.Error ?? "Affectation impossible."; return; }
            }
            else
            {
                var ok = await Api.DeleteAsync($"api/expert/teachers/{tenantId}/disciplines/{d.DisciplineId}");
                if (!ok) { _schoolError = "Retrait de la discipline impossible."; return; }
            }
            _disciplines = await Api.GetAsync<List<TeacherDisciplineStatusVm>>($"api/expert/teachers/{tenantId}/disciplines") ?? _disciplines;
            if (on && string.IsNullOrWhiteSpace(_offerSubject))
                _offerSubject = d.Name;
        }
        catch (Exception ex) { _schoolError = ex.Message; }
        finally { _discBusy = false; }
    }

    private async Task PublishSchoolAsync()
    {
        if (_selectedTenantId is not Guid tenantId) return;
        await SaveSchoolAsync();
        if (!string.IsNullOrEmpty(_schoolError)) return;

        _schoolBusy = true;
        _schoolError = null;
        _schoolSuccess = null;
        try
        {
            var result = await Api.PostWithErrorAsync<PublishSchoolResult>($"api/expert/teachers/{tenantId}/publish-profile", new { });
            if (!result.IsSuccess)
            {
                _schoolError = result.Error ?? "Échec de la publication.";
                return;
            }
            _school = await Api.GetAsync<TeacherSchoolVm>($"api/expert/teachers/{tenantId}/school") ?? _school;
            _schoolSuccess = result.Value is not null
                ? $"Fiche publique créée : {result.Value.PublicPath}"
                : "Fiche publique publiée.";
        }
        catch (Exception ex) { _schoolError = ex.Message; }
        finally { _schoolBusy = false; }
    }

    private async Task UnpublishSchoolAsync()
    {
        if (_selectedTenantId is not Guid tenantId) return;
        _schoolBusy = true;
        _schoolError = null;
        _schoolSuccess = null;
        try
        {
            var result = await Api.PostWithErrorAsync<PublishSchoolResult>($"api/expert/teachers/{tenantId}/unpublish-profile", new { });
            if (!result.IsSuccess)
            {
                _schoolError = result.Error ?? "Échec de la dépublication.";
                return;
            }
            _school = await Api.GetAsync<TeacherSchoolVm>($"api/expert/teachers/{tenantId}/school") ?? _school;
            _schoolSuccess = "Fiche dépubliée.";
        }
        catch (Exception ex) { _schoolError = ex.Message; }
        finally { _schoolBusy = false; }
    }

    private void PrepareRemarkFor(TeacherMaterialItem m)
    {
        _formCategory = 2; // CourseMaterial
        _formRelatedKey = MaterialKey(m);
        _remarkError = null;
        _remarkSuccess = null;
    }

    private async Task SendRemarkAsync()
    {
        if (_selectedTenantId is not Guid tenantId) return;
        if (string.IsNullOrWhiteSpace(_formMessage))
        {
            _remarkError = L["ExpertTeachers_RemarkMessageRequired"];
            return;
        }

        _remarkBusy = true;
        _remarkError = null;
        _remarkSuccess = null;
        try
        {
            Guid? homeworkId = null;
            Guid? documentId = null;
            if (!string.IsNullOrWhiteSpace(_formRelatedKey))
            {
                var parts = _formRelatedKey.Split(':', 2);
                if (parts.Length == 2 && Guid.TryParse(parts[1], out var relId))
                {
                    if (parts[0] == "Homework") homeworkId = relId;
                    else if (parts[0] == "Document") documentId = relId;
                }
            }

            var result = await Api.PostWithErrorAsync<ExpertRemarkItem>($"api/expert/teachers/{tenantId}/remarks", new
            {
                category = _formCategory,
                message = _formMessage,
                relatedHomeworkId = homeworkId,
                relatedDocumentId = documentId
            });

            if (!result.IsSuccess)
            {
                _remarkError = result.Error ?? L["ExpertTeachers_RemarkFailed"].Value;
                return;
            }

            _remarkSuccess = L["ExpertTeachers_RemarkSent"];
            _formMessage = "";
            _formRelatedKey = "";
            _formCategory = 0;

            _remarks = await Api.GetAsync<List<ExpertRemarkItem>>($"api/expert/teachers/{tenantId}/remarks") ?? [];
            _teachers = await Api.GetAsync<List<MonitoredTeacherItem>>("api/expert/teachers") ?? _teachers;
        }
        catch (Exception ex) { _remarkError = ex.Message; }
        finally { _remarkBusy = false; }
    }

    private static string MaterialKey(TeacherMaterialItem m) => $"{m.Kind}:{m.Id}";

    private string MaterialKindLabel(string kind) => kind switch
    {
        "Homework" => L["ExpertTeachers_MaterialKind_Homework"],
        "Document" => L["ExpertTeachers_MaterialKind_Document"],
        _ => kind
    };

    private string CategoryLabel(int category) => category switch
    {
        1 => L["ExpertTeachers_RemarkCategory_Activity"],
        2 => L["ExpertTeachers_RemarkCategory_CourseMaterial"],
        _ => L["ExpertTeachers_RemarkCategory_General"]
    };

    private static string JoinMeta(params string?[] parts) =>
        string.Join(" · ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));

