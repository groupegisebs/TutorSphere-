@page "/expert/teachers/add"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TutorSphere.Web.Common
@using TutorSphere.Application.DTOs.ExpertApproval
@using TutorSphere.Application.DTOs.Branding
@using TutorSphere.Application.Common
@inject AuthService Auth
@inject ApiClient Api
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Nav

<ApplyRequestCulture />

<PageTitle>Ajouter un enseignant — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar ex-toolbar">
            <div class="ex-page-head">
                <span class="ex-page-icon"><i class="bi bi-person-plus" aria-hidden="true"></i></span>
                <div>
                    <h1 class="cc-page-title">Ajouter un enseignant</h1>
                    <p class="cc-page-sub">
                        Créez le compte d’un enseignant qui donnera des cours, puis publiez sa fiche publique.
                    </p>
                </div>
            </div>
            <button type="button" class="cc-btn" @onclick="() => _showGuide = !_showGuide">
                <i class="bi bi-journal-text"></i> Guide d’utilisation
            </button>
        </div>

        @if (_showGuide)
        {
            <div class="alert alert-light border ex-demo-process mb-3">
                Parcours : informations personnelles → profil professionnel → matières → disponibilités → invitation → validation.
                L’enseignant n’est pas un membre du groupe d’experts.
            </div>
        }

        <div class="ex-add-layout">
            <div>
                <div class="cc-card ex-wizard-card">
                    <StepIndicator Steps="_steps" CurrentStep="_step" />

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger py-2">@_error</div>
                    }
                    @if (!string.IsNullOrEmpty(_success))
                    {
                        <div class="alert alert-success py-2">@_success</div>
                    }

                    @if (_step == 1)
                    {
                        <h2 class="cc-card-title mb-3">Informations personnelles</h2>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Prénom <span class="text-danger">*</span></label>
                                <input class="form-control" @bind="_firstName" @bind:event="oninput" @bind:after="OnNameChanged" autocomplete="given-name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Nom <span class="text-danger">*</span></label>
                                <input class="form-control" @bind="_lastName" @bind:event="oninput" @bind:after="OnNameChanged" autocomplete="family-name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Date de naissance</label>
                                <input type="date" class="form-control" @bind="_birthDate" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">E-mail <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" @bind="_email" placeholder="exemple@courriel.com" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Téléphone</label>
                                <div class="input-group">
                                    <span class="input-group-text">@PhoneAddon</span>
                                    <input class="form-control" @bind="_phone" placeholder="@PhonePlaceholder" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Pays de résidence</label>
                                <input class="form-control" value="@CountryDisplay" disabled readonly />
                                <div class="form-text">Identique au pays du groupe.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ville <span class="text-danger">*</span></label>
                                <input class="form-control" @bind="_city" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Adresse</label>
                                <input class="form-control" @bind="_address" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Code postal</label>
                                <input class="form-control" @bind="_postal" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Langue de communication <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="_language">
                                    <option value="fr">Français</option>
                                    <option value="en">English</option>
                                    <option value="es">Español</option>
                                    <option value="de">Deutsch</option>
                                    <option value="pt">Português</option>
                                    <option value="zh">中文</option>
                                    <option value="ar">العربية</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Photo de profil (optionnel)</label>
                                <label class="ex-upload">
                                    <i class="bi bi-cloud-arrow-up"></i>
                                    <span>PNG, JPG ou WEBP — max. 2 Mo</span>
                                    @if (!string.IsNullOrWhiteSpace(_photoName))
                                    {
                                        <strong>@_photoName</strong>
                                    }
                                    <InputFile OnChange="OnPhotoSelected" accept=".png,.jpg,.jpeg,.webp" />
                                </label>
                            </div>
                        </div>
                    }
                    else if (_step == 2)
                    {
                        <h2 class="cc-card-title mb-3">Informations professionnelles</h2>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Groupe / école</label>
                                <input class="form-control" value="@_schoolName" disabled readonly />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Adresse du profil (URL) <span class="text-danger">*</span></label>
                                <div class="subdomain-field">
                                    <span class="subdomain-prefix">https://</span>
                                    <input @bind="_slug" @bind:event="oninput" @bind:after="AfterSlugChanged" placeholder="jean" />
                                    <span class="subdomain-suffix">.tutorsphere.com</span>
                                </div>
                                @if (_slugAvailable == false)
                                {
                                    <small class="text-danger">@L["Error_SlugTaken"]</small>
                                }
                            </div>
                            <div class="col-12">
                                <label class="form-label">Présentation</label>
                                <textarea class="form-control" rows="3" @bind="_presentation"
                                          placeholder="Parcours, pédagogie, public visé…"></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Pays de visibilité du profil</label>
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    @if (_visible.Count == 0)
                                    {
                                        <span class="badge text-bg-light border py-2 px-2">🌐 International</span>
                                    }
                                    @foreach (var code in _visible)
                                    {
                                        var info = CountryCatalog.Find(code);
                                        <span class="badge text-bg-light border py-2 px-2">@(info?.Flag) @(info?.Name ?? code)</span>
                                    }
                                </div>
                                @if (_catalogLocked)
                                {
                                    <div class="form-text">Définie par l’offre du groupe (portée et pays de marché).</div>
                                }
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="pub" @bind="_publishPublic" />
                                    <label class="form-check-label" for="pub">@L["Expert_PublishPublicProfile"]</label>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_step == 3)
                    {
                        <h2 class="cc-card-title mb-3">Matières &amp; niveaux</h2>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Offre du groupe <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <select class="form-select" @bind="_offerPick" @bind:after="OnCatalogOfferChanged">
                                        <option value="">— Choisir une offre du catalogue —</option>
                                        @foreach (var o in SelectableOffers)
                                        {
                                            <option value="@o.Id.ToString()">@OfferOptionLabel(o)</option>
                                        }
                                        @if (_canManageOffers)
                                        {
                                            <option value="new">+ Créer une nouvelle offre…</option>
                                        }
                                    </select>
                                    @if (_canManageOffers)
                                    {
                                        <button type="button" class="btn btn-outline-secondary" title="Créer une offre"
                                                @onclick="BeginCreateCatalogOffer">+</button>
                                    }
                                </div>
                                <div class="form-text">
                                    Une offre existante applique son prix et sa visibilité (locale = pays du groupe, internationale = pays de marché).
                                </div>
                                @if (_groupOffers.Count == 0 && !_canManageOffers)
                                {
                                    <div class="form-text text-danger">Aucune offre dans le catalogue. Demandez au Responsable d’en créer une.</div>
                                }
                            </div>

                            @if (_offerPick == "new")
                            {
                                <div class="col-md-6">
                                    <label class="form-label">Nom de l’offre <span class="text-danger">*</span></label>
                                    <input class="form-control" @bind="_offerTitle" placeholder="Ex. Français — soutien scolaire" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Code</label>
                                    <input class="form-control" @bind="_newOfferCode" placeholder="MAA" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Prix recommandé (@GroupOfferCurrencyRules.FormatCurrencyLabel(NewOfferCurrency))</label>
                                    <input class="form-control" type="number" min="0" step="0.01" @bind="_price" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Portée *</label>
                                    <select class="form-select" @bind="_newOfferScope" @bind:after="OnNewScopeChanged">
                                        <option value="local">Locale (pays du groupe)</option>
                                        <option value="international">Internationale</option>
                                    </select>
                                </div>
                                @if (_newOfferScope == "international")
                                {
                                    <div class="col-md-4">
                                        <label class="form-label">Pays de marché *</label>
                                        <CountrySelect Value="@_newOfferMarket" ValueChanged="OnNewMarketChanged" Placeholder="Pays cible" />
                                    </div>
                                }
                                <div class="col-md-4">
                                    <label class="form-label">Devise</label>
                                    <input class="form-control" value="@GroupOfferCurrencyRules.FormatCurrencyLabel(NewOfferCurrency)" disabled readonly />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Description courte</label>
                                    <input class="form-control" @bind="_newOfferShort" />
                                </div>
                            }
                            else if (SelectedCatalogOffer is { } selected)
                            {
                                <div class="col-12">
                                    <div class="ex-offer-recap">
                                        <strong>@selected.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(selected.Code))
                                        {
                                            <span class="small text-muted">@selected.Code</span>
                                        }
                                        <div>Prix : @(selected.RecommendedPrice?.ToString("N0") ?? "—") @GroupOfferCurrencyRules.FormatCurrencyLabel(selected.Currency)</div>
                                        <div>Visibilité : @OfferScopeLabel(selected)</div>
                                        <div class="form-text mb-0">Prix et visibilité du catalogue — non modifiables ici.</div>
                                    </div>
                                </div>
                            }

                            <div class="col-md-6">
                                <label class="form-label">Matière</label>
                                <input class="form-control" @bind="_offerSubject" placeholder="Mathématiques, Français…" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Niveau</label>
                                <select class="form-select" @bind="_offerLevel">
                                    <option>Tous niveaux</option>
                                    <option>Primaire</option>
                                    <option>Collège</option>
                                    <option>Lycée</option>
                                    <option>Université</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Mode</label>
                                <select class="form-select" @bind="_offerMode">
                                    <option value="En ligne">En ligne</option>
                                    <option value="Présentiel">Présentiel</option>
                                    <option value="Hybride">Hybride</option>
                                </select>
                            </div>
                        </div>
                    }
                    else if (_step == 4)
                    {
                        <h2 class="cc-card-title mb-3">Disponibilités &amp; tarifs</h2>
                        <div class="ex-billing-toggle mb-3" role="group">
                            <button type="button" class="ex-billing-option @(_billing == "hourly" ? "active" : null)"
                                    @onclick='() => _billing = "hourly"'>
                                <strong>Taux horaire</strong>
                                <span>Facturé à l’heure</span>
                            </button>
                            <button type="button" class="ex-billing-option @(_billing == "monthly" ? "active" : null)"
                                    @onclick='() => _billing = "monthly"'>
                                <strong>Taux mensuel</strong>
                                <span>Forfait mensuel</span>
                            </button>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">@(_billing == "monthly" ? "Taux mensuel" : "Taux horaire") <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" min="0" step="0.01" class="form-control" @bind="_price"
                                           disabled="@_catalogLocked" readonly="@_catalogLocked" />
                                    <span class="input-group-text">@_currency @(_billing == "monthly" ? "/ mois" : "/ h")</span>
                                </div>
                                @if (_catalogLocked)
                                {
                                    <div class="form-text">Prix défini par l’offre du groupe.</div>
                                }
                            </div>
                            @if (_billing == "monthly")
                            {
                                <div class="col-md-4">
                                    <label class="form-label">Heures par semaine *</label>
                                    <input type="number" min="0.5" step="0.5" class="form-control" @bind="_hoursPerWeek" />
                                </div>
                            }
                            <div class="col-md-4">
                                <label class="form-label">Durée d’une séance <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <select class="form-select" @bind="_sessionMin">
                                        <option value="30">30</option>
                                        <option value="45">45</option>
                                        <option value="60">60</option>
                                        <option value="90">90</option>
                                    </select>
                                    <span class="input-group-text">min</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Fuseau horaire de l’enseignant</label>
                                <select class="form-select" @bind="_timeZone">
                                    @foreach (var tz in TimeZoneCatalog.All)
                                    {
                                        <option value="@tz.Id">@tz.Id (@TimeZoneCatalog.UtcOffsetLabel(tz.Id))</option>
                                    }
                                </select>
                                <div class="form-text">Les horaires sont enregistrés dans le fuseau horaire de l’enseignant.</div>
                            </div>
                            <div class="col-12">
                                <div class="ex-avail-head">
                                    <div>
                                        <label class="form-label mb-0">Plages horaires de disponibilité</label>
                                        <div class="form-text mt-0">Les créneaux de réservation seront générés selon la durée d’une séance, pas stockés ici.</div>
                                    </div>
                                    <div class="ex-avail-toolbar">
                                        <select class="form-select form-select-sm" value=""
                                                @onchange="e => CopyFromFirstEnabled(e.Value?.ToString())">
                                            <option value="">Copier les horaires ▾</option>
                                            @foreach (var d in Days)
                                            {
                                                <option value="@d">@d</option>
                                            }
                                            <option value="*">Tous les jours</option>
                                        </select>
                                        <button type="button" class="cc-btn cc-btn-sm ex-avail-off-all" @onclick="DisableAllDays">Tout désactiver</button>
                                    </div>
                                </div>
                                <button type="button" class="ex-avail-apply-toggle" @onclick="() => _applyCopyOpen = !_applyCopyOpen">
                                    Appliquer les mêmes horaires à plusieurs jours
                                </button>
                                @if (_applyCopyOpen)
                                {
                                    <div class="ex-avail-apply">
                                        <label class="form-label">Jour source</label>
                                        <select class="form-select form-select-sm" @bind="_copySource">
                                            @foreach (var d in Days)
                                            {
                                                <option value="@d">@d</option>
                                            }
                                        </select>
                                        <div class="ex-avail-apply-days">
                                            @foreach (var d in Days.Where(x => x != _copySource))
                                            {
                                                var target = d;
                                                <label>
                                                    <input type="checkbox" checked="@_copyTargets.Contains(target)"
                                                           @onchange="e => ToggleCopyTarget(target, e)" />
                                                    @target
                                                </label>
                                            }
                                        </div>
                                        <button type="button" class="cc-btn cc-btn-primary cc-btn-sm" @onclick="ApplyCopiedHours">Appliquer</button>
                                    </div>
                                }
                                <div class="ex-avail-table">
                                    <div class="ex-avail-cols">
                                        <span>Jour</span>
                                        <span>Plages horaires</span>
                                    </div>
                                    @foreach (var day in Days)
                                    {
                                        var sched = _avail[day];
                                        <div class="ex-avail-day @(sched.Enabled ? "is-on" : null)">
                                            <label class="ex-avail-check">
                                                <input type="checkbox" checked="@sched.Enabled"
                                                       @onchange="e => ToggleDay(day, e)" />
                                                <span>@day</span>
                                            </label>
                                            <div class="ex-avail-ranges">
                                                @if (!sched.Enabled)
                                                {
                                                    <span class="ex-avail-off">Indisponible</span>
                                                }
                                                else
                                                {
                                                    @for (var i = 0; i < sched.Ranges.Count; i++)
                                                    {
                                                        var idx = i;
                                                        var range = sched.Ranges[idx];
                                                        <div class="ex-avail-range">
                                                            <span>De</span>
                                                            <input type="time" class="form-control form-control-sm"
                                                                   value="@range.Start"
                                                                   @onchange="e => SetRange(day, idx, true, e.Value?.ToString())" />
                                                            <span>à</span>
                                                            <input type="time" class="form-control form-control-sm"
                                                                   value="@range.End"
                                                                   @onchange="e => SetRange(day, idx, false, e.Value?.ToString())" />
                                                            <button type="button" class="ex-avail-del" title="Supprimer la plage"
                                                                    @onclick="() => RemoveRange(day, idx)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                            @if (!string.IsNullOrWhiteSpace(range.Error))
                                                            {
                                                                <div class="ex-avail-error">@range.Error</div>
                                                            }
                                                        </div>
                                                    }
                                                    <div class="ex-avail-row-actions">
                                                        <button type="button" class="ex-avail-add" @onclick="() => AddRange(day)">
                                                            + Ajouter une plage
                                                        </button>
                                                        <select class="form-select form-select-sm ex-avail-copy"
                                                                value=""
                                                                @onchange="e => CopyDayTo(day, e.Value?.ToString())">
                                                            <option value="">Copier vers ▾</option>
                                                            @foreach (var other in Days.Where(d => d != day))
                                                            {
                                                                <option value="@other">@other</option>
                                                            }
                                                            <option value="*">Tous les jours</option>
                                                        </select>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="ex-avail-banner">
                                    Les créneaux de réservation seront générés automatiquement selon la durée d’une séance (@_sessionMin min).
                                </div>
                            </div>
                        </div>
                    }
                    else if (_step == 5)
                    {
                        <h2 class="cc-card-title mb-3">Invitation &amp; message</h2>
                        <p class="small text-muted">
                            Un e-mail d’identifiants sera envoyé à <strong>@(string.IsNullOrWhiteSpace(_email) ? "l’adresse indiquée" : _email)</strong>.
                        </p>
                        <div class="mb-3">
                            <label class="form-label">Message personnel (optionnel)</label>
                            <textarea class="form-control" rows="4" @bind="_inviteMessage"
                                      placeholder="Bienvenue dans le groupe. Merci de compléter votre fiche…"></textarea>
                        </div>
                        <div class="teacher-conduct-box">
                            <strong>@L["TeacherConduct_Title"]</strong>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="cond" @bind="_acceptedConduct" />
                                <label class="form-check-label" for="cond">@L["TeacherConduct_AcceptCheckbox"]</label>
                            </div>
                        </div>
                    }
                    else
                    {
                        <h2 class="cc-card-title mb-1">Aperçu &amp; validation</h2>
                        <p class="small text-muted mb-3">
                            Voici la fiche telle que les parents la verront
                            @if (!string.IsNullOrWhiteSpace(_slug))
                            {
                                <text> sur <code>/profil/@_slug</code></text>
                            }
                            . L’e-mail et le téléphone restent privés.
                        </p>
                        <div class="border rounded p-3 mb-3 bg-light">
                            <h3 class="h6 mb-2">Licence annuelle (code promo)</h3>
                            <p class="small text-muted mb-2">
                                Si vous saisissez un code promo, la session est activée tout de suite.
                                Cochez le renouvellement automatique pour prélever 10 $ USD à la source l’année suivante.
                            </p>
                            <label class="form-label" for="add-promo">Code promo (optionnel)</label>
                            <input id="add-promo" class="form-control font-monospace text-uppercase mb-2"
                                   placeholder="TS-ABCD1234" @bind="_licensePromo" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="add-autorenew"
                                       @bind="_autoRenewAtSource" />
                                <label class="form-check-label" for="add-autorenew">
                                    J’autorise le renouvellement annuel automatique par retenue à la source
                                </label>
                            </div>
                            <p class="form-text mb-0">Chaque année, 10 $ USD sont prélevés sur les premiers paiements dus à l’enseignant.</p>
                        </div>
                        @if (!_publishPublic)
                        {
                            <div class="alert alert-warning py-2">
                                Fiche en brouillon : elle ne sera pas visible dans la recherche ni à l’adresse publique tant que vous ne la publiez pas.
                            </div>
                        }
                        <div class="ex-public-preview">
                            <div class="ex-public-preview-bar">
                                <span><i class="bi bi-globe2"></i> Vue parents</span>
                                <span class="ex-public-preview-url">tutorsphere.com/profil/@_slug</span>
                                <span class="cc-pill @(_publishPublic ? "cc-pill-ok" : "cc-pill-type")">
                                    @(_publishPublic ? "Publiée" : "Brouillon")
                                </span>
                            </div>
                            <div class="ex-public-preview-frame tutor-detail-public">
                                <TutorDetailView Profile="BuildPublicPreview()" PreviewMode="true" />
                            </div>
                        </div>
                        @if (_done && _created is not null)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <a class="cc-btn cc-btn-primary" href="expert/teachers">Voir la liste des enseignants</a>
                                <a class="cc-btn" href="@($"expert/teachers/{_created.TenantId}")">Ouvrir le dossier</a>
                                @if (_created.IsPublicProfile && !string.IsNullOrWhiteSpace(_created.TenantSlug))
                                {
                                    <a class="cc-btn" href="@($"/profil/{_created.TenantSlug}")" target="_blank" rel="noopener">
                                        Ouvrir la fiche publique
                                    </a>
                                }
                            </div>
                        }
                    }

                    <div class="ex-wizard-actions">
                        <button type="button" class="cc-btn" @onclick="CancelOrBack">
                            @(_step == 1 ? "Annuler" : "Retour")
                        </button>
                        @if (_step < 6)
                        {
                            <button type="button" class="cc-btn cc-btn-primary" @onclick="NextAsync">Suivant →</button>
                        }
                        else
                        {
                            <button type="button" class="cc-btn cc-btn-primary" disabled="@(_busy || _done)" @onclick="SubmitAsync">
                                @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Créer le compte et la fiche
                            </button>
                        }
                    </div>
                </div>

                <div class="ex-why mt-3">
                    <h3 class="h6 mb-3">Pourquoi ajouter un enseignant ?</h3>
                    <div class="ex-why-grid">
                        <div><i class="bi bi-envelope"></i><strong>Invitation par e-mail</strong><span>L’enseignant reçoit ses identifiants.</span></div>
                        <div><i class="bi bi-folder2-open"></i><strong>Dossier complet</strong><span>Profil, matières, horaires et tarif.</span></div>
                        <div><i class="bi bi-graph-up"></i><strong>Suivi et évaluation</strong><span>Le groupe accompagne la qualité.</span></div>
                    </div>
                </div>
            </div>

            <aside class="ex-add-aside">
                <div class="cc-card mb-3">
                    <h2 class="cc-card-title">Étapes d’ajout</h2>
                    <ol class="ex-aside-steps">
                        @for (var i = 0; i < _steps.Count; i++)
                        {
                            var n = i + 1;
                            <li class="@(n == _step ? "is-on" : n < _step ? "is-done" : null)">
                                <span>@n</span>
                                <div>
                                    <strong>@_steps[i]</strong>
                                    <small>@_stepHints[i]</small>
                                </div>
                            </li>
                        }
                    </ol>
                </div>
                <div class="ex-hint-box mb-3">
                    <strong>Bon à savoir</strong>
                    <p>@HintText</p>
                </div>
                <div class="cc-card">
                    <h2 class="cc-card-title">Actions rapides</h2>
                    <a class="ex-action" href="expert/teachers"><i class="bi bi-people"></i><span>Voir la liste des enseignants</span></a>
                    <a class="ex-action" href="expert/approvals?tab=queue">
                        <i class="bi bi-inbox"></i>
                        <span>Enseignants en attente d’approbation</span>
                        @if (_pendingCount > 0)
                        {
                            <span class="cc-pill cc-pill-type">@_pendingCount</span>
                        }
                    </a>
                    <a class="ex-action" href="expert/approvals?tab=invite"><i class="bi bi-envelope"></i><span>Inviter plutôt par e-mail</span></a>
                </div>
            </aside>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="cc-card cc-empty">
            <p>@L["Expert_LoginRequired"]</p>
            <a class="cc-btn cc-btn-primary" href="/login/expert">@L["Nav_Login"]</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly List<string> _steps =
    [
        "Informations personnelles",
        "Informations professionnelles",
        "Matières & niveaux",
        "Disponibilités & tarifs",
        "Invitation & message",
        "Aperçu & validation"
    ];
    private static readonly List<string> _stepHints =
    [
        "Identité et coordonnées",
        "Profil public et visibilité",
        "Compétences et niveaux enseignés",
        "Taux horaire ou mensuel, plages",
        "Message et code de conduite",
        "Vérifier la fiche publique, puis créer le compte"
    ];
    private static readonly string[] Days = ["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi", "Samedi", "Dimanche"];
    private bool _showGuide;

    private int _step = 1;
    private bool _busy;
    private bool _done;
    private string? _error;
    private string? _success;
    private int _pendingCount;
    private Created? _created;
    private CancellationTokenSource? _slugCts;

    private string _firstName = "";
    private string _lastName = "";
    private DateTime? _birthDate;
    private string _email = "";
    private string? _phone;
    private string _city = "";
    private string? _address;
    private string? _postal;
    private string _language = "fr";
    private string _schoolName = "";
    private string _country = "";
    private bool _groupInternational;
    private bool _groupLoaded;
    private List<string> _visible = [];
    private string _slug = "";
    private string? _autoSlug;
    private bool? _slugAvailable;
    private string? _presentation;
    private bool _publishPublic = true;
    private bool _acceptedConduct;
    private string _licensePromo = "";
    private bool _autoRenewAtSource = true;
    private string _offerTitle = "";
    private string? _offerSubject;
    private string _offerLevel = "Tous niveaux";
    private string _offerMode = "En ligne";
    private string _offerPick = "";
    private Guid? _selectedGroupOfferId;
    private bool _catalogLocked;
    private bool _canManageOffers;
    private List<CatalogOffer> _groupOffers = [];
    private string? _newOfferCode;
    private string _newOfferScope = "local";
    private string? _newOfferMarket;
    private string? _newOfferShort;
    private string _billing = "hourly";
    private decimal _price;
    private decimal _hoursPerWeek = 2;
    private int _sessionMin = 60;
    private string _currency = "XAF";
    private string _timeZone = "America/Montreal";
    private bool _applyCopyOpen;
    private string _copySource = "Lundi";
    private readonly HashSet<string> _copyTargets = [];
    private string? _inviteMessage;
    private string? _photoName;
    private IBrowserFile? _photo;
    private byte[]? _photoBytes;
    private string? _photoContentType;
    private string? _photoDataUrl;
    private readonly Dictionary<string, DaySchedule> _avail = Days.ToDictionary(d => d, _ => new DaySchedule());

    private string CountryDisplay
    {
        get
        {
            if (!_groupLoaded) return "Chargement…";
            if (string.IsNullOrWhiteSpace(_schoolName))
                return "Pays du groupe indisponible";
            if (_groupInternational || string.IsNullOrWhiteSpace(_country))
                return "🌐 International";
            var info = CountryCatalog.Find(_country);
            return info is null ? _country : $"{info.Flag} {info.Name}";
        }
    }

    private string PhoneAddon
    {
        get
        {
            var flag = CountryCatalog.Find(_country)?.Flag ?? "🌐";
            var dial = CountryCatalog.DialPrefix(_country);
            return string.IsNullOrWhiteSpace(dial) ? flag : $"{flag} {dial}";
        }
    }

    private string PhonePlaceholder =>
        CountryCatalog.DialPrefix(_country) is { Length: > 0 } dial
            ? $"{dial} …"
            : "Numéro de téléphone";

    private string HintText => _step switch
    {
        3 => "Choisissez une offre du catalogue (prix et visibilité) ou créez-en une nouvelle.",
        4 => "Définir plusieurs plages par jour permet à l’enseignant d’avoir des pauses entre ses cours.",
        6 => "Cette vue est celle des parents : pas d’e-mail, pas de téléphone, uniquement ce qui sera public.",
        _ => "Une fois créé, l’enseignant reçoit un e-mail pour accéder à son espace et compléter sa fiche."
    };

    private string AvailabilitySummary
    {
        get
        {
            var parts = Days
                .Where(d => _avail[d].Enabled && _avail[d].Ranges.Count > 0)
                .Select(d => $"{d[..3]} {string.Join(", ", _avail[d].Ranges.Select(r => $"{r.Start}–{r.End}"))}");
            return parts.Any() ? string.Join(" · ", parts) : "Aucune";
        }
    }

    private TeacherPublicProfileDto BuildPublicPreview()
    {
        var display = TeacherPublicName.Format(_firstName, _lastName);
        if (string.IsNullOrWhiteSpace(display))
            display = "Enseignant";
        var countryName = CountryCatalog.Find(_country)?.Name ?? (string.IsNullOrWhiteSpace(_country) ? null : _country);
        var subject = string.IsNullOrWhiteSpace(_offerSubject) ? null : _offerSubject.Trim();
        var subjects = new List<string>();
        if (!string.IsNullOrWhiteSpace(subject))
            subjects.Add(subject);
        var levels = string.IsNullOrWhiteSpace(_offerLevel) ? Array.Empty<string>() : new[] { _offerLevel };
        var availability = Days
            .Where(d => _avail[d].Enabled)
            .SelectMany(d => _avail[d].Ranges.Select(r => $"{d}-{r.Start}–{r.End}"))
            .ToList();
        var sessionMinutes = _sessionMin > 0 ? _sessionMin : 60;
        var windows = FlattenAvailabilities().Sum(r => CountWindows(r.StartTime, r.EndTime, sessionMinutes));
        var monthly = _billing == "monthly";
        var sessionsPerWeek = monthly
            ? Math.Max(1, (int)Math.Ceiling((double)_hoursPerWeek * 60 / sessionMinutes))
            : Math.Max(1, windows);
        var sessionCount = Math.Max(1, sessionsPerWeek * 4);
        var frequency = monthly
            ? $"{_hoursPerWeek:0.##} h/semaine · forfait mensuel"
            : $"Taux horaire · {sessionMinutes} min";
        var offerTitle = string.IsNullOrWhiteSpace(_offerTitle) ? (subject ?? "Offre") : _offerTitle.Trim();
        var bio = string.IsNullOrWhiteSpace(_presentation) ? _inviteMessage : _presentation;
        var offering = new PublicOfferingDto(
            Guid.Empty,
            offerTitle,
            string.IsNullOrWhiteSpace(_inviteMessage) ? _presentation : _inviteMessage,
            subject,
            _price,
            string.IsNullOrWhiteSpace(_currency) ? "XAF" : _currency,
            monthly ? 30 : 7,
            sessionCount,
            frequency,
            string.IsNullOrWhiteSpace(_offerMode) ? "En ligne" : _offerMode,
            AvailabilitySummary == "Aucune" ? null : AvailabilitySummary,
            availability);
        var photo = TeacherPublicPhotoResolver.Resolve(_photoDataUrl, null, TeacherPublicName.Initials(_firstName, _lastName));
        return new TeacherPublicProfileDto
        {
            Slug = string.IsNullOrWhiteSpace(_slug) ? "enseignant" : _slug,
            DisplayName = display,
            GivenName = TeacherPublicName.FirstToken(_firstName),
            PublicInitials = photo.Initials,
            Location = TeacherPublicName.GeneralLocation(_city, countryName),
            City = _city,
            Country = countryName,
            Language = _language,
            Currency = string.IsNullOrWhiteSpace(_currency) ? "XAF" : _currency,
            PhotoUrl = photo.Url,
            PhotoKind = TeacherPublicPhotoResolver.ToApi(photo.Kind),
            PhotoIsGroupLogoFallback = photo.IsGroupLogoFallback,
            PrimaryColor = ColorHex.TutorSpherePrimary,
            SecondaryColor = ColorHex.TutorSphereSecondary,
            ShortBio = bio,
            FullBio = bio,
            HourlyRate = monthly ? 0 : _price,
            Status = _publishPublic ? "Disponible" : "Brouillon",
            Subjects = subjects,
            Levels = levels,
            Availability = availability,
            Offerings = [offering],
            ExpertGroupName = string.IsNullOrWhiteSpace(_schoolName) ? null : _schoolName,
            IsVerified = true
        };
    }

    private bool SlugOk => !string.IsNullOrWhiteSpace(_slug)
        && System.Text.RegularExpressions.Regex.IsMatch(_slug, @"^[a-z0-9]([a-z0-9-]{1,48}[a-z0-9])?$");

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        try
        {
            var group = await Api.GetAsync<Grp>("api/expert/my-group");
            if (group is not null)
            {
                _schoolName = group.Name;
                ApplyGroupCountry(group.CountryCode, group.IsInternational);
            }
        }
        catch { }
        _groupLoaded = true;
        try
        {
            var ctx = await Api.GetAsync<MeCtx>("api/expert/me-context");
            _canManageOffers = ctx?.IsGroupManager == true
                               || Auth.IsInRole("GroupManager")
                               || Auth.IsActingAsGroupAdmin;
        }
        catch
        {
            _canManageOffers = Auth.IsInRole("GroupManager") || Auth.IsActingAsGroupAdmin;
        }
        try
        {
            var catalog = await Api.GetAsync<OfferCatalog>("api/expert/group-offers");
            _groupOffers = catalog?.Offers?.Where(o => o.Status is not (4 or 5)).ToList() ?? [];
        }
        catch { }
        try
        {
            var q = await Api.GetAsync<List<QueuePeek>>("api/expert/approvals-queue") ?? [];
            _pendingCount = q.Count;
        }
        catch { }
    }

    private void CancelOrBack()
    {
        if (_step == 1) { Nav.NavigateTo("expert/teachers"); return; }
        _error = null;
        _step--;
    }

    private async Task NextAsync()
    {
        _error = null;
        if (_step == 1)
        {
            if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName)
                || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_city))
            {
                _error = "Prénom, nom, e-mail et ville sont obligatoires.";
                return;
            }
            if (!_email.Contains('@', StringComparison.Ordinal))
            {
                _error = "Indiquez une adresse e-mail valide.";
                return;
            }
        }
        else if (_step == 2)
        {
            if (!SlugOk) { _error = L["Error_InvalidSubdomain"]; return; }
            if (_slugAvailable == false) { _error = L["Error_SlugTaken"]; return; }
        }
        else if (_step == 3)
        {
            if (_offerPick == "new")
            {
                if (!await EnsureNewCatalogOfferAsync())
                    return;
            }
            else if (_selectedGroupOfferId is null)
            {
                _error = "Sélectionnez une offre du groupe ou créez-en une nouvelle.";
                return;
            }
            else if (string.IsNullOrWhiteSpace(_offerTitle))
            {
                _error = "Indiquez le titre de l’offre (matière / cours).";
                return;
            }
        }
        else if (_step == 4)
        {
            if (_price <= 0) { _error = "Indiquez le tarif."; return; }
            if (_billing == "monthly" && _hoursPerWeek <= 0)
            { _error = L["Expert_OfferHoursPerWeekRequired"]; return; }
            var availError = ValidateAvailabilities();
            if (availError is not null)
            {
                _error = availError;
                return;
            }
        }
        else if (_step == 5 && !_acceptedConduct)
        {
            _error = L["TeacherConduct_MustAccept"];
            return;
        }
        _step++;
        await Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        if (_done) return;
        if (!_acceptedConduct) { _error = L["TeacherConduct_MustAccept"]; return; }
        if (string.IsNullOrWhiteSpace(_schoolName))
        {
            _error = "Le groupe n’a pas pu être chargé. Rechargez la page.";
            return;
        }
        _busy = true;
        _error = _success = null;
        var assignNote = "";
        try
        {
            var ranges = FlattenAvailabilities();
            var slots = ranges.Select(r => new { day = r.Day, time = r.StartTime, endTime = r.EndTime }).ToList();
            var monthly = _billing == "monthly";
            var sessionMinutes = _sessionMin > 0 ? _sessionMin : 60;
            var windowsPerWeek = ranges.Sum(r => CountWindows(r.StartTime, r.EndTime, sessionMinutes));
            var sessionsPerWeek = monthly
                ? Math.Max(1, (int)Math.Ceiling((double)_hoursPerWeek * 60 / sessionMinutes))
                : Math.Max(1, windowsPerWeek);
            var sessionCount = Math.Max(1, sessionsPerWeek * 4);
            var schoolNotes = string.Join(" · ", new[]
            {
                string.IsNullOrWhiteSpace(_address) ? null : _address,
                string.IsNullOrWhiteSpace(_postal) ? null : $"CP {_postal}",
                _birthDate is DateTime d ? $"Né(e) le {d:dd/MM/yyyy}" : null
            }.Where(x => !string.IsNullOrWhiteSpace(x)));

            var result = await Api.PostWithErrorAsync<Created>("api/expert/register-teacher", new
            {
                email = _email.Trim(),
                firstName = _firstName,
                lastName = _lastName,
                schoolName = _schoolName,
                slug = _slug.Trim().ToLowerInvariant(),
                city = _city,
                country = string.IsNullOrWhiteSpace(_country) ? null : _country,
                visibleCountryCodes = _visible,
                acceptedTeacherConductPolicy = true,
                publishPublicProfile = _publishPublic,
                timeZone = _timeZone,
                availabilities = ranges.Select(r => new { day = r.Day, startTime = r.StartTime, endTime = r.EndTime }),
                initialOffering = new
                {
                    title = _offerTitle.Trim(),
                    description = string.IsNullOrWhiteSpace(_inviteMessage) ? _presentation : _inviteMessage,
                    subject = string.IsNullOrWhiteSpace(_offerSubject) ? null : _offerSubject,
                    price = _price,
                    currency = string.IsNullOrWhiteSpace(_currency)
                        ? GroupOfferCurrencyRules.ResolveCurrency(_country)
                        : _currency,
                    durationDays = monthly ? 30 : 7,
                    sessionCount,
                    frequency = monthly
                        ? $"{_hoursPerWeek:0.##} h/semaine · forfait mensuel"
                        : $"Taux horaire · {sessionMinutes} min",
                    mode = _offerMode,
                    maxCapacity = 20,
                    schedule = new
                    {
                        billingPeriod = monthly ? "mois" : "semaine",
                        cadence = "weekly",
                        sessionDurationMin = sessionMinutes,
                        level = _offerLevel,
                        slots,
                        billingMode = _billing,
                        hourlyRate = monthly ? (decimal?)null : _price,
                        hoursPerWeek = monthly ? _hoursPerWeek : (decimal?)null,
                        timeZone = _timeZone
                    }
                }
            });
            if (result.Error is not null) { _error = result.Error; return; }
            _created = result.Value;
            if (_created is not null)
            {
                await Api.PutWithErrorAsync<SchoolPatch>($"api/expert/teachers/{_created.TenantId}/school", new
                {
                    firstName = _firstName,
                    lastName = _lastName,
                    phone = _phone,
                    city = _city,
                    language = _language,
                    presentation = _presentation,
                    description = string.IsNullOrWhiteSpace(schoolNotes) ? null : schoolNotes
                });
                if (_photoBytes is { Length: > 0 })
                {
                    using var content = new MultipartFormDataContent();
                    var sc = new ByteArrayContent(_photoBytes);
                    sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_photoContentType ?? "image/jpeg");
                    content.Add(sc, "file", _photoName ?? "photo.jpg");
                    await Api.PostMultipartAsync<PhotoPatch>($"api/expert/teachers/{_created.TenantId}/photo", content);
                }
                if (_selectedGroupOfferId is Guid groupOfferId)
                {
                    var assign = await Api.PostWithErrorAsync<AssignResult>(
                        $"api/expert/group-offers/{groupOfferId}/teachers",
                        new
                        {
                            teacherTenantId = _created.TenantId,
                            teacherPrice = _price,
                            subscriptionOfferingId = _created.OfferingId
                        });
                    if (assign.Error is not null)
                        assignNote = " · affectation à l’offre du groupe : " + assign.Error;
                }
                if (!string.IsNullOrWhiteSpace(_licensePromo))
                {
                    var act = await Api.PostWithErrorAsync<object>(
                        $"api/expert/teachers/{_created.TenantId}/activate-session",
                        new
                        {
                            settlement = "promo",
                            promoCode = _licensePromo.Trim(),
                            autoRenewAtSource = _autoRenewAtSource
                        });
                    if (act.Error is not null)
                        assignNote += " · licence : " + act.Error;
                    else
                        assignNote += _autoRenewAtSource
                            ? " · session activée (promo, renouvellement auto à la source)."
                            : " · session activée (code promo).";
                }
                if (_publishPublic && !_created.IsPublicProfile)
                {
                    var pub = await Api.PostWithErrorAsync<PublishPatch>(
                        $"api/expert/teachers/{_created.TenantId}/publish-profile", new { });
                    if (pub.Error is null)
                        _created = _created with { IsPublicProfile = true };
                }
            }
            _success = _created is null
                ? L["Expert_RegisterTeacherSuccess"]
                : $"Compte créé. Login : {_created.Email}"
                  + (string.IsNullOrWhiteSpace(_created.TemporaryPassword) ? "" : $" · MDP temporaire : {_created.TemporaryPassword}")
                  + (_created.CredentialsSent ? " · e-mail envoyé." : " · e-mail non envoyé.")
                  + (_created.IsPublicProfile ? " Fiche publique publiée." : "")
                  + assignNote;
            _done = true;
            _step = 6;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (file.Size > 2 * 1024 * 1024)
        {
            _error = "Photo trop volumineuse (max. 2 Mo).";
            _photo = null;
            _photoBytes = null;
            _photoDataUrl = null;
            _photoName = null;
            return;
        }
        _error = null;
        _photo = file;
        _photoName = file.Name;
        _photoContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
        await using var stream = file.OpenReadStream(2 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _photoBytes = ms.ToArray();
        _photoDataUrl = $"data:{_photoContentType};base64,{Convert.ToBase64String(_photoBytes)}";
    }

    private async Task OnNameChanged()
    {
        if (!string.IsNullOrWhiteSpace(_slug) && _slug != _autoSlug) return;
        var generated = Slugify(_firstName, _lastName);
        _autoSlug = generated;
        _slug = generated;
        await AfterSlugChanged();
    }

    private async Task AfterSlugChanged()
    {
        _slug = _slug.Trim().ToLowerInvariant();
        _slugAvailable = null;
        if (!SlugOk) return;

        _slugCts?.Cancel();
        _slugCts = new CancellationTokenSource();
        var token = _slugCts.Token;
        try
        {
            await Task.Delay(400, token);
            var r = await Api.GetAsync<SlugOkDto>($"api/tenants/check-slug/{Uri.EscapeDataString(_slug)}");
            if (!token.IsCancellationRequested && r is not null)
                _slugAvailable = r.Available;
        }
        catch (OperationCanceledException) { }
        catch { }
    }

    private static string Slugify(string a, string b)
    {
        var combined = $"{a} {b}".Trim();
        if (string.IsNullOrWhiteSpace(combined)) return "";
        var n = combined.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in n)
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        var slug = System.Text.RegularExpressions.Regex.Replace(
            sb.ToString().Normalize(System.Text.NormalizationForm.FormC).ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');
        return slug.Length > 40 ? slug[..40].Trim('-') : slug;
    }

    private void ToggleDay(string day, ChangeEventArgs e)
    {
        var on = e.Value is bool x ? x : bool.TryParse(e.Value?.ToString(), out var p) && p;
        var sched = _avail[day];
        sched.Enabled = on;
        if (on && sched.Ranges.Count == 0)
            sched.Ranges.Add(new TimeRange());
        ValidateDay(day);
    }

    private void AddRange(string day)
    {
        var sched = _avail[day];
        sched.Enabled = true;
        var start = "14:00";
        var end = "18:00";
        if (sched.Ranges.Count > 0 && AvailabilityWindows.TryParseTime(sched.Ranges[^1].End, out var lastEnd))
        {
            var next = lastEnd.Add(TimeSpan.FromHours(2));
            if (next < TimeSpan.FromHours(22))
            {
                start = FormatClock(next);
                end = FormatClock(next.Add(TimeSpan.FromHours(4)));
            }
        }
        sched.Ranges.Add(new TimeRange { Start = start, End = end });
        ValidateDay(day);
    }

    private void RemoveRange(string day, int index)
    {
        var sched = _avail[day];
        if (index < 0 || index >= sched.Ranges.Count) return;
        sched.Ranges.RemoveAt(index);
        if (sched.Ranges.Count == 0)
            sched.Enabled = false;
        ValidateDay(day);
    }

    private void SetRange(string day, int index, bool isStart, string? value)
    {
        var sched = _avail[day];
        if (index < 0 || index >= sched.Ranges.Count) return;
        if (isStart) sched.Ranges[index].Start = string.IsNullOrWhiteSpace(value) ? "08:00" : value;
        else sched.Ranges[index].End = string.IsNullOrWhiteSpace(value) ? "12:00" : value;
        ValidateDay(day);
    }

    private void DisableAllDays()
    {
        foreach (var d in Days)
            _avail[d].Enabled = false;
    }

    private void CopyDayTo(string source, string? target)
    {
        if (string.IsNullOrWhiteSpace(target)) return;
        if (target == "*")
        {
            foreach (var d in Days.Where(x => x != source))
                CopyRanges(source, d);
            return;
        }
        CopyRanges(source, target);
    }

    private void CopyFromFirstEnabled(string? target)
    {
        if (string.IsNullOrWhiteSpace(target)) return;
        var source = Days.FirstOrDefault(d => _avail[d].Enabled && _avail[d].Ranges.Count > 0);
        if (source is null) return;
        if (target == "*")
        {
            foreach (var d in Days.Where(x => x != source))
                CopyRanges(source, d);
            return;
        }
        CopyRanges(source, target);
    }

    private void ToggleCopyTarget(string day, ChangeEventArgs e)
    {
        var on = e.Value is bool x ? x : bool.TryParse(e.Value?.ToString(), out var p) && p;
        if (on) _copyTargets.Add(day);
        else _copyTargets.Remove(day);
    }

    private void ApplyCopiedHours()
    {
        foreach (var d in _copyTargets.ToList())
            CopyRanges(_copySource, d);
        _applyCopyOpen = false;
    }

    private void CopyRanges(string source, string target)
    {
        if (!_avail.TryGetValue(source, out var from) || !_avail.TryGetValue(target, out var to) || source == target)
            return;
        to.Enabled = true;
        to.Ranges = from.Ranges.Select(r => new TimeRange { Start = r.Start, End = r.End }).ToList();
        if (to.Ranges.Count == 0)
            to.Ranges.Add(new TimeRange());
        ValidateDay(target);
    }

    private string? ValidateAvailabilities()
    {
        var any = false;
        foreach (var day in Days)
        {
            ValidateDay(day);
            var sched = _avail[day];
            if (!sched.Enabled) continue;
            if (sched.Ranges.Count == 0)
                return $"Ajoutez au moins une plage pour {day}, ou décochez le jour.";
            foreach (var r in sched.Ranges)
            {
                if (!string.IsNullOrWhiteSpace(r.Error))
                    return r.Error;
            }
            any = true;
        }
        return any ? null : "Cochez au moins un jour de disponibilité.";
    }

    private void ValidateDay(string day)
    {
        var sched = _avail[day];
        foreach (var r in sched.Ranges)
            r.Error = null;
        if (!sched.Enabled) return;

        var parsed = new List<(TimeRange Row, TimeSpan Start, TimeSpan End)>();
        foreach (var r in sched.Ranges)
        {
            if (!AvailabilityWindows.TryParseTime(r.Start, out var start)
                || !AvailabilityWindows.TryParseTime(r.End, out var end))
            {
                r.Error = "Indiquez une heure de début et de fin.";
                continue;
            }
            if (end <= start)
            {
                r.Error = "L’heure de fin doit être après l’heure de début.";
                continue;
            }
            parsed.Add((r, start, end));
        }

        for (var i = 0; i < parsed.Count; i++)
        {
            for (var j = i + 1; j < parsed.Count; j++)
            {
                if (!AvailabilityWindows.Overlaps(parsed[i].Start, parsed[i].End, parsed[j].Start, parsed[j].End))
                    continue;
                parsed[j].Row.Error = "Cette plage chevauche une disponibilité existante.";
            }
        }
    }

    private List<TeacherAvailabilityRangeDto> FlattenAvailabilities()
    {
        var list = new List<TeacherAvailabilityRangeDto>();
        foreach (var day in Days)
        {
            var sched = _avail[day];
            if (!sched.Enabled) continue;
            foreach (var r in sched.Ranges)
                list.Add(new TeacherAvailabilityRangeDto(day, r.Start, r.End));
        }
        return list;
    }

    private static int CountWindows(string start, string end, int sessionMin)
    {
        if (!AvailabilityWindows.TryParseTime(start, out var s)
            || !AvailabilityWindows.TryParseTime(end, out var e) || e <= s)
            return 0;
        return AvailabilityWindows.CountBookingSlots(s, e, sessionMin);
    }

    private static string FormatClock(TimeSpan t)
    {
        var clamped = t > TimeSpan.FromHours(23.5) ? TimeSpan.FromHours(23) : t;
        return $"{(int)clamped.TotalHours:D2}:{clamped.Minutes:D2}";
    }

