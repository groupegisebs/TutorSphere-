    private IEnumerable<CatalogOffer> SelectableOffers => _groupOffers;

    private CatalogOffer? SelectedCatalogOffer =>
        _selectedGroupOfferId is Guid id ? _groupOffers.FirstOrDefault(o => o.Id == id) : null;

    private string NewOfferCurrency =>
        _newOfferScope == "international"
            ? GroupOfferCurrencyRules.ResolveCurrency(_newOfferMarket)
            : GroupOfferCurrencyRules.ResolveCurrency(_country);

    private string OfferOptionLabel(CatalogOffer o)
    {
        var price = o.RecommendedPrice is decimal p ? p.ToString("N0") : "—";
        var cur = GroupOfferCurrencyRules.FormatCurrencyLabel(o.Currency);
        var scope = OfferScopeLabel(o);
        return string.IsNullOrWhiteSpace(o.Code)
            ? $"{o.Name} · {price} {cur} · {scope}"
            : $"{o.Name} ({o.Code}) · {price} {cur} · {scope}";
    }

    private string OfferScopeLabel(CatalogOffer o)
    {
        if (o.IsInternational)
        {
            var market = CountryCatalog.Find(o.MarketCountryCode)?.Name ?? o.MarketCountryCode;
            return string.IsNullOrWhiteSpace(market) ? "Internationale" : $"Internationale · {market}";
        }

        var local = CountryCatalog.Find(_country)?.Name ?? _country;
        return string.IsNullOrWhiteSpace(local) ? "Locale (pays du groupe)" : $"Locale · {local}";
    }

    private Task OnNewMarketChanged(string? code)
    {
        _newOfferMarket = code;
        _currency = NewOfferCurrency;
        return Task.CompletedTask;
    }

    private void OnNewScopeChanged()
    {
        if (_newOfferScope != "international")
            _newOfferMarket = null;
        _currency = NewOfferCurrency;
    }

    private void BeginCreateCatalogOffer()
    {
        _offerPick = "new";
        OnCatalogOfferChanged();
    }

    private void OnCatalogOfferChanged()
    {
        if (_offerPick == "new" || string.IsNullOrWhiteSpace(_offerPick))
        {
            _selectedGroupOfferId = null;
            _catalogLocked = false;
            return;
        }

        if (Guid.TryParse(_offerPick, out var id)
            && _groupOffers.FirstOrDefault(o => o.Id == id) is { } offer)
        {
            ApplyCatalogOffer(offer);
        }
    }

    private void ApplyCatalogOffer(CatalogOffer offer)
    {
        _selectedGroupOfferId = offer.Id;
        _offerPick = offer.Id.ToString();
        _offerTitle = offer.Name;
        if (string.IsNullOrWhiteSpace(_offerSubject))
            _offerSubject = offer.Name;
        if (offer.RecommendedPrice is decimal price && price > 0)
            _price = price;
        if (!string.IsNullOrWhiteSpace(offer.Currency))
            _currency = offer.Currency;
        _catalogLocked = true;
        var vis = offer.IsInternational
            ? offer.MarketCountryCode
            : (string.IsNullOrWhiteSpace(offer.MarketCountryCode) ? _country : offer.MarketCountryCode);
        _visible = string.IsNullOrWhiteSpace(vis) ? [] : [vis.Trim().ToUpperInvariant()];
    }

    private async Task<bool> EnsureNewCatalogOfferAsync()
    {
        if (!_canManageOffers)
        {
            _error = "Seul le Responsable peut créer une offre du groupe.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(_offerTitle))
        {
            _error = "Indiquez le nom de la nouvelle offre.";
            return false;
        }
        if (_price <= 0)
        {
            _error = "Indiquez le prix recommandé de l’offre.";
            return false;
        }
        if (_newOfferScope == "international" && string.IsNullOrWhiteSpace(_newOfferMarket))
        {
            _error = "Sélectionnez un pays de marché pour une offre internationale.";
            return false;
        }

        var international = _newOfferScope == "international";
        _currency = NewOfferCurrency;
        var result = await Api.PostWithErrorAsync<CatalogOffer>("api/expert/group-offers", new
        {
            name = _offerTitle.Trim(),
            code = _newOfferCode,
            shortDescription = _newOfferShort,
            pricingModel = 0,
            fixedPrice = _price,
            recommendedPrice = _price,
            isInternational = international,
            marketCountryCode = international ? _newOfferMarket : null
        });
        if (result.Error is not null || result.Value is null)
        {
            _error = result.Error ?? "Impossible de créer l’offre du groupe.";
            return false;
        }

        _groupOffers = _groupOffers.Where(o => o.Id != result.Value.Id).Prepend(result.Value).ToList();
        ApplyCatalogOffer(result.Value);
        return true;
    }

    private void ApplyGroupCountry(string? countryCode, bool isInternational)
    {
        _groupInternational = isInternational;
        var iso = ResolveGroupCountryCode(countryCode);
        if (!string.IsNullOrWhiteSpace(iso) && !isInternational)
        {
            _country = iso;
            _visible = [iso];
        }
        else
        {
            _country = "";
            _visible = [];
        }

        _currency = GroupOfferCurrencyRules.ResolveCurrency(_country);
        if (string.IsNullOrWhiteSpace(_timeZone) || _timeZone == "America/Montreal")
            _timeZone = TimeZoneCatalog.DefaultForCountry(_country);
        _groupLoaded = true;
    }

    private static string? ResolveGroupCountryCode(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var trimmed = raw.Trim();
        var exact = CountryCatalog.Find(trimmed);
        if (exact is not null) return exact.Code;

        var normalized = GroupOfferCurrencyRules.NormalizeCountryCode(trimmed);
        var byNorm = CountryCatalog.Find(normalized);
        if (byNorm is not null) return byNorm.Code;

        var named = CountryCatalog.Search(trimmed);
        return named.Count == 1 ? named[0].Code : null;
    }

