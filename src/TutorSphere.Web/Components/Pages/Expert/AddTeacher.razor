    private sealed record Created(
        Guid TenantId,
        string TenantSlug,
        string Email,
        bool CredentialsSent,
        Guid? OfferingId = null,
        string? TemporaryPassword = null,
        bool IsPublicProfile = false,
        string? PublicPath = null);
    private sealed class SchoolPatch { public Guid TenantId { get; set; } }
    private sealed class PhotoPatch { public string? LogoUrl { get; set; } }
    private sealed class PublishPatch { public bool IsPublicProfile { get; set; } }
