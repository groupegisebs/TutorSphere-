@page "/expert/meetings/create"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Créer une réunion — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <MeetingCreateForm CancelHref="/expert/meetings" RoomPrefix="/expert/meetings" />
    </Authorized>
    <NotAuthorized>
        <p>Connectez-vous pour créer une réunion.</p>
    </NotAuthorized>
</AuthorizeView>
