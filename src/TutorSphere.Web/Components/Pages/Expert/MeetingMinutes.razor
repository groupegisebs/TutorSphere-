@page "/expert/meetings/{Id:guid}/minutes"
@page "/admin/meetings/{Id:guid}/minutes"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService Auth
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>Compte rendu — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        @if (_loading) { <span class="spinner-border"></span> }
        else if (_m is null) { <div class="alert alert-danger">@(_error ?? "Compte rendu introuvable.")</div> }
        else
        {
            <div class="cc-toolbar">
                <div class="ex-page-head">
                    <span class="ex-page-icon"><i class="bi bi-journal-text"></i></span>
                    <div>
                        <h1 class="cc-page-title">Compte rendu</h1>
                        <p class="cc-page-sub">@_m.Meeting.Title</p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="cc-btn" type="button" @onclick="PrintAsync">Exporter PDF</button>
                    <button class="cc-btn" type="button" @onclick="EmailAsync">Envoyer par e-mail</button>
                    <button class="cc-btn" type="button" @onclick="ShareGroupAsync">Partager avec le groupe</button>
                    <button class="cc-btn cc-btn-primary" type="button" @onclick="ApproveAsync">Approuver</button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger">@_error</div> }
            <div class="cc-card mtg-minutes">
                <p><strong>Durée :</strong> @DurationLabel</p>
                <p><strong>Ordre du jour :</strong> @(_m.Meeting.Agenda ?? "—")</p>
                <h3>Participants</h3>
                <ul>
                    @foreach (var p in _m.Attendance)
                    {
                        <li>@p.DisplayName — @StatusFr(p.Status) @(p.IsExternal ? "(externe)" : "") — @TimeSpan.FromSeconds(p.DurationSeconds)</li>
                    }
                </ul>
                @if (_m.Summary is not null)
                {
                    <h3>Résumé IA</h3>
                    <p>@_m.Summary.Overview</p>
                    <p><strong>Sujets :</strong> @string.Join(" · ", _m.Summary.Topics)</p>
                    <p><strong>Questions ouvertes :</strong> @string.Join(" · ", _m.Summary.OpenQuestions)</p>
                    <p><strong>Risques :</strong> @string.Join(" · ", _m.Summary.Risks)</p>
                    <p><strong>Prochaines étapes :</strong> @_m.Summary.NextSteps</p>
                }
                <h3>Décisions</h3>
                @foreach (var d in _m.Decisions)
                {
                    <div class="mtg-ai-card">
                        <p>@d.Text @(d.FromAi ? "(IA)" : "")</p>
                        @if (!d.Accepted)
                        {
                            <button class="cc-btn cc-btn-primary cc-btn-sm" @onclick="() => ReviewDecision(d.Id, true)">Valider</button>
                            <button class="cc-btn cc-btn-sm" @onclick="() => ReviewDecision(d.Id, false)">Rejeter</button>
                        }
                        else { <span class="text-success">Acceptée</span> }
                    </div>
                }
                <h3>Actions proposées</h3>
                <p class="mtg-hint">Aucune action n’est enregistrée tant qu’elle n’est pas validée.</p>
                @foreach (var a in _m.Actions)
                {
                    <div class="mtg-ai-card">
                        <input class="form-control mb-2" @bind="a.Title" />
                        <div class="d-flex gap-2">
                            <input class="form-control" placeholder="Responsable" @bind="a.AssigneeName" />
                            <input class="form-control" type="date" value="@a.DueAtUtc?.ToString("yyyy-MM-dd")" @onchange="e => a.DueAtUtc = ParseDue(e)" />
                        </div>
                        <p class="mt-2 mb-1"><small>Statut : @ActionFr(a.Status) @(a.FromAi ? "· proposition IA" : "")</small></p>
                        @if (a.Status == 0)
                        {
                            <button class="cc-btn cc-btn-primary cc-btn-sm" @onclick="() => ReviewAction(a, 1)">Valider</button>
                            <button class="cc-btn cc-btn-sm" @onclick="() => ReviewAction(a, 3)">Modifier</button>
                            <button class="cc-btn cc-btn-sm" @onclick="() => ReviewAction(a, 2)">Rejeter</button>
                        }
                    </div>
                }
                <h3>Conversation</h3>
                <pre class="mtg-pre">@string.Join("\n", _m.Chat)</pre>
                <h3>Fichiers</h3>
                <p>@(_m.Files.Count == 0 ? "Aucun fichier." : string.Join(", ", _m.Files))</p>
                <h3>Enregistrement</h3>
                <p>@(_m.RecordingAvailable ? "Un enregistrement est disponible." : "Pas d’enregistrement.")</p>
                <h3>Transcription</h3>
                <pre class="mtg-pre">@(_m.Transcript ?? "—")</pre>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public Guid Id { get; set; }
    private MinutesDto? _m;
    private bool _loading = true;
    private string? _error;

    private string DurationLabel
    {
        get
        {
            if (_m?.Meeting.StartAtUtc is null) return "—";
            var end = _m.Meeting.EndAtUtc ?? DateTime.UtcNow;
            return (end - _m.Meeting.StartAtUtc.Value).ToString(@"hh\:mm");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Auth.EnsureSessionRestoredAsync();
        var r = await Api.GetWithErrorAsync<MinutesDto>($"api/expert/meetings/{Id}/minutes");
        _error = r.Error;
        _m = r.Value;
        _loading = false;
    }

    private async Task ReviewAction(ActionDto a, int status)
    {
        var r = await Api.PostWithErrorAsync<object>($"api/expert/meetings/{Id}/actions/{a.Id}/review", new
        {
            status,
            title = a.Title,
            assigneeName = a.AssigneeName,
            dueAtUtc = a.DueAtUtc
        });
        _error = r.Error;
        if (_error is null) await OnInitializedAsync();
    }

    private async Task ReviewDecision(Guid id, bool accepted)
    {
        var r = await Api.PostWithErrorAsync<object>($"api/expert/meetings/{Id}/decisions/{id}/review", new { accepted });
        _error = r.Error;
        if (_error is null) await OnInitializedAsync();
    }

    private async Task ApproveAsync()
    {
        var r = await Api.PostWithErrorAsync<object>($"api/expert/meetings/{Id}/minutes/approve", new { });
        _error = r.Error ?? "Compte rendu approuvé.";
    }

    private async Task EmailAsync()
    {
        var r = await Api.PostWithErrorAsync<object>($"api/expert/meetings/{Id}/minutes/email", new { extraEmails = Array.Empty<string>() });
        _error = r.Error ?? "Compte rendu envoyé.";
    }

    private async Task ShareGroupAsync()
    {
        var r = await Api.PostWithErrorAsync<object>($"api/expert/meetings/{Id}/minutes/share", new { share = 1 });
        _error = r.Error ?? "Partage limité au groupe.";
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");
    private static DateTime? ParseDue(ChangeEventArgs e) =>
        DateTime.TryParse(e.Value?.ToString(), out var d) ? DateTime.SpecifyKind(d, DateTimeKind.Utc) : null;
    private static string StatusFr(int s) => s switch { 1 => "Présent", 5 => "Parti", 8 => "Absent", 4 => "En réunion", _ => "Invité" };
    private static string ActionFr(int s) => s switch { 0 => "Proposée", 1 => "Acceptée", 2 => "Rejetée", 3 => "Modifiée", _ => "" };

    private sealed class MinutesDto
    {
        public MeetingDto Meeting { get; set; } = new();
        public SummaryDto? Summary { get; set; }
        public List<DecisionDto> Decisions { get; set; } = [];
        public List<ActionDto> Actions { get; set; } = [];
        public List<PartDto> Attendance { get; set; } = [];
        public List<string> Chat { get; set; } = [];
        public List<string> Files { get; set; } = [];
        public bool RecordingAvailable { get; set; }
        public string? Transcript { get; set; }
    }
    private sealed class MeetingDto
    {
        public string Title { get; set; } = "";
        public string? Agenda { get; set; }
        public DateTime? StartAtUtc { get; set; }
        public DateTime? EndAtUtc { get; set; }
    }
    private sealed class SummaryDto
    {
        public string? Overview { get; set; }
        public List<string> Topics { get; set; } = [];
        public List<string> OpenQuestions { get; set; } = [];
        public List<string> Risks { get; set; } = [];
        public string? NextSteps { get; set; }
    }
    private sealed class DecisionDto { public Guid Id { get; set; } public string Text { get; set; } = ""; public bool FromAi { get; set; } public bool Accepted { get; set; } }
    private sealed class ActionDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public string? AssigneeName { get; set; }
        public DateTime? DueAtUtc { get; set; }
        public int Status { get; set; }
        public bool FromAi { get; set; }
    }
    private sealed class PartDto
    {
        public string DisplayName { get; set; } = "";
        public int Status { get; set; }
        public int DurationSeconds { get; set; }
        public bool IsExternal { get; set; }
    }
}
