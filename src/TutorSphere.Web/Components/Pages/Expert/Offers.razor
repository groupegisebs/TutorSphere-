@page "/expert/offers"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService Auth
@inject ApiClient Api
@inject IStringLocalizer<SharedResources> L

<ApplyRequestCulture />

<PageTitle>Offres du groupe — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">Catalogue — Offres du groupe</h1>
                <p class="cc-page-sub">
                    @if (_canManage)
                    {
                        <text>Créez, modifiez ou supprimez les offres, puis affectez-les aux enseignants du groupe.</text>
                    }
                    else
                    {
                        <text>Consultation des offres du groupe. La gestion (création / modification / suppression) est réservée au Responsable.</text>
                    }
                </p>
            </div>
            @if (!string.IsNullOrWhiteSpace(_groupCurrencyLabel))
            {
                <div class="text-end">
                    <div class="small text-muted">Devise du groupe</div>
                    <strong>@_groupCurrencyLabel</strong>
                    @if (!string.IsNullOrWhiteSpace(_groupCountryCode))
                    {
                        <div class="small text-muted">@_groupCountryCode</div>
                    }
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_info))
        {
            <div class="alert alert-success">@_info</div>
        }

        @if (_canManage)
        {
            <div class="cc-card mb-3">
                <h2 class="cc-card-title">@(_editId is null ? "Nouvelle offre (brouillon)" : "Modifier l'offre")</h2>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">Nom *</label>
                        <input class="form-control" @bind="_name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Code</label>
                        <input class="form-control" @bind="_code" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Prix recommandé (@PreviewCurrencyLabel)</label>
                        <input class="form-control" type="number" @bind="_price" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Portée *</label>
                        <select class="form-select" @bind="_scope" @bind:after="OnScopeChanged">
                            <option value="local">Locale (pays du groupe)</option>
                            <option value="international">Internationale</option>
                        </select>
                    </div>
                    @if (IsInternational)
                    {
                        <div class="col-md-4">
                            <label class="form-label">Pays de marché *</label>
                            <CountrySelect Value="@_marketCountry" ValueChanged="OnMarketCountryChanged" Placeholder="Pays cible" />
                        </div>
                    }
                    <div class="col-md-4">
                        <label class="form-label">Devise (automatique)</label>
                        <input class="form-control" value="@PreviewCurrencyLabel" disabled readonly />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description courte</label>
                        <input class="form-control" @bind="_short" />
                    </div>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button type="button" class="cc-btn cc-btn-primary" disabled="@_busy" @onclick="SaveAsync">
                        @(_editId is null ? "Créer" : "Enregistrer")
                    </button>
                    @if (_editId is not null)
                    {
                        <button type="button" class="cc-btn" disabled="@_busy" @onclick="CancelEdit">Annuler</button>
                    }
                </div>
                <p class="small text-muted mt-2 mb-0">
                    Devise internationale : Europe → EUR · Canada → $CAD · USA → $USD · Cameroun / Afrique → XAF.
                </p>
            </div>
        }

        <div class="cc-card">
            @if (_loading)
            {
                <span class="spinner-border"></span>
            }
            else if (_offers.Count == 0)
            {
                <p class="text-muted mb-0">Aucune offre.</p>
            }
            else
            {
                <table class="cc-table">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Portée</th>
                            <th>Statut</th>
                            <th>Enseignants</th>
                            <th>Prix</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in _offers)
                        {
                            <tr>
                                <td>
                                    <strong>@o.Name</strong>
                                    <span class="small text-muted">@o.Code</span>
                                </td>
                                <td>
                                    @(o.IsInternational ? "Internationale" : "Locale")
                                    @if (!string.IsNullOrWhiteSpace(o.MarketCountryCode))
                                    {
                                        <span class="small text-muted">· @o.MarketCountryCode</span>
                                    }
                                </td>
                                <td>@StatusName(o.Status)</td>
                                <td>@o.AssignedTeacherCount</td>
                                <td>@(o.RecommendedPrice?.ToString("N0") ?? "—") @GroupOfferCurrencyRules.FormatCurrencyLabel(o.Currency)</td>
                                <td class="text-end text-nowrap">
                                    @if (_canManage)
                                    {
                                        <button type="button" class="cc-btn btn-sm" @onclick="() => OpenAssignAsync(o)">Affecter</button>
                                        <button type="button" class="cc-btn btn-sm" @onclick="() => BeginEdit(o)">Modifier</button>
                                        <button type="button" class="cc-btn btn-sm" @onclick="() => DeleteAsync(o)">Supprimer</button>
                                        @if (o.Status is 0 or 1 or 2)
                                        {
                                            <button type="button" class="cc-btn btn-sm" @onclick="() => PublishAsync(o.Id)">Publier</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (_assignOffer is not null)
        {
            <div class="cc-card mt-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h2 class="cc-card-title mb-0">Affecter — @_assignOffer.Name</h2>
                        <p class="small text-muted mb-0">
                            Crée une offre sur le compte enseignant (agenda &amp; abonnements). L’enseignant complète ensuite ses créneaux.
                        </p>
                    </div>
                    <button type="button" class="cc-btn btn-sm" @onclick="CloseAssign">Fermer</button>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-8">
                        <label class="form-label">Enseignant du groupe</label>
                        <select class="form-select" @bind="_assignTenantId">
                            <option value="">— Choisir —</option>
                            @foreach (var t in _assignableTeachers)
                            {
                                <option value="@t.TenantId.ToString()">@t.SchoolName @(string.IsNullOrWhiteSpace(t.City) ? "" : $"· {t.City}")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="button" class="cc-btn cc-btn-primary w-100" disabled="@(_busy || string.IsNullOrEmpty(_assignTenantId))"
                                @onclick="AssignTeacherAsync">
                            Affecter l’offre
                        </button>
                    </div>
                </div>

                @if (_assignments.Count == 0)
                {
                    <p class="text-muted mb-0">Aucun enseignant affecté.</p>
                }
                else
                {
                    <table class="cc-table">
                        <thead>
                            <tr>
                                <th>Enseignant</th>
                                <th>Statut</th>
                                <th>Prix</th>
                                <th>Offre plateforme</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in _assignments)
                            {
                                <tr>
                                    <td>@a.TeacherName</td>
                                    <td>@a.AssignmentStatus</td>
                                    <td>@(a.TeacherPrice?.ToString("N0") ?? "—")</td>
                                    <td class="small text-muted">@(a.SubscriptionOfferingId is Guid oid ? oid.ToString("N")[..8] + "…" : "—")</td>
                                    <td class="text-end">
                                        <button type="button" class="cc-btn btn-sm" @onclick="() => UnassignAsync(a)">Retirer</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _canManage;
    private string? _error;
    private string? _info;
    private string _name = "";
    private string? _code;
    private string? _short;
    private decimal? _price;
    private string _scope = "local";
    private string? _marketCountry;
    private Guid? _editId;
    private string _groupCurrency = "XAF";
    private string? _groupCountryCode;
    private List<OfferItem> _offers = [];
    private OfferItem? _assignOffer;
    private string _assignTenantId = "";
    private List<AssignableTeacher> _assignableTeachers = [];
    private List<AssignmentItem> _assignments = [];

    private bool IsInternational => string.Equals(_scope, "international", StringComparison.OrdinalIgnoreCase);
    private string _groupCurrencyLabel => GroupOfferCurrencyRules.FormatCurrencyLabel(_groupCurrency);
    private string PreviewCurrencyLabel => GroupOfferCurrencyRules.FormatCurrencyLabel(
        IsInternational
            ? GroupOfferCurrencyRules.ResolveCurrency(_marketCountry)
            : GroupOfferCurrencyRules.ResolveCurrency(_groupCountryCode));

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        try { await Auth.RestoreActAsGroupAsync(); } catch { }
        try
        {
            var ctx = await Api.GetAsync<MeContext>("api/expert/me-context");
            _canManage = ctx?.IsGroupManager == true
                         || Auth.IsInRole("GroupManager")
                         || Auth.IsActingAsGroupAdmin;
        }
        catch
        {
            _canManage = Auth.IsInRole("GroupManager") || Auth.IsActingAsGroupAdmin;
        }
        await ReloadAsync();
    }

    private Task OnScopeChanged()
    {
        if (!IsInternational)
            _marketCountry = null;
        return Task.CompletedTask;
    }

    private Task OnMarketCountryChanged(string? code)
    {
        _marketCountry = code;
        return Task.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.GetWithErrorAsync<CatalogDto>("api/expert/group-offers");
            if (result.Error is not null)
            {
                _error = result.Error;
                // Ne pas vider la liste locale : une offre vient peut-être d'être créée.
                return;
            }

            var catalog = result.Value;
            _offers = catalog?.Offers?.ToList() ?? [];
            _groupCurrency = string.IsNullOrWhiteSpace(catalog?.GroupCurrency) ? "XAF" : catalog!.GroupCurrency;
            _groupCountryCode = catalog?.GroupCountryCode;
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void BeginEdit(OfferItem o)
    {
        _editId = o.Id;
        _name = o.Name;
        _code = o.Code;
        _short = o.ShortDescription;
        _price = o.RecommendedPrice;
        _scope = o.IsInternational ? "international" : "local";
        _marketCountry = o.MarketCountryCode;
        _info = null;
        _error = null;
    }

    private void CancelEdit()
    {
        _editId = null;
        ResetForm();
    }

    private void ResetForm()
    {
        _name = "";
        _code = _short = null;
        _price = null;
        _scope = "local";
        _marketCountry = null;
    }

    private async Task SaveAsync()
    {
        if (!_canManage)
        {
            _error = "Seul le Responsable peut créer ou modifier une offre.";
            return;
        }

        _busy = true;
        _info = null;
        _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_name))
            {
                _error = "Le nom de l'offre est requis.";
                return;
            }

            if (IsInternational && string.IsNullOrWhiteSpace(_marketCountry))
            {
                _error = "Sélectionnez un pays de marché pour une offre internationale.";
                return;
            }

            var payload = new
            {
                name = _name,
                code = _code,
                shortDescription = _short,
                pricingModel = 0,
                fixedPrice = _price,
                recommendedPrice = _price,
                isInternational = IsInternational,
                marketCountryCode = IsInternational ? _marketCountry : null
            };

            if (_editId is Guid id)
            {
                var result = await Api.PutWithErrorAsync<OfferItem>($"api/expert/group-offers/{id}", payload);
                if (result.Error is not null) { _error = result.Error; return; }
                _info = "Offre mise à jour.";
            }
            else
            {
                var result = await Api.PostWithErrorAsync<OfferItem>("api/expert/group-offers", payload);
                if (result.Error is not null) { _error = result.Error; return; }
                if (result.Value is not null)
                    _offers = _offers.Where(o => o.Id != result.Value.Id).Prepend(result.Value).ToList();
                _info = "Offre créée.";
            }

            _editId = null;
            ResetForm();
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(OfferItem o)
    {
        if (!await JsConfirm($"Supprimer l'offre « {o.Name} » ?"))
            return;

        try
        {
            var result = await Api.DeleteWithErrorAsync($"api/expert/group-offers/{o.Id}");
            if (result.Error is not null) { _error = result.Error; return; }
            if (_editId == o.Id) CancelEdit();
            _info = "Offre supprimée.";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task PublishAsync(Guid id)
    {
        try
        {
            var result = await Api.PostWithErrorAsync<object>($"api/expert/group-offers/{id}/publish", new { });
            if (result.Error is not null) { _error = result.Error; return; }
            _info = "Offre publiée.";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task OpenAssignAsync(OfferItem o)
    {
        _assignOffer = o;
        _assignTenantId = "";
        _error = null;
        _info = null;
        try
        {
            _assignableTeachers = await Api.GetAsync<List<AssignableTeacher>>("api/expert/group-offers/assignable-teachers") ?? [];
            _assignments = await Api.GetAsync<List<AssignmentItem>>($"api/expert/group-offers/{o.Id}/teachers") ?? [];
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void CloseAssign()
    {
        _assignOffer = null;
        _assignments = [];
        _assignTenantId = "";
    }

    private async Task AssignTeacherAsync()
    {
        if (_assignOffer is null || !Guid.TryParse(_assignTenantId, out var tenantId))
            return;

        _busy = true;
        try
        {
            var result = await Api.PostWithErrorAsync<AssignmentItem>(
                $"api/expert/group-offers/{_assignOffer.Id}/teachers",
                new { teacherTenantId = tenantId, teacherPrice = _assignOffer.RecommendedPrice });
            if (result.Error is not null) { _error = result.Error; return; }
            _info = "Offre affectée — l’enseignant peut programmer son agenda dans Mes offres.";
            _assignTenantId = "";
            _assignments = await Api.GetAsync<List<AssignmentItem>>($"api/expert/group-offers/{_assignOffer.Id}/teachers") ?? [];
            await ReloadAsync();
            _assignOffer = _offers.FirstOrDefault(x => x.Id == _assignOffer.Id) ?? _assignOffer;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task UnassignAsync(AssignmentItem a)
    {
        if (_assignOffer is null) return;
        if (!await JsConfirm($"Retirer « {a.TeacherName} » de cette offre ?"))
            return;

        try
        {
            var result = await Api.DeleteWithErrorAsync(
                $"api/expert/group-offers/{_assignOffer.Id}/teachers/{a.TeacherTenantId}");
            if (result.Error is not null) { _error = result.Error; return; }
            _info = "Affectation retirée.";
            _assignments = await Api.GetAsync<List<AssignmentItem>>($"api/expert/group-offers/{_assignOffer.Id}/teachers") ?? [];
            await ReloadAsync();
            _assignOffer = _offers.FirstOrDefault(x => x.Id == _assignOffer.Id) ?? _assignOffer;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    [Inject] private IJSRuntime Js { get; set; } = default!;

    private async Task<bool> JsConfirm(string message)
    {
        try { return await Js.InvokeAsync<bool>("confirm", message); }
        catch { return true; }
    }

    private static string StatusName(int s) => s switch
    {
        0 => "Draft",
        1 => "UnderReview",
        2 => "Approved",
        3 => "Published",
        4 => "Suspended",
        5 => "Archived",
        _ => s.ToString()
    };

    private sealed record MeContext(bool IsGroupManager, Guid? GroupId, string? GroupName, bool IsPlatformActAs = false);

    private sealed record CatalogDto(
        Guid ExpertGroupId,
        string GroupName,
        string? GroupCountryCode,
        string GroupCurrency,
        bool GroupIsInternational,
        List<OfferItem>? Offers);

    private sealed record OfferItem(
        Guid Id,
        Guid ExpertGroupId,
        string Name,
        string? Code,
        int Status,
        int PricingModel,
        string Currency,
        decimal? RecommendedPrice,
        DateTime CreatedAt,
        DateTime? PublishedAtUtc,
        string? ShortDescription = null,
        bool IsInternational = false,
        string? MarketCountryCode = null,
        int AssignedTeacherCount = 0);

    private sealed record AssignableTeacher(
        Guid TenantId,
        string SchoolName,
        string? OwnerName,
        string? City,
        string? Country);

    private sealed record AssignmentItem(
        Guid Id,
        Guid GroupOfferId,
        Guid TeacherTenantId,
        string TeacherName,
        int AssignmentStatus,
        decimal? TeacherPrice,
        Guid? SubscriptionOfferingId,
        DateTime AssignedAtUtc);
}
