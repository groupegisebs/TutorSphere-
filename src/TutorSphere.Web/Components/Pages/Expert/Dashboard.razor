    private static string MeetingWhen(MeetingItem m)
    {
        if (m.StartAtUtc is not DateTime utc) return "Date à fixer";
        var local = utc.ToLocalTime();
        var day = local.Date == DateTime.Today
            ? "Aujourd'hui"
            : local.Date == DateTime.Today.AddDays(1)
                ? "Demain"
                : local.ToString("d MMMM");
        return $"{day}, {local:HH:mm}";
    }

    /// <summary>Participants au-delà des trois visages affichés.</summary>
    private static int HiddenParticipants(MeetingItem m) =>
        m.ParticipantCount - Math.Min(3, m.ParticipantPreview?.Count ?? 0);

    /// <summary>Ancienneté en clair : sur un tableau de bord, « il y a 2 h » se lit mieux qu'une date.</summary>
    private static string Ago(DateTime createdAtUtc)
    {
        var span = DateTime.UtcNow - createdAtUtc;
        if (span < TimeSpan.FromMinutes(1)) return "à l'instant";
        if (span < TimeSpan.FromHours(1)) return $"il y a {(int)span.TotalMinutes} min";
        if (span < TimeSpan.FromDays(1)) return $"il y a {(int)span.TotalHours} h";
        if (span < TimeSpan.FromDays(2)) return "hier";
        if (span < TimeSpan.FromDays(30)) return $"il y a {(int)span.TotalDays} j";
        return createdAtUtc.ToLocalTime().ToString("d MMM yyyy");
    }

