@page "/expert/dashboard"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<ApplyRequestCulture />

<PageTitle>Tableau de bord Expert — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar ex-toolbar">
            <div>
                <h1 class="ex-page-title">Tableau de bord</h1>
                <p class="ex-page-sub">
                    @if (_summary is not null)
                    {
                        <text>@_summary.GroupName@(string.IsNullOrWhiteSpace(_summary.CountryCode) ? "" : $" · {_summary.CountryCode}") — pilotage pédagogique du groupe.</text>
                    }
                    else
                    {
                        <text>Pilotage pédagogique de votre groupe d'experts.</text>
                    }
                </p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="cc-btn cc-btn-primary btn-sm" href="expert/teachers/add">
                    <i class="bi bi-person-plus" aria-hidden="true"></i> @L["Expert_TeachersNav"]
                </a>
                <a class="cc-btn btn-sm" href="expert/admissions">
                    <i class="bi bi-person-check" aria-hidden="true"></i> Admissions Experts
                </a>
            </div>
        </div>

        @if (_loading)
        {
            <div class="cc-empty"><span class="spinner-border"></span></div>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        else if (_summary is not null)
        {
            <div class="ex-kpi-grid">
                <div class="ex-kpi" data-tone="amber">
                    <i class="bi bi-person-plus ex-kpi-icon" aria-hidden="true"></i>
                    <div>
                        <div class="ex-kpi-value">@_summary.PendingTeacherEnrollments</div>
                        <div class="ex-kpi-label">Inscriptions à valider</div>
                    </div>
                </div>
                <div class="ex-kpi" data-tone="amber">
                    <i class="bi bi-hourglass-split ex-kpi-icon" aria-hidden="true"></i>
                    <div>
                        <div class="ex-kpi-value">@_summary.TeachersPending</div>
                        <div class="ex-kpi-label">En attente</div>
                    </div>
                </div>
                <div class="ex-kpi" data-tone="sky">
                    <i class="bi bi-eye ex-kpi-icon" aria-hidden="true"></i>
                    <div>
                        <div class="ex-kpi-value">@_summary.TeachersUnderReview</div>
                        <div class="ex-kpi-label">En revue</div>
                    </div>
                </div>
                <div class="ex-kpi" data-tone="rose">
                    <i class="bi bi-pencil-square ex-kpi-icon" aria-hidden="true"></i>
                    <div>
                        <div class="ex-kpi-value">@_summary.TeachersChangesRequested</div>
                        <div class="ex-kpi-label">Modifications</div>
                    </div>
                </div>
                <div class="ex-kpi" data-tone="emerald">
                    <i class="bi bi-check2-circle ex-kpi-icon" aria-hidden="true"></i>
                    <div>
                        <div class="ex-kpi-value">@_summary.TeachersApproved</div>
                        <div class="ex-kpi-label">Approuvés</div>
                    </div>
                </div>
                <div class="ex-kpi">
                    <i class="bi bi-hand-thumbs-up ex-kpi-icon" aria-hidden="true"></i>
                    <div>
                        <div class="ex-kpi-value">@_summary.ExpertVotesOpen</div>
                        <div class="ex-kpi-label">Votes ouverts</div>
                    </div>
                </div>
                <div class="ex-kpi">
                    <i class="bi bi-people ex-kpi-icon" aria-hidden="true"></i>
                    <div>
                        <div class="ex-kpi-value">@_summary.ActiveGroupMembers</div>
                        <div class="ex-kpi-label">Membres actifs</div>
                    </div>
                </div>
            </div>

            <div class="ex-panel-grid">
                <div class="ex-panel-col">
                <section class="ex-panel" id="expert-enrollments">
                    <div class="ex-panel-head">
                        <h2 class="ex-panel-title">Inscriptions en attente de l'enseignant</h2>
                        <span class="ex-panel-meta">@_enrollments.Count demande(s)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(_enrollError))
                    {
                        <div class="alert alert-danger py-2 px-3">@_enrollError</div>
                    }
                    @if (!string.IsNullOrEmpty(_enrollBanner))
                    {
                        <div class="alert alert-success py-2 px-3">@_enrollBanner</div>
                    }
                    @if (_enrollments.Count == 0)
                    {
                        <div class="ex-empty">
                            <i class="bi bi-person-check" aria-hidden="true"></i>
                            <strong>Aucune demande en attente</strong>
                            <span>Les souscriptions à valider par un enseignant du groupe apparaîtront ici. Vous pouvez les accepter à sa place.</span>
                        </div>
                    }
                    else
                    {
                        <div class="ex-alert-list">
                            @foreach (var item in _enrollments)
                            {
                                <div class="ex-alert-item warning">
                                    <span class="ex-alert-dot" aria-hidden="true"></span>
                                    <div class="ex-alert-msg">
                                        <strong>@item.StudentName</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.ParentName))
                                        {
                                            <span> · parent @item.ParentName</span>
                                        }
                                        <div class="small text-muted">
                                            Cours « @item.OfferingTitle » chez <strong>@item.TeacherName</strong>
                                            · @item.Price.ToString("N2") @item.Currency
                                            · @item.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <button type="button" class="cc-btn cc-btn-primary btn-sm"
                                                disabled="@(_busyEnrollmentId == item.Id)"
                                                @onclick="() => DecideEnrollmentAsync(item.Id, true)">
                                            Accepter
                                        </button>
                                        <button type="button" class="cc-btn btn-sm"
                                                disabled="@(_busyEnrollmentId == item.Id)"
                                                @onclick="() => DecideEnrollmentAsync(item.Id, false)">
                                            Refuser
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>

                <section class="ex-panel">
                    <div class="ex-panel-head">
                        <h2 class="ex-panel-title">Alertes</h2>
                        <span class="ex-panel-meta">@_summary.Alerts.Count signalement(s)</span>
                    </div>
                    @if (_summary.Alerts.Count == 0)
                    {
                        <div class="ex-empty">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            <strong>Tout est calme</strong>
                            <span>Aucune alerte pour le moment.</span>
                        </div>
                    }
                    else
                    {
                        <div class="ex-alert-list">
                            @foreach (var alert in _summary.Alerts)
                            {
                                <div class="ex-alert-item @alert.Severity">
                                    <span class="ex-alert-dot" aria-hidden="true"></span>
                                    <div class="ex-alert-msg">@alert.Message</div>
                                    @if (!string.IsNullOrWhiteSpace(alert.ActionUrl) || alert.Code == "pending_enrollments")
                                    {
                                        <button type="button" class="cc-btn btn-sm" @onclick="() => OpenAlertAsync(alert)">Ouvrir</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>

                @if (_isManager)
                {
                    <section class="ex-panel">
                        <div class="ex-panel-head">
                            <h2 class="ex-panel-title"><i class="bi bi-camera-video" aria-hidden="true"></i> Réunions</h2>
                            <a class="cc-btn btn-sm" href="expert/meetings">Voir tout</a>
                        </div>
                        @if (_meetings.Count == 0)
                        {
                            <div class="ex-empty">
                                <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                                <strong>Aucune réunion programmée</strong>
                                <span>Planifiez une rencontre avec les membres du groupe.</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var m in _meetings)
                            {
                                <div class="ex-meet-item">
                                    <span class="ex-page-icon" style="width:2.1rem;height:2.1rem;font-size:0.95rem"><i class="bi bi-camera-video"></i></span>
                                    <div style="flex:1;min-width:0">
                                        <strong>@m.Title</strong>
                                        <small>@StatusFr(m.Status) · @(m.StartAtUtc?.ToLocalTime().ToString("g") ?? "Brouillon")</small>
                                    </div>
                                    @if (m.Status is 1 or 2)
                                    {
                                        <a class="cc-btn cc-btn-primary btn-sm" href="@($"expert/meetings/{m.Id}/room")">Rejoindre</a>
                                    }
                                    else if (m.Status == 3)
                                    {
                                        <a class="cc-btn btn-sm" href="@($"expert/meetings/{m.Id}/minutes")">Compte rendu</a>
                                    }
                                </div>
                            }
                        }
                        <div class="d-flex gap-2 mt-2 flex-wrap">
                            <a class="cc-btn cc-btn-primary btn-sm" href="expert/meetings/create">
                                <i class="bi bi-plus-lg"></i> Créer une réunion
                            </a>
                            <a class="cc-btn btn-sm" href="expert/meetings">Toutes les réunions</a>
                        </div>
                    </section>
                }
                </div>

                <section class="ex-panel">
                    <div class="ex-panel-head">
                        <h2 class="ex-panel-title">Actions rapides</h2>
                        <span class="ex-panel-meta">Raccourcis</span>
                    </div>
                    <div class="ex-action-stack">
                        @if (_summary.NextPendingTenantId is Guid nextTid)
                        {
                            <a class="ex-action is-primary" href="@($"expert/teachers/{nextTid}")">
                                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                                <span>Revoir le prochain dossier</span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        }
                        else
                        {
                            <a class="ex-action is-primary" href="expert/approvals?tab=queue">
                                <i class="bi bi-inbox" aria-hidden="true"></i>
                                <span>Ouvrir les dossiers en revue</span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        }
                        <a class="ex-action" href="expert/teachers/add">
                            <i class="bi bi-person-plus" aria-hidden="true"></i>
                            <span>@L["Expert_PathCreateTitle"]</span>
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                        <a class="ex-action" href="expert/approvals?tab=invite">
                            <i class="bi bi-envelope" aria-hidden="true"></i>
                            <span>@L["Expert_PathInviteTitle"]</span>
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                        <a class="ex-action" href="expert/admissions">
                            <i class="bi bi-person-check" aria-hidden="true"></i>
                            <span>@(_summary.NextOpenExpertVoteId is not null ? "Voter sur une candidature" : "Admissions Experts")</span>
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                        <a class="ex-action" href="expert/disciplines">
                            <i class="bi bi-book" aria-hidden="true"></i>
                            <span>Gérer les disciplines</span>
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                        <a class="ex-action" href="expert/teachers">
                            <i class="bi bi-mortarboard" aria-hidden="true"></i>
                            <span>Enseignants approuvés</span>
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </a>
                        @if (_isManager)
                        {
                            <a class="ex-action" href="expert/meetings/create">
                                <i class="bi bi-camera-video" aria-hidden="true"></i>
                                <span>Créer une réunion</span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                            <a class="ex-action" href="expert/meetings">
                                <i class="bi bi-calendar-event" aria-hidden="true"></i>
                                <span>Réunions du groupe</span>
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        }
                    </div>

                    <div class="ex-stat-grid">
                        <div class="ex-stat">
                            <span class="ex-stat-val">@_summary.TeacherInvitesSent</span>
                            <span class="ex-stat-lbl">Invitations enseignants</span>
                        </div>
                        <div class="ex-stat">
                            <span class="ex-stat-val">@_summary.ExpertInvitesPending</span>
                            <span class="ex-stat-lbl">Invitations Expert en attente</span>
                        </div>
                        <div class="ex-stat">
                            <span class="ex-stat-val">@_summary.DisciplinesWithoutTeacher</span>
                            <span class="ex-stat-lbl">Disciplines sans enseignant</span>
                        </div>
                        <div class="ex-stat">
                            <span class="ex-stat-val">@_summary.TeachersInactive</span>
                            <span class="ex-stat-lbl">Inactifs (45 j)</span>
                        </div>
                        <div class="ex-stat">
                            <span class="ex-stat-val">@_summary.UnreadRemarksForTeachers</span>
                            <span class="ex-stat-lbl">Remarques non lues</span>
                        </div>
                        <div class="ex-stat">
                            <span class="ex-stat-val">@_summary.CancelledLessonsRecent</span>
                            <span class="ex-stat-lbl">Cours annulés (30 j)</span>
                        </div>
                        @if (_summary.TeachersSuspended > 0)
                        {
                            <div class="ex-stat">
                                <span class="ex-stat-val">@_summary.TeachersSuspended</span>
                                <span class="ex-stat-lbl">Suspendus</span>
                            </div>
                        }
                    </div>
                </section>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="cc-card cc-empty">
            <p>@L["Expert_LoginRequired"]</p>
            <a class="cc-btn cc-btn-primary" href="/login/expert">@L["Nav_Login"]</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _loading = true;
    private string? _error;
    private bool _isManager;
    private DashboardSummary? _summary;
    private readonly List<MeetingItem> _meetings = [];
    private List<ExpertPendingEnrollmentDto> _enrollments = [];
    private Guid? _busyEnrollmentId;
    private string? _enrollError;
    private string? _enrollBanner;

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        try
        {
            try
            {
                var ctx = await Api.GetAsync<MeContext>("api/expert/me-context");
                _isManager = ctx?.IsGroupManager == true || Auth.IsActingAsGroupAdmin;
            }
            catch { }

            _summary = await Api.GetAsync<DashboardSummary>("api/expert/dashboard-summary");
            if (_summary is null)
                _error = "Impossible de charger le tableau de bord.";

            try
            {
                _enrollments = await Api.GetAsync<List<ExpertPendingEnrollmentDto>>("api/expert/enrollments/pending") ?? [];
            }
            catch
            {
                _enrollments = [];
            }

            if (_isManager)
            {
                var list = await Api.GetAsync<List<MeetingItem>>("api/expert/meetings") ?? [];
                _meetings.AddRange(list.Where(m => m.Status is not 4).Take(4));
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private async Task OpenAlertAsync(DashboardAlert alert)
    {
        var url = alert.ActionUrl ?? "";
        var enrollments = string.Equals(alert.Code, "pending_enrollments", StringComparison.OrdinalIgnoreCase)
            || url.Contains("#expert-enrollments", StringComparison.OrdinalIgnoreCase);

        if (enrollments)
        {
            try
            {
                await JS.InvokeVoidAsync("tsScrollToId", "expert-enrollments");
            }
            catch
            {
                Nav.NavigateTo("expert/dashboard");
            }
            return;
        }

        var path = url.Trim();
        var hash = path.IndexOf('#');
        if (hash >= 0)
            path = path[..hash];
        path = path.TrimStart('/');
        if (!string.IsNullOrEmpty(path))
            Nav.NavigateTo(path);
    }

    private async Task DecideEnrollmentAsync(Guid id, bool accept)
    {
        _busyEnrollmentId = id;
        _enrollError = null;
        _enrollBanner = null;
        try
        {
            var action = accept ? "accept" : "reject";
            var result = await Api.PostWithErrorAsync<ExpertPendingEnrollmentDto>(
                $"api/expert/enrollments/{id}/{action}", new { });
            if (result.Error is not null)
            {
                _enrollError = result.Error;
                return;
            }

            _enrollBanner = accept
                ? "Inscription acceptée. L'enseignant a été averti (e-mail et remarque)."
                : "Inscription refusée. L'enseignant a été averti.";
            _enrollments = await Api.GetAsync<List<ExpertPendingEnrollmentDto>>("api/expert/enrollments/pending") ?? [];
            _summary = await Api.GetAsync<DashboardSummary>("api/expert/dashboard-summary") ?? _summary;
        }
        finally { _busyEnrollmentId = null; }
    }

    private static string StatusFr(int s) => s switch
    {
        0 => "Brouillon",
        1 => "Programmée",
        2 => "En cours",
        3 => "Terminée",
        _ => "—"
    };

    private sealed record MeContext(bool IsGroupManager, Guid? GroupId, string? GroupName);
    private sealed class MeetingItem
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public int Status { get; set; }
        public DateTime? StartAtUtc { get; set; }
    }

    private sealed record DashboardAlert(string Severity, string Code, string Message, string? ActionUrl);

    private sealed record DashboardSummary(
        string GroupName,
        string? CountryCode,
        int TeachersPending,
        int TeachersUnderReview,
        int TeachersChangesRequested,
        int TeachersApproved,
        int TeachersSuspended,
        int ExpertVotesOpen,
        int ExpertInvitesPending,
        int TeacherInvitesSent,
        int UnreadRemarksForTeachers,
        int CancelledLessonsRecent,
        int DisciplinesWithoutTeacher,
        int TeachersInactive,
        int ActiveGroupMembers,
        Guid? NextPendingTenantId,
        Guid? NextOpenExpertVoteId,
        List<DashboardAlert> Alerts,
        int PendingTeacherEnrollments = 0);
}
