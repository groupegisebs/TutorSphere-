    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split([' ', '@'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}"
            : parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
    }

    /// <summary>Couleur stable déduite du nom : le même membre garde son pastille d'un écran à l'autre.</summary>
    private static string AvatarBg(string? name)
    {
        string[] palette = ["#5b5bd6", "#0f9d78", "#d97706", "#db2777", "#0891b2", "#7c3aed"];
        var hash = 0;
        foreach (var c in name ?? "") hash = ((hash * 31) + c) & 0x7fffffff;
        return palette[hash % palette.Length];
    }

