@page "/expert/dashboard"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService Auth
@inject ApiClient Api
@inject IStringLocalizer<SharedResources> L

<ApplyRequestCulture />

<PageTitle>Tableau de bord Expert — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">Tableau de bord</h1>
                <p class="cc-page-sub">
                    @if (_summary is not null)
                    {
                        <text>@_summary.GroupName@(string.IsNullOrWhiteSpace(_summary.CountryCode) ? "" : $" · {_summary.CountryCode}") — pilotage pédagogique du groupe.</text>
                    }
                    else
                    {
                        <text>Pilotage pédagogique de votre groupe d'experts.</text>
                    }
                </p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="cc-btn cc-btn-primary btn-sm" href="expert/approvals">File d'attente</a>
                <a class="cc-btn btn-sm" href="expert/admissions">Admissions Experts</a>
            </div>
        </div>

        @if (_loading)
        {
            <div class="cc-empty"><span class="spinner-border"></span></div>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        else if (_summary is not null)
        {
            <div class="cc-kpi-grid mb-3">
                <div class="cc-kpi">
                    <div class="cc-kpi-label">En attente</div>
                    <div class="cc-kpi-value">@_summary.TeachersPending</div>
                </div>
                <div class="cc-kpi">
                    <div class="cc-kpi-label">En revue</div>
                    <div class="cc-kpi-value">@_summary.TeachersUnderReview</div>
                </div>
                <div class="cc-kpi">
                    <div class="cc-kpi-label">Modifications demandées</div>
                    <div class="cc-kpi-value">@_summary.TeachersChangesRequested</div>
                </div>
                <div class="cc-kpi">
                    <div class="cc-kpi-label">Approuvés</div>
                    <div class="cc-kpi-value">@_summary.TeachersApproved</div>
                </div>
                <div class="cc-kpi">
                    <div class="cc-kpi-label">Votes Expert ouverts</div>
                    <div class="cc-kpi-value">@_summary.ExpertVotesOpen</div>
                </div>
                <div class="cc-kpi">
                    <div class="cc-kpi-label">Membres actifs</div>
                    <div class="cc-kpi-value">@_summary.ActiveGroupMembers</div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-lg-7">
                    <div class="cc-card h-100">
                        <h2 class="cc-card-title">Alertes</h2>
                        @if (_summary.Alerts.Count == 0)
                        {
                            <p class="small text-muted mb-0">Aucune alerte pour le moment.</p>
                        }
                        else
                        {
                            <div class="cc-alert-list">
                                @foreach (var alert in _summary.Alerts)
                                {
                                    <div class="cc-alert-item @alert.Severity">
                                        <div class="flex-grow-1">@alert.Message</div>
                                        @if (!string.IsNullOrWhiteSpace(alert.ActionUrl))
                                        {
                                            <a class="cc-btn btn-sm" href="@alert.ActionUrl.TrimStart('/')">Ouvrir</a>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="cc-card h-100">
                        <h2 class="cc-card-title">Actions rapides</h2>
                        <div class="d-grid gap-2">
                            @if (_summary.NextPendingTenantId is Guid nextTid)
                            {
                                <a class="cc-btn cc-btn-primary" href="@($"expert/teachers/{nextTid}")">
                                    Revoir le prochain dossier
                                </a>
                            }
                            else
                            {
                                <a class="cc-btn cc-btn-primary" href="expert/approvals">Ouvrir la file d'attente</a>
                            }
                            <a class="cc-btn" href="expert/approvals">Inviter / enregistrer un enseignant</a>
                            @if (_summary.NextOpenExpertVoteId is not null)
                            {
                                <a class="cc-btn" href="expert/admissions">Voter sur une candidature Expert</a>
                            }
                            else
                            {
                                <a class="cc-btn" href="expert/admissions">Admissions Experts</a>
                            }
                            <a class="cc-btn" href="expert/disciplines">Gérer les disciplines</a>
                            <a class="cc-btn" href="expert/teachers">Enseignants approuvés</a>
                        </div>
                        <hr class="my-3" />
                        <div class="small text-muted">
                            <div>Invitations enseignants envoyées : @_summary.TeacherInvitesSent</div>
                            <div>Invitations Expert en attente : @_summary.ExpertInvitesPending</div>
                            <div>Remarques non lues : @_summary.UnreadRemarksForTeachers</div>
                            <div>Cours annulés (30 j) : @_summary.CancelledLessonsRecent</div>
                            <div>Disciplines sans enseignant : @_summary.DisciplinesWithoutTeacher</div>
                            <div>Enseignants inactifs (45 j) : @_summary.TeachersInactive</div>
                            @if (_summary.TeachersSuspended > 0)
                            {
                                <div>Suspendus : @_summary.TeachersSuspended</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="cc-card cc-empty">
            <p>@L["Expert_LoginRequired"]</p>
            <a class="cc-btn cc-btn-primary" href="/login/expert">@L["Nav_Login"]</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _loading = true;
    private string? _error;
    private DashboardSummary? _summary;

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        try
        {
            _summary = await Api.GetAsync<DashboardSummary>("api/expert/dashboard-summary");
            if (_summary is null)
                _error = "Impossible de charger le tableau de bord.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private sealed record DashboardAlert(string Severity, string Code, string Message, string? ActionUrl);

    private sealed record DashboardSummary(
        string GroupName,
        string? CountryCode,
        int TeachersPending,
        int TeachersUnderReview,
        int TeachersChangesRequested,
        int TeachersApproved,
        int TeachersSuspended,
        int ExpertVotesOpen,
        int ExpertInvitesPending,
        int TeacherInvitesSent,
        int UnreadRemarksForTeachers,
        int CancelledLessonsRecent,
        int DisciplinesWithoutTeacher,
        int TeachersInactive,
        int ActiveGroupMembers,
        Guid? NextPendingTenantId,
        Guid? NextOpenExpertVoteId,
        List<DashboardAlert> Alerts);
}
