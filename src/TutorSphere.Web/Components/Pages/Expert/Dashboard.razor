@page "/expert/dashboard"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<ApplyRequestCulture />

<PageTitle>Tableau de bord Expert — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="th-head">
            <div>
                <h1 class="th-greeting">Tableau de bord</h1>
                <p class="th-subtitle">
                    @if (_summary is not null)
                    {
                        <text>@_summary.GroupName@(string.IsNullOrWhiteSpace(_summary.CountryCode) ? "" : $" · {_summary.CountryCode}") — pilotage pédagogique du groupe.</text>
                    }
                    else
                    {
                        <text>Pilotage pédagogique de votre groupe d'experts.</text>
                    }
                </p>
            </div>
            <div class="th-head-actions">
                <a class="btn btn-primary" href="expert/teachers/add">
                    <i class="bi bi-person-plus me-1" aria-hidden="true"></i>@L["Expert_TeachersNav"]
                </a>
                <a class="btn btn-outline-secondary" href="expert/admissions">
                    <i class="bi bi-person-check me-1" aria-hidden="true"></i>Admissions Experts
                </a>
            </div>
        </div>

        @if (_loading)
        {
            <div class="th-hero">
                <div class="th-hero-main">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="text-muted">@L["Common_Loading"]</span>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        else if (_summary is not null)
        {
            <div class="th-hero">
                <div class="th-hero-main">
                    <div class="th-hero-icon"><i class="bi bi-folder2-open" aria-hidden="true"></i></div>
                    <div>
                        <span class="th-badge @(ReviewQueue > 0 ? null : "th-badge--muted")">Dossiers enseignants</span>
                        <h2 class="th-hero-title">
                            @(ReviewQueue > 0
                                ? $"{ReviewQueue} dossier(s) à traiter"
                                : "Aucun dossier en attente")
                        </h2>
                        <p class="th-hero-text">
                            @(ReviewQueue > 0
                                ? $"{_summary.TeachersPending} en attente · {_summary.TeachersUnderReview} en revue · {_summary.TeachersChangesRequested} à corriger."
                                : "Les dossiers du groupe sont à jour.")
                        </p>
                    </div>
                </div>
                <div class="th-hero-actions">
                    @if (_summary.NextPendingTenantId is Guid nextTid)
                    {
                        <a class="btn btn-primary" href="@($"expert/teachers/{nextTid}")">Revoir le prochain dossier</a>
                    }
                    else
                    {
                        <a class="btn btn-primary" href="expert/approvals?tab=queue">Ouvrir les dossiers en revue</a>
                    }
                    <a class="btn btn-outline-secondary" href="expert/teachers">Enseignants approuvés</a>
                </div>
            </div>

            <div class="th-kpis">
                <div class="th-kpi">
                    <div class="th-kpi-icon th-kpi-icon--amber"><i class="bi bi-person-plus" aria-hidden="true"></i></div>
                    <div class="th-kpi-body">
                        <span class="th-kpi-label">Inscriptions à valider</span>
                        <span class="th-kpi-val">@_summary.PendingTeacherEnrollments</span>
                        @if (_enrollments.Count > 0)
                        {
                            <button type="button" class="th-link th-link--btn" @onclick="ScrollToEnrollmentsAsync">
                                Voir <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                </div>
                <div class="th-kpi">
                    <div class="th-kpi-icon th-kpi-icon--amber"><i class="bi bi-hourglass-split" aria-hidden="true"></i></div>
                    <div class="th-kpi-body">
                        <span class="th-kpi-label">En attente</span>
                        <span class="th-kpi-val">@_summary.TeachersPending</span>
                        @if (_summary.TeachersPending > 0)
                        {
                            <a class="th-link" href="expert/approvals?tab=queue">Voir <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        }
                    </div>
                </div>
                <div class="th-kpi">
                    <div class="th-kpi-icon th-kpi-icon--sky"><i class="bi bi-eye" aria-hidden="true"></i></div>
                    <div class="th-kpi-body">
                        <span class="th-kpi-label">En revue</span>
                        <span class="th-kpi-val">@_summary.TeachersUnderReview</span>
                        @if (_summary.TeachersUnderReview > 0)
                        {
                            <a class="th-link" href="expert/approvals?tab=queue">Voir <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        }
                    </div>
                </div>
                <div class="th-kpi">
                    <div class="th-kpi-icon th-kpi-icon--rose"><i class="bi bi-pencil-square" aria-hidden="true"></i></div>
                    <div class="th-kpi-body">
                        <span class="th-kpi-label">Modifications</span>
                        <span class="th-kpi-val">@_summary.TeachersChangesRequested</span>
                        @if (_summary.TeachersChangesRequested > 0)
                        {
                            <a class="th-link" href="expert/approvals?tab=queue">Voir <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        }
                    </div>
                </div>
                <div class="th-kpi">
                    <div class="th-kpi-icon th-kpi-icon--green"><i class="bi bi-check2-circle" aria-hidden="true"></i></div>
                    <div class="th-kpi-body">
                        <span class="th-kpi-label">Approuvés</span>
                        <span class="th-kpi-val">@_summary.TeachersApproved</span>
                        @if (_summary.TeachersApproved > 0)
                        {
                            <a class="th-link" href="expert/teachers">Voir <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        }
                    </div>
                </div>
                <div class="th-kpi">
                    <div class="th-kpi-icon th-kpi-icon--violet"><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i></div>
                    <div class="th-kpi-body">
                        <span class="th-kpi-label">Votes ouverts</span>
                        <span class="th-kpi-val">@_summary.ExpertVotesOpen</span>
                        @if (_summary.ExpertVotesOpen > 0)
                        {
                            <a class="th-link" href="expert/admissions">Voir <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        }
                    </div>
                </div>
                <div class="th-kpi">
                    <div class="th-kpi-icon th-kpi-icon--mint"><i class="bi bi-people" aria-hidden="true"></i></div>
                    <div class="th-kpi-body">
                        <span class="th-kpi-label">Membres actifs</span>
                        <span class="th-kpi-val">@_summary.ActiveGroupMembers</span>
                        <a class="th-link" href="expert/members">Voir <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </div>
            </div>

            <div class="th-grid">
                <section class="th-card th-card--half" id="expert-enrollments">
                    <div class="th-card-head">
                        <h2>Inscriptions en attente de l'enseignant</h2>
                        <span class="th-card-meta">@_enrollments.Count demande(s)</span>
                    </div>
                    <div class="th-card-body">
                        @if (!string.IsNullOrEmpty(_enrollError))
                        {
                            <div class="alert alert-danger py-2 px-3">@_enrollError</div>
                        }
                        @if (!string.IsNullOrEmpty(_enrollBanner))
                        {
                            <div class="alert alert-success py-2 px-3">@_enrollBanner</div>
                        }
                        @if (_enrollments.Count == 0)
                        {
                            <div class="th-msg-empty">
                                <span class="th-msg-empty-icon"><i class="bi bi-person-check" aria-hidden="true"></i></span>
                                <div>
                                    <strong>Aucune demande en attente</strong>
                                    <span class="th-setup-text">
                                        Les souscriptions à valider par un enseignant du groupe apparaîtront ici.
                                        Vous pouvez les accepter à sa place.
                                    </span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <ul class="th-people">
                                @foreach (var item in _enrollments)
                                {
                                    <li class="th-person th-person--wrap">
                                        <span class="th-avatar th-avatar--@HueOf(item.StudentName)">@InitialsOf(item.StudentName)</span>
                                        <div class="th-person-body">
                                            <strong>
                                                @item.StudentName
                                                @if (!string.IsNullOrWhiteSpace(item.ParentName))
                                                {
                                                    <text> · parent @item.ParentName</text>
                                                }
                                            </strong>
                                            <span>
                                                Cours « @item.OfferingTitle » chez @item.TeacherName
                                                · @item.Price.ToString("N2") @item.Currency
                                                · @item.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        </div>
                                        <div class="th-person-actions">
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    disabled="@(_busyEnrollmentId == item.Id)"
                                                    @onclick="() => DecideEnrollmentAsync(item.Id, true)">
                                                Accepter
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    disabled="@(_busyEnrollmentId == item.Id)"
                                                    @onclick="() => DecideEnrollmentAsync(item.Id, false)">
                                                Refuser
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </section>

                <section class="th-card th-card--half">
                    <div class="th-card-head">
                        <h2>Actions rapides</h2>
                        <span class="th-card-meta">Raccourcis</span>
                    </div>
                    <div class="th-card-body">
                        <ul class="th-quick">
                            <li>
                                <a href="@(_summary.NextPendingTenantId is Guid tid ? $"expert/teachers/{tid}" : "expert/approvals?tab=queue")">
                                    <span class="th-kpi-icon th-kpi-icon--violet"><i class="bi bi-inbox" aria-hidden="true"></i></span>
                                    <span class="th-quick-label">
                                        @(_summary.NextPendingTenantId is not null ? "Revoir le prochain dossier" : "Ouvrir les dossiers en revue")
                                    </span>
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </li>
                            <li>
                                <a href="expert/teachers/add">
                                    <span class="th-kpi-icon th-kpi-icon--green"><i class="bi bi-person-plus" aria-hidden="true"></i></span>
                                    <span class="th-quick-label">@L["Expert_PathCreateTitle"]</span>
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </li>
                            <li>
                                <a href="expert/approvals?tab=invite">
                                    <span class="th-kpi-icon th-kpi-icon--sky"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                                    <span class="th-quick-label">@L["Expert_PathInviteTitle"]</span>
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </li>
                            <li>
                                <a href="expert/admissions">
                                    <span class="th-kpi-icon th-kpi-icon--pink"><i class="bi bi-person-check" aria-hidden="true"></i></span>
                                    <span class="th-quick-label">
                                        @(_summary.NextOpenExpertVoteId is not null ? "Voter sur une candidature" : "Admissions Experts")
                                    </span>
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </li>
                            <li>
                                <a href="expert/disciplines">
                                    <span class="th-kpi-icon th-kpi-icon--amber"><i class="bi bi-book" aria-hidden="true"></i></span>
                                    <span class="th-quick-label">Gérer les disciplines</span>
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </li>
                            <li>
                                <a href="expert/teachers">
                                    <span class="th-kpi-icon th-kpi-icon--mint"><i class="bi bi-mortarboard" aria-hidden="true"></i></span>
                                    <span class="th-quick-label">Enseignants approuvés</span>
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </li>
                            @if (_isManager)
                            {
                                <li>
                                    <a href="expert/meetings/create">
                                        <span class="th-kpi-icon th-kpi-icon--violet"><i class="bi bi-camera-video" aria-hidden="true"></i></span>
                                        <span class="th-quick-label">Créer une réunion</span>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="expert/meetings">
                                        <span class="th-kpi-icon th-kpi-icon--sky"><i class="bi bi-calendar-event" aria-hidden="true"></i></span>
                                        <span class="th-quick-label">Réunions du groupe</span>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </section>

                <section class="th-card th-card--half">
                    <div class="th-card-head">
                        <h2>Alertes</h2>
                        <span class="th-card-meta">@_summary.Alerts.Count signalement(s)</span>
                    </div>
                    <div class="th-card-body">
                        @if (_summary.Alerts.Count == 0)
                        {
                            <div class="th-msg-empty">
                                <span class="th-msg-empty-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                                <div>
                                    <strong>Tout est calme</strong>
                                    <span class="th-setup-text">Aucune alerte pour le moment.</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <ul class="th-alerts">
                                @foreach (var alert in _summary.Alerts)
                                {
                                    <li class="th-alert th-alert--@AlertTone(alert.Severity)">
                                        <span class="th-alert-dot" aria-hidden="true"></span>
                                        <span class="th-alert-msg">@alert.Message</span>
                                        @if (!string.IsNullOrWhiteSpace(alert.ActionUrl) || alert.Code == "pending_enrollments")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => OpenAlertAsync(alert)">
                                                Ouvrir
                                            </button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </section>

                <section class="th-card th-card--half">
                    <div class="th-card-head">
                        <h2>Indicateurs du groupe</h2>
                    </div>
                    <div class="th-card-body">
                        <div class="th-stats">
                            <div class="th-stat">
                                <span class="th-stat-val">@_summary.TeacherInvitesSent</span>
                                <span class="th-stat-lbl">Invitations enseignants</span>
                            </div>
                            <div class="th-stat">
                                <span class="th-stat-val">@_summary.ExpertInvitesPending</span>
                                <span class="th-stat-lbl">Invitations Expert en attente</span>
                            </div>
                            <div class="th-stat">
                                <span class="th-stat-val">@_summary.DisciplinesWithoutTeacher</span>
                                <span class="th-stat-lbl">Disciplines sans enseignant</span>
                            </div>
                            <div class="th-stat">
                                <span class="th-stat-val">@_summary.TeachersInactive</span>
                                <span class="th-stat-lbl">Inactifs (45 j)</span>
                            </div>
                            <div class="th-stat">
                                <span class="th-stat-val">@_summary.UnreadRemarksForTeachers</span>
                                <span class="th-stat-lbl">Remarques non lues</span>
                            </div>
                            <div class="th-stat">
                                <span class="th-stat-val">@_summary.CancelledLessonsRecent</span>
                                <span class="th-stat-lbl">Cours annulés (30 j)</span>
                            </div>
                            @if (_summary.TeachersSuspended > 0)
                            {
                                <div class="th-stat">
                                    <span class="th-stat-val">@_summary.TeachersSuspended</span>
                                    <span class="th-stat-lbl">Suspendus</span>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                @if (_isManager)
                {
                    <section class="th-card th-card--full">
                        <div class="th-card-head">
                            <h2><i class="bi bi-camera-video me-2" aria-hidden="true"></i>Réunions</h2>
                            <a class="th-link" href="expert/meetings">Voir tout <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                        </div>
                        <div class="th-card-body">
                            @if (_meetings.Count == 0)
                            {
                                <div class="th-msg-empty">
                                    <span class="th-msg-empty-icon"><i class="bi bi-calendar-plus" aria-hidden="true"></i></span>
                                    <div>
                                        <strong>Aucune réunion programmée</strong>
                                        <span class="th-setup-text">Planifiez une rencontre avec les membres du groupe.</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <ul class="th-people">
                                    @foreach (var m in _meetings)
                                    {
                                        <li class="th-person">
                                            <span class="th-kpi-icon th-kpi-icon--violet"><i class="bi bi-camera-video" aria-hidden="true"></i></span>
                                            <div class="th-person-body">
                                                <strong>@m.Title</strong>
                                                <span>@StatusFr(m.Status) · @(m.StartAtUtc?.ToLocalTime().ToString("g") ?? "Brouillon")</span>
                                            </div>
                                            @if (m.Status is 1 or 2)
                                            {
                                                <a class="btn btn-sm btn-primary" href="@($"expert/meetings/{m.Id}/room")">Rejoindre</a>
                                            }
                                            else if (m.Status == 3)
                                            {
                                                <a class="btn btn-sm btn-outline-secondary" href="@($"expert/meetings/{m.Id}/minutes")">Compte rendu</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <div class="th-card-foot th-card-foot--actions">
                            <a class="btn btn-sm btn-primary" href="expert/meetings/create">
                                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Créer une réunion
                            </a>
                            <a class="btn btn-sm btn-outline-secondary" href="expert/meetings">Toutes les réunions</a>
                        </div>
                    </section>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="th-card">
            <div class="th-card-body">
                <p>@L["Expert_LoginRequired"]</p>
                <a class="btn btn-primary" href="/login/expert">@L["Nav_Login"]</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _loading = true;
    private string? _error;
    private bool _isManager;
    private DashboardSummary? _summary;
    private readonly List<MeetingItem> _meetings = [];
    private List<ExpertPendingEnrollmentDto> _enrollments = [];
    private Guid? _busyEnrollmentId;
    private string? _enrollError;
    private string? _enrollBanner;

    private int ReviewQueue => _summary is null
        ? 0
        : _summary.TeachersPending + _summary.TeachersUnderReview + _summary.TeachersChangesRequested;

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        try
        {
            try
            {
                var ctx = await Api.GetAsync<MeContext>("api/expert/me-context");
                _isManager = ctx?.IsGroupManager == true || Auth.IsActingAsGroupAdmin;
            }
            catch { }

            _summary = await Api.GetAsync<DashboardSummary>("api/expert/dashboard-summary");
            if (_summary is null)
                _error = "Impossible de charger le tableau de bord.";

            try
            {
                _enrollments = await Api.GetAsync<List<ExpertPendingEnrollmentDto>>("api/expert/enrollments/pending") ?? [];
            }
            catch
            {
                _enrollments = [];
            }

            if (_isManager)
            {
                var list = await Api.GetAsync<List<MeetingItem>>("api/expert/meetings") ?? [];
                _meetings.AddRange(list.Where(m => m.Status is not 4).Take(4));
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private async Task ScrollToEnrollmentsAsync()
    {
        try { await JS.InvokeVoidAsync("tsScrollToId", "expert-enrollments"); }
        catch { /* la carte est déjà visible */ }
    }

    private async Task OpenAlertAsync(DashboardAlert alert)
    {
        var url = alert.ActionUrl ?? "";
        var enrollments = string.Equals(alert.Code, "pending_enrollments", StringComparison.OrdinalIgnoreCase)
            || url.Contains("#expert-enrollments", StringComparison.OrdinalIgnoreCase);

        if (enrollments)
        {
            await ScrollToEnrollmentsAsync();
            return;
        }

        var path = url.Trim();
        var hash = path.IndexOf('#');
        if (hash >= 0)
            path = path[..hash];
        path = path.TrimStart('/');
        if (!string.IsNullOrEmpty(path))
            Nav.NavigateTo(path);
    }

    private async Task DecideEnrollmentAsync(Guid id, bool accept)
    {
        _busyEnrollmentId = id;
        _enrollError = null;
        _enrollBanner = null;
        try
        {
            var action = accept ? "accept" : "reject";
            var result = await Api.PostWithErrorAsync<ExpertPendingEnrollmentDto>(
                $"api/expert/enrollments/{id}/{action}", new { });
            if (result.Error is not null)
            {
                _enrollError = result.Error;
                return;
            }

            _enrollBanner = accept
                ? "Inscription acceptée. L'enseignant a été averti (e-mail et remarque)."
                : "Inscription refusée. L'enseignant a été averti.";
            _enrollments = await Api.GetAsync<List<ExpertPendingEnrollmentDto>>("api/expert/enrollments/pending") ?? [];
            _summary = await Api.GetAsync<DashboardSummary>("api/expert/dashboard-summary") ?? _summary;
        }
        finally { _busyEnrollmentId = null; }
    }

    private static string AlertTone(string? severity) => severity?.ToLowerInvariant() switch
    {
        "danger" => "danger",
        "warning" => "warning",
        _ => "info"
    };

    private static int HueOf(string? value) =>
        string.IsNullOrEmpty(value) ? 0 : Math.Abs(value.Sum(c => c)) % 5;

    private static string InitialsOf(string? name) =>
        string.IsNullOrWhiteSpace(name)
            ? "?"
            : string.Concat(name
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(p => char.ToUpperInvariant(p[0])));

    private static string StatusFr(int s) => s switch
    {
        0 => "Brouillon",
        1 => "Programmée",
        2 => "En cours",
        3 => "Terminée",
        _ => "—"
    };

    private sealed record MeContext(bool IsGroupManager, Guid? GroupId, string? GroupName);
    private sealed class MeetingItem
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public int Status { get; set; }
        public DateTime? StartAtUtc { get; set; }
    }

    private sealed record DashboardAlert(string Severity, string Code, string Message, string? ActionUrl);

    private sealed record DashboardSummary(
        string GroupName,
        string? CountryCode,
        int TeachersPending,
        int TeachersUnderReview,
        int TeachersChangesRequested,
        int TeachersApproved,
        int TeachersSuspended,
        int ExpertVotesOpen,
        int ExpertInvitesPending,
        int TeacherInvitesSent,
        int UnreadRemarksForTeachers,
        int CancelledLessonsRecent,
        int DisciplinesWithoutTeacher,
        int TeachersInactive,
        int ActiveGroupMembers,
        Guid? NextPendingTenantId,
        Guid? NextOpenExpertVoteId,
