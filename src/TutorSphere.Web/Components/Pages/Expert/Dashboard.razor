@page "/expert/dashboard"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TutorSphere.Web.Common
@inject AuthService Auth
@inject ApiClient Api
@inject IStringLocalizer<SharedResources> L

<ApplyRequestCulture />

<PageTitle>@L["Expert_Queue"] — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">@L["Expert_Queue"]</h1>
                <p class="cc-page-sub">@L["Expert_QueueSubtitle"]</p>
            </div>
        </div>

        <div class="cc-card mb-3">
            <h2 class="cc-card-title">@L["Expert_InviteTitle"]</h2>
            <p class="small text-muted mb-3">@L["Expert_InviteSubtitle"]</p>

            @if (!string.IsNullOrEmpty(_inviteError))
            {
                <div class="alert alert-danger py-2">@_inviteError</div>
            }
            @if (!string.IsNullOrEmpty(_inviteSuccess))
            {
                <div class="alert alert-success py-2">@_inviteSuccess</div>
            }

            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">@L["Expert_InviteEmail"]</label>
                    <input class="form-control" type="email" @bind="_inviteEmail" placeholder="enseignant@exemple.com" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@L["Expert_InviteFirstName"]</label>
                    <input class="form-control" @bind="_inviteFirstName" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">@L["Expert_InviteMessage"]</label>
                    <input class="form-control" @bind="_inviteMessage" placeholder="@L["Expert_InviteMessagePlaceholder"]" />
                </div>
                <div class="col-12">
                    <button type="button" class="cc-btn cc-btn-primary" disabled="@_inviteBusy" @onclick="InviteAsync">
                        <i class="bi bi-envelope"></i> @L["Expert_InviteSend"]
                    </button>
                </div>
            </div>
        </div>

        <div class="cc-card mb-3">
            <h2 class="cc-card-title">@L["Expert_RegisterTeacherTitle"]</h2>
            <p class="small text-muted mb-3">@L["Expert_RegisterTeacherSubtitle"]</p>

            @if (!string.IsNullOrEmpty(_regError))
            {
                <div class="alert alert-danger py-2">@_regError</div>
            }
            @if (!string.IsNullOrEmpty(_regSuccess))
            {
                <div class="alert alert-success py-2">@_regSuccess</div>
            }

            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">@L["Expert_InviteEmail"]</label>
                    <input class="form-control" type="email" @bind="_regEmail" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Expert_InviteFirstName"]</label>
                    <input class="form-control" @bind="_regFirstName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Expert_RegisterLastName"]</label>
                    <input class="form-control" @bind="_regLastName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Expert_RegisterSchoolName"]</label>
                    <input class="form-control" @bind="_regSchoolName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Expert_RegisterCity"]</label>
                    <input class="form-control" @bind="_regCity" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@L["Expert_RegisterCountry"]</label>
                    <CountrySelect Value="_regCountry" ValueChanged="OnRegCountryChanged" />
                </div>
                <div class="col-12">
                    <label class="form-label">@L["School_VisibleCountries"]</label>
                    <p class="small text-muted mb-2">@L["School_VisibleCountriesHint"]</p>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        @foreach (var code in _regVisibleCountries)
                        {
                            var info = CountryCatalog.Find(code);
                            <span class="badge text-bg-light border d-inline-flex align-items-center gap-1 py-2 px-2">
                                <span aria-hidden="true">@(info?.Flag ?? "")</span>
                                @(info?.Name ?? code)
                                @if (!string.Equals(code, _regCountry, StringComparison.OrdinalIgnoreCase))
                                {
                                    <button type="button" class="btn-close btn-close-sm ms-1" @onclick="() => RemoveRegVisible(code)"></button>
                                }
                            </span>
                        }
                    </div>
                    <div class="col-md-6 px-0">
                        <CountrySelect Value="@_regAddVisible" ValueChanged="OnRegAddVisibleChanged" Placeholder="@L["School_AddVisibleCountry"]" />
                    </div>
                </div>
                <div class="col-12">
                    <button type="button" class="cc-btn cc-btn-primary" disabled="@_regBusy" @onclick="RegisterTeacherAsync">
                        <i class="bi bi-person-plus"></i> @L["Expert_RegisterTeacherSend"]
                    </button>
                </div>
            </div>
        </div>

        <div class="cc-card mb-3">
            <h2 class="cc-card-title">@L["Expert_InvitesListTitle"]</h2>
            <p class="small text-muted mb-3">@L["Expert_InvitesListSubtitle"]</p>

            @if (_invitesLoading)
            {
                <div class="cc-empty py-3"><span class="spinner-border spinner-border-sm"></span></div>
            }
            else if (_invites.Count == 0)
            {
                <div class="cc-empty py-3">
                    <i class="bi bi-envelope-open"></i>
                    <p>@L["Expert_InvitesEmpty"]</p>
                </div>
            }
            else
            {
                <table class="cc-table">
                    <thead>
                        <tr>
                            <th>@L["Expert_InviteEmail"]</th>
                            <th>@L["Expert_InviteColInvitedBy"]</th>
                            <th>@L["Expert_ColDate"]</th>
                            <th>@L["Expert_InviteColStatus"]</th>
                            <th>@L["Expert_ColSchool"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in _invites)
                        {
                            <tr>
                                <td>
                                    <strong>@inv.Email</strong>
                                    @if (!string.IsNullOrWhiteSpace(inv.FirstName))
                                    {
                                        <div class="small text-muted">@inv.FirstName</div>
                                    }
                                </td>
                                <td>@(inv.InvitedByName ?? "—")</td>
                                <td>@inv.SentAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    <span class="cc-pill @InviteStatusPill(inv.Status)">@InviteStatusLabel(inv.Status)</span>
                                </td>
                                <td>
                                    @if (inv.AcceptedTenantId is Guid tid && !string.IsNullOrWhiteSpace(inv.SchoolName))
                                    {
                                        <a href="@($"expert/teachers/{tid}")">@inv.SchoolName</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <h2 class="cc-card-title mb-2">@L["Expert_Queue"]</h2>

        @if (_loading)
        {
            <div class="cc-empty"><span class="spinner-border"></span></div>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        else if (_queue.Count == 0)
        {
            <div class="cc-card cc-empty">
                <i class="bi bi-inbox"></i>
                <p>@L["Expert_QueueEmpty"]</p>
            </div>
        }
        else
        {
            <div class="cc-card">
                <table class="cc-table">
                    <thead>
                        <tr>
                            <th>@L["Expert_ColSchool"]</th>
                            <th>@L["Expert_ColCountry"]</th>
                            <th>@L["Expert_ColDocs"]</th>
                            <th>@L["Expert_ColDate"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _queue)
                        {
                            <tr>
                                <td>
                                    <strong>@item.SchoolName</strong>
                                    <div class="small text-muted">@(item.OwnerName ?? item.OwnerEmail)</div>
                                </td>
                                <td>@(item.Country ?? "—")</td>
                                <td>@item.DocumentCount</td>
                                <td>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a class="cc-btn cc-btn-primary btn-sm" href="@($"expert/teachers/{item.TenantId}")">
                                        @L["Expert_Review"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="cc-card cc-empty">
            <p>@L["Expert_LoginRequired"]</p>
            <a class="cc-btn cc-btn-primary" href="/login/expert">@L["Nav_Login"]</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<PendingTeacherItem> _queue = [];
    private List<TeacherInviteItem> _invites = [];
    private bool _loading = true;
    private bool _invitesLoading = true;
    private string? _error;

    private string _inviteEmail = "";
    private string _inviteFirstName = "";
    private string _inviteMessage = "";
    private bool _inviteBusy;
    private string? _inviteError;
    private string? _inviteSuccess;

    private string _regEmail = "";
    private string _regFirstName = "";
    private string _regLastName = "";
    private string _regSchoolName = "";
    private string _regCity = "";
    private string? _regCountry = "CM";
    private List<string> _regVisibleCountries = ["CM"];
    private string? _regAddVisible;
    private bool _regBusy;
    private string? _regError;
    private string? _regSuccess;

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        await Task.WhenAll(LoadQueueAsync(), LoadInvitesAsync());
    }

    private async Task LoadQueueAsync()
    {
        try
        {
            _queue = await Api.GetAsync<List<PendingTeacherItem>>("api/expert/queue") ?? [];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private async Task LoadInvitesAsync()
    {
        try
        {
            _invites = await Api.GetAsync<List<TeacherInviteItem>>("api/expert/invitations") ?? [];
        }
        catch
        {
            _invites = [];
        }
        finally { _invitesLoading = false; }
    }

    private async Task InviteAsync()
    {
        _inviteBusy = true;
        _inviteError = null;
        _inviteSuccess = null;
        try
        {
            var result = await Api.PostWithErrorAsync<object>("api/expert/invite-application", new
            {
                email = _inviteEmail,
                firstName = string.IsNullOrWhiteSpace(_inviteFirstName) ? null : _inviteFirstName,
                personalMessage = string.IsNullOrWhiteSpace(_inviteMessage) ? null : _inviteMessage
            });
            if (result.Error is not null)
            {
                _inviteError = result.Error;
                return;
            }

            _inviteSuccess = L["Expert_InviteSuccess"];
            _inviteEmail = "";
            _inviteFirstName = "";
            _inviteMessage = "";
            await LoadInvitesAsync();
        }
        catch (Exception ex)
        {
            _inviteError = ex.Message;
        }
        finally { _inviteBusy = false; }
    }

    private Task OnRegCountryChanged(string? code)
    {
        _regCountry = code;
        if (!string.IsNullOrWhiteSpace(code)
            && !_regVisibleCountries.Contains(code, StringComparer.OrdinalIgnoreCase))
        {
            _regVisibleCountries.Insert(0, code.Trim().ToUpperInvariant());
        }
        return Task.CompletedTask;
    }

    private Task OnRegAddVisibleChanged(string? code)
    {
        _regAddVisible = null;
        if (string.IsNullOrWhiteSpace(code))
            return Task.CompletedTask;
        var n = code.Trim().ToUpperInvariant();
        if (!_regVisibleCountries.Contains(n, StringComparer.OrdinalIgnoreCase))
            _regVisibleCountries.Add(n);
        return Task.CompletedTask;
    }

    private void RemoveRegVisible(string code)
    {
        _regVisibleCountries.RemoveAll(c => string.Equals(c, code, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_regCountry)
            && !_regVisibleCountries.Contains(_regCountry, StringComparer.OrdinalIgnoreCase))
            _regVisibleCountries.Insert(0, _regCountry.Trim().ToUpperInvariant());
    }

    private async Task RegisterTeacherAsync()
    {
        _regBusy = true;
        _regError = null;
        _regSuccess = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_regCountry))
            {
                _regError = L["Expert_RegisterCountryRequired"];
                return;
            }

            var result = await Api.PostWithErrorAsync<RegisterTeacherResult>("api/expert/register-teacher", new
            {
                email = _regEmail,
                firstName = _regFirstName,
                lastName = _regLastName,
                schoolName = _regSchoolName,
                city = string.IsNullOrWhiteSpace(_regCity) ? null : _regCity,
                country = _regCountry,
                visibleCountryCodes = _regVisibleCountries
            });
            if (result.Error is not null)
            {
                _regError = result.Error;
                return;
            }

            _regSuccess = L["Expert_RegisterTeacherSuccess"];
            _regEmail = _regFirstName = _regLastName = _regSchoolName = _regCity = "";
            await LoadInvitesAsync();
        }
        catch (Exception ex)
        {
            _regError = ex.Message;
        }
        finally { _regBusy = false; }
    }

    private sealed record RegisterTeacherResult(
        Guid TenantId,
        string TenantSlug,
        string Email,
        bool CredentialsSent);

    private string InviteStatusLabel(int status) => status switch
    {
        1 => L["Expert_InviteStatus_Registered"],
        2 => L["Expert_InviteStatus_Approved"],
        3 => L["Expert_InviteStatus_Rejected"],
        4 => L["Expert_InviteStatus_Expired"],
        _ => L["Expert_InviteStatus_Sent"]
    };

    private static string InviteStatusPill(int status) => status switch
    {
        1 => "cc-pill-type teacher",
        2 => "cc-pill-ok",
        3 => "cc-pill-bad",
        4 => "cc-pill-type",
        _ => "cc-pill-type"
    };

    private sealed record TeacherInviteItem(
        Guid Id,
        string Email,
        string? FirstName,
        int Status,
        DateTime SentAt,
        DateTime? ExpiresAt,
        DateTime? AcceptedAt,
        Guid? AcceptedTenantId,
        string? InvitedByUserId,
        string? InvitedByName,
        Guid ExpertGroupId,
        string? ExpertGroupName,
        string? SchoolName);
}
