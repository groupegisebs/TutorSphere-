@page "/expert/dashboard"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<ApplyRequestCulture />

<PageTitle>Tableau de bord Expert — TutorSphere</PageTitle>

<AuthorizeView Roles="Expert,GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="ex-dash-head">
            <div class="ex-dash-hello-wrap">
                <h1 class="ex-dash-hello">Bonjour @FirstName <span aria-hidden="true">👋</span></h1>
                <p class="ex-dash-sub">Voici les priorités de @GroupLabel aujourd'hui.</p>
            </div>
            <div class="ex-dash-head-actions">
                <a class="btn btn-primary" href="expert/teachers/add">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Ajouter un enseignant
                </a>
                <a class="btn btn-outline-secondary" href="expert/admissions">
                    <i class="bi bi-person-check me-1" aria-hidden="true"></i>Admissions Experts
                </a>
                <div class="ex-dash-more-wrap">
                    <button type="button" class="ex-dash-more" aria-label="Autres actions"
                            aria-expanded="@_moreOpen" @onclick="ToggleMore" @onclick:stopPropagation="true">
                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                    </button>
                    @if (_moreOpen)
                    {
                        <div class="ex-dash-more-menu" @onclick:stopPropagation="true">
                            @if (_isManager)
                            {
                                <a href="expert/meetings/create" @onclick="CloseMore">
                                    <i class="bi bi-camera-video" aria-hidden="true"></i>Créer une réunion
                                </a>
                            }
                            <a href="expert/disciplines" @onclick="CloseMore">
                                <i class="bi bi-book" aria-hidden="true"></i>Gérer les disciplines
                            </a>
                            <a href="expert/reports" @onclick="CloseMore">
                                <i class="bi bi-graph-up" aria-hidden="true"></i>Rapports
                            </a>
                            <a href="expert/activity" @onclick="CloseMore">
                                <i class="bi bi-clock-history" aria-hidden="true"></i>Journal d'activité
                            </a>
                        </div>
                    }
                </div>
                @* Date du jour, sans sélecteur : rien sur cet écran ne se lit à une autre date. *@
                <span class="ex-dash-date">
                    <i class="bi bi-calendar3" aria-hidden="true"></i>Aujourd'hui · @DateTime.Now.ToString("d MMM")
                </span>
            </div>
        </div>

        @if (_moreOpen)
        {
            <div class="ex-dash-more-backdrop" @onclick="CloseMore"></div>
        }

        @if (_loading)
        {
            <div class="ex-dash-card ex-dash-loading">
                <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                <span class="text-muted">@L["Common_Loading"]</span>
            </div>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        else if (_summary is not null)
        {
            <div class="ex-dash-grid">
                <section class="ex-dash-card">
                    <div class="ex-dash-card-head">
                        <h2>À traiter maintenant</h2>
                        <span class="ex-dash-count @(ActionCount > 0 ? null : "ex-dash-count--ok")">
                            @(ActionCount > 0 ? $"{ActionCount} action{(ActionCount > 1 ? "s" : "")}" : "Rien en attente")
                        </span>
                    </div>
                    <div class="ex-dash-tiles">
                        @foreach (var tile in PriorityTiles)
                        {
                            <div class="ex-dash-tile ex-dash-tile--@tile.Tone">
                                <span class="ex-dash-tile-icon"><i class="bi @tile.Icon" aria-hidden="true"></i></span>
                                <strong class="ex-dash-tile-title">@tile.Title</strong>
                                <span class="ex-dash-tile-sub">@tile.Sub</span>
                                @if (tile.ActionLabel is not null)
                                {
                                    @if (tile.ScrollTo is not null)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => ScrollToAsync(tile.ScrollTo)">
                                            @tile.ActionLabel
                                        </button>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@tile.Href">@tile.ActionLabel</a>
                                    }
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="ex-dash-card ex-dash-card--health">
                    <div class="ex-dash-card-head">
                        <h2>
                            <span class="ex-dash-head-icon"><i class="bi bi-heart-pulse" aria-hidden="true"></i></span>
                            Santé du groupe
                        </h2>
                    </div>
                    <div class="ex-dash-health">
                        @* Anneau en conic-gradient : pas de dépendance à une bibliothèque de graphiques
                           pour une valeur unique. *@
                        <div class="ex-dash-ring ex-dash-ring--@HealthTone" style="--ex-dash-pct:@HealthScore">
                            <span class="ex-dash-ring-val">@HealthScore<small>%</small></span>
                        </div>
                        <div class="ex-dash-health-body">
                            <strong>@HealthLabel</strong>
                            <span class="@(WatchPoints > 0 ? "ex-dash-health-warn" : null)">
                                @(WatchPoints > 0
                                    ? $"{WatchPoints} point{(WatchPoints > 1 ? "s" : "")} à surveiller"
                                    : "Aucun point de vigilance")
                            </span>
                        </div>
                    </div>
                    @if (_summary.Alerts.Count > 0)
                    {
                        <div class="ex-dash-card-foot">
                            <button type="button" class="ex-dash-link ex-dash-link--btn" @onclick="() => _showDiagnostic = !_showDiagnostic">
                                @(_showDiagnostic ? "Masquer le diagnostic" : "Voir le diagnostic")
                                <i class="bi @(_showDiagnostic ? "bi-chevron-up" : "bi-arrow-right")" aria-hidden="true"></i>
                            </button>
                        </div>
                        @if (_showDiagnostic)
                        {
                            <ul class="ex-dash-alerts">
                                @foreach (var alert in _summary.Alerts)
                                {
                                    <li class="ex-dash-alert ex-dash-alert--@AlertTone(alert.Severity)">
                                        <span class="ex-dash-alert-dot" aria-hidden="true"></span>
                                        <span>@alert.Message</span>
                                        @if (!string.IsNullOrWhiteSpace(alert.ActionUrl) || alert.Code == "pending_enrollments")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => OpenAlertAsync(alert)">
                                                Ouvrir
                                            </button>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    }
                </section>

                @* La bande traverse les deux colonnes : ces six chiffres décrivent le groupe entier,
                   pas la colonne de gauche. *@
                <div class="ex-dash-kpis">
                    @foreach (var kpi in Kpis)
                    {
                        <a class="ex-dash-kpi" href="@kpi.Href">
                            <span class="ex-dash-kpi-icon ex-dash-kpi-icon--@kpi.Tone">
                                <i class="bi @kpi.Icon" aria-hidden="true"></i>
                            </span>
                            <span class="ex-dash-kpi-body">
                                <span class="ex-dash-kpi-val">@kpi.Value</span>
                                <span class="ex-dash-kpi-label">@kpi.Label</span>
                            </span>
                        </a>
                    }
                </div>

                <div class="ex-dash-main">
                    @if (_enrollments.Count > 0 || !string.IsNullOrEmpty(_enrollBanner) || !string.IsNullOrEmpty(_enrollError))
                    {
                        <section class="ex-dash-card" id="expert-enrollments">
                            <div class="ex-dash-card-head">
                                <h2>Inscriptions en attente de l'enseignant</h2>
                                <span class="ex-dash-card-meta">@_enrollments.Count demande(s)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(_enrollError))
                            {
                                <div class="alert alert-danger py-2 px-3">@_enrollError</div>
                            }
                            @if (!string.IsNullOrEmpty(_enrollBanner))
                            {
                                <div class="alert alert-success py-2 px-3">@_enrollBanner</div>
                            }
                            <ul class="ex-dash-list">
                                @foreach (var item in _enrollments)
                                {
                                    <li class="ex-dash-row">
                                        <span class="ex-dash-av" style="background:@AvatarBg(item.StudentName)">
                                            @Initials(item.StudentName)
                                        </span>
                                        <div class="ex-dash-row-body">
                                            <strong>
                                                @item.StudentName
                                                @if (!string.IsNullOrWhiteSpace(item.ParentName))
                                                {
                                                    <text> · parent @item.ParentName</text>
                                                }
                                            </strong>
                                            <span>
                                                « @item.OfferingTitle » chez @item.TeacherName
                                                · @item.Price.ToString("N2") @item.Currency
                                                · @item.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        </div>
                                        <div class="ex-dash-row-act">
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    disabled="@(_busyEnrollmentId == item.Id)"
                                                    @onclick="() => DecideEnrollmentAsync(item.Id, true)">
                                                Accepter
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    disabled="@(_busyEnrollmentId == item.Id)"
                                                    @onclick="() => DecideEnrollmentAsync(item.Id, false)">
                                                Refuser
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </section>
                    }

                    <section class="ex-dash-card">
                        <div class="ex-dash-card-head">
                            <h2>Agenda et réunions</h2>
                            <a class="ex-dash-link" href="expert/meetings">
                                Voir toutes <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                        <div class="ex-dash-tabs" role="tablist">
                            <button type="button" role="tab" aria-selected="@(!_meetingsPast)"
                                    class="ex-dash-tab @(!_meetingsPast ? "active" : null)"
                                    @onclick="() => _meetingsPast = false">
                                À venir
                            </button>
                            <button type="button" role="tab" aria-selected="@_meetingsPast"
                                    class="ex-dash-tab @(_meetingsPast ? "active" : null)"
                                    @onclick="() => _meetingsPast = true">
                                Terminées
                            </button>
                        </div>
                        @if (VisibleMeetings.Count == 0)
                        {
                            <div class="ex-dash-empty">
                                <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                                <div>
                                    <strong>@(_meetingsPast ? "Aucune réunion terminée" : "Aucune réunion programmée")</strong>
                                    <span>@(_meetingsPast
                                        ? "Les comptes rendus apparaîtront ici."
                                        : "Planifiez une rencontre avec les membres du groupe.")</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <ul class="ex-dash-list">
                                @foreach (var m in VisibleMeetings)
                                {
                                    <li class="ex-dash-row">
                                        <span class="ex-dash-row-icon"><i class="bi bi-calendar-event" aria-hidden="true"></i></span>
                                        <div class="ex-dash-row-body">
                                            <strong>@m.Title</strong>
                                            <span>@MeetingWhen(m)</span>
                                        </div>
                                        <span class="ex-dash-stack">
                                            @foreach (var name in (m.ParticipantPreview ?? []).Take(3))
                                            {
                                                <span class="ex-dash-av ex-dash-av--sm" style="background:@AvatarBg(name)"
                                                      title="@name">@Initials(name)</span>
                                            }
                                            @if (HiddenParticipants(m) > 0)
                                            {
                                                <span class="ex-dash-av ex-dash-av--sm ex-dash-av--rest">+@HiddenParticipants(m)</span>
                                            }
                                        </span>
                                        <span class="ex-dash-chip ex-dash-chip--@MeetingTone(m.Status)">@StatusFr(m.Status)</span>
                                        <div class="ex-dash-row-act">
                                            @if (m.Status is 1 or 2)
                                            {
                                                <a class="btn btn-sm btn-primary" href="@($"expert/meetings/{m.Id}/room")">Rejoindre</a>
                                            }
                                            else if (m.Status == 3)
                                            {
                                                <a class="btn btn-sm btn-outline-secondary"
                                                   href="@($"expert/meetings/{m.Id}/minutes")">Compte rendu</a>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        @if (_isManager)
                        {
                            <div class="ex-dash-card-foot">
                                <a class="btn btn-sm btn-outline-secondary" href="expert/meetings/create">
                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Créer une réunion
                                </a>
                            </div>
                        }
                    </section>

                    <section class="ex-dash-card">
                        <div class="ex-dash-card-head">
                            <h2>Activité récente</h2>
                        </div>
                        @if (_activity.Count == 0)
                        {
                            <div class="ex-dash-empty">
                                <i class="bi bi-clock-history" aria-hidden="true"></i>
                                <div>
                                    <strong>Aucune activité enregistrée</strong>
                                    <span>Les décisions et les envois du groupe s'inscriront ici.</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <ul class="ex-dash-feed">
                                @foreach (var e in _activity)
                                {
                                    <li>
                                        <span class="ex-dash-feed-icon"><i class="bi @EventIcon(e.EventType)" aria-hidden="true"></i></span>
                                        <span class="ex-dash-feed-text">@e.Summary</span>
                                        <span class="ex-dash-feed-when">@Ago(e.CreatedAt)</span>
                                    </li>
                                }
                            </ul>
                            <div class="ex-dash-card-foot">
                                <a class="ex-dash-link" href="expert/activity">
                                    Voir le journal complet <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            </div>
                        }
                    </section>
                </div>

                <aside class="ex-dash-side">

                    <section class="ex-dash-card">
                        <div class="ex-dash-card-head">
                            <h2>Actions rapides</h2>
                        </div>
                        <div class="ex-dash-quick">
                            <a href="expert/approvals?tab=invite">
                                <span class="ex-dash-kpi-icon ex-dash-kpi-icon--blue">
                                    <i class="bi bi-person-plus" aria-hidden="true"></i>
                                </span>
                                Inviter un enseignant
                            </a>
                            <a href="@NextFileHref">
                                <span class="ex-dash-kpi-icon ex-dash-kpi-icon--amber">
                                    <i class="bi bi-folder2-open" aria-hidden="true"></i>
                                </span>
                                Ouvrir les dossiers
                            </a>
                            @if (_isManager)
                            {
                                <a href="expert/meetings/create">
                                    <span class="ex-dash-kpi-icon ex-dash-kpi-icon--violet">
                                        <i class="bi bi-camera-video" aria-hidden="true"></i>
                                    </span>
                                    Créer une réunion
                                </a>
                            }
                            else
                            {
                                <a href="expert/my-tasks">
                                    <span class="ex-dash-kpi-icon ex-dash-kpi-icon--violet">
                                        <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                                    </span>
                                    Mes tâches
                                </a>
                            }
                            <a href="expert/disciplines">
                                <span class="ex-dash-kpi-icon ex-dash-kpi-icon--green">
                                    <i class="bi bi-book" aria-hidden="true"></i>
                                </span>
                                Gérer les disciplines
                            </a>
                        </div>
                    </section>

                    <section class="ex-dash-card">
                        <div class="ex-dash-card-head">
                            <h2>Équipe du groupe</h2>
                        </div>
                        <div class="ex-dash-team">
                            <span class="ex-dash-stack">
                                @foreach (var name in _memberNames.Take(4))
                                {
                                    <span class="ex-dash-av" style="background:@AvatarBg(name)" title="@name">@Initials(name)</span>
                                }
                                @if (_memberNames.Count > 4)
                                {
                                    <span class="ex-dash-av ex-dash-av--rest">+@(_memberNames.Count - 4)</span>
                                }
                                @if (_memberNames.Count == 0)
                                {
                                    <span class="ex-dash-av ex-dash-av--rest"><i class="bi bi-people" aria-hidden="true"></i></span>
                                }
                            </span>
                            <div class="ex-dash-team-stats">
                                <div>
                                    <strong>@_summary.ActiveGroupMembers</strong>
                                    <span>membre@(_summary.ActiveGroupMembers > 1 ? "s" : "") actif@(_summary.ActiveGroupMembers > 1 ? "s" : "")</span>
                                </div>
                                <div>
                                    <strong>@_summary.TeachersApproved</strong>
                                    <span>enseignants approuvés</span>
                                </div>
                                <div>
                                    <strong>@_summary.TeachersInactive</strong>
                                    <span>inactifs depuis 45 j</span>
                                </div>
                            </div>
                        </div>
                        <div class="ex-dash-card-foot ex-dash-card-foot--split">
                            <a class="btn btn-sm btn-outline-secondary" href="@TeamHref">Voir l'équipe</a>
                            <a class="btn btn-sm btn-outline-secondary" href="expert/admissions">Admissions</a>
                        </div>
                    </section>

                    <section class="ex-dash-card">
                        <div class="ex-dash-card-head">
                            <h2>Couverture pédagogique</h2>
                        </div>
                        <div class="ex-dash-coverage @(_summary.DisciplinesWithoutTeacher > 0 ? "ex-dash-coverage--warn" : null)">
                            <i class="bi @(_summary.DisciplinesWithoutTeacher > 0 ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"
                               aria-hidden="true"></i>
                            <span>
                                @(_summary.DisciplinesWithoutTeacher > 0
                                    ? $"{_summary.DisciplinesWithoutTeacher} discipline(s) sans enseignant affecté"
                                    : "Toutes les disciplines sont couvertes")
                            </span>
                        </div>
                        <div class="ex-dash-card-foot">
                            <a class="ex-dash-link" href="expert/disciplines">
                                Voir les disciplines <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </section>
                </aside>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="ex-dash-card">
            <p>@L["Expert_LoginRequired"]</p>
            <a class="btn btn-primary" href="/login/expert">@L["Nav_Login"]</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _loading = true;
    private string? _error;
    private bool _isManager;
    private bool _moreOpen;
    private bool _meetingsPast;
    private bool _showDiagnostic;
    private DashboardSummary? _summary;
    private readonly List<MeetingItem> _meetings = [];
    private List<GovernanceEvent> _activity = [];
    private List<string> _memberNames = [];
    private List<ExpertPendingEnrollmentDto> _enrollments = [];
    private Guid? _busyEnrollmentId;
    private string? _enrollError;
    private string? _enrollBanner;

    private const int ActivityTake = 6;
    private const int MeetingsShown = 4;

    private string FirstName =>
        (Auth.UserName ?? Auth.UserEmail ?? "").Split([' ', '@'], StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault() ?? "";

    private string GroupLabel => _summary is null
        ? "votre groupe"
        : string.IsNullOrWhiteSpace(_summary.CountryCode)
            ? _summary.GroupName
            : $"{_summary.GroupName} ({_summary.CountryCode})";

    private int ReviewQueue => _summary is null
        ? 0
        : _summary.TeachersPending + _summary.TeachersUnderReview + _summary.TeachersChangesRequested;

    private string NextFileHref => _summary?.NextPendingTenantId is Guid tid
        ? $"expert/teachers/{tid}"
        : "expert/approvals?tab=queue";

    private string TeamHref => _isManager ? "group-admin/members" : "expert/members";

    /// <summary>
    /// Réunions du volet : à venir (brouillon, programmée, en cours) ou terminées, les plus proches
    /// d'abord. La liste complète reste sur l'écran Réunions.
    /// </summary>
    private List<MeetingItem> VisibleMeetings =>
        [.. _meetings
            .Where(m => _meetingsPast ? m.Status == 3 : m.Status is 0 or 1 or 2)
            .OrderBy(m => _meetingsPast ? DateTime.MaxValue.Ticks : (m.StartAtUtc?.Ticks ?? long.MaxValue))
            .ThenByDescending(m => m.StartAtUtc ?? DateTime.MinValue)
            .Take(MeetingsShown)];

    private sealed record PriorityTile(
        string Tone, string Icon, string Title, string Sub, string? ActionLabel, string? Href, string? ScrollTo);

    /// <summary>
    /// Points qui demandent une décision, du plus bloquant au moins urgent. Le dossier enseignant
    /// figure toujours en premier, même à zéro : c'est la mission du groupe, et son état « rien à
    /// faire » vaut d'être affirmé.
    /// </summary>
    private List<PriorityTile> Priorities
    {
        get
        {
            var s = _summary!;
            var list = new List<PriorityTile>
            {
                ReviewQueue > 0
                    ? new("danger", "bi-folder2-open",
                        $"{ReviewQueue} dossier{(ReviewQueue > 1 ? "s" : "")} enseignant à traiter",
                        $"{s.TeachersPending} en attente · {s.TeachersUnderReview} en revue · {s.TeachersChangesRequested} à corriger",
                        "Ouvrir", NextFileHref, null)
                    : new("ok", "bi-check-circle", "Aucun dossier", "enseignant en attente", null, null, null)
            };

            if (s.PendingTeacherEnrollments > 0)
                list.Add(new("warn", "bi-person-check",
                    $"{s.PendingTeacherEnrollments} inscription{(s.PendingTeacherEnrollments > 1 ? "s" : "")} élève",
                    "en attente de l'enseignant", "Traiter", null, "expert-enrollments"));

            if (s.UnreadRemarksForTeachers > 0)
                list.Add(new("warn", "bi-exclamation-triangle",
                    $"{s.UnreadRemarksForTeachers} remarque{(s.UnreadRemarksForTeachers > 1 ? "s" : "")} non lue{(s.UnreadRemarksForTeachers > 1 ? "s" : "")}",
                    "par les enseignants", "Ouvrir", "expert/teachers", null));

            if (s.TeachersInactive > 0)
                list.Add(new("danger", "bi-person-dash",
                    $"{s.TeachersInactive} enseignant{(s.TeachersInactive > 1 ? "s" : "")} inactif{(s.TeachersInactive > 1 ? "s" : "")}",
                    "depuis 45 jours", "Voir", "expert/teachers", null));

            if (s.ExpertVotesOpen > 0)
                list.Add(new("warn", "bi-hand-thumbs-up",
                    $"{s.ExpertVotesOpen} vote{(s.ExpertVotesOpen > 1 ? "s" : "")} ouvert{(s.ExpertVotesOpen > 1 ? "s" : "")}",
                    "sur des candidatures Expert", "Voter", "expert/admissions", null));

            if (s.DisciplinesWithoutTeacher > 0)
                list.Add(new("warn", "bi-book",
                    $"{s.DisciplinesWithoutTeacher} discipline{(s.DisciplinesWithoutTeacher > 1 ? "s" : "")} sans enseignant",
                    "affecté dans le groupe", "Ouvrir", "expert/disciplines", null));

            return list;
        }
    }

    /// <summary>Trois tuiles au plus : au-delà, la carte cesse de désigner une priorité.</summary>
    private List<PriorityTile> PriorityTiles => [.. Priorities.Take(3)];

    private int ActionCount => Priorities.Count(t => t.Tone != "ok");

    private sealed record Kpi(string Icon, string Tone, int Value, string Label, string Href);

    private List<Kpi> Kpis =>
    [
        new("bi-mortarboard", "green", _summary!.TeachersApproved, "Enseignants approuvés", "expert/teachers"),
        new("bi-people", "blue", _summary.ActiveGroupMembers,
            _summary.ActiveGroupMembers > 1 ? "Membres actifs" : "Membre actif", TeamHref),
        new("bi-send", "violet", _summary.TeacherInvitesSent, "Invitations envoyées", "expert/approvals?tab=invite"),
        new("bi-person-check", "amber", _summary.ExpertInvitesPending, "Admissions en attente", "expert/admissions"),
        new("bi-hand-thumbs-up", "pink", _summary.ExpertVotesOpen, "Votes ouverts", "expert/admissions"),
        new("bi-calendar-x", "rose", _summary.CancelledLessonsRecent, "Cours annulés (30 j)", "expert/reports")
    ];

    private sealed record Penalty(string Label, int Points);

    /// <summary>
    /// Retenues appliquées au score de santé. Le poids traduit ce qu'un point coûte au groupe :
    /// un dossier qui dort ou un enseignant sans activité pèsent davantage qu'un cours annulé.
    /// Chaque catégorie est plafonnée, sinon un seul indicateur ferait tomber le score à zéro.
    /// </summary>
    private List<Penalty> HealthPenalties
    {
        get
        {
            var s = _summary!;
            List<Penalty> all =
            [
                new("Dossiers à traiter", Math.Min(20, ReviewQueue * 4)),
                new("Enseignants inactifs", Math.Min(18, s.TeachersInactive * 3)),
                new("Disciplines sans enseignant", Math.Min(12, s.DisciplinesWithoutTeacher * 4)),
                new("Inscriptions élèves en attente", Math.Min(12, s.PendingTeacherEnrollments * 3)),
                new("Remarques non lues", Math.Min(10, s.UnreadRemarksForTeachers * 2)),
                new("Votes ouverts", Math.Min(8, s.ExpertVotesOpen * 2)),
                new("Cours annulés (30 j)", Math.Min(6, s.CancelledLessonsRecent)),
                new("Groupe sous-doté", s.ActiveGroupMembers < 2 ? 10 : 0)
            ];
            return [.. all.Where(p => p.Points > 0)];
        }
    }

    private int HealthScore => Math.Clamp(100 - HealthPenalties.Sum(p => p.Points), 5, 100);

    private int WatchPoints => HealthPenalties.Count;

    private string HealthTone => HealthScore >= 85 ? "ok" : HealthScore >= 65 ? "warn" : "danger";

    private string HealthLabel => HealthScore >= 85
        ? "Bon fonctionnement"
        : HealthScore >= 65 ? "Fonctionnement correct" : "Attention requise";

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        try
        {
            try
            {
                var ctx = await Api.GetAsync<MeContext>("api/expert/me-context");
                _isManager = ctx?.IsGroupManager == true || Auth.IsActingAsGroupAdmin;
            }
            catch { }

            _summary = await Api.GetAsync<DashboardSummary>("api/expert/dashboard-summary");
            if (_summary is null)
                _error = "Impossible de charger le tableau de bord.";

            // Chaque volet est facultatif : un endpoint indisponible masque sa carte, il ne doit pas
            // emporter le tableau de bord entier.
            try
            {
                _enrollments = await Api.GetAsync<List<ExpertPendingEnrollmentDto>>("api/expert/enrollments/pending") ?? [];
            }
            catch { _enrollments = []; }

            try
            {
                var list = await Api.GetAsync<List<MeetingItem>>("api/expert/meetings") ?? [];
                _meetings.AddRange(list.Where(m => m.Status != 4));
            }
            catch { /* réunions indisponibles pour ce rôle */ }

            try
            {
                _activity = await Api.GetAsync<List<GovernanceEvent>>($"api/expert/activity?take={ActivityTake}") ?? [];
            }
            catch { _activity = []; }

            try
            {
                var members = await Api.GetAsync<List<MemberItem>>("api/expert/membership/members") ?? [];
                // Statut 0 = actif : les membres suspendus ou retirés ne comptent pas dans l'équipe,
                // sinon la pile d'avatars contredirait le compteur de membres actifs.
                _memberNames = [.. members
                    .Where(m => m.Status == 0 && !string.IsNullOrWhiteSpace(m.FullName))
                    .Select(m => m.FullName)];
            }
            catch { _memberNames = []; }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally { _loading = false; }
    }

    private void ToggleMore() => _moreOpen = !_moreOpen;
    private void CloseMore() => _moreOpen = false;

    private async Task ScrollToAsync(string? elementId)
    {
        if (string.IsNullOrEmpty(elementId)) return;
        try { await JS.InvokeVoidAsync("tsScrollToId", elementId); }
        catch { /* la carte est déjà visible */ }
    }

    private async Task OpenAlertAsync(DashboardAlert alert)
    {
        var url = alert.ActionUrl ?? "";
        var enrollments = string.Equals(alert.Code, "pending_enrollments", StringComparison.OrdinalIgnoreCase)
            || url.Contains("#expert-enrollments", StringComparison.OrdinalIgnoreCase);

        if (enrollments)
        {
            await ScrollToAsync("expert-enrollments");
            return;
        }

        var path = url.Trim();
        var hash = path.IndexOf('#');
        if (hash >= 0)
            path = path[..hash];
        path = path.TrimStart('/');
        if (!string.IsNullOrEmpty(path))
            Nav.NavigateTo(path);
    }

    private async Task DecideEnrollmentAsync(Guid id, bool accept)
    {
        _busyEnrollmentId = id;
        _enrollError = null;
        _enrollBanner = null;
        try
        {
            var action = accept ? "accept" : "reject";
            var result = await Api.PostWithErrorAsync<ExpertPendingEnrollmentDto>(
                $"api/expert/enrollments/{id}/{action}", new { });
            if (result.Error is not null)
            {
                _enrollError = result.Error;
                return;
            }

            _enrollBanner = accept
                ? "Inscription acceptée. L'enseignant a été averti (e-mail et remarque)."
                : "Inscription refusée. L'enseignant a été averti.";
            _enrollments = await Api.GetAsync<List<ExpertPendingEnrollmentDto>>("api/expert/enrollments/pending") ?? [];
            _summary = await Api.GetAsync<DashboardSummary>("api/expert/dashboard-summary") ?? _summary;
        }
        finally { _busyEnrollmentId = null; }
    }

