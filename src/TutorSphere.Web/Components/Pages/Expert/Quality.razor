@page "/expert/quality"
@layout ExpertLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService Auth
@inject ApiClient Api

<PageTitle>Suivi qualité — Expert</PageTitle>

<AuthorizeView Roles="Expert,GroupManager">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">Suivi qualité</h1>
                <p class="cc-page-sub">Indicateurs d'activité et signaux de qualité pour les enseignants suivis.</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        <div class="cc-card">
            @if (_loading)
            {
                <span class="spinner-border"></span>
            }
            else if (_teachers.Count == 0)
            {
                <p class="text-muted mb-0">Aucun enseignant à afficher.</p>
            }
            else
            {
                <table class="cc-table">
                    <thead>
                        <tr>
                            <th>Profil</th>
                            <th>Cours</th>
                            <th>Annulés</th>
                            <th>Absences</th>
                            <th>Remarques</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _teachers.OrderByDescending(x => x.NoShowIncidents + x.CancelledLessons))
                        {
                            <tr>
                                <td>
                                    <strong>@t.SchoolName</strong>
                                    <div class="small text-muted">@(t.OwnerName ?? t.OwnerEmail ?? "—")</div>
                                </td>
                                <td>@t.TotalLessons</td>
                                <td>
                                    @if (t.CancelledLessons > 0)
                                    {
                                        <span class="cc-pill cc-pill-bad">@t.CancelledLessons</span>
                                    }
                                    else
                                    {
                                        <span>0</span>
                                    }
                                </td>
                                <td>
                                    @if (t.NoShowIncidents > 0)
                                    {
                                        <span class="cc-pill cc-pill-bad">@t.NoShowIncidents</span>
                                    }
                                    else
                                    {
                                        <span>0</span>
                                    }
                                </td>
                                <td>@t.RemarkCount</td>
                                <td class="text-end">
                                    <a class="cc-btn btn-sm" href="@($"expert/teachers/{t.TenantId}")">Détail</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool _loading = true;
    private string? _error;
    private List<MonitoredTeacher> _teachers = [];

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _teachers = await Api.GetAsync<List<MonitoredTeacher>>("api/expert/teachers") ?? [];
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private sealed record MonitoredTeacher(
        Guid TenantId, string SchoolName, string? Country, string? City,
        string? OwnerEmail, string? OwnerName, int TotalLessons, int CancelledLessons,
        int NoShowIncidents, DateTime? LastActivityAt, int RemarkCount, DateTime? LastRemarkAt);
}
