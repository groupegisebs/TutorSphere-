@page "/parent/dashboard"
@page "/parent"
@layout ParentLayout
@rendermode InteractiveServer
@using TutorSphere.Application.DTOs.Parents
@inject IStringLocalizer<SharedResources> L
@inject ParentProfileState ParentProfile
@inject ApiClient Api

<PageTitle>@L["PageTitle_ParentDashboard"]</PageTitle>

<div class="parent-dashboard">
    <header class="pd-header">
        <div>
            <h1 class="pd-greeting">@L["ParentDashboard_Welcome", ParentProfile.DisplayName] 👋</h1>
            <p class="pd-subtitle">@L["ParentDashboard_Subtitle"]</p>
        </div>
    </header>

    @if (_loading)
    {
        <div class="pd-loading">
            <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
            <span>@L["Label_Loading"]</span>
        </div>
    }
    else
    {
        <!-- Mes enfants -->
        <section class="pd-section">
            <div class="pd-section-head">
                <h2>@L["Parent_MyChildren_Title"]</h2>
                <a href="/parent/children" class="pd-link">@L["Button_ViewAll"]</a>
            </div>
            <div class="pd-children-row">
                @if (_children.Count == 0)
                {
                    <div class="pd-empty-banner">
                        <div class="pd-empty-banner-icon"><i class="bi bi-people-fill" aria-hidden="true"></i></div>
                        <div class="pd-empty-banner-body">
                            <h3>@L["ParentDashboard_NoChildren"]</h3>
                            <p>@L["ParentDashboard_EmptyChildrenHint"]</p>
                        </div>
                        <a href="/parent/children" class="btn btn-primary pd-btn-primary">
                            <i class="bi bi-person-plus me-1" aria-hidden="true"></i>@L["ParentDashboard_AddChild"]
                        </a>
                    </div>
                }
                else
                {
                    @foreach (var (child, index) in _children.Select((c, i) => (c, i)))
                    {
                        var name = $"{child.FirstName} {child.LastName}".Trim();
                        var initials = GetInitials(name);
                        var color = AvatarColors[index % AvatarColors.Length];
                        <article class="pd-child-card">
                            @if (!string.IsNullOrEmpty(child.PhotoUrl))
                            {
                                <img class="pd-child-photo" src="@child.PhotoUrl" alt="" />
                            }
                            else
                            {
                                <div class="pd-child-avatar" style="background:@color">@initials</div>
                            }
                            <div class="pd-child-meta">
                                <h3>@name</h3>
                                <span>@(child.SchoolLevel ?? "—")</span>
                            </div>
                            <div class="pd-child-progress">
                                <div class="pd-progress-track">
                                    <div class="pd-progress-fill" style="width:@(child.ProgressPercent ?? 0)%"></div>
                                </div>
                                <strong>@FormatPercent(child.ProgressPercent)</strong>
                            </div>
                        </article>
                    }
                }
                <a href="/parent/children" class="pd-child-add" aria-label="@L["ParentDashboard_AddChild"]">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>@L["ParentDashboard_AddChild"]</span>
                </a>
            </div>
        </section>

        <!-- KPI row -->
        <div class="pd-kpi-row">
            <article class="pd-kpi pd-kpi--purple">
                <div class="pd-kpi-icon"><i class="bi bi-calendar2-check" aria-hidden="true"></i></div>
                <div>
                    <span class="pd-kpi-label">@L["ParentDashboard_StatCoursesToday"]</span>
                    <strong class="pd-kpi-value">@L["ParentDashboard_CoursesCount", _lessonsToday]</strong>
                    <span class="pd-kpi-hint">@_nextCourseLabel</span>
                </div>
            </article>
            <article class="pd-kpi pd-kpi--amber">
                <div class="pd-kpi-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>
                <div>
                    <span class="pd-kpi-label">@L["ParentDashboard_StatWatch"]</span>
                    <strong class="pd-kpi-value">@L["ParentDashboard_HomeworkCount", _homeworkItems.Count]</strong>
                </div>
            </article>
            <article class="pd-kpi pd-kpi--green">
                <div class="pd-kpi-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></div>
                <div>
                    <span class="pd-kpi-label">@L["ParentDashboard_StatProgressAvg"]</span>
                    <strong class="pd-kpi-value">@_averageGradeDisplay</strong>
                </div>
            </article>
            <article class="pd-kpi pd-kpi--blue">
                <div class="pd-kpi-icon"><i class="bi bi-credit-card" aria-hidden="true"></i></div>
                <div>
                    <span class="pd-kpi-label">@L["ParentDashboard_NextPayment"]</span>
                    <strong class="pd-kpi-value">@_nextPaymentDisplay</strong>
                    <span class="pd-kpi-hint">@_subscriptionPlan</span>
                </div>
            </article>
        </div>

        <!-- Main 3-column board -->
        <div class="pd-board">
            <div class="pd-board-col">
                <section class="pd-card pd-today-card">
                    <div class="pd-card-head">
                        <h2>@L["ParentDashboard_TodaySection"]</h2>
                    </div>
                    @if (_featuredSession is null)
                    {
                        <div class="pd-soft-empty">
                            <i class="bi bi-calendar-event" aria-hidden="true"></i>
                            <p>@L["ParentDashboard_NoSessions"]</p>
                            <a href="/parent/calendar" class="pd-link">@L["ParentDashboard_ScheduleClass"]</a>
                        </div>
                    }
                    else
                    {
                        <div class="pd-today-body">
                            <div class="pd-today-badge">
                                <i class="bi bi-clock" aria-hidden="true"></i>
                                @FormatSessionTime(_featuredSession.StartTime)
                            </div>
                            <h3>@(_featuredSession.Subject ?? L["ParentDashboard_NextClass"])</h3>
                            <p class="pd-today-meta">
                                <span>@_featuredSession.TutorName</span>
                                <span class="pd-dot">·</span>
                                <span>@LessonModeLabel(_featuredSession.Mode)</span>
                            </p>
                            <div class="pd-today-actions">
                                <a href="/parent/calendar" class="btn btn-primary pd-btn-primary">@L["ParentDashboard_JoinClass"]</a>
                                <a href="/parent/messages" class="btn btn-outline-primary pd-btn-outline">@L["ParentDashboard_ContactTeacher"]</a>
                            </div>
                        </div>
                    }
                </section>

                <section class="pd-card">
                    <div class="pd-card-head">
                        <h2>@L["ParentDashboard_TodoSection"]</h2>
                        <a href="/parent/homework" class="pd-link">@L["Button_ViewAll"]</a>
                    </div>
                    @if (_homeworkItems.Count == 0)
                    {
                        <div class="pd-soft-empty pd-soft-empty--sm">
                            <i class="bi bi-journal-check" aria-hidden="true"></i>
                            <p>@L["ParentDashboard_NoHomework"]</p>
                        </div>
                    }
                    else
                    {
                        <ul class="pd-todo-list">
                            @foreach (var hw in _homeworkItems.Take(4))
                            {
                                var tag = GetHomeworkTag(hw);
                                <li>
                                    <div>
                                        <strong>@hw.Title</strong>
                                        <span>@hw.ChildName — @FormatDueDate(hw.DueDate)</span>
                                    </div>
                                    <span class="pd-tag pd-tag--@tag.Class">@tag.Label</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <div class="pd-board-col">
                <section class="pd-card pd-progress-card">
                    <div class="pd-card-head">
                        <h2>@L["ParentDashboard_ChildrenProgress"]</h2>
                        <a href="/parent/progress" class="pd-link">@L["Button_ViewAll"]</a>
                    </div>
                    @if (_children.Count == 0)
                    {
                        <div class="pd-soft-empty">
                            <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                            <p>@L["ParentDashboard_NoProgressData"]</p>
                        </div>
                    }
                    else
                    {
                        <ul class="pd-progress-list">
                            @foreach (var child in _children)
                            {
                                var name = $"{child.FirstName} {child.LastName}".Trim();
                                <li>
                                    <div class="pd-progress-row-head">
                                        <strong>@name</strong>
                                        <span>@FormatGrade(child.AverageGrade)</span>
                                    </div>
                                    <div class="pd-progress-track pd-progress-track--lg">
                                        <div class="pd-progress-fill" style="width:@(child.ProgressPercent ?? 0)%"></div>
                                    </div>
                                    <div class="pd-progress-row-foot">
                                        <span>@(child.NextLessonSubject ?? child.SchoolLevel ?? "—")</span>
                                        <span>@FormatPercent(child.ProgressPercent)</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <div class="pd-board-col">
                <section class="pd-card">
                    <div class="pd-card-head">
                        <h2>@L["ParentDashboard_FamilyCalendar"]</h2>
                        <a href="/parent/calendar" class="pd-link">@L["Button_ViewAll"]</a>
                    </div>
                    <div class="pd-mini-cal">
                        @foreach (var day in _weekDays.Take(5))
                        {
                            <div class="pd-mini-day @(day.IsToday ? "is-today" : null)">
                                <span class="pd-mini-day-label">@day.Label</span>
                                @if (day.Events.Count == 0)
                                {
                                    <span class="pd-mini-empty">@L["ParentDashboard_NoClass"]</span>
                                }
                                else
                                {
                                    @foreach (var ev in day.Events.Take(2))
                                    {
                                        <div class="pd-mini-event pd-mini-event--@ev.Color">
                                            <strong>@ev.Title</strong>
                                            <span>@ev.Time</span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="pd-card">
                    <div class="pd-card-head">
                        <h2>@L["ParentDashboard_RecentMessages"]</h2>
                        <a href="/parent/messages" class="pd-link">@L["Button_ViewAll"]</a>
                    </div>
                    @if (_recentMessages.Count == 0)
                    {
                        <div class="pd-soft-empty pd-soft-empty--sm">
                            <i class="bi bi-chat-left-text" aria-hidden="true"></i>
                            <p>@L["ParentDashboard_NoMessages"]</p>
                        </div>
                    }
                    else
                    {
                        <ul class="pd-msg-list">
                            @foreach (var msg in _recentMessages.Take(3))
                            {
                                <li class="@(msg.IsUnread ? "is-unread" : null)">
                                    <div class="pd-msg-avatar">@GetInitials(msg.From)</div>
                                    <div class="pd-msg-body">
                                        <strong>@msg.From</strong>
                                        <span>@msg.Preview</span>
                                    </div>
                                    <time>@FormatRelativeDate(msg.CreatedAt)</time>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="pd-card pd-sub-card">
                    <div class="pd-card-head">
                        <h2>@L["ParentDashboard_ActivePlan"]</h2>
                    </div>
                    @if (_dashboard?.ActiveSubscription is null)
                    {
                        <div class="pd-soft-empty pd-soft-empty--sm">
                            <i class="bi bi-wallet2" aria-hidden="true"></i>
                            <p>@L["ParentDashboard_NoSubscription"]</p>
                            <a href="/parent/subscriptions" class="pd-link">@L["Nav_Subscriptions"]</a>
                        </div>
                    }
                    else
                    {
                        <div class="pd-sub-body">
                            <div class="pd-sub-check"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></div>
                            <div>
                                <strong>@_dashboard.ActiveSubscription.PlanName</strong>
                                <span class="pd-tag pd-tag--active">@L["ParentDashboard_SubscriptionActive"]</span>
                                <p>@L["ParentDashboard_Until", _dashboard.ActiveSubscription.EndDate.ToLocalTime().ToString("d MMM yyyy")]</p>
                            </div>
                        </div>
                    }
                </section>
            </div>
        </div>

        <!-- Accès rapides -->
        <section class="pd-section">
            <div class="pd-section-head">
                <h2>@L["ParentDashboard_QuickActions"]</h2>
            </div>
            <div class="pd-quick-row">
                <a href="/parent/calendar" class="pd-quick"><i class="bi bi-camera-video" aria-hidden="true"></i><span>@L["ParentDashboard_JoinClass"]</span></a>
                <a href="/parent/homework" class="pd-quick"><i class="bi bi-journal-text" aria-hidden="true"></i><span>@L["Nav_Homework"]</span></a>
                <a href="/parent/reports" class="pd-quick"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i><span>@L["Nav_Reports"]</span></a>
                <a href="/parent/documents" class="pd-quick"><i class="bi bi-folder2-open" aria-hidden="true"></i><span>@L["Nav_Documents"]</span></a>
                <a href="/parent/messages" class="pd-quick"><i class="bi bi-headset" aria-hidden="true"></i><span>@L["ParentDashboard_ContactUs"]</span></a>
            </div>
        </section>
    }
</div>

@code {
    private static readonly string[] AvatarColors =
        ["#5831e0", "#ec4899", "#0ea5e9", "#10b981", "#f59e0b", "#8b5cf6"];

    private bool _loading = true;
    private ParentDashboardDto? _dashboard;
    private int _lessonsToday;
    private string _nextCourseLabel = "—";
    private string _averageGradeDisplay = "—";
    private string _nextPaymentDisplay = "—";
    private string? _subscriptionPlan;
    private List<ParentDashboardChildDto> _children = [];
    private List<ParentDashboardSessionDto> _upcomingSessions = [];
    private List<ParentDashboardHomeworkDto> _homeworkItems = [];
    private List<ParentDashboardMessageDto> _recentMessages = [];
    private List<ParentDashboardCalendarDayDto> _weekDays = [];
    private ParentDashboardSessionDto? _featuredSession;

    protected override async Task OnInitializedAsync()
    {
        var profileTask = ParentProfile.EnsureLoadedAsync();

        try
        {
            _dashboard = await Api.GetAsync<ParentDashboardDto>("api/parent/dashboard");
            if (_dashboard is not null)
            {
                _children = _dashboard.Children.ToList();
                _lessonsToday = _dashboard.LessonsTodayCount;
                _upcomingSessions = _dashboard.UpcomingSessions.ToList();
                _homeworkItems = _dashboard.PendingHomework.ToList();
                _recentMessages = _dashboard.RecentMessages.ToList();
                _weekDays = _dashboard.WeekCalendar.ToList();
                _featuredSession = _upcomingSessions.FirstOrDefault();

                _nextCourseLabel = _dashboard.NextLessonStartTime is null
                    ? L["ParentDashboard_NextNone"]
                    : L["ParentDashboard_NextAt", _dashboard.NextLessonStartTime.Value.ToLocalTime().ToString("HH:mm")];

                _averageGradeDisplay = FormatGrade(_dashboard.AverageGrade);

                if (_dashboard.ActiveSubscription is not null)
                {
                    _nextPaymentDisplay = _dashboard.ActiveSubscription.EndDate.ToLocalTime().ToString("d MMM");
                    _subscriptionPlan = _dashboard.ActiveSubscription.PlanName;
                }
                else if (_dashboard.RecentPayment is not null)
                {
                    _nextPaymentDisplay = FormatPaymentAmount(_dashboard.RecentPayment);
                    _subscriptionPlan = L["Parent_RecentPayment"];
                }
                else
                {
                    _nextPaymentDisplay = "—";
                    _subscriptionPlan = L["ParentDashboard_NoSubscription"];
                }
            }
        }
        catch { }

        await profileTask;
        _loading = false;
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            : name.Length > 0 ? name[..1].ToUpperInvariant() : "?";
    }

    private string FormatGrade(decimal? grade) =>
        grade.HasValue ? $"{grade.Value:0.#}/20" : "—";

    private static string FormatPercent(int? percent) =>
        percent.HasValue ? $"{percent}%" : "—";

    private static string FormatSessionTime(DateTime startTime) =>
        startTime.ToLocalTime().ToString("dddd · HH:mm");

    private static string LessonModeLabel(string mode) => mode switch
    {
        "Online" => "En ligne",
        "InPerson" => "Présentiel",
        "Hybrid" => "Hybride",
        _ => mode
    };

    private (string Label, string Class) GetHomeworkTag(ParentDashboardHomeworkDto hw)
    {
        if (hw.IsGraded)
            return (L["Tag_Done"], "done");

        if (hw.DueDate.HasValue)
        {
            var due = hw.DueDate.Value.Date;
            if (due <= DateTime.Today.AddDays(1))
                return (L["Tag_Urgent"], "urgent");
            if (due <= DateTime.Today.AddDays(3))
                return (L["Tag_Important"], "important");
        }

        return (L["Tag_New"], "new");
    }

    private static string FormatDueDate(DateTime? dueDate) =>
        dueDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—";

    private static string FormatRelativeDate(DateTime dateTime)
    {
        var local = dateTime.ToLocalTime();
        var diff = DateTime.Now - local;
        if (diff.TotalHours < 1) return "à l'instant";
        if (diff.TotalHours < 24) return $"il y a {(int)diff.TotalHours}h";
        if (diff.TotalDays < 2) return "Hier";
        if (diff.TotalDays < 7) return $"Il y a {(int)diff.TotalDays} j";
        return local.ToString("dd/MM");
    }

    private static string FormatPaymentAmount(ParentDashboardPaymentDto payment) =>
        $"{payment.Amount:N2} {payment.Currency}";
}
