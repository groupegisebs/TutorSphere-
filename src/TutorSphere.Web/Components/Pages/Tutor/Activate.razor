@page "/tutor/activate"
@layout TutorLayout
@rendermode InteractiveServer
@using Microsoft.Extensions.Localization
@using TutorSphere.Web.Services
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Activate_Title"] — TutorSphere</PageTitle>

<div class="container py-4" style="max-width:640px">
    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (_status?.RequiresOnboarding == true)
    {
        <div class="alert alert-info">
            <h1 class="h4 mb-2">@L["Onboarding_NeedTraining"]</h1>
            <p class="mb-3">@L["Onboarding_AfterPay"]</p>
            <a class="btn btn-primary" href="/tutor/onboarding">@L["Onboarding_Start"]</a>
        </div>
    }
    else if (_status?.HasValidLicense == true && !_renewalMode)
    {
        <div class="alert alert-success">
            <h1 class="h4 mb-2">@L["Activate_AlreadyActive"]</h1>
            <p class="mb-3">
                @L["Activate_ExpiresOn"]
                <strong>@_status.LicenseExpiresAt?.ToLocalTime().ToString("d")</strong>
            </p>
            @if (_status.LicenseFeeWithholdingRemainingUsd > 0)
            {
                <p class="mb-3">@L["Activate_WithholdNotice", _status.LicenseFeeWithholdingRemainingUsd.ToString("0.##")]</p>
            }
            <a class="btn btn-primary" href="/tutor/dashboard">@L["Activate_GoDashboard"]</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <span class="badge text-bg-primary mb-3">@L["Activate_Badge"]</span>
                <h1 class="h3 mb-2">@L["Activate_Title"]</h1>
                <p class="text-muted mb-4">@L["Activate_Subtitle"]</p>

                <div class="d-flex align-items-baseline gap-2 mb-4">
                    <span class="display-5 fw-bold">@((_status?.AnnualFee ?? 10m).ToString("0.##"))&nbsp;$</span>
                    <span class="text-muted">@L["Activate_PerYear"] @(_status?.Currency ?? "USD")</span>
                </div>

                <ul class="list-unstyled mb-4">
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@L["Activate_F1"]</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@L["Activate_F2"]</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@L["Activate_F3"]</li>
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@L["Activate_F4"]</li>
                </ul>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger">@_error</div>
                }

                <button class="btn btn-primary btn-lg w-100" disabled="@_busy" @onclick="OpenPay">
                    @L["Activate_PayCta"]
                </button>

                <div class="text-center my-3 text-muted small">— ou —</div>

                <label class="form-label" for="promo-code">@L["Activate_PromoLabel"]</label>
                <div class="input-group mb-2">
                    <input id="promo-code" class="form-control font-monospace text-uppercase"
                           placeholder="@L["Activate_PromoPlaceholder"]"
                           maxlength="64"
                           @bind="_promoCode" @bind:event="oninput"
                           disabled="@_busy" />
                    <button class="btn btn-outline-primary" type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_promoCode))"
                            @onclick="RedeemPromoAsync">
                        @L["Activate_PromoCta"]
                    </button>
                </div>
                <p class="small text-muted mb-2">@L["Activate_PromoHint"]</p>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="activate-autorenew"
                           disabled="@_busy" @bind="_autoRenewAtSource" />
                    <label class="form-check-label" for="activate-autorenew">@L["Activate_AutoRenewLabel"]</label>
                </div>
                <p class="form-text mt-0">@L["Activate_AutoRenewHint"]</p>

                <p class="small text-muted mt-3 mb-0 text-center">@L["Activate_SecurePay"]</p>
            </div>
        </div>
    }
</div>

<PaymentCheckoutModal @bind-Visible="_payModalVisible"
                      IsPlatformLicense="true"
                      PayerName="@(_status?.SchoolName)"
                      PayerCountry="@(_status?.Country)"
                      Amount="@(_status?.AnnualFee ?? 10m)"
                      Currency="@(_status?.Currency ?? "USD")"
                      SuccessUrl="@_paySuccessUrl"
                      CancelUrl="@_payCancelUrl"
                      OnPaid="OnPayCompletedAsync"
                      OnError="OnPayError" />

@code {
    private PlatformLicenseStatusVm? _status;
    private bool _loading = true;
    private bool _busy;
    private bool _renewalMode;
    private string? _error;
    private string _promoCode = "";
    private bool _autoRenewAtSource;
    private bool _payModalVisible;
    private string _paySuccessUrl = "";
    private string _payCancelUrl = "";

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        var paid = query.TryGetValue("paid", out var paidVal)
                   && paidVal.ToString().Equals("1", StringComparison.OrdinalIgnoreCase);
        var paymentId = query.TryGetValue("paymentId", out var pid) && Guid.TryParse(pid, out var g) ? g : (Guid?)null;

        if (paid)
        {
            _busy = true;
            try
            {
                var confirmUrl = paymentId.HasValue
                    ? $"api/platform-billing/confirm?paymentId={paymentId}"
                    : "api/platform-billing/confirm";
                var confirm = await Api.PostWithErrorAsync<PlatformLicensePaymentStatusVm>(confirmUrl, new { });
                if (confirm.Value?.RequiresOnboarding == true || confirm.Value?.HasPaidLicense == true)
                {
                    Navigation.NavigateTo("/tutor/onboarding", forceLoad: true);
                    return;
                }
                if (confirm.Value?.HasValidLicense == true)
                {
                    Navigation.NavigateTo("/tutor/dashboard", forceLoad: true);
                    return;
                }
                _error = confirm.Error ?? L["Activate_ConfirmPending"];
            }
            finally
            {
                _busy = false;
            }
        }

        await ReloadStatusAsync();
        if (_status?.RequiresOnboarding == true)
        {
            Navigation.NavigateTo("/tutor/onboarding", forceLoad: true);
            return;
        }
        if (_status?.HasValidLicense == true && !_renewalMode && !paid
            && (_status.LicenseFeeWithholdingRemainingUsd <= 0))
        {
            Navigation.NavigateTo("/tutor/dashboard", forceLoad: true);
            return;
        }
        _loading = false;
    }

    private async Task ReloadStatusAsync()
    {
        _status = await Api.GetAsync<PlatformLicenseStatusVm>("api/platform-billing/status");
        _renewalMode = _status?.RenewalSoon == true;
    }

    private void OpenPay()
    {
        _error = null;
        var baseUri = Navigation.BaseUri.TrimEnd('/');
        _paySuccessUrl = $"{baseUri}/tutor/activate?paid=1";
        _payCancelUrl = $"{baseUri}/tutor/activate";
        _payModalVisible = true;
    }

    private async Task OnPayCompletedAsync()
    {
        await ReloadStatusAsync();
        if (_status?.HasValidLicense == true)
            Navigation.NavigateTo("/tutor/dashboard", forceLoad: true);
    }

    private void OnPayError(string message) => _error = message;

    private async Task RedeemPromoAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_promoCode))
        {
            _error = L["Activate_PromoRequired"];
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.PostWithErrorAsync<PlatformLicensePaymentStatusVm>(
                "api/platform-billing/redeem-promo",
                new { code = _promoCode.Trim(), autoRenewAtSource = _autoRenewAtSource });

            if (result.Value is null)
            {
                _error = result.Error ?? L["Activate_PromoInvalid"];
                return;
            }

            if (result.Value.RequiresOnboarding || result.Value.HasPaidLicense)
            {
                Navigation.NavigateTo("/tutor/onboarding", forceLoad: true);
                return;
            }

            if (result.Value.HasValidLicense)
            {
                Navigation.NavigateTo("/tutor/dashboard", forceLoad: true);
                return;
            }

            _error = L["Activate_PromoInvalid"];
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class PlatformLicenseStatusVm
    {
        public Guid TenantId { get; set; }
        public string SchoolName { get; set; } = "";
        public string Status { get; set; } = "";
        public bool HasValidLicense { get; set; }
        public bool HasPaidLicense { get; set; }
        public bool RequiresPayment { get; set; }
        public bool RequiresOnboarding { get; set; }
        public DateTime? LicenseExpiresAt { get; set; }
        public int? DaysUntilExpiry { get; set; }
        public decimal AnnualFee { get; set; }
        public string Currency { get; set; } = "USD";
        public bool RenewalSoon { get; set; }
        public decimal LicenseFeeWithholdingRemainingUsd { get; set; }
        public string? Country { get; set; }
    }

    private sealed class PlatformLicensePaymentStatusVm
    {
        public bool HasValidLicense { get; set; }
        public bool HasPaidLicense { get; set; }
        public bool RequiresOnboarding { get; set; }
    }
}
