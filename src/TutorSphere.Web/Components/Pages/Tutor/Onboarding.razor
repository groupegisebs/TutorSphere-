@page "/tutor/onboarding"
@layout TutorLayout
@rendermode InteractiveServer
@using Microsoft.Extensions.Localization
@using TutorSphere.Web.Services
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Onboarding_Title"] — TutorSphere</PageTitle>

<div class="container py-4" style="max-width:820px">
    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (_status is null)
    {
        <div class="alert alert-danger">@(_error ?? L["Onboarding_LoadError"])</div>
        <a class="btn btn-outline-primary" href="/tutor/activate">@L["Activate_Title"]</a>
    }
    else if (_status.IsFullyActive)
    {
        <div class="alert alert-success">
            <h1 class="h4">@L["Onboarding_Done"]</h1>
            <p>@L["Onboarding_Visible"]</p>
            <a class="btn btn-primary" href="/tutor/dashboard">@L["Activate_GoDashboard"]</a>
        </div>
    }
    else if (!_status.HasPaidLicense)
    {
        <div class="alert alert-warning">
            <h1 class="h4">@L["Onboarding_NeedPay"]</h1>
            <a class="btn btn-primary" href="/tutor/activate">@L["Activate_PayCta"]</a>
        </div>
    }
    else
    {
        <div class="mb-4">
            <span class="badge text-bg-primary mb-2">@L["Onboarding_Badge"]</span>
            <h1 class="h3 mb-2">@L["Onboarding_Title"]</h1>
            <p class="text-muted">@L["Onboarding_Subtitle"]</p>
            <div class="progress mb-2" style="height:8px">
                <div class="progress-bar" style="width:@ProgressPct%"></div>
            </div>
            <div class="small text-muted">@_status.CompletedModuleCount / @_status.TotalModuleCount</div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        @if (_current is null)
        {
            <div class="alert alert-info">@L["Onboarding_AllModules"]</div>
        }
        else
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4">
                    <h2 class="h5">@_current.Order. @_current.Title</h2>
                    <p class="text-muted">@_current.Summary</p>
                    <div class="onboarding-body mb-4">@((MarkupString)_current.BodyHtml)</div>

                    @if (_current.Quiz is { Count: > 0 })
                    {
                        <h3 class="h6 mb-3">@L["Onboarding_Quiz"]</h3>
                        @for (var i = 0; i < _current.Quiz.Count; i++)
                        {
                            var qi = i;
                            var q = _current.Quiz[i];
                            <div class="mb-3">
                                <div class="fw-semibold mb-2">@q.Question</div>
                                @for (var c = 0; c < q.Choices.Count; c++)
                                {
                                    var ci = c;
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio"
                                               name="q@qi" id="q@(qi)_@ci"
                                               checked="@(_answers.ElementAtOrDefault(qi) == ci)"
                                               @onchange="() => SetAnswer(qi, ci)" />
                                        <label class="form-check-label" for="q@(qi)_@ci">@q.Choices[c]</label>
                                    </div>
                                }
                            </div>
                        }
                    }

                    <button class="btn btn-primary" disabled="@_busy" @onclick="CompleteCurrentAsync">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @L["Onboarding_Validate"]
                    </button>
                </div>
            </div>
        }

        <div class="list-group">
            @foreach (var m in _status.Modules)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@m.Order. @m.Title</span>
                    @if (m.IsCompleted)
                    {
                        <i class="bi bi-check-circle-fill text-success"></i>
                    }
                    else if (_current?.Id == m.Id)
                    {
                        <span class="badge text-bg-primary">@L["Onboarding_InProgress"]</span>
                    }
                    else
                    {
                        <span class="badge text-bg-light text-muted">@L["Onboarding_Locked"]</span>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private OnboardingStatusVm? _status;
    private OnboardingModuleVm? _current;
    private readonly List<int> _answers = [];
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    private int ProgressPct =>
        _status is null || _status.TotalModuleCount == 0
            ? 0
            : (int)(100.0 * _status.CompletedModuleCount / _status.TotalModuleCount);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _error = null;
        _status = await Api.GetAsync<OnboardingStatusVm>("api/tutor-onboarding/status");
        if (_status?.IsFullyActive == true)
        {
            Navigation.NavigateTo("/tutor/dashboard", forceLoad: true);
            return;
        }

        if (_status is { HasPaidLicense: false })
        {
            Navigation.NavigateTo("/tutor/activate", forceLoad: true);
            return;
        }

        _current = _status?.Modules.OrderBy(m => m.Order).FirstOrDefault(m => !m.IsCompleted);
        _answers.Clear();
        if (_current?.Quiz is { Count: > 0 } quiz)
        {
            for (var i = 0; i < quiz.Count; i++)
                _answers.Add(-1);
        }
    }

    private void SetAnswer(int questionIndex, int choiceIndex)
    {
        while (_answers.Count <= questionIndex)
            _answers.Add(-1);
        _answers[questionIndex] = choiceIndex;
    }

    private async Task CompleteCurrentAsync()
    {
        if (_current is null) return;
        _error = null;
        _busy = true;
        try
        {
            if (_current.Quiz.Count > 0 && _answers.Any(a => a < 0))
            {
                _error = L["Onboarding_AnswerAll"];
                return;
            }

            var result = await Api.PostWithErrorAsync<CompleteModuleVm>(
                "api/tutor-onboarding/modules/complete",
                new { moduleId = _current.Id, quizAnswers = _answers });

            if (!string.IsNullOrEmpty(result.Error) || !string.IsNullOrEmpty(result.Value?.Error))
            {
                _error = result.Value?.Error ?? result.Error ?? L["Onboarding_Failed"];
                return;
            }

            if (result.Value?.OnboardingCompleted == true)
            {
                Navigation.NavigateTo("/tutor/dashboard", forceLoad: true);
                return;
            }

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class OnboardingStatusVm
    {
        public Guid TenantId { get; set; }
        public string SchoolName { get; set; } = "";
        public bool HasPaidLicense { get; set; }
        public bool RequiresOnboarding { get; set; }
        public bool IsFullyActive { get; set; }
        public List<OnboardingModuleVm> Modules { get; set; } = [];
        public int CompletedModuleCount { get; set; }
        public int TotalModuleCount { get; set; }
    }

    private sealed class OnboardingModuleVm
    {
        public string Id { get; set; } = "";
        public int Order { get; set; }
        public string Title { get; set; } = "";
        public string Summary { get; set; } = "";
        public string BodyHtml { get; set; } = "";
        public List<QuizItemVm> Quiz { get; set; } = [];
        public bool IsCompleted { get; set; }
    }

    private sealed class QuizItemVm
    {
        public string Question { get; set; } = "";
        public List<string> Choices { get; set; } = [];
        public int CorrectIndex { get; set; }
    }

    private sealed class CompleteModuleVm
    {
        public string ModuleId { get; set; } = "";
        public bool ModuleCompleted { get; set; }
        public bool OnboardingCompleted { get; set; }
        public bool IsFullyActive { get; set; }
        public string? Error { get; set; }
    }
}
