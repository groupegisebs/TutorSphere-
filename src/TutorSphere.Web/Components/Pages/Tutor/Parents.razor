@page "/tutor/parents"
@layout TutorLayout
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResources> L
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Nav
@using TutorSphere.Web.Common

<PageTitle>@L["Parents_Title"] – TutorSphere</PageTitle>

<div class="ts-page-header">
    <div>
        <h1><i class="bi bi-person-hearts me-2"></i>@L["Parents_Title"]</h1>
        <p class="ts-page-subtitle">@string.Format(L["Parents_CountEnrolled"].Value, _parents.Count)</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(_loadError))
{
    <div class="alert alert-danger">@_loadError</div>
}

<div class="alert alert-light border d-flex align-items-start gap-2">
    <i class="bi bi-shield-lock text-primary mt-1"></i>
    <span class="small mb-0">@L["Parents_PrivacyNotice"]</span>
</div>

<div class="ts-toolbar">
    <div class="ts-search-box">
        <i class="bi bi-search ts-search-icon"></i>
        <input class="form-control" placeholder="@L["Parents_Search"]"
               @bind="_search" @bind:event="oninput" />
    </div>
</div>

@if (_loading)
{
    <div class="ts-loading-state" style="padding:2rem;">
        <div class="spinner-border text-primary" role="status"></div>
        <span class="ms-2 text-muted">@L["Parents_Loading"]</span>
    </div>
}
else if (_parents.Count == 0)
{
    <div class="ts-empty-card">
        <i class="bi bi-person-hearts ts-empty-icon"></i>
        <p>@L["Parents_EmptyEnrolled"]</p>
    </div>
}
else if (!FilteredParents.Any())
{
    <div class="ts-empty-card">
        <i class="bi bi-search ts-empty-icon"></i>
        <p>@L["Parents_None"]</p>
    </div>
}
else
{
    <div class="ts-table-card">
        <table class="table ts-table">
            <thead>
                <tr>
                    <th>@L["Parents_Title"]</th>
                    <th>@L["Parents_Children"]</th>
                    <th>@L["Parents_ChildCountry"]</th>
                    <th>@L["Common_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in FilteredParents)
                {
                    <tr>
                        <td>
                            <div class="ts-cell-user">
                                <div class="ts-avatar" style="background:@p.Color">@p.Initials</div>
                                <div><strong>@p.FullName</strong></div>
                            </div>
                        </td>
                        <td>
                            @if (p.Children.Count == 0)
                            {
                                <span class="text-muted">@p.ChildrenCount @L["Parents_ChildrenCount"]</span>
                            }
                            else
                            {
                                @foreach (var c in p.Children)
                                {
                                    <span class="ts-badge ts-badge-neutral me-1">@c.FullName</span>
                                }
                            }
                        </td>
                        <td>
                            @{
                                var countries = p.Children
                                    .Select(c => c.Country)
                                    .Where(code => !string.IsNullOrWhiteSpace(code))
                                    .Distinct(StringComparer.OrdinalIgnoreCase)
                                    .ToList();
                            }
                            @if (countries.Count == 0)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @foreach (var code in countries)
                                {
                                    <span class="ts-badge ts-badge-neutral me-1">@CountryLabel(code)</span>
                                }
                            }
                        </td>
                        <td>
                            <div class="ts-action-group">
                                <button type="button" class="ts-icon-btn" title="@L["Common_View"]" @onclick="() => OpenDetail(p)"><i class="bi bi-eye"></i></button>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        disabled="@(!p.CanMessage)"
                                        title="@(p.CanMessage ? L["Parents_SendMessage"].Value : L["Parents_NoMailbox"].Value)"
                                        @onclick="() => OpenMessage(p)">
                                    <i class="bi bi-chat-dots me-1"></i>@L["Parents_SendMessage"]
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_selected != null)
{
    <div class="ts-modal-backdrop" @onclick="() => _selected = null">
        <div class="ts-modal ts-modal-lg" @onclick:stopPropagation="true">
            <div class="ts-modal-header">
                <div class="ts-avatar ts-avatar-lg" style="background:@_selected.Color">@_selected.Initials</div>
                <div>
                    <h2>@_selected.FullName</h2>
                </div>
                <button type="button" class="ts-modal-close" @onclick="() => _selected = null"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="ts-modal-tabs">
                <button type="button" class="ts-tab @(_pTab == "info" ? "active" : "")" @onclick='() => _pTab = "info"'>@L["Parents_Info"]</button>
                <button type="button" class="ts-tab @(_pTab == "children" ? "active" : "")" @onclick='() => _pTab = "children"'>@L["Parents_Children"]</button>
            </div>
            <div class="ts-modal-body">
                @if (_pTab == "info")
                {
                    <div class="ts-form-grid">
                        <div class="ts-form-row"><label>@L["Parents_FullName"]</label><span>@_selected.FullName</span></div>
                        <div class="ts-form-row">
                            <label>@L["Parents_Children"]</label>
                            <span>@_selected.ChildrenCount @L["Parents_ChildrenCount"]</span>
                        </div>
                    </div>
                    <p class="text-muted small mt-3 mb-0">@L["Parents_PrivacyNotice"]</p>
                }
                else if (_pTab == "children")
                {
                    @if (_childrenLoading)
                    {
                        <div class="text-muted">@L["Common_Loading"]</div>
                    }
                    else if (_selected.Children.Count == 0)
                    {
                        <p class="ts-empty-inline">@L["Parents_NoChildren"]</p>
                    }
                    else
                    {
                        @foreach (var c in _selected.Children)
                        {
                            <div class="ts-list-item">
                                <i class="bi bi-person me-2 text-primary"></i>
                                <span>@c.FullName</span>
                                @if (!string.IsNullOrWhiteSpace(c.Country))
                                {
                                    <span class="ts-badge ts-badge-neutral ms-2">@CountryLabel(c.Country)</span>
                                }
                            </div>
                        }
                    }
                }
            </div>
            <div class="ts-modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => _selected = null">@L["Common_Close"]</button>
                <button type="button" class="btn btn-primary" disabled="@(!_selected.CanMessage)"
                        @onclick="() => OpenMessage(_selected)">
                    <i class="bi bi-chat-dots me-1"></i>@L["Parents_SendMessage"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string _search = "";
    private ParentVM? _selected;
    private string _pTab = "info";
    private bool _loading = true;
    private bool _childrenLoading;
    private string _loadError = "";
    private readonly List<ParentVM> _parents = [];
    private static readonly string[] Colors = ["#7c3aed", "#0ea5e9", "#10b981", "#f59e0b"];

    private IEnumerable<ParentVM> FilteredParents => _parents
        .Where(p => string.IsNullOrEmpty(_search) ||
            p.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            p.Children.Any(c => c.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = "";
        try
        {
            var result = await Api.GetWithErrorAsync<List<ApiParentDto>>("api/parents");
            if (result.Error is not null)
            {
                _loadError = result.Error;
                _parents.Clear();
                return;
            }

            _parents.Clear();
            var list = result.Value ?? [];
            for (var i = 0; i < list.Count; i++)
                _parents.Add(MapParent(list[i], i));
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenDetail(ParentVM p)
    {
        _selected = p;
        _pTab = "info";
        _childrenLoading = true;
        try
        {
            var children = await Api.GetAsync<List<ApiChildDto>>($"api/parents/{p.Id}/children") ?? [];
            if (children.Count > 0)
            {
                p.Children = children
                    .Select(c => new ChildVM(c.FirstName, c.LastName, c.Country))
                    .ToList();
            }
        }
        catch
        {
            // la liste envoyée avec les parents reste affichée
        }
        finally
        {
            _childrenLoading = false;
        }
    }

    private void OpenMessage(ParentVM p)
    {
        if (!p.CanMessage) return;
        _selected = null;
        Nav.NavigateTo($"tutor/messages?to={Uri.EscapeDataString(p.MessagingUserId!)}&name={Uri.EscapeDataString(p.FullName)}&role=parent");
    }

    private static ParentVM MapParent(ApiParentDto d, int index) => new()
    {
        Id = d.Id,
        FullName = $"{d.FirstName} {d.LastName}".Trim(),
        ChildrenCount = d.ChildrenCount,
        Children = (d.Children ?? []).Select(c => new ChildVM(c.FirstName, c.LastName, c.Country)).ToList(),
        MessagingUserId = d.MessagingUserId,
        Color = Colors[index % Colors.Length]
    };

    private static string CountryLabel(string? code)
    {
        var info = CountryCatalog.Find(code);
        return info is null ? (code ?? "—") : $"{info.Flag} {info.Name}";
    }

    private record ApiParentDto(
        Guid Id, string FirstName, string LastName, int ChildrenCount,
        List<ApiChildDto>? Children, string? MessagingUserId);

    private record ApiChildDto(Guid Id, string FirstName, string LastName, string? Country = null);

    private sealed record ChildVM(string FirstName, string LastName, string? Country)
    {
        public string FullName => $"{FirstName} {LastName}".Trim();
    }

    private class ParentVM
    {
        public Guid Id { get; set; }
        public string FullName { get; set; } = "";
        public int ChildrenCount { get; set; }
        public List<ChildVM> Children { get; set; } = [];
        public string? MessagingUserId { get; set; }
        public bool CanMessage => !string.IsNullOrWhiteSpace(MessagingUserId);
        public string Color { get; set; } = "#7c3aed";
        public string Initials
        {
            get
            {
                var parts = FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
                return FullName.Length > 0 ? FullName[..1].ToUpperInvariant() : "?";
            }
        }
    }
}
