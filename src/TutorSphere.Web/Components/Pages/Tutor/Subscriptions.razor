@page "/tutor/subscriptions"
@layout TutorLayout
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResources> L
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>@L["TutorSubs_Title"] – TutorSphere</PageTitle>

<div class="ts-page-header">
    <div>
        <h1><i class="bi bi-arrow-repeat me-2"></i>@L["TutorSubs_Title"]</h1>
        <p class="ts-page-subtitle">@L["TutorSubs_Subtitle"]</p>
    </div>
    <button class="btn btn-primary" @onclick="ResetPlanForm">
        <i class="bi bi-plus-lg me-1"></i>@L["TutorSubs_CreatePlan"]
    </button>
</div>

@if (!string.IsNullOrEmpty(_loadError))
{
    <div class="alert alert-warning mb-3" role="alert">@_loadError</div>
}
@if (!string.IsNullOrEmpty(_actionError))
{
    <div class="alert alert-danger mb-3" role="alert">@_actionError</div>
}
@if (!string.IsNullOrEmpty(_actionBanner))
{
    <div class="alert alert-success mb-3" role="alert">@_actionBanner</div>
}

<!-- KPIs -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="ts-kpi-card ts-kpi-card--success">
            <span class="ts-kpi-val">@_subs.Count(s => IsActiveStatus(s.Status))</span>
            <span class="ts-kpi-label">@L["TutorSubs_Active"]</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
                <div class="ts-kpi-card ts-kpi-card--warning">
                    <span class="ts-kpi-val">@_subs.Count(s => string.Equals(s.Status, "Pending", StringComparison.OrdinalIgnoreCase))</span>
                    <span class="ts-kpi-label">@L["TutorSubs_StatusPending"]</span>
                </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ts-kpi-card">
            <span class="ts-kpi-val">@_subs.Where(s => IsActiveStatus(s.Status)).Sum(s => s.Amount).ToString("N0") @DisplayCurrencyLabel</span>
            <span class="ts-kpi-label">@L["TutorSubs_MRR"]</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ts-kpi-card">
            <span class="ts-kpi-val">@AvgActiveAmount().ToString("N0") @DisplayCurrencyLabel</span>
            <span class="ts-kpi-label">@L["TutorSubs_AvgAmount"]</span>
        </div>
    </div>
</div>

<div class="section-card mb-3 p-3">
    <h2 class="h6 fw-bold mb-3">Nouveau plan (brouillon)</h2>
    <div class="row g-2">
        <div class="col-md-6">
            <label class="form-label">Nom *</label>
            <input class="form-control" @bind="_name" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Code</label>
            <input class="form-control" @bind="_code" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Prix recommandé (@PreviewCurrencyLabel)</label>
            <input class="form-control" type="number" @bind="_price" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Portée *</label>
            <select class="form-select" @bind="_scope" @bind:after="OnScopeChanged">
                <option value="local">Locale (pays de l'enseignant)</option>
                <option value="international">Internationale</option>
            </select>
        </div>
        @if (IsInternational)
        {
            <div class="col-md-4">
                <label class="form-label">Pays de marché *</label>
                <CountrySelect Value="@_marketCountry" ValueChanged="OnMarketCountryChanged" Placeholder="Pays cible" />
            </div>
        }
        <div class="col-md-4">
            <label class="form-label">Devise (automatique)</label>
            <input class="form-control" value="@PreviewCurrencyLabel" disabled readonly />
        </div>
        <div class="col-12">
            <label class="form-label">Description courte</label>
            <input class="form-control" @bind="_short" />
        </div>
    </div>
    <div class="d-flex gap-2 mt-2">
        <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="SavePlan">
            @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Créer
        </button>
    </div>
    <p class="small text-muted mt-2 mb-0">
        Devise internationale : Europe → EUR · Canada → $CAD · USA → $USD · Cameroun / Afrique → XAF.
    </p>
</div>

<!-- Plans section -->
<div class="section-card mb-4">
    <div class="section-card-header">
        <h2>@L["TutorSubs_MyPlans"]</h2>
    </div>
    @if (_plans.Count == 0)
    {
        <p class="text-muted mb-0 p-4">Aucun plan.</p>
    }
    else
    {
        <div class="sub-plans-grid">
            @foreach (var plan in _plans)
            {
                <div class="sub-plan-card">
                    @if (!string.IsNullOrWhiteSpace(plan.OwnerTeacherName))
                    {
                        <span class="sub-plan-teacher-tag">
                            <i class="bi bi-person-badge me-1"></i>@plan.OwnerTeacherName
                        </span>
                    }
                    <h3>@plan.Name</h3>
                    @if (!string.IsNullOrWhiteSpace(plan.Code) || plan.IsInternational)
                    {
                        <div class="small text-muted">
                            @if (!string.IsNullOrWhiteSpace(plan.Code)) { <span>@plan.Code</span> }
                            @if (!string.IsNullOrWhiteSpace(plan.Code) && (plan.IsInternational || !string.IsNullOrWhiteSpace(plan.MarketCountryCode)))
                            { <span> · </span> }
                            @(plan.IsInternational ? "Internationale" : "Locale")
                            @if (!string.IsNullOrWhiteSpace(plan.MarketCountryCode))
                            {
                                <span> · @plan.MarketCountryCode</span>
                            }
                        </div>
                    }
                    <div class="sub-plan-price">
                        <span class="sub-plan-amount">@plan.Price.ToString("N0")</span>
                        <span class="sub-plan-period">@GroupOfferCurrencyRules.FormatCurrencyLabel(plan.Currency)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(plan.Description))
                    {
                        <p class="small text-muted mb-0">@plan.Description</p>
                    }
                    <div class="sub-plan-footer">
                        <span class="text-muted small">@string.Format(L["TutorSubs_Subscribers"].Value, _subs.Count(s => s.PlanName == plan.Name && IsActiveStatus(s.Status)))</span>
                        <div class="d-flex gap-1">
                            <button class="ts-icon-btn" title="@(plan.IsActive ? L["TutorSubs_Deactivate"] : L["TutorSubs_Activate"])"
                                    @onclick="async () => await TogglePlan(plan)">
                                <i class="bi @(plan.IsActive ? "bi-toggle-on text-success" : "bi-toggle-off text-muted")"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Subscribers table -->
<div class="section-card">
    <div class="section-card-header">
        <h2>@L["TutorSubs_SubscribersTitle"]</h2>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm w-auto" @bind="_filterSubStatus">
                <option value="">@L["Common_All"]</option>
                <option value="Pending">@L["TutorSubs_StatusPending"]</option>
                <option value="AwaitingPayment">@L["TutorSubs_StatusAwaitingPayment"]</option>
                <option value="Active">@L["TutorSubs_StatusActive"]</option>
                <option value="Paused">@L["TutorSubs_StatusSuspended"]</option>
                <option value="Rejected">@L["TutorSubs_StatusRejected"]</option>
                <option value="Cancelled">@L["TutorSubs_StatusCancelled"]</option>
            </select>
        </div>
    </div>
    @if (_loading)
    {
        <div class="d-flex align-items-center justify-content-center py-4">
            <span class="spinner-border text-primary me-2" role="status"></span>
            <span class="text-muted">@L["Common_Loading"]</span>
        </div>
    }
    else if (!FilteredSubs.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-people fs-1 d-block mb-2 opacity-50"></i>
            <p class="mb-0">@L["TutorSubs_NoSubscribers"]</p>
        </div>
    }
    else
    {
        <table class="table ts-table">
            <thead>
                <tr>
                    <th>@L["TutorSubs_StudentParent"]</th>
                    <th>@L["TutorSubs_Plan"]</th>
                    <th>@L["TutorSubs_Amount"]</th>
                    <th>@L["TutorSubs_Renewal"]</th>
                    <th>@L["Common_Status"]</th>
                    <th>@L["Common_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in FilteredSubs)
                {
                    <tr class="@(s.ExpiresAt <= DateTime.Today.AddDays(7) && IsActiveStatus(s.Status) ? "ts-row-warning" : "")">
                        <td>
                            <div><strong>@s.StudentName</strong></div>
                            <small class="text-muted">@(string.IsNullOrWhiteSpace(s.ParentName) ? "—" : s.ParentName)</small>
                        </td>
                        <td><span class="ts-badge ts-badge-neutral">@s.PlanName</span></td>
                        <td class="fw-semibold">@s.Amount.ToString("N2") @DisplayCurrencyLabel</td>
                        <td>@s.ExpiresAt.ToString("dd/MM/yyyy")
                            @if (s.ExpiresAt <= DateTime.Today.AddDays(14) && IsActiveStatus(s.Status))
                            {
                                <span class="text-warning ms-1"><i class="bi bi-exclamation-circle"></i></span>
                            }
                        </td>
                        <td><span class="ts-badge @SubBadge(s.Status)">@SubStatusLabel(s.Status)</span></td>
                        <td>
                            <div class="ts-action-group">
                                @if (string.Equals(s.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="btn btn-sm btn-success"
                                            disabled="@(_busyId == s.Id)"
                                            title="@L["TutorSubs_Accept"]"
                                            @onclick="async () => await AcceptAsync(s)">
                                        @if (_busyId == s.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-lg me-1"></i>@L["TutorSubs_Accept"]
                                        }
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@(_busyId == s.Id)"
                                            title="@L["TutorSubs_Refuse"]"
                                            @onclick="async () => await RejectAsync(s)">
                                        <i class="bi bi-x-lg me-1"></i>@L["TutorSubs_Refuse"]
                                    </button>
                                }
                                else if (s.Status == "Active")
                                {
                                    <button class="ts-icon-btn" title="@L["TutorSubs_Suspend"]" @onclick="async () => await PauseAsync(s)">
                                        <i class="bi bi-pause-circle text-warning"></i>
                                    </button>
                                }
                                else if (s.Status == "Paused")
                                {
                                    <button class="ts-icon-btn" title="@L["TutorSubs_Reactivate"]" @onclick="async () => await ResumeAsync(s)">
                                        <i class="bi bi-play-circle text-success"></i>
                                    </button>
                                }
                                <a class="ts-icon-btn" title="@L["TutorSubs_Invoice"]" href="/tutor/payments"><i class="bi bi-receipt"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private string _filterSubStatus = "";
    private bool _loading = true;
    private bool _saving;
    private bool _initialLoadDone;
    private string? _loadError;
    private string? _actionError;
    private string? _actionBanner;
    private Guid? _busyId;
    private string _name = "";
    private string? _code;
    private string? _short;
    private decimal? _price;
    private string _scope = "local";
    private string? _marketCountry;
    private string? _teacherCountry;
    private string? _teacherName;

    private bool IsInternational => string.Equals(_scope, "international", StringComparison.OrdinalIgnoreCase);
    private string PreviewCurrencyLabel => GroupOfferCurrencyRules.FormatCurrencyLabel(
        GroupOfferCurrencyRules.ResolveOfferCurrency(IsInternational, _marketCountry, _teacherCountry));
    private string DisplayCurrencyLabel => _plans.Count > 0
        ? GroupOfferCurrencyRules.FormatCurrencyLabel(_plans[0].Currency)
        : PreviewCurrencyLabel;

    private static bool IsActiveStatus(string status) =>
        status is "Active" or "Actif";

    private decimal AvgActiveAmount()
    {
        var active = _subs.Where(s => IsActiveStatus(s.Status)).ToList();
        return active.Count > 0 ? Math.Round(active.Average(s => s.Amount), 0) : 0;
    }

    private static string SubBadge(string s) => s switch {
        "Active" or "Actif" => "ts-badge-success",
        "Paused" or "Suspendu" or "AwaitingPayment" or "Pending" => "ts-badge-warning",
        "Cancelled" or "Résilié" or "Rejected" => "ts-badge-danger",
        "Expired" => "ts-badge-neutral",
        _ => "ts-badge-neutral"
    };

    private string SubStatusLabel(string s) => s switch {
        "Active" or "Actif" => L["TutorSubs_StatusActive"],
        "Paused" or "Suspendu" => L["TutorSubs_StatusSuspended"],
        "Cancelled" or "Résilié" => L["TutorSubs_StatusCancelled"],
        "Pending" => L["TutorSubs_StatusPending"],
        "AwaitingPayment" => L["TutorSubs_StatusAwaitingPayment"],
        "Rejected" => L["TutorSubs_StatusRejected"],
        "Expired" => L["TutorSubs_StatusExpired"],
        _ => s
    };

    private IEnumerable<SubVM> FilteredSubs => _subs
        .Where(s => string.IsNullOrEmpty(_filterSubStatus) || s.Status == _filterSubStatus)
        .OrderBy(s => string.Equals(s.Status, "Pending", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
        .ThenBy(s => s.ExpiresAt);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialLoadDone)
            return;

        _initialLoadDone = true;
        await Auth.EnsureSessionRestoredAsync(forceJs: true);
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
                .TryGetValue("status", out var status)
            && !string.IsNullOrWhiteSpace(status))
            _filterSubStatus = status.ToString();
        await LoadProfileAsync();
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadProfileAsync()
    {
        _teacherName = Auth.SchoolName ?? Auth.UserName;
        if (Auth.TenantId is not Guid tenantId)
            return;

        try
        {
            var profile = await Api.GetAsync<TutorProfileDto>($"api/tenants/{tenantId}/profile");
            if (profile is null)
                return;
            if (!string.IsNullOrWhiteSpace(profile.Name))
                _teacherName = profile.Name;
            _teacherCountry = profile.Country;
        }
        catch
        {
            /* devise locale XAF si pays inconnu */
        }
    }

    private Task OnScopeChanged()
    {
        if (!IsInternational)
            _marketCountry = null;
        return Task.CompletedTask;
    }

    private Task OnMarketCountryChanged(string? code)
    {
        _marketCountry = code;
        return Task.CompletedTask;
    }

    private void ResetPlanForm()
    {
        _name = "";
        _code = _short = null;
        _price = null;
        _scope = "local";
        _marketCountry = null;
        _actionError = null;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var offeringsTask = Api.GetAsync<List<ApiOfferingDto>>("api/subscription-offerings");
            var subscribersTask = Api.GetAsync<List<ApiSubscriberDto>>("api/subscription-offerings/subscribers");
            await Task.WhenAll(offeringsTask, subscribersTask);

            var offerings = await offeringsTask ?? [];
            _plans.Clear();
            foreach (var o in offerings)
            {
                _plans.Add(MapPlan(o));
            }

            var subscribers = await subscribersTask ?? [];
            _subs.Clear();
            _subs.AddRange(subscribers.Select(MapSubscriber));
        }
        catch (Exception ex)
        {
            _loadError = string.Format(L["TutorSubs_LoadError"].Value, ex.Message);
        }
        finally { _loading = false; }
    }

    private static SubVM MapSubscriber(ApiSubscriberDto s) => new()
    {
        Id = s.Id,
        StudentName = s.StudentName,
        ParentName = s.ParentName ?? "",
        PlanName = s.OfferingTitle,
        Amount = s.Price,
        ExpiresAt = s.EndDate.Kind == DateTimeKind.Utc ? s.EndDate.ToLocalTime().Date : s.EndDate.Date,
        Status = s.Status
    };

    private async Task AcceptAsync(SubVM sub)
    {
        _busyId = sub.Id;
        _actionError = null;
        _actionBanner = null;
        try
        {
            var result = await Api.PostWithErrorAsync<ApiSubscriberDto>(
                $"api/subscription-offerings/subscribers/{sub.Id}/accept",
                new { });
            if (result.Error is not null || result.Value is null)
            {
                _actionError = result.Error ?? L["TutorSubs_ActionFailed"];
                return;
            }

            ApplySubscriberUpdate(sub.Id, result.Value);
            _actionBanner = result.Value.Status == "Active"
                ? L["TutorSubs_AcceptActiveBanner"]
                : L["TutorSubs_AcceptPaymentBanner"];
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally { _busyId = null; }
    }

    private async Task RejectAsync(SubVM sub)
    {
        _busyId = sub.Id;
        _actionError = null;
        _actionBanner = null;
        try
        {
            var result = await Api.PostWithErrorAsync<ApiSubscriberDto>(
                $"api/subscription-offerings/subscribers/{sub.Id}/reject",
                new { });
            if (result.Error is not null || result.Value is null)
            {
                _actionError = result.Error ?? L["TutorSubs_ActionFailed"];
                return;
            }

            ApplySubscriberUpdate(sub.Id, result.Value);
            _actionBanner = L["TutorSubs_RejectBanner"];
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally { _busyId = null; }
    }

    private async Task PauseAsync(SubVM sub)
    {
        _busyId = sub.Id;
        _actionError = null;
        try
        {
            var result = await Api.PostWithErrorAsync<ApiSubscriberDto>(
                $"api/subscription-offerings/subscribers/{sub.Id}/pause", new { });
            if (result.Value is not null) ApplySubscriberUpdate(sub.Id, result.Value);
            else _actionError = result.Error;
        }
        finally { _busyId = null; }
    }

    private async Task ResumeAsync(SubVM sub)
    {
        _busyId = sub.Id;
        _actionError = null;
        try
        {
            var result = await Api.PostWithErrorAsync<ApiSubscriberDto>(
                $"api/subscription-offerings/subscribers/{sub.Id}/resume", new { });
            if (result.Value is not null) ApplySubscriberUpdate(sub.Id, result.Value);
            else _actionError = result.Error;
        }
        finally { _busyId = null; }
    }

    private void ApplySubscriberUpdate(Guid id, ApiSubscriberDto dto)
    {
        var idx = _subs.FindIndex(s => s.Id == id);
        if (idx < 0) return;
        _subs[idx] = MapSubscriber(dto);
    }

    private PlanVM MapPlan(ApiOfferingDto o) => new()
    {
        ApiId = o.Id,
        Name = o.Title,
        Code = o.Code,
        Description = o.Description,
        Price = o.Price,
        Currency = string.IsNullOrWhiteSpace(o.Currency) ? "XAF" : o.Currency,
        IsInternational = o.IsInternational,
        MarketCountryCode = o.MarketCountryCode,
        OwnerTeacherName = string.IsNullOrWhiteSpace(o.OwnerTeacherName) ? _teacherName : o.OwnerTeacherName,
        IsActive = o.IsActive
    };

    private async Task SavePlan()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _actionError = "Le nom du plan est requis.";
            return;
        }

        if (IsInternational && string.IsNullOrWhiteSpace(_marketCountry))
        {
            _actionError = "Sélectionnez un pays de marché pour une offre internationale.";
            return;
        }

        _saving = true;
        _actionError = null;
        _actionBanner = null;
        try
        {
            var currency = GroupOfferCurrencyRules.ResolveOfferCurrency(
                IsInternational, _marketCountry, _teacherCountry);
            var req = new
            {
                title = _name.Trim(),
                description = _short,
                subject = _name.Trim(),
                price = _price ?? 0,
                currency,
                durationDays = 30,
                sessionCount = 4,
                frequency = "mois",
                code = _code,
                isInternational = IsInternational,
                marketCountryCode = IsInternational ? _marketCountry : null
            };
            var result = await Api.PostWithErrorAsync<ApiOfferingDto>("api/subscription-offerings", req);
            if (result.Error is not null || result.Value is null)
            {
                _actionError = result.Error ?? L["TutorSubs_ActionFailed"];
                return;
            }

            _plans.Insert(0, MapPlan(result.Value));
            _actionBanner = "Plan créé et tagué à votre nom.";
            ResetPlanForm();
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally { _saving = false; }
    }

    private async Task TogglePlan(PlanVM plan)
    {
        if (plan.ApiId is null) { plan.IsActive = !plan.IsActive; return; }
        var endpoint = plan.IsActive
            ? $"api/subscription-offerings/{plan.ApiId}/deactivate"
            : $"api/subscription-offerings/{plan.ApiId}/activate";
        var result = await Api.PostAsync<ApiOfferingDto>(endpoint, new { });
        if (result is not null) plan.IsActive = result.IsActive;
        else plan.IsActive = !plan.IsActive;
    }

    private record ApiOfferingDto(
        Guid Id, string Title, string? Description, string? Subject,
        decimal Price, string Currency, int DurationDays, int SessionCount,
        string? Frequency, bool IsActive,
        string? Code = null,
        bool IsInternational = false,
        string? MarketCountryCode = null,
        string? OwnerTeacherName = null);

    private record ApiSubscriberDto(
        Guid Id,
        string StudentName,
        string? ParentName,
        string OfferingTitle,
        decimal Price,
        string Status,
        DateTime EndDate);

    private class PlanVM
    {
        public Guid? ApiId { get; set; }
        public string Name { get; set; } = "";
        public string? Code { get; set; }
        public string? Description { get; set; }
        public decimal Price { get; set; }
        public string Currency { get; set; } = "XAF";
        public bool IsInternational { get; set; }
        public string? MarketCountryCode { get; set; }
        public string? OwnerTeacherName { get; set; }
        public bool IsActive { get; set; } = true;
    }
    private class SubVM
    {
        public Guid Id { get; set; }
        public string StudentName { get; set; } = "";
        public string ParentName { get; set; } = "";
        public string PlanName { get; set; } = "";
        public decimal Amount { get; set; }
        public DateTime ExpiresAt { get; set; }
        public string Status { get; set; } = "Active";
    }

    private readonly List<PlanVM> _plans = [];
    private readonly List<SubVM> _subs = [];
}
