@page "/tutor/payments"
@layout TutorLayout
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResources> L
@inject ApiClient Api
@inject IJSRuntime JS
@inject AuthService Auth

<PageTitle>@L["Payments_Title"] – TutorSphere</PageTitle>

<div class="ts-page-header">
    <div>
        <h1><i class="bi bi-credit-card me-2"></i>@L["Payments_Title"]</h1>
        <p class="ts-page-subtitle">@L["Payments_Subtitle"]</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick="ExportCsvAsync">
            <i class="bi bi-download me-1"></i>@L["Common_Export"]
        </button>
        <button class="btn btn-outline-secondary" @onclick="() => _showInvoiceModal = true">
            <i class="bi bi-receipt me-1"></i>@L["Payments_CreateInvoice"]
        </button>
        <button class="btn btn-primary" disabled="@(_payoutBusy || !_canWithdraw)" @onclick="RequestPayoutAsync">
            @if (_payoutBusy)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
            }
            else
            {
                <i class="bi bi-send me-1"></i>
            }
            Demander un paiement
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_payoutError))
{
    <div class="alert alert-danger">@_payoutError</div>
}
@if (!string.IsNullOrEmpty(_payoutSuccess))
{
    <div class="alert alert-success">@_payoutSuccess</div>
}

<div class="section-card mb-4">
    <div class="section-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 class="mb-1">Solde à verser</h2>
            <p class="text-muted small mb-0">
                Si le solde est suffisant, la facture est générée et transmise au responsable de votre groupe, avec votre moyen de paiement.
            </p>
        </div>
        <div class="text-end">
            <div class="fs-4 fw-bold">@_claimable.ToString("N2") @_payoutCurrency</div>
            <div class="small text-muted">Disponible : @_available.ToString("N2") @_payoutCurrency</div>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_eligibilityBlock))
    {
        <div class="alert alert-warning mb-0 py-2">@_eligibilityBlock</div>
    }
    @if (_myPayouts.Count > 0)
    {
        <div class="table-responsive">
            <table class="table ts-table mb-0">
                <thead>
                    <tr>
                        <th>Facture</th>
                        <th>Montant</th>
                        <th>Moyen</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in _myPayouts)
                    {
                        <tr>
                            <td>
                                <strong>@(inv.InvoiceNumber ?? inv.Id.ToString("N")[..8])</strong>
                                <div class="small text-muted">@inv.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>@inv.Amount.ToString("N2") @inv.Currency</td>
                            <td class="small">@(inv.PaymentMethodSummary ?? inv.ProviderKind)</td>
                            <td>@PayoutStatusLabel(inv.Status)</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => PrintPayoutAsync(inv)">
                                    <i class="bi bi-printer"></i> Imprimer
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="ts-kpi-card ts-kpi-card--success">
            <span class="ts-kpi-val">@CollectedThisMonth.ToString("N0") $</span>
            <span class="ts-kpi-label">@L["Payments_CollectedThisMonth"]</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ts-kpi-card ts-kpi-card--warning">
            <span class="ts-kpi-val">@_payments.Where(p => IsPending(p.Status)).Sum(p => p.Amount).ToString("N0") $</span>
            <span class="ts-kpi-label">@L["Payments_Pending"]</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ts-kpi-card ts-kpi-card--danger">
            <span class="ts-kpi-val">@_payments.Where(p => IsFailed(p.Status)).Sum(p => p.Amount).ToString("N0") $</span>
            <span class="ts-kpi-label">@L["Payments_FailedLate"]</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ts-kpi-card">
            <span class="ts-kpi-val">@_payments.Count</span>
            <span class="ts-kpi-label">@L["Payments_TotalTransactions"]</span>
        </div>
    </div>
</div>

<div class="ts-toolbar">
    <div class="ts-search-box">
        <i class="bi bi-search ts-search-icon"></i>
        <input class="form-control" placeholder="@L["Payments_SearchPlaceholder"]"
               @bind="_search" @bind:event="oninput" />
    </div>
    <select class="form-select w-auto" @bind="_filterStatus">
        <option value="">@L["Common_AllStatuses"]</option>
        <option value="paid">@L["Common_Paid"]</option>
        <option value="pending">@L["Common_Pending"]</option>
        <option value="failed">@L["Common_Failed"]</option>
        <option value="refunded">@L["Common_Refunded"]</option>
    </select>
    <select class="form-select w-auto" @bind="_filterMethod">
        <option value="">@L["Common_AllModes"]</option>
        <option value="card">@L["Common_Card"]</option>
        <option value="transfer">@L["Common_Transfer"]</option>
        <option value="cash">@L["Common_Cash"]</option>
    </select>
</div>

<div class="ts-table-card">
    <table class="table ts-table">
        <thead>
            <tr>
                <th>@L["Common_Date"]</th>
                <th>@L["Payments_Col_ParentStudent"]</th>
                <th>@L["Common_Offer"]</th>
                <th>@L["Common_Amount"]</th>
                <th>@L["Common_Mode"]</th>
                <th>@L["Common_Status"]</th>
                <th>@L["Common_Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in FilteredPayments)
            {
                <tr>
                    <td><strong>@p.Date.ToString("dd/MM/yyyy")</strong></td>
                    <td>
                        <div><strong>@p.Parent</strong></div>
                        <small class="text-muted">@p.Student</small>
                    </td>
                    <td>@p.OfferName</td>
                    <td class="fw-semibold @(IsRefunded(p.Status) ? "text-danger" : "")">@p.Amount.ToString("N0") $</td>
                    <td><span class="ts-badge ts-badge-neutral">@DisplayMethod(p.Method)</span></td>
                    <td><span class="ts-badge @PaymentBadge(p.Status)">@DisplayStatus(p.Status)</span></td>
                    <td>
                        <div class="ts-action-group">
                            <button class="ts-icon-btn" title="@L["Payments_PdfInvoice"]"
                                    @onclick="async () => await DownloadInvoicePdf(p)"><i class="bi bi-file-pdf"></i></button>
                            <button class="ts-icon-btn" title="@L["Payments_Receipt"]"
                                    @onclick="async () => await DownloadInvoicePdf(p)"><i class="bi bi-receipt"></i></button>
                            @if (IsPending(p.Status))
                            {
                                <button class="ts-icon-btn ts-icon-btn--success" title="@L["Payments_MarkPaid"]"
                                        @onclick="async () => await MarkPaid(p)">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_showInvoiceModal)
{
    <div class="ts-modal-backdrop" @onclick="() => _showInvoiceModal = false">
        <div class="ts-modal" @onclick:stopPropagation="true">
            <div class="ts-modal-header">
                <h2>@L["Payments_CreateInvoiceManual"]</h2>
                <button class="ts-modal-close" @onclick="() => _showInvoiceModal = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="ts-modal-body">
                <div class="row g-3">
                    <div class="col-6"><label class="form-label">@L["Payments_ParentRequired"]</label>
                        <select class="form-select" @bind="_invParentId">
                            <option value="">—</option>
                            @foreach (var parent in _parents)
                            {
                                <option value="@parent.Id.ToString()">@parent.Name</option>
                            }
                        </select></div>
                    <div class="col-6"><label class="form-label">@L["Payments_OfferDesc"]</label>
                        <input class="form-control" @bind="_invOffer" /></div>
                    <div class="col-6"><label class="form-label">@L["Payments_AmountLabel"]</label>
                        <input type="number" class="form-control" @bind="_invAmount" /></div>
                    <div class="col-6"><label class="form-label">@L["Payments_PaymentMethod"]</label>
                        <select class="form-select" @bind="_invMethod">
                            <option value="card">@L["Common_Card"]</option>
                            <option value="transfer">@L["Common_Transfer"]</option>
                            <option value="cash">@L["Common_Cash"]</option>
                        </select></div>
                    <div class="col-12"><label class="form-label">@L["Common_Date"]</label>
                        <input type="date" class="form-control" @bind="_invDate" /></div>
                </div>
            </div>
            <div class="ts-modal-footer">
                <button class="btn btn-outline-secondary" @onclick="() => _showInvoiceModal = false">@L["Common_Cancel"]</button>
                <button class="btn btn-primary" @onclick="async () => await CreateInvoice()">@L["Common_Create"]</button>
            </div>
        </div>
    </div>
}

@code {
    private string _search = "", _filterStatus = "", _filterMethod = "";
    private bool _showInvoiceModal;
    private bool _payoutBusy, _canWithdraw;
    private decimal _available, _claimable;
    private string _payoutCurrency = "CAD";
    private string? _eligibilityBlock, _payoutError, _payoutSuccess;
    private readonly List<PayoutInvoiceDto> _myPayouts = [];
    private string _invParentId = "", _invOffer = "", _invMethod = "card";
    private decimal _invAmount = 150;
    private DateTime _invDate = DateTime.Today;
    private readonly List<ParentOpt> _parents = [];
    private sealed record ParentOpt(Guid Id, string Name);

    private static bool IsPaid(string s) =>
        s is "paid" or "Payé" or "Paid" or "completed" or "Completed";
    private static bool IsPending(string s) =>
        s is "pending" or "En attente" or "Sent" or "Draft" or "Pending";
    private static bool IsFailed(string s) =>
        s is "failed" or "Échoué" or "Cancelled" or "Failed";
    private static bool IsRefunded(string s) =>
        s is "refunded" or "Remboursé" or "Refunded";

    private decimal CollectedThisMonth => _payments
        .Where(p => IsPaid(p.Status) && IsSameMonth(p.Date, DateTime.Today))
        .Sum(p => p.Amount);

    private static bool IsSameMonth(DateTime date, DateTime reference) =>
        date.Year == reference.Year && date.Month == reference.Month;

    private string DisplayStatus(string s) => s switch
    {
        "paid" or "Payé" or "Paid" or "completed" or "Completed" => L["Common_Paid"],
        "pending" or "En attente" or "Sent" or "Draft" or "Pending" => L["Common_Pending"],
        "failed" or "Échoué" or "Cancelled" or "Failed" => L["Common_Failed"],
        "refunded" or "Remboursé" or "Refunded" => L["Common_Refunded"],
        _ => s
    };

    private string DisplayMethod(string m) => m switch
    {
        "card" or "Carte" => L["Common_Card"],
        "transfer" or "Virement" => L["Common_Transfer"],
        "cash" or "Espèces" => L["Common_Cash"],
        "—" => "—",
        _ => m
    };

    private static string PaymentBadge(string s) => s switch
    {
        "paid" or "Payé" or "Paid" or "completed" or "Completed" => "ts-badge-success",
        "pending" or "En attente" or "Sent" or "Draft" or "Pending" => "ts-badge-warning",
        "failed" or "Échoué" or "Cancelled" or "Failed" => "ts-badge-danger",
        "refunded" or "Remboursé" or "Refunded" => "ts-badge-neutral",
        _ => "ts-badge-neutral"
    };

    /// <summary>Normalise Invoice/PaymentStatus API → clés UI (paid/pending/failed/refunded).</summary>
    private static string MapStatus(string apiStatus) => apiStatus switch
    {
        "Paid" or "paid" or "Payé" or "Completed" or "completed" => "paid",
        "Pending" or "pending" or "Sent" or "Draft" or "En attente" => "pending",
        "Failed" or "failed" or "Cancelled" or "Échoué" => "failed",
        "Refunded" or "refunded" or "Remboursé" => "refunded",
        _ => apiStatus.ToLowerInvariant()
    };

    private IEnumerable<PaymentVM> FilteredPayments => _payments
        .Where(p => string.IsNullOrEmpty(_search) ||
            p.Parent.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            p.Student.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrEmpty(_filterStatus) || NormalizeStatus(p.Status) == _filterStatus)
        .Where(p => string.IsNullOrEmpty(_filterMethod) || NormalizeMethod(p.Method) == _filterMethod)
        .OrderByDescending(p => p.Date);

    private static string NormalizeStatus(string s) => s switch
    {
        "Payé" or "Paid" or "paid" or "Completed" or "completed" => "paid",
        "En attente" or "Sent" or "Draft" or "pending" or "Pending" => "pending",
        "Échoué" or "Cancelled" or "failed" or "Failed" => "failed",
        "Remboursé" or "refunded" or "Refunded" => "refunded",
        _ => s
    };

    private static string NormalizeMethod(string m) => m switch
    {
        "Carte" or "card" => "card",
        "Virement" or "transfer" => "transfer",
        "Espèces" or "cash" => "cash",
        _ => m
    };

    protected override async Task OnInitializedAsync()
    {
        var invoices = await Api.GetAsync<List<ApiInvoiceDto>>("api/invoices");
        if (invoices is not null && invoices.Count > 0)
        {
            _payments.Clear();
            foreach (var inv in invoices)
            {
                _payments.Add(new PaymentVM
                {
                    ApiId = inv.Id,
                    Date = inv.IssuedAt.ToLocalTime(),
                    Parent = string.IsNullOrWhiteSpace(inv.ParentName)
                        ? inv.ParentProfileId.ToString()[..8] + "…"
                        : inv.ParentName,
                    Student = "—",
                    OfferName = string.Format(L["Payments_InvoiceNumber"].Value, inv.InvoiceNumber),
                    Amount = inv.Amount,
                    Method = "—",
                    Status = MapStatus(inv.Status)
                });
            }
        }
        var parents = await Api.GetAsync<List<TutorSphere.Application.DTOs.Parents.TutorParentDto>>("api/parents") ?? [];
        _parents.Clear();
        _parents.AddRange(parents.Select(p => new ParentOpt(p.Id, $"{p.FirstName} {p.LastName}".Trim())));
        await LoadPayoutsAsync();
    }

    private async Task LoadPayoutsAsync()
    {
        try
        {
            var summary = await Api.GetAsync<EarningsSummaryDto>("api/tutor-earnings");
            if (summary is not null)
            {
                _available = summary.Available;
                _payoutCurrency = string.IsNullOrWhiteSpace(summary.Currency) ? "CAD" : summary.Currency;
                if (summary.Eligibility is not null)
                {
                    _canWithdraw = summary.Eligibility.CanWithdraw;
                    _claimable = summary.Eligibility.ClaimableNow;
                    _eligibilityBlock = summary.Eligibility.BlockReason;
                }
            }
            var list = await Api.GetAsync<List<PayoutInvoiceDto>>("api/tutor-earnings/payouts") ?? [];
            _myPayouts.Clear();
            _myPayouts.AddRange(list.OrderByDescending(x => x.RequestedAt));
        }
        catch { }
    }

    private async Task RequestPayoutAsync()
    {
        _payoutBusy = true;
        _payoutError = null;
        _payoutSuccess = null;
        try
        {
            await Auth.EnsureSessionRestoredAsync();
            var result = await Api.PostWithErrorAsync<PayoutInvoiceDto>(
                "api/tutor-earnings/payouts",
                new { amount = (decimal?)null, note = (string?)null });
            if (result.Error is not null) { _payoutError = result.Error; return; }
            var inv = result.Value;
            _payoutSuccess = inv?.ExpertGroupId is not null
                ? $"Facture {(inv.InvoiceNumber ?? "")} générée et transmise au responsable du groupe."
                : "Demande de paiement enregistrée.";
            await LoadPayoutsAsync();
        }
        finally { _payoutBusy = false; }
    }

    private async Task PrintPayoutAsync(PayoutInvoiceDto inv)
    {
        var result = await Api.GetBytesWithErrorAsync($"api/tutor-earnings/payouts/{inv.Id}/pdf");
        if (result.Value is null)
        {
            _payoutError = result.Error ?? "PDF indisponible.";
            return;
        }
        var name = $"facture-{inv.InvoiceNumber ?? inv.Id.ToString("N")[..8]}.pdf";
        await JS.InvokeVoidAsync("downloadFileFromBase64", name, "application/pdf", Convert.ToBase64String(result.Value));
    }

    private static string PayoutStatusLabel(string s) => s switch
    {
        "pending" => "Demande de paiement",
        "processing" => "Paiement en cours",
        "completed" => "Facture payée",
        _ => s
    };

    private record EarningsSummaryDto(
        decimal Available, string Currency, EligibilityDto? Eligibility);
    private record EligibilityDto(
        bool CanWithdraw, decimal ClaimableNow, string? BlockReason, string Currency);
    private record PayoutInvoiceDto(
        Guid Id, decimal Amount, string Currency, string Status, DateTime RequestedAt,
        string? ProviderKind, string? InvoiceNumber, string? PaymentMethodSummary, Guid? ExpertGroupId);

    private async Task MarkPaid(PaymentVM p)
    {
        if (p.ApiId.HasValue)
        {
            var result = await Api.PostAsync<ApiInvoiceDto>($"api/invoices/{p.ApiId}/mark-paid", new { });
            if (result is not null) p.Status = MapStatus(result.Status);
            else p.Status = "paid";
        }
        else
        {
            p.Status = "paid";
        }
    }

    private async Task CreateInvoice()
    {
        if (!Guid.TryParse(_invParentId, out var parentId) || _invAmount <= 0)
            return;

        var created = await Api.PostWithErrorAsync<ApiInvoiceDto>("api/invoices", new
        {
            parentProfileId = parentId,
            amount = _invAmount,
            currency = "USD"
        });
        if (created.Value is null) return;

        await Api.PostWithErrorAsync<ApiInvoiceDto>($"api/invoices/{created.Value.Id}/send", new { });
        var inv = created.Value;
        _payments.Insert(0, new PaymentVM
        {
            ApiId = inv.Id,
            Date = inv.IssuedAt.ToLocalTime(),
            Parent = inv.ParentName ?? _parents.FirstOrDefault(p => p.Id == parentId)?.Name ?? "",
            Student = "—",
            OfferName = string.IsNullOrWhiteSpace(_invOffer) ? inv.InvoiceNumber : _invOffer,
            Amount = inv.Amount,
            Method = _invMethod,
            Status = MapStatus(inv.Status)
        });
        _showInvoiceModal = false;
    }

    private async Task DownloadInvoicePdf(PaymentVM p)
    {
        if (p.ApiId is not Guid id) return;
        var result = await Api.GetBytesWithErrorAsync($"api/invoices/{id}/pdf");
        if (result.Value is null) return;
        await JS.InvokeVoidAsync("downloadFileFromBase64", $"facture-{p.Date:yyyyMMdd}.pdf", "application/pdf", Convert.ToBase64String(result.Value));
    }

    private async Task ExportCsvAsync()
    {
        var lines = new List<string> { "Date;Parent;Offre;Montant;Statut" };
        lines.AddRange(_payments.Select(p => $"{p.Date:yyyy-MM-dd};{p.Parent};{p.OfferName};{p.Amount};{p.Status}"));
        var bytes = System.Text.Encoding.UTF8.GetBytes(string.Join("\n", lines));
        await JS.InvokeVoidAsync("downloadFileFromBase64", "paiements.csv", "text/csv;charset=utf-8", Convert.ToBase64String(bytes));
    }

    private record ApiInvoiceDto(
        Guid Id, string InvoiceNumber, Guid ParentProfileId,
        decimal Amount, string Currency, string Status,
        DateTime IssuedAt, DateTime? PaidAt, string? ParentName = null);

    private class PaymentVM
    {
        public Guid? ApiId { get; set; }
        public DateTime Date { get; set; }
        public string Parent { get; set; } = "";
        public string Student { get; set; } = "";
        public string OfferName { get; set; } = "";
        public decimal Amount { get; set; }
        public string Method { get; set; } = "";
        public string Status { get; set; } = "";
    }

    private readonly List<PaymentVM> _payments = [];
}
