@page "/contract/verify/{ContractNumber}"
@layout LoginLayout
@rendermode InteractiveServer
@using TutorSphere.Application.DTOs.Contracts
@using TutorSphere.Application.Services
@using TutorSphere.Domain.Enums
@inject HttpClient Http

<PageTitle>@Chrome.Badge — TutorSphere</PageTitle>

<div class="contract-sign-page" lang="@_language" dir="@(_language == "ar" ? "rtl" : "ltr")">
    <header class="contract-sign-brand">
        <img src="images/tutorsphere-logo-full.png" alt="TutorSphere" />
        <img src="images/gisebs-logo.png" alt="GISEBS Inc." class="gisebs-mark" />
        <span>@Chrome.Badge</span>
    </header>

    @if (_loading)
    {
        <div class="text-center py-5"><span class="spinner-border"></span></div>
    }
    else if (_dto is null)
    {
        <div class="alert alert-warning">@Chrome.NotFound</div>
    }
    else
    {
        <div class="contract-verify-card">
            <h1>@_dto.ContractNumber</h1>
            <p>@_dto.Version · @_dto.Language</p>
            <p><strong>@Chrome.Status :</strong> @TeacherContractCatalog.ContractStatusLabel(_language, _dto.Status)</p>
            @if (_dto.SignedAt is DateTime at)
            {
                <p><strong>@Chrome.SignedAt :</strong> @at.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") UTC</p>
            }
            <p><strong>@Chrome.Reference :</strong> @(_dto.VerificationCode ?? "—")</p>
            <p class="small text-break"><strong>@Chrome.Hash :</strong> @(_dto.DocumentHash ?? "—")</p>
            @if (_dto.Authentic)
            {
                <div class="alert alert-success mb-0">@Chrome.Authentic</div>
            }
            else
            {
                <div class="alert alert-secondary mb-0">@Chrome.NotYetSigned</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string ContractNumber { get; set; } = "";
    private TeacherContractVerifyDto? _dto;
    private bool _loading = true;
    private string _language = "fr";

    private TeacherContractVerifyChrome Chrome => TeacherContractCatalog.VerifyChrome(_language);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var resp = await Http.GetAsync($"api/contracts/verify/{Uri.EscapeDataString(ContractNumber)}");
            if (resp.IsSuccessStatusCode)
            {
                _dto = await resp.Content.ReadFromJsonAsync<TeacherContractVerifyDto>();
                if (_dto is not null)
                    _language = _dto.Language;
            }
        }
        catch { }
        finally { _loading = false; }
    }
}
