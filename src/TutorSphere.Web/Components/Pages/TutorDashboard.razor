@page "/tutor/dashboard"
@layout TutorLayout
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResources> L
@inject LessonService LessonSvc
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@L["PageTitle_TutorDashboard"]</PageTitle>

<div class="dashboard-header">
    <div>
        <h1 class="dashboard-greeting">@L["TutorDashboard_Title"]</h1>
        <p class="dashboard-date">@L["TutorDashboard_Subtitle_Welcome", DisplayName]</p>
    </div>
</div>

@if (_licenseWithholdRemaining > 0)
{
    <div class="alert alert-info mb-4">
        Un montant équivalent à 10 $ USD sera retenu à la source sur vos premiers paiements
        jusqu’à solde de <strong>@_licenseWithholdRemaining.ToString("0.##") $ USD</strong>.
    </div>
}

<TutorPendingEnrollments />

<div class="row g-4">
    <!-- Ma classe -->
    <div class="col-lg-6">
        <div class="section-card h-100">
            <div class="section-card-header">
                <h2><i class="bi bi-easel2 me-2"></i>@L["TutorDashboard_MyClass"]</h2>
                <a href="tutor/lessons" class="btn btn-sm btn-link">@L["Button_ViewAll"]</a>
            </div>
            @if (_loading)
            {
                <div class="ts-loading-state" style="padding: 1.5rem;">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span class="ms-2 text-muted">@L["Common_Loading"]</span>
                </div>
            }
            else if (_nextSessions.Count == 0)
            {
                <p class="ts-empty-inline px-3 py-3">@L["TutorDashboard_NoUpcomingLessons"]</p>
            }
            else
            {
                <ul class="lesson-list">
                    @foreach (var s in _nextSessions)
                    {
                        <li class="lesson-list-item">
                            <span class="lesson-time-left">@s.TimeLabel</span>
                            <div class="lesson-info">
                                <strong>@s.Title</strong>
                                <span>@s.Subject</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary"
                                    @onclick="async () => await JoinClassroomAsync(s)">
                                <i class="bi bi-easel2 me-1"></i>@L["Lessons_OpenClassroom"]
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <!-- Mes élèves -->
    <div class="col-lg-6">
        <div class="section-card h-100">
            <div class="section-card-header">
                <h2><i class="bi bi-people me-2"></i>@L["Nav_MyStudents"]</h2>
                <a href="tutor/students" class="btn btn-sm btn-link">@L["Button_ViewAll"]</a>
            </div>
            <p class="dashboard-big-stat">@_activeStudents</p>
            <p class="dashboard-big-stat-label">
                <span class="dot dot--primary"></span> @L["Stat_ActiveStudents"]
            </p>
            <div class="px-3 pb-3">
                <a href="tutor/enrollments" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-person-plus me-1"></i>@L["Nav_Enrollments"]
                </a>
            </div>
        </div>
    </div>

    <!-- Mon compte -->
    <div class="col-12">
        <div class="section-card">
            <div class="section-card-header">
                <h2><i class="bi bi-wallet2 me-2"></i>@L["TutorDashboard_MyAccount"]</h2>
                <a href="tutor/revenue" class="btn btn-sm btn-link">@L["Button_ViewAll"]</a>
            </div>
            <div class="row g-3 px-3 pb-3">
                <div class="col-sm-4">
                    <StatCard Label="@L["Stat_MonthlyRevenue"]" Value="@FormatMoney(_monthlyRevenue)"
                              Icon="bi-currency-dollar" Variant="revenue" />
                </div>
                <div class="col-sm-4">
                    <StatCard Label="@L["Stat_PendingPayments"]" Value="@FormatMoney(_pendingPayments)"
                              Icon="bi-hourglass-split" Variant="payments" />
                </div>
                <div class="col-sm-4">
                    <StatCard Label="@L["Stat_ActiveSubscriptions"]" Value="@_activeSubscriptions.ToString()"
                              Icon="bi-arrow-repeat" Variant="subscriptions" />
                </div>
            </div>
            <div class="px-3 pb-3 d-flex gap-2 flex-wrap">
                <a href="tutor/payments" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-credit-card me-1"></i>@L["Nav_Payments"]
                </a>
                <a href="tutor/payout-settings" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-wallet2 me-1"></i>@L["Nav_PayoutSettings"]
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private sealed record SessionItem(Guid Id, string Title, string Subject, string TimeLabel);
    private record DashboardDto(decimal MonthlyRevenue, int ActiveStudents, int ActiveSubscriptions, int UpcomingLessons, int PendingPayments);

    private sealed class LicenseStatusVm
    {
        public decimal LicenseFeeWithholdingRemainingUsd { get; set; }
    }

    private bool _loading = true;
    private decimal _monthlyRevenue;
    private int _activeStudents;
    private int _activeSubscriptions;
    private decimal _pendingPayments;
    private decimal _licenseWithholdRemaining;
    private List<SessionItem> _nextSessions = [];

    private string DisplayName
    {
        get
        {
            var name = Auth.UserName;
            if (string.IsNullOrWhiteSpace(name)) return "Tuteur";
            var first = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
            return first ?? name;
        }
    }

    private static string FormatMoney(decimal amount) =>
        amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fr-CA")) + " $";

    protected override async Task OnInitializedAsync()
    {
        var tenantId = Auth.TenantId;
        if (tenantId is not null)
        {
            var stats = await Api.GetAsync<DashboardDto>($"api/tenants/{tenantId}/dashboard");
            if (stats is not null)
            {
                _monthlyRevenue = stats.MonthlyRevenue;
                _activeStudents = stats.ActiveStudents;
                _activeSubscriptions = stats.ActiveSubscriptions;
                _pendingPayments = stats.PendingPayments;
            }

            try
            {
                var license = await Api.GetAsync<LicenseStatusVm>("api/platform-billing/status");
                _licenseWithholdRemaining = license?.LicenseFeeWithholdingRemainingUsd ?? 0;
            }
            catch { /* ignore */ }
        }

        try
        {
            var lessons = await LessonSvc.GetLessonsAsync();
            _nextSessions = lessons
                .Where(d => d.EndTime >= DateTime.UtcNow)
                .OrderBy(d => d.StartTime)
                .Take(3)
                .Select(d =>
                {
                    var local = d.StartTime.ToLocalTime();
                    return new SessionItem(
                        d.Id,
                        d.Title,
                        d.Subject ?? LessonService.ModeToDisplay(d.Mode),
                        $"{local:ddd dd/MM} · {local:HH:mm}");
                })
                .ToList();
        }
        catch { /* liste vide si l'API ne répond pas */ }
        finally { _loading = false; }
    }

    private async Task JoinClassroomAsync(SessionItem session)
    {
        try { await LessonSvc.NotifyLessonStartedAsync(session.Id); } catch { }
        Navigation.NavigateTo(
            $"/tutor/classroom/{session.Id}?title={Uri.EscapeDataString(session.Title)}&subject={Uri.EscapeDataString(session.Subject)}");
    }
}
