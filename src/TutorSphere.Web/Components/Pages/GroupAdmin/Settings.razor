@page "/group-admin/settings"
@layout GroupAdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService Auth
@inject ApiClient Api

<PageTitle>Paramètres du groupe — TutorSphere</PageTitle>

<AuthorizeView Roles="GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">Paramètres du groupe</h1>
                <p class="cc-page-sub">Description publique et processus d’approbation des enseignants. Pays, type et Responsable : Super Admin uniquement.</p>
            </div>
        </div>

        @if (_loading)
        {
            <span class="spinner-border"></span>
        }
        else if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_flash))
            {
                <div class="alert alert-success">@_flash</div>
            }
            <div class="cc-card">
                <div class="mb-3">
                    <label class="form-label">Nom</label>
                    <input class="form-control" value="@_name" disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label">Pays / portée</label>
                    <input class="form-control" value="@(_country ?? "International")" disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description publique</label>
                    <textarea class="form-control" rows="4" @bind="_description"></textarea>
                </div>
                <fieldset class="mb-3">
                    <legend class="form-label">Processus d’approbation des enseignants</legend>
                    <p class="small text-muted">Les diplômes et l’entretien disent qui est l’enseignant. La démonstration vérifie comment il enseigne. Elle n’est pas obligatoire pour tous les groupes.</p>
                    <div class="ex-track-list">
                        <label class="ex-track @( _track == 0 ? "is-on" : null)">
                            <input type="radio" name="track" checked="@(_track == 0)" @onchange="() => _track = 0" />
                            <span><strong>Dossier → Approbation</strong><small>Vérification du dossier, puis décision.</small></span>
                        </label>
                        <label class="ex-track @( _track == 1 ? "is-on" : null)">
                            <input type="radio" name="track" checked="@(_track == 1)" @onchange="() => _track = 1" />
                            <span><strong>Dossier → Entretien → Approbation</strong><small>Un entretien est exigé avant l’approbation définitive.</small></span>
                        </label>
                        <label class="ex-track @( _track == 3 ? "is-on" : null)">
                            <input type="radio" name="track" checked="@(_track == 3)" @onchange="() => _track = 3" />
                            <span><strong>Dossier → Démonstration → Approbation</strong><small>Une démonstration pédagogique réussie est exigée, sans entretien obligatoire.</small></span>
                        </label>
                        <label class="ex-track @( _track == 2 ? "is-on" : null)">
                            <input type="radio" name="track" checked="@(_track == 2)" @onchange="() => _track = 2" />
                            <span><strong>Dossier → Entretien → Démonstration → Approbation</strong><small>Parcours complet : entretien puis cours simulé évalué par les experts.</small></span>
                        </label>
                    </div>
                </fieldset>
                <button type="button" class="cc-btn cc-btn-primary" disabled="@_busy" @onclick="SaveAsync">Enregistrer</button>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="cc-card cc-empty"><p>Accès réservé au Responsable.</p></div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _flash;
    private string _name = "";
    private string? _country;
    private string? _description;
    private int _track;

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        try
        {
            var settings = await Api.GetAsync<GroupSettings>("api/expert/my-group/settings");
            if (settings is null) { _error = "Impossible de charger les paramètres."; return; }
            _name = settings.Name;
            _country = settings.CountryCode;
            _description = settings.Description;
            _track = settings.TeacherApprovalTrack;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _flash = null;
        _error = null;
        try
        {
            var result = await Api.PutWithErrorAsync<GroupSettings>("api/expert/my-group/settings", new
            {
                description = _description,
                teacherApprovalTrack = _track
            });
            if (result.Error is not null) { _error = result.Error; return; }
            if (result.Value is not null)
            {
                _description = result.Value.Description;
                _track = result.Value.TeacherApprovalTrack;
            }
            _flash = "Paramètres enregistrés.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private sealed record GroupSettings(
        Guid Id, string Name, string? CountryCode, string? Description, bool IsInternational, int TeacherApprovalTrack = 0);
}
