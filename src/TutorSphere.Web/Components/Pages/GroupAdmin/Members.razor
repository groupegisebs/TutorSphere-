    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine("Nom;Email;Rôle;Spécialité;Statut;Tâches;Arrivée");
        foreach (var r in _filtered)
        {
            sb.AppendLine(string.Join(';',
                Csv(r.FullName), Csv(r.Email), Csv(RoleLabel(r)), Csv(r.Specialty),
                Csv(StatusLabel(r)), r.OpenTaskCount, r.JoinedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd") ?? ""));
        }
        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        await JS.InvokeVoidAsync("downloadFileFromBase64", "membres-groupe.csv", "text/csv;charset=utf-8", Convert.ToBase64String(bytes));
    }

    private static List<string> ResponsibilityLabels(List<string>? keys, int role)
    {
        var set = (keys ?? []).ToHashSet(StringComparer.Ordinal);
        if (role == 1)
            return ["Évaluation enseignants", "Admissions experts", "Démonstrations pédagogiques"];
        var list = new List<string>();
        if (set.Contains("teachers.evaluate") || set.Contains("teachers.approve")) list.Add("Évaluation enseignants");
        if (set.Contains("admissions.vote") || set.Contains("admissions.review")) list.Add("Admissions experts");
        if (set.Contains("demos.plan") || set.Contains("demos.evaluate")) list.Add("Démonstrations pédagogiques");
        return list;
    }

    private static List<string> LostElevated(IEnumerable<string> previous, IEnumerable<string> next)
    {
        var elevated = new HashSet<string>(StringComparer.Ordinal)
        {
            "teachers.approve", "teachers.suspend", "admissions.review", "group.tasks.assign", "group.documents.manage"
        };
        var labels = new Dictionary<string, string>(StringComparer.Ordinal)
        {
            ["teachers.approve"] = "approuver un enseignant",
            ["teachers.suspend"] = "suspendre un enseignant",
            ["admissions.review"] = "examiner une candidature",
            ["group.tasks.assign"] = "attribuer des tâches",
            ["group.documents.manage"] = "gérer les documents"
        };
        var nextSet = next.ToHashSet(StringComparer.Ordinal);
        return previous.Where(k => elevated.Contains(k) && !nextSet.Contains(k))
            .Select(k => labels.GetValueOrDefault(k, k))
            .Distinct()
            .ToList();
    }

    private static string RoleLabel(MemberRow row)
    {
        if (row.IsManager || row.Role == 1) return "Responsable";
        if (!string.IsNullOrWhiteSpace(row.DefinedRoleName)) return row.DefinedRoleName!;
        return row.Role switch
        {
            2 => "Chef discipline",
            3 => "Chef comité",
            4 => "Expert senior",
            5 => "Observateur",
            _ => "Expert"
        };
    }
    private static string RoleClass(MemberRow row)
    {
        if (row.IsManager || row.Role == 1) return "is-mgr";
        if (!string.IsNullOrWhiteSpace(row.DefinedRoleColor)) return "";
        return row.Role switch
        {
            4 or 2 or 3 => "is-senior",
            5 => "is-obs",
            _ => "is-exp"
        };
    }
    private static string RoleStyle(MemberRow row)
    {
        if (row.IsManager || row.Role == 1 || string.IsNullOrWhiteSpace(row.DefinedRoleColor))
            return "";
        return $"background:{row.DefinedRoleColor}22;color:{row.DefinedRoleColor}";
    }
    private static string StatusLabel(MemberRow r) => r.Kind == "invite" ? "Invitation envoyée" : r.Status switch
    {
        1 => "Suspendu",
        2 => "Désactivé",
        _ => "Actif"
    };
    private static string StatusClass(MemberRow r) => r.Kind == "invite" ? "is-wait" : r.Status == 1 ? "is-bad" : r.Status == 2 ? "is-off" : "is-ok";
    private static string TaskTone(int n) => n >= 3 ? "is-hot" : n >= 1 ? "is-ok" : "is-muted";
    private static IEnumerable<string> SpecialtyParts(string? s) =>
        (s ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
    private static string MessageHref(string? userId) => $"expert/messages?to={userId}";
    private static string Initials(string? name)
    {
        var parts = (name ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";
        return string.IsNullOrEmpty(name) ? "?" : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }
    private static string? NullIfBlank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
    private static string Csv(string? s) => $"\"{(s ?? "").Replace("\"", "\"\"")}\"";

