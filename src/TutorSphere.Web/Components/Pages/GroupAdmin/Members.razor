    private async Task AssignTaskAsync()
    {
        if (_taskTarget?.UserId is null) return;
        if (!Guid.TryParse(_taskTeacher, out var tid))
        {
            _error = "Choisissez un enseignant (objet lié).";
            return;
        }
        _busy = true;
        try
        {
            var notes = _taskNotes;
            if (_taskPrio == "haute")
                notes = string.IsNullOrWhiteSpace(notes) ? "[Priorité : haute]" : $"[Priorité : haute]\n{notes}";
            DateTime? due = _taskDue.HasValue ? DateTime.SpecifyKind(_taskDue.Value, DateTimeKind.Local).ToUniversalTime() : null;
            var r = await Api.PostWithErrorAsync<object>("api/group-admin/tasks", new
            {
                teacherTenantId = tid,
                assigneeExpertUserId = _taskTarget.UserId,
                taskType = int.Parse(_taskType),
                notes,
                dueAtUtc = due
            });
            if (r.Error is not null) { _error = r.Error; return; }
            _success = "Tâche attribuée.";
            _taskTarget = null;
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

