@page "/group-admin/members"
@layout GroupAdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using System.Text
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Membres du groupe — TutorSphere</PageTitle>

<AuthorizeView Roles="GroupManager,SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="ex-gm">
            <div class="cc-toolbar ex-toolbar">
                <div class="ex-page-head">
                    <span class="ex-page-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                    <div>
                        <h1 class="cc-page-title">Membres du groupe</h1>
                        <p class="cc-page-sub">Gérez les membres de votre groupe, leurs rôles, permissions et responsabilités.</p>
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button type="button" class="cc-btn ex-btn-export" @onclick="ExportCsvAsync"><i class="bi bi-download"></i> Exporter</button>
                    <button type="button" class="cc-btn cc-btn-primary" @onclick="() => _showInvite = true">
                        <i class="bi bi-plus-lg"></i> Inviter un membre
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2">@_error</div>
            }
            @if (!string.IsNullOrEmpty(_success))
            {
                <div class="alert alert-success py-2">@_success</div>
            }

            @if (_loading)
            {
                <div class="ex-teachers-kpi mb-3">
                    @for (var i = 0; i < 5; i++)
                    {
                        <div class="ex-kpi ex-skel"></div>
                    }
                </div>
                <div class="cc-card ex-skel" style="height:18rem"></div>
            }
            else
            {
                <div class="ex-teachers-kpi">
                    <div class="ex-kpi" data-tone="emerald">
                        <i class="bi bi-people ex-kpi-icon"></i>
                        <div>
                            <div class="ex-kpi-label">Membres actifs</div>
                            <div class="ex-kpi-value">@_dir.ActiveCount</div>
                            @if (_dir.JoinedThisMonth > 0)
                            {
                                <div class="ex-kpi-hint">+@_dir.JoinedThisMonth ce mois-ci</div>
                            }
                        </div>
                    </div>
                    <div class="ex-kpi" data-tone="sky">
                        <i class="bi bi-person-badge ex-kpi-icon"></i>
                        <div>
                            <div class="ex-kpi-label">Experts</div>
                            <div class="ex-kpi-value">@_dir.ExpertCount</div>
                            <div class="ex-kpi-hint">@Pct(_dir.ExpertCount) % du groupe</div>
                        </div>
                    </div>
                    <div class="ex-kpi" data-tone="violet">
                        <i class="bi bi-award ex-kpi-icon"></i>
                        <div>
                            <div class="ex-kpi-label">Experts seniors</div>
                            <div class="ex-kpi-value">@_dir.SeniorCount</div>
                            <div class="ex-kpi-hint">@Pct(_dir.SeniorCount) % du groupe</div>
                        </div>
                    </div>
                    <button type="button" class="ex-kpi" data-tone="amber" @onclick="ShowPendingInvites">
                        <i class="bi bi-envelope ex-kpi-icon"></i>
                        <div>
                            <div class="ex-kpi-label">Invitations en attente</div>
                            <div class="ex-kpi-value">@_dir.PendingInviteCount</div>
                            <div class="ex-kpi-hint">Voir les invitations</div>
                        </div>
                    </button>
                    <div class="ex-kpi" data-tone="rose">
                        <i class="bi bi-slash-circle ex-kpi-icon"></i>
                        <div>
                            <div class="ex-kpi-label">Suspendus</div>
                            <div class="ex-kpi-value">@_dir.SuspendedCount</div>
                            <div class="ex-kpi-hint">@Pct(_dir.SuspendedCount) % du groupe</div>
                        </div>
                    </div>
                </div>

                <div class="ex-approve-layout @(_selected is not null ? "has-drawer" : null)">
                    <div>
                        <div class="cc-card ex-filter-bar ex-gm-filters mb-3">
                            <div class="ex-filter-search">
                                <i class="bi bi-search"></i>
                                <input class="form-control" placeholder="Rechercher un membre..."
                                       @bind="_search" @bind:event="oninput" @bind:after="OnFilterChanged" />
                            </div>
                            <div class="ex-filter-field">
                                <label>Rôle</label>
                                <select class="form-select" @bind="_roleFilter" @bind:after="OnFilterChanged">
                                    <option value="">Tous les rôles</option>
                                    <option value="1">Responsable</option>
                                    <option value="4">Expert senior</option>
                                    <option value="0">Expert</option>
                                    <option value="5">Observateur</option>
                                </select>
                            </div>
                            <div class="ex-filter-field">
                                <label>Statut</label>
                                <select class="form-select" @bind="_statusFilter" @bind:after="OnFilterChanged">
                                    <option value="">Tous les statuts</option>
                                    <option value="0">Actif</option>
                                    <option value="1">Suspendu</option>
                                    <option value="invite">Invitation envoyée</option>
                                    <option value="2">Désactivé</option>
                                </select>
                            </div>
                            <div class="ex-filter-field">
                                <label>Spécialité</label>
                                <select class="form-select" @bind="_specFilter" @bind:after="OnFilterChanged">
                                    <option value="">Toutes les spécialités</option>
                                    @foreach (var s in SpecialtyOptions)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                            </div>
                            <button type="button" class="cc-btn" @onclick="() => _showAdvanced = !_showAdvanced">
                                <i class="bi bi-funnel"></i> Filtres
                            </button>
                        </div>
                        @if (_showAdvanced)
                        {
                            <div class="cc-card mb-3">
                                <label class="form-label">Arrivé après</label>
                                <input type="date" class="form-control" @bind="_joinedAfter" @bind:after="OnFilterChanged" />
                                <button type="button" class="cc-btn btn-sm mt-2" @onclick="ResetFilters">Réinitialiser</button>
                            </div>
                        }

                        <div class="cc-card ex-teachers-table-wrap">
                            @if (_filtered.Count == 0)
                            {
                                <div class="cc-empty py-4">
                                    <i class="bi bi-people"></i>
                                    @if (RosterIsEmpty)
                                    {
                                        <p class="mb-1"><strong>Aucun membre dans ce groupe</strong></p>
                                        <p class="small text-muted">Invitez votre premier Expert pour commencer à constituer votre équipe.</p>
                                        <button type="button" class="cc-btn cc-btn-primary" @onclick="() => _showInvite = true">Inviter un membre</button>
                                    }
                                    else
                                    {
                                        <p class="mb-1"><strong>Aucun résultat</strong></p>
                                        <p class="small text-muted">Aucun membre ne correspond à la recherche ou aux filtres.</p>
                                        <button type="button" class="cc-btn" @onclick="ResetFilters">Réinitialiser</button>
                                    }
                                </div>
                            }
                            else
                            {
                                <table class="cc-table ex-teachers-table ex-gm-table">
                                    <thead>
                                        <tr>
                                            <th>Membre</th>
                                            <th>Rôle</th>
                                            <th>Spécialité</th>
                                            <th>Statut</th>
                                            <th>Tâches en cours</th>
                                            <th>Date d’arrivée</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Paged)
                                        {
                                            <tr class="@(_selected?.Id == row.Id ? "is-picked" : null)"
                                                @onclick="() => SelectAsync(row)" style="cursor:pointer">
                                                <td>
                                                    <div class="ex-teacher-id">
                                                        <span class="ex-teacher-avatar">@Initials(row.FullName)</span>
                                                        <div>
                                                            <strong>@(string.IsNullOrWhiteSpace(row.FullName) ? "—" : row.FullName)</strong>
                                                            <span>@(string.IsNullOrWhiteSpace(row.Email) ? "—" : row.Email)</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td><span class="ex-role @RoleClass(row)" style="@RoleStyle(row)">@RoleLabel(row)</span></td>
                                                <td>
                                                    @if (string.IsNullOrWhiteSpace(row.Specialty))
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var part in SpecialtyParts(row.Specialty))
                                                        {
                                                            <span class="ex-subj">@part</span>
                                                        }
                                                    }
                                                </td>
                                                <td>
                                                    <span class="ex-status @StatusClass(row)">
                                                        <i></i> @StatusLabel(row)
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (row.Kind == "invite")
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="ex-task-n @TaskTone(row.OpenTaskCount)"
                                                                @onclick:stopPropagation="true"
                                                                @onclick="() => OpenMemberTasks(row)">@row.OpenTaskCount</button>
                                                    }
                                                </td>
                                                <td>@(row.JoinedAtUtc is { } d ? d.ToLocalTime().ToString("d MMMM yyyy", Fr) : "—")</td>
                                                <td class="text-end" @onclick:stopPropagation="true">
                                                    @if (row.Kind == "member")
                                                    {
                                                        <div class="ex-more">
                                                            <button type="button" class="ex-more-btn" @onclick="() => _menuId = _menuId == row.Id ? null : row.Id">•••</button>
                                                            @if (_menuId == row.Id)
                                                            {
                                                                <div class="ex-more-menu">
                                                                    <button type="button" @onclick="() => SelectAsync(row)"><i class="bi bi-person"></i> Voir le profil</button>
                                                                    @if (!row.IsManager && !IsSelf(row))
                                                                    {
                                                                        <button type="button" @onclick="() => OpenRole(row)"><i class="bi bi-person-gear"></i> Modifier le rôle</button>
                                                                        <button type="button" @onclick="() => OpenPerms(row)"><i class="bi bi-shield-check"></i> Gérer les permissions</button>
                                                                        <button type="button" @onclick="() => OpenTask(row)"><i class="bi bi-list-check"></i> Attribuer une tâche</button>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(row.UserId))
                                                                    {
                                                                        <button type="button" @onclick="() => GoMessage(row.UserId)"><i class="bi bi-envelope"></i> Envoyer un message</button>
                                                                    }
                                                                    <button type="button" @onclick="() => SelectAsync(row)"><i class="bi bi-activity"></i> Voir l’activité</button>
                                                                    @if (!row.IsManager && !IsSelf(row))
                                                                    {
                                                                        <hr class="my-1" />
                                                                        @if (row.Status == 1)
                                                                        {
                                                                            <button type="button" @onclick="() => ReactivateAsync(row)"><i class="bi bi-arrow-counterclockwise"></i> Réactiver</button>
                                                                        }
                                                                        else
                                                                        {
                                                                            <button type="button" class="is-warn" @onclick="() => OpenSuspend(row)"><i class="bi bi-pause-circle"></i> Suspendre</button>
                                                                        }
                                                                        <button type="button" class="text-danger" @onclick="() => OpenRemove(row)"><i class="bi bi-person-x"></i> Retirer du groupe</button>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <a class="cc-btn btn-sm" href="expert/admissions">Admissions</a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="ex-table-foot">
                                    <span>Affichage de @FromRow à @ToRow sur @_filtered.Count @MemberWord</span>
                                    <div class="ex-table-pager">
                                        <select class="form-select form-select-sm" @bind="_pageSize" @bind:after="OnPageSizeChanged">
                                            <option value="10">10 par page</option>
                                            <option value="20">20 par page</option>
                                        </select>
                                        <button type="button" class="cc-btn btn-sm" disabled="@(_page <= 1)" @onclick="FirstPage">«</button>
                                        <button type="button" class="cc-btn btn-sm" disabled="@(_page <= 1)" @onclick="PrevPage">‹</button>
                                        @for (var i = 1; i <= PageCount; i++)
                                        {
                                            var p = i;
                                            <button type="button" class="ex-page-n @(_page == p ? "is-on" : null)" @onclick="() => GoPage(p)">@p</button>
                                        }
                                        <button type="button" class="cc-btn btn-sm" disabled="@(_page >= PageCount)" @onclick="NextPage">›</button>
                                        <button type="button" class="cc-btn btn-sm" disabled="@(_page >= PageCount)" @onclick="LastPage">»</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @if (_selected is MemberRow sel)
                    {
                        <aside class="cc-card ex-approve-drawer">
                            <div class="ex-gm-profile">
                                <span class="ex-gm-avatar" data-status="@StatusClass(sel)">@Initials(sel.FullName)</span>
                                <button type="button" class="ex-more-btn" style="position:absolute;right:0;top:0" @onclick="() => _selected = null"><i class="bi bi-x-lg"></i></button>
                                <strong>@(string.IsNullOrWhiteSpace(sel.FullName) ? "—" : sel.FullName)</strong>
                                <span class="ex-role @RoleClass(sel)" style="@RoleStyle(sel)">@RoleLabel(sel)</span>
                                <span class="text-muted">@(string.IsNullOrWhiteSpace(sel.Specialty) ? "—" : sel.Specialty)</span>
                            </div>
                            @if (sel.Kind == "invite")
                            {
                                <p class="small">Invitation en cours. Suivez le dossier dans Admissions.</p>
                                <a class="cc-btn cc-btn-primary w-100" href="expert/admissions">Ouvrir les admissions</a>
                            }
                            else
                            {
                                <ul class="ex-gm-contact">
                                    <li><i class="bi bi-envelope"></i> @(string.IsNullOrWhiteSpace(sel.Email) ? "—" : sel.Email)</li>
                                    <li><i class="bi bi-telephone"></i> @(string.IsNullOrWhiteSpace(sel.Phone) ? "—" : sel.Phone)</li>
                                    <li><i class="bi bi-geo-alt"></i> @(_groupCountry ?? "—")</li>
                                </ul>
                                <h3 class="h6">À propos</h3>
                                <dl class="ex-demo-meta">
                                    <div><dt>Membre depuis</dt><dd>@(sel.JoinedAtUtc is { } j ? j.ToLocalTime().ToString("d MMMM yyyy", Fr) : "—")</dd></div>
                                    <div><dt>Invité par</dt><dd>@(sel.InvitedByName ?? "—")</dd></div>
                                    <div><dt>Statut</dt><dd>@StatusLabel(sel)</dd></div>
                                </dl>
                                <h3 class="h6">Activité dans le groupe</h3>
                                @if (_actLoading)
                                {
                                    <div class="ex-skel" style="height:4.5rem"></div>
                                }
                                else if (_activity is { } act)
                                {
                                    <dl class="ex-demo-meta">
                                        <div><dt>Évaluations réalisées</dt><dd>@act.EvaluationsCompleted</dd></div>
                                        <div><dt>Enseignants approuvés</dt><dd>@act.TeachersApproved</dd></div>
                                        <div><dt>Tâches en cours</dt><dd>@act.OpenTasks</dd></div>
                                        <div><dt>Votes en attente</dt><dd>@act.PendingVotes</dd></div>
                                    </dl>
                                }
                                <h3 class="h6">Responsabilités</h3>
                                <div class="ex-subj-wrap mb-3">
                                    @foreach (var r in ResponsibilityLabels(sel.Permissions, sel.Role))
                                    {
                                        <span class="ex-subj">@r</span>
                                    }
                                    @if (ResponsibilityLabels(sel.Permissions, sel.Role).Count == 0)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </div>
                                <div class="ex-drawer-actions">
                                    @if (!string.IsNullOrWhiteSpace(sel.UserId))
                                    {
                                        <a class="cc-btn" href="@MessageHref(sel.UserId)">Envoyer un message</a>
                                    }
                                    @if (!sel.IsManager && !IsSelf(sel))
                                    {
                                        <button type="button" class="cc-btn" @onclick="() => OpenTask(sel)">Attribuer une tâche</button>
                                        <button type="button" class="cc-btn ex-gm-outline" @onclick="() => OpenRole(sel)">Modifier le rôle</button>
                                        <button type="button" class="cc-btn" @onclick="() => OpenPerms(sel)">Gérer les permissions</button>
                                        @if (sel.Status == 1)
                                        {
                                            <button type="button" class="cc-btn" disabled="@_busy" @onclick="() => ReactivateAsync(sel)">Réactiver</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="ex-btn-danger" @onclick="() => OpenSuspend(sel)">Suspendre</button>
                                        }
                                        <button type="button" class="ex-btn-danger" @onclick="() => OpenRemove(sel)">Retirer du groupe</button>
                                    }
                                    @if (sel.IsManager)
                                    {
                                        <button type="button" class="cc-btn" @onclick="() => _showTransfer = true">Transférer la responsabilité du groupe</button>
                                    }
                                </div>
                            }
                        </aside>
                    }
                </div>
            }

            @if (_showInvite)
            {
                <div class="ex-gm-modal-back" @onclick="() => _showInvite = false"></div>
                <div class="cc-card ex-gm-modal">
                    <h2 class="cc-card-title">Inviter un membre</h2>
                    <p class="small text-muted">Cela invite un Expert dans le groupe, pas un enseignant.</p>
                    @* L'erreur s'affichait en haut de la page, derrière le modal : invisible au
                       moment où l'utilisateur clique. *@
                    @if (!string.IsNullOrEmpty(_inviteError))
                    {
                        <div class="alert alert-danger py-2">@_inviteError</div>
                    }
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">E-mail *</label>
                            <input class="form-control @(_invMissing.Contains("email") ? "is-invalid" : null)"
                                   type="email" @bind="_invEmail" @bind:after='() => _invMissing.Remove("email")' />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Prénom *</label>
                            <input class="form-control @(_invMissing.Contains("first") ? "is-invalid" : null)"
                                   @bind="_invFirst" @bind:after='() => _invMissing.Remove("first")' />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Nom *</label>
                            <input class="form-control @(_invMissing.Contains("last") ? "is-invalid" : null)"
                                   @bind="_invLast" @bind:after='() => _invMissing.Remove("last")' />
                        </div>
                        <div class="col-md-4"><label class="form-label">Téléphone</label><input class="form-control" @bind="_invPhone" /></div>
                        <div class="col-md-4"><label class="form-label">Spécialité</label><input class="form-control" @bind="_invSpec" /></div>
                        <div class="col-md-4">
                            <label class="form-label">Rôle envisagé</label>
                            <select class="form-select" @bind="_invRole">
                                <option value="Expert">Expert</option>
                                <option value="Expert senior">Expert senior</option>
                                <option value="Observateur">Observateur</option>
                            </select>
                        </div>
                        <div class="col-12"><label class="form-label">Message personnel</label><textarea class="form-control" rows="3" @bind="_invMsg"></textarea></div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="cc-btn" @onclick="() => _showInvite = false">Annuler</button>
                        <button type="button" class="cc-btn cc-btn-primary" disabled="@_busy" @onclick="InviteAsync">Envoyer l’invitation</button>
                    </div>
                </div>
            }

            @if (_roleTarget is not null)
            {
                <div class="ex-gm-modal-back" @onclick="CloseRoleModal"></div>
                <div class="cc-card ex-gm-modal" @onclick:stopPropagation="true" @onclick="() => _roleOpen = false">
                    <h2 class="cc-card-title">Modifier le rôle</h2>
                    <div class="ex-teacher-id mb-3">
                        <span class="ex-teacher-avatar">@Initials(_roleTarget.FullName)</span>
                        <div>
                            <strong>@_roleTarget.FullName</strong>
                            <span>Rôle actuel : @RoleLabel(_roleTarget)</span>
                        </div>
                    </div>
                    <label class="form-label" id="role-combo-label">Nouveau rôle</label>
                    <div class="ex-combo" @onclick:stopPropagation="true">
                        <div class="ex-combo-input"
                             role="combobox"
                             aria-labelledby="role-combo-label"
                             aria-expanded="@_roleOpen"
                             aria-controls="role-combo-list"
                             aria-haspopup="listbox">
                            @if (_rolePick is { } picked && string.IsNullOrWhiteSpace(_roleQuery) && !_roleOpen)
                            {
                                <span class="ex-combo-dot" style="background:@picked.BadgeColor"></span>
                            }
                            <input @ref="_roleInput"
                                   @bind="_roleQuery"
                                   @bind:event="oninput"
                                   @bind:after="OnRoleQueryChanged"
                                   @onfocus="OpenRoleMenu"
                                   @onkeydown="OnRoleKeyDown"
                                   aria-autocomplete="list"
                                   aria-controls="role-combo-list"
                                   aria-activedescendant="@(_roleOpen && _roleHighlight >= 0 ? $"role-opt-{_roleHighlight}" : null)"
                                   placeholder="@(_rolePick?.Name ?? "Rechercher un rôle…")" />
                            <i class="bi bi-chevron-down ex-combo-caret" aria-hidden="true"></i>
                        </div>
                        @if (_roleOpen)
                        {
                            <div class="ex-combo-menu" id="role-combo-list" role="listbox">
                                @if (!FilteredRoles.Any())
                                {
                                    <div class="ex-combo-empty">Aucun rôle ne correspond à « @_roleQuery ».</div>
                                }
                                else
                                {
                                    var i = 0;
                                    @foreach (var r in FilteredRoles)
                                    {
                                        var idx = i++;
                                        var on = _roleHighlight == idx || string.Equals(_rolePick?.Key, r.Key, StringComparison.Ordinal);
                                        <button type="button" class="ex-combo-opt @(on ? "is-on" : null)"
                                                id="role-opt-@idx" role="option" aria-selected="@on"
                                                @onclick="() => SelectRole(r)">
                                            <span class="ex-combo-dot" style="background:@r.BadgeColor"></span>
                                            <span>
                                                @r.Name
                                                @if (!string.IsNullOrWhiteSpace(r.Description))
                                                {
                                                    <small>@r.Description</small>
                                                }
                                            </span>
                                        </button>
                                    }
                                }
                                <div class="ex-combo-add">
                                    <button type="button" class="ex-combo-opt" id="role-opt-add" @onclick="OpenCreateRole">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                                        <span>+ Ajouter un nouveau rôle</span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <p class="small text-muted mt-2 mb-0">Le transfert vers Responsable n’est pas disponible ici.</p>
                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <button type="button" class="cc-btn" @onclick="CloseRoleModal">Annuler</button>
                        <button type="button" class="cc-btn cc-btn-primary"
                                disabled="@(_busy || !RoleChanged)"
                                @onclick="TrySaveRoleAsync">Enregistrer les modifications</button>
                    </div>
                </div>
            }

            @if (_showCreateRole)
            {
                <div class="ex-gm-modal-back is-nested" @onclick="() => _showCreateRole = false"></div>
                <div class="cc-card ex-gm-modal is-nested" @onclick:stopPropagation="true">
                    <h2 class="cc-card-title">Ajouter un nouveau rôle</h2>
                    <p class="small text-muted">Ce rôle n’existera que dans le groupe actuel.</p>
                    <label class="form-label">Nom du rôle *</label>
                    <input class="form-control mb-2" @bind="_createName" maxlength="120" aria-required="true" />
                    <label class="form-label">Description</label>
                    <textarea class="form-control mb-2" rows="2" @bind="_createDesc"></textarea>
                    <label class="form-label">Couleur du badge</label>
                    <div class="ex-swatches mb-2" role="radiogroup" aria-label="Couleur du badge">
                        @foreach (var c in BadgeColors)
                        {
                            <button type="button" class="ex-swatch @(_createColor == c ? "is-on" : null)"
                                    style="background:@c" aria-label="@c"
                                    aria-checked="@(_createColor == c)" role="radio"
                                    @onclick="() => _createColor = c"></button>
                        }
                    </div>
                    <label class="form-label">Permissions</label>
                    <div class="ex-perm-grid mb-2">
                        @foreach (var cat in Perms.GroupBy(p => p.Cat))
                        {
                            <h3 class="h6 mt-2">@cat.Key</h3>
                            @foreach (var p in cat)
                            {
                                var on = _createPerms.Contains(p.Key);
                                <label class="d-flex gap-2 align-items-center small mb-1">
                                    <input type="checkbox" checked="@on" @onchange="e => ToggleCreatePerm(p.Key, e.Value is bool b && b)" />
                                    @p.Label
                                </label>
                            }
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_createError))
                    {
                        <div class="alert alert-danger py-2">@_createError</div>
                    }
                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <button type="button" class="cc-btn" @onclick="() => _showCreateRole = false">Annuler</button>
                        <button type="button" class="cc-btn cc-btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_createName))" @onclick="CreateRoleAsync">Créer et sélectionner</button>
                    </div>
                </div>
            }

            @if (_showRoleConfirm && _roleTarget is not null)
            {
                <div class="ex-gm-modal-back is-nested" @onclick="() => _showRoleConfirm = false"></div>
                <div class="cc-card ex-gm-modal is-nested" @onclick:stopPropagation="true">
                    <h2 class="cc-card-title">Confirmer le changement de rôle</h2>
                    <p>Ce changement retire des permissions importantes à <strong>@_roleTarget.FullName</strong> (@string.Join(", ", _lostElevated)).</p>
                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="cc-btn" @onclick="() => _showRoleConfirm = false">Annuler</button>
                        <button type="button" class="cc-btn cc-btn-primary" disabled="@_busy" @onclick="SaveRoleAsync">Confirmer</button>
                    </div>
                </div>
            }

            @if (_permTarget is not null)
            {
                <div class="ex-gm-modal-back" @onclick="() => _permTarget = null"></div>
                <div class="cc-card ex-gm-modal">
                    <h2 class="cc-card-title">Gérer les permissions</h2>
                    <p class="small text-muted">Les permissions du Responsable ne sont pas négociables. Un Observateur ne reçoit pas les droits d’approbation.</p>
                    @foreach (var cat in Perms.GroupBy(p => p.Cat))
                    {
                        <h3 class="h6 mt-3">@cat.Key</h3>
                        @foreach (var p in cat)
                        {
                            var on = _permSet.Contains(p.Key);
                            <label class="d-flex gap-2 align-items-center small mb-1">
                                <input type="checkbox" checked="@on" @onchange="e => TogglePerm(p.Key, e.Value is bool b && b)" />
                                @p.Label
                            </label>
                        }
                    }
                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="cc-btn" @onclick="() => _permTarget = null">Annuler</button>
                        <button type="button" class="cc-btn cc-btn-primary" disabled="@_busy" @onclick="SavePermsAsync">Enregistrer</button>
                    </div>
                </div>
            }

            @if (_taskTarget is not null)
            {
                <div class="ex-gm-modal-back" @onclick="() => _taskTarget = null"></div>
                <div class="cc-card ex-gm-modal">
                    <h2 class="cc-card-title">Attribuer une tâche</h2>
                    <p class="small">Membre : <strong>@_taskTarget.FullName</strong></p>
                    <label class="form-label">Titre *</label>
                    <select class="form-select mb-2" @bind="_taskType">
                        <option value="0">Compléter le profil enseignant</option>
                        <option value="1">Organiser l’agenda</option>
                        <option value="2">Publier le profil public</option>
                    </select>
                    <label class="form-label">Description</label>
                    <textarea class="form-control mb-2" rows="3" @bind="_taskNotes"></textarea>
                    <label class="form-label">Priorité</label>
                    <select class="form-select mb-2" @bind="_taskPrio">
                        <option value="normale">Normale</option>
                        <option value="haute">Haute</option>
                    </select>
                    <label class="form-label">Échéance</label>
                    <input type="datetime-local" class="form-control mb-2" @bind="_taskDue" />
                    <label class="form-label">Objet lié (enseignant)</label>
                    <select class="form-select mb-2" @bind="_taskTeacher">
                        <option value="">— Choisir —</option>
                        @foreach (var t in _teachers)
                        {
                            <option value="@t.TenantId">@t.Label</option>
                        }
                    </select>
                    <p class="small text-muted">Les pièces jointes ne sont pas encore gérées sur les délégations du groupe.</p>
                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="cc-btn" @onclick="() => _taskTarget = null">Annuler</button>
                        <button type="button" class="cc-btn cc-btn-primary" disabled="@_busy" @onclick="AssignTaskAsync">Attribuer la tâche</button>
                    </div>
                </div>
            }

            @if (_suspendTarget is not null)
            {
                <div class="ex-gm-modal-back" @onclick="() => _suspendTarget = null"></div>
                <div class="cc-card ex-gm-modal">
                    <h2 class="cc-card-title">Suspendre ce membre ?</h2>
                    <p>Le membre ne pourra plus effectuer de nouvelles actions dans le groupe jusqu’à sa réactivation. L’historique est conservé.</p>
                    @if (!string.IsNullOrEmpty(_suspendError))
                    {
                        <div class="alert alert-danger py-2">@_suspendError</div>
                    }
                    <label class="form-label">Motif de la suspension *</label>
                    <textarea class="form-control @(_suspendError is not null ? "is-invalid" : null)" rows="3"
                              @bind="_suspendReason" @bind:after="() => _suspendError = null"></textarea>
                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="cc-btn" @onclick="() => _suspendTarget = null">Annuler</button>
                        <button type="button" class="ex-btn-danger" disabled="@_busy" @onclick="SuspendAsync">Suspendre le membre</button>
                    </div>
                </div>
            }

            @if (_removeTarget is not null)
            {
                <div class="ex-gm-modal-back" @onclick="() => _removeTarget = null"></div>
                <div class="cc-card ex-gm-modal">
                    <h2 class="cc-card-title">Retirer du groupe</h2>
                    @if (_removeCheck is null)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else if (!_removeCheck.CanRemove)
                    {
                        <p>Ce membre possède encore :</p>
                        <ul>
                            @if (_removeCheck.OpenTasks > 0) { <li>@_removeCheck.OpenTasks tâche(s) ouverte(s)</li> }
                            @if (_removeCheck.OpenEvaluations > 0) { <li>@_removeCheck.OpenEvaluations évaluation(s) en cours</li> }
                            @if (_removeCheck.AssignedDemonstrations > 0) { <li>@_removeCheck.AssignedDemonstrations démonstration(s) assignée(s)</li> }
                            @if (_removeCheck.PendingVotes > 0) { <li>@_removeCheck.PendingVotes vote(s) actif(s)</li> }
                        </ul>
                        <p>Veuillez réattribuer ces éléments avant de retirer le membre. Les anciennes évaluations, votes et journaux resteront conservés.</p>
                        <button type="button" class="cc-btn" @onclick="() => _removeTarget = null">Fermer</button>
                    }
                    else
                    {
                        <p>Confirmez le retrait de <strong>@_removeTarget.FullName</strong>. L’historique du groupe est conservé.</p>
                        <div class="d-flex gap-2">
                            <button type="button" class="cc-btn" @onclick="() => _removeTarget = null">Annuler</button>
                            <button type="button" class="ex-btn-danger" disabled="@_busy" @onclick="RemoveAsync">Retirer du groupe</button>
                        </div>
                    }
                </div>
            }

            @if (_showTransfer)
            {
                <div class="ex-gm-modal-back" @onclick="() => _showTransfer = false"></div>
                <div class="cc-card ex-gm-modal">
                    <h2 class="cc-card-title">Transférer la responsabilité du groupe</h2>
                    <p>Vous ne pouvez pas vous retirer ni vous suspendre, ni vous attribuuer un successeur depuis « Modifier le rôle ». Le transfert du mandat Responsable est un workflow distinct, effectué par un Super Admin de TutorSphere.</p>
                    <button type="button" class="cc-btn cc-btn-primary" @onclick="() => _showTransfer = false">Compris</button>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="cc-card cc-empty"><p>Accès réservé au Responsable du groupe.</p></div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly CultureInfo Fr = new("fr-FR");
    private static readonly (string Cat, string Key, string Label)[] Perms =
    [
        ("Enseignants", "teachers.view", "Voir les enseignants"),
        ("Enseignants", "teachers.add", "Ajouter un enseignant"),
        ("Enseignants", "teachers.evaluate", "Évaluer un enseignant"),
        ("Enseignants", "teachers.approve", "Approuver un enseignant"),
        ("Enseignants", "teachers.suspend", "Suspendre un enseignant"),
        ("Admissions", "admissions.view", "Voir les admissions"),
        ("Admissions", "admissions.vote", "Participer aux votes"),
        ("Admissions", "admissions.review", "Examiner une candidature"),
        ("Démonstrations", "demos.plan", "Planifier"),
        ("Démonstrations", "demos.evaluate", "Évaluer"),
        ("Démonstrations", "demos.view", "Consulter"),
        ("Groupe", "group.members.view", "Voir les membres"),
        ("Groupe", "group.tasks.assign", "Attribuer des tâches"),
        ("Groupe", "group.documents.manage", "Gérer les documents")
    ];

    private bool _loading = true;
    private bool _busy;
    private bool _actLoading;
    private bool _showInvite;
    private bool _showAdvanced;
    private bool _showTransfer;
    private string? _error;
    private string? _success;
    private string _meId = "";
    private string? _groupCountry;
    private string _search = "";
    private string _roleFilter = "";
    private string _statusFilter = "";
    private string _specFilter = "";
    private DateTime? _joinedAfter;
    private int _page = 1;
    private int _pageSize = 10;
    private Guid? _menuId;
    private DirectoryDto _dir = new([], 0, 0, 0, 0, 0, 0);
    private List<MemberRow> _filtered = [];
    private MemberRow? _selected;
    private ActivityDto? _activity;
    private MemberRow? _roleTarget;
    private List<RoleOption> _roles = [];
    private RoleOption? _rolePick;
    private string _roleOriginalKey = "";
    private string _roleQuery = "";
    private bool _roleOpen;
    private int _roleHighlight;
    private bool _showCreateRole;
    private bool _showRoleConfirm;
    private string _createName = "";
    private string _createDesc = "";
    private string _createColor = "#006D44";
    private string? _createError;
    private readonly HashSet<string> _createPerms = new(StringComparer.Ordinal);
    private List<string> _lostElevated = [];
    private ElementReference _roleInput;
    private static readonly string[] BadgeColors =
        ["#006D44", "#2563EB", "#0f766e", "#1d4ed8", "#7c3aed", "#b45309", "#be123c", "#64748b"];
    private MemberRow? _permTarget;
    private MemberRow? _taskTarget;
    private MemberRow? _suspendTarget;
    private MemberRow? _removeTarget;
    private RemovalDto? _removeCheck;
    private readonly HashSet<string> _permSet = new(StringComparer.Ordinal);
    private string _suspendReason = "";
    private string? _suspendError;
    /// <summary>Erreurs affichées dans le modal d'invitation, non en haut de la page qu'il recouvre.</summary>
    private string? _inviteError;
    private readonly HashSet<string> _invMissing = new(StringComparer.Ordinal);
    private string _invEmail = "";
    private string _invFirst = "";
    private string _invLast = "";
    private string _invPhone = "";
    private string _invSpec = "";
    private string _invRole = "Expert";
    private string _invMsg = "";
    private string _taskType = "0";
    private string _taskNotes = "";
    private string _taskPrio = "normale";
    private string _taskTeacher = "";
    private DateTime? _taskDue;
    private List<TeacherItem> _teachers = [];

    private int RosterSize => Math.Max(1, _dir.ActiveCount + _dir.SuspendedCount);
    private bool RosterIsEmpty => (_dir.Items?.Count ?? 0) == 0;
    private int Pct(int n) => (int)Math.Round(100.0 * n / RosterSize);
    private int PageCount => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));
    private int FromRow => _filtered.Count == 0 ? 0 : ((_page - 1) * _pageSize) + 1;
    private int ToRow => Math.Min(_filtered.Count, _page * _pageSize);
    private string MemberWord => _filtered.Count > 1 ? "membres" : "membre";
    private IEnumerable<MemberRow> Paged => _filtered.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private IEnumerable<RoleOption> FilteredRoles =>
        string.IsNullOrWhiteSpace(_roleQuery)
            ? _roles
            : _roles.Where(r => r.Name.Contains(_roleQuery.Trim(), StringComparison.OrdinalIgnoreCase)
                             || (r.Description?.Contains(_roleQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));
    private bool RoleChanged =>
        _rolePick is not null && !string.Equals(_rolePick.Key, _roleOriginalKey, StringComparison.Ordinal);
    private IEnumerable<string> SpecialtyOptions =>
        (_dir.Items ?? []).Select(i => i.Specialty).Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s!).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        try
        {
            var ctx = await Api.GetAsync<MeCtx>("api/expert/me-context");
            _meId = ctx?.UserId ?? Auth.UserId ?? "";
            var g = await Api.GetAsync<GroupDto>("api/expert/my-group");
            _groupCountry = string.IsNullOrWhiteSpace(g?.CountryCode) ? "International" : g.CountryCode;
        }
        catch { }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _menuId = null;
        try
        {
            _dir = await Api.GetAsync<DirectoryDto>("api/expert/membership/directory") ?? new([], 0, 0, 0, 0, 0, 0);
            _dir = _dir with { Items = _dir.Items?.ToList() ?? [] };
            try
            {
                var queue = await Api.GetAsync<List<TeacherItem>>("api/expert/approvals-queue") ?? [];
                var dirTeachers = await Api.GetAsync<List<TeacherItem>>("api/expert/teacher-directory") ?? [];
                _teachers = queue.Concat(dirTeachers).GroupBy(t => t.TenantId).Select(g => g.First()).ToList();
            }
            catch { _teachers = []; }
            if (_selected is not null)
                _selected = _dir.Items.FirstOrDefault(i => i.Id == _selected.Id);
            OnFilterChanged();
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void ShowPendingInvites()
    {
        _statusFilter = "invite";
        OnFilterChanged();
    }

    private void GoMessage(string? userId)
    {
        if (!string.IsNullOrWhiteSpace(userId))
            Nav.NavigateTo(MessageHref(userId));
    }

    private void OpenMemberTasks(MemberRow row)
    {
        if (!string.IsNullOrWhiteSpace(row.UserId))
            Nav.NavigateTo($"group-admin/tasks?assignee={row.UserId}");
    }

    private void OnPageSizeChanged() => _page = 1;
    private void FirstPage() => _page = 1;
    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < PageCount) _page++; }
    private void LastPage() => _page = PageCount;
    private void GoPage(int p) => _page = p;

    private void ResetFilters()
    {
        _search = _roleFilter = _statusFilter = _specFilter = "";
        _joinedAfter = null;
        OnFilterChanged();
    }

    private void OnFilterChanged()
    {
        IEnumerable<MemberRow> q = _dir.Items ?? [];
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim();
            q = q.Where(r => (r.FullName ?? "").Contains(s, StringComparison.OrdinalIgnoreCase)
                || (r.Email ?? "").Contains(s, StringComparison.OrdinalIgnoreCase)
                || (r.Specialty ?? "").Contains(s, StringComparison.OrdinalIgnoreCase));
        }
        if (_roleFilter == "4")
            q = q.Where(r => !r.IsManager && r.Role is 2 or 3 or 4);
        else if (int.TryParse(_roleFilter, out var rf))
            q = q.Where(r => r.IsManager ? rf == 1 : r.Role == rf);
        if (_statusFilter == "invite") q = q.Where(r => r.Kind == "invite");
        else if (int.TryParse(_statusFilter, out var st))
            q = q.Where(r => r.Kind == "member" && r.Status == st);
        if (!string.IsNullOrWhiteSpace(_specFilter))
            q = q.Where(r => (r.Specialty ?? "").Contains(_specFilter, StringComparison.OrdinalIgnoreCase));
        if (_joinedAfter is DateTime ja)
            q = q.Where(r => r.JoinedAtUtc is { } d && d.ToLocalTime().Date >= ja.Date);
        _filtered = q.ToList();
        if (_page > PageCount) _page = PageCount;
    }

    private async Task SelectAsync(MemberRow row)
    {
        _selected = row;
        _menuId = null;
        _activity = null;
        if (row.Kind != "member" || string.IsNullOrWhiteSpace(row.UserId)) return;
        _actLoading = true;
        try { _activity = await Api.GetAsync<ActivityDto>($"api/expert/membership/members/{row.UserId}/activity"); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _actLoading = false; }
    }

    private bool IsSelf(MemberRow row) =>
        !string.IsNullOrWhiteSpace(_meId) && string.Equals(row.UserId, _meId, StringComparison.Ordinal);

    private async Task OpenRole(MemberRow row)
    {
        _roleTarget = row;
        _menuId = null;
        _roleOpen = false;
        _roleQuery = "";
        _showCreateRole = _showRoleConfirm = false;
        _lostElevated = [];
        _roleOriginalKey = CurrentRoleKey(row);
        try
        {
            _roles = await Api.GetAsync<List<RoleOption>>("api/expert/membership/roles") ?? [];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _roles = [];
        }
        _rolePick = _roles.FirstOrDefault(r => string.Equals(r.Key, _roleOriginalKey, StringComparison.Ordinal))
            ?? _roles.FirstOrDefault(r => row.DefinedRoleId is Guid id && r.Id == id)
            ?? _roles.FirstOrDefault(r => string.Equals(r.Name, RoleLabel(row), StringComparison.OrdinalIgnoreCase));
        if (_rolePick is not null)
            _roleOriginalKey = _rolePick.Key;
    }

    private void CloseRoleModal()
    {
        if (_showCreateRole || _showRoleConfirm) return;
        _roleTarget = null;
        _roleOpen = false;
        _roleQuery = "";
    }

    private void OpenRoleMenu() => _roleOpen = true;

    private void OnRoleQueryChanged()
    {
        _roleOpen = true;
        _roleHighlight = 0;
    }

    private void SelectRole(RoleOption role)
    {
        _rolePick = role;
        _roleQuery = "";
        _roleOpen = false;
    }

    private void OpenCreateRole()
    {
        _roleOpen = false;
        _showCreateRole = true;
        _createError = null;
        _createName = "";
        _createDesc = "";
        _createColor = "#006D44";
        _createPerms.Clear();
        foreach (var p in Perms.Where(x => x.Key is "teachers.view" or "demos.view" or "group.members.view" or "admissions.view"))
            _createPerms.Add(p.Key);
    }

    private void ToggleCreatePerm(string key, bool on)
    {
        if (on) _createPerms.Add(key);
        else _createPerms.Remove(key);
    }

    private async Task OnRoleKeyDown(KeyboardEventArgs e)
    {
        var items = FilteredRoles.ToList();
        if (e.Key == "ArrowDown")
        {
            _roleOpen = true;
            _roleHighlight = Math.Min(_roleHighlight + 1, Math.Max(0, items.Count - 1));
        }
        else if (e.Key == "ArrowUp")
        {
            _roleOpen = true;
            _roleHighlight = Math.Max(_roleHighlight - 1, 0);
        }
        else if (e.Key == "Enter")
        {
            if (!_roleOpen) { _roleOpen = true; return; }
            if (_roleHighlight >= 0 && _roleHighlight < items.Count)
                SelectRole(items[_roleHighlight]);
        }
        else if (e.Key == "Escape")
        {
            if (_roleOpen) _roleOpen = false;
            else CloseRoleModal();
        }
        else if (e.Key == "Home")
        {
            _roleOpen = true;
            _roleHighlight = 0;
        }
        else if (e.Key == "End" && items.Count > 0)
        {
            _roleOpen = true;
            _roleHighlight = items.Count - 1;
        }
        await Task.CompletedTask;
    }

    private static string CurrentRoleKey(MemberRow row)
    {
        if (!string.IsNullOrWhiteSpace(row.DefinedRoleKey)) return row.DefinedRoleKey!;
        if (row.DefinedRoleId is Guid id) return $"custom:{id:N}";
        return row.Role switch
        {
            5 => "member",
            2 => "teachers",
            3 => "admissions",
            4 => "pedagogy",
            _ => "expert"
        };
    }

    private void OpenPerms(MemberRow row)
    {
        _permTarget = row;
        _permSet.Clear();
        foreach (var p in row.Permissions ?? [])
            _permSet.Add(p);
        _menuId = null;
    }

    private void OpenTask(MemberRow row)
    {
        _taskTarget = row;
        _taskNotes = _taskTeacher = "";
        _taskType = "0";
        _taskPrio = "normale";
        _taskDue = null;
        _menuId = null;
    }

    private void OpenSuspend(MemberRow row)
    {
        _suspendTarget = row;
        _suspendReason = "";
        _menuId = null;
    }

    private async Task OpenRemove(MemberRow row)
    {
        _removeTarget = row;
        _removeCheck = null;
        _menuId = null;
        if (string.IsNullOrWhiteSpace(row.UserId)) return;
        try { _removeCheck = await Api.GetAsync<RemovalDto>($"api/expert/membership/members/{row.UserId}/removal-check"); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void TogglePerm(string key, bool on)
    {
        if (on) _permSet.Add(key);
        else _permSet.Remove(key);
    }

    private async Task InviteAsync()
    {
        _error = _success = _inviteError = null;

        // Les trois champs marqués d'une étoile, vérifiés avant l'appel : le serveur les refusait
        // déjà, mais son message atterrissait derrière le modal.
        _invMissing.Clear();
        if (string.IsNullOrWhiteSpace(_invEmail)) _invMissing.Add("email");
        if (string.IsNullOrWhiteSpace(_invFirst)) _invMissing.Add("first");
        if (string.IsNullOrWhiteSpace(_invLast)) _invMissing.Add("last");
        if (_invMissing.Count > 0)
        {
            _inviteError = _invMissing.Count == 1
                ? "Un champ obligatoire est vide : complétez-le pour envoyer l'invitation."
                : "Des champs obligatoires sont vides : complétez-les pour envoyer l'invitation.";
            return;
        }
        if (!IsEmail(_invEmail.Trim()))
        {
            _invMissing.Add("email");
            _inviteError = "Cette adresse e-mail n'est pas valide.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.PostWithErrorAsync<object>("api/expert/membership/invites", new
            {
                email = _invEmail,
                firstName = _invFirst,
                lastName = _invLast,
                phone = NullIfBlank(_invPhone),
                specialty = NullIfBlank(_invSpec),
                intendedRole = _invRole,
                personalMessage = NullIfBlank(_invMsg)
            });
            if (result.Error is not null) { _inviteError = result.Error; return; }
            _success = "Invitation envoyée.";
            _showInvite = false;
            _invEmail = _invFirst = _invLast = _invPhone = _invSpec = _invMsg = "";
            await LoadAsync();
        }
        catch (Exception ex) { _inviteError = ex.Message; }
        finally { _busy = false; }
    }

    /// <summary>
    /// Contrôle sommaire : une arobase entourée de texte, un point dans le domaine. Il s'agit
    /// d'attraper la faute de frappe avant l'aller-retour réseau.
    /// </summary>
    private static bool IsEmail(string value)
    {
        var at = value.IndexOf('@');
        return at > 0
            && at < value.Length - 1
            && value.IndexOf('@', at + 1) < 0
            && value.LastIndexOf('.') > at + 1
            && !value.EndsWith('.')
            && !value.Any(char.IsWhiteSpace);
    }

    private Task TrySaveRoleAsync()
    {
        if (_roleTarget?.UserId is null || _rolePick is null || !RoleChanged) return Task.CompletedTask;
        var next = _rolePick.Permissions ?? [];
        _lostElevated = LostElevated(_roleTarget.Permissions ?? [], next);
        if (_lostElevated.Count > 0)
        {
            _showRoleConfirm = true;
            return Task.CompletedTask;
        }
        return SaveRoleAsync();
    }

    private async Task CreateRoleAsync()
    {
        _createError = null;
        if (string.IsNullOrWhiteSpace(_createName))
        {
            _createError = "Le nom du rôle est obligatoire.";
            return;
        }
        _busy = true;
        try
        {
            var created = await Api.PostWithErrorAsync<RoleOption>("api/expert/membership/roles", new
            {
                name = _createName.Trim(),
                description = NullIfBlank(_createDesc),
                badgeColor = _createColor,
                permissions = _createPerms.ToArray()
            });
            if (created.Error is not null)
            {
                _createError = created.Error;
                return;
            }
            if (created.Value is null)
            {
                _createError = "Impossible de créer le rôle.";
                return;
            }
            _roles = await Api.GetAsync<List<RoleOption>>("api/expert/membership/roles") ?? _roles;
            _rolePick = _roles.FirstOrDefault(r => r.Id == created.Value.Id)
                ?? _roles.FirstOrDefault(r => string.Equals(r.Name, created.Value.Name, StringComparison.OrdinalIgnoreCase))
                ?? created.Value;
            _showCreateRole = false;
            _roleQuery = "";
        }
        catch (Exception ex) { _createError = ex.Message; }
        finally { _busy = false; }
    }

