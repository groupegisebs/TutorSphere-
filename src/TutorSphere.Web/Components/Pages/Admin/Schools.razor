@page "/admin/profils"
@page "/admin/schools"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AdminService AdminSvc
@inject AuthService Auth
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>Profils enseignants — Control Center</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">Profils enseignants</h1>
                <p class="cc-page-sub">Chaque enseignant possède sa fiche publique, son abonnement et ses métriques.</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="cc-alert cc-alert-success"><i class="bi bi-check-circle"></i> @_message</div>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="cc-alert cc-alert-danger"><i class="bi bi-exclamation-circle"></i> @_error</div>
        }

        @if (_loading)
        {
            <div class="cc-empty"><span class="spinner-border"></span></div>
        }
        else if (_schools.Count == 0)
        {
            <div class="cc-card cc-empty">
                <i class="bi bi-person-badge"></i>
                <p>Aucun profil enseignant enregistré pour le moment.</p>
            </div>
        }
        else
        {
            <div class="cc-stat-grid mb-3">
                <div class="cc-kpi"><div class="cc-kpi-label">Profils</div><div class="cc-kpi-value">@_schools.Count</div></div>
                <div class="cc-kpi"><div class="cc-kpi-label">Élèves (total)</div><div class="cc-kpi-value">@_schools.Sum(s => s.StudentCount).ToString("N0")</div></div>
                <div class="cc-kpi"><div class="cc-kpi-label">Actifs</div><div class="cc-kpi-value">@_schools.Count(s => s.Status == "Active")</div></div>
                <div class="cc-kpi"><div class="cc-kpi-label">En validation</div><div class="cc-kpi-value">@_schools.Count(s => s.Status.Contains("Pending", StringComparison.OrdinalIgnoreCase))</div></div>
            </div>

            <div class="cc-card">
                <div class="cc-table-wrap">
                    <table class="cc-table">
                        <thead>
                            <tr>
                                <th>Profil</th>
                                <th>Pays</th>
                                <th>Ville</th>
                                <th>Élèves</th>
                                <th>Abonnement</th>
                                <th>Statut</th>
                                <th>Créé</th>
                                @if (_isSuperAdmin)
                                {
                                    <th></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _schools)
                            {
                                <tr>
                                    <td>
                                        <div class="cc-user-cell">
                                            <span class="cc-rank-icon"><i class="bi bi-person-badge"></i></span>
                                            <span class="cc-user-cell-text">
                                                <strong>@s.Name</strong>
                                                <span>/profil/@s.Slug</span>
                                            </span>
                                        </div>
                                    </td>
                                    <td>@(s.Country ?? "—")</td>
                                    <td>@(s.City ?? "—")</td>
                                    <td>@s.StudentCount.ToString("N0")</td>
                                    <td><span class="cc-pill cc-pill-type">@s.Plan</span></td>
                                    <td>
                                        <span class="cc-pill @(s.Status == "Active" ? "cc-pill-ok" : "cc-pill-bad")">@s.Status</span>
                                    </td>
                                    <td>@s.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    @if (_isSuperAdmin)
                                    {
                                        <td class="text-end">
                                            <button type="button" class="cc-btn btn-sm"
                                                    style="color:#f87171;border-color:#f87171;"
                                                    disabled="@(_busyId == s.Id)"
                                                    title="Supprimer définitivement"
                                                    @onclick="() => DeleteAsync(s)">
                                                @if (_busyId == s.Id)
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-trash"></i>
                                                }
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    private List<AdminSchoolItem> _schools = [];
    private bool _loading = true;
    private bool _isSuperAdmin;
    private Guid? _busyId;
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        _isSuperAdmin = Auth.IsInRole("SuperAdmin");
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try { _schools = await AdminSvc.GetSchoolsAsync(); }
        catch { _schools = []; }
        finally { _loading = false; }
    }

    private async Task DeleteAsync(AdminSchoolItem school)
    {
        if (!_isSuperAdmin) return;
        _error = null;
        _message = null;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Supprimer définitivement le profil « {school.Name} » (/profil/{school.Slug}) ?\n\nTous les cours programmés seront annulés et les parents déjà payés seront remboursés, sans leur consentement. Action irréversible.");
        if (!confirmed) return;

        _busyId = school.Id;
        try
        {
            var result = await Api.DeleteWithErrorAsync($"api/admin/schools/{school.Id}");
            if (!result.IsSuccess)
            {
                _error = result.Error ?? "Suppression impossible.";
                return;
            }
            _message = $"Profil « {school.Name} » supprimé.";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busyId = null; }
    }
}
