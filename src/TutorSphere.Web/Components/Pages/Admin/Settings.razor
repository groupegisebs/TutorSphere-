@page "/admin/settings"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TutorSphere.Application.Common
@using TutorSphere.Application.DTOs.Payments
@inject IStringLocalizer<SharedResources> L
@inject AuthService Auth
@inject AdminService AdminSvc
@inject IJSRuntime JS

<PageTitle>@L["PageTitle_AdminSettings"]</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="dashboard-header">
            <div>
                <h1 class="dashboard-greeting">@L["Nav_AdminSettings"]</h1>
                <p class="dashboard-date">Configuration générale de la plateforme.</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                @_successMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @_errorMessage
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="section-card mb-4">
                    <h2 class="section-card-title p-3" style="border-bottom:1px solid var(--ts-border)">
                        <i class="bi bi-building me-2 text-primary"></i>Paramètres généraux
                    </h2>
                    <div style="padding:1.5rem">
                        <div class="ts-form-grid">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Nom de la plateforme</label>
                                <input class="form-control" @bind="_platformName" placeholder="TutorSphere" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Courriel de support</label>
                                <input type="email" class="form-control" @bind="_supportEmail" placeholder="support@tutorsphere.com" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">URL de base</label>
                                <input type="url" class="form-control" @bind="_baseUrl" placeholder="https://app.tutorsphere.com" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Domaines autorisés</label>
                                <input class="form-control" @bind="_allowedDomains"
                                       placeholder="tutorsphere.com, votredomaine.com" />
                                <small class="form-text text-muted">Séparez les domaines par des virgules.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="section-card mb-4">
                    <h2 class="section-card-title p-3" style="border-bottom:1px solid var(--ts-border)">
                        <i class="bi bi-cash-stack me-2 text-success"></i>Paiements parents
                    </h2>
                    <div style="padding:1.5rem">
                        <p class="text-muted small">
                            Sur chaque paiement parent, les frais processeur (Stripe, PayPal, MTN ou Orange) sont d’abord déduits du montant brut,
                            puis la commission TutorSphere s’applique sur le net. Le reste va au groupe d’experts
                            (enseignant rattaché) ou à l’enseignant indépendant. La licence annuelle 10 $ reste en plus.
                            Au Cameroun, MTN et Orange Money passent par PayGateway (USSD / My MTN ou redirection Orange), pas par un appel API MTN depuis TutorSphere.
                        </p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Commission par défaut (%)</label>
                                <input class="form-control" type="number" min="0" max="100" step="0.1"
                                       @bind="_defaultCommission" @bind:event="oninput" />
                                <small class="form-text text-muted">Utilisée pour les enseignants indépendants. Les groupes ont leur propre taux.</small>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-text mb-2">Aperçu carte sur 10,00 $</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Stripe — pourcentage (%)</label>
                                <input class="form-control" type="number" min="0" max="100" step="0.01"
                                       @bind="_cardFeePercent" @bind:event="oninput" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Stripe — fixe ($)</label>
                                <input class="form-control" type="number" min="0" step="0.01"
                                       @bind="_cardFeeFixed" @bind:event="oninput" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">PayPal — pourcentage (%)</label>
                                <input class="form-control" type="number" min="0" max="100" step="0.01"
                                       @bind="_paypalFeePercent" @bind:event="oninput" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">PayPal — fixe ($)</label>
                                <input class="form-control" type="number" min="0" step="0.01"
                                       @bind="_paypalFeeFixed" @bind:event="oninput" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mobile Money MTN/Orange — pourcentage (%)</label>
                                <input class="form-control" type="number" min="0" max="100" step="0.01"
                                       @bind="_momoFeePercent" @bind:event="oninput" />
                                <small class="form-text text-muted">Typiquement 1–2,5 % selon le volume MTN. Défaut 2 %.</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mobile Money — fixe</label>
                                <input class="form-control" type="number" min="0" step="1"
                                       @bind="_momoFeeFixed" @bind:event="oninput" />
                                <small class="form-text text-muted">Souvent 0 (pas de 0,30 $ comme Stripe).</small>
                            </div>
                        </div>
                        <div class="mt-3 p-3 rounded" style="background:var(--ts-surface-muted, #f8fafc); border:1px solid var(--ts-border)">
                            <strong>Exemple 10,00 $ (carte)</strong>
                            <ul class="small mb-0 mt-2">
                                <li>Frais processeur : @_cardPreview.ProcessorFee.ToString("0.00") $</li>
                                <li>Net : @_cardPreview.Net.ToString("0.00") $</li>
                                <li>Commission TutorSphere (@_cardPreview.CommissionPercent.ToString("0.##") %) : @_cardPreview.PlatformFee.ToString("0.00") $</li>
                                <li>Groupe / enseignant : @_cardPreview.Remainder.ToString("0.00") $</li>
                            </ul>
                        </div>
                        <div class="mt-3 p-3 rounded" style="background:var(--ts-surface-muted, #f8fafc); border:1px solid var(--ts-border)">
                            <strong>Exemple 6 000 XAF (MTN / Orange)</strong>
                            <ul class="small mb-0 mt-2">
                                <li>Frais opérateur : @_momoPreview.ProcessorFee.ToString("N0") XAF</li>
                                <li>Net : @_momoPreview.Net.ToString("N0") XAF</li>
                                <li>Commission TutorSphere (@_momoPreview.CommissionPercent.ToString("0.##") %) : @_momoPreview.PlatformFee.ToString("N0") XAF</li>
                                <li>Groupe / enseignant : @_momoPreview.Remainder.ToString("N0") XAF</li>
                            </ul>
                        </div>
                        <button class="btn btn-primary mt-3" @onclick="SavePaymentSettings" disabled="@(_savingPay || _loadingPay)">
                            @if (_savingPay)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Enregistrer les frais et la commission
                        </button>
                    </div>
                </div>

                <div class="section-card mb-4">
                    <h2 class="section-card-title p-3" style="border-bottom:1px solid var(--ts-border)">
                        <i class="bi bi-wrench-adjustable me-2 text-warning"></i>Maintenance
                    </h2>
                    <div style="padding:1.5rem">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <strong>Mode maintenance</strong>
                                <p class="text-muted small mb-0">Active une page de maintenance pour tous les utilisateurs.</p>
                            </div>
                            <div class="form-check form-switch ms-3">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       @bind="_maintenanceMode" id="maintenanceSwitch"
                                       style="width:3rem;height:1.5rem;" />
                            </div>
                        </div>
                        @if (_maintenanceMode)
                        {
                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                Le mode maintenance est <strong>activé</strong>. Les utilisateurs verront une page de maintenance.
                            </div>
                        }
                    </div>
                </div>

                <div class="section-card mb-4">
                    <h2 class="section-card-title p-3" style="border-bottom:1px solid var(--ts-border)">
                        <i class="bi bi-envelope me-2 text-info"></i>Notifications par courriel
                    </h2>
                    <div style="padding:1.5rem">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <strong>Notifications d'inscription</strong>
                                <p class="text-muted small mb-0">Envoyer un courriel lors d'une nouvelle inscription.</p>
                            </div>
                            <div class="form-check form-switch ms-3">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       @bind="_notifyOnRegistration"
                                       style="width:3rem;height:1.5rem;" />
                            </div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <strong>Rapport quotidien</strong>
                                <p class="text-muted small mb-0">Recevoir un résumé quotidien d'activité.</p>
                            </div>
                            <div class="form-check form-switch ms-3">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       @bind="_dailyReport"
                                       style="width:3rem;height:1.5rem;" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveSettings" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-floppy me-2"></i>
                        }
                        Enregistrer les paramètres
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ResetSettings">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Réinitialiser
                    </button>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="section-card mb-4">
                    <h2 class="section-card-title p-3" style="border-bottom:1px solid var(--ts-border)">
                        <i class="bi bi-info-circle me-2 text-secondary"></i>Informations système
                    </h2>
                    <div style="padding:1.5rem">
                        <div class="ts-form-grid">
                            <div class="ts-form-row"><label>Version</label><span>1.0.0</span></div>
                            <div class="ts-form-row"><label>Environnement</label><span>Production</span></div>
                            <div class="ts-form-row"><label>Fuseau horaire</label><span>UTC-4 (Montréal)</span></div>
                            <div class="ts-form-row"><label>Langue par défaut</label><span>Français (CA)</span></div>
                        </div>
                    </div>
                </div>

                <div class="section-card">
                    <h2 class="section-card-title p-3" style="border-bottom:1px solid var(--ts-border)">
                        <i class="bi bi-shield-check me-2 text-success"></i>Sécurité
                    </h2>
                    <div style="padding:1.5rem">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div>
                                <strong>Double authentification</strong>
                                <p class="text-muted small mb-0">Exiger le 2FA pour les administrateurs.</p>
                            </div>
                            <div class="form-check form-switch ms-3">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       @bind="_requireMfa"
                                       style="width:3rem;height:1.5rem;" />
                            </div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <strong>Journal d'audit</strong>
                                <p class="text-muted small mb-0">Activer la journalisation des actions admin.</p>
                            </div>
                            <div class="form-check form-switch ms-3">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       @bind="_auditLog"
                                       style="width:3rem;height:1.5rem;" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted">
            <i class="bi bi-shield-lock fs-1 mb-3"></i>
            <p>Accès réservé aux administrateurs.</p>
            <a href="/login" class="btn btn-primary mt-2">Se connecter</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool    _saving               = false;
    private bool    _savingPay            = false;
    private bool    _loadingPay           = false;
    private string? _successMessage;
    private string? _errorMessage;
    private string  _platformName         = "TutorSphere";
    private string  _supportEmail         = "support@tutorsphere.com";
    private string  _baseUrl              = "https://app.tutorsphere.gisebs.com";
    private string  _allowedDomains       = "tutorsphere.com";
    private bool    _maintenanceMode      = false;
    private bool    _notifyOnRegistration = true;
    private bool    _dailyReport          = false;
    private bool    _requireMfa           = false;
    private bool    _auditLog             = true;
    private decimal _defaultCommission    = ParentPaymentSplitCalculator.DefaultCommissionPercent;
    private decimal _cardFeePercent       = ParentPaymentSplitCalculator.DefaultCardFeePercent;
    private decimal _cardFeeFixed         = ParentPaymentSplitCalculator.DefaultCardFeeFixed;
    private decimal _paypalFeePercent     = ParentPaymentSplitCalculator.DefaultPayPalFeePercent;
    private decimal _paypalFeeFixed       = ParentPaymentSplitCalculator.DefaultPayPalFeeFixed;
    private decimal _momoFeePercent       = ParentPaymentSplitCalculator.DefaultMobileMoneyFeePercent;
    private decimal _momoFeeFixed         = ParentPaymentSplitCalculator.DefaultMobileMoneyFeeFixed;

    private ParentPaymentSplit _cardPreview => ParentPaymentSplitCalculator.Compute(
        10m, _cardFeePercent, _cardFeeFixed, _defaultCommission, null);

    private ParentPaymentSplit _momoPreview => ParentPaymentSplitCalculator.Compute(
        6000m, _momoFeePercent, _momoFeeFixed, _defaultCommission, null);

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        try
        {
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", "ts_admin_settings");
            if (!string.IsNullOrEmpty(saved))
            {
                var obj = System.Text.Json.JsonSerializer.Deserialize<SettingsModel>(saved,
                    new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
                if (obj != null)
                {
                    _platformName         = obj.PlatformName;
                    _supportEmail         = obj.SupportEmail;
                    _baseUrl              = obj.BaseUrl;
                    _allowedDomains       = obj.AllowedDomains;
                    _maintenanceMode      = obj.MaintenanceMode;
                    _notifyOnRegistration = obj.NotifyOnRegistration;
                    _dailyReport          = obj.DailyReport;
                    _requireMfa           = obj.RequireMfa;
                    _auditLog             = obj.AuditLog;
                }
            }
        }
        catch { }

        await LoadPaymentSettingsAsync();
    }

    private async Task LoadPaymentSettingsAsync()
    {
        _loadingPay = true;
        try
        {
            var settings = await AdminSvc.GetPaymentSettingsAsync();
            if (settings is null) return;
            _defaultCommission = settings.DefaultCommissionPercent;
            _cardFeePercent = settings.CardFeePercent;
            _cardFeeFixed = settings.CardFeeFixed;
            _paypalFeePercent = settings.PayPalFeePercent;
            _paypalFeeFixed = settings.PayPalFeeFixed;
            _momoFeePercent = settings.MobileMoneyFeePercent;
            _momoFeeFixed = settings.MobileMoneyFeeFixed;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally { _loadingPay = false; }
    }

    private async Task SavePaymentSettings()
    {
        _savingPay = true;
        _successMessage = null;
        _errorMessage = null;
        try
        {
            var result = await AdminSvc.UpdatePaymentSettingsAsync(new UpdatePlatformPaymentSettingsRequest(
                _defaultCommission, _cardFeePercent, _cardFeeFixed, _paypalFeePercent, _paypalFeeFixed,
                _momoFeePercent, _momoFeeFixed));
            if (!result.IsSuccess || result.Value is null)
            {
                _errorMessage = string.IsNullOrWhiteSpace(result.Error)
                    ? "Impossible d’enregistrer les paramètres de paiement."
                    : result.Error;
                return;
            }

            _defaultCommission = result.Value.DefaultCommissionPercent;
            _cardFeePercent = result.Value.CardFeePercent;
            _cardFeeFixed = result.Value.CardFeeFixed;
            _paypalFeePercent = result.Value.PayPalFeePercent;
            _paypalFeeFixed = result.Value.PayPalFeeFixed;
            _momoFeePercent = result.Value.MobileMoneyFeePercent;
            _momoFeeFixed = result.Value.MobileMoneyFeeFixed;
            _successMessage = "Frais processeur et commission enregistrés.";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally { _savingPay = false; }
    }

    private async Task SaveSettings()
    {
        _saving = true;
        _successMessage = null;
        try
        {
            var model = new SettingsModel(
                _platformName, _supportEmail, _baseUrl, _allowedDomains,
                _maintenanceMode, _notifyOnRegistration, _dailyReport, _requireMfa, _auditLog);
            var json = System.Text.Json.JsonSerializer.Serialize(model,
                new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
            await JS.InvokeVoidAsync("localStorage.setItem", "ts_admin_settings", json);
            _successMessage = "Paramètres enregistrés avec succès.";
        }
        catch { }
        finally { _saving = false; }
    }

    private void ResetSettings()
    {
        _platformName         = "TutorSphere";
        _supportEmail         = "support@tutorsphere.com";
        _baseUrl              = "https://app.tutorsphere.gisebs.com";
        _allowedDomains       = "tutorsphere.com";
        _maintenanceMode      = false;
        _notifyOnRegistration = true;
        _dailyReport          = false;
        _requireMfa           = false;
        _auditLog             = true;
        _successMessage       = null;
        _errorMessage         = null;
    }

    private record SettingsModel(
        string PlatformName, string SupportEmail, string BaseUrl, string AllowedDomains,
        bool MaintenanceMode, bool NotifyOnRegistration, bool DailyReport, bool RequireMfa, bool AuditLog);
}
