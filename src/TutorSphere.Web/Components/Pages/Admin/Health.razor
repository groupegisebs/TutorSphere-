@page "/admin/health"
@layout AdminLayout
@rendermode InteractiveServer
@inject AdminService AdminSvc

<PageTitle>Santé plateforme — Control Center</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">Centre de santé de la plateforme</h1>
                <p class="cc-page-sub">Contrôles réels — base de données, e-mail et paiements.</p>
            </div>
            @if (_health is not null)
            {
                <span class="cc-pill @(_health.Healthy ? "cc-pill-ok" : "cc-pill-bad")">
                    <span class="cc-status-dot" style="@(_health.Healthy ? "" : "background:#ef4444;")"></span>
                    @(_health.Healthy ? "Plateforme disponible" : "Anomalie détectée")
                </span>
            }
        </div>

        @if (_loading)
        {
            <div class="d-flex align-items-center justify-content-center py-5">
                <span class="spinner-border text-primary me-3" role="status"></span>
                <span class="text-muted">Vérification en cours…</span>
            </div>
        }
        else if (_error is not null)
        {
            <div class="cc-empty">
                <i class="bi bi-exclamation-triangle"></i>
                <p>@_error</p>
            </div>
        }
        else if (_health?.Checks is { Count: > 0 } checks)
        {
            <p class="cc-page-sub mb-3">Dernière vérification : @_health.CheckedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</p>
            <div class="cc-stat-grid mb-3">
                @foreach (var s in checks)
                {
                    <div class="cc-card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong style="font-size:.9rem;">@s.Name</strong>
                            <span class="cc-pill @(s.Ok ? "cc-pill-ok" : "cc-pill-bad")">@(s.Ok ? "OK" : "Erreur")</span>
                        </div>
                        <div style="font-size:.78rem;color:var(--cc-text-muted);">@s.Detail</div>
                        <div class="mt-2" style="font-size:.72rem;color:@(s.Ok ? "var(--cc-success)" : "#ef4444");">
                            @s.Latency
                        </div>
                    </div>
                }
            </div>
            <button type="button" class="cc-btn cc-btn-primary" @onclick="ReloadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise"></i> Relancer les contrôles
            </button>
        }
    </Authorized>
</AuthorizeView>

@code {
    private AdminHealth? _health;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _health = await AdminSvc.GetHealthAsync();
            if (_health is null)
                _error = "Impossible d'obtenir l'état de santé.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
