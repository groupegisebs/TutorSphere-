@page "/admin/meetings/create"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Créer une réunion — Admin</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        <MeetingCreateForm CancelHref="/admin/meetings" RoomPrefix="/admin/meetings" />
    </Authorized>
    <NotAuthorized>
        <p>Accès réservé au Super Admin.</p>
    </NotAuthorized>
</AuthorizeView>
