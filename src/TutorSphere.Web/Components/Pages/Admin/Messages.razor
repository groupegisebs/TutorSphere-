@page "/admin/messages"
@page "/admin/support"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthService Auth
@inject ApiClient Api
@inject AdminService AdminSvc
@inject NavigationManager Navigation

<PageTitle>Messagerie — Control Center</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">Messagerie interne</h1>
                <p class="cc-page-sub">Écrire à tout utilisateur de la plateforme — une copie est envoyée par e-mail.</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="cc-alert cc-alert-danger"><i class="bi bi-exclamation-circle"></i> @_error</div>
        }
        @if (!string.IsNullOrEmpty(_success))
        {
            <div class="cc-alert cc-alert-success"><i class="bi bi-check-circle"></i> @_success</div>
        }

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="cc-card mb-3">
                    <h2 class="cc-card-title">Conversations</h2>
                    @if (_loadingConv)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else if (_conversations.Count == 0)
                    {
                        <p class="text-muted small mb-0">Aucune conversation pour le moment.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var c in _conversations)
                            {
                                <li class="py-2 border-bottom">
                                    <button type="button" class="btn btn-link text-start p-0 text-decoration-none w-100"
                                            @onclick="() => OpenThreadAsync(c.OtherUserId, c.OtherUserName)">
                                        <strong>@c.OtherUserName</strong>
                                        @if (c.UnreadCount > 0)
                                        {
                                            <span class="cc-pill cc-pill-bad ms-1">@c.UnreadCount</span>
                                        }
                                        <div class="small text-muted text-truncate">
                                            @(c.LastMessage?.Subject ?? c.LastMessage?.Body ?? "—")
                                        </div>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <div class="cc-card">
                    <h2 class="cc-card-title">Nouveau destinataire</h2>
                    <input class="form-control mb-2" placeholder="Rechercher nom ou e-mail…"
                           @bind="_userQuery" @bind:event="oninput" @onkeyup="SearchUsersAsync" />
                    @if (_searching)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else if (_userHits.Count > 0)
                    {
                        <ul class="list-unstyled mb-0" style="max-height:220px;overflow:auto;">
                            @foreach (var u in _userHits.Take(12))
                            {
                                <li class="py-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary w-100 text-start"
                                            @onclick="() => SelectRecipient(u)">
                                        <strong>@u.FullName</strong>
                                        <span class="small text-muted d-block">@u.Email · @u.Role</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <div class="col-lg-8">
                <div class="cc-card">
                    @if (_recipientId is null)
                    {
                        <div class="cc-empty">
                            <i class="bi bi-chat-dots"></i>
                            <p>Sélectionnez une conversation ou un destinataire.</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h2 class="cc-card-title mb-0">@_recipientName</h2>
                                <p class="small text-muted mb-0">@_recipientEmail</p>
                            </div>
                            <button type="button" class="cc-btn btn-sm" @onclick="ClearRecipient">Fermer</button>
                        </div>

                        <div class="border rounded p-3 mb-3" style="max-height:320px;overflow:auto;background:rgba(0,0,0,.15);">
                            @if (_threadLoading)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else if (_thread.Count == 0)
                            {
                                <p class="text-muted small mb-0">Aucun message dans ce fil.</p>
                            }
                            else
                            {
                                @foreach (var m in _thread)
                                {
                                    var mine = !string.Equals(m.SenderUserId, _recipientId, StringComparison.Ordinal);
                                    <div class="mb-3 @(mine ? "text-end" : "")">
                                        <div class="small text-muted">
                                            @(mine ? "Vous" : _recipientName)
                                            · @m.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(m.Subject))
                                        {
                                            <div><strong>@m.Subject</strong></div>
                                        }
                                        <div style="white-space:pre-wrap;">@m.Body</div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">Objet</label>
                                <input class="form-control" @bind="_subject" placeholder="Objet du message" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Message</label>
                                <textarea class="form-control" rows="5" @bind="_body"
                                          placeholder="Votre message…"></textarea>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="emailCopy" @bind="_sendEmailCopy" />
                                    <label class="form-check-label" for="emailCopy">
                                        Envoyer aussi une copie par e-mail au destinataire
                                    </label>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="button" class="cc-btn cc-btn-primary" disabled="@_sending" @onclick="SendAsync">
                                    @if (_sending) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    <i class="bi bi-send"></i> Envoyer
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool _loadingConv = true;
    private bool _searching;
    private bool _threadLoading;
    private bool _sending;
    private string? _error;
    private string? _success;

    private List<ConversationVm> _conversations = [];
    private string _userQuery = "";
    private List<AdminUserItem> _userHits = [];
    private CancellationTokenSource? _searchCts;

    private string? _recipientId;
    private string _recipientName = "";
    private string? _recipientEmail;
    private List<MessageVm> _thread = [];
    private string _subject = "";
    private string _body = "";
    private bool _sendEmailCopy = true;

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        await LoadConversationsAsync();

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        string? userId = null;
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0].Equals("userId", StringComparison.OrdinalIgnoreCase))
                userId = Uri.UnescapeDataString(kv[1]);
        }
        if (!string.IsNullOrWhiteSpace(userId))
        {
            try
            {
                var detail = await AdminSvc.GetUserAsync(userId);
                if (detail is not null)
                {
                    await OpenThreadAsync(detail.Id, detail.FullName);
                    _recipientEmail = detail.Email;
                }
            }
            catch { /* ignore */ }
        }
    }

    private async Task LoadConversationsAsync()
    {
        _loadingConv = true;
        try
        {
            _conversations = await Api.GetAsync<List<ConversationVm>>("api/admin/messages/conversations") ?? [];
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loadingConv = false; }
    }

    private async Task SearchUsersAsync()
    {
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        var q = _userQuery?.Trim() ?? "";
        if (q.Length < 2)
        {
            _userHits = [];
            return;
        }

        _searching = true;
        try
        {
            await Task.Delay(250, token);
            _userHits = await AdminSvc.GetUsersAsync(q: q) ?? [];
        }
        catch (TaskCanceledException) { }
        catch { _userHits = []; }
        finally { if (!token.IsCancellationRequested) _searching = false; }
    }

    private async Task SelectRecipient(AdminUserItem u)
    {
        _userHits = [];
        _userQuery = "";
        await OpenThreadAsync(u.Id, u.FullName);
        _recipientEmail = u.Email;
    }

    private async Task OpenThreadAsync(string userId, string name)
    {
        _recipientId = userId;
        _recipientName = name;
        _error = null;
        _success = null;
        _threadLoading = true;
        try
        {
            _thread = await Api.GetAsync<List<MessageVm>>($"api/admin/messages/conversations/{userId}") ?? [];
            if (_thread.Count > 0 && string.IsNullOrWhiteSpace(_subject))
                _subject = _thread[^1].Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase)
                    ? _thread[^1].Subject
                    : $"Re: {_thread[^1].Subject}";
        }
        catch (Exception ex) { _error = ex.Message; _thread = []; }
        finally { _threadLoading = false; }
    }

    private void ClearRecipient()
    {
        _recipientId = null;
        _recipientName = "";
        _recipientEmail = null;
        _thread = [];
        _subject = "";
        _body = "";
    }

    private async Task SendAsync()
    {
        if (_recipientId is null) return;
        if (string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_body))
        {
            _error = "Objet et message obligatoires.";
            return;
        }

        _sending = true;
        _error = null;
        _success = null;
        try
        {
            var result = await Api.PostWithErrorAsync<SendResult>("api/admin/messages", new
            {
                recipientUserId = _recipientId,
                subject = _subject.Trim(),
                body = _body.Trim(),
                sendEmailCopy = _sendEmailCopy
            });
            if (!result.IsSuccess || result.Value is null)
            {
                _error = result.Error ?? "Échec d'envoi.";
                return;
            }

            _success = result.Value.EmailSent
                ? "Message envoyé (interne + e-mail)."
                : string.IsNullOrWhiteSpace(result.Value.EmailError)
                    ? "Message interne envoyé."
                    : $"Message interne envoyé. E-mail non envoyé : {result.Value.EmailError}";
            _body = "";
            await OpenThreadAsync(_recipientId, _recipientName);
            await LoadConversationsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _sending = false; }
    }

    private sealed record ConversationVm(
        string OtherUserId,
        string OtherUserName,
        MessageVm? LastMessage,
        int UnreadCount);

    private sealed record MessageVm(
        Guid Id,
        string SenderUserId,
        string RecipientUserId,
        string Subject,
        string Body,
        bool IsRead,
        DateTime? ReadAt,
        DateTime CreatedAt);

    private sealed record SendResult(MessageVm Message, bool EmailSent, string? EmailError);
}
