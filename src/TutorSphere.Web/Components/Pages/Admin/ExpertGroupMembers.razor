@page "/admin/expert-groups/{GroupId:guid}"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.Extensions.Localization
@inject AdminService AdminSvc
@inject AuthService Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["ExpertMembers_Title"] — Control Center</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <a href="admin/expert-groups" class="small text-muted">← @L["ExpertMembers_Back"]</a>
                <h1 class="cc-page-title">@(_group?.Name ?? L["ExpertMembers_Group"].ToString())</h1>
                <p class="cc-page-sub">@L["ExpertMembers_Subtitle"]</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mb-3">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_flash))
        {
            <div class="alert alert-success mb-3">@_flash</div>
        }

        <div class="cc-card mb-3">
            <div class="mb-3">
                <label class="form-label cc-label-light" style="color:#f3f4f6">@L["ExpertMembers_Mode"]</label>
                <div class="d-flex flex-wrap gap-3">
                    <label class="form-check" style="color:#f3f4f6">
                        <input class="form-check-input" type="radio" name="expert-mode" checked="@(!_invite)"
                               @onchange="() => _invite = false" />
                        <span class="form-check-label cc-label-light" style="color:#f3f4f6">@L["ExpertMembers_ModeAdd"]</span>
                    </label>
                    <label class="form-check" style="color:#f3f4f6">
                        <input class="form-check-input" type="radio" name="expert-mode" checked="@_invite"
                               @onchange="() => _invite = true" />
                        <span class="form-check-label cc-label-light" style="color:#f3f4f6">@L["ExpertMembers_ModeInvite"]</span>
                    </label>
                </div>
                <p class="form-text mb-0" style="color:#d1d5db">
                    @(_invite ? L["ExpertMembers_ModeInviteHelp"] : L["ExpertMembers_ModeAddHelp"])
                </p>
                <p class="form-text mb-0" style="color:#d1d5db">
                    <i class="bi bi-info-circle"></i> @L["ExpertMembers_SingleGroupHint"]
                </p>
            </div>
            <div class="row g-2 align-items-end">
                <div class="@(_invite ? "col-md-4" : "col-md-8")">
                    <label class="form-label cc-label-light" style="color:#f3f4f6">@L["ExpertMembers_Email"]</label>
                    <input class="form-control" @bind="_email" placeholder="expert@example.com" />
                </div>
                @if (_invite)
                {
                    <div class="col-md-2">
                        <label class="form-label cc-label-light" style="color:#f3f4f6">@L["ExpertMembers_FirstName"]</label>
                        <input class="form-control" @bind="_firstName" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label cc-label-light" style="color:#f3f4f6">@L["ExpertMembers_LastName"]</label>
                        <input class="form-control" @bind="_lastName" />
                    </div>
                }
                <div class="col-md-4">
                    <button type="button" class="cc-btn cc-btn-primary w-100" disabled="@_adding" @onclick="AddAsync">
                        @(_invite ? L["ExpertMembers_InviteBtn"] : L["ExpertMembers_AddBtn"])
                    </button>
                </div>
            </div>
        </div>

        <div class="cc-card mb-3">
            @if (_loading)
            {
                <div class="cc-empty"><span class="spinner-border"></span></div>
            }
            else if (_members.Count == 0)
            {
                <p class="text-muted mb-0">@L["ExpertMembers_Empty"]</p>
            }
            else
            {
                <table class="cc-table">
                    <thead>
                        <tr><th>@L["ExpertMembers_ColName"]</th><th>@L["ExpertMembers_ColEmail"]</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _members)
                        {
                            <tr>
                                <td>@m.FullName</td>
                                <td>@m.Email</td>
                                <td class="text-end">
                                    <button type="button" class="cc-btn btn-sm" @onclick="() => RemoveAsync(m)">@L["ExpertMembers_Remove"]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="cc-card">
            <h2 class="cc-card-title">Candidatures (vote 75 %)</h2>
            <p class="small text-muted mb-3">Invitations communautaires en cours. L'ajout ci-dessus reste immédiat (AdminDirect).</p>
            @if (_invites.Count == 0)
            {
                <p class="text-muted mb-0">Aucune candidature.</p>
            }
            else
            {
                @foreach (var inv in _invites)
                {
                    <div class="border-bottom border-secondary py-3">
                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <div>
                                <strong>@inv.FirstName @inv.LastName</strong> — @inv.Email
                                <div class="small text-muted">Statut @inv.Status · @inv.ApprovalCount/@inv.RequiredApprovalCount · par @(inv.InvitedByName ?? "—")</div>
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                @if (inv.Status == 7)
                                {
                                    <button type="button" class="cc-btn cc-btn-primary btn-sm" @onclick="() => ValidateAsync(inv.Id)">Valider</button>
                                }
                                @if (inv.Status is 0 or 1 or 2 or 7)
                                {
                                    <button type="button" class="cc-btn cc-btn-primary btn-sm" @onclick="() => ForceApproveAsync(inv.Id)">Admettre</button>
                                    <button type="button" class="cc-btn btn-sm" @onclick="() => ForceRejectAsync(inv.Id)">Rejeter</button>
                                    <button type="button" class="cc-btn btn-sm" @onclick="() => ExtendAsync(inv.Id)">+7 j</button>
                                    <button type="button" class="cc-btn btn-sm" @onclick="() => CancelAsync(inv.Id)">Annuler</button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public Guid GroupId { get; set; }

    private ExpertGroupItem? _group;
    private List<ExpertMemberItem> _members = [];
    private List<ExpertMembershipInviteItem> _invites = [];
    private bool _loading = true;
    private bool _adding;
    private bool _invite = true;
    private string _email = "";
    private string _firstName = "";
    private string _lastName = "";
    private string? _error;
    private string? _flash;

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _group = (await AdminSvc.GetExpertGroupsAsync()).FirstOrDefault(g => g.Id == GroupId);
            _members = await AdminSvc.GetExpertGroupMembersAsync(GroupId);
            _invites = await AdminSvc.GetExpertMembershipInvitesAsync(GroupId);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task AddAsync()
    {
        _adding = true;
        _error = null;
        _flash = null;
        try
        {
            var result = await AdminSvc.AddExpertByEmailAsync(
                GroupId, _email, _invite, _firstName, _lastName);
            if (!result.IsSuccess || result.Value is null)
            {
                _error = result.Error ?? L["ExpertMembers_AddFailed"].Value;
                return;
            }
            var m = result.Value;

            if (m.CredentialsSent)
                _flash = m.AccountCreated
                    ? L["ExpertMembers_FlashInviteCreated"]
                    : L["ExpertMembers_FlashInviteSent"];
            else if (m.NotificationSent)
                _flash = L["ExpertMembers_FlashAddedNotified"];
            else
                _flash = L["ExpertMembers_FlashAdded"];

            _email = "";
            _firstName = "";
            _lastName = "";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _adding = false; }
    }

    private async Task ForceApproveAsync(Guid id)
    {
        var r = await AdminSvc.ForceApproveMembershipAsync(id);
        if (!r.IsSuccess) _error = r.Error; else { _flash = "Candidat admis."; await ReloadAsync(); }
    }

    private async Task ForceRejectAsync(Guid id)
    {
        var r = await AdminSvc.ForceRejectMembershipAsync(id, "Rejet administratif");
        if (!r.IsSuccess) _error = r.Error; else { _flash = "Candidature rejetée."; await ReloadAsync(); }
    }

    private async Task CancelAsync(Guid id)
    {
        var r = await AdminSvc.CancelMembershipInviteAsync(id);
        if (!r.IsSuccess) _error = r.Error; else { _flash = "Invitation annulée."; await ReloadAsync(); }
    }

    private async Task ExtendAsync(Guid id)
    {
        var r = await AdminSvc.ExtendMembershipInviteAsync(id, extendInviteDays: 7, extendVoteDays: 7);
        if (!r.IsSuccess) _error = r.Error; else { _flash = "Délai prolongé de 7 jours."; await ReloadAsync(); }
    }

    private async Task ValidateAsync(Guid id)
    {
        var r = await AdminSvc.ValidateMembershipInviteAsync(id);
        if (!r.IsSuccess) _error = r.Error; else { _flash = "Validation admin effectuée."; await ReloadAsync(); }
    }

    private async Task RemoveAsync(ExpertMemberItem m)
    {
        try
        {
            var ok = await AdminSvc.RemoveExpertMemberAsync(GroupId, m.UserId);
            if (!ok) { _error = L["ExpertMembers_RemoveFailed"]; return; }
            _flash = L["ExpertMembers_FlashRemoved"];
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
