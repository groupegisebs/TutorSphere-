@page "/admin/expert-groups/{GroupId:guid}"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AdminService AdminSvc
@inject AuthService Auth

<PageTitle>Membres du groupe — Control Center</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <a href="admin/expert-groups" class="small text-muted">← Groupes</a>
                <h1 class="cc-page-title">@(_group?.Name ?? "Groupe")</h1>
                <p class="cc-page-sub">Assignez des comptes experts à ce groupe (rôle Expert ajouté automatiquement).</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mb-3">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_flash))
        {
            <div class="alert alert-success mb-3">@_flash</div>
        }

        <div class="cc-card mb-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">E-mail du compte expert</label>
                    <input class="form-control" @bind="_email" placeholder="expert@example.com" />
                </div>
                <div class="col-md-4">
                    <button type="button" class="cc-btn cc-btn-primary w-100" disabled="@_adding" @onclick="AddAsync">
                        Ajouter
                    </button>
                </div>
            </div>
        </div>

        <div class="cc-card">
            @if (_loading)
            {
                <div class="cc-empty"><span class="spinner-border"></span></div>
            }
            else if (_members.Count == 0)
            {
                <p class="text-muted mb-0">Aucun membre pour l’instant.</p>
            }
            else
            {
                <table class="cc-table">
                    <thead>
                        <tr><th>Nom</th><th>E-mail</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _members)
                        {
                            <tr>
                                <td>@m.FullName</td>
                                <td>@m.Email</td>
                                <td class="text-end">
                                    <button type="button" class="cc-btn btn-sm" @onclick="() => RemoveAsync(m)">Retirer</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public Guid GroupId { get; set; }

    private ExpertGroupItem? _group;
    private List<ExpertMemberItem> _members = [];
    private bool _loading = true;
    private bool _adding;
    private string _email = "";
    private string? _error;
    private string? _flash;

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _group = (await AdminSvc.GetExpertGroupsAsync()).FirstOrDefault(g => g.Id == GroupId);
            _members = await AdminSvc.GetExpertGroupMembersAsync(GroupId);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task AddAsync()
    {
        _adding = true;
        _error = null;
        try
        {
            var m = await AdminSvc.AddExpertByEmailAsync(GroupId, _email);
            if (m is null) { _error = "Ajout impossible (compte introuvable ?)."; return; }
            _flash = "Expert ajouté.";
            _email = "";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _adding = false; }
    }

    private async Task RemoveAsync(ExpertMemberItem m)
    {
        var ok = await AdminSvc.RemoveExpertMemberAsync(GroupId, m.UserId);
        if (!ok) { _error = "Retrait impossible."; return; }
        _flash = "Membre retiré.";
        await ReloadAsync();
    }
}
