@page "/admin/teachers"
@page "/admin/tutors"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AdminService AdminSvc
@inject AuthService Auth
@inject ApiClient Api
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>Enseignants — Control Center</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="dashboard-header">
            <div>
                <h1 class="dashboard-greeting">Enseignants</h1>
                <p class="dashboard-date">Gérez les enseignants et approuvez leurs profils publics.</p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
            <div class="ms-auto" style="min-width:240px;">
                <div class="form-field-icon">
                    <i class="bi bi-search field-icon" aria-hidden="true"></i>
                    <input type="search" class="form-control"
                           placeholder="Rechercher par nom ou courriel…"
                           @bind="_search" @bind:event="oninput" />
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i>
                @_errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                @_successMessage
            </div>
        }

        @if (_isLoading)
        {
            <div class="d-flex align-items-center justify-content-center py-5">
                <span class="spinner-border text-primary me-3" role="status" aria-hidden="true"></span>
                <span class="text-muted">Chargement des enseignants…</span>
            </div>
        }
        else
        {
            var filtered = FilteredTutors;
            <div class="section-card">
                @if (!filtered.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-person-x fs-1 d-block mb-2 opacity-50"></i>
                        <p>Aucun enseignant trouvé.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table admin-users-table">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Courriel</th>
                                    <th class="text-center">Statut</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tutor in filtered)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="admin-user-avatar">@Initials(tutor.FullName)</div>
                                                <span class="fw-medium">@tutor.FullName</span>
                                            </div>
                                        </td>
                                        <td class="text-muted small">@tutor.Email</td>
                                        <td class="text-center">
                                            @if (tutor.IsActive)
                                            {
                                                <span class="admin-status-badge admin-status-badge--active">
                                                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle;"></i>Actif
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="admin-status-badge admin-status-badge--inactive">
                                                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:middle;"></i>Inactif
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex align-items-center justify-content-end gap-2 flex-wrap">
                                                @if (_pendingUserId == tutor.Id)
                                                {
                                                    <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                                                }
                                                else
                                                {
                                                    @if (tutor.IsActive)
                                                    {
                                                        <button class="btn admin-toggle-btn admin-toggle-btn--deactivate"
                                                                @onclick="() => ToggleUserAsync(tutor)">
                                                            <i class="bi bi-lock me-1"></i>Désactiver
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn admin-toggle-btn admin-toggle-btn--activate"
                                                                @onclick="() => ToggleUserAsync(tutor)">
                                                            <i class="bi bi-unlock me-1"></i>Activer
                                                        </button>
                                                    }
                                                    <button class="btn btn-sm btn-outline-primary"
                                                            title="Approuver le profil"
                                                            disabled="@(_approvingTenant == tutor.Id)"
                                                            @onclick="() => ApproveSchoolAsync(tutor)">
                                                        @if (_approvingTenant == tutor.Id)
                                                        {
                                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-building-check me-1"></i>
                                                        }
                                                        Approuver profil
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            title="Supprimer définitivement"
                                                            @onclick="() => DeleteTeacherAsync(tutor)">
                                                        <i class="bi bi-trash me-1"></i>Supprimer
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted">
            <i class="bi bi-shield-lock fs-1 mb-3"></i>
            <p>Accès réservé aux administrateurs.</p>
            <a href="/login" class="btn btn-primary mt-2">Se connecter</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string _search = "";
    private bool _isLoading;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _pendingUserId;
    private string? _approvingTenant;
    private List<AdminUserItem> _tutors = [];

    private IEnumerable<AdminUserItem> FilteredTutors =>
        string.IsNullOrWhiteSpace(_search)
            ? _tutors
            : _tutors.Where(u =>
                u.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                u.Email.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        _isLoading = true;
        _errorMessage = null;
        try { _tutors = await AdminSvc.GetUsersAsync("Tutor"); }
        catch { _errorMessage = "Impossible de charger les enseignants. Vérifiez votre connexion."; }
        finally { _isLoading = false; }
    }

    private async Task ToggleUserAsync(AdminUserItem tutor)
    {
        _pendingUserId = tutor.Id;
        _successMessage = null;
        _errorMessage = null;
        try
        {
            bool ok = tutor.IsActive
                ? await AdminSvc.DeactivateUserAsync(tutor.Id)
                : await AdminSvc.ActivateUserAsync(tutor.Id);

            if (ok)
            {
                var idx = _tutors.IndexOf(tutor);
                if (idx >= 0) _tutors[idx] = tutor with { IsActive = !tutor.IsActive };
                _successMessage = tutor.IsActive
                    ? $"Compte de {tutor.FullName} désactivé."
                    : $"Compte de {tutor.FullName} activé.";
            }
            else { _errorMessage = "L'opération a échoué. Veuillez réessayer."; }
        }
        catch { _errorMessage = "Une erreur inattendue s'est produite."; }
        finally { _pendingUserId = null; }
    }

    private async Task DeleteTeacherAsync(AdminUserItem tutor)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Supprimer définitivement l'enseignant « {tutor.FullName} » ({tutor.Email}) ?\n\nTous les cours programmés seront annulés et les parents déjà payés seront remboursés, sans leur consentement.\n\nLe compte et le profil seront ensuite effacés. Action irréversible.");
        if (!confirmed) return;

        _pendingUserId = tutor.Id;
        _successMessage = null;
        _errorMessage = null;
        try
        {
            var result = await AdminSvc.DeleteUserAsync(tutor.Id);
            if (!result.IsSuccess)
            {
                _errorMessage = string.IsNullOrWhiteSpace(result.Error)
                    ? "Suppression impossible."
                    : result.Error;
                return;
            }

            _tutors.RemoveAll(t => t.Id == tutor.Id);
            _successMessage = $"Enseignant « {tutor.FullName} » supprimé. Cours annulés et paiements parents remboursés.";
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally { _pendingUserId = null; }
    }

    private async Task ApproveSchoolAsync(AdminUserItem tutor)
    {
        _approvingTenant = tutor.Id;
        _successMessage = null;
        _errorMessage = null;
        try
        {
            // Préférer le tenantId réel ; à défaut l'API accepte aussi le userId (GUID).
            var key = tutor.TenantId?.ToString() ?? tutor.Id;
            var result = await Api.PostWithErrorAsync<object>($"api/admin/tenants/{key}/approve", new { });
            if (result.Error is not null)
            {
                _errorMessage = result.Error;
                return;
            }

            _successMessage = $"Profil de {tutor.FullName} approuvé.";
            // Recharger pour récupérer TenantId / école si créée à la volée.
            _tutors = await AdminSvc.GetUsersAsync("Tutor");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally { _approvingTenant = null; }
    }

    private static string Initials(string fullName)
    {
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            : fullName.Length >= 1 ? fullName[..1].ToUpperInvariant() : "?";
    }
}
