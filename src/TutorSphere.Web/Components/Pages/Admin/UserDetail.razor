@page "/admin/users/{UserId}"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TutorSphere.Application.DTOs.Branding
@using TutorSphere.Application.DTOs.ExpertApproval
@inject AdminService AdminSvc
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>Fiche utilisateur — Control Center</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        @if (_loading)
        {
            <div class="cc-empty"><span class="spinner-border"></span></div>
        }
        else if (_user is null)
        {
            <div class="cc-empty">
                <i class="bi bi-person-x"></i>
                <p>Utilisateur introuvable.</p>
                <a href="admin/users" class="cc-btn mt-3">Retour</a>
            </div>
        }
        else
        {
            <div class="cc-toolbar">
                <div class="d-flex align-items-center gap-3">
                    <span class="cc-user-avatar" style="width:52px;height:52px;font-size:1rem;">@Initials(_user.FullName)</span>
                    <div>
                        <h1 class="cc-page-title">@_user.FullName</h1>
                        <p class="cc-page-sub">
                            <span class="cc-pill cc-pill-type @RoleClass(_user.Role)">@RoleLabel(_user.Role)</span>
                            <span class="ms-2">@_user.Email</span>
                            @if (_teacher is not null)
                            {
                                <span class="ms-2 cc-pill @(_teacher.IsPublicProfile ? "cc-pill-ok" : "cc-pill-type")">
                                    @(_teacher.IsPublicProfile ? "Fiche publique" : "Fiche non publiée")
                                </span>
                            }
                        </p>
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    @if (_user.IsActive)
                    {
                        <button type="button" class="cc-btn" @onclick="DeactivateAsync"><i class="bi bi-lock"></i> Suspendre</button>
                    }
                    else
                    {
                        <button type="button" class="cc-btn cc-btn-primary" @onclick="ActivateAsync"><i class="bi bi-unlock"></i> Activer</button>
                    }
                    <button type="button" class="cc-btn" @onclick="ResetPasswordAsync"><i class="bi bi-arrow-repeat"></i> Réinit. MDP</button>
                    @if (_teacher is not null && _canEditTeacher)
                    {
                        <button type="button" class="cc-btn cc-btn-primary" @onclick="StartEditPublicProfile">
                            <i class="bi bi-pencil-square"></i> Éditer fiche publique
                        </button>
                    }
                    @if (_teacher is not null && !_teacher.IsPublicProfile)
                    {
                        <button type="button" class="cc-btn" disabled="@_busy" @onclick="PublishProfileAsync">
                            <i class="bi bi-globe2"></i> Publier fiche publique
                        </button>
                    }
                    else if (_teacher is { IsPublicProfile: true })
                    {
                        <a class="cc-btn" href="@($"/profil/{_teacher.Slug}")" target="_blank" rel="noopener">
                            <i class="bi bi-box-arrow-up-right"></i> Voir fiche publique
                        </a>
                    }
                    @if (_isSuperAdmin && (_user.Role is "Parent" or "Student"))
                    {
                        <button type="button" class="cc-btn" style="color:#f87171;border-color:#f87171;" @onclick="DeleteAsync">
                            <i class="bi bi-trash"></i> Supprimer
                        </button>
                    }
                    @if (_canEditTeacher && _user.Role is "Tutor" or "TeachingAssistant")
                    {
                        <button type="button" class="cc-btn" style="color:#f87171;border-color:#f87171;" @onclick="DeleteTeacherFromDetailAsync">
                            <i class="bi bi-trash"></i> Supprimer
                        </button>
                    }
                    <a href="admin/users" class="cc-btn">Retour</a>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="cc-alert cc-alert-success"><i class="bi bi-check-circle"></i> @_message</div>
            }
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="cc-alert cc-alert-danger"><i class="bi bi-exclamation-circle"></i> @_error</div>
            }

            <div class="cc-tabs">
                @foreach (var tab in Tabs)
                {
                    <button type="button" class="cc-tab @(_tab == tab.Key ? "active" : null)"
                            @onclick="() => SelectTabAsync(tab.Key)">@tab.Label</button>
                }
            </div>

            @if (_tab == "info")
            {
                @if (_teacher is not null && _canEditTeacher)
                {
                    <div class="cc-card mb-3" id="teacher-public-editor">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                            <div>
                                <h2 class="cc-card-title mb-1">Fiche publique de l'enseignant</h2>
                                <p class="small text-muted mb-0">
                                    Contenu visible sur <code>/profil/@_teacher.Slug</code>
                                    et dans la recherche parents. L’aperçu à droite reprend le rendu final parents
                                    (e-mail et téléphone jamais affichés).
                                </p>
                            </div>
                            <span class="cc-pill @(_teacher.IsPublicProfile ? "cc-pill-ok" : "cc-pill-type")">
                                @(_teacher.IsPublicProfile ? "Publiée" : "Brouillon — non publiée")
                            </span>
                        </div>

                        <div class="row g-4 align-items-start">
                            <div class="col-xl-5">
                                @if (!_editingPublicProfile)
                                {
                                    <div class="cc-detail-grid mb-3">
                                        <div class="cc-detail-item"><label>Nom affiché</label><strong>@_teacher.SchoolName</strong></div>
                                        <div class="cc-detail-item"><label>Enseignant</label><strong>@_teacher.FirstName @_teacher.LastName</strong></div>
                                        <div class="cc-detail-item"><label>Ville / Pays</label><strong>@(_teacher.City ?? "—") / @(_teacher.Country ?? "—")</strong></div>
                                        <div class="cc-detail-item"><label>Langue / Devise</label><strong>@TeacherLanguageSummary / @(_teacher.Currency ?? "—")</strong></div>
                                        <div class="cc-detail-item" style="grid-column:1/-1">
                                            <label>Présentation</label>
                                            <strong>@(string.IsNullOrWhiteSpace(_teacher.Presentation) && string.IsNullOrWhiteSpace(_teacher.Description) ? "—" : (_teacher.Presentation ?? _teacher.Description))</strong>
                                        </div>
                                        <div class="cc-detail-item" style="grid-column:1/-1">
                                            <label>Métadonnées</label>
                                            <strong>
                                                Slug : <code>@_teacher.Slug</code>
                                                · Groupe : @(_teacher.ApprovedByExpertGroupName ?? "—")
                                                · Licence : @(_teacher.HasValidLicense ? "OK" : "à publier")
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <button type="button" class="cc-btn cc-btn-primary" @onclick="StartEditPublicProfile">
                                            <i class="bi bi-pencil-square"></i> Éditer la fiche publique
                                        </button>
                                        @if (_teacher.IsPublicProfile)
                                        {
                                            <a class="cc-btn" href="@($"/profil/{_teacher.Slug}")" target="_blank" rel="noopener">
                                                <i class="bi bi-box-arrow-up-right"></i> Voir fiche publique
                                            </a>
                                            <button type="button" class="cc-btn" disabled="@_busy" @onclick="UnpublishProfileAsync">
                                                <i class="bi bi-eye-slash"></i> Dépublier
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="cc-btn" disabled="@_busy" @onclick="PublishProfileAsync">
                                                <i class="bi bi-globe2"></i> Créer / publier maintenant
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Prénom</label>
                                            <input class="form-control" @bind="_editFirstName" @bind:event="oninput" id="pub-edit-firstname" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Nom</label>
                                            <input class="form-control" @bind="_editLastName" @bind:event="oninput" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Téléphone (compte — jamais public)</label>
                                            <input class="form-control" @bind="_editPhone" @bind:event="oninput" autocomplete="off" />
                                            <div class="form-text">Réservé à l’admin / l’enseignant. Masqué sur la fiche parents et dans les courriels familles.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Nom affiché (profil)</label>
                                            <input class="form-control" @bind="_editSchoolName" @bind:event="oninput" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Ville</label>
                                            <input class="form-control" @bind="_editCity" @bind:event="oninput" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Pays (ISO)</label>
                                            <input class="form-control" @bind="_editCountry" @bind:event="oninput" maxlength="2" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Présentation publique *</label>
                                            <textarea class="form-control" rows="4" @bind="_editPresentation" @bind:event="oninput"
                                                      placeholder="Texte d'accueil visible sur la fiche publique…"></textarea>
                                            <div class="form-text">Affiché en priorité sur la page publique.</div>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Description courte</label>
                                            <textarea class="form-control" rows="2" @bind="_editDescription" @bind:event="oninput"
                                                      placeholder="Résumé (recherche / à propos)…"></textarea>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">Langues de communication</label>
                                            <TeacherCommunicationLanguagePicker Selected="_editLanguages"
                                                                               SelectedChanged="OnEditLanguagesChanged"
                                                                               IdPrefix="admin-teacher-lang"
                                                                               Hint="@L["TeacherApply_LanguageHint"]" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Devise</label>
                                            <input class="form-control" @bind="_editCurrency" @bind:event="oninput" />
                                        </div>
                                        <div class="col-12">
                                            <div class="small text-muted">
                                                Slug : <code>@_teacher.Slug</code>
                                                · Groupe : @(_teacher.ApprovedByExpertGroupName ?? "—")
                                                · Licence : @(_teacher.HasValidLicense ? "OK" : "à publier")
                                            </div>
                                        </div>
                                        @if (!_teacher.IsPublicProfile)
                                        {
                                            <div class="col-12">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="pubAfterSave" @bind="_publishAfterSave" />
                                                    <label class="form-check-label" for="pubAfterSave">
                                                        Publier la fiche après enregistrement (visible recherche + /profil/…)
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <div class="mt-3 d-flex gap-2 flex-wrap">
                                        <button type="button" class="cc-btn cc-btn-primary" disabled="@_busy" @onclick="SaveTeacherAsync">
                                            @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            <i class="bi bi-check-lg"></i>
                                            @(_teacher.IsPublicProfile ? "Enregistrer les modifications" : "Enregistrer la fiche")
                                        </button>
                                        <button type="button" class="cc-btn" disabled="@_busy" @onclick="CancelEditPublicProfile">
                                            Annuler
                                        </button>
                                        @if (!_teacher.IsPublicProfile)
                                        {
                                            <button type="button" class="cc-btn" disabled="@_busy" @onclick="PublishProfileAsync">
                                                <i class="bi bi-globe2"></i> Créer / publier maintenant
                                            </button>
                                        }
                                        else
                                        {
                                            <a class="cc-btn" href="@($"/profil/{_teacher.Slug}")" target="_blank" rel="noopener">
                                                <i class="bi bi-box-arrow-up-right"></i> Voir fiche publique
                                            </a>
                                            <button type="button" class="cc-btn" disabled="@_busy" @onclick="UnpublishProfileAsync">
                                                <i class="bi bi-eye-slash"></i> Dépublier
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="col-xl-7">
                                <div class="cc-parent-profile-preview sticky-top" style="top:1rem;">
                                    <div class="cc-parent-profile-preview-bar">
                                        <span><i class="bi bi-eye"></i> Aperçu parents — rendu final</span>
                                        @if (!_teacher.IsPublicProfile)
                                        {
                                            <span class="cc-pill cc-pill-type">Brouillon</span>
                                        }
                                    </div>
                                    <div class="cc-parent-profile-preview-frame tutor-detail-public">
                                        <TutorDetailView Profile="BuildParentPreview()" PreviewMode="true" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="cc-detail-grid">
                        <div class="cc-detail-item"><label>Type</label><strong>@RoleLabel(_user.Role)</strong></div>
                        <div class="cc-detail-item"><label>Statut</label><strong>@(_user.IsActive ? "Actif" : "Inactif")</strong></div>
                        <div class="cc-detail-item"><label>Pays</label><strong>@(_user.Country ?? "—")</strong></div>
                        <div class="cc-detail-item"><label>Ville</label><strong>@(_user.City ?? "—")</strong></div>
                        <div class="cc-detail-item"><label>Nom affiché</label><strong>@(_user.SchoolName ?? "—")</strong></div>
                        <div class="cc-detail-item"><label>Téléphone</label><strong>@(_user.Phone ?? "—")</strong></div>
                        <div class="cc-detail-item"><label>Langue</label><strong>@_user.PreferredLanguage</strong></div>
                        <div class="cc-detail-item"><label>Fuseau horaire</label><strong>@_user.TimeZone</strong></div>
                        <div class="cc-detail-item"><label>Créé</label><strong>@(_user.CreatedAt?.ToString("dd MMMM yyyy") ?? "—")</strong></div>
                        <div class="cc-detail-item"><label>Dernière connexion</label><strong>@(_user.LastLoginAt?.ToString("dd MMMM yyyy HH:mm") ?? "—")</strong></div>
                    </div>
                }
            }
            else if (_tab == "students")
            {
                <div class="cc-card">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                        <div>
                            <h2 class="cc-card-title mb-1">Élèves inscrits actuellement</h2>
                            <p class="small text-muted mb-0">Abonnements actifs aux cours de cet enseignant.</p>
                        </div>
                        @if (_teacher is not null)
                        {
                            <button type="button" class="cc-btn btn-sm" disabled="@_studentsLoading" @onclick="LoadActiveStudentsAsync">
                                <i class="bi bi-arrow-clockwise"></i> Actualiser
                            </button>
                        }
                    </div>

                    @if (_teacher is null)
                    {
                        <div class="cc-empty">
                            <i class="bi bi-people"></i>
                            <p>Cet utilisateur n'est pas un enseignant — pas de liste d'élèves.</p>
                        </div>
                    }
                    else if (_studentsLoading)
                    {
                        <div class="cc-empty"><span class="spinner-border"></span></div>
                    }
                    else if (!string.IsNullOrEmpty(_studentsError))
                    {
                        <div class="cc-alert cc-alert-danger"><i class="bi bi-exclamation-circle"></i> @_studentsError</div>
                    }
                    else if (_activeStudents.Count == 0)
                    {
                        <div class="cc-empty">
                            <i class="bi bi-mortarboard"></i>
                            <p>Aucun élève ne suit actuellement un cours de cet enseignant.</p>
                        </div>
                    }
                    else
                    {
                        <div class="cc-table-wrap">
                            <table class="cc-table">
                                <thead>
                                    <tr>
                                        <th>Élève</th>
                                        <th>Parent</th>
                                        <th>Cours / offre</th>
                                        <th>Séances restantes</th>
                                        <th>Période</th>
                                        <th>Tarif</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in _activeStudents)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@s.StudentName</strong>
                                                @if (!string.IsNullOrWhiteSpace(s.StudentEmail))
                                                {
                                                    <div class="small text-muted">@s.StudentEmail</div>
                                                }
                                            </td>
                                            <td>@(s.ParentName ?? "—")</td>
                                            <td>
                                                <strong>@s.OfferingTitle</strong>
                                                @if (!string.IsNullOrWhiteSpace(s.Subject))
                                                {
                                                    <div class="small text-muted">@s.Subject</div>
                                                }
                                            </td>
                                            <td>@s.SessionsRemaining</td>
                                            <td class="small">
                                                @s.StartDate.ToLocalTime().ToString("dd MMM yyyy")
                                                –
                                                @s.EndDate.ToLocalTime().ToString("dd MMM yyyy")
                                            </td>
                                            <td>@s.Price.ToString("N0") @s.Currency</td>
                                            <td><span class="cc-pill cc-pill-ok">@s.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="small text-muted mt-2 mb-0">@_activeStudents.Count élève(s) actif(s).</p>
                    }
                </div>
            }
            else
            {
                <div class="cc-card">
                    <div class="cc-empty">
                        <i class="bi bi-hourglass-split"></i>
                        <p>Module « @Tabs.First(t => t.Key == _tab).Label » — données en cours d'intégration au Control Center.</p>
                    </div>
                </div>
            }
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public string UserId { get; set; } = "";

    private AdminUserDetail? _user;
    private TeacherSchoolVm? _teacher;
    private TeacherPublicProfileDto? _publicDetail;
    private bool _loading = true;
    private bool _isSuperAdmin;
    private bool _canEditTeacher;
    private bool _busy;
    private bool _editingPublicProfile;
    private bool _publishAfterSave = true;
    private string _tab = "info";
    private string? _message;
    private string? _error;

    private string _editFirstName = "";
    private string _editLastName = "";
    private string? _editPhone;
    private string _editSchoolName = "";
    private string? _editDescription;
    private string? _editPresentation;
    private string? _editCity;
    private string? _editCountry;
    private List<string> _editLanguages = [SupportedLanguageCodes.French];
    private string TeacherLanguageSummary =>
        _teacher is null
            ? "—"
            : string.Join(" · ", TeacherCommunicationLanguages.NormalizeMany(
                _teacher.CommunicationLanguages, _teacher.Language).Select(TeacherCommunicationLanguages.Label));
    private string _editCurrency = "XAF";

    private List<ActiveStudentVm> _activeStudents = [];
    private bool _studentsLoading;
    private bool _studentsLoaded;
    private string? _studentsError;

    private static readonly (string Key, string Label)[] Tabs =
    [
        ("info", "Informations"),
        ("students", "Élèves"),
        ("activity", "Activité"),
        ("payments", "Paiements"),
        ("courses", "Cours"),
        ("documents", "Documents"),
        ("login", "Connexion"),
        ("history", "Historique"),
        ("ai", "IA"),
        ("support", "Support"),
    ];

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        _isSuperAdmin = Auth.IsInRole("SuperAdmin");
        _canEditTeacher = _isSuperAdmin || Auth.IsInRole("PlatformAdmin");
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (uri.Query.Contains("tab=history", StringComparison.OrdinalIgnoreCase))
            _tab = "history";

        try
        {
            _user = await AdminSvc.GetUserAsync(UserId);
            if (_user?.Role is "Tutor" or "TeachingAssistant")
                await LoadTeacherAsync();
        }
        catch { _user = null; }
        finally { _loading = false; }
    }

    private async Task LoadTeacherAsync()
    {
        try
        {
            _teacher = await Api.GetAsync<TeacherSchoolVm>($"api/admin/teachers/by-user/{UserId}");
            if (_teacher is not null)
            {
                FillEditFromTeacher();
                await LoadPublicDetailAsync();
            }
        }
        catch { _teacher = null; }
    }

    private async Task LoadPublicDetailAsync()
    {
        _publicDetail = null;
        if (_teacher is null || string.IsNullOrWhiteSpace(_teacher.Slug))
            return;
        try
        {
            _publicDetail = await Api.GetAsync<TeacherPublicProfileDto>(
                $"api/branding/{Uri.EscapeDataString(_teacher.Slug)}/tutor");
        }
        catch
        {
            _publicDetail = null;
        }
    }

    /// <summary>Rendu parents : champs éditables + offres/photo publiées. Jamais e-mail/téléphone/nom complet.</summary>
    private TeacherPublicProfileDto BuildParentPreview()
    {
        var t = _teacher!;
        var editing = _editingPublicProfile;
        var schoolName = editing
            ? (string.IsNullOrWhiteSpace(_editSchoolName) ? t.SchoolName : _editSchoolName.Trim())
            : t.SchoolName;
        var first = editing ? _editFirstName.Trim() : t.FirstName;
        var last = editing ? _editLastName.Trim() : t.LastName;
        var display = TeacherPublicName.Format(first, last, schoolName);

        var presentation = editing ? _editPresentation : (t.Presentation ?? t.Description);
        var description = editing ? _editDescription : t.Description;
        var fullBio = string.IsNullOrWhiteSpace(presentation) ? description : presentation;
        var shortBio = string.IsNullOrWhiteSpace(description) ? presentation : description;

        var city = editing ? _editCity : t.City;
        var country = editing ? _editCountry : t.Country;
        var language = editing
            ? TeacherCommunicationLanguages.Primary(_editLanguages)
            : t.Language;
        var currency = editing
            ? (string.IsNullOrWhiteSpace(_editCurrency) ? t.Currency : _editCurrency)
            : t.Currency;

        var baseDto = _publicDetail;
        var photo = TeacherPublicPhotoResolver.Resolve(
            baseDto?.PhotoUrl,
            baseDto?.ExpertGroupLogoUrl,
            TeacherPublicName.Initials(first, last, schoolName));
        return new TeacherPublicProfileDto
        {
            Slug = t.Slug,
            DisplayName = display,
            GivenName = TeacherPublicName.FirstToken(first),
            PublicInitials = photo.Initials,
            Location = TeacherPublicName.GeneralLocation(city, country),
            City = city,
            Country = country,
            Language = language,
            Languages = editing
                ? _editLanguages.Select(TeacherCommunicationLanguages.Label).ToList()
                : (baseDto?.Languages ?? Array.Empty<string>()),
            Currency = currency,
            PhotoUrl = photo.Url,
            PhotoKind = TeacherPublicPhotoResolver.ToApi(photo.Kind),
            PhotoIsGroupLogoFallback = photo.IsGroupLogoFallback,
            BannerUrl = baseDto?.BannerUrl,
            PrimaryColor = baseDto?.PrimaryColor ?? ColorHex.TutorSpherePrimary,
            SecondaryColor = baseDto?.SecondaryColor ?? ColorHex.TutorSphereSecondary,
            ShortBio = shortBio,
            FullBio = fullBio,
            YearsExperience = baseDto?.YearsExperience ?? 0,
            HourlyRate = baseDto?.HourlyRate ?? 0,
            Status = baseDto?.Status,
            Diplomas = baseDto?.Diplomas ?? Array.Empty<PublicCredentialDto>(),
            Certifications = baseDto?.Certifications ?? Array.Empty<PublicCredentialDto>(),
            Subjects = baseDto?.Subjects ?? Array.Empty<string>(),
            Levels = baseDto?.Levels ?? Array.Empty<string>(),
            Availability = baseDto?.Availability ?? Array.Empty<string>(),
            Offerings = baseDto?.Offerings ?? Array.Empty<PublicOfferingDto>(),
            ExpertGroupName = t.ApprovedByExpertGroupName ?? baseDto?.ExpertGroupName,
            ExpertGroupLogoUrl = baseDto?.ExpertGroupLogoUrl,
            ExpertGroupCountryCode = baseDto?.ExpertGroupCountryCode,
            IsVerified = true,
            Rating = baseDto?.Rating,
            ReviewCount = baseDto?.ReviewCount ?? 0,
            Disciplines = baseDto?.Disciplines
        };
    }

    private void FillEditFromTeacher()
    {
        if (_teacher is null) return;
        _editFirstName = _teacher.FirstName;
        _editLastName = _teacher.LastName;
        _editPhone = _teacher.Phone;
        _editSchoolName = _teacher.SchoolName;
        _editDescription = _teacher.Description;
        _editPresentation = string.IsNullOrWhiteSpace(_teacher.Presentation)
            ? _teacher.Description
            : _teacher.Presentation;
        _editCity = _teacher.City;
        _editCountry = _teacher.Country;
        _editLanguages = TeacherCommunicationLanguages.NormalizeMany(
            _teacher.CommunicationLanguages, _teacher.Language).ToList();
        _editCurrency = string.IsNullOrWhiteSpace(_teacher.Currency) ? "XAF" : _teacher.Currency;
        _publishAfterSave = !_teacher.IsPublicProfile;
        // Brouillon : formulaire ouvert ; publié : résumé + bouton Éditer.
        if (!_teacher.IsPublicProfile)
            _editingPublicProfile = true;
    }

    private void OnEditLanguagesChanged(List<string> next) =>
        _editLanguages = next.Count == 0 ? [SupportedLanguageCodes.French] : next;

    private async Task StartEditPublicProfile()
    {
        _tab = "info";
        _editingPublicProfile = true;
        FillEditFromTeacher();
        _message = null;
        _error = null;
        try
        {
            await JS.InvokeVoidAsync("eval",
                "document.getElementById('teacher-public-editor')?.scrollIntoView({behavior:'smooth',block:'start'})");
        }
        catch { }
    }

    private void CancelEditPublicProfile()
    {
        FillEditFromTeacher();
        _editingPublicProfile = _teacher is null || !_teacher.IsPublicProfile;
        _error = null;
    }

    private async Task SaveTeacherAsync()
    {
        if (_user is null || _teacher is null) return;
        await SaveTeacherCoreAsync(publish: !_teacher.IsPublicProfile && _publishAfterSave);
    }

    private async Task SaveTeacherCoreAsync(bool publish)
    {
        if (_user is null || _teacher is null) return;
        _busy = true;
        _message = null;
        _error = null;
        try
        {
            var result = await Api.PutWithErrorAsync<TeacherSchoolVm>($"api/admin/teachers/by-user/{UserId}", new
            {
                firstName = _editFirstName,
                lastName = _editLastName,
                phone = _editPhone,
                schoolName = _editSchoolName,
                description = _editDescription,
                presentation = _editPresentation,
                city = _editCity,
                country = _editCountry,
                language = TeacherCommunicationLanguages.Primary(_editLanguages),
                communicationLanguages = _editLanguages,
                currency = _editCurrency,
                publish
            });
            if (!result.IsSuccess || result.Value is null)
            {
                _error = result.Error ?? "Échec de l'enregistrement.";
                return;
            }

            _teacher = result.Value;
            FillEditFromTeacher();
            await LoadPublicDetailAsync();
            _user = _user with
            {
                FullName = $"{_teacher.FirstName} {_teacher.LastName}".Trim(),
                FirstName = _teacher.FirstName,
                LastName = _teacher.LastName,
                Phone = _teacher.Phone,
                SchoolName = _teacher.SchoolName,
                City = _teacher.City,
                Country = _teacher.Country
            };
            _message = _teacher.IsPublicProfile
                ? "Fiche publique mise à jour."
                : "Fiche enregistrée (brouillon). Publiez-la pour la rendre visible.";
            if (_teacher.IsPublicProfile)
                _editingPublicProfile = false;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task PublishProfileAsync()
    {
        if (_teacher is null) return;
        await SaveTeacherCoreAsync(publish: false);
        if (!string.IsNullOrEmpty(_error) || _teacher is null) return;

        _busy = true;
        _message = null;
        _error = null;
        try
        {
            var result = await Api.PostWithErrorAsync<PublishResult>($"api/admin/teachers/{_teacher.TenantId}/publish-profile", new { });
            if (!result.IsSuccess)
            {
                _error = result.Error ?? "Échec de la publication.";
                return;
            }

            await LoadTeacherAsync();
            _message = result.Value is not null
                ? $"Fiche publique créée : {result.Value.PublicPath}"
                : "Fiche publique publiée.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task UnpublishProfileAsync()
    {
        if (_teacher is null) return;
        _busy = true;
        _message = null;
        _error = null;
        try
        {
            var result = await Api.PostWithErrorAsync<PublishResult>($"api/admin/teachers/{_teacher.TenantId}/unpublish-profile", new { });
            if (!result.IsSuccess)
            {
                _error = result.Error ?? "Échec de la dépublication.";
                return;
            }

            await LoadTeacherAsync();
            _message = "Fiche dépubliée — retirée de la recherche et de la page publique.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ActivateAsync()
    {
        if (_user is null) return;
        if (await AdminSvc.ActivateUserAsync(_user.Id))
        {
            _user = _user with { IsActive = true };
            _message = "Compte activé.";
        }
        else _error = "Échec de l'activation.";
    }

    private async Task DeactivateAsync()
    {
        if (_user is null) return;
        if (await AdminSvc.DeactivateUserAsync(_user.Id))
        {
            _user = _user with { IsActive = false };
            _message = "Compte suspendu.";
        }
        else _error = "Échec de la suspension.";
    }

    private async Task ResetPasswordAsync()
    {
        if (_user is null) return;
        _message = await AdminSvc.ResetPasswordAsync(_user.Id)
            ? "Lien de réinitialisation envoyé."
            : null;
        if (_message is null) _error = "Impossible d'envoyer le lien.";
    }

    private async Task DeleteAsync()
    {
        if (_user is null) return;
        _message = null;
        _error = null;
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Supprimer définitivement le compte {RoleLabel(_user.Role)} « {_user.FullName} » ?\n\nCette action est irréversible.");
        if (!confirmed) return;

        var result = await AdminSvc.DeleteUserAsync(_user.Id);
        if (result.Error is not null)
        {
            _error = result.Error;
            return;
        }

        Navigation.NavigateTo(_user.Role == "Parent" ? "admin/parents" : "admin/students");
    }

    private async Task DeleteTeacherFromDetailAsync()
    {
        if (_user is null) return;
        _message = null;
        _error = null;
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Supprimer définitivement l'enseignant « {_user.FullName} » ?\n\nTous les cours programmés seront annulés et les parents déjà payés seront remboursés, sans leur consentement.\n\nLe compte et le profil seront ensuite effacés. Action irréversible.");
        if (!confirmed) return;

        var result = await AdminSvc.DeleteUserAsync(_user.Id);
        if (result.Error is not null)
        {
            _error = result.Error;
            return;
        }

        Navigation.NavigateTo("admin/teachers");
    }

    private static string Initials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }

    private static string RoleLabel(string role) => role switch
    {
        "Parent" => "Parent",
        "Student" => "Élève",
        "Tutor" => "Tuteur",
        "TeachingAssistant" => "Enseignant",
        _ => role
    };

    private static string RoleClass(string role) => role switch
    {
        "Parent" => "parent",
        "Student" => "student",
        "Tutor" => "tutor",
        "TeachingAssistant" => "teacher",
        _ => ""
    };

    private async Task SelectTabAsync(string key)
    {
        _tab = key;
        if (key == "students" && !_studentsLoaded && _teacher is not null)
            await LoadActiveStudentsAsync();
    }

    private async Task LoadActiveStudentsAsync()
    {
        if (_teacher is null) return;
        _studentsLoading = true;
        _studentsError = null;
        try
        {
            _activeStudents = await Api.GetAsync<List<ActiveStudentVm>>(
                $"api/admin/teachers/{_teacher.TenantId}/active-students") ?? [];
            _studentsLoaded = true;
        }
        catch (Exception ex)
        {
            _studentsError = ex.Message;
            _activeStudents = [];
        }
        finally { _studentsLoading = false; }
    }

    private sealed record ActiveStudentVm(
        Guid SubscriptionId,
        Guid StudentId,
        string StudentName,
        string? StudentEmail,
        string? ParentName,
        Guid OfferingId,
        string OfferingTitle,
        string? Subject,
        string Status,
        DateTime StartDate,
        DateTime EndDate,
        int SessionsRemaining,
        decimal Price,
        string Currency);

    private sealed record TeacherSchoolVm(
        Guid TenantId,
        string OwnerUserId,
        string OwnerEmail,
        string FirstName,
        string LastName,
        string? Phone,
        string SchoolName,
        string Slug,
        string? Description,
        string? Presentation,
        string? City,
        string? Country,
        string Language,
        IReadOnlyList<string>? CommunicationLanguages,
        string Currency,
        IReadOnlyList<string> VisibleCountryCodes,
        bool IsPublicProfile,
        bool IsActiveSchool,
        bool HasValidLicense,
        bool OnboardingCompleted,
        DateTime? LicenseExpiresAt,
        int ExpertApprovalStatus,
        Guid? ApprovedByExpertGroupId,
        string? ApprovedByExpertGroupName);

    private sealed record PublishResult(Guid TenantId, string Slug, bool IsPublicProfile, string PublicPath);
}
