@page "/admin/users"
@page "/admin/parents"
@page "/admin/students"
@page "/admin/teachers"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AdminService AdminSvc
@inject AuthService Auth
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L

<PageTitle>Gestion des utilisateurs — Control Center</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized Context="adminAuth">
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">@_pageHeading</h1>
                <p class="cc-page-sub">Recherche avancée, actions et supervision des comptes TutorSphere.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (_isSuperAdmin)
                {
                    <button type="button" class="cc-btn cc-btn-primary" @onclick="OpenCreate">
                        <i class="bi bi-person-plus"></i> @_createButtonLabel
                    </button>
                }
                <a href="admin/users" class="cc-btn">Tous les rôles</a>
            </div>
        </div>

        <div class="cc-card mb-3">
            <div class="cc-filters">
                <div class="cc-field">
                    <label>Recherche</label>
                    <input type="search" placeholder="Nom, e-mail, téléphone…" @bind="_search" @bind:event="oninput" />
                </div>
                <div class="cc-field">
                    <label>Rôle</label>
                    <select @bind="_roleFilter">
                        <option value="all">Tous</option>
                        <option value="Parent">Parent</option>
                        <option value="Student">Élève</option>
                        <option value="Tutor">Enseignant (école)</option>
                        <option value="TeachingAssistant">Assistant</option>
                    </select>
                </div>
                <div class="cc-field">
                    <label>Pays</label>
                    <input @bind="_countryFilter" placeholder="Tous" />
                </div>
                <div class="cc-field">
                    <label>Statut</label>
                    <select @bind="_statusFilter">
                        <option value="all">Tous</option>
                        <option value="active">Actif</option>
                        <option value="inactive">Inactif</option>
                    </select>
                </div>
                <div class="cc-field">
                    <label>École</label>
                    <input @bind="_schoolFilter" placeholder="Toutes" />
                </div>
                <div class="cc-field d-flex align-items-end">
                    <button type="button" class="cc-btn cc-btn-primary w-100" @onclick="ReloadAsync">
                        <i class="bi bi-search"></i> Filtrer
                    </button>
                </div>
            </div>
        </div>

        @if (_showCreate)
        {
            <div class="cc-card mb-3">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h2 class="h5 mb-1">Créer un compte</h2>
                        <p class="text-muted small mb-0">Un mot de passe temporaire sera généré et envoyé par e-mail.</p>
                    </div>
                    <button type="button" class="cc-btn btn-sm" @onclick="CloseCreate">Fermer</button>
                </div>

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="cc-alert cc-alert-danger mb-3"><i class="bi bi-exclamation-circle"></i> @_formError</div>
                }
                @if (!string.IsNullOrEmpty(_createdPassword))
                {
                    <div class="cc-alert cc-alert-success mb-3">
                        <i class="bi bi-check-circle"></i>
                        Compte créé pour <strong>@_createdEmail</strong>.
                        Mot de passe temporaire :
                        <code class="user-select-all">@_createdPassword</code>
                        @if (_createdCredentialsSent)
                        {
                            <span> — e-mail envoyé.</span>
                        }
                        else
                        {
                            <span> — communiquez ce mot de passe manuellement.</span>
                        }
                    </div>
                }

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Type de compte</label>
                        <select class="form-select" @bind="_createKind" @bind:after="OnCreateKindChanged">
                            <option value="Parent">Parent</option>
                            <option value="Student">Élève</option>
                            <option value="Teacher">Enseignant (école)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Prénom *</label>
                        <input class="form-control" @bind="_cFirstName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nom *</label>
                        <input class="form-control" @bind="_cLastName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Courriel *</label>
                        <input type="email" class="form-control" @bind="_cEmail" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Téléphone</label>
                        <input class="form-control" @bind="_cPhone" />
                    </div>

                    @if (_createKind == "Student")
                    {
                        <div class="col-md-4">
                            <label class="form-label">Date de naissance *</label>
                            <input type="date" class="form-control" @bind="_cDob" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">E-mail du parent (obligatoire si &lt; 14 ans)</label>
                            <input type="email" class="form-control" @bind="_cParentEmail" placeholder="parent@example.com" />
                        </div>
                    }

                    @if (_createKind == "Teacher")
                    {
                        <div class="col-md-6">
                            <label class="form-label">Groupe d'experts *</label>
                            <select class="form-select" @bind="_cExpertGroupId">
                                <option value="">— Sélectionner —</option>
                                @foreach (var g in _expertGroups.Where(x => x.IsActive))
                                {
                                    <option value="@g.Id.ToString()">@g.Name @(g.CountryCode is null ? "(International)" : $"({g.CountryCode})")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nom de l'école / profil</label>
                            <input class="form-control" @bind="_cSchoolName" placeholder="Ex. École BEDIGA" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Sous-domaine (slug)</label>
                            <input class="form-control" @bind="_cSlug" placeholder="auto si vide" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ville</label>
                            <input class="form-control" @bind="_cCity" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="actSchool" @bind="_cActivateSchool" />
                                <label class="form-check-label" for="actSchool">Activer l'école immédiatement</label>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="pubProfile" @bind="_cPublishPublic" />
                                <label class="form-check-label" for="pubProfile">Créer / publier la fiche publique</label>
                            </div>
                        </div>

                        <div class="col-12">
                            <hr class="my-2" />
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="createOffer" @bind="_cCreateOffer" />
                                <label class="form-check-label" for="createOffer">Créer une offre de service pour cet enseignant</label>
                            </div>
                        </div>
                        @if (_cCreateOffer)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Titre de l'offre *</label>
                                <input class="form-control" @bind="_cOfferTitle" placeholder="Ex. Maths collège — 4 séances / mois" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Matière</label>
                                <input class="form-control" @bind="_cOfferSubject" placeholder="Mathématiques" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Mode</label>
                                <select class="form-select" @bind="_cOfferMode">
                                    <option value="En ligne">En ligne</option>
                                    <option value="Présentiel">Présentiel</option>
                                    <option value="Hybride">Hybride</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Prix *</label>
                                <input type="number" min="0" step="100" class="form-control" @bind="_cOfferPrice" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Devise</label>
                                <input class="form-control" @bind="_cOfferCurrency" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Durée (jours)</label>
                                <input type="number" min="1" class="form-control" @bind="_cOfferDurationDays" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Séances</label>
                                <input type="number" min="1" class="form-control" @bind="_cOfferSessionCount" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Fréquence</label>
                                <input class="form-control" @bind="_cOfferFrequency" placeholder="Ex. 1× / semaine" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" rows="2" @bind="_cOfferDescription"></textarea>
                            </div>
                        }
                    }
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button type="button" class="cc-btn cc-btn-primary" disabled="@_saving" @onclick="SaveCreateAsync">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Créer le compte
                    </button>
                    <button type="button" class="cc-btn" @onclick="CloseCreate">Annuler</button>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="cc-alert cc-alert-danger"><i class="bi bi-exclamation-circle"></i> @_errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="cc-alert cc-alert-success"><i class="bi bi-check-circle"></i> @_successMessage</div>
        }

        <div class="cc-card">
            @if (_isLoading)
            {
                <div class="cc-empty"><span class="spinner-border text-light"></span><p class="mt-3">Chargement des utilisateurs…</p></div>
            }
            else if (!Filtered.Any())
            {
                <div class="cc-empty"><i class="bi bi-person-x"></i><p>Aucun utilisateur trouvé.</p></div>
            }
            else
            {
                <div class="cc-table-wrap">
                    <table class="cc-table">
                        <thead>
                            <tr>
                                <th>Utilisateur</th>
                                <th>Type</th>
                                <th>Pays</th>
                                <th>École</th>
                                <th>Statut</th>
                                <th>Téléphone</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Filtered)
                            {
                                <tr>
                                    <td>
                                        <div class="cc-user-cell">
                                            <span class="cc-user-avatar">@Initials(user.FullName)</span>
                                            <span class="cc-user-cell-text">
                                                <strong>@user.FullName</strong>
                                                <span>@user.Email</span>
                                            </span>
                                        </div>
                                    </td>
                                    <td><span class="cc-pill cc-pill-type @RoleClass(user.Role)">@RoleLabel(user.Role)</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(user.Country) ? "—" : user.Country)</td>
                                    <td>@(string.IsNullOrWhiteSpace(user.SchoolName) ? "—" : user.SchoolName)</td>
                                    <td>
                                        <span class="cc-pill @(user.IsActive ? "cc-pill-ok" : "cc-pill-bad")">
                                            @(user.IsActive ? "Actif" : "Inactif")
                                        </span>
                                    </td>
                                    <td>@(user.Phone ?? "—")</td>
                                    <td>
                                        <div class="cc-actions-wrap">
                                            <button type="button" class="cc-actions-btn" @onclick="() => ToggleMenu(user.Id)">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            @if (_openMenuId == user.Id)
                                            {
                                                <div class="cc-dropdown">
                                                    <a href="admin/users/@user.Id"><i class="bi bi-eye"></i> Voir</a>
                                                    <a href="admin/users/@user.Id"><i class="bi bi-pencil"></i> Modifier</a>
                                                    @if (user.IsActive)
                                                    {
                                                        <button type="button" @onclick="() => ToggleUserAsync(user)"><i class="bi bi-lock"></i> Suspendre / Désactiver</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" @onclick="() => ToggleUserAsync(user)"><i class="bi bi-unlock"></i> Activer</button>
                                                    }
                                                    <button type="button" @onclick="() => ResetPasswordAsync(user)"><i class="bi bi-arrow-repeat"></i> Réinitialiser mot de passe</button>
                                                    @if (_isSuperAdmin && IsDeletableRole(user.Role))
                                                    {
                                                        <button type="button" class="danger" @onclick="() => DeleteUserAsync(user)">
                                                            <i class="bi bi-trash"></i> Supprimer
                                                        </button>
                                                    }
                                                    <a href="admin/support"><i class="bi bi-envelope"></i> Envoyer un message</a>
                                                    <a href="admin/users/@user.Id?tab=history"><i class="bi bi-graph-up"></i> Historique</a>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3" style="font-size:.78rem;color:var(--cc-text-muted);">
                    @Filtered.Count() utilisateur(s) affiché(s)
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="cc-empty">
            <i class="bi bi-shield-lock"></i>
            <p>Accès réservé aux administrateurs.</p>
            <a href="/login/admin" class="cc-btn cc-btn-primary mt-3">Se connecter</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string _pageHeading = "Utilisateurs";
    private string _roleFilter = "all";
    private string _search = "";
    private string _countryFilter = "";
    private string _schoolFilter = "";
    private string _statusFilter = "all";
    private bool _isLoading;
    private bool _isSuperAdmin;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _openMenuId;
    private List<AdminUserItem> _users = [];

    private bool _showCreate;
    private bool _saving;
    private string _createKind = "Parent";
    private string _cFirstName = "";
    private string _cLastName = "";
    private string _cEmail = "";
    private string? _cPhone;
    private DateTime? _cDob;
    private string? _cParentEmail;
    private string _cExpertGroupId = "";
    private string? _cSchoolName;
    private string? _cSlug;
    private string? _cCity;
    private bool _cActivateSchool = true;
    private bool _cPublishPublic = true;
    private bool _cCreateOffer;
    private string _cOfferTitle = "";
    private string? _cOfferDescription;
    private string? _cOfferSubject;
    private decimal _cOfferPrice;
    private string _cOfferCurrency = "XAF";
    private int _cOfferDurationDays = 30;
    private int _cOfferSessionCount = 4;
    private string? _cOfferFrequency;
    private string _cOfferMode = "En ligne";
    private List<ExpertGroupItem> _expertGroups = [];
    private string? _formError;
    private string? _createdPassword;
    private string? _createdEmail;
    private bool _createdCredentialsSent;

    private string _createButtonLabel => _roleFilter switch
    {
        "Student" => "Nouvel élève",
        "Tutor" => "Nouvel enseignant",
        "Parent" => "Nouveau parent",
        _ => "Créer un compte"
    };

    private IEnumerable<AdminUserItem> Filtered
    {
        get
        {
            IEnumerable<AdminUserItem> q = _users;
            if (!string.IsNullOrWhiteSpace(_search))
            {
                q = q.Where(u =>
                    u.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    u.Email.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (u.Phone?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            if (!string.IsNullOrWhiteSpace(_countryFilter))
                q = q.Where(u => u.Country?.Contains(_countryFilter, StringComparison.OrdinalIgnoreCase) == true);
            if (!string.IsNullOrWhiteSpace(_schoolFilter))
                q = q.Where(u => u.SchoolName?.Contains(_schoolFilter, StringComparison.OrdinalIgnoreCase) == true);
            if (_statusFilter == "active") q = q.Where(u => u.IsActive);
            if (_statusFilter == "inactive") q = q.Where(u => !u.IsActive);
            return q;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        _isSuperAdmin = Auth.IsInRole("SuperAdmin");

        var path = new Uri(Navigation.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
        (_pageHeading, _roleFilter, _createKind) = path switch
        {
            "admin/parents" => ("Parents", "Parent", "Parent"),
            "admin/students" => ("Élèves", "Student", "Student"),
            "admin/teachers" => ("Enseignants", "Tutor", "Teacher"),
            _ => ("Utilisateurs", "all", "Parent")
        };

        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0].Equals("q", StringComparison.OrdinalIgnoreCase))
                _search = Uri.UnescapeDataString(kv[1]);
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _openMenuId = null;
        try
        {
            var role = _roleFilter == "all" ? "all" : _roleFilter;
            _users = await AdminSvc.GetUsersAsync(role, string.IsNullOrWhiteSpace(_search) ? null : _search);
        }
        catch
        {
            _errorMessage = "Impossible de charger les utilisateurs.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreate()
    {
        _showCreate = true;
        _formError = null;
        _createdPassword = null;
        _createdEmail = null;
        if (_createKind == "Teacher" && _expertGroups.Count == 0)
        {
            try { _expertGroups = await AdminSvc.GetExpertGroupsAsync(); }
            catch { _expertGroups = []; }
        }
    }

    private void CloseCreate()
    {
        _showCreate = false;
        _formError = null;
    }

    private async Task OnCreateKindChanged()
    {
        _formError = null;
        _createdPassword = null;
        if (_createKind == "Teacher" && _expertGroups.Count == 0)
        {
            try { _expertGroups = await AdminSvc.GetExpertGroupsAsync(); }
            catch { _expertGroups = []; }
        }
    }

    private async Task SaveCreateAsync()
    {
        _saving = true;
        _formError = null;
        _createdPassword = null;
        _errorMessage = null;
        _successMessage = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_cFirstName) || string.IsNullOrWhiteSpace(_cLastName) || string.IsNullOrWhiteSpace(_cEmail))
            {
                _formError = "Prénom, nom et courriel sont obligatoires.";
                return;
            }

            ApiResult<AdminCreatedAccountItem> result;
            if (_createKind == "Parent")
            {
                result = await AdminSvc.CreateParentAccountAsync(_cEmail, _cFirstName, _cLastName, _cPhone);
            }
            else if (_createKind == "Student")
            {
                if (_cDob is null)
                {
                    _formError = "Date de naissance obligatoire.";
                    return;
                }
                result = await AdminSvc.CreateStudentAccountAsync(
                    _cEmail, _cFirstName, _cLastName, _cDob.Value, _cPhone, _cParentEmail);
            }
            else
            {
                if (!Guid.TryParse(_cExpertGroupId, out var groupId))
                {
                    _formError = "Sélectionnez un groupe d'experts.";
                    return;
                }
                object? initialOffering = null;
                if (_cCreateOffer)
                {
                    if (string.IsNullOrWhiteSpace(_cOfferTitle))
                    {
                        _formError = "Titre de l'offre obligatoire (ou décochez « Créer une offre »).";
                        return;
                    }
                    initialOffering = new
                    {
                        title = _cOfferTitle.Trim(),
                        description = string.IsNullOrWhiteSpace(_cOfferDescription) ? null : _cOfferDescription,
                        subject = string.IsNullOrWhiteSpace(_cOfferSubject) ? null : _cOfferSubject,
                        price = _cOfferPrice,
                        currency = string.IsNullOrWhiteSpace(_cOfferCurrency) ? "XAF" : _cOfferCurrency,
                        durationDays = _cOfferDurationDays > 0 ? _cOfferDurationDays : 30,
                        sessionCount = _cOfferSessionCount > 0 ? _cOfferSessionCount : 4,
                        frequency = string.IsNullOrWhiteSpace(_cOfferFrequency) ? null : _cOfferFrequency,
                        mode = _cOfferMode,
                        maxCapacity = 20
                    };
                }
                result = await AdminSvc.CreateTeacherAccountAsync(
                    _cEmail, _cFirstName, _cLastName, groupId,
                    _cSchoolName, _cSlug, _cCity, _cPhone, _cActivateSchool, initialOffering);
            }

            if (!result.IsSuccess || result.Value is null)
            {
                _formError = string.IsNullOrWhiteSpace(result.Error) ? "Échec de création." : result.Error;
                return;
            }

            var created = result.Value;
            _createdPassword = created.TemporaryPassword;
            _createdEmail = created.Email;
            _createdCredentialsSent = created.CredentialsSent;

            var extras = new List<string>();
            if (created.OfferingId is not null)
                extras.Add("offre créée");
            if (_createKind == "Teacher" && _cPublishPublic && created.TenantId is Guid tid)
            {
                var pub = await Api.PostWithErrorAsync<object>($"api/admin/teachers/{tid}/publish-profile", new { });
                extras.Add(pub.IsSuccess ? "fiche publique publiée" : "fiche publique non publiée");
            }

            _successMessage = extras.Count > 0
                ? $"Compte {RoleLabel(created.Role)} créé : {created.FullName} ({string.Join(", ", extras)})."
                : $"Compte {RoleLabel(created.Role)} créé : {created.FullName}.";
            _cFirstName = _cLastName = _cEmail = "";
            _cPhone = _cParentEmail = _cSchoolName = _cSlug = _cCity = null;
            _cExpertGroupId = "";
            _cDob = null;
            _cCreateOffer = false;
            _cPublishPublic = true;
            _cOfferTitle = "";
            _cOfferDescription = _cOfferSubject = _cOfferFrequency = null;
            _cOfferPrice = 0;
            _cOfferCurrency = "XAF";
            _cOfferDurationDays = 30;
            _cOfferSessionCount = 4;
            _cOfferMode = "En ligne";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally { _saving = false; }
    }

    private void ToggleMenu(string id) => _openMenuId = _openMenuId == id ? null : id;

    private async Task ToggleUserAsync(AdminUserItem user)
    {
        _openMenuId = null;
        _successMessage = null;
        _errorMessage = null;
        try
        {
            var ok = user.IsActive
                ? await AdminSvc.DeactivateUserAsync(user.Id)
                : await AdminSvc.ActivateUserAsync(user.Id);
            if (!ok) { _errorMessage = "L'opération a échoué."; return; }
            var idx = _users.IndexOf(user);
            if (idx >= 0) _users[idx] = user with { IsActive = !user.IsActive };
            _successMessage = user.IsActive
                ? $"Compte de {user.FullName} désactivé."
                : $"Compte de {user.FullName} activé.";
        }
        catch { _errorMessage = "Une erreur inattendue s'est produite."; }
    }

    private async Task ResetPasswordAsync(AdminUserItem user)
    {
        _openMenuId = null;
        _successMessage = null;
        _errorMessage = null;
        try
        {
            var ok = await AdminSvc.ResetPasswordAsync(user.Id);
            _successMessage = ok
                ? $"Lien de réinitialisation envoyé à {user.Email}."
                : null;
            if (!ok) _errorMessage = "Impossible d'envoyer le lien.";
        }
        catch { _errorMessage = "Une erreur inattendue s'est produite."; }
    }

    private async Task DeleteUserAsync(AdminUserItem user)
    {
        _openMenuId = null;
        _successMessage = null;
        _errorMessage = null;
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Supprimer définitivement le compte {RoleLabel(user.Role)} « {user.FullName} » ({user.Email}) ?\n\nCette action est irréversible.");
        if (!confirmed) return;

        try
        {
            var result = await AdminSvc.DeleteUserAsync(user.Id);
            if (result.Error is not null)
            {
                _errorMessage = result.Error;
                return;
            }
            _users.RemoveAll(u => u.Id == user.Id);
            _successMessage = $"Compte de {user.FullName} supprimé.";
        }
        catch
        {
            _errorMessage = "Impossible de supprimer ce compte.";
        }
    }

    private static bool IsDeletableRole(string role) =>
        role is "Parent" or "Student";

    private static string Initials(string fullName)
    {
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            : fullName.Length >= 1 ? fullName[..1].ToUpperInvariant() : "?";
    }

    private static string RoleLabel(string role) => role switch
    {
        "Parent" => "Parent",
        "Student" => "Élève",
        "Tutor" => "Enseignant",
        "TeachingAssistant" => "Assistant",
        _ => role
    };

    private static string RoleClass(string role) => role switch
    {
        "Parent" => "parent",
        "Student" => "student",
        "Tutor" => "tutor",
        "TeachingAssistant" => "teacher",
        _ => ""
    };
}
