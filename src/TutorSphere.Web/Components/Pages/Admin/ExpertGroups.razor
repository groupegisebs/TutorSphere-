    private void CloseDelete()
    {
        _deleteTarget = null;
        _deleteImpact = null;
        _deleteConfirmName = string.Empty;
    }

    /// <summary>Le nom recopié doit correspondre : l'API applique la même règle de son côté.</summary>
    private bool DeleteConfirmed =>
        _deleteTarget is not null
        && string.Equals(
            NormalizeGroupName(_deleteConfirmName),
            NormalizeGroupName(_deleteTarget.Name),
            StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// Réduit les suites d'espaces à un seul. Un nom saisi avec deux espaces s'affiche comme s'il
    /// n'en avait qu'un — le HTML les fusionne — et la confirmation devenait alors impossible à
    /// réussir : on comparait un nom invisible.
    /// </summary>
    private static string NormalizeGroupName(string? value) =>
        string.Join(' ', (value ?? string.Empty).Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null || !DeleteConfirmed) return;

        _error = null;
        _flash = null;
        _deleteBusy = true;
        try
        {
            var name = _deleteTarget.Name;
            var result = await AdminSvc.DeleteExpertGroupCascadeAsync(_deleteTarget.Id, _deleteConfirmName.Trim());
            if (!result.IsSuccess)
            {
                _error = result.Error ?? "Suppression impossible.";
                return;
            }

            CloseDelete();
            _flash = $"Groupe « {name} » supprimé avec ses données rattachées.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _deleteBusy = false;
        }
    }

