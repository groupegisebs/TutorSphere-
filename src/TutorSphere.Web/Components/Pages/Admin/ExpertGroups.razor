@page "/admin/expert-groups"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TutorSphere.Web.Common
@using TutorSphere.Web.Components.Shared
@inject AdminService AdminSvc
@inject AuthService Auth
@inject ApiClient Api
@inject IConfiguration Config
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Groupes d'experts — Control Center</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-expert-groups">
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">Groupes d'experts</h1>
                <p class="cc-page-sub">
                    Autant de groupes que nécessaire, sans exclusivité de pays. Chaque groupe est administré
                    par un Responsable ; un seul groupe reçoit les candidatures spontanées.
                </p>
            </div>
            <AuthorizeView Roles="SuperAdmin" Context="superAdminAuth">
                <Authorized>
                    <button type="button" class="cc-btn cc-btn-primary" @onclick="OpenCreate">
                        <i class="bi bi-plus-lg"></i> Nouveau groupe
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        @if (!string.IsNullOrEmpty(_flash))
        {
            <div class="alert alert-success mb-3">@_flash</div>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mb-3">@_error</div>
        }

        @if (_historyGroup is not null)
        {
            <div class="cc-card mb-3">
                <div class="cc-card-header d-flex justify-content-between align-items-center">
                    <h2 class="cc-card-title mb-0">Historique des mandats — @_historyGroup.Name</h2>
                    <button type="button" class="cc-btn btn-sm" @onclick="() => _historyGroup = null"><i class="bi bi-x-lg"></i></button>
                </div>
                @if (_mandateHistory.Count == 0)
                {
                    <p class="text-muted mb-0 p-3">Aucun mandat enregistré.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Statut</th>
                                    <th>UserId</th>
                                    <th>Début</th>
                                    <th>Fin</th>
                                    <th>Motif</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in _mandateHistory)
                                {
                                    <tr>
                                        <td>@(((TutorSphere.Domain.Enums.ExpertGroupManagerMandateStatus)h.Status).ToString())</td>
                                        <td><code>@h.UserId</code></td>
                                        <td>@h.MandateStartsAtUtc.ToLocalTime().ToString("g")</td>
                                        <td>@(h.MandateEndsAtUtc?.ToLocalTime().ToString("g") ?? "—")</td>
                                        <td>@(h.EndReason ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        @if (_showForm)
        {
            <div class="cc-card mb-3 cc-expert-group-form">
                <div class="cc-card-header">
                    <h2 class="cc-card-title">@(_editId is null ? "Créer un groupe" : "Modifier le groupe")</h2>
                    <button type="button" class="cc-btn" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button>
                </div>
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="alert alert-danger">@_formError</div>
                }
                <div class="row g-2">
                    <div class="col-md-6 mb-3">
                        <label class="form-label cc-label-light" style="color:#f3f4f6">Nom *</label>
                        <input class="form-control" @bind="_formName" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label cc-label-light" style="color:#f3f4f6">Description</label>
                        <input class="form-control" @bind="_formDescription" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label cc-label-light" style="color:#f3f4f6">Pays de rattachement</label>
                        <CountrySelect Value="_formCountry" ValueChanged="OnCountryChanged" />
                        <div class="form-text" style="color:#9ca3af">
                            Facultatif et non exclusif : plusieurs groupes peuvent couvrir le même pays.
                        </div>
                    </div>
                    <div class="col-12 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="intl"
                                   checked="@_formInternational"
                                   @onchange="OnInternationalChanged" />
                            <label class="form-check-label cc-label-light" for="intl" style="color:#f3f4f6">Portée internationale</label>
                        </div>
                    </div>

                    @if (_editId is null)
                    {
                        <div class="col-12"><hr class="border-secondary opacity-25" /></div>
                        <div class="col-12 mb-2">
                            <h3 class="h6 mb-0" style="color:#f3f4f6">Responsable du groupe *</h3>
                            <p class="small mb-0" style="color:#d1d5db">Obligatoire. Compte Expert créé ou réutilisé, puis nommé Responsable.</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Prénom *</label>
                            <input class="form-control" @bind="_mgrFirstName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Nom *</label>
                            <input class="form-control" @bind="_mgrLastName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Courriel *</label>
                            <input class="form-control" type="email" @bind="_mgrEmail" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Téléphone</label>
                            <input class="form-control" @bind="_mgrPhone" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Fonction</label>
                            <input class="form-control" placeholder="ex. Responsable pédagogique" @bind="_mgrFunction" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Début du mandat</label>
                            <input class="form-control" type="date" @bind="_mgrStartDate" />
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Responsable (affichage)</label>
                            <input class="form-control" @bind="_formContactName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">E-mail contact</label>
                            <input class="form-control" @bind="_formEmail" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Téléphone</label>
                            <input class="form-control" @bind="_formPhone" />
                        </div>
                        <div class="col-12 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="_formActive" id="active" />
                                <label class="form-check-label cc-label-light" for="active" style="color:#f3f4f6">Actif</label>
                            </div>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Logo</label>
                            <InputFile OnChange="UploadLogoAsync" accept="image/*" class="form-control" />
                            <div class="form-text cc-label-light" style="color:#d1d5db">PNG, JPG ou SVG — max. 5 Mo. Affiché sur les fiches enseignants.</div>
                            @if (!string.IsNullOrWhiteSpace(_formLogo))
                            {
                                <div class="cc-logo-preview">
                                    <img src="@ResolveMediaUrl(_formLogo)" alt="Aperçu logo"
                                         onerror="this.style.display='none'; this.nextElementSibling?.classList.add('cc-logo-preview-missing--show');" />
                                    <span class="cc-logo-preview-missing">Logo introuvable — re-uploadez le fichier</span>
                                    <span class="cc-logo-preview-caption" style="color:#f3f4f6">Logo</span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <button type="button" class="cc-btn" @onclick="CloseForm">@(_editId is null ? "Annuler" : "Fermer")</button>
                    <button type="button" class="cc-btn cc-btn-primary" disabled="@_saving" @onclick="SaveAsync">
                        @if (_saving) { <span class="spinner-border spinner-border-sm"></span> }
                        Enregistrer
                    </button>
                </div>
            </div>
        }

        @if (_deleteTarget is not null)
        {
            <div class="cc-card mb-3 border-danger">
                <div class="cc-card-header">
                    <h2 class="cc-card-title mb-0 text-danger">
                        <i class="bi bi-exclamation-octagon me-1"></i>Supprimer « @_deleteTarget.Name »
                    </h2>
                    <button type="button" class="cc-btn" @onclick="CloseDelete"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="p-3">
                    @if (_deleteImpactLoading)
                    {
                        <div class="text-center py-3"><span class="spinner-border"></span></div>
                    }
                    else
                    {
                        <p style="color:#f3f4f6">
                            La suppression est définitive : le groupe et tout ce qui lui appartient
                            disparaissent de la base, sans possibilité de retour. Si vous souhaitez
                            seulement le retirer de la circulation, fermez cette fenêtre et utilisez
                            <strong>Archiver</strong> : l'historique est alors conservé.
                        </p>

                        @if (_deleteImpact is null || _deleteImpact.Deleted.Count == 0)
                        {
                            <p style="color:#d1d5db">Aucune donnée n'est rattachée à ce groupe.</p>
                        }
                        else
                        {
                            <p class="mb-1" style="color:#f3f4f6">Seront supprimés définitivement :</p>
                            <ul style="color:#f3f4f6">
                                @foreach (var item in _deleteImpact.Deleted)
                                {
                                    <li><strong>@item.Count</strong> — @item.Label</li>
                                }
                            </ul>
                        }

                        @if (_deleteImpact is not null && _deleteImpact.Detached.Count > 0)
                        {
                            <p class="mb-1" style="color:#f3f4f6">
                                Conservés, mais détachés du groupe :
                            </p>
                            <ul style="color:#d1d5db">
                                @foreach (var item in _deleteImpact.Detached)
                                {
                                    <li><strong>@item.Count</strong> — @item.Label</li>
                                }
                            </ul>
                        }

                        <div class="mb-3">
                            <label class="form-label cc-label-light" for="delete-confirm" style="color:#f3f4f6">
                                Recopiez le nom du groupe pour confirmer :
                                @* pre-wrap rend visibles les espaces doubles que le nom peut contenir. *@
                                <code style="white-space:pre-wrap">@_deleteTarget.Name</code>
                            </label>
                            <input id="delete-confirm" class="form-control" placeholder="@_deleteTarget.Name"
                                   autocomplete="off" @bind="_deleteConfirmName" @bind:event="oninput" />
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <button type="button" class="cc-btn" @onclick="CloseDelete">Annuler</button>
                            <button type="button" class="cc-btn cc-btn-danger"
                                    disabled="@(_deleteBusy || !DeleteConfirmed)"
                                    @onclick="ConfirmDeleteAsync">
                                @if (_deleteBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Supprimer définitivement
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        @if (_loading)
        {
            <div class="cc-empty"><span class="spinner-border"></span></div>
        }
        else
        {
            @if (ActiveGroups.Count == 0)
            {
                <div class="cc-card"><p class="text-muted mb-0 p-3">Aucun groupe actif.</p></div>
            }
            else
            {
                <div class="cc-group-grid">
                    @foreach (var g in ActiveGroups)
                    {
                        <article class="cc-group-card @(g.IsDefaultReviewGroup ? "is-default" : null)">
                            <header class="cc-group-card-head">
                                @if (!string.IsNullOrWhiteSpace(g.LogoUrl))
                                {
                                    <img class="cc-group-logo" src="@ResolveMediaUrl(g.LogoUrl)" alt=""
                                         onerror="this.style.display='none'; this.nextElementSibling?.classList.remove('d-none');" />
                                    <span class="cc-group-logo-fallback d-none"><i class="bi bi-award"></i></span>
                                }
                                else
                                {
                                    <span class="cc-group-logo-fallback"><i class="bi bi-award"></i></span>
                                }
                                <div class="cc-group-ident">
                                    <h3 class="cc-group-name">@g.Name</h3>
                                    <div class="cc-scope-cell">
                                        @if (!string.IsNullOrWhiteSpace(g.CountryCode))
                                        {
                                            <span class="cc-pill">
                                                <span aria-hidden="true">@CountryCatalog.FlagEmoji(g.CountryCode)</span>
                                                @(CountryCatalog.Find(g.CountryCode)?.Name ?? g.CountryCode)
                                            </span>
                                        }
                                        @if (g.IsInternational)
                                        {
                                            <span class="cc-pill cc-pill-type">International</span>
                                        }
                                        @if (string.IsNullOrWhiteSpace(g.CountryCode) && !g.IsInternational)
                                        {
                                            <span class="cc-pill">Sans rattachement</span>
                                        }
                                    </div>
                                </div>
                                <span class="cc-pill @(g.IsActive ? "cc-pill-ok" : "cc-pill-bad") cc-group-status">
                                    @(g.LifecycleStatus == 3 ? "Archivé" : g.IsActive ? "Actif" : "Inactif")
                                </span>
                            </header>

                            @if (g.IsDefaultReviewGroup)
                            {
                                <p class="cc-group-default-note">
                                    <i class="bi bi-inbox-fill"></i>
                                    Reçoit les candidatures qu'aucun pays ne rattache.
                                </p>
                            }

                            <div class="cc-group-card-body">
                                <div class="cc-group-block">
                                    <span class="cc-group-block-title">Responsable</span>
                                    @{
                                        var mgrName = FirstNonEmpty(g.ManagerFullName, g.ContactName);
                                        var mgrEmail = FirstNonEmpty(g.ManagerEmail, g.ContactEmail);
                                        var mgrPhone = FirstNonEmpty(g.ManagerPhone, g.ContactPhone);
                                        var hasMandate = g.ActiveManagerMandateId.HasValue
                                            || !string.IsNullOrWhiteSpace(g.ManagerUserId);
                                        var hasContact = !string.IsNullOrWhiteSpace(mgrName)
                                            || !string.IsNullOrWhiteSpace(mgrEmail)
                                            || !string.IsNullOrWhiteSpace(mgrPhone);
                                        var displayName = !string.IsNullOrWhiteSpace(mgrName)
                                            ? mgrName
                                            : (!string.IsNullOrWhiteSpace(mgrEmail)
                                                ? mgrEmail
                                                : null);
                                    }
                                    @if (hasMandate || hasContact)
                                    {
                                        <div class="cc-manager-cell">
                                            <strong class="cc-manager-name">@(displayName ?? "Responsable nommé")</strong>
                                            @if (!string.IsNullOrWhiteSpace(mgrEmail) && !string.Equals(mgrEmail, displayName, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="cc-manager-meta">@mgrEmail</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(mgrPhone))
                                            {
                                                <span class="cc-manager-meta">@mgrPhone</span>
                                            }
                                            @if (!hasMandate && hasContact)
                                            {
                                                <span class="cc-manager-hint">Contact groupe — mandat à confirmer</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="cc-manager-empty">Aucun Responsable</div>
                                    }
                                </div>
                                <div class="cc-group-block">
                                    <span class="cc-group-block-title">Effectifs</span>
                                    @HeadcountCell(g)
                                </div>
                            </div>

                            <footer class="cc-group-card-foot">
                                <button type="button" class="cc-btn btn-sm cc-btn-primary"
                                        disabled="@_actAsBusy"
                                        @onclick="() => ActAsGroupAdminAsync(g)">
                                    <i class="bi bi-person-gear"></i> Administrer
                                </button>
                                <a class="cc-btn btn-sm" href="@($"admin/expert-groups/{g.Id}")">Membres</a>
                                <button type="button" class="cc-btn btn-sm" @onclick="() => OpenEdit(g)">Modifier</button>

                                @* Huit actions de plus tiendraient mal dans une carte : elles sont
                                   regroupées ici pour garder les trois gestes courants visibles. *@
                                <div class="cc-group-more">
                                    <button type="button" class="cc-btn btn-sm" title="Plus d'actions"
                                            @onclick="() => ToggleMenu(g.Id)">
                                        <i class="bi bi-three-dots"></i>
                                    </button>
                                    @if (_menuId == g.Id)
                                    {
                                        <div class="cc-group-menu">
                                            <AuthorizeView Roles="SuperAdmin" Context="saAuth">
                                                <Authorized>
                                                    <a href="@($"admin/expert-groups/{g.Id}/manager")">Changer le responsable</a>
                                                </Authorized>
                                            </AuthorizeView>
                                            <AuthorizeView Roles="SuperAdmin" Context="defaultAuth">
                                                <Authorized>
                                                    @if (!g.IsDefaultReviewGroup)
                                                    {
                                                        <button type="button" disabled="@_defaultBusy"
                                                                @onclick="() => SetDefaultReviewAsync(g, true)">
                                                            Recevoir les candidatures spontanées
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" disabled="@_defaultBusy"
                                                                @onclick="() => SetDefaultReviewAsync(g, false)">
                                                            Ne plus recevoir les candidatures
                                                        </button>
                                                    }
                                                </Authorized>
                                            </AuthorizeView>
                                            <button type="button" @onclick="() => ShowMandateHistoryAsync(g)">Historique des mandats</button>
                                            <button type="button" @onclick="() => ContactAsync(g)">Contacter</button>
                                            <button type="button" @onclick="() => ToggleActiveAsync(g)">
                                                @(g.IsActive ? "Désactiver" : "Activer")
                                            </button>
                                            <button type="button" @onclick="() => ArchiveAsync(g)">Archiver</button>
                                            <AuthorizeView Roles="SuperAdmin" Context="deleteAuth">
                                                <Authorized>
                                                    <button type="button" class="is-danger"
                                                            @onclick="() => OpenDeleteAsync(g)">Supprimer</button>
                                                </Authorized>
                                            </AuthorizeView>
                                        </div>
                                    }
                                </div>
                            </footer>
                        </article>
                    }
                </div>
            }

            @* Les groupes hors service restaient invisibles : impossible de rattraper un doublon
               ou un brouillon créé par erreur sans passer par la base. *@
            <div class="cc-card mt-3">
                <div class="cc-card-header">
                    <h2 class="cc-card-title mb-0">
                        Groupes inactifs et archivés
                        <span class="cc-pill ms-2">@InactiveGroups.Count</span>
                    </h2>
                </div>
                @if (InactiveGroups.Count == 0)
                {
                    <p class="text-muted mb-0 p-3">Aucun groupe inactif.</p>
                }
                else
                {
                    <div class="cc-group-grid cc-group-grid--muted p-3">
                        @foreach (var g in InactiveGroups)
                        {
                            <article class="cc-group-card cc-group-card--muted">
                                <header class="cc-group-card-head">
                                    <span class="cc-group-logo-fallback"><i class="bi bi-archive"></i></span>
                                    <div class="cc-group-ident">
                                        <h3 class="cc-group-name">@g.Name</h3>
                                        <div class="cc-scope-cell">
                                            @if (!string.IsNullOrWhiteSpace(g.CountryCode))
                                            {
                                                <span class="cc-pill">
                                                    <span aria-hidden="true">@CountryCatalog.FlagEmoji(g.CountryCode)</span>
                                                    @(CountryCatalog.Find(g.CountryCode)?.Name ?? g.CountryCode)
                                                </span>
                                            }
                                            @if (g.IsInternational)
                                            {
                                                <span class="cc-pill cc-pill-type">International</span>
                                            }
                                            <span class="cc-pill cc-pill-bad">@LifecycleLabel(g)</span>
                                        </div>
                                    </div>
                                </header>
                                <div class="cc-group-card-body">
                                    <div class="cc-group-block">
                                        <span class="cc-group-block-title">Effectifs</span>
                                        @HeadcountCell(g)
                                    </div>
                                    <div class="cc-group-block">
                                        <span class="cc-group-block-title">Créé le</span>
                                        <span class="cc-count-main">@g.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                                <footer class="cc-group-card-foot">
                                    <a class="cc-btn btn-sm" href="@($"admin/expert-groups/{g.Id}")">Membres</a>
                                    <button type="button" class="cc-btn btn-sm" @onclick="() => OpenEdit(g)">Modifier</button>
                                    @if (g.LifecycleStatus != 3)
                                    {
                                        <button type="button" class="cc-btn btn-sm" @onclick="() => ToggleActiveAsync(g)">Activer</button>
                                    }
                                    <AuthorizeView Roles="SuperAdmin" Context="deleteInactiveAuth">
                                        <Authorized>
                                            <button type="button" class="cc-btn btn-sm cc-btn-danger"
                                                    @onclick="() => OpenDeleteAsync(g)">Supprimer</button>
                                        </Authorized>
                                    </AuthorizeView>
                                </footer>
                            </article>
                        }
                    </div>
                }
            </div>
        }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private List<ExpertGroupItem> _groups = [];
    private List<ExpertGroupItem> ActiveGroups =>
        _groups.Where(g => g.IsActive && g.LifecycleStatus != 3).ToList();

    /// <summary>Tout ce que le tableau principal écarte : brouillons, suspendus, archivés.</summary>
    private List<ExpertGroupItem> InactiveGroups =>
        _groups.Where(g => !g.IsActive || g.LifecycleStatus == 3)
            .OrderBy(g => g.LifecycleStatus)
            .ThenBy(g => g.Name)
            .ToList();

    private static string LifecycleLabel(ExpertGroupItem g) => g.LifecycleStatus switch
    {
        0 => "Brouillon",
        2 => "Suspendu",
        3 => "Archivé",
        _ => g.IsActive ? "Actif" : "Inactif"
    };

    /// <summary>
    /// Un chiffre unique laissait croire qu'un groupe n'avait qu'une personne alors qu'il portait
    /// des invitations en cours de vote et des enseignants approuvés. Chaque population est donc
    /// affichée séparément.
    /// </summary>
    private static RenderFragment HeadcountCell(ExpertGroupItem g) =>
        @<div class="cc-count-cell">
            <span class="cc-count-main">
                <strong>@g.ActiveExpertCount</strong> @Plural(g.ActiveExpertCount, "expert", "experts")
            </span>
            @if (g.SuspendedExpertCount > 0)
            {
                <span class="cc-count-meta">@g.SuspendedExpertCount @Plural(g.SuspendedExpertCount, "suspendu", "suspendus")</span>
            }
            @if (g.PendingExpertInviteCount > 0)
            {
                <span class="cc-count-meta">@g.PendingExpertInviteCount @Plural(g.PendingExpertInviteCount, "invitation en cours", "invitations en cours")</span>
            }
            <span class="cc-count-meta">@g.ApprovedTeacherCount @Plural(g.ApprovedTeacherCount, "enseignant approuvé", "enseignants approuvés")</span>
        </div>;

    private static string Plural(int count, string one, string many) => count > 1 ? many : one;

    private ExpertGroupItem? _historyGroup;
    private List<MandateHistoryItem> _mandateHistory = [];
    private bool _loading = true;
    private bool _showForm;
    private bool _saving;
    private bool _actAsBusy;
    private bool _defaultBusy;

    /// <summary>Carte dont le menu d'actions secondaires est ouvert (une seule à la fois).</summary>
