    private async Task ActAsGroupAdminAsync(ExpertGroupItem g)
    {
        _error = null;
        _flash = null;
        _actAsBusy = true;
        try
        {
            var result = await Api.PostWithErrorAsync<ActAsResult>($"api/admin/expert-groups/{g.Id}/act-as", new { });
            if (!result.IsSuccess || result.Value is null)
            {
                _error = result.Error ?? "Impossible d'ouvrir l'espace Responsable.";
                return;
            }

            await Auth.StartActingAsGroupAdminAsync(result.Value.GroupId, result.Value.GroupName);
            _flash = $"Mode suppléant : {result.Value.GroupName}";
            Navigation.NavigateTo(result.Value.PortalPath ?? "/expert/dashboard");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _actAsBusy = false; }
    }

