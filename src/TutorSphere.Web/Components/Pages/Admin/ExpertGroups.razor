@page "/admin/expert-groups"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using TutorSphere.Web.Common
@using TutorSphere.Web.Components.Shared
@inject AdminService AdminSvc
@inject AuthService Auth
@inject ApiClient Api
@inject IConfiguration Config
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Groupes d'experts — Control Center</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-expert-groups">
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">Groupes d'experts</h1>
                <p class="cc-page-sub">
                    Un groupe par pays + un seul groupe international. Chaque groupe est administré par un Responsable.
                </p>
            </div>
            <AuthorizeView Roles="SuperAdmin" Context="superAdminAuth">
                <Authorized>
                    <button type="button" class="cc-btn cc-btn-primary" @onclick="OpenCreate">
                        <i class="bi bi-plus-lg"></i> Nouveau groupe
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        @if (!string.IsNullOrEmpty(_flash))
        {
            <div class="alert alert-success mb-3">@_flash</div>
        }
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger mb-3">@_error</div>
        }

        @if (_showForm)
        {
            <div class="cc-card mb-3 cc-expert-group-form">
                <div class="cc-card-header">
                    <h2 class="cc-card-title">@(_editId is null ? "Créer un groupe" : "Modifier le groupe")</h2>
                    <button type="button" class="cc-btn" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button>
                </div>
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="alert alert-danger">@_formError</div>
                }
                <div class="row g-2">
                    <div class="col-md-6 mb-3">
                        <label class="form-label cc-label-light" style="color:#f3f4f6">Nom *</label>
                        <input class="form-control" @bind="_formName" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label cc-label-light" style="color:#f3f4f6">Description</label>
                        <input class="form-control" @bind="_formDescription" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label cc-label-light" style="color:#f3f4f6">Pays</label>
                        <CountrySelect Value="_formCountry" ValueChanged="OnCountryChanged" Disabled="_formInternational" />
                    </div>
                    <div class="col-12 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="intl"
                                   checked="@_formInternational"
                                   disabled="@(_editId is not null)"
                                   @onchange="OnInternationalChanged" />
                            <label class="form-check-label cc-label-light" for="intl" style="color:#f3f4f6">Groupe international (unique)</label>
                        </div>
                    </div>

                    @if (_editId is null)
                    {
                        <div class="col-12"><hr class="border-secondary opacity-25" /></div>
                        <div class="col-12 mb-2">
                            <h3 class="h6 mb-0" style="color:#f3f4f6">Responsable du groupe *</h3>
                            <p class="small mb-0" style="color:#d1d5db">Obligatoire. Compte Expert créé ou réutilisé, puis nommé Responsable.</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Prénom *</label>
                            <input class="form-control" @bind="_mgrFirstName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Nom *</label>
                            <input class="form-control" @bind="_mgrLastName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Courriel *</label>
                            <input class="form-control" type="email" @bind="_mgrEmail" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Téléphone</label>
                            <input class="form-control" @bind="_mgrPhone" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Fonction</label>
                            <input class="form-control" placeholder="ex. Responsable pédagogique" @bind="_mgrFunction" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Début du mandat</label>
                            <input class="form-control" type="date" @bind="_mgrStartDate" />
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Responsable (affichage)</label>
                            <input class="form-control" @bind="_formContactName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">E-mail contact</label>
                            <input class="form-control" @bind="_formEmail" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Téléphone</label>
                            <input class="form-control" @bind="_formPhone" />
                        </div>
                        <div class="col-12 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="_formActive" id="active" />
                                <label class="form-check-label cc-label-light" for="active" style="color:#f3f4f6">Actif</label>
                            </div>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label cc-label-light" style="color:#f3f4f6">Logo</label>
                            <InputFile OnChange="UploadLogoAsync" accept="image/*" class="form-control" />
                            <div class="form-text cc-label-light" style="color:#d1d5db">PNG, JPG ou SVG — max. 5 Mo. Affiché sur les fiches enseignants.</div>
                            @if (!string.IsNullOrWhiteSpace(_formLogo))
                            {
                                <div class="cc-logo-preview">
                                    <img src="@ResolveMediaUrl(_formLogo)" alt="Aperçu logo" />
                                    <span class="cc-logo-preview-caption" style="color:#f3f4f6">Logo</span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <button type="button" class="cc-btn" @onclick="CloseForm">@(_editId is null ? "Annuler" : "Fermer")</button>
                    <button type="button" class="cc-btn cc-btn-primary" disabled="@_saving" @onclick="SaveAsync">
                        @if (_saving) { <span class="spinner-border spinner-border-sm"></span> }
                        Enregistrer
                    </button>
                </div>
            </div>
        }

        @if (_loading)
        {
            <div class="cc-empty"><span class="spinner-border"></span></div>
        }
        else
        {
            <div class="cc-card">
                <div class="cc-table-wrap">
                    <table class="cc-table">
                        <thead>
                            <tr>
                                <th>Groupe</th>
                                <th>Portée</th>
                                <th>Responsable du groupe</th>
                                <th>Membres</th>
                                <th>Statut</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_groups.Count == 0)
                            {
                                <tr><td colspan="6" class="text-muted">Aucun groupe. Créez d'abord le groupe international.</td></tr>
                            }
                            @foreach (var g in _groups)
                            {
                                <tr>
                                    <td>
                                        <div class="cc-user-cell">
                                            @if (!string.IsNullOrWhiteSpace(g.LogoUrl))
                                            {
                                                <img class="cc-group-logo-thumb" src="@ResolveMediaUrl(g.LogoUrl)" alt="" />
                                            }
                                            else
                                            {
                                                <span class="cc-rank-icon"><i class="bi bi-award"></i></span>
                                            }
                                            <strong>@g.Name</strong>
                                        </div>
                                    </td>
                                    <td>
                                        @if (g.IsInternational)
                                        {
                                            <span class="cc-pill cc-pill-type">International</span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(g.CountryCode))
                                        {
                                            <span class="cc-pill">
                                                <span aria-hidden="true">@CountryCatalog.FlagEmoji(g.CountryCode)</span>
                                                @(CountryCatalog.Find(g.CountryCode)?.Name ?? g.CountryCode)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="cc-pill">—</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var mgrName = g.ManagerFullName ?? g.ContactName;
                                            var mgrEmail = g.ManagerEmail ?? g.ContactEmail;
                                            var mgrPhone = g.ManagerPhone ?? g.ContactPhone;
                                        }
                                        @if (!string.IsNullOrWhiteSpace(mgrName))
                                        {
                                            <div><strong>@mgrName</strong></div>
                                        }
                                        else
                                        {
                                            <div class="text-muted">Aucun Responsable</div>
                                        }
                                        <div>@(mgrEmail ?? "—")</div>
                                        <div class="small text-muted">@(mgrPhone ?? "")</div>
                                    </td>
                                    <td>@g.MemberCount</td>
                                    <td>
                                        <span class="cc-pill @(g.IsActive ? "cc-pill-ok" : "cc-pill-bad")">
                                            @(g.LifecycleStatus == 3 ? "Archivé" : g.IsActive ? "Actif" : "Inactif")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex flex-wrap gap-1 justify-content-end">
                                            <a class="cc-btn btn-sm" href="@($"admin/expert-groups/{g.Id}")">Ouvrir</a>
                                            <a class="cc-btn btn-sm" href="@($"admin/expert-groups/{g.Id}")">Membres</a>
                                            <a class="cc-btn btn-sm" href="@($"admin/expert-groups/{g.Id}/manager")">Changer le responsable</a>
                                            <button type="button" class="cc-btn btn-sm" @onclick="() => ContactAsync(g)">Contacter</button>
                                            <button type="button" class="cc-btn btn-sm" @onclick="() => OpenEdit(g)">Modifier</button>
                                            <button type="button" class="cc-btn btn-sm" @onclick="() => ToggleActiveAsync(g)">
                                                @(g.IsActive ? "Désactiver" : "Activer")
                                            </button>
                                            @if (g.CanHardDelete)
                                            {
                                                <button type="button" class="cc-btn btn-sm" @onclick="() => DeleteAsync(g)">Supprimer</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="cc-btn btn-sm" @onclick="() => ArchiveAsync(g)">Archiver</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="cc-card mt-3">
                <div class="cc-card-header">
                    <h2 class="cc-card-title">Enseignants en attente (tous pays)</h2>
                </div>
                @if (_pending.Count == 0)
                {
                    <p class="text-muted mb-0">Aucune fiche en attente.</p>
                }
                else
                {
                    <div class="cc-table-wrap">
                        <table class="cc-table">
                            <thead>
                                <tr>
                                    <th>École</th>
                                    <th>Pays</th>
                                    <th>Groupe suggéré</th>
                                    <th>Docs</th>
                                    <th>Inscrit</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _pending)
                                {
                                    <tr>
                                        <td><strong>@p.SchoolName</strong></td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(p.Country) && CountryCatalog.Find(p.Country) is { } pc)
                                            {
                                                <span aria-hidden="true">@pc.Flag</span> @pc.Name
                                            }
                                            else
                                            {
                                                @(p.Country ?? "—")
                                            }
                                        </td>
                                        <td>@(p.AssignedExpertGroupName ?? "—")</td>
                                        <td>@p.DocumentCount</td>
                                        <td>@p.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private List<ExpertGroupItem> _groups = [];
    private List<PendingTeacherItem> _pending = [];
    private bool _loading = true;
    private bool _showForm;
    private bool _saving;
    private Guid? _editId;
    private string? _flash;
    private string? _error;
    private string? _formError;
    private string _formName = "";
    private string? _formDescription;
    private string? _formContactName;
    private string? _formEmail;
    private string? _formPhone;
    private string? _formCountry;
    private string? _formLogo;
    private bool _formInternational;
    private bool _formActive = true;

    private string _mgrFirstName = "";
    private string _mgrLastName = "";
    private string _mgrEmail = "";
    private string? _mgrPhone;
    private string? _mgrFunction;
    private DateTime? _mgrStartDate = DateTime.Today;

    /// <summary>
    /// Logos are stored as API-relative paths (/uploads/...). Served via the Web /uploads proxy
    /// (same origin) so the browser never hits InternalApiBaseUrl / loopback.
    /// </summary>
    private string ResolveMediaUrl(string? url) =>
        MediaUrlHelper.Resolve(url, Config, Navigation);

    protected override async Task OnInitializedAsync()
    {
        try { await Auth.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _groups = await AdminSvc.GetExpertGroupsAsync();
            _pending = await AdminSvc.GetPendingTeacherApprovalsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _groups = [];
            _pending = [];
        }
        finally { _loading = false; }
    }

    private void OpenCreate()
    {
        _editId = null;
        _formName = "";
        _formDescription = _formContactName = _formEmail = _formPhone = _formCountry = _formLogo = null;
        _mgrFirstName = _mgrLastName = _mgrEmail = "";
        _mgrPhone = _mgrFunction = null;
        _mgrStartDate = DateTime.Today;
        _formInternational = !_groups.Any(g => g.IsInternational);
        _formActive = true;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(ExpertGroupItem g)
    {
        _editId = g.Id;
        _formName = g.Name;
        _formDescription = g.Description;
        _formContactName = g.ManagerFullName ?? g.ContactName;
        _formEmail = g.ManagerEmail ?? g.ContactEmail;
        _formPhone = g.ManagerPhone ?? g.ContactPhone;
        _formCountry = g.CountryCode;
        _formLogo = g.LogoUrl;
        _formInternational = g.IsInternational;
        _formActive = g.IsActive;
        _formError = null;
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private void OnInternationalChanged(ChangeEventArgs e)
    {
        _formInternational = e.Value is bool b && b || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (_formInternational) _formCountry = null;
    }

    private void OnCountryChanged(string? code) => _formCountry = code;

    private async Task SaveAsync()
    {
        _saving = true;
        _formError = null;
        try
        {
            if (_editId is null)
            {
                if (string.IsNullOrWhiteSpace(_mgrEmail) || string.IsNullOrWhiteSpace(_mgrFirstName) || string.IsNullOrWhiteSpace(_mgrLastName))
                {
                    _formError = "Le Responsable (prénom, nom, courriel) est obligatoire.";
                    return;
                }

                var created = await AdminSvc.CreateExpertGroupAsync(
                    _formName, null, _mgrEmail, _mgrPhone, _formCountry, _formInternational,
                    _formDescription, _mgrEmail, _mgrFirstName, _mgrLastName, _mgrPhone, _mgrFunction,
                    _mgrStartDate?.ToUniversalTime());
                if (created is null) { _formError = "Échec de création."; return; }
                _editId = created.Id;
                _formLogo = created.LogoUrl;
                _formActive = created.IsActive;
                _formContactName = created.ManagerFullName ?? created.ContactName;
                _formEmail = created.ManagerEmail ?? created.ContactEmail;
                _formPhone = created.ManagerPhone ?? created.ContactPhone;
                _flash = "Groupe créé avec son Responsable. Vous pouvez ajouter un logo.";
            }
            else
            {
                var updated = await AdminSvc.UpdateExpertGroupAsync(
                    _editId.Value, _formName, _formContactName, _formEmail, _formPhone, _formLogo, _formActive, _formDescription);
                if (updated is null) { _formError = "Échec de mise à jour."; return; }
                _flash = "Groupe mis à jour.";
                _showForm = false;
            }
            await ReloadAsync();
        }
        catch (Exception ex) { _formError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task UploadLogoAsync(InputFileChangeEventArgs e)
    {
        if (_editId is null) return;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(stream);
            var mime = string.IsNullOrWhiteSpace(e.File.ContentType)
                       || e.File.ContentType.Equals("application/octet-stream", StringComparison.OrdinalIgnoreCase)
                ? GuessImageMime(e.File.Name)
                : e.File.ContentType;
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(mime);
            content.Add(fileContent, "file", e.File.Name);
            var result = await Api.PostMultipartAsync<LogoUploadResult>(
                $"api/admin/expert-groups/{_editId}/logo", content);
            if (result.IsSuccess && result.Value is not null)
            {
                _formLogo = result.Value.LogoUrl;
                _flash = "Logo téléversé.";
                await ReloadAsync();
            }
            else _formError = result.Error ?? "Échec upload logo.";
        }
        catch (Exception ex) { _formError = ex.Message; }
    }

    private static string GuessImageMime(string fileName) =>
        Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            ".svg" => "image/svg+xml",
            _ => "image/png"
        };

    private async Task ContactAsync(ExpertGroupItem g)
    {
        _error = null;
        _flash = null;
        var result = await AdminSvc.ContactExpertGroupAsync(g.Id);
        if (!result.IsSuccess)
        {
            _error = result.Error ?? "Impossible d'ouvrir la conversation.";
            return;
        }
        _flash = "Conversation ouverte avec le Responsable.";
        Navigation.NavigateTo("admin/expert-groups/messages");
    }

    private async Task ToggleActiveAsync(ExpertGroupItem g)
    {
        _error = null;
        try
        {
            var updated = await AdminSvc.UpdateExpertGroupAsync(
                g.Id, g.Name, g.ManagerFullName ?? g.ContactName, g.ManagerEmail ?? g.ContactEmail,
                g.ManagerPhone ?? g.ContactPhone, g.LogoUrl, !g.IsActive, g.Description);
            if (updated is null) { _error = "Échec de mise à jour du statut."; return; }
            _flash = updated.IsActive ? "Groupe activé." : "Groupe désactivé.";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ArchiveAsync(ExpertGroupItem g)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm", $"Archiver le groupe « {g.Name} » ? L'historique est conservé.");
        if (!confirmed) return;
        _error = null;
        var result = await AdminSvc.ArchiveExpertGroupAsync(g.Id);
        if (!result.IsSuccess)
        {
            _error = result.Error ?? "Archivage impossible.";
            return;
        }
        _flash = "Groupe archivé.";
        await ReloadAsync();
    }

    private async Task DeleteAsync(ExpertGroupItem g)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm", $"Supprimer définitivement le groupe « {g.Name} » ? Cette action est irréversible.");
        if (!confirmed) return;

        _error = null;
        _flash = null;
        var result = await AdminSvc.DeleteExpertGroupAsync(g.Id);
        if (!result.IsSuccess)
        {
            _error = result.Error ?? "Suppression impossible.";
            return;
        }
        _flash = "Groupe supprimé.";
        await ReloadAsync();
    }

    private sealed record LogoUploadResult(string? LogoUrl);
}
