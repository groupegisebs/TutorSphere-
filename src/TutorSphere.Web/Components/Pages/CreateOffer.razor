@page "/tutor/offers/create"
@layout TutorLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Navigation
@inject ApiClient Api
@inject IConfiguration Config

<PageTitle>@L["PageTitle_CreateOffer"]</PageTitle>

<div class="create-offer-header">
    <button type="button" class="btn-back" @onclick='() => Navigation.NavigateTo("tutor/offers")' aria-label="@L["Button_Back"]">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
    </button>
    <div>
        <h1 class="create-offer-title">@L["CreateOffer_Title"]</h1>
        <p class="create-offer-subtitle">@L["CreateOffer_Subtitle"]</p>
    </div>
</div>

<StepIndicator Steps="@Steps" Subtitles="@StepSubtitles" CurrentStep="@CurrentStep" />

@if (!string.IsNullOrEmpty(_publishError) && CurrentStep < 4)
{
    <div class="alert alert-danger mt-3 mb-0">@_publishError</div>
}

<div class="row g-4 create-offer-body">
    <div class="col-lg-8">

        @if (CurrentStep == 1)
        {
            <div class="section-card mb-4">
                <h2 class="form-section-title">@L["CreateOffer_SectionBasicInfo"]</h2>

                <div class="row g-4">
                    <!-- Left column -->
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">@L["CreateOffer_TitleLabel"] <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="OfferTitle" @bind:event="oninput"
                                   placeholder="@L["CreateOffer_TitlePlaceholder"]" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@L["Label_Subject"] <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="Subject">
                                <option>@L["Subject_Math"]</option>
                                <option>@L["Subject_Physics"]</option>
                                <option>@L["Subject_Chemistry"]</option>
                                <option>@L["Subject_French"]</option>
                                <option>@L["Subject_History"]</option>
                                <option>@L["Subject_English"]</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@L["CreateOffer_Cycle"] <span class="text-danger">*</span></label>
                            <select class="form-select" value="@Cycle" @onchange="OnCycleChanged">
                                <option value="primary">@L["Cycle_Primary"]</option>
                                <option value="secondary">@L["Cycle_Secondary"]</option>
                                <option value="college">@L["Cycle_College"]</option>
                                <option value="university">@L["Cycle_University"]</option>
                            </select>
                            <div class="form-text">@L["CreateOffer_CycleHint"]</div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label">@L["Label_Description"] <span class="text-danger">*</span></label>
                            <div class="richtext-toolbar">
                                <button type="button" class="richtext-btn" title="Gras"><i class="bi bi-type-bold"></i></button>
                                <button type="button" class="richtext-btn" title="Italique"><i class="bi bi-type-italic"></i></button>
                                <button type="button" class="richtext-btn" title="Liste"><i class="bi bi-list-ul"></i></button>
                                <button type="button" class="richtext-btn" title="Liste numérotée"><i class="bi bi-list-ol"></i></button>
                                <button type="button" class="richtext-btn" title="Lien"><i class="bi bi-link-45deg"></i></button>
                            </div>
                            <textarea class="form-control richtext-area" rows="5"
                                      @bind="Description" @bind:event="oninput"
                                      placeholder="@L["CreateOffer_DescriptionPlaceholder"]"
                                      maxlength="500"></textarea>
                            <div class="richtext-counter">@Description.Length / 500</div>
                        </div>
                    </div>

                    <!-- Right column -->
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">@L["CreateOffer_TeachingMode"]</label>
                            <div class="teaching-mode-group">
                                @foreach (var mode in TeachingModes)
                                {
                                    <button type="button"
                                            class="teaching-mode-card @(SelectedMode == mode.Key ? "selected" : "")"
                                            @onclick="() => SelectedMode = mode.Key">
                                        <i class="bi @mode.Icon teaching-mode-icon" aria-hidden="true"></i>
                                        <span class="teaching-mode-label">@mode.Label</span>
                                        <span class="teaching-mode-desc">@mode.Description</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@L["CreateOffer_Language"]</label>
                            <select class="form-select" @bind="Language">
                                <option>@L["Lang_French"]</option>
                                <option>@L["Lang_English"]</option>
                                <option>@L["Lang_Spanish"]</option>
                            </select>
                        </div>

                        <div class="mb-0">
                            <label class="form-label">@L["CreateOffer_SpecificLevels"] <span class="badge badge-optional ms-1">@L["Label_Optional"]</span></label>
                            @if (AvailableSpecificLevels.Count == 0)
                            {
                                <div class="form-text text-muted">@L["CreateOffer_SpecificLevelsNone"]</div>
                            }
                            else
                            {
                                <div class="specific-level-chips">
                                    @foreach (var lvl in AvailableSpecificLevels)
                                    {
                                        <button type="button"
                                                class="specific-level-chip @(SelectedSpecificLevels.Contains(lvl.Key) ? "selected" : "")"
                                                @onclick="() => ToggleSpecificLevel(lvl.Key)">
                                            @lvl.Label
                                        </button>
                                    }
                                </div>
                                <div class="form-text">@L["CreateOffer_SpecificLevelsHint"]</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="section-card">
                <h2 class="form-section-title">@L["CreateOffer_Benefits"]</h2>
                <div class="benefit-chips">
                    @foreach (var benefit in AllBenefits)
                    {
                        var isSelected = SelectedBenefits.Contains(benefit);
                        <button type="button"
                                class="benefit-chip @(isSelected ? "selected" : "")"
                                @onclick="() => ToggleBenefit(benefit)">
                            <i class="bi @(isSelected ? "bi-check-circle-fill" : "bi-circle") benefit-chip-icon" aria-hidden="true"></i>
                            @benefit
                        </button>
                    }
                    <button type="button" class="benefit-chip benefit-chip--add">
                        <i class="bi bi-plus benefit-chip-icon" aria-hidden="true"></i>
                        @L["CreateOffer_AddBenefit"]
                    </button>
                </div>
            </div>
        }

        else if (CurrentStep == 2)
        {
            <div class="section-card">
                <h2 class="form-section-title">@L["CreateOffer_SectionPricing"]</h2>
                <div class="alert alert-info py-2 px-3 mb-3" role="status">
                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                    @L["CreateOffer_BillingAfterValidation"]
                </div>
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label">@L["CreateOffer_BillingMode"]</label>
                        <select class="form-select" @bind="BillingMode">
                            <option value="hourly">@L["Billing_Hourly"]</option>
                            <option value="perSession">@L["Billing_PerSession"]</option>
                            <option value="quarterlyPerValidated">@L["Billing_QuarterlyPerValidated"]</option>
                        </select>
                        @if (BillingMode == "quarterlyPerValidated")
                        {
                            <div class="form-text">@L["Billing_QuarterlyPerValidated_Hint"]</div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@RateFieldLabel</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" @bind="Rate" min="0" step="0.01" />
                            <span class="input-group-text">@RateUnitLabel</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@L["CreateOffer_SessionDuration"]</label>
                        <select class="form-select" @bind="SessionDuration">
                            <option value="30">30 min</option>
                            <option value="45">45 min</option>
                            <option value="60">60 min</option>
                            <option value="90">90 min</option>
                            <option value="120">120 min</option>
                        </select>
                        @if (BillingMode == "hourly")
                        {
                            <div class="form-text">@string.Format(L["CreateOffer_EstimatedSessionCost"].Value, EstimatedSessionCost.ToString("0.##"))</div>
                        }
                    </div>
                </div>
            </div>
        }

        else if (CurrentStep == 3)
        {
            <div class="section-card">
                <h2 class="form-section-title">@L["CreateOffer_SectionOptions"]</h2>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" @bind="OptionTrial" id="opt-trial" />
                    <label class="form-check-label" for="opt-trial">@L["CreateOffer_OptionTrial"]</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" @bind="OptionMaterials" id="opt-materials" />
                    <label class="form-check-label" for="opt-materials">@L["CreateOffer_OptionMaterials"]</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" @bind="OptionReport" id="opt-report" />
                    <label class="form-check-label" for="opt-report">@L["CreateOffer_OptionReport"]</label>
                </div>

                <hr class="my-4" />
                <h3 class="h6 mb-2">@L["CreateOffer_PresentationVideo"]</h3>
                <p class="text-muted small mb-3">@L["CreateOffer_PresentationVideoHint"]</p>

                <PresentationVideoRecorder MaxSeconds="90"
                                           OnSaved="OnPresentationVideoSaved"
                                           OnError="OnPresentationVideoError" />

                <div class="mt-3">
                    <label class="form-label small text-muted">@L["CreateOffer_PresentationVideoOrUpload"]</label>
                    <InputFile OnChange="OnPresentationVideoSelected" accept="video/mp4,video/webm,video/quicktime,.mp4,.webm,.mov" class="form-control" />
                </div>
                @if (_uploadingVideo)
                {
                    <div class="small text-muted mt-2">
                        <span class="spinner-border spinner-border-sm me-1"></span>@L["CreateOffer_PresentationVideoUploading"]
                    </div>
                }
                @if (!string.IsNullOrEmpty(_videoError))
                {
                    <div class="text-danger small mt-2">@_videoError</div>
                }
                @if (!string.IsNullOrWhiteSpace(PresentationVideoUrl))
                {
                    <div class="mt-3">
                        <GuideVideo Src="@PresentationVideoPlaybackUrl" Title="@L["CreateOffer_PresentationVideoReady"]" />
                        <button type="button" class="btn btn-link btn-sm text-danger px-0" @onclick="ClearPresentationVideo">
                            @L["CreateOffer_PresentationVideoRemove"]
                        </button>
                    </div>
                }
            </div>
        }

        else
        {
            <div class="section-card">
                <h2 class="form-section-title">@L["CreateOffer_SectionPreview"]</h2>
                <p class="text-muted">@L["CreateOffer_PreviewNote"]</p>
                @if (!string.IsNullOrWhiteSpace(PresentationVideoUrl))
                {
                    <GuideVideo Src="@PresentationVideoPlaybackUrl" Title="@L["CreateOffer_PresentationVideo"]" CssClass="mb-3" />
                }
                @if (!string.IsNullOrEmpty(_publishError))
                {
                    <div class="alert alert-danger">@_publishError</div>
                }
                <button class="btn btn-primary mt-3" type="button" disabled="@_publishing" @onclick="PublishOfferAsync">
                    @if (_publishing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    @L["Button_PublishOffer"] <i class="bi bi-send ms-2" aria-hidden="true"></i>
                </button>
            </div>
        }
    </div>

    <!-- Live preview -->
    <div class="col-lg-4">
        <div class="offer-preview sticky-top" style="top: calc(var(--ts-topbar-height, 56px) + 1rem);">
            <h3 class="offer-preview-header-title">@L["CreateOffer_Preview"]</h3>

            <div class="offer-preview-hero">
                <div class="offer-preview-hero-icon">
                    <i class="bi bi-mortarboard-fill" aria-hidden="true"></i>
                </div>
                <div class="offer-preview-hero-content">
                    <span class="offer-preview-hero-title">
                        @(string.IsNullOrWhiteSpace(OfferTitle) ? L["CreateOffer_TitlePlaceholder"].Value : OfferTitle)
                    </span>
                    <span class="offer-preview-mode-badge">@ModeLabel</span>
                </div>
            </div>

            <div class="offer-preview-body">
                @if (BillingMode == "quarterlyPerValidated")
                {
                    <p class="offer-preview-price">
                        @Rate.ToString("0.##") $
                        <span class="offer-preview-price-unit">/ @L["CreateOffer_PerValidatedLesson"]</span>
                    </p>
                    <p class="offer-preview-detail">@L["Billing_QuarterlyPerValidated"] · @SessionDuration min</p>
                }
                else
                {
                    <p class="offer-preview-price">
                        @Rate.ToString("0.##") $
                        <span class="offer-preview-price-unit">/ @RateUnitLabel</span>
                    </p>
                    <p class="offer-preview-detail">
                        @SessionDuration min @L["CreateOffer_PerSession"]
                        @if (BillingMode == "hourly")
                        {
                            <text> · ~@EstimatedSessionCost.ToString("0.##") $ @L["CreateOffer_PerSessionUnit"]</text>
                        }
                    </p>
                }
                <p class="offer-preview-detail text-muted small">@L["CreateOffer_BillingAfterValidationShort"]</p>

                <ul class="offer-preview-meta">
                    <li><i class="bi bi-book" aria-hidden="true"></i> @Subject</li>
                    <li><i class="bi bi-bar-chart-steps" aria-hidden="true"></i> @CycleLabel@SpecificLevelsPreview</li>
                    <li><i class="bi @TeachingModes.FirstOrDefault(m => m.Key == SelectedMode)?.Icon" aria-hidden="true"></i> @ModeLabel</li>
                    <li><i class="bi bi-translate" aria-hidden="true"></i> @Language</li>
                </ul>

                @if (SelectedBenefits.Count > 0)
                {
                    <div class="offer-preview-benefits-title">@L["CreateOffer_Benefits"]</div>
                    <ul class="offer-preview-benefits">
                        @foreach (var b in SelectedBenefits.Take(3))
                        {
                            <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @b</li>
                        }
                    </ul>
                }

                @if (CurrentStep < 4)
                {
                    <button class="btn btn-primary w-100 mt-3" type="button" @onclick="NextStep">
                        @L["Button_Next"] <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
                    </button>
                }
                else
                {
                    <button class="btn btn-primary w-100 mt-3" type="button" disabled="@_publishing" @onclick="PublishOfferAsync">
                        @if (_publishing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @L["Button_PublishOffer"] <i class="bi bi-send ms-2" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Sticky bottom bar -->
<div class="create-offer-footer">
    <button type="button" class="btn btn-ghost" @onclick='() => Navigation.NavigateTo("tutor/offers")'>
        @L["Button_Cancel"]
    </button>
    <div class="create-offer-footer-actions">
        @if (CurrentStep > 1)
        {
            <button type="button" class="btn btn-outline-primary" @onclick="PreviousStep" disabled="@_publishing">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> @L["Button_Previous"]
            </button>
        }
        @if (CurrentStep < 4)
        {
            <button type="button" class="btn btn-primary" @onclick="NextStep">
                @L["Button_Next"] <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
            </button>
        }
        else
        {
            <button type="button" class="btn btn-primary" disabled="@_publishing" @onclick="PublishOfferAsync">
                @if (_publishing)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                @L["Button_PublishOffer"] <i class="bi bi-send ms-2" aria-hidden="true"></i>
            </button>
        }
    </div>
</div>

@code {
    private record TeachingMode(string Key, string Label, string Description, string Icon);

    private int CurrentStep { get; set; } = 1;
    private string OfferTitle { get; set; } = "";
    private string Subject { get; set; } = "Mathématiques";
    /// <summary>Cycle d'enseignement : primary | secondary | college | university.</summary>
    private string Cycle { get; set; } = "secondary";
    private string Description { get; set; } = "";
    private string SelectedMode { get; set; } = "online";
    private string Language { get; set; } = "Français";
    /// <summary>hourly | perSession | quarterlyPerValidated — facturation après validation du cours.</summary>
    private string BillingMode { get; set; } = "hourly";
    private decimal Rate { get; set; } = 45;
    private int SessionDuration { get; set; } = 60;

    private decimal EstimatedSessionCost =>
        BillingMode == "hourly"
            ? Math.Round(Rate * (SessionDuration / 60m), 2)
            : Rate;

    private string RateFieldLabel => BillingMode switch
    {
        "hourly" => L["CreateOffer_HourlyRate"],
        "quarterlyPerValidated" => L["CreateOffer_ValidatedLessonRate"],
        _ => L["CreateOffer_SessionRate"]
    };

    private string RateUnitLabel => BillingMode switch
    {
        "hourly" => L["CreateOffer_PerHour"],
        "quarterlyPerValidated" => L["CreateOffer_PerValidatedLesson"],
        _ => L["CreateOffer_PerSessionUnit"]
    };

    private readonly HashSet<string> SelectedBenefits = [];
    private readonly HashSet<string> SelectedSpecificLevels = [];

    private record SpecificLevelOption(string Key, string Label);

    private IReadOnlyList<string> Steps => [
        L["CreateOffer_Step_Info"].Value,
        L["CreateOffer_Step_Pricing"].Value,
        L["CreateOffer_Step_Options"].Value,
        L["CreateOffer_Step_Preview"].Value
    ];

    private IReadOnlyList<string> StepSubtitles => [
        L["CreateOffer_Step_Info_Sub"].Value,
        L["CreateOffer_Step_Pricing_Sub"].Value,
        L["CreateOffer_Step_Options_Sub"].Value,
        L["CreateOffer_Step_Preview_Sub"].Value
    ];

    private IReadOnlyList<TeachingMode> TeachingModes => [
        new("online", L["CreateOffer_Mode_Online"].Value, L["CreateOffer_Mode_Online_Desc"].Value, "bi-display"),
        new("inperson", L["CreateOffer_Mode_InPerson"].Value, L["CreateOffer_Mode_InPerson_Desc"].Value, "bi-building"),
        new("hybrid", L["CreateOffer_Mode_Hybrid"].Value, L["CreateOffer_Mode_Hybrid_Desc"].Value, "bi-grid-3x3"),
    ];

    private IReadOnlyList<string> AllBenefits => [
        L["CreateOffer_Benefit1"].Value,
        L["CreateOffer_Benefit2"].Value,
        L["CreateOffer_Benefit3"].Value,
        L["CreateOffer_Benefit4"].Value,
        L["CreateOffer_Benefit5"].Value,
        L["CreateOffer_Benefit6"].Value,
    ];

    private string ModeLabel => TeachingModes.FirstOrDefault(m => m.Key == SelectedMode)?.Label ?? SelectedMode;

    private string CycleLabel => Cycle switch
    {
        "primary" => L["Cycle_Primary"],
        "secondary" => L["Cycle_Secondary"],
        "college" => L["Cycle_College"],
        "university" => L["Cycle_University"],
        _ => L["Cycle_Secondary"]
    };

    /// <summary>Niveaux selon le système scolaire canadien (élémentaire K–6, secondaire 7–12).</summary>
    private IReadOnlyList<SpecificLevelOption> AvailableSpecificLevels => Cycle switch
    {
        "primary" =>
        [
            new("pk", L["SpecificLevel_Kindergarten"]),
            new("p1", L["SpecificLevel_Grade1"]),
            new("p2", L["SpecificLevel_Grade2"]),
            new("p3", L["SpecificLevel_Grade3"]),
            new("p4", L["SpecificLevel_Grade4"]),
            new("p5", L["SpecificLevel_Grade5"]),
            new("p6", L["SpecificLevel_Grade6"]),
        ],
        "secondary" =>
        [
            new("g7", L["SpecificLevel_Grade7"]),
            new("g8", L["SpecificLevel_Grade8"]),
            new("g9", L["SpecificLevel_Grade9"]),
            new("g10", L["SpecificLevel_Grade10"]),
            new("g11", L["SpecificLevel_Grade11"]),
            new("g12", L["SpecificLevel_Grade12"]),
        ],
        "college" =>
        [
            new("c1", L["SpecificLevel_College1"]),
            new("c2", L["SpecificLevel_College2"]),
            new("c3", L["SpecificLevel_College3"]),
        ],
        _ => []
    };

    private string SpecificLevelsPreview
    {
        get
        {
            if (SelectedSpecificLevels.Count == 0)
                return "";
            var labels = AvailableSpecificLevels
                .Where(l => SelectedSpecificLevels.Contains(l.Key))
                .Select(l => l.Label)
                .ToList();
            return labels.Count == 0 ? "" : " · " + string.Join(", ", labels);
        }
    }

    protected override void OnInitialized()
    {
        SelectedBenefits.Add(L["CreateOffer_Benefit1"].Value);
        SelectedBenefits.Add(L["CreateOffer_Benefit2"].Value);
        SelectedBenefits.Add(L["CreateOffer_Benefit3"].Value);
        SelectedBenefits.Add(L["CreateOffer_Benefit4"].Value);
        SelectedBenefits.Add(L["CreateOffer_Benefit5"].Value);
    }

    private void OnCycleChanged(ChangeEventArgs e)
    {
        Cycle = e.Value?.ToString() ?? "secondary";
        var allowed = AvailableSpecificLevels.Select(l => l.Key).ToHashSet();
        SelectedSpecificLevels.RemoveWhere(k => !allowed.Contains(k));
    }

    private void ToggleSpecificLevel(string key)
    {
        if (!SelectedSpecificLevels.Remove(key))
            SelectedSpecificLevels.Add(key);
    }

    private void ToggleBenefit(string benefit)
    {
        if (!SelectedBenefits.Remove(benefit))
            SelectedBenefits.Add(benefit);
    }

    private bool OptionTrial { get; set; } = true;
    private bool OptionMaterials { get; set; }
    private bool OptionReport { get; set; }
    private string? PresentationVideoUrl { get; set; }
    private string? PresentationVideoFileName { get; set; }
    private bool _uploadingVideo;
    private bool _publishing;
    private string? _videoError;
    private string? _publishError;

    private string PresentationVideoPlaybackUrl =>
        string.IsNullOrWhiteSpace(PresentationVideoUrl)
            ? ""
            : PresentationVideoUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? PresentationVideoUrl
                : $"{PublicApiBase.TrimEnd('/')}/{PresentationVideoUrl.TrimStart('/')}";

    private string PublicApiBase =>
        NonEmpty(Config["ApiBaseUrl"])
        ?? Navigation.BaseUri.TrimEnd('/');

    private static string? NonEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void NextStep()
    {
        _publishError = null;
        if (CurrentStep == 1 && !ValidateStep1())
            return;
        if (CurrentStep == 2 && Rate <= 0)
        {
            _publishError = L["CreateOffer_RateRequired"];
            return;
        }
        if (CurrentStep < 4) CurrentStep++;
    }

    private void PreviousStep()
    {
        _publishError = null;
        if (CurrentStep > 1) CurrentStep--;
    }

    private bool ValidateStep1()
    {
        if (string.IsNullOrWhiteSpace(OfferTitle))
        {
            _publishError = L["CreateOffer_TitleRequired"];
            CurrentStep = 1;
            return false;
        }
        if (string.IsNullOrWhiteSpace(Description))
        {
            _publishError = L["CreateOffer_DescriptionRequired"];
            CurrentStep = 1;
            return false;
        }
        return true;
    }

    private Task OnPresentationVideoSaved(string url)
    {
        PresentationVideoUrl = url;
        PresentationVideoFileName = "presentation-recorded";
        _videoError = null;
        return Task.CompletedTask;
    }

    private Task OnPresentationVideoError(string error)
    {
        _videoError = error;
        return Task.CompletedTask;
    }

    private async Task OnPresentationVideoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _uploadingVideo = true;
        _videoError = null;
        try
        {
            const long maxSize = 100L * 1024 * 1024; // 100 Mo
            await using var stream = file.OpenReadStream(maxSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(ms.ToArray());
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                string.IsNullOrWhiteSpace(file.ContentType) ? "video/mp4" : file.ContentType);
            content.Add(fileContent, "file", file.Name);
            content.Add(new StringContent("OfferPresentations"), "folder");

            var result = await Api.PostMultipartAsync<DocVm>("api/documents", content);
            if (result.Error is not null || result.Value is null)
            {
                _videoError = result.Error ?? L["CreateOffer_PresentationVideoFailed"];
                return;
            }

            PresentationVideoUrl = result.Value.Url;
            PresentationVideoFileName = result.Value.FileName;
        }
        catch (Exception ex)
        {
            _videoError = ex.Message;
        }
        finally
        {
            _uploadingVideo = false;
        }
    }

    private void ClearPresentationVideo()
    {
        PresentationVideoUrl = null;
        PresentationVideoFileName = null;
        _videoError = null;
    }

    private async Task PublishOfferAsync()
    {
        _publishError = null;
        if (!ValidateStep1())
        {
            CurrentStep = 1;
            return;
        }
        if (Rate <= 0)
        {
            _publishError = L["CreateOffer_RateRequired"];
            CurrentStep = 2;
            return;
        }

        _publishing = true;
        try
        {
            var durationDays = BillingMode == "quarterlyPerValidated" ? 90 : 30;
            var billingPeriod = BillingMode == "quarterlyPerValidated" ? "trimestre" : "mois";
            var modeLabel = SelectedMode switch
            {
                "inperson" => "Présentiel",
                "hybrid" => "Hybride",
                _ => "En ligne"
            };

            var levelParts = new List<string> { CycleLabel };
            if (SelectedSpecificLevels.Count > 0)
            {
                levelParts.AddRange(AvailableSpecificLevels
                    .Where(l => SelectedSpecificLevels.Contains(l.Key))
                    .Select(l => l.Label));
            }

            var optionsNote = string.Join(" · ", new[]
            {
                OptionTrial ? L["CreateOffer_OptionTrial"].Value : null,
                OptionMaterials ? L["CreateOffer_OptionMaterials"].Value : null,
                OptionReport ? L["CreateOffer_OptionReport"].Value : null
            }.Where(x => x is not null));

            var desc = Description.Trim();
            if (SelectedBenefits.Count > 0)
                desc += "\n\n" + string.Join("\n", SelectedBenefits.Select(b => "• " + b));
            if (!string.IsNullOrWhiteSpace(optionsNote))
                desc += "\n\n" + optionsNote;
            if (!string.IsNullOrWhiteSpace(Language))
                desc += $"\n\n{L["CreateOffer_Language"]}: {Language}";

            var price = BillingMode == "hourly" ? EstimatedSessionCost : Rate;

            var schedule = new
            {
                billingPeriod,
                cadence = "weekly",
                sessionDurationMin = SessionDuration,
                billingMode = BillingMode,
                hourlyRate = BillingMode == "hourly" ? (decimal?)Rate : null,
                sessionRate = BillingMode is "perSession" or "quarterlyPerValidated" ? (decimal?)Rate : null,
                presentationVideoUrl = PresentationVideoUrl,
                level = string.Join(" · ", levelParts),
                cancellationPolicy = (string?)null,
                slots = Array.Empty<object>()
            };

            var req = new
            {
                title = OfferTitle.Trim(),
                description = desc,
                subject = Subject,
                price,
                currency = "CAD",
                durationDays,
                sessionCount = 1,
                frequency = billingPeriod,
                mode = modeLabel,
                maxCapacity = 20,
                schedule
            };

            var created = await Api.PostWithErrorAsync<CreatedOfferVm>("api/subscription-offerings", req);
            if (created.Error is not null || created.Value is null)
            {
                _publishError = created.Error ?? L["CreateOffer_PublishFailed"];
                return;
            }

            // Toujours publié immédiatement (API IsActive = true à la création).
            Navigation.NavigateTo("tutor/offers");
        }
        catch (Exception ex)
        {
            _publishError = ex.Message;
        }
        finally
        {
            _publishing = false;
        }
    }

    private sealed class DocVm
    {
        public Guid Id { get; set; }
        public string FileName { get; set; } = "";
        public string Url { get; set; } = "";
    }

    private sealed class CreatedOfferVm
    {
        public Guid Id { get; set; }
        public bool IsActive { get; set; }
    }
}
