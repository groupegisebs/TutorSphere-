@page "/admin"
@page "/admin/dashboard"
@layout AdminLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AdminService AdminSvc
@inject AuthService Auth
@inject IStringLocalizer<SharedResources> L

<PageTitle>TutorSphere Control Center</PageTitle>

<AuthorizeView Roles="SuperAdmin,PlatformAdmin">
    <Authorized>
        <div class="cc-toolbar">
            <div>
                <h1 class="cc-page-title">Tableau de bord</h1>
                <p class="cc-page-sub">Supervision administrative — données réelles de la plateforme.</p>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="cc-date-range">
                    <i class="bi bi-calendar3"></i>
                    <span>@_rangeLabel</span>
                </div>
            </div>
        </div>

        @if (_loading)
        {
            <div class="d-flex align-items-center justify-content-center py-5">
                <span class="spinner-border text-primary me-3" role="status"></span>
                <span class="text-muted">Chargement des indicateurs…</span>
            </div>
        }
        else if (_error is not null)
        {
            <div class="cc-empty">
                <i class="bi bi-exclamation-triangle"></i>
                <p>@_error</p>
            </div>
        }
        else
        {
            <div class="cc-kpi-grid">
                <div class="cc-kpi">
                    <div class="cc-kpi-label">Utilisateurs</div>
                    <div class="cc-kpi-value">@Fmt(_stats!.TotalUsers)</div>
                    <span class="cc-page-sub" style="font-size:.75rem;">@_stats.ActiveUsers actifs · @_stats.InactiveUsers inactifs</span>
                </div>
                <div class="cc-kpi">
                    <div class="cc-kpi-label">Parents</div>
                    <div class="cc-kpi-value">@Fmt(_stats.TotalParents)</div>
                </div>
                <div class="cc-kpi">
                    <div class="cc-kpi-label">Élèves</div>
                    <div class="cc-kpi-value">@Fmt(_stats.TotalStudents)</div>
                </div>
                <div class="cc-kpi">
                    <div class="cc-kpi-label">Enseignants / Tuteurs</div>
                    <div class="cc-kpi-value">@Fmt(_stats.TotalTeachers + _stats.TotalTutors)</div>
                    <span class="cc-page-sub" style="font-size:.75rem;">@_stats.TotalTeachers ens. · @_stats.TotalTutors tuteurs</span>
                </div>
                <div class="cc-kpi">
                    <div class="cc-kpi-label">Écoles</div>
                    <div class="cc-kpi-value">@Fmt(_stats.TotalSchools)</div>
                </div>
                <div class="cc-kpi">
                    <div class="cc-kpi-label">Séances (fenêtre 60 j)</div>
                    <div class="cc-kpi-value">@Fmt(_stats.ActiveCourses)</div>
                </div>
            </div>

            <div class="cc-dash-mid">
                <div class="cc-card">
                    <div class="cc-card-header">
                        <div>
                            <h2 class="cc-card-title">Activité (30 jours)</h2>
                            <p class="cc-card-sub">Nouvelles écoles + paiements complétés / jour</p>
                        </div>
                    </div>
                    @if (_stats.DailySignups is { Count: > 0 } days && days.Any(d => d.Count > 0))
                    {
                        <div class="cc-line-chart">
                            <svg viewBox="0 0 400 180" preserveAspectRatio="none" aria-hidden="true">
                                <defs>
                                    <linearGradient id="ccAreaReal" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="#7c5cff" stop-opacity="0.45" />
                                        <stop offset="100%" stop-color="#7c5cff" stop-opacity="0" />
                                    </linearGradient>
                                </defs>
                                <path d="@ChartAreaPath(days)" fill="url(#ccAreaReal)" />
                                <path d="@ChartLinePath(days)" fill="none" stroke="#7c5cff" stroke-width="2.5" />
                            </svg>
                            <div class="cc-chart-tooltip">
                                <strong>Total 30 j</strong>
                                @days.Sum(d => d.Count) événement(s)
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="cc-empty" style="padding:2rem;">
                            <i class="bi bi-graph-up"></i>
                            <p>Aucune activité enregistrée sur 30 jours.</p>
                        </div>
                    }
                </div>

                <div class="cc-card">
                    <div class="cc-card-header">
                        <div>
                            <h2 class="cc-card-title">Répartition par pays</h2>
                            <p class="cc-card-sub">Écoles actives</p>
                        </div>
                    </div>
                    @if (_stats.Countries is { Count: > 0 } countries)
                    {
                        <ul class="cc-country-list" style="padding:1rem;">
                            @foreach (var c in countries)
                            {
                                <li>
                                    <span class="cc-country-left">
                                        <span class="cc-flag">@Flag(c.Country)</span>
                                        @c.Country
                                    </span>
                                    <span class="cc-country-count">@c.Count.ToString("N0")</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="cc-empty" style="padding:2rem;">
                            <i class="bi bi-globe2"></i>
                            <p>Aucun pays renseigné sur les écoles.</p>
                        </div>
                    }
                </div>

                <div class="cc-mini-stack">
                    <div class="cc-mini-stat">
                        <div class="cc-mini-stat-label">Séances en direct</div>
                        <div class="cc-mini-stat-row">
                            <span class="cc-mini-stat-value live">@_stats.LiveLessons</span>
                        </div>
                    </div>
                    <div class="cc-mini-stat">
                        <div class="cc-mini-stat-label">Abonnements actifs</div>
                        <div class="cc-mini-stat-row">
                            <span class="cc-mini-stat-value">@_stats.ActiveSubscriptions</span>
                        </div>
                    </div>
                    <div class="cc-mini-stat">
                        <div class="cc-mini-stat-label">Revenu (ce mois)</div>
                        <div class="cc-mini-stat-row">
                            <span class="cc-mini-stat-value money">@_stats.MonthRevenue.ToString("N0") @_stats.MonthCurrency</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cc-dash-lower">
                <div class="cc-card">
                    <div class="cc-card-header">
                        <div>
                            <h2 class="cc-card-title">Utilisateurs récents</h2>
                            <p class="cc-card-sub">Comptes présents sur la plateforme</p>
                        </div>
                        <a href="admin/users" class="cc-btn">Voir tout</a>
                    </div>
                    <div class="cc-table-wrap">
                        <table class="cc-table">
                            <thead>
                                <tr>
                                    <th>Utilisateur</th>
                                    <th>Type</th>
                                    <th>Pays</th>
                                    <th>École</th>
                                    <th>Statut</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_stats.RecentUsers is { Count: > 0 } recent)
                                {
                                    @foreach (var u in recent)
                                    {
                                        <tr>
                                            <td>
                                                <div class="cc-user-cell">
                                                    <span class="cc-user-avatar">@Initials(u.FullName)</span>
                                                    <span class="cc-user-cell-text">
                                                        <strong>@u.FullName</strong>
                                                        <span>@u.Email</span>
                                                    </span>
                                                </div>
                                            </td>
                                            <td><span class="cc-pill cc-pill-type @RoleClass(u.Role)">@RoleLabel(u.Role)</span></td>
                                            <td>@(u.Country ?? "—")</td>
                                            <td>@(u.SchoolName ?? "—")</td>
                                            <td>
                                                @if (u.IsActive)
                                                {
                                                    <span class="cc-pill cc-pill-ok">Actif</span>
                                                }
                                                else
                                                {
                                                    <span class="cc-pill cc-pill-bad">Inactif</span>
                                                }
                                            </td>
                                            <td><a class="cc-actions-btn" href="admin/users/@u.Id" title="Voir"><i class="bi bi-three-dots"></i></a></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">Aucun utilisateur à afficher.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="cc-card">
                    <div class="cc-card-header">
                        <div>
                            <h2 class="cc-card-title">Paiements (ce mois)</h2>
                            <p class="cc-card-sub">Répartition du chiffre d'affaires réel</p>
                        </div>
                        <a href="admin/payments" class="cc-btn">Voir</a>
                    </div>
                    @if (_stats.PaymentBreakdown is { Count: > 0 } slices)
                    {
                        <div class="cc-donut-wrap">
                            <div class="cc-donut">
                                <div class="cc-donut-center">
                                    <strong>@_stats.MonthRevenue.ToString("N0") @_stats.MonthCurrency</strong>
                                    Total
                                </div>
                            </div>
                            <ul class="cc-legend">
                                @foreach (var s in slices)
                                {
                                    <li>
                                        <span class="cc-dot" style="background:@SliceColor(s.Label);"></span>
                                        @s.Label @s.Percent.ToString("0.#")% · @s.Amount.ToString("N0")
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="cc-empty" style="padding:2rem;">
                            <i class="bi bi-credit-card"></i>
                            <p>Aucun paiement complété ce mois-ci.</p>
                        </div>
                    }
                </div>
            </div>

            <div class="cc-dash-bottom">
                <div class="cc-card">
                    <div class="cc-card-header">
                        <div>
                            <h2 class="cc-card-title">Top écoles</h2>
                            <p class="cc-card-sub">Par nombre d'élèves</p>
                        </div>
                        <a href="admin/schools" class="cc-btn">Voir</a>
                    </div>
                    @if (_stats.TopSchools is { Count: > 0 } schools)
                    {
                        <ul class="cc-rank-list">
                            @foreach (var s in schools)
                            {
                                <li class="cc-rank-item">
                                    <div class="cc-rank-icon"><i class="bi bi-building"></i></div>
                                    <div class="cc-rank-meta">
                                        <strong>@s.Name</strong>
                                        <span>@(s.Country ?? "—") · @s.StudentCount.ToString("N0") élèves</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="cc-empty" style="padding:1.5rem;">
                            <i class="bi bi-building"></i>
                            <p>Aucune école enregistrée.</p>
                        </div>
                    }
                </div>

                <div class="cc-card">
                    <div class="cc-card-header">
                        <div>
                            <h2 class="cc-card-title">Activité récente</h2>
                            <p class="cc-card-sub">Écoles, paiements, séances</p>
                        </div>
                    </div>
                    @if (_stats.RecentActivity is { Count: > 0 } activity)
                    {
                        <ul class="cc-activity-list">
                            @foreach (var a in activity)
                            {
                                <li class="cc-activity-item">
                                    <span class="cc-activity-dot" style="background:@a.Color;"></span>
                                    <div>
                                        <strong>@a.Title — @a.Detail</strong>
                                        <span>@Relative(a.At)</span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="cc-empty" style="padding:1.5rem;">
                            <i class="bi bi-activity"></i>
                            <p>Aucune activité récente.</p>
                        </div>
                    }
                </div>

                <div class="cc-card">
                    <div class="cc-card-header">
                        <div>
                            <h2 class="cc-card-title">Santé de la plateforme</h2>
                            <p class="cc-card-sub">Contrôles live</p>
                        </div>
                        <a href="admin/health" class="cc-btn">Détails</a>
                    </div>
                    @if (_health?.Checks is { Count: > 0 } checks)
                    {
                        <ul class="cc-health-list">
                            @foreach (var h in checks)
                            {
                                <li class="cc-health-item">
                                    <span class="cc-health-left">
                                        <span class="cc-status-dot" style="@(h.Ok ? "" : "background:#ef4444;")"></span>
                                        @h.Name
                                    </span>
                                    <span class="cc-health-status" style="@(h.Ok ? "" : "color:#ef4444;")">
                                        @(h.Ok ? "Opérationnel" : "En erreur")
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="cc-empty" style="padding:1.5rem;">
                            <i class="bi bi-heart-pulse"></i>
                            <p>Statut indisponible.</p>
                        </div>
                    }
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="cc-empty">
            <i class="bi bi-shield-lock"></i>
            <p>Accès réservé aux administrateurs de plateforme.</p>
            <a href="/login/admin" class="cc-btn cc-btn-primary mt-3">Se connecter</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private AdminStats? _stats;
    private AdminHealth? _health;
    private bool _loading = true;
    private string? _error;
    private string _rangeLabel = "";

    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;
        var end = DateTime.Today;
        var start = end.AddDays(-30);
        _rangeLabel = $"{start:dd MMM yyyy} — {end:dd MMM yyyy}";
        try
        {
            await Auth.EnsureSessionRestoredAsync(forceJs: true);
            _stats = await AdminSvc.GetStatsAsync();
            _health = await AdminSvc.GetHealthAsync();
            if (_stats is null)
                _error = "Impossible de charger les statistiques administrateur.";
        }
        catch (Exception ex)
        {
            _error = $"Erreur de chargement : {ex.Message}";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string Fmt(int n) => n.ToString("N0");

    private static string Initials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}"
            : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }

    private static string RoleLabel(string role) => role switch
    {
        "Parent" => "Parent",
        "Student" => "Élève",
        "Tutor" => "Tuteur",
        "TeachingAssistant" => "Enseignant",
        _ => role
    };

    private static string RoleClass(string role) => role switch
    {
        "Parent" => "parent",
        "Student" => "student",
        "Tutor" => "tutor",
        "TeachingAssistant" => "teacher",
        _ => ""
    };

    private static string Flag(string country) => country.ToLowerInvariant() switch
    {
        "cameroun" or "cameroon" => "🇨🇲",
        "france" => "🇫🇷",
        "canada" => "🇨🇦",
        "belgique" or "belgium" => "🇧🇪",
        "sénégal" or "senegal" => "🇸🇳",
        "côte d'ivoire" or "cote d'ivoire" or "ivory coast" => "🇨🇮",
        _ => "🌍"
    };

    private static string SliceColor(string label) => label switch
    {
        "Abonnements" => "#7c5cff",
        "Licences plateforme" => "#3b82f6",
        _ => "#f59e0b"
    };

    private static string Relative(DateTime at)
    {
        var utc = at.Kind == DateTimeKind.Unspecified ? DateTime.SpecifyKind(at, DateTimeKind.Utc) : at.ToUniversalTime();
        var delta = DateTime.UtcNow - utc;
        if (delta.TotalMinutes < 1) return "À l'instant";
        if (delta.TotalMinutes < 60) return $"Il y a {(int)delta.TotalMinutes} min";
        if (delta.TotalHours < 24) return $"Il y a {(int)delta.TotalHours} h";
        if (delta.TotalDays < 7) return $"Il y a {(int)delta.TotalDays} j";
        return utc.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    }

    private static string ChartLinePath(List<AdminDailyCount> days)
    {
        var max = Math.Max(1, days.Max(d => d.Count));
        var n = Math.Max(1, days.Count - 1);
        var pts = days.Select((d, i) =>
        {
            var x = i * 400.0 / n;
            var y = 160 - (d.Count * 140.0 / max);
            return $"{x:0.##},{y:0.##}";
        });
        return "M" + string.Join(" L", pts);
    }

    private static string ChartAreaPath(List<AdminDailyCount> days)
        => ChartLinePath(days) + " L400,180 L0,180 Z";
}
