@page "/parent/payments"
@layout ParentLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.WebUtilities
@inject IStringLocalizer<SharedResources> L
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ParentProfileState ParentProfile

<PageTitle>Mes Paiements – TutorSphere</PageTitle>

<div class="ts-page-header">
    <div>
        <h1><i class="bi bi-credit-card me-2"></i>Mes Paiements</h1>
        <p class="ts-page-subtitle">Historique de vos paiements et factures</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(_banner))
{
    <div class="alert alert-success py-2 px-3 mb-3"><i class="bi bi-check-circle me-2"></i>@_banner</div>
}

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger py-2 px-3 mb-3">@_error</div>
}

@if (!_loading && string.IsNullOrWhiteSpace(ParentProfile.Country))
{
    <div class="alert alert-warning py-2 px-3 mb-3">
        <i class="bi bi-geo-alt me-2"></i>
        @L["ParentPayments_CountryRequired"]
        <a class="alert-link ms-1" href="/parent/profile">@L["Nav_MyProfile"]</a>
    </div>
}

@if (_loading)
{
    <div class="d-flex align-items-center justify-content-center py-5">
        <span class="spinner-border text-primary me-3" role="status"></span>
        <span class="text-muted">Chargement des paiements…</span>
    </div>
}
else
{
    @* Un compteur par devise : les enfants peuvent suivre des offres de pays différents, et le
       symbole « $ » codé en dur affichait des francs CFA comme des dollars. *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="ts-kpi-card ts-kpi-card--success">
                <span class="ts-kpi-val">@FormatTotals(PaidTotals)</span>
                <span class="ts-kpi-label">Total payé</span>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="ts-kpi-card ts-kpi-card--warning">
                <span class="ts-kpi-val">@FormatTotals(PendingTotals)</span>
                <span class="ts-kpi-label">En attente</span>
            </div>
        </div>
    </div>

    <div class="ts-table-card">
        <table class="table ts-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Montant</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _payments)
                {
                    var statusLabel = StatusLabel(p.Status);
                    var statusBadge = StatusBadge(p.Status);
                    <tr>
                        <td>@((p.PaidAt ?? p.CreatedAt).ToLocalTime().ToString("dd/MM/yyyy"))</td>
                        <td>
                            <div class="fw-semibold">@p.Description</div>
                            @if (!string.IsNullOrWhiteSpace(p.StudentName) || !string.IsNullOrWhiteSpace(p.TutorName))
                            {
                                <div class="text-muted small">
                                    @if (!string.IsNullOrWhiteSpace(p.StudentName))
                                    {
                                        <span>@p.StudentName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(p.TutorName))
                                    {
                                        <span> · @p.TutorName</span>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.InvoiceNumber))
                            {
                                <div class="text-muted small">@p.InvoiceNumber</div>
                            }
                        </td>
                        <td class="fw-semibold">@p.Amount.ToString("N2") @p.Currency.ToUpper()</td>
                        <td><span class="ts-badge @statusBadge">@statusLabel</span></td>
                        <td class="text-end text-nowrap">
                            @* Un paiement resté en attente doit pouvoir aboutir depuis ici : le
                               parent qui a quitté la page de règlement n'avait plus aucun bouton. *@
                            @if (p.CanPay && p.SubscriptionId.HasValue)
                            {
                                <button type="button" class="btn btn-primary btn-sm me-2"
                                        @onclick="() => OpenPay(p)">
                                    <i class="bi bi-credit-card me-1"></i>Payer
                                </button>
                            }
                            else if (p.Status == "Pending" && !string.IsNullOrWhiteSpace(p.PayBlockedReason))
                            {
                                <span class="text-muted small me-2" title="@p.PayBlockedReason">
                                    <i class="bi bi-hourglass-split me-1"></i>Règlement indisponible
                                </span>
                            }
                            @if (p.CanDownloadInvoice)
                            {
                                <button type="button" class="ts-icon-btn" title="Télécharger la facture"
                                        disabled="@(_downloadingId == p.Id)"
                                        @onclick="() => DownloadInvoiceAsync(p)">
                                    @if (_downloadingId == p.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-pdf"></i>
                                    }
                                </button>
                            }
                            else
                            {
                                <button type="button" class="ts-icon-btn" title="Facture indisponible" disabled>
                                    <i class="bi bi-file-pdf"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
                @if (_payments.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Aucun paiement trouvé.</td></tr>
                }
            </tbody>
        </table>
    </div>
}

<PaymentCheckoutModal @bind-Visible="_payModalVisible"
                      SubscriptionId="@(_payTarget?.SubscriptionId)"
                      Amount="@(_payTarget?.Amount ?? 0)"
                      Currency="@(_payTarget?.Currency ?? "CAD")"
                      ProductTitle="@_payTarget?.Description"
                      PayerCountry="@ParentProfile.Country"
                      SuccessUrl="@_paySuccessUrl"
                      CancelUrl="@_payCancelUrl"
                      OnPaid="OnPaidAsync"
                      OnError="OnPayError" />

@code {
    private bool _loading = true;
    private string? _error;
    private string? _banner;
    private Guid? _downloadingId;
    private List<ParentPaymentVm> _payments = [];
    private bool _payModalVisible;
    private ParentPaymentVm? _payTarget;
    private string _paySuccessUrl = "";
    private string _payCancelUrl = "";

    private IReadOnlyList<MoneyTotal> PaidTotals => TotalsFor("Completed");

    private IReadOnlyList<MoneyTotal> PendingTotals => TotalsFor("Pending");

    private IReadOnlyList<MoneyTotal> TotalsFor(string status) =>
        MoneyTotals.Group(
            _payments.Where(p => p.Status == status),
            p => p.Amount,
            p => p.Currency);

    /// <summary>Le tiret cadratin plutôt qu'un zéro : aucun paiement n'est pas un montant nul.</summary>
    private static string FormatTotals(IReadOnlyList<MoneyTotal> totals) =>
        totals.Count == 0 ? "—" : MoneyTotals.Format(totals, "N2");

    private static string StatusLabel(string status) => status switch
    {
        "Completed" => "Payé",
        "Pending" => "En attente",
        "Failed" => "Échoué",
        "Refunded" => "Remboursé",
        _ => status
    };

    private static string StatusBadge(string status) => status switch
    {
        "Completed" => "ts-badge-success",
        "Pending" => "ts-badge-warning",
        "Refunded" => "ts-badge-muted",
        _ => "ts-badge-danger"
    };

    protected override async Task OnInitializedAsync()
    {
        try { await ParentProfile.EnsureLoadedAsync(); } catch { }

        // Retour de la page de règlement : le webhook peut arriver après le navigateur, on
        // demande la confirmation côté serveur avant d'afficher la liste.
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query.ContainsKey("paid")
            && query.TryGetValue("sub", out var subRaw)
            && Guid.TryParse(subRaw, out var subId))
        {
            try
            {
                await Api.PostWithErrorAsync<object>($"api/payments/subscriptions/{subId}/confirm", new { });
                _banner = "Paiement enregistré. Merci !";
            }
            catch { }
        }

        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await Api.GetWithErrorAsync<List<ParentPaymentVm>>("api/parent/payments");
            if (result.Error is not null)
            {
                _error = result.Error;
                _payments = [];
            }
            else
            {
                _payments = result.Value ?? [];
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _payments = [];
        }
    }

    private void OpenPay(ParentPaymentVm payment)
    {
        _error = null;
        _payTarget = payment;
        var baseUri = Nav.BaseUri.TrimEnd('/');
        _paySuccessUrl = $"{baseUri}/parent/payments?paid=1&sub={payment.SubscriptionId}";
        _payCancelUrl = $"{baseUri}/parent/payments";
        _payModalVisible = true;
    }

    private async Task OnPaidAsync()
    {
        _banner = "Paiement enregistré. Merci !";
        await LoadAsync();
    }

    private void OnPayError(string message) => _error = message;

    private async Task DownloadInvoiceAsync(ParentPaymentVm payment)
    {
        _error = null;
        _downloadingId = payment.Id;
        try
        {
            var result = await Api.GetBytesWithErrorAsync($"api/parent/payments/{payment.Id}/invoice");
            if (result.Error is not null || result.Value is null || result.Value.Length == 0)
            {
                _error = result.Error ?? "Impossible de télécharger la facture.";
                return;
            }

            var fileName = string.IsNullOrWhiteSpace(payment.InvoiceNumber)
                ? $"Facture-{payment.Id:N}.pdf"
                : $"Facture-{payment.InvoiceNumber}.pdf";
            var base64 = Convert.ToBase64String(result.Value);
            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "application/pdf", base64);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _downloadingId = null;
        }
    }

    private record ParentPaymentVm(
        Guid Id,
        Guid? InvoiceId,
        string? InvoiceNumber,
        string Description,
        string? StudentName,
        string? TutorName,
        decimal Amount,
        string Currency,
        string Status,
        DateTime CreatedAt,
        DateTime? PaidAt,
        bool CanDownloadInvoice,
        Guid? SubscriptionId,
        bool CanPay,
        string? PayBlockedReason);
}
