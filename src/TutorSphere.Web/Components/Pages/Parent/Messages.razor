@page "/parent/messages"
@layout ParentLayout
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using TutorSphere.Application.DTOs.Parents
@inject IStringLocalizer<SharedResources> L
@inject ApiClient Api
@inject AuthService Auth
@inject RealtimeMessagingClient Realtime
@inject MessagingNotificationState NotifyState
@inject NavigationManager Nav

<PageTitle>@L["Nav_Messages"] – TutorSphere</PageTitle>

<div class="parent-dashboard pd-mock pmsg-page">
    <header class="pc-header">
        <div>
            <h1>@L["Nav_Messages"]</h1>
            <p class="ts-page-subtitle">@L["ParentMsg_Subtitle"]</p>
        </div>
        <button type="button" class="pc-add-btn" @onclick="OpenCompose">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> @L["ParentMsg_New"]
        </button>
    </header>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-warning mb-3 d-flex flex-wrap align-items-center gap-2" role="alert">
            <span>@_error</span>
            @if (_sessionExpired)
            {
                <a class="btn btn-sm btn-outline-dark" href="/login/parent">@L["Common_ReLogin"]</a>
            }
        </div>
    }

    @if (_loading)
    {
        <div class="pd-loading">
            <span class="spinner-border spinner-border-sm" role="status"></span>
            <span>@L["Common_Loading"]</span>
        </div>
    }
    else
    {
        <nav class="pc-tabs pmsg-tabs">
            <button type="button" class="pc-tab @(_tab == "all" ? "is-active" : "")" @onclick='() => _tab = "all"'>
                @L["ParentMsg_TabAll"] (@_threads.Count)
            </button>
            <button type="button" class="pc-tab @(_tab == "teacher" ? "is-active" : "")" @onclick='() => _tab = "teacher"'>
                @L["ParentMsg_TabTeachers"] (@CountChannel("teacher"))
            </button>
            <button type="button" class="pc-tab @(_tab == "group" ? "is-active" : "")" @onclick='() => _tab = "group"'>
                @L["ParentMsg_TabGroups"] (@CountChannel("group"))
            </button>
            <button type="button" class="pc-tab @(_tab == "admin" ? "is-active" : "")" @onclick='() => _tab = "admin"'>
                @L["ParentMsg_TabAdmin"] (@CountChannel("admin"))
            </button>
        </nav>

        <div class="pcal-chips" role="tablist">
            <button type="button" class="pcal-chip @(_childFilter is null ? "is-active" : "")" @onclick="() => _childFilter = null">
                @L["ParentCal_AllChildren"]
            </button>
            @foreach (var child in _children)
            {
                <button type="button" class="pcal-chip @(_childFilter == child.Id ? "is-active" : "")" @onclick="() => _childFilter = child.Id">
                    <span class="pcal-dot" style="background:@ChildColor(child.Id)"></span>
                    @child.FirstName
                </button>
            }
        </div>

        <div class="pmsg-layout @(_compose || _active is not null ? "has-side" : "")">
            <aside class="pmsg-list">
                <div class="messages-search">
                    <i class="bi bi-search"></i>
                    <input class="form-control form-control-sm" placeholder="@L["ParentMsg_Search"]"
                           @bind="_search" @bind:event="oninput" />
                </div>
                @if (!VisibleThreads.Any())
                {
                    <p class="pmsg-empty-list">@L["ParentMsg_EmptyList"]</p>
                }
                @foreach (var t in VisibleThreads)
                {
                    <button type="button"
                            class="pmsg-item @(_active?.ThreadId == t.ThreadId ? "is-active" : "") @(t.UnreadCount > 0 ? "unread" : "")"
                            @onclick="() => SelectThreadAsync(t)">
                        <div class="conv-avatar" style="background:@ChannelColor(t)">@Initials(t.PeerName)</div>
                        <div class="conv-info">
                            <div class="conv-name">@t.PeerName</div>
                            <div class="pmsg-item-meta">
                                <span>@RoleLabel(t.Channel)</span>
                                @if (!string.IsNullOrWhiteSpace(t.ChildFirstName))
                                {
                                    <span class="pmsg-child-tag" style="--pprog-chip:@ChildColor(t.StudentId)">@t.ChildFirstName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(t.CaseNumber))
                                {
                                    <span class="pmsg-case">@t.CaseNumber</span>
                                }
                            </div>
                            <div class="conv-last">@(string.IsNullOrWhiteSpace(t.LastPreview) ? L["ParentMsg_Start"] : t.LastPreview)</div>
                        </div>
                        <div class="conv-meta">
                            <span class="conv-time">@FormatTime(t.LastAt)</span>
                            @if (t.UnreadCount > 0)
                            {
                                <span class="conv-badge">@t.UnreadCount</span>
                            }
                        </div>
                    </button>
                }
            </aside>

            <section class="pmsg-chat">
                @if (_activeDetail is { } detail)
                {
                    <div class="chat-header pmsg-chat-head">
                        <div class="conv-avatar" style="background:@ChannelColor(detail.Thread)">@Initials(detail.Thread.PeerName)</div>
                        <div>
                            <strong>@detail.Thread.PeerName</strong>
                            <span class="chat-role">
                                @RoleLabel(detail.Thread.Channel)
                                @if (!string.IsNullOrWhiteSpace(detail.Thread.ChildFirstName))
                                {
                                    <span> · @L["ParentMsg_TeacherOf", detail.Thread.ChildFirstName]</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(detail.Thread.GroupName))
                                {
                                    <text> · @detail.Thread.GroupName</text>
                                }
                                @if (!string.IsNullOrWhiteSpace(detail.Thread.CaseNumber))
                                {
                                    <text> · @detail.Thread.CaseNumber</text>
                                }
                            </span>
                        </div>
                    </div>
                    <div class="chat-messages">
                        @foreach (var m in FilteredMessages(detail.Messages))
                        {
                            <div class="chat-msg @(m.FromParent ? "chat-msg--me" : "chat-msg--them")">
                                <div class="chat-bubble">
                                    @m.Body
                                    @if (!string.IsNullOrWhiteSpace(m.AttachmentLabel))
                                    {
                                        <div class="pmsg-attach"><i class="bi bi-paperclip"></i> @m.AttachmentLabel</div>
                                    }
                                </div>
                                <span class="chat-time">
                                    @FormatTime(m.CreatedAt)
                                    @if (m.FromParent)
                                    {
                                        <i class="bi bi-check2-all" title="@L["ParentMsg_Sent"]"></i>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                    <div class="pmsg-actions">
                        <button type="button" class="pmsg-action" @onclick='() => _attachKind = "homework"'>@L["ParentMsg_AttachHw"]</button>
                        <button type="button" class="pmsg-action" @onclick='() => _attachKind = "document"'>@L["ParentMsg_AttachDoc"]</button>
                        <button type="button" class="pmsg-action" @onclick="() => _showAppt = !_showAppt">@L["ParentMsg_AskMeeting"]</button>
                    </div>
                    @if (_attachKind is not null && _directory is not null)
                    {
                        <div class="pmsg-picker">
                            <select class="pc-period" @bind="_attachId">
                                <option value="">@L["ParentMsg_Choose"]</option>
                                @foreach (var item in _attachKind == "homework" ? _directory.Homework : _directory.Documents)
                                {
                                    <option value="@item.Id">@item.Label</option>
                                }
                            </select>
                            <button type="button" class="pd-link" @onclick="ClearAttach">@L["Common_Cancel"]</button>
                        </div>
                    }
                    @if (_showAppt)
                    {
                        <div class="pmsg-picker">
                            <input class="form-control form-control-sm" type="datetime-local" @bind="_appt" />
                        </div>
                    }
                    <div class="chat-input-area">
                        <input class="form-control" placeholder="@L["ParentMsg_Write"]"
                               @bind="_newMsg" @bind:event="oninput" @onkeydown="HandleKey" />
                        <button type="button" class="pmsg-send" disabled="@(_sending || string.IsNullOrWhiteSpace(_newMsg))" @onclick="ReplyAsync">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                    <p class="pmsg-privacy">@L["ParentMsg_Privacy"]</p>
                    @if (!string.IsNullOrEmpty(_sendError))
                    {
                        <div class="text-danger small px-3 pb-2">@_sendError</div>
                    }
                }
                else if (!_compose)
                {
                    <div class="messages-empty">
                        <i class="bi bi-chat-dots messages-empty-icon"></i>
                        <p>@L["ParentMsg_Pick"]</p>
                    </div>
                }
            </section>

            @if (_compose || _activeDetail is not null)
            {
                <aside class="pmsg-side">
                    @if (_compose)
                    {
                        <h3>@L["ParentMsg_New"]</h3>
                        <label class="pmsg-label">@L["ParentMsg_About"]</label>
                        <select class="pc-period pmsg-select" @bind="_composeChildId" @bind:after="OnComposeChildChangedAsync">
                            <option value="">@L["ParentMsg_ChooseChild"]</option>
                            @foreach (var child in _children)
                            {
                                <option value="@child.Id">@child.FirstName @child.LastName</option>
                            }
                        </select>

                        <label class="pmsg-label">@L["ParentMsg_RecipientType"]</label>
                        <div class="pmsg-types">
                            <button type="button" class="pmsg-type @(_composeChannel == "teacher" ? "is-active" : "")" @onclick='() => _composeChannel = "teacher"'>
                                <strong>@L["ParentMsg_TypeTeacher"]</strong>
                                <span>@L["ParentMsg_TypeTeacherHint"]</span>
                            </button>
                            <button type="button" class="pmsg-type @(_composeChannel == "group" ? "is-active" : "")" @onclick='() => _composeChannel = "group"'>
                                <strong>@L["ParentMsg_TypeGroup"]</strong>
                                <span>@L["ParentMsg_TypeGroupHint"]</span>
                            </button>
                            <button type="button" class="pmsg-type @(_composeChannel == "admin" ? "is-active" : "")" disabled="@(!_adminAvailable)" @onclick='() => _composeChannel = "admin"'>
                                <strong>@L["ParentMsg_TypeAdmin"]</strong>
                                <span>@L["ParentMsg_TypeAdminHint"]</span>
                            </button>
                        </div>

                        @if (_composeChannel != "admin")
                        {
                            <label class="pmsg-label">@L["ParentMsg_Recipient"]</label>
                            <select class="pc-period pmsg-select" @bind="_composeTeacherId">
                                <option value="">@L["ParentMsg_ChooseTeacher"]</option>
                                @foreach (var teacher in _directory?.Teachers ?? [])
                                {
                                    <option value="@teacher.UserId">@teacher.DisplayName @(string.IsNullOrWhiteSpace(teacher.Subject) ? "" : $"· {teacher.Subject}")</option>
                                }
                            </select>
                            @if (_composeChannel == "group")
                            {
                                <p class="pmsg-hint">@L["ParentMsg_GroupAuto"]</p>
                                @if (SelectedGroup is { } g)
                                {
                                    <div class="pmsg-group-card">
                                        <strong>@g.Name</strong>
                                        @if (g.Verified)
                                        {
                                            <span class="pc-pill pc-pill-ok">@L["ParentMsg_GroupVerified"]</span>
                                        }
                                    </div>
                                }
                            }
                        }

                        <label class="pmsg-label">@L["ParentMsg_Reason"]</label>
                        <select class="pc-period pmsg-select" @bind="_composeReason">
                            <option value="">@L["ParentMsg_ChooseReason"]</option>
                            @foreach (var reason in ReasonsFor(_composeChannel))
                            {
                                <option value="@reason">@ReasonLabel(reason)</option>
                            }
                        </select>

                        <label class="pmsg-label">@L["ParentMsg_Write"]</label>
                        <textarea class="form-control" rows="4" @bind="_composeBody"></textarea>
                        <button type="button" class="pc-add-btn pmsg-submit" disabled="@_sending" @onclick="ComposeAsync">
                            @L["ParentMsg_Send"]
                        </button>
                    }
                    else if (_activeDetail is { } ctx)
                    {
                        <h3>@L["ParentMsg_Context"]</h3>
                        @if (!string.IsNullOrWhiteSpace(ctx.Thread.GroupName))
                        {
                            <div class="pmsg-group-card">
                                <strong>@ctx.Thread.GroupName</strong>
                                @if (ctx.Thread.GroupVerified)
                                {
                                    <span class="pc-pill pc-pill-ok">@L["ParentMsg_GroupVerified"]</span>
                                }
                            </div>
                        }
                        @if (_directory?.Context is { Count: > 0 })
                        {
                            <p class="pmsg-label">@L["ParentMsg_Linked"]</p>
                            @foreach (var item in _directory.Context)
                            {
                                <p class="pmsg-hint mb-1">@item.Label</p>
                            }
                        }
                        <div class="pmsg-side-links">
                            @if (!string.IsNullOrWhiteSpace(ctx.Thread.TeacherProfileSlug))
                            {
                                <a class="pd-link" href="@($"/parent/tutors/{ctx.Thread.TeacherProfileSlug}")">@L["ParentMsg_ViewProfile"]</a>
                            }
                            <button type="button" class="pd-link" @onclick="() => _showSearch = !_showSearch">@L["ParentMsg_SearchThread"]</button>
                            <button type="button" class="pd-link pmsg-report" @onclick="ReportProblemAsync">@L["ParentMsg_Report"]</button>
                        </div>
                        @if (_showSearch)
                        {
                            <input class="form-control form-control-sm mt-2" placeholder="@L["ParentMsg_Search"]" @bind="_threadSearch" @bind:event="oninput" />
                        }
                    }
                </aside>
            }
        </div>
    }
</div>

@code {
    private static readonly string[] ChildPalette = ["#5831E0", "#2563EB", "#7c3aed", "#0ea5e9", "#ec4899"];
    private bool _loading = true;
    private bool _sessionExpired;
    private bool _initialLoadDone;
    private bool _compose;
    private bool _sending;
    private bool _showAppt;
    private bool _showSearch;
    private string? _error;
    private string? _sendError;
    private string _search = "";
    private string _threadSearch = "";
    private string _tab = "all";
    private string _newMsg = "";
    private Guid? _childFilter;
    private string? _attachKind;
    private string _attachId = "";
    private DateTime? _appt;
    private List<ParentMailboxChildDto> _children = [];
    private List<ParentMailboxThreadDto> _threads = [];
    private ParentMailboxThreadDto? _active;
    private ParentMailboxThreadDetailDto? _activeDetail;
    private ParentMailboxDirectoryDto? _directory;
    private bool _adminAvailable;
    private string _composeChildId = "";
    private string _composeChannel = "teacher";
    private string _composeTeacherId = "";
    private string _composeReason = "";
    private string _composeBody = "";

    [SupplyParameterFromQuery(Name = "to")] public string? ToUserId { get; set; }
    [SupplyParameterFromQuery(Name = "childId")] public Guid? QueryChildId { get; set; }

    private IEnumerable<ParentMailboxThreadDto> VisibleThreads =>
        _threads.Where(t =>
            (_tab == "all" || t.Channel == _tab)
            && (_childFilter is null || t.StudentId == _childFilter)
            && (string.IsNullOrWhiteSpace(_search)
                || t.PeerName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || (t.ChildFirstName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                || (t.LastPreview?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)));

    private ParentMailboxGroupDto? SelectedGroup
    {
        get
        {
            if (_directory is null)
                return null;
            var teacher = _directory.Teachers.FirstOrDefault(t => t.UserId == _composeTeacherId);
            if (teacher is not null && !string.IsNullOrWhiteSpace(teacher.GroupName))
            {
                return new ParentMailboxGroupDto(
                    _directory.Group?.ManagerUserId,
                    _directory.Group?.GroupId ?? Guid.Empty,
                    teacher.GroupName,
                    _directory.Group?.LogoUrl,
                    teacher.GroupVerified,
                    teacher.UserId);
            }
            return _directory.Group;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialLoadDone) return;
        _initialLoadDone = true;
        Realtime.MessageReceived += OnRealtime;
        await Auth.EnsureSessionRestoredAsync(forceJs: true);
        await Realtime.EnsureConnectedAsync();
        await LoadMailboxAsync();
        if (QueryChildId is Guid cid)
            _composeChildId = cid.ToString();
        if (!string.IsNullOrWhiteSpace(ToUserId))
        {
            var match = _threads.FirstOrDefault(t => t.PeerUserId == ToUserId);
            if (match is not null) await SelectThreadAsync(match);
            else await OpenCompose();
        }
        StateHasChanged();
    }

    private void OnRealtime(TutorSphere.Application.DTOs.Messages.MessageDto message)
    {
        _ = InvokeAsync(async () =>
        {
            await LoadMailboxAsync(keepSelection: true);
            if (_active is not null)
                await SelectThreadAsync(_active);
        });
    }

    private void ClearAttach()
    {
        _attachKind = null;
        _attachId = "";
    }

    private async Task LoadMailboxAsync(bool keepSelection = false)
    {
        _loading = !keepSelection;
        _error = null;
        try
        {
            await Auth.EnsureSessionRestoredAsync();
            if (string.IsNullOrEmpty(Auth.Token))
            {
                if (Auth.IsSessionExpired)
                {
                    _sessionExpired = true;
                    _error = ApiClient.SessionExpiredMessage;
                }
                return;
            }
            var result = await Api.GetWithErrorAsync<ParentMailboxDto>("api/parent/mailbox");
            if (result.Error == ApiClient.SessionExpiredMessage)
            {
                _sessionExpired = true;
                _error = result.Error;
                return;
            }
            if (result.Error is not null || result.Value is null)
            {
                _error = result.Error ?? L["ParentMsg_LoadError"];
                return;
            }
            _children = result.Value.Children.ToList();
            _threads = result.Value.Threads.ToList();
            _adminAvailable = result.Value.AdminAvailable;
            NotifyState.SetUnreadTotal(_threads.Sum(t => t.UnreadCount));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task LoadDirectoryAsync(Guid childId)
    {
        var result = await Api.GetWithErrorAsync<ParentMailboxDirectoryDto>($"api/parent/mailbox/directory?childId={childId}");
        _directory = result.Value;
    }

    private async Task SelectThreadAsync(ParentMailboxThreadDto thread)
    {
        _compose = false;
        _active = thread;
        _sendError = null;
        var encoded = Uri.EscapeDataString(thread.ThreadId);
        var result = await Api.GetWithErrorAsync<ParentMailboxThreadDetailDto>($"api/parent/mailbox/threads/{encoded}");
        if (result.Value is null)
        {
            _error = result.Error ?? L["ParentMsg_LoadError"];
            return;
        }
        _activeDetail = result.Value;
        _threads = _threads
            .Select(t => t.ThreadId == thread.ThreadId ? t with { UnreadCount = 0 } : t)
            .ToList();
        _active = _threads.FirstOrDefault(t => t.ThreadId == thread.ThreadId) ?? result.Value.Thread;
        await Api.PutAsync<object>($"api/parent/mailbox/threads/{encoded}/read", new { });
        NotifyState.SetUnreadTotal(_threads.Sum(t => t.UnreadCount));
        if (thread.StudentId is Guid sid)
            await LoadDirectoryAsync(sid);
    }

    private async Task OpenCompose()
    {
        _compose = true;
        _active = null;
        _activeDetail = null;
        _composeReason = "";
        _composeBody = "";
        if (string.IsNullOrEmpty(_composeChildId) && _children.Count > 0)
            _composeChildId = _children[0].Id.ToString();
        if (Guid.TryParse(_composeChildId, out var id))
            await LoadDirectoryAsync(id);
    }

    private async Task OnComposeChildChangedAsync()
    {
        _composeTeacherId = "";
        if (Guid.TryParse(_composeChildId, out var id))
            await LoadDirectoryAsync(id);
        else
            _directory = null;
    }

    private async Task ComposeAsync()
    {
        if (!Guid.TryParse(_composeChildId, out var childId))
        {
            _sendError = L["ParentMsg_ChooseChild"];
            return;
        }
        _sending = true;
        _sendError = null;
        try
        {
            var request = new ParentMailboxComposeRequest(
                childId,
                _composeChannel,
                _composeReason,
                _composeBody,
                string.IsNullOrWhiteSpace(_composeTeacherId) ? null : _composeTeacherId);
            var result = await Api.PostWithErrorAsync<ParentMailboxThreadDetailDto>("api/parent/mailbox", request);
            if (result.Error is not null || result.Value is null)
            {
                _sendError = result.Error ?? L["ParentMsg_SendError"];
                return;
            }
            _compose = false;
            await LoadMailboxAsync(keepSelection: true);
            await SelectThreadAsync(result.Value.Thread);
        }
        finally { _sending = false; }
    }

    private async Task ReplyAsync()
    {
        if (_active is null || string.IsNullOrWhiteSpace(_newMsg)) return;
        _sending = true;
        _sendError = null;
        var text = _newMsg.Trim();
        _newMsg = "";
        try
        {
            Guid? attachId = Guid.TryParse(_attachId, out var id) ? id : null;
            var request = new ParentMailboxReplyRequest(text, _attachKind, attachId, _showAppt ? _appt : null);
            var encoded = Uri.EscapeDataString(_active.ThreadId);
            var result = await Api.PostWithErrorAsync<ParentMailboxMessageDto>(
                $"api/parent/mailbox/threads/{encoded}/messages", request);
            if (result.Error is not null || result.Value is null)
            {
                _sendError = result.Error ?? L["ParentMsg_SendError"];
                _newMsg = text;
                return;
            }
            _attachKind = null;
            _attachId = "";
            _showAppt = false;
            _appt = null;
            await SelectThreadAsync(_active);
            await LoadMailboxAsync(keepSelection: true);
        }
        finally { _sending = false; }
    }

    private async Task ReportProblemAsync()
    {
        _composeChannel = "group";
        _composeReason = "complaint";
        if (_active?.StudentId is Guid sid)
            _composeChildId = sid.ToString();
        await OpenCompose();
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await ReplyAsync();
    }

    private IEnumerable<ParentMailboxMessageDto> FilteredMessages(IReadOnlyList<ParentMailboxMessageDto> messages) =>
        string.IsNullOrWhiteSpace(_threadSearch)
            ? messages
            : messages.Where(m => m.Body.Contains(_threadSearch, StringComparison.OrdinalIgnoreCase)
                                  || (m.AttachmentLabel?.Contains(_threadSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    private int CountChannel(string channel) => _threads.Count(t => t.Channel == channel);

    private string ChildColor(Guid? id)
    {
        if (id is null) return ChildPalette[0];
        var i = _children.FindIndex(c => c.Id == id.Value);
        return ChildPalette[Math.Max(0, i) % ChildPalette.Length];
    }

    private string ChannelColor(ParentMailboxThreadDto t) => t.Channel switch
    {
        "group" => "#0f766e",
        "admin" => "#4c1d95",
        _ => ChildColor(t.StudentId)
    };

    private string RoleLabel(string channel) => channel switch
    {
        "group" => L["ParentMsg_TypeGroup"],
        "admin" => L["ParentMsg_TypeAdmin"],
        _ => L["ParentMsg_TypeTeacher"]
    };

    private static string[] ReasonsFor(string channel) => channel switch
    {
        "group" => ["schedule", "replacement", "quality", "organization", "complaint"],
        "admin" => ["account", "payment", "security", "technical"],
        _ => ["lessons", "homework", "results", "progress"]
    };

    private string ReasonLabel(string reason) => L[$"ParentMsg_Reason_{reason}"];

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1 ? parts[0][..1].ToUpperInvariant() : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string FormatTime(DateTime? dt)
    {
        if (dt is null) return "";
        var local = dt.Value.Kind == DateTimeKind.Utc ? dt.Value.ToLocalTime() : dt.Value;
        if (local.Date == DateTime.Today) return local.ToString("HH:mm");
        return local.ToString("dd/MM", CultureInfo.CurrentCulture);
    }

    public void Dispose() => Realtime.MessageReceived -= OnRealtime;
}
