@page "/parent/search"
@layout ParentLayout
@rendermode InteractiveServer
@using TutorSphere.Web.Common
@inject IStringLocalizer<SharedResources> L
@inject ApiClient Api
@inject ParentProfileState ParentProfile

<PageTitle>@L["PageTitle_FindTutor"]</PageTitle>

<div class="ts-page-header">
    <div>
        <h1><i class="bi bi-binoculars me-2"></i>@L["Nav_FindTutor"]</h1>
        <p class="ts-page-subtitle">Trouvez un enseignant pour vos enfants</p>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(_viewerCountry))
{
    <div class="alert alert-info">
        <i class="bi bi-geo-alt me-2"></i>@L["Search_CountryRequired"]
    </div>
}

<div class="search-layout">
    <aside class="search-filters">
        <h2><i class="bi bi-sliders"></i> @L["Search_Filters"]</h2>
        <div class="mb-3">
            <label class="form-label">@L["Search_ViewerCountry"]</label>
            <CountrySelect Value="_viewerCountry" ValueChanged="OnViewerCountryChanged" />
            <small class="form-hint">@L["Search_ViewerCountryHint"]</small>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["Label_Subject"]</label>
            <input class="form-control" @bind="_subject" placeholder="@L["Placeholder_Subject"]" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["Label_City"]</label>
            <input class="form-control" @bind="_city" placeholder="@L["Placeholder_City"]" />
        </div>
        <div class="row g-2 mb-3">
            <div class="col-6">
                <label class="form-label">@L["Label_MinPrice"]</label>
                <input type="number" class="form-control" @bind="_minPrice" min="0" step="1" />
            </div>
            <div class="col-6">
                <label class="form-label">@L["Label_MaxPrice"]</label>
                <input type="number" class="form-control" @bind="_maxPrice" min="0" step="1" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">@L["Label_Level"]</label>
            <input class="form-control" @bind="_level" placeholder="@L["Placeholder_Level"]" />
        </div>
        <button class="btn btn-primary w-100" @onclick="SearchAsync" disabled="@(_loading || string.IsNullOrWhiteSpace(_viewerCountry))">
            @if (_loading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            @(_loading ? L["Button_Searching"] : L["Button_Search"])
        </button>
    </aside>

    <section class="search-results">
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-circle me-2"></i>@_error
            </div>
        }
        else if (_loading)
        {
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <span>@L["Search_Loading"]</span>
            </div>
        }
        else if (_results.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-search"></i></div>
                <h2 class="h5">@L["Search_NoResults_Title"]</h2>
                <p class="text-muted mb-0">@L["Search_NoResults_Description"]</p>
            </div>
        }
        else
        {
            <p class="results-count"><i class="bi bi-people me-1"></i>@L["Search_ResultsCount", _results.Count]</p>
            <div class="results-grid">
                @foreach (var tutor in _results)
                {
                    <TutorSearchCard Tutor="tutor"
                                     ProfileHref="@($"/parent/tutors/{tutor.Slug}")"
                                     ShowSubscribe="true"
                                     SubscribeHref="@($"/parent/tutors/{tutor.Slug}")" />
                }
            </div>
        }
    </section>
</div>

@code {
    private string  _subject  = "";
    private string  _city     = "";
    private string  _level    = "";
    private string? _viewerCountry;
    private decimal? _minPrice;
    private decimal? _maxPrice;
    private bool    _loading  = true;
    private string? _error;
    private List<TutorSearchResultDto> _results = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ParentProfile.EnsureLoadedAsync();
            _viewerCountry = ParentProfile.Country;
        }
        catch { }
        await SearchAsync();
    }

    private async Task OnViewerCountryChanged(string? code)
    {
        _viewerCountry = code;
        if (!string.IsNullOrWhiteSpace(code))
        {
            try
            {
                var me = await Api.GetAsync<ParentMeUpdateDto>("api/parent/me");
                if (me is not null)
                {
                    await Api.PutAsync<object>("api/parent/me", new
                    {
                        firstName = me.FirstName,
                        lastName = me.LastName,
                        email = me.Email,
                        phone = me.Phone,
                        country = code
                    });
                    await ParentProfile.EnsureLoadedAsync(forceReload: true);
                }
            }
            catch { /* filtre local même si la sauvegarde échoue */ }
        }

        await SearchAsync();
    }

    private sealed record ParentMeUpdateDto(
        string FirstName,
        string LastName,
        string Email,
        string? Phone,
        string? Country = null);

    private async Task SearchAsync()
    {
        _loading = true;
        _error   = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_viewerCountry))
            {
                _results = [];
                return;
            }

            var parts = new List<string>
            {
                $"viewerCountry={Uri.EscapeDataString(_viewerCountry.Trim())}"
            };
            if (!string.IsNullOrWhiteSpace(_subject))   parts.Add($"subject={Uri.EscapeDataString(_subject.Trim())}");
            if (!string.IsNullOrWhiteSpace(_city))      parts.Add($"city={Uri.EscapeDataString(_city.Trim())}");
            if (!string.IsNullOrWhiteSpace(_level))     parts.Add($"level={Uri.EscapeDataString(_level.Trim())}");
            if (_minPrice.HasValue)                     parts.Add($"minPrice={_minPrice.Value}");
            if (_maxPrice.HasValue)                     parts.Add($"maxPrice={_maxPrice.Value}");
            var query = "?" + string.Join("&", parts);

            var result = await Api.GetAsync<List<TutorSearchResultDto>>($"api/search/tutors{query}");
            _results = result ?? [];
        }
        catch
        {
            _error   = L["Search_Error_Load"];
            _results = [];
        }
        finally { _loading = false; }
    }
}
