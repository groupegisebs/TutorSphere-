@page "/change-password"
@layout LoginLayout
@rendermode InteractiveServer
@using Microsoft.Extensions.Localization
@inject NavigationManager Navigation
@inject AuthService AuthSvc
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["ChangePassword_Title"] — TutorSphere</PageTitle>

<div class="login-admin-page login-theme-admin">
    <div class="login-admin-inner">
        <div class="login-admin-brand">
            <img src="images/tutorsphere-logo-full.png" alt="TutorSphere" class="app-logo-full login-logo" />
        </div>
        <div class="login-admin-icon">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h1>@L["ChangePassword_Title"]</h1>
        <p class="login-subtitle">@L["ChangePassword_Subtitle"]</p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger mb-3" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@_errorMessage
            </div>
        }

        <form class="login-form w-100" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <div class="mb-3">
                <label class="form-label" for="current-password">@L["ChangePassword_Current"]</label>
                <div class="form-field-icon">
                    <i class="bi bi-lock field-icon" aria-hidden="true"></i>
                    <input type="@(_showCurrent ? "text" : "password")" id="current-password"
                           class="form-control" autocomplete="current-password"
                           @bind="_current" @bind:event="oninput"
                           style="padding-right: 2.5rem;" />
                    <button type="button" class="password-toggle" @onclick="() => _showCurrent = !_showCurrent"
                            aria-label="@L["Label_TogglePassword"]">
                        <i class="bi @(_showCurrent ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="new-password">@L["ChangePassword_New"]</label>
                <div class="form-field-icon">
                    <i class="bi bi-lock-fill field-icon" aria-hidden="true"></i>
                    <input type="@(_showNew ? "text" : "password")" id="new-password"
                           class="form-control" autocomplete="new-password"
                           @bind="_newPassword" @bind:event="oninput"
                           style="padding-right: 2.5rem;" />
                    <button type="button" class="password-toggle" @onclick="() => _showNew = !_showNew"
                            aria-label="@L["Label_TogglePassword"]">
                        <i class="bi @(_showNew ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="mb-4">
                <label class="form-label" for="confirm-password">@L["ChangePassword_Confirm"]</label>
                <div class="form-field-icon">
                    <i class="bi bi-lock-fill field-icon" aria-hidden="true"></i>
                    <input type="@(_showConfirm ? "text" : "password")" id="confirm-password"
                           class="form-control" autocomplete="new-password"
                           @bind="_confirm" @bind:event="oninput"
                           style="padding-right: 2.5rem;" />
                    <button type="button" class="password-toggle" @onclick="() => _showConfirm = !_showConfirm"
                            aria-label="@L["Label_TogglePassword"]">
                        <i class="bi @(_showConfirm ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_confirm) && _newPassword != _confirm)
                {
                    <small class="text-danger">@L["ChangePassword_Mismatch"]</small>
                }
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 mb-3 login-submit-btn" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>@L["Login_Loading"]
                }
                else
                {
                    <i class="bi bi-check-lg me-2"></i>@L["ChangePassword_Submit"]
                }
            </button>
        </form>
    </div>
</div>

@code {
    private string _current = "";
    private string _newPassword = "";
    private string _confirm = "";
    private bool _showCurrent;
    private bool _showNew;
    private bool _showConfirm;
    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try { await AuthSvc.EnsureSessionRestoredAsync(forceJs: true); } catch { }
        if (!AuthSvc.IsAuthenticated)
            Navigation.NavigateTo("/login/expert", forceLoad: true);
    }

    private async Task SubmitAsync()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_current) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _errorMessage = L["Error_FillAllFields"];
            return;
        }
        if (_newPassword != _confirm)
        {
            _errorMessage = L["ChangePassword_Mismatch"];
            return;
        }

        _isLoading = true;
        try
        {
            var (ok, error, redirect) = await AuthSvc.ChangePasswordAsync(_current, _newPassword);
            if (!ok)
            {
                _errorMessage = string.IsNullOrWhiteSpace(error) || error is "change_password_failed" or "invalid_response"
                    ? L["ChangePassword_Failed"].ToString()
                    : error;
                return;
            }
            Navigation.NavigateTo(
                AuthSvc.IsInRole("Expert")
                    ? "/expert/dashboard"
                    : (redirect ?? "/"));
        }
        catch
        {
            _errorMessage = L["ChangePassword_Failed"];
        }
        finally { _isLoading = false; }
    }
}
