@page "/legal/teacher-conduct"
@layout LoginLayout
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["TeacherConduct_Title"] — TutorSphere</PageTitle>

<div class="container py-4" style="max-width:820px">
    <p class="text-muted small mb-2">@L["TeacherConduct_VersionLabel"] @TutorSphere.Domain.Policies.TeacherConductPolicy.CurrentVersion</p>
    <h1 class="h3 mb-3">@L["TeacherConduct_Title"]</h1>
    <p class="lead">@L["TeacherConduct_Intro"]</p>
    <p class="text-muted small">@L["TeacherConduct_LegalNote"]</p>

    <article class="teacher-conduct-doc">
        <section>
            <h2>1. @L["TeacherConduct_S1_Title"]</h2>
            <p>@L["TeacherConduct_S1_Body"]</p>
        </section>
        <section>
            <h2>2. @L["TeacherConduct_S2_Title"]</h2>
            <p>@L["TeacherConduct_S2_Body"]</p>
        </section>
        <section>
            <h2>3. @L["TeacherConduct_S3_Title"]</h2>
            <p>@L["TeacherConduct_S3_Body"]</p>
        </section>
        <section>
            <h2>4. @L["TeacherConduct_S4_Title"]</h2>
            <p>@L["TeacherConduct_S4_Body"]</p>
        </section>
        <section>
            <h2>5. @L["TeacherConduct_S5_Title"]</h2>
            <p>@L["TeacherConduct_S5_Body"]</p>
        </section>
        <section>
            <h2>6. @L["TeacherConduct_S6_Title"]</h2>
            <p>@L["TeacherConduct_S6_Body"]</p>
        </section>
        <section>
            <h2>7. @L["TeacherConduct_S7_Title"]</h2>
            <p>@L["TeacherConduct_S7_Body"]</p>
        </section>
        <section>
            <h2>8. @L["TeacherConduct_S8_Title"]</h2>
            <p>@L["TeacherConduct_S8_Body"]</p>
        </section>
        <section>
            <h2>9. @L["TeacherConduct_S9_Title"]</h2>
            <p>@L["TeacherConduct_S9_Body"]</p>
        </section>
        <section>
            <h2>10. @L["TeacherConduct_S10_Title"]</h2>
            <p>@L["TeacherConduct_S10_Body"]</p>
        </section>
        <section>
            <h2>11. @L["TeacherConduct_S11_Title"]</h2>
            <p>@L["TeacherConduct_S11_Body"]</p>
        </section>
    </article>

    <div class="mt-4 d-flex gap-2 flex-wrap">
        <a class="btn btn-primary" href="/tutor/register">@L["TeacherConduct_BackRegister"]</a>
        <a class="btn btn-outline-secondary" href="/">@L["Nav_Home"]</a>
    </div>
</div>
