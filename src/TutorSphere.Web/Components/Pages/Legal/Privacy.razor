@page "/legal/privacy"
@layout LoginLayout
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Privacy_Title"] — TutorSphere</PageTitle>

<div class="expert-join-page">
    <div class="expert-join-shell" style="max-width:820px">
        <h1 class="h3 mb-3">@L["Privacy_Title"]</h1>
        <p class="lead">@L["Privacy_Intro"]</p>
        <p class="text-muted small">@L["Privacy_LegalNote"]</p>

        <article class="teacher-conduct-doc">
            <section>
                <h2>1. @L["Privacy_S1_Title"]</h2>
                <p>@L["Privacy_S1_Body"]</p>
            </section>
            <section>
                <h2>2. @L["Privacy_S2_Title"]</h2>
                <p>@L["Privacy_S2_Body"]</p>
            </section>
            <section>
                <h2>3. @L["Privacy_S3_Title"]</h2>
                <p>@L["Privacy_S3_Body"]</p>
            </section>
            <section>
                <h2>4. @L["Privacy_S4_Title"]</h2>
                <p>@L["Privacy_S4_Body"]</p>
            </section>
            <section>
                <h2>5. @L["Privacy_S5_Title"]</h2>
                <p>@L["Privacy_S5_Body"]</p>
            </section>
        </article>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary" href="/">@L["ExpertJoin_Back"]</a>
        </div>
    </div>
</div>
