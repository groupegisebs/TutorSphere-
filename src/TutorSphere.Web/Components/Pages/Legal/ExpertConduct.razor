@page "/legal/expert-conduct"
@layout LoginLayout
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["ExpertConduct_Title"] — TutorSphere</PageTitle>

<div class="expert-join-page">
    <div class="expert-join-shell" style="max-width:820px">
        <p class="text-muted small mb-2">@L["ExpertConduct_VersionLabel"] @TutorSphere.Domain.Policies.ExpertConductPolicy.CurrentVersion</p>
        <h1 class="h3 mb-3">@L["ExpertConduct_Title"]</h1>
        <p class="lead">@L["ExpertConduct_Intro"]</p>
        <p class="text-muted small">@L["ExpertConduct_LegalNote"]</p>

        <article class="teacher-conduct-doc">
            <section>
                <h2>1. @L["ExpertConduct_S1_Title"]</h2>
                <p>@L["ExpertConduct_S1_Body"]</p>
            </section>
            <section>
                <h2>2. @L["ExpertConduct_S2_Title"]</h2>
                <p>@L["ExpertConduct_S2_Body"]</p>
            </section>
            <section>
                <h2>3. @L["ExpertConduct_S3_Title"]</h2>
                <p>@L["ExpertConduct_S3_Body"]</p>
            </section>
            <section>
                <h2>4. @L["ExpertConduct_S4_Title"]</h2>
                <p>@L["ExpertConduct_S4_Body"]</p>
            </section>
            <section>
                <h2>5. @L["ExpertConduct_S5_Title"]</h2>
                <p>@L["ExpertConduct_S5_Body"]</p>
            </section>
            <section>
                <h2>6. @L["ExpertConduct_S6_Title"]</h2>
                <p>@L["ExpertConduct_S6_Body"]</p>
            </section>
            <section>
                <h2>7. @L["ExpertConduct_S7_Title"]</h2>
                <p>@L["ExpertConduct_S7_Body"]</p>
            </section>
            <section>
                <h2>8. @L["ExpertConduct_S8_Title"]</h2>
                <p>@L["ExpertConduct_S8_Body"]</p>
            </section>
        </article>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary" href="/">@L["ExpertJoin_Back"]</a>
        </div>
    </div>
</div>
