@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Localization
@using TutorSphere.Application.Common
@using TutorSphere.Web.Services
@inject IHttpContextAccessor HttpContextAccessor
@{
    var culture = CultureRequestHelper.Resolve(HttpContextAccessor.HttpContext);
    var lang = culture.Name;
    var dir = culture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}

<!DOCTYPE html>
<html lang="@lang" dir="@dir">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#5831E0" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TutorSphere" />
    <meta name="application-name" content="TutorSphere" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="manifest.webmanifest" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/parent-dashboard.css"]" />
    <link rel="stylesheet" href="@Assets["css/expert-space.css"]" />
    <link rel="stylesheet" href="@Assets["css/meeting-room.css"]" />
    @if (dir == "rtl")
    {
        <link rel="stylesheet" href="@Assets["css/rtl.css"]" />
    }
    <link rel="stylesheet" href="@Assets["TutorSphere.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="icons/icon-192.png" sizes="192x192" />
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <AuthSessionRestorer />
        <Routes />
        <PwaInstallBanner />
    </CascadingAuthenticationState>

    @* Blazor toggles classes on this dialog (components-reconnect-show|failed|rejected). *@
    <div id="components-reconnect-modal" class="ts-reconnect-modal">
        <div class="ts-reconnect-card ts-reconnect-show">
            <div class="spinner-border text-primary mb-3" role="status" aria-hidden="true"></div>
            <p class="mb-0">Connexion interrompue — reconnexion…</p>
        </div>
        <div class="ts-reconnect-card ts-reconnect-failed">
            <p class="mb-3">Impossible de rétablir la connexion (réseau mobile instable).</p>
            <button type="button" class="btn btn-primary" onclick="location.reload()">Actualiser</button>
        </div>
        <div class="ts-reconnect-card ts-reconnect-rejected">
            <p class="mb-3">Session expirée sur le serveur.</p>
            <button type="button" class="btn btn-primary" onclick="location.reload()">Recharger</button>
        </div>
    </div>

    @* auth-storage must load before Blazor so login can persist the JWT immediately *@
    <script src="js/auth-storage.js"></script>
    <script src="js/page-assets.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="js/culture.js"></script>
    <script src="js/file-download.js"></script>
    <script src="js/pwa-install.js"></script>
    <script>
        Blazor.start({
            circuit: {
                reconnectionOptions: {
                    maxRetries: 16,
                    retryIntervalMilliseconds: 2000,
                    dialogId: 'components-reconnect-modal'
                }
            }
        });
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        // Persist the resolved request culture so InteractiveServer circuits
        // (WebSocket) receive the same cookie as the initial SSR document.
        var ctx = HttpContext ?? HttpContextAccessor.HttpContext;
        if (ctx is null || ctx.Response.HasStarted)
            return;

        var culture = CultureRequestHelper.Resolve(ctx);
        ctx.Response.Cookies.Append(
            CookieRequestCultureProvider.DefaultCookieName,
            CookieRequestCultureProvider.MakeCookieValue(new RequestCulture(culture, culture)),
            new CookieOptions
            {
                Expires = DateTimeOffset.UtcNow.AddYears(1),
                IsEssential = true,
                Path = "/",
                SameSite = SameSiteMode.Lax,
                Secure = ctx.Request.IsHttps
            });
    }
}
