@using TutorSphere.Application.DTOs.Search
@inject IStringLocalizer<SharedResources> L
@inject IConfiguration Config
@inject NavigationManager Navigation

<article class="tutor-card tutor-card--directory" style="@CardTheme">
    <div class="tutor-card-banner @(string.IsNullOrWhiteSpace(BannerUrl) ? "tutor-card-banner--fallback" : null)"
         style="@BannerStyle">
        @if (Tutor.Rating.HasValue)
        {
            <div class="tutor-rating-badge" title="@L["Search_Satisfaction", Tutor.Rating.Value.ToString("0")]">
                <i class="bi bi-star-fill" aria-hidden="true"></i>
                <span>@Tutor.Rating.Value.ToString("0.0")</span>
                @if (Tutor.ReviewCount > 0)
                {
                    <span class="tutor-rating-count">(@Tutor.ReviewCount)</span>
                }
            </div>
        }
    </div>

    <div class="tutor-card-identity">
        @if (!string.IsNullOrWhiteSpace(PhotoUrl))
        {
            <div class="tutor-avatar-wrap">
                <img class="tutor-avatar tutor-avatar-photo @(Tutor.PhotoIsGroupLogoFallback ? "tutor-avatar--group-fallback" : null)"
                     src="@PhotoUrl" alt="@Tutor.Name" />
                @if (Tutor.PhotoIsGroupLogoFallback)
                {
                    <span class="tutor-photo-fallback-label">@L["Search_GroupLogoFallback"]</span>
                }
            </div>
        }
        else
        {
            <div class="tutor-avatar" aria-hidden="true">@(Tutor.PublicInitials ?? GetInitials(Tutor.Name))</div>
        }
        <div class="tutor-card-header">
            <div class="tutor-card-group">
                @if (!string.IsNullOrWhiteSpace(GroupLogoUrl))
                {
                    <img class="tutor-card-group-logo" src="@GroupLogoUrl" alt="" />
                }
                @if (!string.IsNullOrWhiteSpace(Tutor.ExpertGroupName))
                {
                    <span>@Tutor.ExpertGroupName</span>
                }
            </div>
            <h3>@Tutor.Name</h3>
            @if (!string.IsNullOrWhiteSpace(Location))
            {
                <span class="tutor-location">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                    @Location
                </span>
            }
        </div>
    </div>

    <div class="tutor-tags tutor-tags--primary">
        @foreach (var subject in Tutor.Subjects.Take(3))
        {
            <span class="tutor-pill">@subject</span>
        }
        @foreach (var level in (Tutor.Levels ?? []).Take(2))
        {
            <span class="tutor-level-chip">@level</span>
        }
        @foreach (var lang in Langs)
        {
            <span class="tutor-pill tutor-pill--soft">@lang</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Tutor.OfferTitle) || !string.IsNullOrWhiteSpace(Tutor.Description))
    {
        <div class="tutor-card-offer">
            @if (!string.IsNullOrWhiteSpace(Tutor.OfferTitle))
            {
                <h4>@Tutor.OfferTitle</h4>
            }
            @if (!string.IsNullOrWhiteSpace(Tutor.Description))
            {
                <p>@Tutor.Description</p>
            }
            <div class="tutor-card-offer-meta">
                @if (Tutor.SessionDurationMin is > 0)
                {
                    <span><i class="bi bi-clock" aria-hidden="true"></i> @FormatDurationLabel()</span>
                }
                @if (!string.IsNullOrWhiteSpace(Tutor.OfferMode) || Tutor.Modes.Count > 0)
                {
                    <span><i class="bi bi-laptop" aria-hidden="true"></i> @(Tutor.OfferMode ?? Tutor.Modes[0])</span>
                }
            </div>
        </div>
    }

    @if (Tutor.MinPrice.HasValue)
    {
        <p class="tutor-price">
            <strong>@FormatPrice()</strong>
            <span>@Tutor.Currency / h</span>
        </p>
    }

    <div class="tutor-card-footer tutor-card-footer--row">
        <a class="btn btn-outline-primary btn-sm" href="@ProfileHref">
            @L["Button_ViewProfile"]
        </a>
        @if (ShowSubscribe)
        {
            <a class="btn btn-primary btn-sm" href="@(SubscribeHref ?? ProfileHref)">
                @L["PublicProfile_ChooseOffer"]
            </a>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public TutorSearchResultDto Tutor { get; set; } = default!;
    [Parameter, EditorRequired] public string ProfileHref { get; set; } = "";
    [Parameter] public bool ShowSubscribe { get; set; }
    [Parameter] public string? SubscribeHref { get; set; }

    private string PhotoUrl => MediaUrlHelper.Resolve(Tutor.PhotoUrl, Config, Navigation);
    private string BannerUrl => MediaUrlHelper.Resolve(Tutor.ExpertGroupBannerUrl, Config, Navigation);
    private string GroupLogoUrl => MediaUrlHelper.Resolve(Tutor.ExpertGroupLogoUrl, Config, Navigation);
    private string? Location => FormatLocation(Tutor.City, Tutor.Country);

    private string CardTheme
    {
        get
        {
            var p = string.IsNullOrWhiteSpace(Tutor.ExpertGroupPrimaryColor) ? "#5831E0" : Tutor.ExpertGroupPrimaryColor;
            var s = string.IsNullOrWhiteSpace(Tutor.ExpertGroupSecondaryColor) ? "#4419c8" : Tutor.ExpertGroupSecondaryColor;
            return $"--tutor-group-primary:{p};--tutor-group-secondary:{s};";
        }
    }

    private string? BannerStyle => string.IsNullOrWhiteSpace(BannerUrl)
        ? null
        : $"background-image:url('{BannerUrl.Replace("'", "%27")}')";

    private IReadOnlyList<string> Langs =>
        (Tutor.Languages is { Count: > 0 } ? Tutor.Languages : [Tutor.Language])
        .Where(l => !string.IsNullOrWhiteSpace(l))
        .Select(FormatLanguage)
        .Distinct()
        .ToList();

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}"
            : parts[0][0].ToString().ToUpperInvariant();
    }

    private static string? FormatLocation(string? city, string? country)
    {
        if (!string.IsNullOrWhiteSpace(city) && !string.IsNullOrWhiteSpace(country))
            return $"{city}, {country}";
        return string.IsNullOrWhiteSpace(city) ? country : city;
    }

    private string FormatDurationLabel()
    {
        var hours = Tutor.SessionDurationMin!.Value / 60.0;
        var label = hours % 1 == 0 ? hours.ToString("0") : hours.ToString("0.#");
        return L["Search_HoursPerSession", label];
    }

    private string FormatPrice()
    {
        var amount = Tutor.MinPrice!.Value.ToString("0.##");
        if (Tutor.MaxPrice.HasValue && Tutor.MaxPrice != Tutor.MinPrice)
            return $"{amount}–{Tutor.MaxPrice.Value.ToString("0.##")}";
        return amount;
    }

    private string FormatLanguage(string language) => language.Trim().ToLowerInvariant() switch
    {
        "fr" or "français" or "francais" or "french" => L["Lang_French"],
        "en" or "anglais" or "english" => L["Lang_English"],
        "es" or "espagnol" or "spanish" => L["Lang_Spanish"],
        "de" or "allemand" or "german" => L["Lang_German"],
        "pt" or "portugais" or "portuguese" => L["Lang_Portuguese"],
        "zh" or "zh-hans" or "mandarin" => L["Lang_Mandarin"],
        "ar" or "arabe" or "arabic" => L["Lang_Arabic"],
        _ => language
    };
}
