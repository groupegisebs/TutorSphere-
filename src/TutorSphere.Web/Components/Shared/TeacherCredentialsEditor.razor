@inject IStringLocalizer<SharedResources> L

<div class="teacher-creds">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">@L["Profile_YearsExp"]</label>
            <input class="form-control" type="number" min="0" max="70" @bind="YearsExperience" @bind:after="OnYearsChangedAsync" />
        </div>
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0">@L["Profile_Diplomas"]</label>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddDiploma">
                    <i class="bi bi-plus me-1"></i>@L["Common_Add"]
                </button>
            </div>
            @if (Diplomas.Count == 0)
            {
                <p class="form-text mb-0">@L["Profile_NoDiplomas"]</p>
            }
            @foreach (var row in Diplomas)
            {
                <div class="teacher-creds-row">
                    <input class="form-control" @bind="row.Title" @bind:event="oninput" @bind:after="NotifyChanged" placeholder="@L["Profile_TitleLabel"]" />
                    <input class="form-control" @bind="row.Institution" @bind:event="oninput" @bind:after="NotifyChanged" placeholder="@L["Profile_Institution"]" />
                    <input class="form-control teacher-creds-year" @bind="row.Year" @bind:event="oninput" @bind:after="NotifyChanged" placeholder="@L["Profile_Year"]" />
                    <button type="button" class="btn btn-outline-danger" title="@L["Common_Delete"]"
                            @onclick="() => RemoveDiploma(row)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            }
        </div>
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label mb-0">@L["Profile_Certifications"]</label>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddCert">
                    <i class="bi bi-plus me-1"></i>@L["Common_Add"]
                </button>
            </div>
            @if (Certifications.Count == 0)
            {
                <p class="form-text mb-0">@L["Profile_NoCerts"]</p>
            }
            @foreach (var row in Certifications)
            {
                <div class="teacher-creds-row">
                    <input class="form-control" @bind="row.Title" @bind:event="oninput" @bind:after="NotifyChanged" placeholder="@L["Profile_TitleLabel"]" />
                    <input class="form-control" @bind="row.Institution" @bind:event="oninput" @bind:after="NotifyChanged" placeholder="@L["Profile_Organization"]" />
                    <input class="form-control teacher-creds-year" @bind="row.Year" @bind:event="oninput" @bind:after="NotifyChanged" placeholder="@L["Profile_Year"]" />
                    <button type="button" class="btn btn-outline-danger" title="@L["Common_Delete"]"
                            @onclick="() => RemoveCert(row)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int YearsExperience { get; set; }
    [Parameter] public EventCallback<int> YearsExperienceChanged { get; set; }
    [Parameter] public List<TeacherCredentialDraft> Diplomas { get; set; } = [];
    [Parameter] public List<TeacherCredentialDraft> Certifications { get; set; } = [];
    [Parameter] public EventCallback Changed { get; set; }

    private async Task OnYearsChangedAsync()
    {
        await YearsExperienceChanged.InvokeAsync(YearsExperience);
        await NotifyChanged();
    }

    private Task NotifyChanged() => Changed.HasDelegate ? Changed.InvokeAsync() : Task.CompletedTask;

    private async Task AddDiploma()
    {
        Diplomas.Add(new TeacherCredentialDraft());
        await NotifyChanged();
    }

    private async Task RemoveDiploma(TeacherCredentialDraft row)
    {
        Diplomas.Remove(row);
        await NotifyChanged();
    }

    private async Task AddCert()
    {
        Certifications.Add(new TeacherCredentialDraft());
        await NotifyChanged();
    }

    private async Task RemoveCert(TeacherCredentialDraft row)
    {
        Certifications.Remove(row);
        await NotifyChanged();
    }
}
