@inject IStringLocalizer<SharedResources> L
@inject ApiClient Api
@inject IJSRuntime JS

@if (Visible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg pay-checkout-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">@L["PayMethod_Title"]</h5>
                        <p class="pay-checkout-secure mb-0">
                            <i class="bi bi-shield-check" aria-hidden="true"></i>
                            @L["PayMethod_SecureBy"]
                        </p>
                    </div>
                    <button type="button" class="btn-close" disabled="@_busy" @onclick="CloseAsync" aria-label="@L["PayMethod_Cancel"]"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_error) && _phase != Phase.Failed)
                    {
                        <div class="alert alert-danger py-2">@_error</div>
                    }

                    @if (_phase == Phase.Waiting)
                    {
                        <div class="alert alert-info" role="status" aria-live="polite">
                            <div class="d-flex align-items-start gap-2">
                                <span class="spinner-border spinner-border-sm mt-1" aria-hidden="true"></span>
                                <div>
                                    <p class="mb-1">@(_instruction ?? L["PayMethod_MmInstruction"])</p>
                                    @if (!string.IsNullOrWhiteSpace(_ussdHint))
                                    {
                                        <p class="small mb-0 text-muted">USSD : @_ussdHint</p>
                                    }
                                    <p class="small mb-0 mt-2 text-muted">@L["PayMethod_MmNeverSharePin"]</p>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_phase == Phase.Success)
                    {
                        <div class="alert alert-success" role="status">
                            @L["PayMethod_MmSuccess"]
                        </div>
                    }
                    else if (_phase == Phase.Failed)
                    {
                        <div class="alert alert-warning" role="status">
                            @(_error ?? L["PayMethod_MmFailed"])
                        </div>
                    }
                    else
                    {
                        <div class="pay-checkout-grid">
                            <div>
                                @if (IsPlatformLicense)
                                {
                                    <div class="mb-3">
                                        <label class="form-label" for="pay-promo">@L["Activate_PromoLabel"]</label>
                                        <div class="input-group">
                                            <input id="pay-promo" class="form-control font-monospace text-uppercase"
                                                   placeholder="@L["Activate_PromoPlaceholder"]"
                                                   disabled="@_busy"
                                                   @bind="_promoCode" @bind:event="oninput" />
                                            <button type="button" class="btn btn-outline-primary"
                                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_promoCode))"
                                                    @onclick="RedeemPromoAsync">
                                                @L["Activate_PromoCta"]
                                            </button>
                                        </div>
                                        <div class="form-text">@L["Activate_PromoHint"]</div>
                                    </div>
                                    <div class="form-check pay-autorenew mb-3">
                                        <input class="form-check-input" type="checkbox" id="pay-autorenew-promo"
                                               disabled="@_busy"
                                               @bind="_autoRenewAtSource" />
                                        <label class="form-check-label" for="pay-autorenew-promo">
                                            @L["Activate_AutoRenewLabel"]
                                            <i class="bi bi-info-circle ms-1" title="@L["Activate_AutoRenewHint"]"></i>
                                        </label>
                                    </div>
                                    <p class="small text-muted text-center">— @L["PayMethod_OrPayNow"] —</p>
                                }

                                <div class="pay-method-list mb-3" role="radiogroup" aria-label="@L["PayMethod_Title"]">
                                    <button type="button"
                                            class="pay-method-option @FamilyClass("card")"
                                            disabled="@_busy"
                                            role="radio"
                                            aria-checked="@(_family == "card" ? "true" : "false")"
                                            @onclick='() => SelectFamilyAsync("card")'>
                                        <span class="pay-method-radio" aria-hidden="true"></span>
                                        <span class="pay-method-icon pay-method-icon--card" aria-hidden="true">@CardIcon</span>
                                        <span class="pay-method-label">@L["PayMethod_Card"]</span>
                                        <span class="pay-method-brands" aria-hidden="true">
                                            <span class="pay-method-brand">Visa</span>
                                            <span class="pay-method-brand">Mastercard</span>
                                            <span class="pay-method-brand">Amex</span>
                                        </span>
                                    </button>
                                    <button type="button"
                                            class="pay-method-option @FamilyClass("paypal")"
                                            disabled="@_busy"
                                            role="radio"
                                            aria-checked="@(_family == "paypal" ? "true" : "false")"
                                            @onclick='() => SelectFamilyAsync("paypal")'>
                                        <span class="pay-method-radio" aria-hidden="true"></span>
                                        <span class="pay-method-icon pay-method-icon--paypal" aria-hidden="true">@PayPalIcon</span>
                                        <span class="pay-method-label">@L["PayMethod_PayPal"]</span>
                                    </button>
                                    @if (ShowMobileMoney)
                                    {
                                        <div class="@(_family == "momo" ? "pay-method-block is-selected" : "")">
                                            <button type="button"
                                                    class="pay-method-option @FamilyClass("momo")"
                                                    disabled="@_busy"
                                                    role="radio"
                                                    aria-checked="@(_family == "momo" ? "true" : "false")"
                                                    @onclick='() => SelectFamilyAsync("momo")'>
                                                <span class="pay-method-radio" aria-hidden="true"></span>
                                                <span class="pay-method-icon pay-method-icon--momo" aria-hidden="true">@OrangeIcon</span>
                                                <span class="pay-method-label">@L["PayMethod_MobileMoney"]</span>
                                                <span class="pay-method-brands" aria-hidden="true">
                                                    <span class="pay-method-brand">OM</span>
                                                    <span class="pay-method-brand">MTN</span>
                                                    <span class="pay-method-brand">Airtel</span>
                                                    <span class="pay-method-brand">Wave</span>
                                                </span>
                                            </button>
                                            @if (_family == "momo")
                                            {
                                                <div class="pay-momo-panel">
                                                    <div class="mb-2">
                                                        <label class="form-label" for="mm-country">@L["PayMethod_Country"]</label>
                                                        <select id="mm-country"
                                                                class="form-select"
                                                                disabled="@_busy"
                                                                @bind="_billingCountry"
                                                                @bind:after="OnBillingCountryChangedAsync">
                                                            @if (_africaRates.Count == 0)
                                                            {
                                                                <option value="CM">Cameroun</option>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var rate in _africaRates)
                                                                {
                                                                    <option value="@rate.CountryCode">@rate.CountryName</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label" for="mm-operator">@L["PayMethod_Operator"]</label>
                                                        <select id="mm-operator"
                                                                class="form-select"
                                                                disabled="@_busy"
                                                                @bind="_momoOperator"
                                                                @bind:after="OnOperatorChanged">
                                                            <option value="@PaymentMethodCodes.OrangeMoney">Orange Money</option>
                                                            <option value="@PaymentMethodCodes.MtnMomo">MTN MoMo</option>
                                                            <option value="airtel">Airtel Money</option>
                                                            <option value="wave">Wave</option>
                                                        </select>
                                                    </div>
                                                    <div class="mb-0">
                                                        <label class="form-label" for="mm-phone">@L["PayMethod_PhoneLabel"]</label>
                                                        <div class="input-group">
                                                            <span class="input-group-text">@_dialCode</span>
                                                            <input id="mm-phone"
                                                                   class="form-control"
                                                                   type="tel"
                                                                   inputmode="numeric"
                                                                   maxlength="9"
                                                                   placeholder="6 .. .. .. .."
                                                                   disabled="@_busy"
                                                                   @bind="_phoneLocal"
                                                                   @bind:event="oninput" />
                                                        </div>
                                                        <div class="form-text">@L["PayMethod_MmConfirmHint"]</div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (IsPlatformLicense)
                                {
                                    <div class="form-check pay-autorenew">
                                        <input class="form-check-input" type="checkbox" id="pay-autorenew-method"
                                               disabled="@_busy"
                                               @bind="_autoRenewAtSource" />
                                        <label class="form-check-label" for="pay-autorenew-method">
                                            @L["PayMethod_AutoRenew"]
                                            <i class="bi bi-info-circle ms-1" title="@L["PayMethod_AutoRenewHint"]"></i>
                                        </label>
                                    </div>
                                }
                            </div>

                            <aside class="pay-summary-card">
                                <h6>@L["PayMethod_Summary"]</h6>
                                <div class="pay-summary-row">
                                    <span>@SummaryProduct</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(PayerName))
                                {
                                    <div class="pay-summary-row text-muted"><span>@PayerName</span></div>
                                }
                                @if (IsPlatformLicense)
                                {
                                    <div class="pay-summary-row text-muted"><span>@L["PayMethod_Duration12"]</span></div>
                                }
                                <div class="pay-summary-row">
                                    <span>@L["PayMethod_Subtotal"]</span>
                                    <span>@FormatMoney(AmountExclusive)</span>
                                </div>
                                <div class="pay-summary-row">
                                    <span>@L["PayMethod_Taxes"]</span>
                                    <span>@FormatMoney(TaxAmount)</span>
                                </div>
                                <div class="pay-summary-row pay-summary-total">
                                    <span>@L["PayMethod_TotalToday"]</span>
                                    <span>@FormatMoney(AmountInclusive)</span>
                                </div>
                                @if (ShowFxEstimate)
                                {
                                    <div class="pay-summary-fx">
                                        @L["PayMethod_EstimatedDebit", EstimatedFcfa.ToString("N0")]
                                    </div>
                                }
                                @if (IsPlatformLicense)
                                {
                                    <p class="pay-summary-renew mb-0">
                                        <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>
                                        @L["PayMethod_NextRenewal", NextRenewalLabel, FormatMoney(Amount)]
                                        <span class="d-block mt-1">@L["PayMethod_NextRenewalNote"]</span>
                                    </p>
                                }
                            </aside>
                        </div>

                        <div class="pay-checkout-banner">
                            <span>@L["PayMethod_SecurityBanner"]</span>
                            <span class="badges">
                                <span>@L["PayMethod_Ssl"]</span>
                                <span>GiseBsPayGateway</span>
                            </span>
                        </div>
                    }
                </div>
                <div class="modal-footer justify-content-between">
                    <span class="small text-muted">@L["PayMethod_FooterHint"]</span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-link text-decoration-none" disabled="@_busy" @onclick="CloseAsync">
                            @L["PayMethod_Cancel"]
                        </button>

                        @if (_phase == Phase.Waiting)
                        {
                            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="VerifyAsync">
                                @if (_busy)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                @L["PayMethod_Verify"]
                            </button>
                        }
                        else if (_phase == Phase.Failed)
                        {
                            <button type="button" class="btn btn-outline-primary" disabled="@_busy" @onclick="RetryAsync">
                                @L["PayMethod_Retry"]
                            </button>
                        }
                        else if (_phase == Phase.Select)
                        {
                            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="PayAsync">
                                @if (_busy)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                @ContinueLabel
                                <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private enum Phase { Select, Waiting, Success, Failed }
    private const decimal UsdToXafDisplay = 610m;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public Guid? SubscriptionId { get; set; }
    [Parameter] public bool IsPlatformLicense { get; set; }
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public string Currency { get; set; } = "CAD";
    [Parameter] public string SuccessUrl { get; set; } = "";
    [Parameter] public string CancelUrl { get; set; } = "";
    [Parameter] public string? PayerName { get; set; }
    [Parameter] public string? ProductTitle { get; set; }
    [Parameter] public EventCallback OnPaid { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private string _family = "card";
    private string _method = PaymentMethodCodes.Card;
    private string _momoOperator = PaymentMethodCodes.OrangeMoney;
    private bool _busy;
    private bool _autoRenewAtSource;
    private string? _error;
    private Phase _phase = Phase.Select;
    private string _phoneLocal = "";
    private string _promoCode = "";
    private Guid? _paymentId;
    private string? _instruction;
    private string? _ussdHint;
    private string _idempotencyKey = Guid.NewGuid().ToString("N");
    private string _billingCountry = "CM";
    private string _dialCode = "+237";
    private TaxQuoteVm? _taxQuote;
    private List<AfricaRateVm> _africaRates = [];

    private bool ShowMobileMoney =>
        IsPlatformLicense
        || (SubscriptionId.HasValue && Currency.Equals("XAF", StringComparison.OrdinalIgnoreCase));

    private bool ShowFxEstimate =>
        IsPlatformLicense && Currency.Equals("USD", StringComparison.OrdinalIgnoreCase);

    private string SummaryProduct =>
        !string.IsNullOrWhiteSpace(ProductTitle)
            ? ProductTitle
            : IsPlatformLicense ? L["PayMethod_LicenseProduct"] : L["PayMethod_SubscriptionProduct"];

    private decimal AmountExclusive => _taxQuote?.AmountExclusive ?? Amount;
    private decimal TaxAmount => _taxQuote?.TaxAmount ?? 0m;
    private decimal AmountInclusive => _taxQuote?.AmountInclusive ?? Amount;
    private decimal EstimatedFcfa => Math.Round(Amount * UsdToXafDisplay, 0, MidpointRounding.AwayFromZero);
    private string NextRenewalLabel => DateTime.Today.AddYears(1).ToString("d MMMM yyyy");

    private string ContinueLabel => _family switch
    {
        "paypal" => L["PayMethod_ContinuePayPal"],
        "momo" => L["PayMethod_ContinueMomo"],
        _ => L["PayMethod_ContinueCard"]
    };

    private string FamilyClass(string family) =>
        _family == family ? "is-selected" : "";

    private string FormatMoney(decimal amount)
    {
        if (Currency.Equals("USD", StringComparison.OrdinalIgnoreCase))
            return $"{amount:N2} $ US";
        if (Currency.Equals("XAF", StringComparison.OrdinalIgnoreCase))
            return $"{amount:N0} {Currency}";
        return $"{amount:N2} {Currency}";
    }

    private async Task SelectFamilyAsync(string family)
    {
        _family = family;
        _error = null;
        if (family == "card")
        {
            _method = PaymentMethodCodes.Card;
            _taxQuote = null;
            return;
        }
        if (family == "paypal")
        {
            _method = PaymentMethodCodes.PayPal;
            _taxQuote = null;
            return;
        }

        ApplyOperatorToMethod();
        await EnsureAfricaRatesAsync();
        await RefreshTaxQuoteAsync();
    }

    private void OnOperatorChanged()
    {
        ApplyOperatorToMethod();
    }

    private void ApplyOperatorToMethod()
    {
        _method = _momoOperator is PaymentMethodCodes.OrangeMoney or PaymentMethodCodes.MtnMomo
            ? _momoOperator
            : PaymentMethodCodes.OrangeMoney;
    }

    private static string DialCodeFor(string countryCode) =>
        countryCode.ToUpperInvariant() switch
        {
            "CI" => "+225",
            "SN" => "+221",
            "BF" => "+226",
            "ML" => "+223",
            "NE" => "+227",
            "TG" => "+228",
            "BJ" => "+229",
            "GN" => "+224",
            "GA" => "+241",
            "CG" => "+242",
            "CD" => "+243",
            _ => "+237"
        };

    private async Task OnBillingCountryChangedAsync()
    {
        _dialCode = DialCodeFor(_billingCountry);
        if (_family == "momo")
            await RefreshTaxQuoteAsync();
    }

    private async Task EnsureAfricaRatesAsync()
    {
        if (_africaRates.Count > 0)
            return;
        try
        {
            var result = await Api.GetWithErrorAsync<List<AfricaRateVm>>("api/payments/tax/africa/rates");
            if (result.Value is { Count: > 0 } rates)
                _africaRates = rates;
        }
        catch
        {
            // Fallback : option Cameroun seule
        }
    }

    private async Task RefreshTaxQuoteAsync()
    {
        try
        {
            var url =
                $"api/payments/tax/africa/quote?amountExclusive={Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)}&currency={Uri.EscapeDataString(Currency)}&countryCode={Uri.EscapeDataString(_billingCountry)}";
            var result = await Api.GetWithErrorAsync<TaxQuoteVm>(url);
            _taxQuote = result.Value;
        }
        catch
        {
            _taxQuote = null;
        }
    }

    private static readonly MarkupString CardIcon = new(
        """
        <svg viewBox="0 0 40 28" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <rect x="1" y="1" width="38" height="26" rx="4" fill="#1e3a5f"/>
          <rect x="1" y="7" width="38" height="6" fill="#0f2744"/>
          <rect x="5" y="18" width="12" height="3.5" rx="1" fill="#f4d35e"/>
          <rect x="20" y="18" width="7" height="3.5" rx="1" fill="#94a3b8"/>
          <circle cx="31.5" cy="19.5" r="3.2" fill="#eb001b"/>
          <circle cx="35" cy="19.5" r="3.2" fill="#f79e1b" fill-opacity=".9"/>
        </svg>
        """);

    private static readonly MarkupString PayPalIcon = new(
        """
        <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <path fill="#003087" d="M14.2 30.2 15.6 21c.1-.5.5-.8 1-.8h4.6c4.7 0 8.1-1.9 9.1-6.1.1-.4.2-.8.2-1.2 0-.2 0-.4-.1-.6H21.2c-.6 0-1.1.4-1.2 1l-1.8 11.4c-.1.5-.5.8-1 .8h-3z"/>
          <path fill="#009cde" d="M29.4 12.3c-.8 3.9-3.7 5.9-8.1 5.9h-2.3c-.6 0-1.1.4-1.2 1L16.2 28c-.1.4.2.8.6.8h3c.5 0 .9-.3 1-.8l.7-4.3.1-.4c.1-.5.5-.8 1-.8h.6c4.1 0 7.3-1.7 8.2-6.5.4-2 .2-3.7-.8-4.9-.4-.5-.9-.8-1.2-.8z"/>
          <path fill="#012169" d="M12.8 8.4c.1-.5.5-.8 1-.8h8.7c1.1 0 2.1.1 2.9.3.3.1.6.2.9.3-.3-.2-.5-.3-.9-.3C23.6 7.7 22.6 7.6 21.5 7.6h-8.7c-.6 0-1.1.4-1.2 1L9.2 28.2c-.1.4.2.8.6.8h3.2l.8-5.2 1-6.4z"/>
        </svg>
        """);

    private static readonly MarkupString OrangeIcon = new(
        """
        <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <circle cx="20" cy="20" r="16" fill="#ff7900"/>
          <text x="20" y="25" text-anchor="middle" fill="#fff" font-size="12" font-weight="700">OM</text>
        </svg>
        """);

    private async Task CloseAsync()
    {
        if (_busy) return;
        ResetForm();
        await VisibleChanged.InvokeAsync(false);
    }

    private void ResetForm()
    {
        _family = "card";
        _method = PaymentMethodCodes.Card;
        _momoOperator = PaymentMethodCodes.OrangeMoney;
        _error = null;
        _busy = false;
        _autoRenewAtSource = false;
        _phase = Phase.Select;
        _phoneLocal = "";
        _promoCode = "";
        _paymentId = null;
        _instruction = null;
        _ussdHint = null;
        _idempotencyKey = Guid.NewGuid().ToString("N");
        _taxQuote = null;
        _dialCode = "+237";
        _billingCountry = "CM";
    }

    private async Task RedeemPromoAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_promoCode))
        {
            _error = L["Activate_PromoRequired"];
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.PostWithErrorAsync<CheckoutVm>("api/platform-billing/redeem-promo", new
            {
                code = _promoCode.Trim(),
                autoRenewAtSource = _autoRenewAtSource
            });
            if (result.Value is null)
            {
                _error = result.Error ?? L["Activate_PromoInvalid"];
                await OnError.InvokeAsync(_error);
                return;
            }

            await OnPaid.InvokeAsync();
            if (!string.IsNullOrWhiteSpace(SuccessUrl))
                await JS.InvokeVoidAsync("open", SuccessUrl, "_self");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task RetryAsync()
    {
        _phase = Phase.Select;
        _error = null;
        _paymentId = null;
        _instruction = null;
        _ussdHint = null;
        _idempotencyKey = Guid.NewGuid().ToString("N");
        return Task.CompletedTask;
    }

    private async Task PayAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_method))
        {
            _error = L["PayMethod_SelectRequired"];
            return;
        }

        if (_family == "momo")
        {
            if (IsPlatformLicense)
            {
                _error = L["PayMethod_LicenseMmHint"];
                return;
            }

            if (_momoOperator is "airtel" or "wave")
            {
                _error = L["PayMethod_OperatorUnavailable"];
                return;
            }

            await PayMobileMoneyAsync();
            return;
        }

        _busy = true;
        try
        {
            if (IsPlatformLicense)
            {
                var result = await Api.PostWithErrorAsync<CheckoutVm>("api/platform-billing/checkout", new
                {
                    successUrl = SuccessUrl,
                    cancelUrl = CancelUrl,
                    paymentMethod = _method,
                    autoRenewAtSource = _autoRenewAtSource
                });
                await HandleCheckoutResultAsync(result.Value, result.Error);
            }
            else if (SubscriptionId.HasValue)
            {
                var result = await Api.PostWithErrorAsync<CheckoutVm>(
                    $"api/payments/subscriptions/{SubscriptionId}/checkout",
                    new
                    {
                        successUrl = SuccessUrl,
                        cancelUrl = CancelUrl,
                        paymentMethod = _method
                    });
                await HandleCheckoutResultAsync(result.Value, result.Error);
            }
            else
            {
                _error = L["PayMethod_PayUnavailable"];
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PayMobileMoneyAsync()
    {
        if (!SubscriptionId.HasValue)
        {
            _error = L["PayMethod_PayUnavailable"];
            return;
        }

        var digits = new string((_phoneLocal ?? "").Where(char.IsDigit).ToArray());
        var isMtn = _method == PaymentMethodCodes.MtnMomo;
        if (isMtn && (digits.Length != 9 || digits[0] != '6'))
        {
            _error = L["PayMethod_PhoneInvalid"];
            return;
        }

        _busy = true;
        try
        {
            var body = new
            {
                subscriptionId = SubscriptionId.Value,
                channel = _method,
                phoneNumber = isMtn ? _dialCode + digits : null,
                idempotencyKey = _idempotencyKey,
                billingCountryCode = _billingCountry,
                returnUrl = SuccessUrl,
                cancelUrl = CancelUrl
            };

            var result = await Api.PostWithErrorAsync<MobileMoneyVm>("api/payments/mobile-money", body);
            if (result.Value is null)
            {
                _error = result.Error ?? L["PayMethod_PayUnavailable"];
                await OnError.InvokeAsync(_error);
                return;
            }

            _paymentId = result.Value.PaymentId;
            _instruction = result.Value.Instruction;
            _ussdHint = result.Value.UssdHint;

            if (string.Equals(result.Value.Status, "Failed", StringComparison.OrdinalIgnoreCase)
                || string.Equals(result.Value.Status, "Expired", StringComparison.OrdinalIgnoreCase))
            {
                _phase = Phase.Failed;
                _error = L["PayMethod_MmFailed"];
                return;
            }

            if (!string.IsNullOrWhiteSpace(result.Value.PaymentUrl))
            {
                await JS.InvokeVoidAsync("open", result.Value.PaymentUrl, "_self");
                return;
            }

            _phase = Phase.Waiting;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task VerifyAsync()
    {
        if (!_paymentId.HasValue) return;
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.GetWithErrorAsync<StatusVm>($"api/payments/mobile-money/{_paymentId}/status");
            if (result.Value is null)
            {
                _error = result.Error ?? L["PayMethod_PayUnavailable"];
                return;
            }

            var gateway = result.Value.GatewayStatus ?? "";
            var local = result.Value.LocalStatus ?? "";

            if (gateway.Equals("Succeeded", StringComparison.OrdinalIgnoreCase)
                || local.Equals("Completed", StringComparison.OrdinalIgnoreCase))
            {
                _phase = Phase.Success;
                await OnPaid.InvokeAsync();
                if (!string.IsNullOrWhiteSpace(SuccessUrl))
                    await JS.InvokeVoidAsync("open", SuccessUrl, "_self");
                return;
            }

            if (gateway is "Failed" or "Expired" or "Cancelled"
                || local.Equals("Failed", StringComparison.OrdinalIgnoreCase))
            {
                _phase = Phase.Failed;
                _error = L["PayMethod_MmFailed"];
                return;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task HandleCheckoutResultAsync(CheckoutVm? checkout, string? error)
    {
        if (checkout is null || string.IsNullOrWhiteSpace(checkout.CheckoutUrl))
        {
            _error = error ?? L["PayMethod_PayUnavailable"];
            await OnError.InvokeAsync(_error);
            return;
        }

        await JS.InvokeVoidAsync("open", checkout.CheckoutUrl, "_self");
    }

    private sealed record CheckoutVm(Guid PaymentId, string? CheckoutUrl);
    private sealed record MobileMoneyVm(
        Guid PaymentId,
        string PaymentCode,
        string Status,
        string? Instruction,
        string? UssdHint,
        decimal Amount,
        decimal AmountExclusive,
        decimal TaxAmount,
        decimal TaxRatePercent,
        string? TaxName,
        string? PaymentUrl);
    private sealed record StatusVm(string? GatewayStatus, string? LocalStatus);
    private sealed record TaxQuoteVm(
        string CountryCode,
        string CountryName,
        string TaxName,
        decimal TaxRatePercent,
        decimal AmountExclusive,
        decimal TaxAmount,
        decimal AmountInclusive,
        string Currency);
    private sealed record AfricaRateVm(
        string CountryCode,
        string CountryName,
        string TaxName,
        decimal RatePercent,
        string? Notes);
}
