@inject ApiClient Api
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@using TutorSphere.Application.DTOs.StudentSubscriptions

@if (_loading)
{
    return;
}

@if (!string.IsNullOrEmpty(_error) || _pending.Count > 0 || AlwaysVisible)
{
    <div class="cov-banner">
        <div class="cov-banner-head">
            <div class="cov-banner-icon" aria-hidden="true"><i class="bi bi-person-plus"></i></div>
            <div>
                <strong>@( _pending.Count > 0
                    ? string.Format(L["TutorEnroll_BannerTitle"].Value, _pending.Count)
                    : L["TutorEnroll_Title"])</strong>
                <p>@L["TutorEnroll_BannerHint"]</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2 px-3 mb-3" role="alert">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_banner))
        {
            <div class="alert alert-success py-2 px-3 mb-3" role="alert">@_banner</div>
        }

        @if (_pending.Count == 0 && string.IsNullOrEmpty(_error))
        {
            <p class="text-muted mb-2">@L["TutorEnroll_EmptyPending"]</p>
        }

        @foreach (var item in _pending)
        {
            <article class="cov-card">
                <div class="cov-card-main">
                    <h3>@item.StudentName</h3>
                    @if (!string.IsNullOrWhiteSpace(item.ParentName))
                    {
                        <p>Parent : @item.ParentName</p>
                    }
                    <p>@item.OfferingTitle · @item.Price.ToString("N2") @item.Currency</p>
                </div>
                <div class="cov-card-actions">
                    <button type="button" class="btn btn-success" disabled="@(_busyId == item.Id)"
                            @onclick="() => AcceptAsync(item)">
                        @if (_busyId == item.Id)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>@L["TutorSubs_Accept"]
                        }
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@(_busyId == item.Id)"
                            @onclick="() => RejectAsync(item)">
                        <i class="bi bi-x-lg me-1"></i>@L["TutorSubs_Refuse"]
                    </button>
                </div>
            </article>
        }

        <button type="button" class="btn btn-sm btn-primary" @onclick="OpenList">
            <i class="bi bi-box-arrow-up-right me-1"></i>@L["TutorEnroll_OpenList"]
        </button>
    </div>
}

@code {
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool AlwaysVisible { get; set; }

    private List<StudentSubscriptionDto> _pending = [];
    private Guid? _busyId;
    private string? _error;
    private string? _banner;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private void OpenList()
    {
        if (Nav.Uri.Contains("/tutor/enrollments", StringComparison.OrdinalIgnoreCase))
            return;
        Nav.NavigateTo("tutor/enrollments");
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.GetWithErrorAsync<List<StudentSubscriptionDto>>(
                "api/subscription-offerings/subscribers");
            if (result.Error is not null)
            {
                _pending = [];
                _error = result.Error;
                return;
            }

            _error = null;
            _pending = (result.Value ?? [])
                .Where(s => string.Equals(s.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        finally { _loading = false; }
    }

    private async Task AcceptAsync(StudentSubscriptionDto item)
    {
        _busyId = item.Id;
        _error = null;
        _banner = null;
        try
        {
            var result = await Api.PostWithErrorAsync<StudentSubscriptionDto>(
                $"api/subscription-offerings/subscribers/{item.Id}/accept", new { });
            if (result.Error is not null || result.Value is null)
            {
                _error = result.Error ?? L["TutorSubs_ActionFailed"];
                return;
            }

            _banner = string.Equals(result.Value.Status, "Active", StringComparison.OrdinalIgnoreCase)
                ? L["TutorSubs_AcceptActiveBanner"]
                : L["TutorSubs_AcceptPaymentBanner"];
            await ReloadAsync();
            await OnChanged.InvokeAsync();
        }
        finally { _busyId = null; }
    }

    private async Task RejectAsync(StudentSubscriptionDto item)
    {
        _busyId = item.Id;
        _error = null;
        _banner = null;
        try
        {
            var result = await Api.PostWithErrorAsync<StudentSubscriptionDto>(
                $"api/subscription-offerings/subscribers/{item.Id}/reject", new { });
            if (result.Error is not null)
            {
                _error = result.Error;
                return;
            }

            _banner = L["TutorSubs_RejectBanner"];
            await ReloadAsync();
            await OnChanged.InvokeAsync();
        }
        finally { _busyId = null; }
    }
}
