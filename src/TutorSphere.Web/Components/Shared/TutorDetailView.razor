@using TutorSphere.Application.DTOs.Branding
@using TutorSphere.Application.DTOs.ExpertApproval
@using Microsoft.JSInterop
@using TutorSphere.Web.Services
@inject NavigationManager Navigation
@inject ApiClient Api
@inject IJSRuntime JS
@inject IConfiguration Config

@if (Profile is null)
{
    return;
}

<div class="tutor-detail"
     style="--ts-primary: @Profile.PrimaryColor; --ts-primary-dark: @Profile.SecondaryColor;">
    <div class="tutor-detail-banner @(string.IsNullOrWhiteSpace(ResolvedBannerUrl) ? "tutor-detail-banner--fallback" : null)"
         style="@BannerStyle">
        <div class="tutor-detail-banner-overlay"></div>
        <div class="tutor-detail-banner-meta">
            @if (!string.IsNullOrWhiteSpace(Profile.ExpertGroupName))
            {
                @if (!string.IsNullOrWhiteSpace(ResolvedGroupLogoUrl))
                {
                    <img src="@ResolvedGroupLogoUrl" alt="" class="tutor-detail-banner-logo" />
                }
                <span class="tutor-detail-banner-group">@Profile.ExpertGroupName</span>
            }
            @if (!string.IsNullOrWhiteSpace(Profile.ExpertGroupCountryCode) || !string.IsNullOrWhiteSpace(Profile.Country))
            {
                <span class="tutor-detail-banner-country">@((Profile.ExpertGroupCountryCode ?? Profile.Country))</span>
            }
            @if (Profile.IsVerified)
            {
                <span class="tutor-detail-banner-verified">
                    <i class="bi bi-patch-check-fill" aria-hidden="true"></i>
                    @L["Search_VerifiedTeacher"]
                </span>
            }
        </div>
    </div>

    <div class="tutor-detail-body">
        <div class="tutor-detail-header">
            @if (!string.IsNullOrWhiteSpace(ResolvedPhotoUrl))
            {
                <div class="tutor-detail-avatar tutor-detail-avatar--photo @(Profile.PhotoIsGroupLogoFallback ? "tutor-detail-avatar--group-fallback" : null)"
                     style="background-image:url('@CssUrl(ResolvedPhotoUrl)')">
                    @if (Profile.PhotoIsGroupLogoFallback)
                    {
                        <span class="tutor-photo-fallback-label">@L["Search_GroupLogoFallback"]</span>
                    }
                </div>
            }
            else
            {
                <div class="tutor-detail-avatar">@Profile.PublicInitials</div>
            }

            <div class="tutor-detail-info">
                <h1>@Profile.DisplayName</h1>
                @if (!string.IsNullOrWhiteSpace(Profile.ExpertGroupName))
                {
                    <p class="tutor-detail-school">
                        @if (!string.IsNullOrWhiteSpace(ResolvedGroupLogoUrl))
                        {
                            <img src="@ResolvedGroupLogoUrl" alt="" class="tutor-detail-group-thumb" />
                        }
                        else
                        {
                            <i class="bi bi-patch-check-fill text-success"></i>
                        }
                        <span>@Profile.ExpertGroupName</span>
                    </p>
                }
                @if (!string.IsNullOrWhiteSpace(Profile.Location))
                {
                    <p class="tutor-detail-location"><i class="bi bi-geo-alt"></i> @Profile.Location</p>
                }
                @if (!string.IsNullOrWhiteSpace(Profile.Status))
                {
                    <span class="tutor-detail-status">@Profile.Status</span>
                }
                @if (Profile.Subjects.Count > 0)
                {
                    <div class="tutor-tags mt-2">
                        @foreach (var subject in Profile.Subjects.Take(6))
                        {
                            <span class="badge">@subject</span>
                        }
                    </div>
                }
                @if (Profile.Levels.Count > 0)
                {
                    <p class="tutor-detail-levels mt-2">
                        <span class="text-muted">@L["Label_Level"] :</span>
                        @string.Join(" · ", Profile.Levels)
                    </p>
                }
                @if (DisplayLanguages.Count > 0)
                {
                    <p class="tutor-detail-levels mt-2">
                        <span class="text-muted">@L["TeacherApply_Language"] :</span>
                        @string.Join(" · ", DisplayLanguages)
                    </p>
                }
            </div>

            <div class="tutor-detail-actions">
                @if (PreviewMode)
                {
                    <button type="button" class="btn btn-primary" disabled title="Aperçu — action parents">
                        <i class="bi bi-plus-lg me-1"></i>@L["PublicProfile_ChooseOffer"]
                    </button>
                    <p class="small text-muted mt-2 mb-0">
                        <i class="bi bi-shield-lock me-1"></i>@L["PublicProfile_ContactPrivacy"]
                    </p>
                }
                else if ((AllowSubscribe || AllowSelfSubscribe) && Profile.Offerings.Count > 0)
                {
                    <button type="button" class="btn btn-primary" @onclick="() => OpenSubscribe(Profile.Offerings[0])">
                        <i class="bi bi-plus-lg me-1"></i>@L["PublicProfile_ChooseOffer"]
                    </button>
                    <p class="small text-muted mt-2 mb-0">
                        <i class="bi bi-shield-lock me-1"></i>@L["PublicProfile_ContactPrivacy"]
                    </p>
                }
                else if (!string.IsNullOrWhiteSpace(SubscribeHref))
                {
                    <a class="btn btn-primary" href="@SubscribeHref">
                        <i class="bi bi-plus-lg me-1"></i>@L["PublicProfile_ChooseOffer"]
                    </a>
                    <p class="small text-muted mt-2 mb-0">
                        <i class="bi bi-shield-lock me-1"></i>@L["PublicProfile_ContactPrivacy"]
                    </p>
                }
            </div>
        </div>

        <div class="tutor-detail-stats">
            @if (Profile.YearsExperience > 0)
            {
                <div class="tutor-detail-stat">
                    <strong>@Profile.YearsExperience @L["PublicProfile_Years"]</strong>
                    <span>@L["PublicProfile_Experience"]</span>
                </div>
            }
            @if (Profile.HourlyRate > 0)
            {
                <div class="tutor-detail-stat">
                    <strong>@Profile.HourlyRate.ToString("0.##") $/@Profile.Currency</strong>
                    <span>Tarif horaire</span>
                </div>
            }
            @if (Profile.Subjects.Count > 0)
            {
                <div class="tutor-detail-stat">
                    <strong>@Profile.Subjects.Count</strong>
                    <span>@L["PublicProfile_Tab_Subjects"]</span>
                </div>
            }
            @if (Profile.Offerings.Count > 0)
            {
                <div class="tutor-detail-stat">
                    <strong>@Profile.Offerings.Count</strong>
                    <span>@L["PublicProfile_Tab_Offers"]</span>
                </div>
            }
            @if (Profile.Availability.Count > 0)
            {
                <div class="tutor-detail-stat">
                    <strong>@GroupAvailability(Profile.Availability).Count()</strong>
                    <span>Jours dispo.</span>
                </div>
            }
        </div>

        <ul class="nav nav-tabs tutor-detail-tabs">
            @foreach (var tab in _tabs)
            {
                <li class="nav-item">
                    <button type="button"
                            class="nav-link @(_activeTab == tab.Key ? "active" : null)"
                            @onclick="() => _activeTab = tab.Key">
                        @tab.Label
                    </button>
                </li>
            }
        </ul>

        <div class="tutor-detail-tab-content">
            @if (_activeTab == "about")
            {
                <section class="section-card">
                    <h2>Présentation</h2>
                    @if (!string.IsNullOrWhiteSpace(Profile.FullBio))
                    {
                        <p class="tutor-detail-bio">@Profile.FullBio</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(Profile.ShortBio))
                    {
                        <p class="tutor-detail-bio">@Profile.ShortBio</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Aucune présentation renseignée pour le moment.</p>
                    }
                </section>

                @if (!string.IsNullOrWhiteSpace(Profile.ShortBio) && !string.IsNullOrWhiteSpace(Profile.FullBio)
                     && !string.Equals(Profile.ShortBio.Trim(), Profile.FullBio.Trim(), StringComparison.Ordinal))
                {
                    <section class="section-card mt-3">
                        <h2>Approche pédagogique</h2>
                        <p class="tutor-detail-bio mb-0">@Profile.ShortBio</p>
                    </section>
                }

                @if (Profile.Diplomas.Count > 0 || Profile.Certifications.Count > 0)
                {
                    <section class="section-card mt-3">
                        <h2>Parcours (CV)</h2>
                        <div class="row g-3">
                            @if (Profile.Diplomas.Count > 0)
                            {
                                <div class="col-md-6">
                                    <h3 class="h6">Diplômes</h3>
                                    <ul class="tutor-detail-list">
                                        @foreach (var d in Profile.Diplomas)
                                        {
                                            <li>
                                                <strong>@d.Title</strong>
                                                @if (!string.IsNullOrWhiteSpace(d.Institution) || !string.IsNullOrWhiteSpace(d.Year))
                                                {
                                                    <span>@FormatCredentialMeta(d.Institution, d.Year)</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (Profile.Certifications.Count > 0)
                            {
                                <div class="col-md-6">
                                    <h3 class="h6">Certifications</h3>
                                    <ul class="tutor-detail-list">
                                        @foreach (var c in Profile.Certifications)
                                        {
                                            <li>
                                                <strong>@c.Title</strong>
                                                @if (!string.IsNullOrWhiteSpace(c.Institution) || !string.IsNullOrWhiteSpace(c.Year))
                                                {
                                                    <span>@FormatCredentialMeta(c.Institution, c.Year)</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </section>
                }
            }
            else if (_activeTab == "credentials")
            {
                @if (CredentialsEditor is not null)
                {
                    <section class="section-card">
                        <p class="small text-muted mb-3">
                            Optionnel. Les parents verront ces informations sur la fiche publique.
                            Cliquez sur « Ajouter » pour un diplôme ou une certification.
                        </p>
                        @CredentialsEditor
                    </section>
                }
                else
                {
                <div class="row g-3">
                    <div class="col-md-6">
                        <section class="section-card h-100">
                            <h2>Diplômes</h2>
                            @if (Profile.Diplomas.Count == 0)
                            {
                                <p class="text-muted mb-0">Aucun diplôme publié.</p>
                            }
                            else
                            {
                                <ul class="tutor-detail-list">
                                    @foreach (var d in Profile.Diplomas)
                                    {
                                        <li>
                                            <strong>@d.Title</strong>
                                            @if (!string.IsNullOrWhiteSpace(d.Institution) || !string.IsNullOrWhiteSpace(d.Year))
                                            {
                                                <span>@FormatCredentialMeta(d.Institution, d.Year)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    </div>
                    <div class="col-md-6">
                        <section class="section-card h-100">
                            <h2>Certifications</h2>
                            @if (Profile.Certifications.Count == 0)
                            {
                                <p class="text-muted mb-0">Aucune certification publiée.</p>
                            }
                            else
                            {
                                <ul class="tutor-detail-list">
                                    @foreach (var c in Profile.Certifications)
                                    {
                                        <li>
                                            <strong>@c.Title</strong>
                                            @if (!string.IsNullOrWhiteSpace(c.Institution) || !string.IsNullOrWhiteSpace(c.Year))
                                            {
                                                <span>@FormatCredentialMeta(c.Institution, c.Year)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    </div>
                </div>
                }
            }
            else if (_activeTab == "subjects")
            {
                <section class="section-card">
                    <h2>@L["PublicProfile_SubjectsTaught"]</h2>
                    @if (Profile.Subjects.Count == 0)
                    {
                        <p class="text-muted mb-0">Aucune matière indiquée. Vérifiez l’onglet Offres.</p>
                    }
                    else
                    {
                        <div class="tutor-tags">
                            @foreach (var subject in Profile.Subjects)
                            {
                                <span class="badge">@subject</span>
                            }
                        </div>
                    }
                </section>
            }
            else if (_activeTab == "disciplines")
            {
                @if (Profile.Disciplines is null || Profile.Disciplines.Count == 0)
                {
                    <section class="section-card">
                        <p class="text-muted mb-0">@L["PublicProfile_NoDisciplines"]</p>
                    </section>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var discipline in Profile.Disciplines)
                        {
                            <div class="col-md-6">
                                <section class="section-card h-100">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <h2 class="h6 mb-0">@discipline.Name</h2>
                                        <span class="badge bg-light text-dark border">@discipline.Cycle</span>
                                    </div>
                                    @if (discipline.Services.Count > 0)
                                    {
                                        <h3 class="h6 text-muted mt-3">@L["PublicProfile_DisciplineServices"]</h3>
                                        <ul class="tutor-detail-list mb-2">
                                            @foreach (var svc in discipline.Services)
                                            {
                                                <li>
                                                    <strong>@svc.Title</strong>
                                                    @if (!string.IsNullOrWhiteSpace(svc.Description))
                                                    {
                                                        <span>— @svc.Description</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(discipline.WorkMethod))
                                    {
                                        <h3 class="h6 text-muted mt-3">@L["PublicProfile_DisciplineWorkMethod"]</h3>
                                        <p class="mb-0">@discipline.WorkMethod</p>
                                    }
                                </section>
                            </div>
                        }
                    </div>
                }
            }
            else if (_activeTab == "offers")
            {
                @if (Profile.Offerings.Count == 0)
                {
                    <section class="section-card">
                        <p class="text-muted mb-0">Aucune offre active pour le moment.</p>
                    </section>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var offer in Profile.Offerings)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="offering-card">
                                    @if (!string.IsNullOrWhiteSpace(offer.Subject))
                                    {
                                        <span class="offering-subject">@offer.Subject</span>
                                    }
                                    <h3>@offer.Title</h3>
                                    @if (!string.IsNullOrWhiteSpace(offer.Description))
                                    {
                                        <p class="offering-description">@offer.Description</p>
                                    }
                                    <p class="offering-price">@offer.Price.ToString("N2") $ @offer.Currency</p>
                                    <ul class="offering-meta">
                                        <li>@offer.SessionCount séance(s)</li>
                                        <li>@offer.DurationDays jour(s)</li>
                                        @if (!string.IsNullOrWhiteSpace(offer.Frequency))
                                        {
                                            <li>@offer.Frequency</li>
                                        }
                                        <li>@offer.Mode</li>
                                    </ul>
                                    @if (offer.AvailabilitySlots is { Count: > 0 })
                                    {
                                        <div class="tutor-tags mt-2">
                                            @foreach (var slot in offer.AvailabilitySlots.Take(4))
                                            {
                                                <span class="badge">@FormatSlot(slot)</span>
                                            }
                                        </div>
                                    }
                                    @if (AllowSubscribe || AllowSelfSubscribe)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm w-100 mt-3"
                                                @onclick="() => OpenSubscribe(offer)">
                                            <i class="bi bi-cart-plus me-1"></i>@L["PublicProfile_ChooseOffer"]
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else if (_activeTab == "availability")
            {
                <section class="section-card">
                    <h2>Disponibilités</h2>
                    @if (Profile.Availability.Count == 0)
                    {
                        <p class="text-muted mb-0">
                            Aucune disponibilité publiée. L’enseignant peut les définir dans son profil
                            ou via les créneaux de ses offres.
                        </p>
                    }
                    else
                    {
                        <div class="tutor-detail-availability">
                            @foreach (var group in GroupAvailability(Profile.Availability))
                            {
                                <div class="tutor-detail-avail-row">
                                    <strong>@group.Day</strong>
                                    <div class="tutor-tags">
                                        @foreach (var slot in group.Slots)
                                        {
                                            <span class="badge">@slot</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        </div>
    </div>
</div>

@if (_showSubscribeModal && _selectedOffer is not null)
{
    <div class="ts-modal-backdrop" @onclick="CloseSubscribe">
        <div class="ts-modal" @onclick:stopPropagation="true" style="max-width:480px">
            <div class="ts-modal-header">
                <h2>@string.Format(L["ParentSubscribe_ModalTitle"].Value, _selectedOffer.Title)</h2>
                <button type="button" class="btn-close" @onclick="CloseSubscribe"></button>
            </div>
            <div class="ts-modal-body">
                @if (!string.IsNullOrWhiteSpace(_subscribeError))
                {
                    <div class="alert alert-danger">@_subscribeError</div>
                }
                <p class="text-muted">
                    @_selectedOffer.Price.ToString("N2") @_selectedOffer.Currency
                    · @string.Format(L["ParentSubscribe_Sessions"].Value, _selectedOffer.SessionCount)
                    @if (!string.IsNullOrWhiteSpace(_selectedOffer.Subject))
                    {
                        <span>· @_selectedOffer.Subject</span>
                    }
                </p>

                @if (AllowSelfSubscribe)
                {
                    <p class="mb-0">Envoyer une demande d’inscription pour <strong>vous-même</strong>. Après acceptation par l’enseignant, vous pourrez payer.</p>
                }
                else if (_loadingChildren)
                {
                    <div class="text-muted">@L["ParentSubscribe_LoadingChildren"]</div>
                }
                else if (_children.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        @{
                            // Ressource : « … dans <a href="{0}">…</a> … » (évite le HTML double-encodé).
                            var noChildrenHtml = System.Net.WebUtility.HtmlDecode(
                                string.Format(L["ParentSubscribe_NoChildren"].Value, "/parent/children"));
                        }
                        @((MarkupString)noChildrenHtml)
                    </div>
                }
                else
                {
                    <label class="form-label">@L["ParentSubscribe_ChooseChild"]</label>
                    <select class="form-select" @bind="_selectedChildId">
                        <option value="">@L["ParentSubscribe_SelectPlaceholder"]</option>
                        @foreach (var child in _children)
                        {
                            <option value="@child.Id">@child.FirstName @child.LastName</option>
                        }
                    </select>
                }
            </div>
            <div class="ts-modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="CloseSubscribe">@L["Common_Cancel"]</button>
                <button type="button" class="btn btn-primary"
                        disabled="@SubscribeDisabled"
                        @onclick="ConfirmSubscribeAsync">
                    @if (_subscribing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    @L["ParentSubscribe_SendRequest"]
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public TeacherPublicProfileDto Profile { get; set; } = default!;
    [Parameter] public string? SubscribeHref { get; set; }
    [Parameter] public bool AllowSubscribe { get; set; }
    /// <summary>Élève autonome (14+) — s'abonne pour lui-même.</summary>
    [Parameter] public bool AllowSelfSubscribe { get; set; }
    /// <summary>Aperçu admin/expert : même rendu parents, sans actions d'inscription.</summary>
    [Parameter] public bool PreviewMode { get; set; }
    /// <summary>Formulaire d’édition des diplômes/certifications (assistant d’ajout d’enseignant).</summary>
    [Parameter] public RenderFragment? CredentialsEditor { get; set; }
    [Inject] private IStringLocalizer<SharedResources> L { get; set; } = default!;

    private string _activeTab = "about";
    private bool _showSubscribeModal;
    private bool _loadingChildren;
    private bool _subscribing;
    private string? _subscribeError;
    private string _selectedChildId = "";
    private PublicOfferingDto? _selectedOffer;
    private List<ChildOption> _children = [];

    private bool SubscribeDisabled =>
        _subscribing
        || (!AllowSelfSubscribe && (string.IsNullOrEmpty(_selectedChildId) || _children.Count == 0));

    private IReadOnlyList<string> DisplayLanguages
    {
        get
        {
            var raw = Profile.Languages is { Count: > 0 } ? Profile.Languages : [Profile.Language];
            return raw
                .Where(l => !string.IsNullOrWhiteSpace(l))
                .Select(l => TeacherCommunicationLanguages.TryParse(l, out var code)
                    ? TeacherCommunicationLanguages.Label(code)
                    : l.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private (string Key, string Label)[] _tabs
    {
        get
        {
            var tabs = new List<(string Key, string Label)>
            {
                ("about", "Présentation"),
                ("credentials", "Diplômes"),
                ("subjects", L["PublicProfile_Tab_Subjects"]),
            };
            if (Profile.Disciplines is { Count: > 0 })
                tabs.Add(("disciplines", L["PublicProfile_Tab_Disciplines"]));
            tabs.Add(("offers", L["PublicProfile_Tab_Offers"]));
            tabs.Add(("availability", "Disponibilités"));
            return tabs.ToArray();
        }
    }

    private string DisplayName =>
        !string.IsNullOrWhiteSpace(Profile.DisplayName) ? Profile.DisplayName : Profile.GivenName;

    private string ResolvedPhotoUrl => MediaUrlHelper.Resolve(Profile.PhotoUrl, Config, Navigation);
    private string ResolvedBannerUrl => MediaUrlHelper.Resolve(Profile.BannerUrl, Config, Navigation);
    private string ResolvedGroupLogoUrl => MediaUrlHelper.Resolve(Profile.ExpertGroupLogoUrl, Config, Navigation);
    private string? BannerStyle => string.IsNullOrWhiteSpace(ResolvedBannerUrl)
        ? $"background:linear-gradient(135deg,{Profile.PrimaryColor} 0%,{Profile.SecondaryColor} 100%);"
        : $"background-image:url('{CssUrl(ResolvedBannerUrl)}')";

    private static string CssUrl(string url) => url.Replace("'", "%27");

    private async Task OpenSubscribe(PublicOfferingDto offer)
    {
        _selectedOffer = offer;
        _subscribeError = null;
        _selectedChildId = "";
        _showSubscribeModal = true;

        if (AllowSelfSubscribe)
        {
            _loadingChildren = false;
            _children = [];
            return;
        }

        _loadingChildren = true;
        try
        {
            var children = await Api.GetAsync<List<ChildOption>>("api/parent/children") ?? [];
            _children = children;
            if (_children.Count == 1)
                _selectedChildId = _children[0].Id.ToString();
        }
        catch
        {
            _subscribeError = L["ParentSubscribe_LoadChildrenError"];
            _children = [];
        }
        finally
        {
            _loadingChildren = false;
        }
    }

    private void CloseSubscribe()
    {
        _showSubscribeModal = false;
        _selectedOffer = null;
        _subscribeError = null;
    }

    private async Task ConfirmSubscribeAsync()
    {
        if (_selectedOffer is null)
            return;

        if (!AllowSelfSubscribe && !Guid.TryParse(_selectedChildId, out _))
            return;

        _subscribing = true;
        _subscribeError = null;
        try
        {
            ApiResult<EnrollResult> enroll;
            if (AllowSelfSubscribe)
            {
                enroll = await Api.PostWithErrorAsync<EnrollResult>("api/students/me/subscriptions/enroll", new
                {
                    offeringId = _selectedOffer.Id
                });
            }
            else
            {
                var childId = Guid.Parse(_selectedChildId);
                enroll = await Api.PostWithErrorAsync<EnrollResult>("api/parent/subscriptions/enroll", new
                {
                    studentId = childId,
                    offeringId = _selectedOffer.Id
                });
            }

            if (enroll.Error is not null || enroll.Value is null)
            {
                _subscribeError = enroll.Error ?? L["ParentSubscribe_EnrollError"];
                return;
            }

            _subscribeError = null;
            CloseSubscribe();
            Navigation.NavigateTo(AllowSelfSubscribe
                ? $"/student/subscriptions?created={enroll.Value.Id}"
                : $"/parent/subscriptions?created={enroll.Value.Id}");
        }
        catch (Exception ex)
        {
            _subscribeError = ex.Message;
        }
        finally
        {
            _subscribing = false;
        }
    }

    private static string FormatCredentialMeta(string? institution, string? year)
    {
        if (!string.IsNullOrWhiteSpace(institution) && !string.IsNullOrWhiteSpace(year))
            return $"{institution} · {year}";
        return institution ?? year ?? "";
    }

    private static string FormatSlot(string key)
    {
        var idx = key.IndexOf('-');
        if (idx <= 0) return key;
        return $"{key[..idx]} {key[(idx + 1)..]}";
    }

    private static IEnumerable<(string Day, List<string> Slots)> GroupAvailability(IReadOnlyList<string> keys)
    {
        return keys
            .Select(k =>
            {
                var idx = k.IndexOf('-');
                if (idx <= 0)
                    return (Day: k, Slot: "");
                return (Day: k[..idx], Slot: k[(idx + 1)..]);
            })
            .GroupBy(x => x.Day)
            .Select(g => (g.Key, g.Select(x => x.Slot).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().ToList()));
    }

    private sealed record ChildOption(Guid Id, string FirstName, string LastName);
    private sealed record EnrollResult(Guid Id);
    private sealed record CheckoutResult(string CheckoutUrl);
}
